<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Documentação técnica</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <style>
    .devdocs { display: grid; grid-template-columns: 260px 1fr; gap: 1.25rem; align-items: start; }
    .devdocs-nav { position: sticky; top: 1rem; }
    .devdocs-nav a { display: block; padding: .45rem .6rem; border-radius: var(--radius-md); color: inherit; text-decoration: none; }
    .devdocs-nav a:hover { background: var(--surface-hover); }
    .devdocs-nav a.active { background: var(--surface-hover); font-weight: 600; }
    .devdocs-nav .dd-title { font-size: .95rem; }
    .devdocs-nav .dd-sum { font-size: .75rem; opacity: .7; margin-top: .15rem; }
    .devdocs-article { max-width: 900px; }
    .devdocs-article h1 { margin-top: 0; }
    .devdocs-article h2 { margin-top: 1.6rem; padding-bottom: .3rem; border-bottom: 1px solid var(--border-light); }
    .devdocs-article h3 { margin-top: 1.2rem; }
    .devdocs-article table { width: 100%; }
    .devdocs-article code { background: var(--surface-hover); padding: .1rem .3rem; border-radius: 4px; font-size: .85em; }
    .devdocs-article pre { background: var(--surface-hover); padding: .8rem 1rem; border-radius: var(--radius-md); overflow-x: auto; }
    .devdocs-article pre code { background: none; padding: 0; }
    .devdocs-article blockquote { border-left: 3px solid var(--border-light); margin: .8rem 0; padding: .2rem 1rem; opacity: .85; }
    @media (max-width: 820px) { .devdocs { grid-template-columns: 1fr; } .devdocs-nav { position: static; } }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: 'documentacao' }) %>
  <main>
    <h1>Documentação técnica</h1>
    <p class="muted text-sm">
      Regras de negócio por módulo, para suporte e treinamento. Visível apenas para quem tem
      a permissão <code>dev.docs.view</code>.
    </p>

    <div class="devdocs">
      <nav class="devdocs-nav">
        <% if (!docs.length) { %>
          <p class="muted text-sm">Nenhum documento disponível.</p>
        <% } %>
        <% docs.forEach(function (d) { %>
          <a href="/admin/documentacao?doc=<%= encodeURIComponent(d.slug) %>"
             class="<%= current && current.slug === d.slug ? 'active' : '' %>">
            <div class="dd-title"><%= d.title %></div>
            <% if (d.summary) { %><div class="dd-sum"><%= d.summary %></div><% } %>
          </a>
        <% }); %>
      </nav>

      <article class="devdocs-article">
        <%- current.html %>
      </article>
    </div>
  </main>
</body>
</html>
