<%
  const _statusOpts = typeof statusOptions !== 'undefined' ? statusOptions : [];
  const _placeholder = typeof placeholder !== 'undefined' ? placeholder : 'Buscar';
  // Telas que têm um período próprio na barra (Caixa) escondem o período daqui para
  // não existirem dois controles concorrentes filtrando a mesma lista.
  const _hidePeriod = typeof hidePeriod !== 'undefined' ? hidePeriod : false;
  // Atalhos de período. 1 = hoje (só o dia atual), 7 = últimos 7 dias, etc.
  const _quickDays = typeof quickDays !== 'undefined' ? quickDays : [30, 60, 90];
%>
<div class="search-filter"
     x-data="searchFilter(<%= JSON.stringify(_statusOpts) %>, <%= JSON.stringify(_quickDays) %>)"
     @apply-filter.window="onApply($event.detail)">
  <input type="text" :placeholder="<%= JSON.stringify(_placeholder) %>" x-model="q" @input.debounce.300ms="emit()" class="input-search" />
  <button type="button" class="filter-btn" :class="{ active: hasActive }" @click="$refs.filterDlg.showModal()" data-tip="Filtros avançados" aria-label="Filtros avançados">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
    </svg>
    <span class="filter-badge" x-show="hasActive"></span>
  </button>

  <dialog x-ref="filterDlg" style="width:min(380px, 94vw)">
    <h2 class="dialog-heading-md">Filtros</h2>
    <div class="dialog-body">
      <template x-if="statusOpts.length">
        <div>
          <label>Status</label>
          <select x-model="status" @change="emit()">
            <option value="">Todos</option>
            <template x-for="s in statusOpts" :key="s.value">
              <option :value="s.value" :style="s.color ? ('color:' + s.color + ';font-weight:600') : ''" x-text="s.label"></option>
            </template>
          </select>
        </div>
      </template>
      <% if (!_hidePeriod) { %>
      <div>
        <label>Período</label>
        <div style="display:flex;gap:.4rem;align-items:center">
          <input type="date" data-picker x-model="from" @change="quickActive = 0; emit()" style="flex:1" />
          <span class="muted text-xs">até</span>
          <input type="date" data-picker x-model="to" @change="quickActive = 0; emit()" style="flex:1" />
        </div>
        <div class="filter-quick">
          <template x-for="d in quickDays" :key="d">
            <button type="button" :class="{ active: quickActive === d }" @click="setQuick(d)" x-text="d === 1 ? 'hoje' : (d + 'd')"></button>
          </template>
        </div>
      </div>
      <% } %>
    </div>
    <div class="actions">
      <button type="button" class="btn secondary" @click="clear(); emit()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
        Limpar
      </button>
      <button type="button" class="btn" @click="$refs.filterDlg.close()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        Aplicar
      </button>
    </div>
  </dialog>
</div>
<script nonce="<%= cspNonce %>">
  function searchFilter(statusOpts, quickDays) {
    quickDays = Array.isArray(quickDays) && quickDays.length ? quickDays : [30, 60, 90];
    return {
      q: '', status: '', from: '', to: '',
      quickActive: 0, statusOpts, quickDays,
      get hasActive() { return !!(this.status || this.from || this.to); },
      setQuick(days) {
        this.quickActive = days;
        // Data de hoje recalculada no clique: o PDV/caixa pode ficar aberto virando a
        // noite, e um `new Date()` congelado no boot mandaria o filtro para o dia anterior.
        const now = new Date();
        const end = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const start = new Date(end);
        // 1 = hoje; 7 = hoje + os 6 dias anteriores. O `days` já é a quantidade de dias
        // incluindo hoje, então não somamos um dia a mais como antes.
        start.setDate(start.getDate() - Math.max(0, days - 1));
        this.from = fmtDateISO(start);
        this.to = fmtDateISO(end);
        this.emit();
      },
      clear() { this.q = ''; this.status = ''; this.from = ''; this.to = ''; this.quickActive = 0; },
      emit() {
        this.$dispatch('apply-filter', {
          q: this.q, status: this.status, from: this.from, to: this.to,
        });
      },
      onApply(d) {
        this.q = d.q || ''; this.status = d.status || '';
        this.from = d.from || ''; this.to = d.to || '';
        this.quickActive = 0;
      },
    };
  }
  function fmtDateISO(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  /** Filtra `rows` com o objeto emitido pelo evento apply-filter ({ q, status, from, to }). */
  function filterRows(rows, filter) {
    filter = filter || {};
    return rows.filter((r) => {
      if (filter.q) {
        const q = filter.q.toLowerCase();
        const desc = (r.description ?? r.name ?? r.notes ?? '').toLowerCase();
        const party = (r.party ?? r.customer ?? r.customer_name ?? r.supplier ?? '').toLowerCase();
        if (!desc.includes(q) && !party.includes(q)) return false;
      }
      if (filter.status && r.status !== filter.status) return false;
      if (filter.from) {
        const d = String(r.created_at ?? r.due_date ?? r.valid_until ?? r.opened_at ?? '').slice(0, 10);
        if (d < filter.from) return false;
      }
      if (filter.to) {
        const d = String(r.created_at ?? r.due_date ?? r.valid_until ?? r.opened_at ?? '').slice(0, 10);
        if (d > filter.to) return false;
      }
      return true;
    });
  }
</script>
