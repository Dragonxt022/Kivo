<%# Instalável na tela inicial: o manifest deixa o Kivo abrir em tela cheia, sem a
    barra do navegador. Os metadados da Apple cobrem o iPhone/iPad, que não lê o
    manifest para o modo standalone. O service worker é registrado no fim deste
    partial, e só em contexto seguro (HTTPS/localhost) — no acesso por http:// da
    rede local ele simplesmente não é registrado, sem quebrar nada. %>
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="Kivo" />
<meta name="theme-color" content="#ff8000" />
<script nonce="<%= cspNonce %>">
(function () {
  try {
    var t = localStorage.getItem('kivo-theme');
    if (t !== 'light' && t !== 'dark') {
      t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
})();
</script>
<!--
  Este partial é o gancho "roda em toda página" do Kivo: está no <head> de todas as telas,
  antes do Alpine (que é `defer`). Por isso os globais de boot moram aqui — o tema acima,
  o desembrulho do envelope abaixo, e `window.brl`, que as telas usam para formatar
  dinheiro. Script externo (e não inline) para o navegador poder cachear.
-->
<script nonce="<%= cspNonce %>" src="/js/money.js"></script>
<script nonce="<%= cspNonce %>">
// Todo JSON do servidor vem embrulhado em { success, data } ou { success: false, error }
// (ver src/shared/responseEnvelope.ts), mas as telas foram escritas esperando o corpo "cru"
// (ex.: this.rows = await r.json()). Desembrulha aqui, num único lugar carregado em toda
// página, em vez de reescrever cada fetch() das views.
(function () {
  var originalJson = Response.prototype.json;
  Response.prototype.json = function () {
    return originalJson.call(this).then(function (body) {
      if (body && typeof body === 'object' && typeof body.success === 'boolean') {
        return body.success ? (body.data !== undefined ? body.data : body) : body;
      }
      return body;
    });
  };
})();
</script>
<script nonce="<%= cspNonce %>">
(function () {
  try {
    var mode = localStorage.getItem('kivo-interface');
    document.documentElement.setAttribute('data-interface', mode === 'sidebar' ? 'sidebar' : 'cards');

    var collapsed = localStorage.getItem('kivo-sidebar-collapsed') === '1';
    document.documentElement.setAttribute('data-sidebar-collapsed', collapsed ? '1' : '0');

    // Modo leve: desliga blur, sombra e animação (ver :root[data-lite] em app.css). Vem do
    // servidor (app.locals.modoLeve → machine-prefs.json), e não do localStorage, porque o
    // processo principal do Electron precisa do mesmo valor para desligar a GPU no boot.
    document.documentElement.setAttribute('data-lite', '<%= typeof modoLeve !== "undefined" && modoLeve ? "1" : "0" %>');

    window.KIVO_COLOR_PRESETS = [
      { id: 'blue', hex: '#2563eb' },
      { id: 'green', hex: '#16a34a' },
      { id: 'orange', hex: '#ff8000' },
      { id: 'pink', hex: '#ec4899' },
      { id: 'black', hex: '#18181b' },
    ];

    window.__kivoApplyCustomColor = function (hex) {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      var s = document.documentElement.style;
      s.setProperty('--primary', hex);
      s.setProperty('--icon-color', hex);
      s.setProperty('--primary-hover', 'color-mix(in srgb, white 15%, ' + hex + ')');
      s.setProperty('--primary-bg', 'color-mix(in srgb, ' + hex + ' ' + (isDark ? 16 : 8) + '%, transparent)');
    };

    var colorTheme = <%- JSON.stringify(typeof corDestaque !== 'undefined' && corDestaque ? corDestaque : 'orange') %>;
    var customHex = <%- JSON.stringify(typeof corCustom !== 'undefined' && corCustom ? corCustom : '#ff8000') %>;
    window.__kivoColor = { theme: colorTheme, custom: customHex };

    // Cor de destaque: configuração da EMPRESA, aplicada no servidor (res.locals.corDestaque/
    // corCustom — ver core/config/themeColor.ts) para valer em qualquer aparelho que abra
    // este Kivo, inclusive pelo celular na rede local. Antes vivia só no localStorage e o
    // celular mostrava o laranja padrão, ignorando a escolha da loja.
    if (colorTheme === 'custom') {
      document.documentElement.setAttribute('data-color-theme', 'custom');
      window.__kivoApplyCustomColor(customHex);
    } else {
      document.documentElement.setAttribute('data-color-theme', colorTheme);
    }

    // A cor da barra de status do celular acompanha a cor de destaque da empresa.
    var presets = { blue: '#2563eb', green: '#16a34a', orange: '#ff8000', pink: '#ec4899', black: '#18181b' };
    var themeHex = colorTheme === 'custom' ? customHex : (presets[colorTheme] || '#ff8000');
    var metaTheme = document.querySelector('meta[name="theme-color"]');
    if (metaTheme) metaTheme.setAttribute('content', themeHex);

    // Marca o modo "aplicativo instalado" para o CSS/JS esconder dicas de instalação.
    if (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) {
      document.documentElement.classList.add('kivo-standalone');
    }
  } catch (e) {}
})();
</script>
<script nonce="<%= cspNonce %>">
// O prompt nativo de instalação do Chrome só pode ser chamado no mesmo gesto em que
// foi capturado; guardamos o evento e o diálogo "Kivo no celular" usa depois.
window.addEventListener('beforeinstallprompt', function (e) {
  e.preventDefault();
  window.__kivoInstallPrompt = e;
  window.dispatchEvent(new Event('kivo-install-available'));
});
window.addEventListener('appinstalled', function () {
  window.__kivoInstallPrompt = null;
  window.dispatchEvent(new Event('kivo-app-installed'));
});

// PWA: apenas em contexto seguro. Em http:// na rede local o Chrome/Android não
// registra service worker — e é exatamente por isso que o diálogo oferece "tela cheia".
if ('serviceWorker' in navigator && window.isSecureContext) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('/sw.js').catch(function () {});
  });
}
</script>
