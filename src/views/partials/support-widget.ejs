<%#
  Widget de ajuda/suporte — aparece em TODAS as páginas (incluído por partials/nav.ejs).
  É um painel flutuante no canto inferior direito, não-modal: dá para continuar usando o
  sistema com ele aberto. "Recolher" esconde o painel e deixa o botão no canto.

  Tem três conversas:
   - Kivo IA: responde com a documentação; cada resposta pode trazer botões que levam à tela
     do módulo. A conversa fica salva num chamado e é recarregada ao reabrir (memória).
   - Atendimento humano: chamado normal, com aviso de prazo (8h úteis).
   - Sugestões.
%>
<div x-data="helpChat()" x-init="init()">
  <button type="button" class="fab" title="Ajuda e suporte" @click="open()" x-show="!panelOpen" x-cloak>
    <%- svgIcon('chat', 22, 22) %>
    <span class="fab-unread" x-show="unread > 0" x-text="unread > 9 ? '9+' : unread" x-cloak></span>
  </button>

  <section class="support-panel" x-show="panelOpen" x-cloak aria-label="Ajuda e suporte">
    <div class="support-head">
      <button type="button" class="back-btn" x-show="view !== 'home'" @click="goHome()" title="Voltar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div style="min-width:0">
        <h2 x-text="view === 'chat' ? ticket.subject : (view === 'new' ? novoTitulo() : (view === 'ia' ? 'Kivo IA' : 'Suporte Kivo'))"></h2>
        <div class="sub" x-show="view === 'home'">Atendimento humano em até 8h úteis</div>
        <div class="sub" x-show="view === 'ia'">Assistente com a documentação do Kivo</div>
        <div class="sub" x-show="view === 'chat'" x-text="'Ticket #' + ticket.id + ' · ' + ticket.status"></div>
      </div>
      <button type="button" class="collapse-btn" @click="minimize()" title="Recolher">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </div>

    <!-- ─── Boas-vindas + atalhos ─── -->
    <div class="support-body" x-show="view === 'home'">
      <p style="margin:.1rem 0 1rem; font-size:.92rem">
        Oi<span x-text="userName ? ', ' + userName : ''"></span>! 👋 Como podemos ajudar hoje?
      </p>

      <div class="help-chat-contacts" style="margin-bottom:1rem">
        <button type="button" class="help-chat-contact" @click="startIa()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v2M12 19v2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M3 12h2M19 12h2M5.6 18.4 7 17M17 7l1.4-1.4"/><circle cx="12" cy="12" r="3.5"/></svg>
          <span><strong>Falar com a Kivo IA</strong><br /><span class="muted text-xs">Resposta na hora, com a documentação oficial do Kivo.</span></span>
        </button>
        <button type="button" class="help-chat-contact" @click="newTicket('suporte')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span><strong>Ajuda e suporte</strong><br /><span class="muted text-xs">Falar com uma pessoa (até 8h úteis).</span></span>
        </button>
        <button type="button" class="help-chat-contact" @click="newTicket('sugestao')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z"/><line x1="9" y1="22" x2="15" y2="22"/></svg>
          <span><strong>Sugestões e melhorias</strong><br /><span class="muted text-xs">Sua ideia pode virar recurso do Kivo.</span></span>
        </button>
        <button type="button" class="help-chat-contact" @click="shareWithFriend()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          <span><strong x-text="shared ? 'Link copiado! ✔' : 'Compartilhar com um amigo'"></strong><br /><span class="muted text-xs">Indique o Kivo para quem você gosta.</span></span>
        </button>
      </div>

      <template x-if="tickets.length">
        <div>
          <p class="muted text-xs" style="margin:.25rem 0 .5rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em">Meus atendimentos</p>
          <template x-for="t in visibleTickets" :key="t.id">
            <button type="button" class="support-ticket-item" @click="openTicket(t.id)">
              <span class="support-unread-dot" x-show="t.client_unread > 0"></span>
              <span class="t-subject" x-text="t.subject"></span>
              <span class="support-badge" :class="t.status" x-text="t.status"></span>
            </button>
          </template>
          <button type="button" class="support-ticket-more" x-show="tickets.length > 3" x-cloak
                  @click="showAllTickets = !showAllTickets"
                  x-text="showAllTickets ? 'Mostrar menos' : ('Ver histórico completo (' + tickets.length + ')')"></button>
        </div>
      </template>

      <div class="help-chat-contacts" x-show="email || phone" style="margin-top:1rem">
        <p class="muted text-xs" style="margin:0 0 .25rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em">Outros canais</p>
        <a :href="'mailto:' + email" class="help-chat-contact" x-show="email">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/></svg>
          <span x-text="email"></span>
        </a>
        <a :href="'tel:' + phone" class="help-chat-contact" x-show="phone">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span x-text="phone"></span>
        </a>
      </div>
      <div class="support-error" x-text="error"></div>
    </div>

    <!-- ─── Novo ticket ─── -->
    <div class="support-body" x-show="view === 'new'">
      <p class="support-sla" x-show="form.category !== 'sugestao'">
        Nosso atendimento humano responde em até <strong>8 horas úteis</strong>. Não contamos
        fins de semana nem feriados nacionais.
      </p>
      <form class="support-form" @submit.prevent="createTicket()">
        <label for="sup-subject">Assunto</label>
        <input id="sup-subject" type="text" x-model="form.subject" maxlength="160" required
               :placeholder="form.category === 'sugestao' ? 'Ex.: Sugestão para o PDV' : 'Ex.: Dúvida no fechamento do caixa'" />
        <label for="sup-message">Como podemos ajudar?</label>
        <textarea id="sup-message" x-model="form.message" maxlength="4000" required
                  placeholder="Descreva com detalhes — quanto mais contexto, mais rápido resolvemos."></textarea>

        <input type="file" accept="image/png,image/jpeg,image/webp" x-ref="formFile" class="sr-only" style="display:none"
               @change="onPickAttachment($event, 'form')">
        <template x-if="!form.attachment">
          <button type="button" class="btn secondary" style="width:100%; justify-content:center; margin-bottom:.4rem"
                  @click="$refs.formFile.click()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05 12.25 20.24a5.5 5.5 0 0 1-7.78-7.78l9.19-9.19a3.5 3.5 0 0 1 4.95 4.95L9.41 17.41a1.5 1.5 0 0 1-2.12-2.12l8.49-8.48"/></svg>
            Anexar print do erro
          </button>
        </template>
        <p class="support-error" x-show="attachError && !form.attachment" x-text="attachError" style="margin-top:0"></p>
        <div class="support-attach-preview" x-show="form.attachment">
          <img :src="form.attachment" alt="Print anexado">
          <span class="muted text-xs" style="flex:1">Print anexado</span>
          <button type="button" @click="form.attachment = ''; $refs.formFile.value = ''">Remover</button>
        </div>

        <button type="submit" class="btn" style="width:100%; justify-content:center" :disabled="sending">
          <span x-text="sending ? 'Abrindo chamado…' : 'Abrir chamado'"></span>
        </button>
        <div class="support-error" x-text="error"></div>
      </form>
    </div>

    <!-- ─── Kivo IA ─── -->
    <div class="support-ia" x-show="view === 'ia'">
      <div class="support-body support-thread" x-ref="aiThread">
        <template x-for="(m, i) in ai.messages" :key="i">
          <div class="support-msg" :class="m.role === 'user' ? 'right' : 'left'">
            <div class="support-avatar" :class="m.role === 'user' ? 'user' : 'ia'"
                 x-text="m.role === 'user' ? userInitial : 'IA'"></div>
            <div class="support-bubble" :class="m.role === 'user' ? 'cliente' : 'ia'">
              <div class="md" x-html="renderMd(m.content)"></div>
              <div class="support-links" x-show="m.links && m.links.length">
                <template x-for="l in (m.links || [])" :key="l.route">
                  <a class="support-link-btn" :class="{ locked: linkLocked(l) }"
                     :href="linkLocked(l) ? '#' : l.route"
                     @click="if (linkLocked(l)) { $event.preventDefault(); openLink(l); }">
                    <svg x-show="!linkLocked(l)" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    <svg x-show="linkLocked(l)" x-cloak width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <span x-text="linkLocked(l) ? (canEditCaps ? 'Ativar e abrir: ' + l.label : l.label + ' (recurso desativado)') : l.label"></span>
                  </a>
                </template>
              </div>
              <div class="meta" x-text="(m.role === 'user' ? 'Você' : 'Kivo IA') + (m.ts ? ' · ' + fmtWhen(m.ts) : '')"></div>
            </div>
          </div>
        </template>
        <div class="support-msg left" x-show="ai.sending" x-cloak>
          <div class="support-avatar ia">IA</div>
          <div class="support-bubble ia support-typing-bubble">
            <span class="support-typing"><i></i><i></i><i></i></span>
          </div>
        </div>
        <p class="muted text-xs" x-show="!ai.messages.length && !ai.sending" style="text-align:center">
          Pergunte sobre qualquer recurso do Kivo — eu respondo com a documentação oficial.
        </p>
      </div>
      <div class="support-ai-error" x-show="ai.error" x-cloak>
        <span x-text="ai.error"></span>
        <button type="button" class="support-err-toggle" x-show="ai.errorDetail" x-cloak
                @click="ai.showError = !ai.showError"
                x-text="ai.showError ? 'ocultar erro' : 'exibir erro'"></button>
        <pre class="support-err-detail" x-show="ai.showError" x-cloak x-text="ai.errorDetail"></pre>
      </div>
      <div class="support-input-row">
        <textarea x-model="ai.draft" x-ref="aiDraft" placeholder="Pergunte para a Kivo IA…" maxlength="4000" rows="1"
                  @keydown.enter.prevent="if (!$event.shiftKey) sendIa(); else ai.draft += '\n'"></textarea>
        <button type="button" class="support-send-btn" @click="sendIa()" :disabled="ai.sending || !ai.draft.trim()" title="Enviar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
        </button>
      </div>
      <div class="support-note">
        A IA pode errar. Precisa de uma pessoa? Atendimento em até 8h úteis (sem fins de semana e feriados).
        <button type="button" class="btn secondary small" @click="newTicket('suporte')">Falar com um atendente</button>
        <button type="button" class="btn secondary small" x-show="canEditCaps && disabledCapsCount > 0" x-cloak
                @click="enableAllCaps()">
          Ativar recursos desativados (<span x-text="disabledCapsCount"></span>)
        </button>
      </div>
    </div>

    <!-- ─── Conversa ─── -->
    <div x-show="view === 'chat'">
      <div class="support-body support-thread" x-ref="thread">
        <template x-for="m in messages" :key="m.id">
          <div class="support-msg" :class="m.sender === 'cliente' ? 'right' : 'left'">
            <div class="support-avatar" :class="avatarClass(m)" x-text="avatarInitial(m)"></div>
            <div class="support-bubble" :class="m.sender === 'cliente' ? 'cliente' : (m.sender === 'ia' ? 'ia' : 'suporte')">
              <div class="support-text" x-text="m.body" x-show="m.body"></div>
              <img class="attachment" x-show="m.attachment" :src="m.attachment" alt="Print anexado" @click="window.open(m.attachment, '_blank')">
              <div class="meta" x-text="(m.sender === 'suporte' ? 'Suporte Kivo' : (m.sender === 'ia' ? 'Kivo IA' : (m.sender_name || 'Você'))) + ' · ' + fmtWhen(m.created_at)"></div>
            </div>
          </div>
        </template>
        <p class="muted text-xs" x-show="!messages.length" style="text-align:center">Carregando conversa…</p>
      </div>
      <p class="support-error" x-show="attachError && !draftAttachment" x-text="attachError" style="padding:0 1.25rem"></p>
      <div class="support-attach-preview" x-show="draftAttachment" style="padding:0 1.25rem">
        <img :src="draftAttachment" alt="Print anexado">
        <span class="muted text-xs" style="flex:1">Print anexado</span>
        <button type="button" @click="draftAttachment = ''; $refs.draftFile.value = ''">Remover</button>
      </div>
      <div class="support-input-row" x-show="ticket.status === 'aberto'">
        <input type="file" accept="image/png,image/jpeg,image/webp" x-ref="draftFile" style="display:none"
               @change="onPickAttachment($event, 'draft')">
        <button type="button" class="support-attach-btn" @click="$refs.draftFile.click()" title="Anexar print">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05 12.25 20.24a5.5 5.5 0 0 1-7.78-7.78l9.19-9.19a3.5 3.5 0 0 1 4.95 4.95L9.41 17.41a1.5 1.5 0 0 1-2.12-2.12l8.49-8.48"/></svg>
        </button>
        <textarea x-model="draft" x-ref="draftBox" placeholder="Escreva sua mensagem…" maxlength="4000"
                  @keydown.enter.prevent="if (!$event.shiftKey) sendMessage(); else draft += '\n'"></textarea>
        <button type="button" class="support-send-btn" @click="sendMessage()" :disabled="sending || (!draft.trim() && !draftAttachment)" title="Enviar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
        </button>
      </div>
      <div class="support-note" x-show="ticket.status === 'aberto'">
        <button type="button" class="btn secondary small" @click="closeTicket()">Encerrar atendimento</button>
      </div>
      <div class="support-closed-note" x-show="ticket.status !== 'aberto'">
        Este atendimento foi encerrado. Precisa de mais ajuda?
        <a href="#" @click.prevent="newTicket('suporte')">Abra um novo chamado</a>.
      </div>
      <div class="support-error" x-text="error" style="padding:0 1.25rem .75rem"></div>
    </div>
  </section>

  <!-- Confirmação em modal: o Electron não implementa window.confirm/alert. -->
  <div class="support-confirm-backdrop" x-show="confirm.open" x-cloak @click.self="confirmResolve(false)">
    <div class="support-confirm" role="dialog" aria-modal="true">
      <h3 x-text="confirm.title"></h3>
      <p x-text="confirm.message"></p>
      <div class="support-confirm-actions">
        <button type="button" class="btn secondary small" @click="confirmResolve(false)">Cancelar</button>
        <button type="button" class="btn small" :class="{ danger: confirm.danger }" @click="confirmResolve(true)" x-text="confirm.okLabel"></button>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  function helpChat() {
    return {
      view: 'home',
      panelOpen: false,
      userName: <%- JSON.stringify(typeof user !== 'undefined' && user ? (user.name || '').split(' ')[0] : '') %>,
      tickets: [], unread: 0, showAllTickets: false,
      ticket: { id: 0, subject: '', status: '' }, messages: [],
      form: { subject: '', message: '', category: 'suporte', attachment: '' },
      ai: {
        messages: [], draft: '', ticketId: 0, sending: false, error: '', errorDetail: '', showError: false,
      },
      caps: {}, canEditCaps: false, capsLoaded: false,
      /** Modal de confirmação próprio (Electron não implementa window.confirm/alert). */
      confirm: { open: false, title: '', message: '', okLabel: 'Confirmar', danger: false, resolve: null },
      draft: '', draftAttachment: '', attachError: '', sending: false, error: '', shared: false,
      email: '', phone: '', contactsLoaded: false,
      pollTimer: null,
      bgTimer: null,

      /** Escapa HTML — o conteúdo da IA vem do modelo e nunca deve virar markup executável. */
      escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
          { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
        ));
      },
      /** Markdown mínimo e seguro (negrito, itálico, código, listas, títulos e parágrafos). */
      renderMd(text) {
        const esc = this.escapeHtml(text);
        const inline = (s) => s
          .replace(/`([^`]+)`/g, '<code>$1</code>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/__([^_]+)__/g, '<strong>$1</strong>')
          .replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>')
          .replace(/(^|[^_])_([^_\n]+)_/g, '$1<em>$2</em>');
        const lines = esc.split('\n');
        let html = '';
        let list = null;
        const closeList = () => { if (list) { html += '</' + list + '>'; list = null; } };
        for (const raw of lines) {
          const line = raw.replace(/\s+$/, '');
          if (!line.trim()) { closeList(); html += '<div class="md-gap"></div>'; continue; }
          const h = /^(#{1,4})\s+(.*)$/.exec(line);
          if (h) { closeList(); html += '<div class="md-h">' + inline(h[2]) + '</div>'; continue; }
          const ul = /^\s*[-*+]\s+(.*)$/.exec(line);
          if (ul) { if (list !== 'ul') { closeList(); html += '<ul>'; list = 'ul'; } html += '<li>' + inline(ul[1]) + '</li>'; continue; }
          const ol = /^\s*\d+[.)]\s+(.*)$/.exec(line);
          if (ol) { if (list !== 'ol') { closeList(); html += '<ol>'; list = 'ol'; } html += '<li>' + inline(ol[1]) + '</li>'; continue; }
          closeList();
          html += '<div>' + inline(line) + '</div>';
        }
        closeList();
        return html;
      },

      /** Inicial do usuário logado (avatar das mensagens dele). */
      get userInitial() {
        return (this.userName || '?').charAt(0).toUpperCase();
      },
      avatarClass(m) {
        return m.sender === 'suporte' ? 'suporte' : m.sender === 'ia' ? 'ia' : 'user';
      },
      avatarInitial(m) {
        if (m.sender === 'suporte') return 'S';
        if (m.sender === 'ia') return 'IA';
        return this.userInitial;
      },
      /** Hora da mensagem hoje; vira data + hora quando é de outro dia (mais antiga). */
      fmtWhen(v) {
        if (!v) return '';
        const d = v instanceof Date ? v : new Date(v);
        if (isNaN(d.getTime())) return '';
        const now = new Date();
        const p2 = (n) => String(n).padStart(2, '0');
        const hm = p2(d.getHours()) + ':' + p2(d.getMinutes());
        if (d.toDateString() === now.toDateString()) return hm;
        return p2(d.getDate()) + '/' + p2(d.getMonth() + 1) + ' ' + hm;
      },

      /** Recurso (capability) exigido por um link da IA está desligado? */
      linkLocked(l) {
        return !!(l && l.capability && this.caps[l.capability] === false);
      },
      get disabledCapsCount() {
        return Object.keys(this.caps).filter((k) => this.caps[k] === false).length;
      },
      async loadCaps() {
        if (this.capsLoaded) return;
        try {
          const r = await fetch('/api/ai/capabilities');
          const d = await r.json();
          const data = d.data !== undefined ? d.data : d;
          this.canEditCaps = !!data.canEdit;
          const map = {};
          (data.capabilities || []).forEach((c) => { map[c.key] = !!c.enabled; });
          this.caps = map;
          this.capsLoaded = true;
        } catch (e) { /* sem lista, não bloqueia os links */ }
      },
      async enableCap(key) {
        try {
          const r = await fetch('/api/core/capabilities/' + encodeURIComponent(key), {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: true }),
          });
          if (!r.ok) return false;
          this.caps = { ...this.caps, [key]: true };
          return true;
        } catch (e) { return false; }
      },
      /** Abre a tela; se o recurso estiver desligado e o usuário puder, ativa antes de ir. */
      async openLink(l) {
        if (this.linkLocked(l)) {
          if (!this.canEditCaps) {
            this.ai.error = 'Este recurso está desativado. Peça a um administrador para ativá-lo.';
            return;
          }
          const ok = await this.enableCap(l.capability);
          if (!ok) { this.ai.error = 'Não foi possível ativar o recurso. Fale com um administrador.'; return; }
        }
        window.location.href = l.route;
      },
      /** Liga todos os recursos desativados (o usuário pediu: "ativar todos"). */
      async enableAllCaps() {
        const keys = Object.keys(this.caps).filter((k) => this.caps[k] === false);
        if (!keys.length) return;
        const ok = await this.askConfirm({ title: 'Ativar recursos', message: 'Ativar todos os ' + keys.length + ' recursos desativados deste sistema?', okLabel: 'Ativar todos' });
        if (!ok) return;
        for (const k of keys) { await this.enableCap(k); }
      },

      /** Confirmação em modal (Promise). Usar no lugar de window.confirm/alert. */
      askConfirm(opts) {
        return new Promise((resolve) => {
          this.confirm = {
            open: true,
            title: opts.title || '',
            message: opts.message || '',
            okLabel: opts.okLabel || 'Confirmar',
            danger: !!opts.danger,
            resolve,
          };
        });
      },
      confirmResolve(ok) {
        const r = this.confirm && this.confirm.resolve;
        this.confirm = { open: false, title: '', message: '', okLabel: 'Confirmar', danger: false, resolve: null };
        if (r) r(ok);
      },

      async api(path, opts) {
        const r = await fetch('/api/support' + path, opts ? {
          method: opts.method || 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: opts.body !== undefined ? JSON.stringify(opts.body) : undefined,
        } : undefined);
        const j = await r.json().catch(() => ({}));
        if (!r.ok || j.success === false) throw new Error(j.error || 'Falha ao falar com o suporte.');
        return j.data !== undefined ? j.data : j;
      },

      persist() {
        try {
          localStorage.setItem('kivo:support-open', this.panelOpen ? '1' : '0');
          localStorage.setItem('kivo:support-view', this.view);
        } catch (e) { /* localStorage indisponível, segue */ }
      },

      /** Na home, mostra só os 3 chamados mais recentes; "ver histórico" revela todos. */
      get visibleTickets() {
        return this.showAllTickets ? this.tickets : this.tickets.slice(0, 3);
      },

      async init() {
        // Badge de não-lidas no botão flutuante; silencioso se offline/sem licença.
        try { await this.refreshTickets(); } catch (e) {}
        // Atualiza o badge a cada 30s mesmo com o chat fechado (2min no modo leve: é um
        // badge, não uma conversa aberta — a resposta do suporte não fica menos visível).
        const leve = document.documentElement.getAttribute('data-lite') === '1';
        this.bgTimer = setInterval(() => {
          this.refreshTickets().catch(() => {});
        }, leve ? 120000 : 30000);
        // Reabre o painel onde o usuário deixou (para ele seguir usando o sistema).
        try {
          if (localStorage.getItem('kivo:support-open') === '1') {
            this.panelOpen = true;
            if (localStorage.getItem('kivo:support-view') === 'ia') await this.startIa();
          }
        } catch (e) { /* sem persistência */ }
      },
      async refreshTickets() {
        const d = await this.api('/tickets');
        this.tickets = d.tickets || [];
        this.unread = this.tickets.reduce((n, t) => n + (t.client_unread || 0), 0);
      },

      async open() {
        this.error = '';
        this.panelOpen = true;
        this.persist();
        try { await this.refreshTickets(); } catch (e) { this.error = e.message; }
        if (!this.contactsLoaded) {
          try {
            const r = await fetch('/api/license/status');
            if (r.ok) {
              const d = await r.json();
              const s = d.data !== undefined ? d.data : d;
              this.email = s.supportEmail || '';
              this.phone = s.supportPhone || '';
            }
          } catch (e) { /* sem contatos, segue o jogo */ }
          this.contactsLoaded = true;
        }
      },
      minimize() {
        this.panelOpen = false;
        this.persist();
      },

      goHome() {
        this.stopPolling();
        this.view = 'home';
        this.error = '';
        this.persist();
        this.refreshTickets().catch(() => {});
      },
      novoTitulo() {
        return this.form.category === 'sugestao' ? 'Sugestões e melhorias' : 'Ajuda e suporte';
      },

      newTicket(category) {
        this.form = { subject: '', message: '', category, attachment: '' };
        this.attachError = '';
        this.error = '';
        this.view = 'new';
        this.persist();
      },

      /** Abre o chat da Kivo IA. Recarrega a conversa anterior (memória) e o chamado só nasce na 1ª mensagem. */
      async startIa() {
        this.error = '';
        this.ai.error = '';
        this.ai.errorDetail = '';
        this.ai.showError = false;
        this.view = 'ia';
        this.persist();
        await this.loadIaStatus();
        await this.loadCaps();
        if (!this.ai.messages.length) await this.restoreAi();
        this.$nextTick(() => this.scrollAi());
        this.$nextTick(() => this.$refs.aiDraft && this.$refs.aiDraft.focus());
      },
      async loadIaStatus() {
        try {
          const r = await fetch('/api/ai/status');
          const d = await r.json();
          if (d.enabled === false) {
            this.ai.error = 'O assistente está indisponível no momento. Fale com um atendente.';
          }
        } catch (e) { /* sem status, segue */ }
      },
      /** Recupera a conversa de IA salva no chamado (para a IA não perder o fio do raciocínio). */
      async restoreAi() {
        let id = 0;
        try { id = Number(localStorage.getItem('kivo:ai-ticket') || 0); } catch (e) { id = 0; }
        if (!id) return;
        try {
          const d = await this.api('/tickets/' + id + '/messages');
          if (!d.ticket || d.ticket.status !== 'aberto') { this.clearAiTicket(); return; }
          this.ai.ticketId = id;
          this.ai.messages = (d.messages || [])
            .filter((m) => m.body)
            .map((m) => ({
              role: m.sender === 'cliente' ? 'user' : 'assistant',
              content: m.body,
              ts: m.created_at ? new Date(m.created_at).getTime() : Date.now(),
            }));
        } catch (e) { this.clearAiTicket(); }
      },
      saveAiTicket() {
        try { localStorage.setItem('kivo:ai-ticket', String(this.ai.ticketId)); } catch (e) { /* ignora */ }
      },
      clearAiTicket() {
        this.ai.ticketId = 0;
        try { localStorage.removeItem('kivo:ai-ticket'); } catch (e) { /* ignora */ }
      },
      /** Garante um chamado aberto para a conversa; se o anterior foi encerrado, abre outro. */
      async ensureTicket(text) {
        if (this.ai.ticketId) {
          try {
            await this.api('/tickets/' + this.ai.ticketId + '/messages', { body: { body: text } });
            return;
          } catch (e) {
            this.clearAiTicket();
          }
        }
        const d = await this.api('/tickets', { body: {
          subject: ('Kivo IA — ' + text).slice(0, 120),
          message: text,
          category: 'suporte',
        } });
        this.ai.ticketId = d.id;
        this.saveAiTicket();
        this.refreshTickets().catch(() => {});
      },
      /**
       * Envia a pergunta para a Kivo IA. A primeira mensagem abre um chamado no Kivo Web (para
       * o suporte ver depois) e cada resposta é gravada no mesmo chamado como sender 'ia' — a
       * conversa inteira fica registrada e é recarregada na próxima visita.
       */
      async sendIa() {
        const text = this.ai.draft.trim();
        if (!text || this.ai.sending) return;
        this.ai.error = '';
        this.ai.draft = '';
        this.ai.messages.push({ role: 'user', content: text, ts: Date.now() });
        this.ai.sending = true;
        this.scrollAi();
        try {
          await this.ensureTicket(text);
          const r = await fetch('/api/ai/chat', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              messages: this.ai.messages.map((m) => ({ role: m.role, content: m.content })),
            }),
          });
          const d = await r.json().catch(() => ({}));
          if (!r.ok) {
            const err = new Error(d.error || 'Falha ao consultar a Kivo IA.');
            err.detail = d.detail || '';
            throw err;
          }
          this.ai.error = '';
          this.ai.errorDetail = '';
          this.ai.showError = false;
          const answer = d.content || '(resposta vazia)';
          this.ai.messages.push({
            role: 'assistant',
            content: answer,
            links: Array.isArray(d.links) ? d.links : [],
            ts: Date.now(),
          });
          if (this.ai.ticketId) {
            const stored = answer.length > 8000 ? answer.slice(0, 8000) : answer;
            this.api('/tickets/' + this.ai.ticketId + '/messages', { body: { body: stored, ai: true } }).catch(() => {});
          }
          this.scrollAi();
        } catch (e) {
          this.ai.error = e.message || 'Falha ao falar com a Kivo IA.';
          this.ai.errorDetail = e && e.detail ? e.detail : '';
          this.ai.showError = false;
        } finally {
          this.ai.sending = false;
        }
      },
      scrollAi() {
        this.$nextTick(() => {
          const el = this.$refs.aiThread;
          if (el) el.scrollTop = el.scrollHeight;
        });
      },
      /** Converte o print escolhido em data URI e guarda no form (novo ticket) ou no
       * rascunho da conversa — sem upload/storage à parte, cabe direto na mensagem. */
      onPickAttachment(event, target) {
        const file = event.target.files && event.target.files[0];
        event.target.value = '';
        if (!file) return;
        this.attachError = '';
        if (file.size > 4 * 1024 * 1024) {
          this.attachError = 'Imagem muito grande (máx. 4MB).';
          return;
        }
        const reader = new FileReader();
        reader.onload = () => {
          if (target === 'form') this.form.attachment = reader.result;
          else this.draftAttachment = reader.result;
        };
        reader.readAsDataURL(file);
      },
      async createTicket() {
        if (this.sending) return;
        this.sending = true; this.error = '';
        try {
          const d = await this.api('/tickets', { body: this.form });
          await this.openTicket(d.id);
        } catch (e) { this.error = e.message; }
        this.sending = false;
      },

      async openTicket(id) {
        this.error = '';
        this.attachError = '';
        this.draftAttachment = '';
        this.view = 'chat';
        this.persist();
        this.messages = [];
        this.ticket = { id, subject: '…', status: '' };
        try {
          await this.loadMessages(id);
          this.startPolling();
          this.$nextTick(() => this.$refs.draftBox && this.$refs.draftBox.focus());
        } catch (e) { this.error = e.message; }
      },
      async loadMessages(id) {
        const d = await this.api('/tickets/' + id + '/messages');
        this.ticket = d.ticket;
        const atBottom = this.isThreadAtBottom();
        const grew = (d.messages || []).length !== this.messages.length;
        this.messages = d.messages || [];
        if (grew && atBottom) this.$nextTick(() => this.scrollThread());
      },
      async sendMessage() {
        const body = this.draft.trim();
        const attachment = this.draftAttachment;
        if ((!body && !attachment) || this.sending) return;
        this.sending = true; this.error = '';
        try {
          await this.api('/tickets/' + this.ticket.id + '/messages', { body: { body, attachment } });
          this.draft = '';
          this.draftAttachment = '';
          await this.loadMessages(this.ticket.id);
          this.scrollThread();
        } catch (e) { this.error = e.message; }
        this.sending = false;
      },
      async closeTicket() {
        const ok = await this.askConfirm({
          title: 'Encerrar atendimento',
          message: 'Encerrar este atendimento? Você pode abrir um novo chamado quando quiser.',
          okLabel: 'Encerrar',
          danger: true,
        });
        if (!ok) return;
        try {
          await this.api('/tickets/' + this.ticket.id + '/close', { body: {} });
          this.stopPolling();
          this.view = 'home';
          this.persist();
          this.error = '';
          await this.refreshTickets();
        } catch (e) { this.error = e.message; }
      },

      startPolling() {
        this.stopPolling();
        // Novas respostas do suporte aparecem sem recarregar; só enquanto a conversa está aberta.
        this.pollTimer = setInterval(() => {
          if (this.view === 'chat' && this.panelOpen) this.loadMessages(this.ticket.id).catch(() => {});
        }, 5000);
      },
      stopPolling() {
        if (this.pollTimer) { clearInterval(this.pollTimer); this.pollTimer = null; }
      },
      isThreadAtBottom() {
        const el = this.$refs.thread;
        return !el || el.scrollHeight - el.scrollTop - el.clientHeight < 60;
      },
      scrollThread() {
        const el = this.$refs.thread;
        if (el) el.scrollTop = el.scrollHeight;
      },

      destroy() {
        this.stopPolling();
        if (this.bgTimer) { clearInterval(this.bgTimer); this.bgTimer = null; }
      },

      async shareWithFriend() {
        try {
          const d = await this.api('/share-link');
          await navigator.clipboard.writeText(
            'Conhece o Kivo? É o sistema que eu uso para PDV, estoque e financeiro — funciona até sem internet. Dá uma olhada: ' + d.url,
          );
          this.shared = true;
          setTimeout(() => { this.shared = false; }, 2500);
        } catch (e) { this.error = 'Não consegui copiar o link.'; }
      },
    };
  }
</script>
