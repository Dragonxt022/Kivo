<%#
  Diálogo "Kivo no celular": instalação como aplicativo, tela cheia e notificações.

  O Kivo é aberto no celular pelo navegador (rede local ou Kivo Web). Instalado na tela
  inicial, o manifest abre em modo standalone — sem a barra de endereço. Quando o
  navegador não oferece instalação (Android em http:// da rede local), este diálogo
  orienta o caminho do menu e oferece "tela cheia" como alternativa imediata.

  Incluído pelo nav em todas as telas; os gatilhos (ícone do topo, menu "Mais" e menu do
  usuário) estão no próprio nav.
-%>
<dialog id="kivo-app-dlg" class="kivo-app-dlg">
  <div class="kivo-app-head">
    <span class="kivo-app-head-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
        <rect x="6" y="2.5" width="12" height="19" rx="2.5"/><line x1="12" y1="18" x2="12.01" y2="18"/>
      </svg>
    </span>
    <div class="kivo-app-head-text">
      <h2>Kivo no celular</h2>
      <p>Use sem a barra do navegador e receba os avisos de pedido pronto.</p>
    </div>
    <button type="button" class="btn-icon" id="kivo-app-close" aria-label="Fechar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <p class="kivo-app-status" id="kivo-app-status"></p>

  <div class="kivo-app-actions">
    <button type="button" class="btn" id="kivo-app-install" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      Instalar aplicativo
    </button>
    <button type="button" class="btn secondary" id="kivo-app-fullscreen" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
        <path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M16 3h3a2 2 0 0 1 2 2v3"/><path d="M8 21H5a2 2 0 0 1-2-2v-3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
      </svg>
      <span id="kivo-app-fullscreen-label">Usar em tela cheia</span>
    </button>
    <button type="button" class="btn secondary" id="kivo-app-notify" hidden>Ativar notificações</button>
  </div>

  <div class="kivo-app-help" id="kivo-app-help"></div>
  <p class="kivo-app-note" id="kivo-app-note" hidden></p>

  <div class="kivo-app-foot">
    <button type="button" class="btn secondary" id="kivo-app-done">Fechar</button>
  </div>
</dialog>

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';
  if (window.KivoMobileApp) return;

  var dlg = document.getElementById('kivo-app-dlg');
  if (!dlg) return;

  var ua = navigator.userAgent || '';
  var iOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  var android = /Android/i.test(ua);
  var mobile = android || iOS || (window.matchMedia && window.matchMedia('(max-width: 820px)').matches);
  var standalone = document.documentElement.classList.contains('kivo-standalone');

  function $(id) { return document.getElementById(id); }

  function render() {
    var status = $('kivo-app-status');
    var help = $('kivo-app-help');
    var note = $('kivo-app-note');
    var install = $('kivo-app-install');
    var fullscreen = $('kivo-app-fullscreen');
    var fullscreenLabel = $('kivo-app-fullscreen-label');

    if (status) {
      status.textContent = standalone
        ? 'Você já está usando o Kivo como aplicativo.'
        : (mobile ? 'No celular, instale o Kivo para abrir em tela cheia.' : 'Abra o Kivo no celular para instalar como aplicativo.');
    }

    if (install) {
      // O prompt nativo existe apenas em navegadores que aceitam instalar este endereço
      // (HTTPS/localhost). Em http:// da rede local ele não dispara — aí ficam as
      // instruções do menu e o botão de tela cheia.
      install.hidden = standalone || !window.__kivoInstallPrompt;
    }

    if (fullscreen) {
      var canFull = !standalone && mobile && !iOS && document.documentElement.requestFullscreen;
      fullscreen.hidden = !canFull;
      if (canFull && fullscreenLabel) {
        fullscreenLabel.textContent = document.fullscreenElement ? 'Sair da tela cheia' : 'Usar em tela cheia';
      }
    }

    if (help) {
      if (standalone) {
        help.innerHTML = '';
      } else if (iOS) {
        help.innerHTML = '<p><strong>iPhone / iPad (Safari):</strong> toque em <strong>Compartilhar</strong> '
          + '(quadrado com a seta para cima) e escolha <strong>Adicionar à Tela de Início</strong>.</p>';
      } else if (android) {
        help.innerHTML = '<p><strong>Android (Chrome):</strong> toque no menu <strong>⋮</strong> no canto do '
          + 'navegador e escolha <strong>Instalar aplicativo</strong> (ou <strong>Adicionar à tela inicial</strong>).</p>';
      } else {
        help.innerHTML = '<p>No computador o Kivo já roda como aplicativo. Este guia serve para o celular ou tablet.</p>';
      }
    }

    if (note) {
      if (!window.isSecureContext) {
        note.hidden = false;
        note.textContent = iOS
          ? 'No iPhone/iPad, use Compartilhar → Adicionar à Tela de Início: o Kivo abre sem a barra do navegador mesmo neste endereço local. As notificações do sistema exigem HTTPS; com o Kivo aberto, o som e o título da aba avisam.'
          : 'Este acesso é por http:// na rede local. O navegador pode não oferecer instalação nem notificações do sistema. Nesse caso, use "Usar em tela cheia" para esconder a barra e mantenha o Kivo aberto para ouvir os avisos.';
      } else if (iOS && !standalone) {
        note.hidden = false;
        note.textContent = 'No iPhone, a instalação só pode ser feita pelo Safari. Se estiver em outro navegador, abra o endereço no Safari.';
      } else {
        note.hidden = true;
      }
    }

    renderNotify();
  }

  function renderNotify() {
    var btn = $('kivo-app-notify');
    if (!btn) return;
    var api = window.KivoReadyAlerts;
    var status = api ? api.notificationPermission() : 'unsupported';
    if (status === 'default') {
      btn.hidden = false;
      btn.disabled = false;
      btn.textContent = 'Ativar notificações';
    } else if (status === 'granted') {
      btn.hidden = false;
      btn.disabled = true;
      btn.textContent = 'Notificações do sistema ativadas';
    } else if (status === 'denied') {
      btn.hidden = false;
      btn.disabled = true;
      btn.textContent = 'Notificações bloqueadas nas configurações';
    } else {
      // insecure/unsupported: o aviso explicativo já aparece no rodapé do diálogo.
      btn.hidden = true;
    }
  }

  function open() {
    render();
    try { dlg.showModal(); } catch (e) { dlg.setAttribute('open', ''); }
  }

  function close() {
    try { dlg.close(); } catch (e) { dlg.removeAttribute('open'); }
  }

  window.KivoMobileApp = { open: open, close: close, render: render };

  var openers = ['kivo-mobile-app-btn', 'kivo-mobile-app-btn-header', 'kivo-mobile-app-btn-user'];
  openers.forEach(function (id) {
    var el = $(id);
    if (el) el.addEventListener('click', function (ev) {
      ev.preventDefault();
      open();
    });
  });

  $('kivo-app-close')?.addEventListener('click', close);
  $('kivo-app-done')?.addEventListener('click', close);

  $('kivo-app-install')?.addEventListener('click', function () {
    var prompt = window.__kivoInstallPrompt;
    if (!prompt) { render(); return; }
    prompt.prompt();
    prompt.userChoice.then(function (choice) {
      if (choice && choice.outcome === 'accepted') {
        window.__kivoInstallPrompt = null;
        close();
      }
      render();
    }).catch(function () { render(); });
  });

  $('kivo-app-fullscreen')?.addEventListener('click', function () {
    try {
      if (document.fullscreenElement) {
        document.exitFullscreen?.();
      } else {
        document.documentElement.requestFullscreen?.().catch(function () {
          if (typeof window.showToast === 'function') window.showToast('Este navegador não liberou a tela cheia.', 'info');
        });
      }
    } catch (e) {
      if (typeof window.showToast === 'function') window.showToast('Este navegador não liberou a tela cheia.', 'info');
    }
  });

  $('kivo-app-notify')?.addEventListener('click', function () {
    var api = window.KivoReadyAlerts;
    if (!api) return;
    api.requestPermission().then(function () { render(); });
  });

  document.addEventListener('fullscreenchange', render);
  window.addEventListener('kivo-install-available', render);
  window.addEventListener('kivo-app-installed', function () {
    document.documentElement.classList.add('kivo-standalone');
    standalone = true;
    render();
  });
  window.addEventListener('kivo-ready-notify-changed', renderNotify);

  // Se o diálogo já estiver aberto quando o prompt de instalação chegar, mostra o botão.
  if (dlg.open) render();
})();
</script>
