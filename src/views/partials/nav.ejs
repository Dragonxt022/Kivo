<div x-data="{
  appsOpen: false, userOpen: false,
  now: new Date().toLocaleTimeString('pt-BR'),
  today: new Date().toLocaleDateString('pt-BR'),
  billingAlert: null,
  licenseStatus: null,
  cloudIssueDismissed: false,
  cashAlert: null,
  // Abrir no celular: estado do diálogo compartilhado (vive na nav para abrir o QR
  // em qualquer tela, sem navegar para a home).
  celular: { loading: false, erro: '', ativando: false, copiado: '', info: { urls: [], lanAtivo: null } },
  renewPlans: [],
  renewPlansLoading: false,
  renewPlansError: '',
  upcomingBills: null,
  notifOpen: false,
  // Mensagens da central (suporte -> loja). O sino soma as não lidas delas com os avisos
  // do sistema; a lista completa vive em /notificacoes.
  messages: [],
  cloudStatus: { configured: false, online: false },
  fmtDueDate(raw) {
    const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(raw || ''));
    return m ? `${m[3]}/${m[2]}/${m[1]}` : String(raw || '');
  },
  money(cents) {
    return (Number(cents || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  },
  planLabel(plan) {
    // Nome comercial (mandado pela nuvem) quando disponível; senão o mapa local ou a chave crua.
    const stored = this.licenseStatus && this.licenseStatus.plan === plan && this.licenseStatus.planLabel;
    return stored || ({ prata: 'Prata', ouro: 'Ouro', diamante: 'Diamante', trial: 'Teste' })[String(plan || '').toLowerCase()]
      || (plan ? String(plan) : '—');
  },
  /** Selo do plano no modal de renovação; o proxy local evita bloqueio de CSP. */
  planSealSrc(p) {
    if (!p || !p.key) return '';
    const key = String(p.key).toLowerCase();
    const builtin = ['prata', 'ouro', 'diamante'].includes(key);
    // Selo personalizado (ou padrão de plano novo, que só existe no cloud) precisa do
    // proxy; para os planos originais a imagem é a mesma local, sem rede.
    if (p.sealPath && (!builtin || String(p.sealPath).startsWith('/planos/selos/'))) {
      return '/api/license/seal?p=' + encodeURIComponent(p.sealPath);
    }
    return builtin ? '/img/plano_' + key + '.jpg' : '';
  },
  planSealFallback(ev, p) {
    const key = String((p && p.key) || '').toLowerCase();
    // Planos do catálogo têm imagem padrão no cloud (plano_default.jpg para os novos):
    // tenta o proxy antes de sumir com a imagem.
    if (['prata', 'ouro', 'diamante'].includes(key)) {
      ev.target.src = '/img/plano_' + key + '.jpg';
      ev.target.onerror = null;
    } else if (p && p.sealPath) {
      ev.target.src = '/api/license/seal?p=' + encodeURIComponent(p.sealPath);
      ev.target.onerror = null;
    } else {
      ev.target.style.display = 'none';
    }
  },
  // Planos para a modal de licença expirada: o usuário já vê as opções e pode ir direto
  // para a tela de cobrança com o plano pré-selecionado (?plan=...).
  loadRenewPlans() {
    if (this.renewPlans.length || this.renewPlansLoading) return;
    this.renewPlansLoading = true;
    this.renewPlansError = '';
    fetch('/api/billing/subscription')
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('billing'))))
      .then((d) => { this.renewPlans = Array.isArray(d?.plans) ? d.plans : []; })
      .catch(() => { this.renewPlansError = 'Não foi possível carregar os planos agora.'; })
      .finally(() => { this.renewPlansLoading = false; });
  },
  notifUserKey: <%= JSON.stringify(user ? user.username : '') %>,
  notifIconMap: { payable: 'dollar-sign', receivable: 'hand-coins', cash: 'wallet', billing: 'receipt', trial: 'sparkles', atualizacao: 'refresh-cw', licenca: 'shield-check', mensagem: 'chat' },
  atualizacao: null,
  notifIconSvg(type) {
    const name = this.notifIconMap[type];
    return (name && typeof NAV_SVG_ICONS !== 'undefined' && NAV_SVG_ICONS[name]) || '';
  },
  notifRead: [],
  notifDismissed: [],
  notifKey(kind) {
    return 'kuruk-notif-' + kind + ':' + (this.notifUserKey || 'anon');
  },
  loadNotifState() {
    try { this.notifRead = JSON.parse(localStorage.getItem(this.notifKey('read')) || '[]'); } catch (e) { this.notifRead = []; }
    try { this.notifDismissed = JSON.parse(localStorage.getItem(this.notifKey('dismissed')) || '[]'); } catch (e) { this.notifDismissed = []; }
  },
  saveNotifState() {
    try { localStorage.setItem(this.notifKey('read'), JSON.stringify(this.notifRead)); } catch (e) {}
    try { localStorage.setItem(this.notifKey('dismissed'), JSON.stringify(this.notifDismissed)); } catch (e) {}
    window.dispatchEvent(new CustomEvent('kuruk-notif-changed'));
  },
  rawNotifications() {
    const list = [];
    if (this.upcomingBills) {
      for (const p of this.upcomingBills.payables || []) {
        list.push({ id: 'p' + p.id, type: 'payable', message: `A pagar: ${p.description} — vence ${this.fmtDueDate(p.due_date)}`, link: '/app/finance/pagar' });
      }
      for (const r of this.upcomingBills.receivables || []) {
        list.push({ id: 'r' + r.id, type: 'receivable', message: `A receber: ${r.description} — vence ${this.fmtDueDate(r.due_date)}`, link: '/app/finance/receber' });
      }
    }
    if (this.cashAlert) list.push({ id: 'cash', type: 'cash', message: 'Caixa aberto há mais de 24h', link: '/app/finance/caixa' });
    // Versão nova do Kuruk. O id carrega a versão para que 'lido'/'dispensado' valham só
    // para ELA — a próxima versão volta a avisar. Espelhado em views/notifications.ejs.
    if (this.atualizacao && this.atualizacao.versaoDisponivel) {
      var msgAtu = this.atualizacao.status === 'baixado'
        ? 'Kuruk ' + this.atualizacao.versaoDisponivel + ' baixado — clique para instalar'
        : 'Nova versão do Kuruk disponível (' + this.atualizacao.versaoDisponivel + ')';
      list.push({ id: 'atualizacao-' + this.atualizacao.versaoDisponivel, type: 'atualizacao', message: msgAtu, link: '/admin/configuracoes#atualizacao' });
    }
    if (this.billingAlert && this.billingAlert.count) {
      list.push({ id: 'billing', type: 'billing', message: `${this.billingAlert.count} cobrança(s) da licença vencendo`, link: '/admin/cobrancas' });
    }
    // Empresa recusada pela nuvem (excluída/desativada ou chave trocada): o Kuruk segue
    // funcionando até a validade local, mas o lojista precisa saber por que o sync parou.
    if (this.licenseStatus && this.licenseStatus.cloudIssue) {
      list.push({ id: 'licenca-nuvem', type: 'licenca', message: 'Sua empresa não está mais ativa no servidor — o Kuruk segue funcionando até a licença vencer', link: '/admin/configuracoes' });
    }
    if (this.licenseStatus && this.licenseStatus.plan === 'trial' && this.licenseStatus.status !== 'expirada') {
      const d = this.licenseStatus.daysRemaining;
      const msg = d != null ? (d > 0 ? `Período de teste — faltam ${d} dia(s)` : 'Período de teste — expira hoje') : 'Período de teste';
      list.push({ id: 'trial', type: 'trial', message: msg, link: '/admin/cobrancas' });
    }
    // Licença vencida (tolerância) ou perto de vencer: contagem regressiva até o bloqueio.
    // O bloqueio acontece no fim da tolerância (vencimento + dias de tolerância).
    if (this.licenseStatus && this.licenseStatus.status === 'tolerancia') {
      const d = this.licenseStatus.daysUntilBlock;
      list.push({ id: 'licenca-bloqueio', type: 'licenca', message: d != null ? `Licença vencida — bloqueio em ${d} dia(s)` : 'Licença vencida — bloqueio a caminho', link: '/admin/configuracoes' });
    } else if (this.licenseStatus && this.licenseStatus.status === 'valida' && this.licenseStatus.plan !== 'trial' && this.licenseStatus.daysRemaining != null && this.licenseStatus.daysRemaining <= 7) {
      const d = this.licenseStatus.daysRemaining;
      list.push({ id: 'licenca-vencendo', type: 'licenca', message: d > 0 ? `Sua licença vence em ${d} dia(s)` : 'Sua licença vence hoje', link: '/admin/configuracoes' });
    }
    return list;
  },
  get notifications() {
    return this.rawNotifications()
      .filter((n) => !this.notifDismissed.includes(n.id))
      .map((n) => ({ ...n, read: this.notifRead.includes(n.id) }));
  },
  get unreadCount() {
    return this.notifications.filter((n) => !n.read).length;
  },
  pruneNotifState() {
    const ids = new Set(this.rawNotifications().map((n) => n.id));
    const nextRead = this.notifRead.filter((id) => ids.has(id));
    const nextDismissed = this.notifDismissed.filter((id) => ids.has(id));
    if (nextRead.length !== this.notifRead.length || nextDismissed.length !== this.notifDismissed.length) {
      this.notifRead = nextRead;
      this.notifDismissed = nextDismissed;
      this.saveNotifState();
    }
  },
  markNotifRead(id) {
    if (!this.notifRead.includes(id)) { this.notifRead.push(id); this.saveNotifState(); }
  },
  markAllNotifRead() {
    this.notifRead = this.rawNotifications().map((n) => n.id);
    this.saveNotifState();
  },
  dismissNotif(id) {
    if (!this.notifDismissed.includes(id)) { this.notifDismissed.push(id); this.saveNotifState(); }
  },
  async loadMessages() {
    try {
      const r = await fetch('/api/messages');
      if (r.ok) { const d = await r.json(); this.messages = d.messages || []; }
    } catch (e) { /* sem conexão: mantém o que já tem */ }
  },
  get unreadMessages() {
    return this.messages.filter((m) => !m.read);
  },
  // Soma do sino: avisos do sistema + mensagens não lidas da central.
  get totalUnread() {
    return this.unreadCount + this.unreadMessages.length;
  },
  markAllMessagesRead() {
    for (const m of this.unreadMessages) {
      m.read = true;
      fetch('/api/messages/' + encodeURIComponent(m.uuid) + '/read', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ read: true }),
      }).catch(() => {});
    }
    window.dispatchEvent(new CustomEvent('kuruk-messages-changed'));
  },
  checkCloudStatus() {
    fetch('/api/sync/status').then((r) => r.ok ? r.json() : null).then((data) => { if (data) this.cloudStatus = data; }).catch(() => { this.cloudStatus = { configured: true, online: false }; });
  },
  // Revalida o 'caixa aberto há mais de 24h' e LIMPA o alerta quando o caixa já foi fechado.
  // Sem o clear, o estado antigo do Alpine voltava junto ao retornar para uma página em
  // bfcache (depois de fechar o caixa), e a modal reaparecia até clicar em 'Depois'.
  loadCashAlert() {
    // Na própria tela do Caixa o turno aberto já aparece no topo. Quando ela é aberta
    // pelo botão Fechar caixa do aviso (?fechar=1), o fechamento vem em modal — repetir
    // o aviso aqui empilhava duas janelas e, depois de confirmar o fechamento, a modal de
    // caixa aberto há mais de 24h continuava na frente da tela.
    if (location.pathname === '/app/finance/caixa') {
      this.cashAlert = null;
      return Promise.resolve();
    }
    return fetch('/api/finance/cash/current')
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const lic = this.licenseStatus;
        const renovando = lic && ['tolerancia', 'expirada', 'bloqueada'].includes(lic.status);
        // Licença vencida/prestes a bloquear: o foco é renovar. O aviso de caixa aberto
        // competia com a renovação e travava o usuário em duas modais.
        this.cashAlert = (d && d.open && d.openTooLong && !renovando) ? d : null;
      })
      .catch(() => {});
  },
  // ─── Abrir no celular (mesma rede local) ───────────────────────────────────
  // O diálogo mora na nav (e não só na home) para o atalho do cabeçalho abrir o QR na
  // tela em que o usuário está. A home também o aciona pelo evento kuruk-open-celular.
  async abrirCelular() {
    const dlg = this.$refs.dlgCelular;
    if (!dlg) return;
    if (!dlg.open) dlg.showModal();
    await this.carregarCelular();
  },
  fecharCelular() {
    const dlg = this.$refs.dlgCelular;
    if (dlg && dlg.open) dlg.close();
  },
  async carregarCelular() {
    this.celular.loading = true;
    this.celular.erro = '';
    try {
      const r = await fetch('/api/settings/network-info');
      if (!r.ok) throw new Error('HTTP ' + r.status);
      this.celular.info = await r.json();
    } catch (e) {
      this.celular.erro = 'Não foi possível consultar os endereços da rede local.';
    } finally {
      this.celular.loading = false;
    }
  },
  async ativarCelular() {
    if (this.celular.ativando) return;
    this.celular.ativando = true;
    try {
      const r = await fetch('/api/settings/rede.acesso_local', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ value: '1' }),
      });
      if (!r.ok) throw new Error('HTTP ' + r.status);
      showToast('Acesso pela rede local ativado.', 'success');
      // A troca do host roda no servidor logo depois desta resposta; reler o estado
      // real troca o botão pelos QR codes sem precisar fechar e abrir o dialog.
      setTimeout(() => this.carregarCelular(), 900);
      setTimeout(() => { this.carregarCelular(); this.celular.ativando = false; }, 2500);
    } catch (e) {
      showToast('Não foi possível ativar o acesso pela rede local.', 'error');
      this.celular.ativando = false;
    }
  },
  async copiarCelular(url) {
    const ok = await this.copiarTexto(url);
    if (ok) {
      this.celular.copiado = url;
      setTimeout(() => { if (this.celular.copiado === url) this.celular.copiado = ''; }, 1500);
    } else {
      showToast('Não foi possível copiar o endereço.', 'error');
    }
  },
  async copiarTexto(txt) {
    // navigator.clipboard só existe em contexto seguro (localhost/HTTPS). Quando o
    // próprio Kuruk é aberto pelo IP da rede (HTTP), cai no textarea antigo.
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(txt);
        return true;
      }
    } catch (e) { /* tenta o fallback abaixo */ }
    try {
      const ta = document.createElement('textarea');
      ta.value = txt;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '-1000px';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, txt.length);
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    } catch (e) { return false; }
  },
  init() {
    // Modo leve espaça o que roda em toda página o dia inteiro: o relógio passa de 1s para
    // 10s (o minuto continua certo, é o que se lê) e a sondagem de nuvem de 25s para 2min.
    // Num PC fraco, cada acordar destes é repintura de header que compete com o PDV.
    var leve = document.documentElement.getAttribute('data-lite') === '1';
    setInterval(() => {
      var d = new Date();
      this.now = d.toLocaleTimeString('pt-BR');
      this.today = d.toLocaleDateString('pt-BR');
    }, leve ? 10000 : 1000);
    <% if (user) { %>
    this.loadNotifState();
    window.addEventListener('kuruk-notif-changed', () => this.loadNotifState());
    const jobs = [];
    // Mensagens: busca no boot da página e revalida quando a central avisa que mudou
    // (marcou lida/excluiu) ou quando a página volta do bfcache.
    jobs.push(this.loadMessages());
    window.addEventListener('kuruk-messages-changed', () => this.loadMessages());
    // `pageshow` também dispara no carregamento inicial; só interessa quando a página
    // voltou do bfcache (ev.persisted), senão era um fetch duplicado em toda navegação.
    window.addEventListener('pageshow', (ev) => { if (ev.persisted) this.loadMessages(); });
    <% if (user && user.permissions.has('billing.view')) { %>
    jobs.push(fetch('/api/billing/alert').then((r) => r.ok ? r.json() : null).then((data) => { if (data && data.count) this.billingAlert = data; }).catch(() => {}));
    <% } %>
    jobs.push(fetch('/api/license/status').then((r) => r.ok ? r.json() : null).then((data) => { this.licenseStatus = data; }).catch(() => {}));
    // Quando a licença vence, fecha o aviso de caixa que tenha aberto antes da resposta
    // da licença chegar. Os dois juntos davam a sensação de bloqueio total.
    this.$watch('licenseStatus', (v) => {
      if (v && ['tolerancia', 'expirada', 'bloqueada'].includes(v.status)) {
        this.cashAlert = null;
        if (this.$refs.cashAlertDlg?.open) this.$refs.cashAlertDlg.close();
      }
    });
    this.checkCloudStatus();
    // Aba escondida não precisa sondar nuvem; no celular isso acordava o rádio à toa.
    setInterval(() => { if (!document.hidden) this.checkCloudStatus(); }, leve ? 120000 : 25000);
    <% if (user && user.permissions.has('settings.edit')) { %>
    // Só quem pode instalar recebe o aviso: para o garçom seria um alerta que ele não
    // tem como resolver. O ciclo longo basta — a checagem em si é de hora em hora.
    const lerAtu = () => fetch('/api/updates/status').then((r) => r.ok ? r.json() : null).then((d) => { if (d && d.suportado) this.atualizacao = d; }).catch(() => {});
    jobs.push(lerAtu());
    setInterval(lerAtu, 600000);
    <% } %>
    <% if (user && user.permissions.has('finance.cash.view')) { %>
    jobs.push(this.loadCashAlert());
    // Voltando de outra tela (ex.: depois de fechar o caixa), a página pode vir do bfcache
    // com o estado antigo: revalida para a modal não reaparecer com o caixa já fechado.
    window.addEventListener('pageshow', (ev) => { if (ev.persisted) this.loadCashAlert(); });
    // A tela do Caixa avisa quando abre/fecha o turno; revalida o aviso na hora para ele
    // não continuar aberto (ou reaparecer) com o caixa já fechado.
    window.addEventListener('kuruk-cash-changed', () => this.loadCashAlert());
    <% } %>
    <% if (user && (user.permissions.has('finance.payables.view') || user.permissions.has('finance.receivables.view'))) { %>
    jobs.push(fetch('/api/finance/reports/upcoming-bills').then((r) => r.ok ? r.json() : null).then((data) => { if (data) this.upcomingBills = data; }).catch(() => {}));
    <% } %>
    // Podar só depois de todos os fetches resolverem: com dados parciais, a poda
    // apagaria ids de notificações cuja API ainda não respondeu (ex.: contas a pagar),
    // e ler/dispensar 'voltava' após um reload.
    Promise.all(jobs).then(() => this.pruneNotifState());
    <% } %>
  },
  theme: document.documentElement.getAttribute('data-theme') || 'light',
  toggleTheme() {
    this.theme = this.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', this.theme);
    try { localStorage.setItem('kuruk-theme', this.theme); } catch (e) {}
    if (document.documentElement.getAttribute('data-color-theme') === 'custom') {
      var c = window.__kurukColor && window.__kurukColor.custom;
      if (c) window.__kurukApplyCustomColor(c);
    }
  },
  currentPath: location.pathname,
  // Aba ativa da navegação inferior do celular. O PDV, as mesas e as vendas têm
  // subpáginas (comanda aberta, detalhe da venda), então o teste é por prefixo.
  navTabActive(tab) {
    var p = this.currentPath || '';
    if (tab === 'home') return p === '/';
    if (tab === 'pdv') return p === '/app/store/pdv' || p.indexOf('/app/store/pdv/') === 0;
    if (tab === 'mesas') return p === '/app/comandas/mesas' || p.indexOf('/app/comandas/') === 0;
    if (tab === 'vendas') return p === '/app/store/vendas' || p.indexOf('/app/store/vendas/') === 0;
    return false;
  },
  get navMoreActive() {
    return !this.navTabActive('home') && !this.navTabActive('pdv') && !this.navTabActive('mesas') && !this.navTabActive('vendas');
  },
  sidebarQuery: '',
  sidebarMatches(label) {
    return !this.sidebarQuery || label.toLowerCase().includes(this.sidebarQuery.toLowerCase());
  },
  get sidebarGroups() {
    return (typeof SIDEBAR_MENU_SEED !== 'undefined' ? SIDEBAR_MENU_SEED : [])
      .map((g) => ({ group: g.group, items: g.items.filter((it) => this.sidebarMatches(it.label)) }))
      .filter((g) => g.items.length);
  },
  sidebarCollapsed: document.documentElement.getAttribute('data-sidebar-collapsed') === '1',
  toggleSidebar() {
    this.sidebarCollapsed = !this.sidebarCollapsed;
    document.documentElement.setAttribute('data-sidebar-collapsed', this.sidebarCollapsed ? '1' : '0');
    try { localStorage.setItem('kuruk-sidebar-collapsed', this.sidebarCollapsed ? '1' : '0'); } catch (e) {}
  },
}">
<header class="nav">
  <div class="nav-left">
    <svg class="nav-clock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
    </svg>
    <span class="nav-clock-wrap">
      <span class="nav-date" x-text="today"></span>
      <span class="nav-clock" x-text="now"></span>
    </span>
    <% if (user) { %>
    <%# Voltar. Nasce escondido e é revelado pelo script do rodapé só fora da tela inicial —
        ao contrário de x-show, não pisca na tela antes do Alpine iniciar. %>
    <button type="button" class="btn-icon nav-back-btn" id="kuruk-voltar" hidden
            title="Voltar" aria-label="Voltar para a tela anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
      </svg>
    </button>
    <button class="btn-icon sidebar-collapse-btn" @click="toggleSidebar()" title="Recolher/expandir menu" aria-label="Recolher ou expandir menu lateral">
      <template x-if="!sidebarCollapsed">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="m11 17-5-5 5-5M18 17l-5-5 5-5"/></svg>
      </template>
      <template x-if="sidebarCollapsed">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="m13 17 5-5-5-5M6 17l5-5-5-5"/></svg>
      </template>
    </button>
    <% } %>
  </div>

  <a href="/" class="brand">
    <%# Logo do lojista quando ele enviou uma; a nossa quando não. O `onerror` cobre o caso
        do segundo computador da loja: a URL chega pelo sync, o arquivo não, e sem isso
        apareceria o ícone de imagem quebrada no cabeçalho de todas as telas. %>
    <% if (typeof empresaLogoUrl !== 'undefined' && empresaLogoUrl) { %>
      <img class="logo logo-empresa" id="kuruk-logo-empresa" src="<%= empresaLogoUrl %>" alt="<%= (typeof empresaNome !== 'undefined' && empresaNome) ? empresaNome : 'Logo da empresa' %>" />
    <% } else { %>
      <%# `src` estático (e não só `:src`): sem ele, o <img> nasce sem fonte e o navegador
          pisca o ícone de imagem quebrada a cada troca de página, até o Alpine rodar. %>
      <img class="logo" id="kuruk-logo" src="/logo_kuruk-horizontal.png" alt="Kuruk"
           :src="theme === 'dark' ? '/logo_kuruk-horizontal_branco.png' : '/logo_kuruk-horizontal.png'" />
    <% } %>
  </a>
  <script nonce="<%= cspNonce %>">
    // Corrige o logo do tema escuro JÁ na primeira pintura (o Alpine é `defer` e chegaria tarde).
    (function () {
      var l = document.getElementById('kuruk-logo');
      if (l && document.documentElement.getAttribute('data-theme') === 'dark') l.src = '/logo_kuruk-horizontal_branco.png';
    })();
  </script>

  <% if (user) { %>
  <div class="nav-end">
    <span :title="!cloudStatus.configured ? 'Licença não configurada' : (cloudStatus.online ? 'Conectado à nuvem' : 'Sem conexão com a nuvem')"
          class="flex-center cloud-status" style="padding:.3rem;color:var(--text-muted)"
          :style="{ color: !cloudStatus.configured ? 'var(--text-muted)' : (cloudStatus.online ? 'var(--primary)' : 'var(--danger)') }">
      <template x-if="cloudStatus.configured && cloudStatus.online">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="17" height="17">
          <path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>
        </svg>
      </template>
      <template x-if="!cloudStatus.configured || !cloudStatus.online">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="17" height="17">
          <line x1="1" y1="1" x2="23" y2="23"/><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/><path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/>
          <path d="M10.71 5.05A16 16 0 0 1 22.58 9"/><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>
        </svg>
      </template>
    </span>

    <% if (user.permissions.has('settings.view')) { %>
    <button type="button" class="btn-icon nav-celular-btn" title="Abrir no celular"
            aria-label="Abrir o Kuruk no celular ou tablet" @click="abrirCelular()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <rect x="6" y="2.5" width="12" height="19" rx="2.5"/><line x1="12" y1="18" x2="12.01" y2="18"/>
      </svg>
    </button>
    <% } %>

    <%# Instalar no celular / tela cheia. Só aparece no layout estreito: no desktop o Kuruk
        já é o aplicativo Electron, e um ícone a mais no cabeçalho só polui. %>
    <button type="button" class="btn-icon nav-install-btn" id="kuruk-mobile-app-btn-header"
            title="Instalar o Kuruk no celular" aria-label="Instalar o Kuruk no celular">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <rect x="6" y="2.5" width="12" height="19" rx="2.5"/><line x1="12" y1="18" x2="12.01" y2="18"/>
        <path d="M12 6v5"/><path d="m9.5 8.5 2.5 2.5 2.5-2.5"/>
      </svg>
    </button>

    <div class="dropdown" style="position:relative">
      <button class="btn-icon" @click="notifOpen = !notifOpen" title="Notificações" aria-label="Notificações">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <span x-show="totalUnread > 0" x-cloak class="notif-badge" x-text="totalUnread > 9 ? '9+' : totalUnread"></span>
      </button>
      <div class="dropdown-menu notif-dropdown" style="width:320px;max-height:400px" x-show="notifOpen" x-cloak @click.outside="notifOpen = false">
        <div class="notif-dropdown-header">
          <span>Notificações</span>
          <button type="button" @click="markAllNotifRead(); markAllMessagesRead()" x-show="totalUnread > 0">Marcar lidas</button>
        </div>
        <div style="max-height:280px;overflow-y:auto">
          <template x-if="!notifications.length && !unreadMessages.length">
            <p class="muted text-xs" style="padding:.9rem .6rem">Nenhuma notificação no momento.</p>
          </template>
          <template x-for="m in unreadMessages" :key="'msg-' + m.uuid">
            <a href="/notificacoes" class="notif-row unread" @click="notifOpen = false">
              <span class="notif-icon" x-html="notifIconSvg('mensagem')"></span>
              <span class="notif-msg" x-text="m.title"></span>
              <span class="notif-dot"></span>
            </a>
          </template>
          <template x-for="n in notifications" :key="n.id">
            <a :href="n.link" class="notif-row" :class="{ unread: !n.read }" @click="markNotifRead(n.id); notifOpen = false">
              <span class="notif-icon" x-html="notifIconSvg(n.type)"></span>
              <span class="notif-msg" x-text="n.message"></span>
              <span class="notif-dot" x-show="!n.read"></span>
            </a>
          </template>
        </div>
        <div class="notif-dropdown-footer">
          <a href="/notificacoes" @click="notifOpen = false">Ver todas as notificações</a>
        </div>
      </div>
    </div>

    <button class="user btn-reset" @mousedown.prevent @click="userOpen = true">
      <span class="name"><%= user.name %></span>
      <span class="role"><%= user.roleSlug %></span>
    </button>

    <button class="btn-icon" @mousedown.prevent @click="userOpen = true" title="Sair / trocar usuário" aria-label="Sair ou trocar usuário">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
    </button>

    <button class="btn-icon apps-toggle-btn" @click="appsOpen = true" title="Aplicações" aria-label="Aplicações">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/>
      </svg>
    </button>
  </div>
  <% } %>
</header>

<% if (user) { %>
<%
  // A barra inferior só oferece atalhos que existem no menu desta empresa/perfil.
  // `moduleMenu` já vem filtrado por permissão e pelos módulos ligados em Personalizar,
  // então um consultório não ganha uma aba "Mesas" que não leva a lugar nenhum.
  var _navHrefs = {};
  (typeof moduleMenu !== 'undefined' ? moduleMenu : []).forEach(function (item) { _navHrefs[item.href] = true; });
  var _navPdv = !!_navHrefs['/app/store/pdv'];
  var _navMesas = !!_navHrefs['/app/comandas/mesas'];
  var _navVendas = !!_navHrefs['/app/store/vendas'];
  // No modo balcão o módulo de comandas troca rótulo e ícone; a aba inferior acompanha.
  var _comandas = typeof comandasLabels !== 'undefined' ? comandasLabels : { icon: 'utensils', plural: 'Mesas' };
%>
<%# Navegação inferior do celular (LAN). No desktop ela não aparece: o menu lateral e os
    cards da tela inicial já dão conta. Aqui os polegares alcançam o que mais se usa. %>
<nav class="mobile-bottom-nav" aria-label="Navegação principal">
  <a href="/" class="mbn-item" :class="{ active: navTabActive('home') }">
    <%- svgIcon('home', 22, 22) %>
    <span>Início</span>
  </a>
  <% if (_navPdv) { %>
  <a href="/app/store/pdv" class="mbn-item" :class="{ active: navTabActive('pdv') }">
    <%- svgIcon('cart', 22, 22) %>
    <span>PDV</span>
  </a>
  <% } %>
  <% if (_navMesas) { %>
  <a href="/app/comandas/mesas" class="mbn-item" :class="{ active: navTabActive('mesas') }">
    <%- svgIcon(_comandas.icon, 22, 22) %>
    <span><%= _comandas.plural %></span>
  </a>
  <% } %>
  <% if (_navVendas) { %>
  <a href="/app/store/vendas" class="mbn-item" :class="{ active: navTabActive('vendas') }">
    <%- svgIcon('receipt', 22, 22) %>
    <span>Vendas</span>
  </a>
  <% } %>
  <button type="button" class="mbn-item" @click="appsOpen = true"
          :class="{ active: appsOpen || navMoreActive }" aria-label="Mais aplicações">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
      <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/>
      <rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/>
    </svg>
    <span>Mais</span>
  </button>
</nav>
<% } %>

<% if (user && user.permissions.has('billing.view')) { %>
<div x-show="billingAlert" x-cloak
     style="position:fixed;top:calc(var(--header-height) + 8px);left:50%;transform:translateX(-50%);z-index:40;
            background:var(--danger-bg);color:var(--danger-text);border-radius:10px;padding:.6rem 1rem;
            display:flex;align-items:center;gap:.75rem;font-size:.88rem;box-shadow:var(--shadow-sm);max-width:90vw">
  <span>⚠ <span x-text="billingAlert ? billingAlert.count : 0"></span> cobrança(s) vencendo em até 3 dias</span>
  <a href="/admin/cobrancas" style="color:inherit;font-weight:600;text-decoration:underline">ver</a>
  <button @click="billingAlert = null" class="btn-reset" style="font-size:1rem;line-height:1" aria-label="Fechar">&times;</button>
</div>
<% } %>

<% if (user) { %>
<%# Aviso de empresa recusada pela nuvem. Fica abaixo do aviso de cobrança (se houver os
    dois) e é dispensável só na sessão: o estado continua no servidor. O Kuruk segue
    operando até a validade local — ver core/license/service.ts. %>
<div x-show="licenseStatus && licenseStatus.cloudIssue && !cloudIssueDismissed" x-cloak
     style="position:fixed;top:calc(var(--header-height) + 56px);left:50%;transform:translateX(-50%);z-index:40;
            background:#fef3c7;color:#92400e;border-radius:10px;padding:.6rem 1rem;
            display:flex;align-items:center;gap:.75rem;font-size:.88rem;box-shadow:var(--shadow-sm);max-width:92vw">
  <span>
    ⚠ <span x-text="licenseStatus && licenseStatus.cloudIssue === 'empresa_removida' ? 'Sua empresa não existe mais no servidor (excluída ou desativada).' : 'A chave de licença não é mais aceita pelo servidor.'"></span>
    <template x-if="licenseStatus && licenseStatus.validUntil"><span> O Kuruk segue funcionando até <strong x-text="fmtDueDate(licenseStatus.validUntil)"></strong>.</span></template>
  </span>
  <a href="/admin/configuracoes" style="color:inherit;font-weight:600;text-decoration:underline">ver</a>
  <button @click="cloudIssueDismissed = true" class="btn-reset" style="font-size:1rem;line-height:1" aria-label="Fechar">&times;</button>
</div>
<% } %>

<%# Licença vencida dentro da tolerância: barra fixa embaixo (não conflita com os avisos do
    topo) com a contagem regressiva até o bloqueio. O modal bloqueante vem em seguida, quando
    a tolerância acaba (status 'expirada'). %>
<% if (user) { %>
<div x-show="licenseStatus && licenseStatus.status === 'tolerancia'" x-cloak
     style="position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:45;
            background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;border-radius:10px;padding:.7rem 1rem;
            display:flex;align-items:center;gap:.75rem;font-size:.9rem;box-shadow:var(--shadow-lg);max-width:92vw">
  <span>
    ⚠ Licença vencida — o Kuruk será bloqueado em
    <strong x-text="licenseStatus ? (licenseStatus.daysUntilBlock ?? 0) : 0"></strong> dia(s)
    <template x-if="licenseStatus && licenseStatus.blockAt"><span>(<strong x-text="fmtDueDate(licenseStatus.blockAt)"></strong>)</span></template>.
    Renove para não parar.
  </span>
  <a href="/admin/cobrancas" style="color:inherit;font-weight:600;text-decoration:underline">renovar</a>
</div>
<% } %>

<%# O modal bloqueante não aparece na tela de cobrança nem na de configurações: são os
    dois lugares em que o cliente consegue renovar ou colar uma nova chave. Sem essa
    exceção ele ficava preso num loop: o modal cobria a própria página de planos. %>
<% var podeRenovarForaDoBloqueio = typeof page !== 'undefined' && (page === 'billing' || page === 'settings'); %>
<% if (user && !podeRenovarForaDoBloqueio) { %>
<dialog x-ref="licenseBlockDlg" closedby="none"
        style="border:0;border-radius:16px;padding:0;box-shadow:var(--shadow-lg);width:min(780px,94vw);max-height:92vh;overflow-y:auto"
        x-init="$watch('licenseStatus', v => { const abrir = v && (v.status === 'expirada' || v.status === 'bloqueada'); if (abrir) { $refs.licenseBlockDlg.showModal(); <% if (user.permissions.has('billing.view')) { %>loadRenewPlans();<% } %> } else { $refs.licenseBlockDlg.close(); } })"
        @close.prevent="null">
  <div style="padding:1.35rem 1.45rem">
    <div style="display:grid;place-items:center;width:46px;height:46px;margin:0 auto .7rem;border-radius:14px;background:var(--danger-bg);color:var(--danger-text)">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>
    <h2 class="dialog-heading-md" style="text-align:center;margin-bottom:.45rem" x-text="licenseStatus && licenseStatus.status === 'bloqueada' ? 'Licença bloqueada' : 'Licença expirada'"></h2>
    <p class="dialog-text" style="text-align:center" x-show="licenseStatus && licenseStatus.status === 'bloqueada'">
      Detectamos uma inconsistência nesta instalação (integridade dos dados de licença ou
      dispositivo). Conecte esta máquina à internet para revalidar. Se o problema continuar, contate o suporte.
    </p>
    <p class="dialog-text" style="text-align:center" x-show="!licenseStatus || licenseStatus.status !== 'bloqueada'">
      <span x-show="licenseStatus && licenseStatus.plan === 'trial'">
        Você pode continuar com <strong>mais 1 mês grátis</strong> ou escolher um plano para renovar.
      </span>
      <span x-show="!licenseStatus || licenseStatus.plan !== 'trial'">
        Sua licença expirou. Escolha abaixo o plano para renovar e liberar novamente o acesso ao Kuruk.
      </span>
    </p>
    <p class="renew-support" x-show="licenseStatus && (licenseStatus.supportPhone || licenseStatus.supportEmail)">
      <span x-show="licenseStatus && licenseStatus.supportPhone">Telefone: <strong x-text="licenseStatus && licenseStatus.supportPhone"></strong></span>
      <span x-show="licenseStatus && licenseStatus.supportEmail">E-mail: <strong x-text="licenseStatus && licenseStatus.supportEmail"></strong></span>
    </p>

    <% if (user && user.permissions.has('billing.view')) { %>
    <button class="btn btn-full" style="margin-bottom:.8rem;justify-content:center"
            x-show="licenseStatus && licenseStatus.status !== 'bloqueada' && licenseStatus.plan === 'trial'"
            @click="fetch('/api/billing/retention/accept', { method: 'POST' }).then(r => r.json()).then(b => { if (b.ok) { showToast(b.message || 'Você ganhou mais 1 mês grátis.', 'success'); setTimeout(() => location.reload(), 1200); } else { showToast(b.error || 'Oferta não disponível.', 'error'); } }).catch(() => showToast('Falha de conexão.', 'error'))">
      Quero mais 1 mês grátis
    </button>

    <div class="renew-plans-head">
      <div>
        <strong>Escolha um plano para renovar</strong>
        <span>O acesso volta assim que o pagamento for confirmado.</span>
      </div>
      <span class="renew-current-plan" x-text="'Plano atual: ' + planLabel(licenseStatus && licenseStatus.plan)"></span>
    </div>

    <div class="renew-loading" x-show="renewPlansLoading">Carregando planos da nuvem…</div>
    <p class="renew-error" x-show="!renewPlansLoading && renewPlansError" x-text="renewPlansError"></p>

    <div class="renew-plans" x-show="!renewPlansLoading && renewPlans.length">
      <template x-for="p in renewPlans" :key="p.key">
        <a class="renew-plan" :class="{ current: p.key === licenseStatus?.plan }"
           :href="'/admin/cobrancas?plan=' + p.key">
          <span class="renew-plan-head">
            <img class="renew-plan-seal" x-show="planSealSrc(p)" :src="planSealSrc(p) || null"
                 :alt="'Selo do plano ' + p.label" @error="planSealFallback($event, p)">
            <span class="renew-plan-label" x-text="p.label"></span>
          </span>
          <span class="renew-plan-price">
            <del x-show="p.promoted" x-text="money(p.originalPriceCents || p.priceCents)"></del>
            <strong x-text="money(p.priceCents)"></strong><small>/mês</small>
          </span>
          <span class="renew-plan-promo" x-show="p.promoted"
                x-text="(p.promoLabel || 'Promoção') + (p.promoUntil ? ' · até ' + fmtDueDate(p.promoUntil) : '')"></span>
          <span class="renew-plan-desc" x-text="p.description"></span>
          <span class="renew-plan-cta" x-text="p.key === licenseStatus?.plan ? 'Renovar este plano' : 'Assinar'"></span>
        </a>
      </template>
    </div>

    <p class="renew-note" x-show="renewPlans.length">
      Na próxima tela você confirma o e-mail do pagador e escolhe Pix ou cartão.
    </p>

    <a class="btn secondary btn-full" href="/admin/cobrancas" style="margin-bottom:.55rem;justify-content:center">
      Ver todos os planos
    </a>
    <% } %>
    <button class="btn secondary btn-full"
            style="justify-content:center"
            @click="fetch('/api/auth/logout', { method: 'POST' }).then(() => location.href = '/')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sair
    </button>
  </div>
</dialog>
<% } %>

<% if (user && user.permissions.has('finance.cash.view')) { %>
<dialog x-ref="cashAlertDlg" style="border:0;border-radius:12px;padding:0;box-shadow:var(--shadow-lg);width:360px;max-width:90vw"
        x-init="$watch('cashAlert', (v) => {
          const dlg = $refs.cashAlertDlg;
          if (!dlg) return;
          // `showModal()` num diálogo já aberto lança InvalidStateError: a revalidação
          // (ex.: depois de abrir/fechar o caixa) pode disparar o watcher de novo.
          if (v && !dlg.open) dlg.showModal();
          else if (!v && dlg.open) dlg.close();
        })"
        @close="cashAlert = null">
  <div class="dialog-body-center" style="padding:1.25rem">
    <div class="dialog-icon-sm dialog-icon-warning">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
    </div>
    <h2 class="dialog-heading-md">Caixa aberto há mais de 24h</h2>
    <p class="dialog-muted-sm">
      Não esqueça de fechar o caixa. Deixá-lo aberto por muito tempo dificulta a conferência dos valores.
    </p>
    <div class="actions actions-center">
      <button class="btn secondary" @click="cashAlert = null; $refs.cashAlertDlg.close()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
        Depois
      </button>
      <button class="btn" @click="cashAlert = null; location.href = '/app/finance/caixa?fechar=1'">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="7" width="22" height="14" rx="2"/><path d="M1 10h22"/><circle cx="12" cy="14" r="2"/></svg>
        Fechar caixa
      </button>
    </div>
  </div>
</dialog>
<% } %>

<% if (user && user.permissions.has('settings.view')) { %>
<%# Diálogo "Abrir no celular" global: o atalho do cabeçalho abre o QR sem navegar
    para a home. A home também o aciona pelo evento kuruk-open-celular. %>
<dialog x-ref="dlgCelular" class="dlg-celular" @kuruk-open-celular.window="abrirCelular()">
  <div class="celular-topo">
    <span class="celular-topo-icone">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
        <rect x="6" y="2.5" width="12" height="19" rx="2.5"/><line x1="12" y1="18" x2="12.01" y2="18"/>
      </svg>
    </span>
    <div>
      <h1>Abrir no celular</h1>
      <p>Aponte a câmera para o QR code — o aparelho precisa estar na mesma rede Wi-Fi ou cabo desta máquina.</p>
    </div>
    <button type="button" class="celular-fechar" @click="fecharCelular()" title="Fechar" aria-label="Fechar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
