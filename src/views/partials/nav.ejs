<div id="toast-container" popover="manual"></div>
<%- include('partials/update-prompt') %>
<script nonce="<%= cspNonce %>">
(function(){
  // Fechamento animado de dialog: o fecha-de-verdade só acontece depois que a animação
  // de saída termina. Três armadilhas, todas já custaram modal travada aberta:
  //   1. Modo leve zera `animation` com !important (ver :root[data-lite] em app.css), o que
  //      vence o style inline daqui — o animationend nunca vinha e a modal não fechava.
  //   2. animationend borbulha: animação de um filho fechava a modal antes da hora.
  //   3. Aba em segundo plano/GPU travada segura o evento indefinidamente — daí o timeout.
  var nativeClose = HTMLDialogElement.prototype.close;
  HTMLDialogElement.prototype.close = function () {
    var d = this, args = arguments;
    if (!d.hasAttribute('open')) return nativeClose.apply(d, args);
    // Sem animação para esperar: fecha direto em vez de aguardar um evento que não vem.
    if (document.documentElement.getAttribute('data-lite') === '1') {
      d.style.animation = '';
      return nativeClose.apply(d, args);
    }
    var fechado = false, timer;
    function fim() {
      if (fechado) return;
      fechado = true;
      clearTimeout(timer);
      d.removeEventListener('animationend', aoFim);
      d.style.animation = '';
      nativeClose.apply(d, args);
    }
    function aoFim(e) { if (e.target === d) fim(); }
    d.addEventListener('animationend', aoFim);
    d.style.animation = 'dialog-out 150ms ease forwards';
    timer = setTimeout(fim, 400);
  };

  // ─── Botão Voltar do cabeçalho ───
  //
  // `history.back()` só é seguro se a tela anterior for do próprio Kuruk. Quem abriu o app
  // direto numa tela interna (atalho na área de trabalho, link aberto no celular, aba nova)
  // seria jogado para FORA do sistema ao clicar em Voltar.
  //
  // A conta é feita com uma profundidade gravada na própria entrada do histórico, e não com
  // `document.referrer`: o referrer some em navegações legítimas (aba nova, política de
  // referrer, alguns redirecionamentos), e aí a seta mandava para a tela inicial quem tinha
  // sim de onde voltar. `history.length` também não serve — conta o histórico da ABA
  // inteira, incluindo o que veio antes do Kuruk.
  //
  // Profundidade 1 = primeira tela do Kuruk nesta aba: não há para onde voltar dentro do app.
  (function () {
    var st = history.state || {};
    if (st.kurukDepth == null) {
      // Entrada nova: um nível abaixo da última que visitamos nesta aba.
      var anterior = 0;
      try { anterior = Number(sessionStorage.getItem('kuruk-nav-depth') || 0); } catch (e) {}
      var d = anterior + 1;
      st.kurukDepth = d;
      history.replaceState(st, '');
      try { sessionStorage.setItem('kuruk-nav-depth', String(d)); } catch (e) {}
    } else {
      // Entrada já conhecida (o lojista usou voltar/avançar): reancora o contador nela.
      try { sessionStorage.setItem('kuruk-nav-depth', String(st.kurukDepth)); } catch (e) {}
    }

    var b = document.getElementById('kuruk-voltar');
    // Na tela inicial não há para onde voltar: mostrar a seta ali só ensinaria que ela
    // às vezes não faz nada.
    if (b && location.pathname !== '/') b.hidden = false;
  })();

  window.kurukVoltar = function () {
    var d = (history.state || {}).kurukDepth || 1;
    if (d > 1) history.back();
    else location.href = '/';
  };

  // Por addEventListener: a CSP recusa `onclick`/`onerror` no HTML — o nonce vale para a
  // tag `script`, nunca para atributo de evento.
  document.getElementById('kuruk-voltar')?.addEventListener('click', window.kurukVoltar);

  // Fallback da logo da empresa: se o arquivo sumiu (troca de máquina, backup restaurado),
  // volta para a marca do Kuruk em vez de deixar o ícone quebrado no cabeçalho de TODAS as
  // telas. `once` no lugar do antigo `this.onerror = null` para não entrar em laço se o
  // próprio fallback falhar.
  document.getElementById('kuruk-logo-empresa')?.addEventListener('error', function () {
    this.classList.remove('logo-empresa');
    this.src = document.documentElement.getAttribute('data-theme') === 'dark'
      ? '/logo_kuruk-horizontal_branco.png'
      : '/logo_kuruk-horizontal.png';
  }, { once: true });

  // Toast global — sempre no #toast-container, nunca dentro de um <dialog>. Dialogs
  // abertos entram na "top layer" do navegador, que nenhum z-index normal supera; por
  // isso o container também é um popover (mesma top layer), reordenado pro topo dela a
  // cada toast novo, pra aparecer por cima de qualquer modal já aberta.
  window.showToast = function(msg, type) {
    type = type || 'error';
    var container = document.getElementById('toast-container');
    if (!container) return;
    var icons = { error: '<svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>', success: '<svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>', info: '<svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>', warning: '<svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>' };
    var el = document.createElement('div');
    el.className = 'toast toast-' + type;
    el.innerHTML = (icons[type] || icons.error) + '<span class="toast-msg">' + String(msg).replace(/</g,'&lt;') + '</span><button class="toast-close">&times;</button>';
    // Listener em vez de `onclick` no HTML: a CSP recusa handler inline, e o × do toast
    // ficava sem efeito — o aviso só sumia sozinho, no tempo dele.
    el.querySelector('.toast-close').addEventListener('click', function () { el.remove(); });
    container.appendChild(el);
    if (container.showPopover) {
      try {
        if (container.matches(':popover-open')) container.hidePopover();
        container.showPopover();
      } catch (e) {}
    }
    setTimeout(function(){
      el.style.opacity = '0'; el.style.transform = 'translateX(100%)';
      setTimeout(function(){
        if (el.parentElement) el.remove();
        if (container.showPopover && !container.children.length && container.matches(':popover-open')) container.hidePopover();
      }, 250);
    }, 5000);
  };

  // Erros do front-end viram telemetria pela API local (o CSP não deixa o renderer falar
  // com o cloud direto). Best-effort e silencioso: nada na tela muda por causa disto.
  window.addEventListener('error', function (ev) {
    try {
      fetch('/api/telemetry/client-error', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: ev.message, source: ev.filename, line: ev.lineno, column: ev.colno, stack: ev.error && ev.error.stack }),
      }).catch(function () {});
    } catch (e) {}
  });
  window.addEventListener('unhandledrejection', function (ev) {
    try {
      var r = ev.reason;
      fetch('/api/telemetry/client-error', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: 'promise rejeitada: ' + (r && r.message ? r.message : String(r)), stack: r && r.stack }),
      }).catch(function () {});
    } catch (e) {}
  });

  // Setas de rolagem em qualquer ".tabs" que não caiba na largura disponível — sem
  // isso, abas extras (ex.: Configurações com 11 abas) só existiam via scroll
  // horizontal sem nenhuma pista visual, ficando escondidas na prática.
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.tabs').forEach(function (tabs) {
      var wrap = document.createElement('div');
      wrap.className = 'tabs-scroll-wrap';
      tabs.parentNode.insertBefore(wrap, tabs);
      var prev = document.createElement('button');
      prev.type = 'button';
      prev.className = 'tabs-arrow tabs-arrow-prev';
      prev.setAttribute('aria-label', 'Abas anteriores');
      prev.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>';
      var next = document.createElement('button');
      next.type = 'button';
      next.className = 'tabs-arrow tabs-arrow-next';
      next.setAttribute('aria-label', 'Próximas abas');
      next.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>';
      wrap.appendChild(prev);
      wrap.appendChild(tabs);
      wrap.appendChild(next);
      prev.addEventListener('click', function () { tabs.scrollBy({ left: -160, behavior: 'smooth' }); });
      next.addEventListener('click', function () { tabs.scrollBy({ left: 160, behavior: 'smooth' }); });
      function update() {
        var overflowing = tabs.scrollWidth > tabs.clientWidth + 1;
        wrap.classList.toggle('has-overflow', overflowing);
        prev.disabled = tabs.scrollLeft <= 0;
        next.disabled = tabs.scrollLeft >= tabs.scrollWidth - tabs.clientWidth - 1;
      }
      tabs.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  });
})();
</script>
