  <div x-show="celular.loading" class="hint">Procurando os endereços desta máquina…</div>

  <div x-show="!celular.loading && celular.erro" x-cloak>
    <p class="hint" style="color:var(--danger)" x-text="celular.erro"></p>
    <button type="button" class="btn secondary small" @click="carregarCelular()">Tentar de novo</button>
  </div>

