              <button type="button" class="btn secondary small" @click="copiarCelular(u.url)"
                      x-text="celular.copiado === u.url ? 'Copiado!' : 'Copiar endereço'"></button>
            </div>
          </div>
        </template>
        <p class="hint" x-show="!celular.info.urls.length" x-cloak>
          Nenhuma interface de rede local detectada — verifique se o cabo ou o Wi-Fi está conectado.
        </p>
      </div>
    </template>
  </div>

  <% if (user.permissions.has('settings.edit')) { %>
  <a class="celular-link-rede" href="/admin/configuracoes#rede">Abrir as configurações de rede local</a>
  <% } %>
</dialog>
