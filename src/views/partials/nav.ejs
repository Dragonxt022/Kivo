        </p>
        <% if (user.permissions.has('settings.edit')) { %>
        <button type="button" class="btn" :disabled="celular.ativando" @click="ativarCelular()"
                x-text="celular.ativando ? 'Ativando…' : 'Ativar acesso pela rede local'"></button>
        <% } else { %>
        <p class="hint">Peça a um administrador para ativar em Configurações → Rede local.</p>
        <% } %>
      </div>
    </template>

    <template x-if="celular.info.lanAtivo !== false">
      <div>
        <p class="hint mt-0" x-show="celular.info.lanAtivo"><span class="badge ok">Ativo</span> Outros aparelhos da mesma rede já conseguem abrir o Kuruk.</p>
        <p class="hint mt-0" x-show="!celular.info.lanAtivo" x-cloak>
          Não foi possível confirmar o estado da rede agora. Se o endereço abaixo não abrir no
          celular, verifique o firewall do Windows ou as configurações de rede local.
        </p>
        <template x-for="u in celular.info.urls" :key="u.url">
          <div class="celular-url">
            <img :src="u.qr" width="92" height="92" alt="QR code do endereço do Kuruk" />
