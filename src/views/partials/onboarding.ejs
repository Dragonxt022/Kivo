<dialog x-ref="onboardingDlg" class="wizard-dialog" tabindex="-1" @cancel.prevent @close="open = false">
  <div class="wizard-progress" x-show="step < totalSteps - 1">
    <template x-for="i in totalSteps - 1" :key="i">
      <div class="dot" :class="(i - 1) < step ? 'done' : ((i - 1) === step ? 'active' : '')"></div>
    </template>
  </div>

  <div class="wizard-viewport">
    <div class="wizard-track" :style="'transform: translateX(-' + (step * 100) + '%)'">

      <!-- 0: boas-vindas -->
      <div class="wizard-step">
        <div class="wizard-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 4.1L6 9l4.1 1.9L12 15l1.9-4.1L18 9l-4.1-1.9L12 3Z"/><path d="M5 3v4M3 5h4M19 17v4M17 19h4"/></svg>
        </div>
        <h2 class="wizard-title">Bem-vindo(a) ao Kivo! 🎉</h2>
        <p class="wizard-subtitle">
          Vamos deixar o sistema do seu jeito antes de começar — leva menos de um minuto
          e já preparamos um ambiente pronto pra você testar.
        </p>
      </div>

      <!-- 1: interface e cor -->
      <div class="wizard-step">
        <h2 class="wizard-title">Como você prefere navegar?</h2>
        <p class="wizard-subtitle">Você pode mudar isso depois em Configurações → Interface.</p>
        <div class="choice-grid">
          <button type="button" class="choice-card" :class="uiInterface === 'cards' ? 'selected' : ''" @click="chooseInterface('cards')">
            <svg class="choice-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            <span class="choice-label">Cartões</span>
            <span class="choice-desc">Tela inicial com ícones</span>
          </button>
          <button type="button" class="choice-card" :class="uiInterface === 'sidebar' ? 'selected' : ''" @click="chooseInterface('sidebar')">
            <svg class="choice-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
            <span class="choice-label">Menu lateral</span>
            <span class="choice-desc">Menu fixo à esquerda</span>
          </button>
        </div>
        <p class="hint" style="margin-top:1rem">Cor de destaque</p>
        <div class="color-swatch-row">
          <template x-for="p in KIVO_COLOR_PRESETS" :key="p.id">
            <button type="button" class="color-swatch" :class="uiColorTheme === p.id ? 'selected' : ''" :style="{ background: p.hex }" @click="chooseColorPreset(p.id)"></button>
          </template>
          <input type="color" class="color-swatch color-swatch-custom" :value="uiCustomColor" @input="chooseCustomColor($event.target.value)" />
        </div>
      </div>

      <!-- 2: onde vai usar -->
      <div class="wizard-step">
        <h2 class="wizard-title">Onde você vai usar o Kivo?</h2>
        <p class="wizard-subtitle">Isso ajuda a deixar as telas certas em destaque pra você.</p>
        <div class="choice-grid">
          <button type="button" class="choice-card" :class="answers.usage === 'balcao' ? 'selected' : ''" @click="chooseUsage('balcao')">
            <svg class="choice-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <span class="choice-label">Só no balcão</span>
            <span class="choice-desc">PDV, venda rápida</span>
          </button>
          <button type="button" class="choice-card" :class="answers.usage === 'mesas' ? 'selected' : ''" @click="chooseUsage('mesas')">
            <svg class="choice-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
            <span class="choice-label">Só nas mesas</span>
            <span class="choice-desc">Comandas, atendimento</span>
          </button>
          <button type="button" class="choice-card" :class="answers.usage === 'ambos' ? 'selected' : ''" @click="chooseUsage('ambos')">
            <svg class="choice-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            <span class="choice-label">Os dois</span>
            <span class="choice-desc">Balcão e mesas</span>
          </button>
        </div>
      </div>

      <%# 3: sobre o negócio — nome, porte e ramo.
          As três perguntas moram no mesmo passo porque respondem a uma coisa só ("quem é
          essa loja"), e separá-las viraria três telas de uma pergunta cada. Diferente dos
          passos 2 e 3 antigos, este NÃO avança sozinho ao clicar num cartão: o nome é
          digitado, e pular fora dele engoliria o que o lojista ainda ia escrever. %>
      <div class="wizard-step">
        <h2 class="wizard-title">Sobre o seu negócio</h2>
        <p class="wizard-subtitle">
          O nome aparece no cabeçalho dos cupons e orçamentos. O resto ajuda a deixar as
          telas certas em destaque pra você.
        </p>

        <div class="wizard-campo">
          <label for="wz-nome">Nome do seu negócio</label>
          <input id="wz-nome" type="text" class="input" x-model="answers.businessName" maxlength="120"
                 placeholder="ex.: Padaria da Esquina" autocomplete="organization"
                 @keydown.enter.prevent="canLeaveBusinessStep() && next()" />
          <p class="error" x-show="businessError" x-cloak x-text="businessError"></p>
        </div>

        <div class="wizard-campo">
          <label>Quantas pessoas trabalham no negócio?</label>
          <div class="wizard-chips">
            <template x-for="f in employeeRanges" :key="f.id">
              <button type="button" class="wizard-chip" :class="answers.employeeRange === f.id ? 'selected' : ''"
                      @click="answers.employeeRange = f.id" x-text="f.label"></button>
            </template>
          </div>
        </div>

        <div class="wizard-campo">
          <label>Qual é o ramo?</label>
          <div class="choice-grid choice-grid-compacto">
            <template x-for="t in businessTypes" :key="t.id">
              <button type="button" class="choice-card" :class="answers.businessType === t.id ? 'selected' : ''"
                      @click="answers.businessType = t.id">
                <svg class="choice-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" x-html="t.icon"></svg>
                <span class="choice-label" x-text="t.label"></span>
              </button>
            </template>
          </div>
        </div>
      </div>

      <!-- 4: recursos -->
      <div class="wizard-step">
        <h2 class="wizard-title">O que você vai usar?</h2>
        <p class="wizard-subtitle">
          Já marcamos o que combina com suas respostas. O que ficar desmarcado some do menu —
          e dá pra ligar de volta a qualquer momento em Configurações → Recursos.
        </p>
        <div class="wizard-feature-list">
          <template x-for="f in features" :key="f.key">
            <label class="wizard-feature-item" :class="featureKeys.includes(f.key) ? 'selected' : ''">
              <input type="checkbox" :checked="featureKeys.includes(f.key)" @change="toggleFeature(f.key)" />
              <span class="wizard-feature-text">
                <span class="wizard-feature-label">
                  <span x-text="f.label"></span>
                  <span class="wizard-feature-tag" x-show="featureRecommended(f)">recomendado</span>
                  <span class="wizard-feature-tag off" x-show="f.enabled && !featureKeys.includes(f.key)">vai desligar</span>
                </span>
                <span class="wizard-feature-hint" x-text="f.hint"></span>
              </span>
            </label>
          </template>
          <p class="hint" x-show="!features.length">Nenhum recurso opcional disponível no seu plano.</p>
        </div>
      </div>

      <!-- 5: formas de pagamento -->
      <div class="wizard-step">
        <h2 class="wizard-title">Formas de pagamento</h2>
        <p class="wizard-subtitle">Marque as que você aceita — dá pra mudar depois em Configurações.</p>
        <div class="wizard-payment-list">
          <template x-for="pm in paymentMethods" :key="pm.id">
            <label class="wizard-payment-item" :class="answers.activePaymentMethodIds.includes(pm.id) ? 'selected' : ''">
              <input type="checkbox" :checked="answers.activePaymentMethodIds.includes(pm.id)" @change="togglePayment(pm.id)" />
              <span x-text="pm.name"></span>
            </label>
          </template>
          <p class="hint" x-show="!paymentMethods.length">Carregando…</p>
        </div>
      </div>

      <!-- 6: resumo -->
      <div class="wizard-step">
        <div class="wizard-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </div>
        <h2 class="wizard-title">Tudo certo?</h2>
        <p class="wizard-subtitle">Confira o que vamos preparar pra você:</p>
        <div class="wizard-summary-list">
          <div class="wizard-summary-item" x-show="willCreateTables()">
            <span class="wizard-summary-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
            <span>10 mesas já cadastradas, prontas pra usar</span>
          </div>
          <div class="wizard-summary-item" x-show="answers.businessType === 'restaurante'">
            <span class="wizard-summary-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
            <!-- Sem o recurso de complementos, os produtos de exemplo saem sem os grupos
                 de adicionais: prometer "com complementos" aqui seria mentira. -->
            <span x-text="featureKeys.includes('commercial.complementos')
              ? 'Produtos de exemplo (suco, lanche…) com complementos, prontos pro PDV'
              : 'Produtos de exemplo (suco, lanche…) prontos pro PDV'"></span>
          </div>
          <div class="wizard-summary-item" x-show="willCreateVariantProducts()">
            <span class="wizard-summary-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
            <span>Produtos de exemplo com variações de tamanho e cor</span>
          </div>
          <div class="wizard-summary-item" x-show="selectedFeatureLabels().length">
            <span class="wizard-summary-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
            <span x-text="'Recursos ativos: ' + selectedFeatureLabels().join(', ')"></span>
          </div>
          <div class="wizard-summary-item warn" x-show="featuresToTurnOff().length">
            <span class="wizard-summary-check off"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg></span>
            <span x-text="'Vamos desligar: ' + featuresToTurnOff().join(', ')"></span>
          </div>
          <div class="wizard-summary-item">
            <span class="wizard-summary-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
            <span x-text="answers.activePaymentMethodIds.length + ' forma(s) de pagamento ativa(s)'"></span>
          </div>
        </div>
        <p class="hint" x-show="mode === 'reopen'">
          Isso salva suas preferências. Se quiser gerar/regenerar mesas/produtos de exemplo agora,
          use o botão "Regenerar dados de exemplo".
        </p>
        <div class="error" x-text="error"></div>
      </div>

      <!-- 7: sucesso -->
      <div class="wizard-step">
        <div class="wizard-icon" style="background:var(--primary);color:#fff">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <h2 class="wizard-title">Prontinho!</h2>
        <p class="wizard-subtitle" x-text="successMessage()"></p>
      </div>

    </div>
  </div>

  <div class="wizard-footer">
    <button type="button" class="btn secondary" @click="back()" x-show="step > 0 && step < totalSteps - 1">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Voltar
    </button>
    <button type="button" class="btn secondary" @click="skipWizard()" x-show="step === 0 && mode === 'first-run'">Pular por agora</button>
    <button type="button" class="btn secondary" @click="close()" x-show="step === 0 && mode === 'reopen'">Fechar</button>
    <div class="spacer"></div>
    <button type="button" class="btn" @click="next()" x-show="step === 0">
      Vamos lá
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <button type="button" class="btn" @click="next()" x-show="step === 1">Continuar</button>
    <%# O passo 3 (sobre o negócio) não avança sozinho: tem campo digitado, e só libera com
        nome e ramo preenchidos — é o que o assistente precisa saber para configurar. %>
    <button type="button" class="btn" @click="leaveBusinessStep()" x-show="step === 3"
            :disabled="!canLeaveBusinessStep()">Continuar</button>
    <button type="button" class="btn" @click="next()" x-show="step === 4">Continuar</button>
    <button type="button" class="btn" @click="next()" x-show="step === 5" :disabled="!paymentMethods.length">Continuar</button>
    <button type="button" class="btn secondary" @click="finish(true, true)" x-show="step === 6 && mode === 'reopen'" :disabled="loading">Regenerar dados de exemplo</button>
    <button type="button" class="btn" @click="finish(mode === 'first-run')" x-show="step === 6" :disabled="loading">
      <span x-text="loading ? 'Configurando…' : (mode === 'first-run' ? 'Concluir e configurar' : 'Salvar preferências')"></span>
    </button>
    <button type="button" class="btn" @click="close()" x-show="step === 7">Ir para o sistema</button>
  </div>
</dialog>
