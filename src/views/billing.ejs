<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Cobranças</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/datetime.js"></script>
  <style>
    .billing-page {
      width: min(1120px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 2rem 0 3rem;
    }
    .billing-hero {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.35rem;
    }
    .billing-hero-icon {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      display: grid;
      place-items: center;
      flex: none;
      color: var(--primary);
      background: color-mix(in srgb, var(--primary) 13%, var(--surface));
      border: 1px solid color-mix(in srgb, var(--primary) 20%, var(--border-light));
    }
    .billing-hero-icon svg { width: 27px; height: 27px; }
    .billing-hero-copy { flex: 1 1 320px; min-width: 0; }
    .billing-eyebrow {
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--primary);
      margin-bottom: .25rem;
    }
    .billing-hero h1 {
      margin: 0;
      font-size: 1.7rem;
      letter-spacing: -.035em;
      line-height: 1.15;
    }
    .billing-hero p {
      margin: .4rem 0 0;
      max-width: 650px;
      color: var(--text-muted);
      font-size: .88rem;
      line-height: 1.55;
    }
    .billing-hero-status { margin-left: auto; align-self: flex-start; }
    .billing-status {
      display: inline-flex;
      align-items: center;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .045em;
      text-transform: uppercase;
      background: color-mix(in srgb, var(--warning) 14%, var(--surface));
      color: var(--warning);
      border: 1px solid color-mix(in srgb, var(--warning) 26%, transparent);
      white-space: nowrap;
    }
    .billing-status.ok {
      background: var(--success-soft);
      color: var(--success);
      border-color: color-mix(in srgb, var(--success) 28%, transparent);
    }
    .billing-status.off {
      background: var(--surface-hover);
      color: var(--text-muted);
      border-color: var(--border-light);
    }
    .sub-card {
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      background: var(--surface);
      padding: 1.35rem 1.5rem;
      margin-bottom: 1.1rem;
      box-shadow: var(--shadow-sm);
    }
    .sub-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .sub-head h2 { margin: 0; font-size: 1.15rem; letter-spacing: -.02em; }
    .sub-head p { margin: .35rem 0 0; font-size: .82rem; color: var(--text-muted); line-height: 1.55; max-width: 720px; }
    .sub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
      gap: .7rem;
      margin-bottom: 1rem;
    }
    .sub-grid > div {
      background: var(--surface-hover);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      padding: .8rem .95rem;
    }
    .sub-grid span { display: block; font-size: .64rem; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); font-weight: 800; }
    .sub-grid strong { display: block; margin-top: .25rem; font-size: .92rem; }
    .sub-alert {
      display: flex;
      align-items: flex-start;
      gap: .7rem;
      padding: .8rem .9rem;
      margin-bottom: .9rem;
      border-radius: 12px;
      background: color-mix(in srgb, var(--warning) 9%, var(--surface));
      border: 1px solid color-mix(in srgb, var(--warning) 22%, transparent);
    }
    .sub-alert svg { flex: none; color: var(--warning); width: 18px; height: 18px; margin-top: 1px; }
    .sub-alert strong { display: block; font-size: .84rem; }
    .sub-alert p { margin: .2rem 0 0; color: var(--text-muted); font-size: .79rem; line-height: 1.5; }
    .sub-actions { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
    .plan-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .6rem; margin: .6rem 0 .9rem; }
    .plan-option {
      text-align: left;
      border: 1.5px solid var(--border);
      border-radius: 12px;
      background: var(--surface);
      color: var(--text);
      padding: .75rem .85rem;
      cursor: pointer;
      font-family: inherit;
    }
    .plan-option.active { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 7%, var(--surface)); box-shadow: 0 0 0 2px var(--primary-soft); }
    .plan-option strong { display: block; font-size: .9rem; }
    .plan-option .price { display: flex; align-items: baseline; gap: .35rem; margin: .15rem 0; font-size: 1.05rem; font-weight: 800; }
    .plan-option .price del { color: var(--text-muted); font-size: .8rem; font-weight: 500; }
    .plan-option .plan-promo {
      display: flex;
      width: fit-content;
      align-items: center;
      gap: .3rem;
      margin: .15rem 0 .3rem;
      padding: .1rem .45rem;
      border-radius: 999px;
      background: var(--primary-bg);
      color: var(--primary);
      font-size: .64rem;
      font-weight: 800;
    }
    .plan-option small { color: var(--text-muted); font-size: .72rem; line-height: 1.35; }
    .subscribe-box { border-top: 1px solid var(--border-light); padding-top: .9rem; margin-top: .9rem; }
    .subscribe-box h3 { margin: 0 0 .3rem; font-size: .95rem; }
    .subscribe-box > p { margin: 0 0 .7rem; font-size: .82rem; color: var(--text-muted); line-height: 1.5; }
    .sub-note { font-size: .78rem; color: var(--text-muted); line-height: 1.5; margin: .45rem 0 0; }
    .billing-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: .35rem;
      padding: 3rem 1.5rem;
      border: 1px dashed var(--border);
      border-radius: var(--radius-lg);
      background: color-mix(in srgb, var(--surface-hover) 55%, transparent);
      margin-bottom: 1rem;
    }
    .billing-empty-icon {
      width: 48px; height: 48px; border-radius: 14px;
      display: grid; place-items: center; margin-bottom: .4rem;
      color: var(--text-muted);
      background: var(--surface);
      border: 1px solid var(--border-light);
    }
    .billing-empty-icon svg { width: 23px; height: 23px; }
    .billing-empty h3 { margin: 0; font-size: 1rem; }
    .billing-empty p { margin: 0 0 .65rem; max-width: 430px; color: var(--text-muted); font-size: .83rem; line-height: 1.5; }
    dialog .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: .8rem;
      border-bottom: 1px solid var(--border-light);
    }
    dialog .modal-header h2 { margin: 0; font-size: 1.1rem; }
    dialog .modal-close {
      border: 0; background: none; color: var(--text-muted);
      font-size: 1.35rem; line-height: 1; cursor: pointer; padding: 0 .2rem;
    }
    dialog .modal-body { padding: 1rem 0; }
    dialog .modal-actions {
      display: flex; justify-content: flex-end; gap: .6rem;
      padding-top: 1rem; border-top: 1px solid var(--border-light);
    }

    /* Modal de pagamento: altura pelo conteúdo, sem o vazio gigante do dialog-fixed. */
    dialog.pay-dialog {
      width: min(700px, calc(100vw - 2rem));
      max-height: calc(100vh - 2rem);
      padding: 0;
      overflow: hidden;
      border-radius: 18px;
    }
    dialog.pay-dialog[open] { display: flex; flex-direction: column; }
    .pay-sheet-head {
      display: flex; align-items: center; gap: .75rem;
      padding: 1.2rem 1.35rem .9rem; border-bottom: 1px solid var(--border-light);
      background: color-mix(in srgb, var(--surface-hover) 55%, var(--surface));
      flex: none;
    }
    .pay-sheet-icon {
      width: 40px; height: 40px; border-radius: 12px; flex: none;
      display: grid; place-items: center; color: var(--primary);
      background: color-mix(in srgb, var(--primary) 13%, transparent);
    }
    .pay-sheet-icon svg { width: 21px; height: 21px; }
    .pay-sheet-title { flex: 1; min-width: 0; }
    .pay-sheet-title h1 { margin: 0; font-size: 1.15rem; line-height: 1.3; letter-spacing: -.02em; }
    .pay-sheet-title p { margin: .15rem 0 0; color: var(--text-muted); font-size: .78rem; }
    .pay-sheet-close {
      flex: none; border: 0; background: none; color: var(--text-muted);
      cursor: pointer; padding: .25rem; display: grid; place-items: center;
      border-radius: 8px;
    }
    .pay-sheet-close svg { width: 18px; height: 18px; }
    .pay-sheet-close:hover { color: var(--text); background: var(--surface-hover); }
    .pay-sheet-summary {
      display: grid; grid-template-columns: 1fr 1fr; gap: .6rem;
      padding: .9rem 1.35rem .2rem; flex: none;
    }
    .pay-sheet-summary > div {
      padding: .7rem .85rem; border-radius: 11px;
      border: 1px solid var(--border-light); background: var(--surface-hover);
    }
    .pay-sheet-summary span { display: block; font-size: .64rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); font-weight: 800; }
    .pay-sheet-summary strong { display: block; margin-top: .2rem; font-size: 1.02rem; }
    .pay-method-grid {
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .55rem;
      padding: .9rem 1.35rem; flex: none;
    }
    .pay-method {
      display: flex; align-items: center; gap: .55rem; text-align: left;
      padding: .65rem .7rem; border-radius: 11px;
      border: 1.5px solid var(--border); background: var(--surface); color: var(--text);
      font-family: inherit; cursor: pointer; min-width: 0;
    }
    .pay-method:hover:not(:disabled) { border-color: var(--primary); }
    .pay-method.active { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 7%, var(--surface)); box-shadow: 0 0 0 2px var(--primary-soft); }
    .pay-method:disabled { opacity: .55; cursor: wait; }
    .pay-method-icon {
      width: 30px; height: 30px; border-radius: 9px; flex: none;
      display: grid; place-items: center; color: #fff;
    }
    .pay-method-icon svg { width: 16px; height: 16px; }
    .pay-method-icon.pix { background: #0ea5a4; }
    .pay-method-icon.boleto { background: #3b82f6; }
    .pay-method-icon.card { background: #8b5cf6; }
    .pay-method span:last-child { min-width: 0; }
    .pay-method strong { display: block; font-size: .82rem; }
    .pay-method small { display: block; font-size: .65rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pay-sheet-body { flex: 1; min-height: 0; overflow-y: auto; padding: .1rem 1.35rem 1rem; }
    .pay-sheet-footer {
      display: flex; justify-content: flex-end; gap: .6rem;
      padding: .85rem 1.35rem; border-top: 1px solid var(--border-light);
      background: var(--surface); flex: none;
    }
    .pay-loading { display: flex; align-items: center; gap: .5rem; padding: .75rem 0; color: var(--text-muted); font-size: .82rem; }
    .pay-spinner { width: 15px; height: 15px; border-radius: 50%; border: 2px solid var(--border); border-top-color: var(--primary); animation: pay-spin .8s linear infinite; }
    @keyframes pay-spin { to { transform: rotate(360deg); } }
    .pay-alert {
      display: flex; align-items: flex-start; gap: .55rem; margin: .65rem 0;
      padding: .7rem .8rem; border-radius: 10px;
      border: 1px solid color-mix(in srgb, var(--danger) 28%, transparent);
      background: var(--danger-bg); color: var(--danger-text);
      font-size: .8rem; line-height: 1.45;
    }
    .pay-alert svg { width: 17px; height: 17px; flex: none; margin-top: 1px; }
    .pay-qr-block { margin-top: .7rem; padding: .85rem; border: 1px solid var(--border-light); border-radius: 13px; background: var(--surface-hover); }
    .pay-qr-copy strong { display: block; font-size: .84rem; }
    .pay-qr-copy small { display: block; margin-top: .15rem; font-size: .72rem; color: var(--text-muted); }
    .pay-qr-image { text-align: center; margin: .7rem 0; }
    .pay-qr-image img { width: 180px; height: 180px; background: #fff; padding: 6px; border-radius: 12px; border: 1px solid var(--border-light); }
    .pay-copy-row { display: flex; gap: .45rem; align-items: center; }
    .pay-copy-row input { flex: 1; min-width: 0; margin: 0; }
    .pay-verify-row { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-top: .7rem; }
    .pay-polling { margin: .35rem 0 0; font-size: .72rem; color: var(--text-muted); }
    .pay-link-card { margin-top: .75rem; padding: .75rem .8rem; border: 1px solid var(--border-light); border-radius: 11px; background: var(--surface); }
    .pay-link-card label { margin-top: 0; }
    .pay-link-card .pay-copy-row { margin-top: .35rem; }
    .pay-empty { text-align: center; padding: 1.2rem .5rem 1.4rem; color: var(--text-muted); }
    .pay-empty-art { width: 70px; height: 70px; margin: 0 auto .6rem; display: grid; place-items: center; color: var(--primary); border-radius: 18px; background: color-mix(in srgb, var(--primary) 9%, transparent); }
    .pay-empty-art svg { width: 42px; height: 42px; opacity: .8; }
    .pay-empty strong { display: block; color: var(--text); font-size: .9rem; }
    .pay-empty p { margin: .3rem auto 0; max-width: 360px; font-size: .78rem; line-height: 1.5; }
    @media (max-width: 560px) {
      .pay-method-grid { grid-template-columns: 1fr; }
      .pay-sheet-summary { grid-template-columns: 1fr; }
    }
  </style>
  <style>
    /* ══════════════════════════════════════════════════════════════════════════
       Redesign da assinatura — cartões de vidro, hierarquia clara e status legível.
       As regras abaixo vêm depois das antigas de propósito: os diálogos e a folha de
       pagamento continuam usando o CSS original.
       ══════════════════════════════════════════════════════════════════════════ */
    .billing-page {
      width: min(1080px, calc(100% - 2rem));
      padding: 1.6rem 0 3rem;
    }
    .billing-hero {
      align-items: center;
      gap: .9rem;
      margin-bottom: 1.15rem;
    }
    .billing-hero-icon {
      width: 50px;
      height: 50px;
      border-radius: 15px;
    }
    .billing-hero h1 { font-size: 1.75rem; }
    .billing-hero p { margin-top: .3rem; }

    /* ─── Cartão principal ─── */
    .sub-card {
      position: relative;
      overflow: hidden;
      padding: 1.4rem 1.5rem;
      border-radius: 20px;
      background: var(--glass-strong);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(170%);
      backdrop-filter: blur(var(--glass-blur)) saturate(170%);
      border: 1px solid var(--glass-border);
      box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, .4);
      margin-bottom: 1.6rem;
    }
    :root[data-theme='dark'] .sub-card {
      box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, .04);
    }
    .sub-head {
      align-items: flex-start;
      justify-content: flex-start;
      gap: 1rem;
      margin-bottom: 1.15rem;
    }
    .sub-head-copy { flex: 1 1 auto; min-width: 0; }
    .sub-head h2 { font-size: 1.2rem; }
    .sub-head p { max-width: 690px; font-size: .82rem; }
    .sub-state { display: flex; flex-direction: column; gap: .85rem; }

    /* ─── Status ─── */
    .billing-status {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .4rem .72rem;
      border-radius: 999px;
      background: var(--surface-hover);
      color: var(--text-muted);
      border: 1px solid var(--border-light);
      font-size: .66rem;
      font-weight: 800;
      letter-spacing: .05em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .billing-status::before {
      content: '';
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
      flex: none;
    }
    .billing-status.is-pending {
      background: color-mix(in srgb, var(--warning-text) 11%, var(--surface));
      color: var(--warning-text);
      border-color: color-mix(in srgb, var(--warning-text) 26%, transparent);
    }
    .billing-status.is-ok {
      background: color-mix(in srgb, var(--primary) 9%, var(--surface));
      color: var(--primary);
      border-color: color-mix(in srgb, var(--primary) 24%, transparent);
    }
    .billing-status.is-off {
      background: var(--surface-hover);
      color: var(--text-muted);
      border-color: var(--border-light);
    }
    .billing-status.is-error {
      background: var(--danger-bg);
      color: var(--danger-text);
      border-color: color-mix(in srgb, var(--danger) 25%, transparent);
    }

    /* ─── Visão geral do plano ─── */
    .sub-overview {
      display: grid;
      grid-template-columns: 1.25fr .9fr .9fr;
      gap: .7rem;
    }
    .sub-plan-card {
      position: relative;
      overflow: hidden;
      padding: 1rem 1.1rem;
      border-radius: 16px;
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--primary) 13%, var(--surface)), var(--surface) 72%);
      border: 1px solid color-mix(in srgb, var(--primary) 22%, var(--border-light));
    }
    .sub-plan-card::after {
      content: '';
      position: absolute;
      right: -28px;
      bottom: -38px;
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: color-mix(in srgb, var(--primary) 11%, transparent);
      pointer-events: none;
    }
    .sub-kicker {
      display: block;
      font-size: .64rem;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      color: var(--primary);
    }
    .sub-plan-name {
      display: block;
      margin-top: .15rem;
      font-size: 1.45rem;
      line-height: 1.2;
      letter-spacing: -.03em;
    }
    .sub-plan-price {
      display: flex;
      align-items: baseline;
      gap: .2rem;
      margin-top: .25rem;
      color: var(--primary);
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -.03em;
      font-variant-numeric: tabular-nums;
    }
    .sub-plan-price small {
      font-size: .76rem;
      font-weight: 600;
      letter-spacing: 0;
      color: var(--text-muted);
    }
    .sub-plan-tag,
    .sub-plan-meta {
      display: inline-flex;
      align-items: center;
      margin-top: .5rem;
      padding: .18rem .5rem;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      color: var(--text-muted);
      font-size: .66rem;
      font-weight: 600;
    }
    .sub-stat {
      display: flex;
      align-items: flex-start;
      gap: .65rem;
      min-width: 0;
      padding: 1rem;
      border-radius: 16px;
      background: var(--surface-hover);
      border: 1px solid var(--border-light);
    }
    .sub-stat-icon {
      width: 34px;
      height: 34px;
      flex: none;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      color: var(--primary);
    }
    .sub-stat-icon svg { width: 17px; height: 17px; }
    .sub-stat > div { min-width: 0; }
    .sub-stat small {
      display: block;
      font-size: .63rem;
      font-weight: 800;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .sub-stat strong {
      display: block;
      margin-top: .2rem;
      font-size: .93rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sub-stat-note {
      display: block;
      margin-top: .15rem;
      color: var(--danger-text);
      font-size: .68rem;
      font-weight: 700;
    }
    .sub-stat.is-danger {
      background: color-mix(in srgb, var(--danger) 5%, var(--surface));
      border-color: color-mix(in srgb, var(--danger) 24%, transparent);
    }
    .sub-stat.is-danger .sub-stat-icon {
      color: var(--danger);
      background: var(--danger-bg);
      border-color: color-mix(in srgb, var(--danger) 20%, transparent);
    }
    .sub-stat.is-danger strong { color: var(--danger-text); }

    /* ─── Avisos de estado ─── */
    .sub-banner {
      display: flex;
      align-items: flex-start;
      gap: .75rem;
      padding: .9rem 1rem;
      border-radius: 14px;
      border: 1px solid var(--border-light);
      background: var(--surface-hover);
    }
    .sub-banner.is-pending {
      background: color-mix(in srgb, var(--warning-text) 8%, var(--surface));
      border-color: color-mix(in srgb, var(--warning-text) 24%, transparent);
    }
    .sub-banner.is-ok {
      background: color-mix(in srgb, var(--primary) 6%, var(--surface));
      border-color: color-mix(in srgb, var(--primary) 20%, transparent);
    }
    .sub-banner.is-error {
      background: var(--danger-bg);
      border-color: color-mix(in srgb, var(--danger) 24%, transparent);
    }
    .sub-banner-icon {
      width: 36px;
      height: 36px;
      flex: none;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      color: var(--warning-text);
    }
    .sub-banner.is-ok .sub-banner-icon { color: var(--primary); }
    .sub-banner.is-error .sub-banner-icon { color: var(--danger-text); }
    .sub-banner-icon svg { width: 18px; height: 18px; }
    .sub-banner-body { min-width: 0; }
    /* Só o título do aviso é bloco. O <strong> dentro do texto (Verificar autorização)
       continua inline — era o que jogava o ponto final numa linha sozinho. */
    .sub-banner-body > strong {
      display: block;
      font-size: .88rem;
      line-height: 1.3;
    }
    .sub-banner-body p {
      margin: .2rem 0 0;
      font-size: .79rem;
      line-height: 1.5;
      color: var(--text-muted);
    }
    .sub-banner-body p strong { display: inline; color: var(--text-secondary); }
    .sub-banner-link {
      display: inline-block;
      margin-top: .55rem;
      padding: 0;
      border: 0;
      background: none;
      color: var(--text-muted);
      font-family: inherit;
      font-size: .72rem;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }
    .sub-banner-link:hover { color: var(--danger); }
    .sub-banner-link:disabled { opacity: .5; cursor: default; }
    .sub-steps {
      display: flex;
      flex-wrap: wrap;
      gap: .35rem;
      margin: .6rem 0 0;
      padding: 0;
      list-style: none;
    }
    .sub-steps li {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      padding: .24rem .55rem;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      color: var(--text-secondary);
      font-size: .69rem;
      font-weight: 600;
    }
    .sub-steps li span {
      width: 16px;
      height: 16px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--warning-bg);
      color: var(--warning-text);
      font-size: .6rem;
      font-weight: 800;
    }
    .sub-note {
      margin: 0;
      font-size: .79rem;
      line-height: 1.55;
      color: var(--text-muted);
    }

    /* ─── Ações ─── */
    .sub-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      padding-top: .15rem;
    }
    .sub-actions .btn { display: inline-flex; align-items: center; gap: .4rem; margin: 0; }
    .sub-actions-spacer { flex: 1 1 auto; }
    .sub-link-danger {
      border: 0;
      background: transparent;
      padding: .3rem .1rem;
      color: var(--text-muted);
      font-family: inherit;
      font-size: .76rem;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }
    .sub-link-danger:hover { color: var(--danger); }
    .sub-link-danger:disabled { opacity: .5; cursor: default; }

    /* ─── Chamada para assinar ─── */
    .subscribe-box {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: .1rem;
      padding: 1.05rem 1.15rem;
      border-radius: 16px;
      border: 1px solid color-mix(in srgb, var(--primary) 20%, var(--border-light));
      background:
        linear-gradient(120deg, color-mix(in srgb, var(--primary) 9%, var(--surface)), var(--surface) 70%);
    }
    .subscribe-copy { flex: 1 1 380px; min-width: 0; }
    .subscribe-kicker {
      display: block;
      font-size: .63rem;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      color: var(--primary);
    }
    .subscribe-box h3 { margin: .15rem 0 0; font-size: 1rem; }
    .subscribe-box p {
      margin: .25rem 0 0;
      color: var(--text-muted);
      font-size: .8rem;
      line-height: 1.5;
    }

    /* ─── Histórico ─── */
    .billing-history { margin-top: .15rem; }
    .history-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: .7rem;
    }
    .history-head h2 { margin: 0; font-size: 1.08rem; letter-spacing: -.02em; }
    .history-head p { margin: .2rem 0 0; color: var(--text-muted); font-size: .8rem; }
    .history-card {
      border: 1px solid var(--border-light);
      border-radius: 16px;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .history-scroll { overflow-x: auto; }
    .history-card table { margin: 0; box-shadow: none; border-radius: 0; }
    .history-card th,
    .history-card td { background: transparent; }
    .history-card thead th {
      background: var(--surface-hover);
      font-size: .67rem;
      font-weight: 800;
      letter-spacing: .05em;
      text-transform: uppercase;
    }
    .history-card tbody tr:last-child td { border-bottom: 0; }
    .history-card tbody tr:hover td {
      background: color-mix(in srgb, var(--primary) 4%, transparent);
    }
    .urgent-panel {
      display: flex;
      align-items: flex-start;
      gap: .7rem;
      padding: .85rem .95rem;
      border-radius: 14px;
      background: color-mix(in srgb, var(--warning-text) 8%, var(--surface));
      border: 1px solid color-mix(in srgb, var(--warning-text) 24%, transparent);
      margin-bottom: .8rem;
    }
    .urgent-icon {
      width: 32px;
      height: 32px;
      flex: none;
      display: grid;
      place-items: center;
      border-radius: 9px;
      background: var(--surface);
      color: var(--warning-text);
    }
    .urgent-icon svg { width: 17px; height: 17px; }
    .urgent-panel strong { display: block; font-size: .84rem; }
    .urgent-panel p strong { display: inline; font-size: inherit; }
    .urgent-panel p { margin: .2rem 0 0; font-size: .78rem; color: var(--text-muted); }
    .billing-empty {
      padding: 2.3rem 1.5rem;
      border: 1px solid var(--border-light);
      border-radius: 16px;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      margin-bottom: 0;
    }
    .billing-empty-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      color: var(--primary);
      background: color-mix(in srgb, var(--primary) 9%, var(--surface));
      border: 1px solid color-mix(in srgb, var(--primary) 20%, var(--border-light));
    }
    .billing-empty h3 { font-size: 1rem; }
    .billing-empty p { font-size: .82rem; }

    /* ─── Aviso de ambiente no modal de planos ─── */
    .payer-env {
      display: flex;
      align-items: flex-start;
      gap: .55rem;
      margin: 0 0 .8rem;
      padding: .7rem .8rem;
      border-radius: 11px;
      background: var(--surface-hover);
      border: 1px solid var(--border-light);
      font-size: .78rem;
      line-height: 1.45;
    }
    .payer-env.is-teste {
      background: color-mix(in srgb, var(--warning-text) 8%, var(--surface));
      border-color: color-mix(in srgb, var(--warning-text) 24%, transparent);
    }
    .payer-env.is-producao {
      background: color-mix(in srgb, var(--primary) 6%, var(--surface));
      border-color: color-mix(in srgb, var(--primary) 20%, transparent);
    }
    .payer-env-icon {
      width: 30px;
      height: 30px;
      flex: none;
      display: grid;
      place-items: center;
      border-radius: 8px;
      background: var(--surface);
      color: var(--warning-text);
    }
    .payer-env.is-producao .payer-env-icon { color: var(--primary); }
    .payer-env-icon svg { width: 16px; height: 16px; }
    .payer-env strong { display: block; font-size: .8rem; }
    .payer-env span { color: var(--text-muted); }
    .plan-option { position: relative; }
    .plan-option.active::after {
      content: '✓';
      position: absolute;
      top: .55rem;
      right: .6rem;
      display: grid;
      place-items: center;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--primary);
      color: var(--on-primary);
      font-size: .68rem;
      font-weight: 800;
    }

    @media (max-width: 860px) {
      .sub-overview { grid-template-columns: 1fr 1fr; }
      .sub-plan-card { grid-column: 1 / -1; }
    }
    @media (max-width: 560px) {
      .billing-page { width: calc(100% - 1.25rem); padding-top: 1.1rem; }
      .sub-card { padding: 1.1rem; border-radius: 16px; }
      .sub-overview { grid-template-columns: 1fr; }
      .sub-plan-card { grid-column: auto; }
      .sub-actions .btn { width: 100%; justify-content: center; }
      .sub-actions-spacer { display: none; }
      .sub-link-danger { width: 100%; text-align: center; }
      .sub-head { flex-direction: column; }
      .billing-status { align-self: flex-start; }
      .subscribe-box .btn { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: 'billing' }) %>
  <main class="billing-page" x-data="billingPage()" x-init="load()">
    <header class="billing-hero">
      <div class="billing-hero-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><path d="M7 15h3"/><path d="M16 15h1"/></svg>
      </div>
      <div class="billing-hero-copy">
        <div class="billing-eyebrow">Financeiro</div>
        <h1>Assinatura e cobranças</h1>
        <p>Gerencie seu plano, autorize pagamentos e acompanhe o histórico da licença em um só lugar.</p>
      </div>
    </header>

    <section class="sub-card" x-show="subReady" x-cloak>
      <div class="sub-head">
        <div class="sub-head-copy">
          <h2>Minha assinatura</h2>
          <p>Assine ou cancele direto por aqui. O cancelamento não devolve o valor já pago e não encurta o acesso: a licença continua até a data de validade abaixo.</p>
        </div>
        <span class="billing-status" :class="subStatusClass()" x-text="subStatusLabel()"></span>
      </div>

      <template x-if="!subscription && hasUpfrontPlan()">
        <div class="sub-state">
          <div class="sub-overview">
            <div class="sub-plan-card">
              <span class="sub-kicker">Plano ativo</span>
              <strong class="sub-plan-name" x-text="subPlanLabel(subCompany.plan)"></strong>
              <span class="sub-plan-tag">Pagamento à vista</span>
            </div>
            <div class="sub-stat" :class="{ 'is-danger': accessExpired() }">
              <span class="sub-stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
              </span>
              <div>
                <small>Acesso até</small>
                <strong x-text="subCompany.validUntil ? fmtDate(subCompany.validUntil) : '—'"></strong>
                <span class="sub-stat-note" x-show="accessExpired()">Acesso vencido</span>
              </div>
            </div>
          </div>
          <p class="sub-note">Seu plano está ativo por pagamento à vista. Para renovar, escolha um plano abaixo.</p>
        </div>
      </template>

      <template x-if="subscription">
        <div class="sub-state">
          <div class="sub-overview">
            <div class="sub-plan-card">
              <span class="sub-kicker">Seu plano</span>
              <strong class="sub-plan-name" x-text="subPlanLabel(subscription.planKey)"></strong>
              <div class="sub-plan-price"><span x-text="brl(subscription.amountCents)"></span><small>/mês</small></div>
              <span class="sub-plan-tag"
                    x-text="(subscription.status === 'cancelada' || subscription.status === 'encerrada')
                      ? 'Sem renovação automática'
                      : (subscription.status === 'pendente' ? 'Aguardando autorização' : 'Renovação automática')"></span>
            </div>
            <div class="sub-stat">
              <span class="sub-stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="M8 14h8"/><path d="M8 18h5"/></svg>
              </span>
              <div>
                <small>Próxima cobrança</small>
                <strong x-text="(subscription.status === 'cancelada' || subscription.status === 'encerrada')
                  ? '—'
                  : (subscription.nextPaymentDate ? fmtDate(subscription.nextPaymentDate) : '—')"></strong>
              </div>
            </div>
            <div class="sub-stat" :class="{ 'is-danger': accessExpired() }">
              <span class="sub-stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
              </span>
              <div>
                <small>Acesso até</small>
                <strong x-text="subCompany && subCompany.validUntil ? fmtDate(subCompany.validUntil) : '—'"></strong>
                <span class="sub-stat-note" x-show="accessExpired()">Acesso vencido</span>
              </div>
            </div>
          </div>

          <div class="sub-banner is-error"
               x-show="payerMismatch() && (subscription.status === 'pendente' || subscription.status === 'erro')">
            <span class="sub-banner-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </span>
            <div class="sub-banner-body">
              <strong>E-mail do pagador incompatível com o ambiente</strong>
              <p x-text="payerEmailProblem()"></p>
            </div>
          </div>

          <div class="sub-banner is-pending" x-show="subscription.status === 'pendente'">
            <span class="sub-banner-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <div class="sub-banner-body">
              <strong>Falta autorizar o cartão</strong>
              <p>Abra o link do Mercado Pago, autorize a assinatura e depois clique em <strong>Verificar autorização</strong>.</p>
              <ol class="sub-steps">
                <li><span>1</span> Abrir o link</li>
                <li><span>2</span> Autorizar no Mercado Pago</li>
                <li><span>3</span> Verificar aqui</li>
              </ol>
              <button type="button" class="sub-banner-link" x-show="!payerMismatch()"
                      @click="cancelSubscription(true)" :disabled="subBusy">
                Cancelar esta assinatura pendente e usar outro e-mail
              </button>
            </div>
          </div>

          <div class="sub-banner is-ok" x-show="subscription.status === 'autorizada'">
            <span class="sub-banner-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <div class="sub-banner-body">
              <strong>Assinatura ativa</strong>
              <p>Cada cobrança aprovada estende a licença por 30 dias. Você pode cancelar quando quiser.</p>
            </div>
          </div>

          <p class="sub-note" x-show="subscription.status === 'pausada'">Assinatura pausada pelo Mercado Pago. Verifique a autorização para retomar as cobranças.</p>
          <p class="sub-note" x-show="subscription.status === 'cancelada' || subscription.status === 'encerrada'">Assinatura cancelada. Não haverá novas cobranças. Você mantém o acesso até a data de validade.</p>

          <div class="sub-banner is-error" x-show="subscription.status === 'erro'">
            <span class="sub-banner-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </span>
            <div class="sub-banner-body">
              <strong>A assinatura precisa de atenção</strong>
              <p x-text="subscription.lastError || 'Não foi possível concluir a autorização. Tente novamente.'"></p>
            </div>
          </div>

          <div class="sub-actions" x-show="subscription.status !== 'cancelada' && subscription.status !== 'encerrada'">
            <template x-if="subscription.status === 'pendente' && subscription.initPoint && !payerMismatch()">
              <button type="button" class="btn" @click="openSubscriptionCheckout()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>
                Abrir autorização no Mercado Pago
              </button>
            </template>
            <button type="button" class="btn secondary" @click="verifySubscription()" :disabled="subBusy || payerMismatch()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
              <span x-text="subBusy ? 'Consultando…' : 'Verificar autorização'"></span>
            </button>
            <template x-if="subscription.status === 'autorizada' || subscription.status === 'pausada'">
              <button type="button" class="btn danger" @click="cancelSubscription()" :disabled="subBusy">Cancelar assinatura</button>
            </template>
            <template x-if="payerMismatch() && (subscription.status === 'pendente' || subscription.status === 'erro')">
              <button type="button" class="btn danger" @click="cancelSubscription(true)" :disabled="subBusy">Cancelar e corrigir e-mail</button>
            </template>
            <span class="sub-actions-spacer"></span>
            <button type="button" class="sub-link-danger" @click="notInterested()" :disabled="subBusy"
                    x-show="subscription.status === 'pendente' || subscription.status === 'erro'">
              Não quero continuar
            </button>
          </div>
        </div>
      </template>

      <div class="subscribe-box" x-show="canSubscribe()">
        <div class="subscribe-copy">
          <span class="subscribe-kicker">Próximo passo</span>
          <h3 x-text="subscription ? 'Assinar novamente' : 'Assine e continue crescendo'"></h3>
          <p>A primeira cobrança é imediata. Os dias restantes do teste são somados à licença, então você não perde o período de avaliação.</p>
        </div>
        <button type="button" class="btn" @click="openPlans()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M8 14h4"/></svg>
          Ver planos e assinar
        </button>
      </div>
    </section>

    <section class="billing-history">
      <div class="history-head">
        <div>
          <h2>Histórico de cobranças</h2>
          <p>Pagamentos, comprovantes e links de cobrança da sua licença.</p>
        </div>
      </div>

      <div class="urgent-panel" x-show="urgent.length" x-cloak>
        <span class="urgent-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        <div>
          <strong>Vencimento próximo</strong>
          <template x-for="c in urgent" :key="'urgent' + c.id">
            <p><strong x-text="c.description"></strong> — <span x-text="brl(c.amount_cents)"></span> — vence <span x-text="fmtDate(c.due_date)"></span></p>
          </template>
        </div>
      </div>

      <div class="history-card" x-show="charges.length" x-cloak>
        <div class="history-scroll">
          <table>
            <thead>
              <tr><th>Descrição</th><th>Valor</th><th>Vencimento</th><th>Status</th><th>Pago em</th><th>Instruções</th><th></th></tr>
            </thead>
            <tbody>
              <template x-for="c in charges" :key="c.id">
                <tr>
                  <td x-text="c.description"></td>
                  <td x-text="brl(c.amount_cents)"></td>
                  <td x-text="fmtDate(c.due_date)"></td>
                  <td>
                    <span class="badge" :class="c.status === 'paga' ? 'ok' : (c.status === 'cancelada' ? '' : 'off')" x-text="c.status"></span>
                    <span class="muted text-xs" x-show="c.mp_method" x-text="'(' + c.mp_method + ')'"></span>
                  </td>
                  <td class="muted" x-text="c.paid_at ? fmtDateTime(c.paid_at) : '—'"></td>
                  <td class="muted" x-text="c.instructions || '—'" style="max-width:240px;white-space:pre-wrap"></td>
                  <td class="text-right">
                    <button class="btn small" x-show="c.status === 'pendente'" @click="openPay(c)">Pagar</button>
                    <a class="btn secondary small" x-show="c.public_url" :href="c.public_url" target="_blank" rel="noopener">Link</a>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </div>

      <div class="billing-empty" x-show="!charges.length" x-cloak>
        <div class="billing-empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
        </div>
        <h3>Nenhuma cobrança por aqui</h3>
        <p>Quando você assinar ou pagar um plano à vista, as cobranças e os comprovantes aparecem nesta lista.</p>
        <button type="button" class="btn secondary" @click="openPlans()">Ver planos</button>
      </div>
    </section>
    <span class="error" x-text="error"></span>

    <dialog x-ref="plansDlg" style="max-width:760px;width:92vw">
      <div class="modal-header">
        <h2>Escolha seu plano</h2>
        <button type="button" class="modal-close" @click="$refs.plansDlg.close()">×</button>
      </div>
      <div class="modal-body">
        <p class="muted" style="margin:0 0 .8rem">
          O primeiro pagamento é imediato. A licença é estendida por 30 dias e os dias que
          ainda restam do teste são preservados.
        </p>
        <div class="plan-options">
          <template x-for="p in plans" :key="p.key">
            <button type="button" class="plan-option" :class="{ active: selectedPlan === p.key }" @click="selectedPlan = p.key">
              <strong x-text="p.label"></strong>
              <span class="price plan-price">
                <del x-show="p.promoted && p.originalPriceCents" x-text="brl(p.originalPriceCents)"></del>
                <span x-text="brl(p.priceCents) + '/mês'"></span>
              </span>
              <span class="plan-promo" x-show="p.promoted">
                <span x-text="p.promoLabel || 'Promoção'"></span>
                <span x-show="p.promoUntil" x-text="'até ' + fmtDate(p.promoUntil)"></span>
              </span>
              <small x-text="p.description + ' · ' + p.maxDevices + ' dispositivo(s)'"></small>
            </button>
          </template>
        </div>
        <div class="pay-loading" x-show="plansLoading" x-cloak>
          <span class="pay-spinner"></span>
          <span>Carregando planos da nuvem…</span>
        </div>
        <p class="error" x-show="!plansLoading && !plans.length"
           x-text="subError || 'A nuvem respondeu sem planos. Verifique a conexão e tente novamente.'"></p>
        <button type="button" class="btn secondary" x-show="!plansLoading && !plans.length"
                @click="reloadPlans()">Tentar novamente</button>
        <div class="payer-env" x-show="subGateway"
             :class="subGateway && subGateway.environment === 'teste' ? 'is-teste' : (subGateway && subGateway.environment === 'producao' ? 'is-producao' : '')">
          <span class="payer-env-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="M9 12l2 2 4-4"/></svg>
          </span>
          <div>
            <strong x-text="subGateway && subGateway.environment === 'teste' ? 'Ambiente de teste do Mercado Pago' : (subGateway && subGateway.environment === 'producao' ? 'Ambiente de produção' : 'Mercado Pago')"></strong>
            <span x-text="payerEnvHint()"></span>
          </div>
        </div>
        <label>E-mail do pagador</label>
        <input type="text" inputmode="email" name="kivo_payer_email" x-model="payerEmail"
               autocomplete="off" autocapitalize="off" spellcheck="false"
               data-lpignore="true" data-1p-ignore="true"
               :placeholder="subGateway && subGateway.environment === 'teste' ? 'test_user_...@testuser.com' : 'seu@email.com'" />
        <p class="error" x-show="payerEmailError()" x-text="payerEmailError()"></p>
        <p class="sub-note">
          <strong>Pix:</strong> o cliente não precisa de conta no Mercado Pago — ele paga pelo app de
          qualquer banco usando o QR Code ou o copia e cola.
          <strong>Assinatura no cartão:</strong> use o e-mail da conta Mercado Pago que vai autorizar
          a recorrência.
        </p>
        <p class="sub-note">
          <strong>Pix é pagamento único de 30 dias</strong>, sem débito automático. Para cobrança
          recorrente no cartão, use <strong>Assinar agora</strong>.
        </p>
        <p class="error" x-text="subError"></p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn secondary" @click="$refs.plansDlg.close()">Agora não</button>
        <button type="button" class="btn secondary" @click="buyUpfront()" :disabled="subBusy || !canSubmitPlan()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/></svg>
          <span x-text="subBusy ? 'Gerando Pix…' : 'Pagar à vista com Pix'"></span>
        </button>
        <button type="button" class="btn" @click="subscribe()" :disabled="subBusy || !canSubmitPlan()">
          <span x-text="subBusy ? 'Gerando…' : 'Assinar agora'"></span>
        </button>
      </div>
    </dialog>

    <dialog x-ref="retentionDlg" style="max-width:520px;width:92vw">
      <div class="modal-header">
        <h2>Espere! Temos uma oferta para você</h2>
        <button type="button" class="modal-close" @click="$refs.retentionDlg.close()">×</button>
      </div>
      <div class="modal-body">
        <p style="margin:0 0 .7rem;line-height:1.55">
          Que tal ficar mais um pouco? Liberamos <strong>mais 1 mês grátis</strong> para você
          continuar usando o Kivo e conhecer tudo com calma.
        </p>
        <p class="muted" style="margin:0 0 .8rem;font-size:.84rem;line-height:1.5">
          Se aceitar, a assinatura é interrompida para não gerar cobrança durante o período
          grátis. A licença é estendida em 30 dias a partir da validade atual.
        </p>
        <p class="error" x-text="retentionError"></p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn secondary" @click="declineRetention()" :disabled="retentionBusy">Não, obrigado</button>
        <button type="button" class="btn" @click="acceptRetention()" :disabled="retentionBusy">
          <span x-text="retentionBusy ? 'Aplicando…' : 'Quero mais 1 mês grátis'"></span>
        </button>
      </div>
    </dialog>

    <dialog x-ref="sorryDlg" style="max-width:520px;width:92vw">
      <div class="modal-header">
        <h2>Sentimos muito por isso</h2>
        <button type="button" class="modal-close" @click="$refs.sorryDlg.close()">×</button>
      </div>
      <div class="modal-body">
        <p style="margin:0 0 .7rem;line-height:1.6">
          Tudo bem, entendemos. Vamos encerrar a assinatura sem novas cobranças e você mantém
          o acesso até o fim do período já pago.
        </p>
        <p style="margin:0;line-height:1.6">
          Foi um prazer ter você com a gente. Estaremos por aqui aguardando uma nova
          oportunidade de trabalharmos juntos novamente. 💛
        </p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn" @click="finishDecline()" :disabled="retentionBusy">Entendi</button>
      </div>
    </dialog>

    <dialog x-ref="cancelDlg" style="max-width:480px;width:92vw">
      <div class="modal-header">
        <h2 x-text="cancelDlg.title"></h2>
        <button type="button" class="modal-close" @click="$refs.cancelDlg.close()">×</button>
      </div>
      <div class="modal-body">
        <p style="margin:0 0 .6rem;line-height:1.55" x-text="cancelDlg.message"></p>
        <p class="muted" style="margin:0;line-height:1.5;font-size:.82rem" x-show="cancelDlg.note" x-text="cancelDlg.note"></p>
        <p class="error" x-text="cancelDlg.error"></p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn secondary" @click="$refs.cancelDlg.close()" :disabled="subBusy">Voltar</button>
        <button type="button" class="btn danger" @click="confirmCancelDlg()" :disabled="subBusy">
          <span x-text="subBusy ? 'Cancelando…' : 'Cancelar assinatura'"></span>
        </button>
      </div>
    </dialog>

    <dialog x-ref="payDlg" class="pay-dialog" @close="stopPoll()">
      <header class="pay-sheet-head">
        <span class="pay-sheet-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><path d="M7 15h3"/><path d="M16 15h1"/></svg>
        </span>
        <div class="pay-sheet-title">
          <h1 x-text="charge ? ('Pagar: ' + charge.description) : 'Pagar cobrança'"></h1>
          <p>Escolha a forma de pagamento</p>
        </div>
        <button type="button" class="pay-sheet-close" @click="closePay()" aria-label="Fechar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </header>

      <div class="pay-sheet-summary">
        <div><span>Valor</span><strong x-text="charge ? brl(charge.amount_cents) : '—'"></strong></div>
        <div><span>Vencimento</span><strong x-text="charge ? fmtDate(charge.due_date) : '—'"></strong></div>
      </div>

      <div class="pay-method-grid">
        <button type="button" class="pay-method" :class="{ active: method === 'pix' }" @click="generate('pix')" :disabled="loading">
          <span class="pay-method-icon pix">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3z"/><path d="M20 14v3"/><path d="M14 20h3"/><path d="M20 20h.01"/></svg>
          </span>
          <span><strong>Pix</strong><small>QR Code na hora</small></span>
        </button>
        <button type="button" class="pay-method" :class="{ active: method === 'boleto' }" @click="generate('boleto')" :disabled="loading">
          <span class="pay-method-icon boleto">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="5" x2="4" y2="19"/><line x1="7" y1="5" x2="7" y2="19"/><line x1="11" y1="5" x2="11" y2="19"/><line x1="14" y1="5" x2="14" y2="19"/><line x1="18" y1="5" x2="18" y2="19"/><line x1="21" y1="5" x2="21" y2="19"/></svg>
          </span>
          <span><strong>Boleto</strong><small>Link para pagar</small></span>
        </button>
        <button type="button" class="pay-method" :class="{ active: method === 'card' }" @click="generate('card')" :disabled="loading">
          <span class="pay-method-icon card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><path d="M6 15h4"/></svg>
          </span>
          <span><strong>Cartão</strong><small>Checkout Mercado Pago</small></span>
        </button>
      </div>

      <div class="pay-sheet-body">
        <div class="pay-loading" x-show="loading">
          <span class="pay-spinner"></span>
          <span>Falando com a nuvem…</span>
        </div>

        <div class="pay-alert" x-show="payError && !loading">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span x-text="payError"></span>
        </div>

        <template x-if="payment">
          <div>
            <!-- Pix: QR Code + copia e cola -->
            <template x-if="payment.mp_qr_code_base64 || payment.mp_qr_code">
              <div class="pay-qr-block">
                <div class="pay-qr-copy">
                  <strong>Escaneie o QR Code</strong>
                  <small>Use o aplicativo do seu banco em Pix › Pagar com QR Code.</small>
                </div>
                <div x-show="payment.mp_qr_code_base64" class="pay-qr-image">
                  <img :src="'data:image/png;base64,' + payment.mp_qr_code_base64" alt="QR code do Pix" />
                </div>
                <label>Pix copia e cola</label>
                <div class="pay-copy-row">
                  <input type="text" readonly :value="payment.mp_qr_code || ''" />
                  <button class="btn secondary" @click="copy(payment.mp_qr_code)">Copiar</button>
                </div>
              </div>
            </template>

            <div class="pay-verify-row">
              <button class="btn secondary small" @click="verify(false)" :disabled="loading">Já paguei — verificar agora</button>
              <span class="muted text-xs" x-show="statusMsg" x-text="statusMsg"></span>
            </div>
            <p class="pay-polling" x-show="polling">Conferindo o pagamento automaticamente a cada 5 segundos…</p>

            <template x-if="payment.mp_ticket_url || payment.mp_init_point">
              <div class="pay-link-card">
                <label x-text="method === 'card'
                  ? 'Link do pagamento no cartão'
                  : (method === 'boleto' ? 'Link do boleto' : 'Link do Pix no Mercado Pago')"></label>
                <div class="pay-copy-row">
                  <input type="text" readonly :value="payment.mp_init_point || payment.mp_ticket_url || ''" />
                  <button class="btn secondary" @click="copy(payment.mp_init_point || payment.mp_ticket_url)">Copiar</button>
                  <a class="btn secondary" :href="payment.mp_init_point || payment.mp_ticket_url" target="_blank" rel="noopener">Abrir</a>
                </div>
              </div>
            </template>

            <template x-if="payment.public_url">
              <div class="pay-link-card">
                <label>Link para o cliente pagar no celular</label>
                <div class="pay-copy-row">
                  <input type="text" readonly :value="payment.public_url" />
                  <button class="btn secondary" @click="copy(payment.public_url)">Copiar</button>
                </div>
                <p class="muted text-xs">Pode mandar por WhatsApp ou e-mail: a página abre sem login e mostra só esta cobrança.</p>
              </div>
            </template>
          </div>
        </template>

        <template x-if="!payment && !loading && !payError">
          <div class="pay-empty">
            <div class="pay-empty-art">
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="20" width="48" height="32" rx="5"/><path d="M8 29h48"/><path d="M18 40h10"/><circle cx="45" cy="40" r="3"/></svg>
            </div>
            <strong>Pronto para receber</strong>
            <p>Escolha Pix, boleto ou cartão para gerar o QR Code ou link de pagamento.</p>
          </div>
        </template>
      </div>

      <footer class="pay-sheet-footer">
        <button class="btn secondary" @click="closePay()">Fechar</button>
      </footer>
    </dialog>
  </main>
  <script nonce="<%= cspNonce %>">
    function billingPage() {
      return {
        charges: [], urgent: [], error: '',
        charge: null, method: 'pix', payment: null,
        loading: false, payError: '', statusMsg: '', polling: false, pollTimer: null,
        subscription: null, plans: [], subCompany: null, subReady: false, subBusy: false,
        subGateway: null,
        subError: '', selectedPlan: '', payerEmail: '',
        retentionAvailable: false, retentionBusy: false, retentionMode: '', retentionError: '',
        retentionShown: false, licenseStatus: null,
        cancelDlg: { title: '', message: '', note: '', error: '', force: false },
        plansLoading: false,

        async load() {
          void this.loadSubscription(true);
          fetch('/api/license/status')
            .then((r) => (r.ok ? r.json() : null))
            .then((d) => { this.licenseStatus = d; this.maybeOfferRetention(); })
            .catch(() => {});
          const r = await fetch('/api/billing/charges');
          if (r.ok) {
            this.charges = await r.json();
            const now = Date.now();
            const threeDays = 3 * 24 * 3600e3;
            this.urgent = this.charges.filter((c) => c.status === 'pendente' && new Date(c.due_date).getTime() - now <= threeDays);
          } else {
            showToast('Não foi possível carregar as cobranças (sem licença configurada ou nuvem indisponível).', 'error');
          }
        },

        async loadSubscription(sync) {
          try {
            const r = await fetch('/api/billing/subscription' + (sync ? '?sync=1' : ''));
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
              this.subError = body.error || 'Não foi possível carregar a assinatura.';
              this.subReady = true;
              return;
            }
            this.subscription = body.subscription || null;
            this.plans = body.plans || [];
            this.subCompany = body.company || null;
            this.subGateway = body.gateway || null;
            this.retentionAvailable = !!(body.retention && body.retention.available);
            if (!this.selectedPlan && this.plans.length) {
              const preferido = this.plans.find((p) => p.key === this.subCompany?.plan) || this.plans[1] || this.plans[0];
              this.selectedPlan = preferido.key;
            }
            if (!this.payerEmail) {
              // Sugere o e-mail da empresa; o e-mail da assinatura antiga só volta quando
              // ela está ativa. Assinatura pendente/cancelada pode ter sido criada com o
              // e-mail errado — sugerir de novo perpetuaria o erro.
              const sugerido = (this.subscription?.status === 'autorizada' && this.subscription.payerEmail)
                || this.subCompany?.email
                || '';
              const email = sugerido.trim().toLowerCase();
              const ambiente = this.subGateway?.environment;
              const emailCompativel = email.includes('@')
                && (ambiente !== 'teste' || email.endsWith('@testuser.com'))
                && (ambiente !== 'producao' || !email.endsWith('@testuser.com'));
              // Não sugere um e-mail que o Mercado Pago vai recusar no ambiente atual.
              this.payerEmail = emailCompativel ? sugerido : '';
            }
            this.subError = '';
            this.subReady = true;
            this.maybeOfferRetention();
          } catch (e) {
            this.subError = 'Sem conexão com a nuvem para carregar a assinatura.';
            this.subReady = true;
          }
        },

        subPlanLabel(key) {
          const p = this.plans.find((x) => x.key === key);
          return p ? p.label : (key || '—');
        },
        hasUpfrontPlan() {
          const c = this.subCompany;
          if (!c || !c.plan || c.plan === 'trial' || !c.validUntil) return false;
          return new Date(c.validUntil).getTime() > Date.now();
        },
        subStatusLabel() {
          const s = this.subscription;
          if (!s) return this.hasUpfrontPlan() ? 'Plano ativo (à vista)' : 'Sem assinatura';
          return ({
            pendente: 'Aguardando autorização',
            autorizada: 'Ativa',
            pausada: 'Pausada',
            cancelada: 'Cancelada',
            encerrada: 'Encerrada',
            erro: 'Precisa de atenção',
          })[s.status] || s.status;
        },
        subStatusClass() {
          const s = this.subscription;
          if (!s) return this.hasUpfrontPlan() ? 'is-ok' : 'is-off';
          if (s.status === 'autorizada') return 'is-ok';
          if (s.status === 'pendente' || s.status === 'pausada') return 'is-pending';
          if (s.status === 'erro') return 'is-error';
          return 'is-off';
        },
        accessExpired() {
          const validUntil = this.subCompany?.validUntil;
          if (!validUntil) return false;
          const d = new Date(validUntil);
          return Number.isFinite(d.getTime()) && d.getTime() < Date.now();
        },
        /** Valida o e-mail do pagador antes de chamar o Mercado Pago. */
        payerEmailError() {
          const email = (this.payerEmail || '').trim().toLowerCase();
          if (!email) return '';
          if (!email.includes('@')) return 'Informe um e-mail válido.';
          if (email === 'test_user_7923436665712574587@testuser.com') {
            return 'Use o e-mail de um comprador de teste criado na sua própria conta, não o exemplo das instruções.';
          }
          const ambiente = this.subGateway?.environment;
          if (ambiente === 'teste' && !email.endsWith('@testuser.com')) {
            return 'Este ambiente é de teste. Use o e-mail de um usuário de teste, terminado em @testuser.com.';
          }
          if (ambiente === 'producao' && email.endsWith('@testuser.com')) {
            return 'Este ambiente é de produção. Use o e-mail de uma conta Mercado Pago real.';
          }
          return '';
        },
        payerEnvHint() {
          if (!this.subGateway) return '';
          if (!this.subGateway.configured) {
            return 'O Mercado Pago ainda não está configurado na nuvem. Fale com o suporte antes de assinar.';
          }
          if (this.subGateway.environment === 'teste') {
            return 'Ambiente de teste: use um comprador de teste da sua conta (test_user_...@testuser.com), inclusive para Pix. Em produção, o Pix aceita o e-mail do cliente sem conta no Mercado Pago.';
          }
          if (this.subGateway.environment === 'producao') {
            return 'Para Pix, use o e-mail do cliente — ele não precisa de conta no Mercado Pago. Para a assinatura no cartão, use o e-mail da conta Mercado Pago que vai autorizar.';
          }
          return 'Para Pix, use o e-mail do cliente. Para a assinatura no cartão, use o e-mail da conta Mercado Pago que vai autorizar.';
        },
        /** A assinatura existente foi criada com um e-mail do ambiente errado. */
        payerEmailProblem() {
          // E-mail de exemplo que as instruções antigas mostravam. Quem copiou ficou com
          // uma assinatura que o Mercado Pago recusa (o usuário de teste é de outra conta).
          const exemploAntigo = 'test_user_7923436665712574587@testuser.com';
          const email = (this.subscription?.payerEmail || '').trim().toLowerCase();
          const ambiente = this.subGateway?.environment;
          if (email === exemploAntigo) {
            return 'Esta assinatura foi criada com um e-mail de exemplo das instruções antigas. Ele não pertence à sua conta de teste. Cancele e crie novamente usando um comprador de teste criado por você.';
          }
          if (!email || !ambiente || ambiente === 'desconhecido') return '';
          if (ambiente === 'teste' && !email.endsWith('@testuser.com')) {
            return 'Esta assinatura foi criada com um e-mail real, mas o Mercado Pago está em teste. Cancele e crie novamente usando um e-mail de comprador de teste da sua conta.';
          }
          if (ambiente === 'producao' && email.endsWith('@testuser.com')) {
            return 'Esta assinatura foi criada com um e-mail de teste, mas o Mercado Pago está em produção. Cancele e crie novamente com uma conta real.';
          }
          return '';
        },
        payerMismatch() {
          return !!this.payerEmailProblem();
        },
        canSubmitPlan() {
          return !!this.selectedPlan && !!this.payerEmail.trim() && !this.payerEmailError();
        },
        canSubscribe() {
          const s = this.subscription;
          return !s || s.status === 'cancelada' || s.status === 'encerrada' || s.status === 'erro';
        },
        openSubscriptionCheckout() {
          if (this.subscription && this.subscription.initPoint) {
            window.open(this.subscription.initPoint, '_blank', 'noopener');
          }
        },
        openPlans() {
          // Não limpa `subError` aqui: se a carga da assinatura falhou, o modal precisa
          // mostrar o motivo real, e não a mensagem genérica de "verifique a conexão".
          if (this.payerEmail && !this.payerEmail.includes('@')) this.payerEmail = '';
          if (this.$refs.plansDlg) this.$refs.plansDlg.showModal();
          if (!this.plans.length && !this.plansLoading) void this.reloadPlans();
        },
        async reloadPlans() {
          if (this.plansLoading) return;
          this.plansLoading = true;
          this.subError = '';
          try {
            await this.loadSubscription(false);
          } finally {
            this.plansLoading = false;
          }
        },
        maybeOfferRetention() {
          if (this.retentionShown || !this.retentionAvailable) return;
          const s = this.licenseStatus;
          if (s && s.plan === 'trial' && (s.status === 'tolerancia' || s.status === 'expirada')) {
            this.retentionShown = true;
            this.showRetention('trial');
          }
        },
        showRetention(mode) {
          this.retentionMode = mode || 'cancel';
          this.retentionError = '';
          if (this.$refs.retentionDlg) this.$refs.retentionDlg.showModal();
        },
        async acceptRetention() {
          this.retentionBusy = true; this.retentionError = '';
          try {
            const r = await fetch('/api/billing/retention/accept', { method: 'POST' });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
              this.retentionError = body.error || 'Não foi possível aplicar o mês grátis.';
              return;
            }
            if (this.$refs.retentionDlg) this.$refs.retentionDlg.close();
            showToast(body.message || 'Você ganhou mais 1 mês grátis.', 'success');
            setTimeout(() => window.location.reload(), 1200);
          } catch (e) {
            this.retentionError = 'Falha de conexão ao aplicar o mês grátis.';
          } finally {
            this.retentionBusy = false;
          }
        },
        declineRetention() {
          if (this.$refs.retentionDlg) this.$refs.retentionDlg.close();
          if (this.$refs.sorryDlg) this.$refs.sorryDlg.showModal();
        },
        async finishDecline() {
          this.retentionBusy = true;
          try {
            await fetch('/api/billing/retention/decline', { method: 'POST' });
          } catch (e) {
            // O registro é best-effort; a tela de despedida não deve travar por isso.
          } finally {
            this.retentionBusy = false;
            if (this.$refs.sorryDlg) this.$refs.sorryDlg.close();
            setTimeout(() => window.location.reload(), 800);
          }
        },
        notInterested() {
          if (this.retentionAvailable) {
            this.showRetention('exit');
            return;
          }
          this.finishDecline();
        },
        async subscribe() {
          const emailError = this.payerEmailError();
          if (!this.selectedPlan || !this.payerEmail.trim() || emailError) {
            this.subError = emailError || 'Escolha um plano e informe o e-mail do pagador.';
            return;
          }
          this.subBusy = true; this.subError = '';
          try {
            const r = await fetch('/api/billing/subscription', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ planKey: this.selectedPlan, payerEmail: this.payerEmail.trim() }),
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
              this.subError = body.error || 'Não foi possível criar a assinatura.';
              return;
            }
            await this.loadSubscription(false);
            if (this.$refs.plansDlg) this.$refs.plansDlg.close();
            if (body.initPoint) window.open(body.initPoint, '_blank', 'noopener');
            showToast('Assinatura criada. Autorize o cartão no Mercado Pago.', 'info');
          } catch (e) {
            this.subError = 'Falha de conexão ao criar a assinatura.';
          } finally {
            this.subBusy = false;
          }
        },
        async buyUpfront() {
          const emailError = this.payerEmailError();
          if (!this.selectedPlan || !this.payerEmail.trim() || emailError) {
            this.subError = emailError || 'Escolha um plano e informe o e-mail do pagador.';
            return;
          }
          this.subBusy = true; this.subError = '';
          try {
            const r = await fetch('/api/billing/upfront', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ planKey: this.selectedPlan, payerEmail: this.payerEmail.trim() }),
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
              this.subError = body.error || 'Não foi possível gerar a cobrança à vista.';
              return;
            }
            if (this.$refs.plansDlg) this.$refs.plansDlg.close();
            if (body.charge) {
              this.charges = [body.charge, ...this.charges.filter((c) => c.id !== body.charge.id)];
              this.openPay(body.charge);
            }
          } catch (e) {
            this.subError = 'Falha de conexão ao gerar a cobrança à vista.';
          } finally {
            this.subBusy = false;
          }
        },
        async verifySubscription() {
          this.subBusy = true; this.subError = '';
          try {
            await this.loadSubscription(true);
            showToast('Status da assinatura atualizado.', 'info');
          } finally {
            this.subBusy = false;
          }
        },
        cancelSubscription(force = false) {
          if (!force && this.retentionAvailable) {
            this.showRetention('cancel');
            return;
          }
          this.cancelDlg = {
            force: !!force,
            title: force ? 'Cancelar assinatura pendente?' : 'Cancelar assinatura?',
            message: force
              ? 'Esta assinatura ainda não foi autorizada. Vamos cancelá-la para você criar outra com o e-mail correto.'
              : 'Não haverá novas cobranças. O acesso continua até o fim do período já pago.',
            note: force ? 'Nenhuma cobrança foi feita até agora.' : 'O valor já pago não é devolvido.',
            error: '',
          };
          this.$refs.cancelDlg.showModal();
        },
        async confirmCancelDlg() {
          this.subBusy = true;
          this.cancelDlg.error = '';
          try {
            const r = await fetch('/api/billing/subscription/cancel', { method: 'POST' });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
              this.cancelDlg.error = body.error || 'Não foi possível cancelar a assinatura.';
              return;
            }
            this.$refs.cancelDlg.close();
            await this.loadSubscription(true);
            showToast(body.message || 'Assinatura cancelada.', 'success');
          } catch (e) {
            this.cancelDlg.error = 'Falha de conexão ao cancelar a assinatura.';
          } finally {
            this.subBusy = false;
          }
        },

        brl(cents) { return window.brl(cents); },

        openPay(charge) {
          this.charge = charge;
          this.payment = null;
          this.payError = '';
          this.statusMsg = '';
          this.method = 'pix';
          this.$refs.payDlg.showModal();
          this.generate('pix');
        },
        closePay() {
          this.stopPoll();
          this.$refs.payDlg.close();
        },

        async generate(method) {
          if (!this.charge) return;
          this.method = method;
          this.loading = true;
          this.payError = '';
          this.statusMsg = '';
          try {
            const r = await fetch(`/api/billing/charges/${this.charge.id}/payment`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ method }),
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
              this.payError = body.error ?? 'Não foi possível gerar o pagamento.';
              this.payment = null;
              return;
            }
            this.payment = body;
            // Pix: confere sozinho enquanto a janela estiver aberta (o webhook costuma chegar
            // antes, mas quem paga no banco não deveria ter de clicar em "já paguei").
            if (method === 'pix') this.startPoll();
          } catch (e) {
            this.payError = 'Falha de rede ao gerar o pagamento: ' + e.message;
          } finally {
            this.loading = false;
          }
        },

        startPoll() {
          this.stopPoll();
          this.polling = true;
          this.pollTimer = setInterval(() => this.verify(true), 5000);
        },
        stopPoll() {
          if (this.pollTimer) clearInterval(this.pollTimer);
          this.pollTimer = null;
          this.polling = false;
        },

        async verify(silent) {
          if (!this.charge) return;
          try {
            const r = await fetch(`/api/billing/charges/${this.charge.id}/status`);
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
              if (!silent) this.payError = body.error ?? 'Não foi possível consultar o pagamento.';
              return;
            }
            if (body.status === 'paga') {
              this.stopPoll();
              const extra = body.extended_days ? ` Licença válida até ${fmtDate(body.valid_until)} (+${body.extended_days} dias).` : '';
              showToast('Pagamento confirmado! Cobrança baixada.' + extra, 'success');
              this.$refs.payDlg.close();
              this.load();
              return;
            }
            if (!silent) {
              this.statusMsg = body.mp_status
                ? `O Mercado Pago ainda não confirmou: ${body.mp_status}${body.mp_status_detail ? ' (' + body.mp_status_detail + ')' : ''}.`
                : 'O pagamento ainda não foi confirmado.';
            }
          } catch (e) {
            if (!silent) this.payError = 'Falha ao consultar: ' + e.message;
          }
        },

        copy(value) {
          if (!value) return;
          const done = () => showToast('Copiado!', 'success');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value).then(done).catch(done);
            return;
          }
          done();
        },
      };
    }
  </script>
</body>
</html>
