<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Usuários</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <script defer src="/vendor/alpine.min.js"></script>
  <style>
    .solo-admin-warn {
      display: flex; align-items: flex-start; gap: .7rem;
      border: 1.5px solid var(--warning); border-radius: 12px;
      background: var(--warning-soft); padding: .8rem .9rem;
      margin: 0 0 1rem; font-size: .86rem; line-height: 1.45;
    }
    .solo-admin-warn > svg { color: var(--warning); flex: none; margin-top: .1rem; }
    .solo-admin-warn > div { flex: 1; }
    .solo-admin-warn strong { display: block; margin-bottom: .15rem; }
    .solo-admin-warn .btn { flex: none; align-self: center; }
    .solo-admin-close {
      background: none; border: 0; color: var(--text-muted); cursor: pointer;
      flex: none; padding: .15rem; line-height: 0;
    }
    .solo-admin-close:hover { color: var(--text); }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: 'users' }) %>
  <main x-data="usersPage()" x-init="load()">
    <h1>Usuários</h1>

    <%# Um administrador só é o cenário em que perder a senha tranca a loja para fora do
        próprio sistema — o resgate pelo suporte existe justamente por causa dele, mas é
        uma ligação a menos se houver um segundo acesso. Dispensável (fica no
        localStorage) para não virar barulho em quem trabalha sozinho de propósito. %>
    <% if (user.permissions.has('users.create')) { %>
    <div class="solo-admin-warn" x-show="resetters !== null && resetters <= 1 && !soloDismissed" x-cloak>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div>
        <strong>Só existe um acesso capaz de redefinir senhas.</strong>
        Se essa senha for perdida, ninguém aqui dentro consegue destravar — só o suporte,
        por telefone. Crie um segundo administrador de confiança e isso deixa de ser risco.
      </div>
      <button type="button" class="btn secondary small" @click="openNew()">Criar agora</button>
      <button type="button" class="solo-admin-close" @click="dismissSolo()" title="Dispensar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <% } %>

    <div class="toolbar">
      <% if (user.permissions.has('users.create')) { %>
        <button class="btn" @click="openNew()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg> Novo usuário</button>
      <% } %>
      <input type="text" placeholder="Filtrar por nome, usuário ou cargo…" x-model="q"
             class="input-search-ghost" style="min-width:260px" />
      <span class="error" x-text="error"></span>
    </div>
    <% if (user.permissions.has('users.delete')) { %>
    <div class="bulk-bar" x-show="selectedIds.length" x-cloak>
      <span class="bulk-count" x-text="selectedIds.length + ' selecionado(s)'"></span>
      <button class="btn danger small" @click="bulkDelete('/api/users', { label: 'usuário(s)', onDone: onBulkDeleted })"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg> Excluir selecionados</button>
      <button class="btn secondary small" @click="clearSelection()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg> Cancelar</button>
    </div>
    <% } %>
    <table>
      <thead>
        <tr>
          <% if (user.permissions.has('users.delete')) { %>
          <th class="col-checkbox">
            <input type="checkbox" :checked="isAllSelected(displayRows)" @change="toggleSelectAll(displayRows)"
                   x-effect="$el.indeterminate = selectedIds.length > 0 && !isAllSelected(displayRows)" />
          </th>
          <% } %>
          <th @click="sortCycle('name')" class="sortable">Nome<span class="sort-arrow" x-text="sortArrow('name')"></span></th>
          <th @click="sortCycle('username')" class="sortable">Usuário<span class="sort-arrow" x-text="sortArrow('username')"></span></th>
          <th @click="sortCycle('role')" class="sortable">Cargo<span class="sort-arrow" x-text="sortArrow('role')"></span></th>
          <th @click="sortCycle('active')" class="sortable">Status<span class="sort-arrow" x-text="sortArrow('active')"></span></th>
          <th @click="sortCycle('last_login_at')" class="sortable">Último login<span class="sort-arrow" x-text="sortArrow('last_login_at')"></span></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <template x-for="u in displayRows" :key="u.id">
          <tr>
            <% if (user.permissions.has('users.delete')) { %>
            <td class="col-checkbox" @click.stop>
              <input type="checkbox" :checked="isSelected(u.id)" @change="toggleSelect(u.id)" />
            </td>
            <% } %>
            <td x-text="u.name"></td>
            <td x-text="u.username"></td>
            <td x-text="u.role"></td>
            <td><span class="badge" :class="u.active ? 'ok' : 'off'" x-text="u.active ? 'ativo' : 'inativo'"></span></td>
            <td class="muted" x-text="u.last_login_at ?? '—'"></td>
            <td class="text-right" @click.stop>
              <div class="dropdown">
                <button class="icon-btn" @click="openMenu = openMenu === u.id ? null : u.id" title="Mais ações">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                  </svg>
                </button>
                <div class="dropdown-menu" x-show="openMenu === u.id" x-cloak @click.outside="openMenu = null">
                  <% if (user.permissions.has('users.edit')) { %>
                  <button @click="openMenu = null; openEdit(u)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    Editar
                  </button>
                  <% } %>
                  <% if (user.permissions.has('users.remote.manage')) { %>
                  <button @click="openMenu = null; openRemote(u)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
                    Acesso pelo celular
                  </button>
                  <% } %>
                  <% if (user.permissions.has('users.delete')) { %>
                  <button class="danger" @click="openMenu = null; remove(u)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    Excluir
                  </button>
                  <% } %>
                </div>
              </div>
            </td>
          </tr>
        </template>
        <tr x-show="!displayRows.length"><td colspan="7"><%- include('partials/empty-state', { message: 'Nenhum usuário cadastrado ainda.' }) %></td></tr>
      </tbody>
    </table>

    <dialog x-ref="dlg" class="dialog-fixed">
      <h1 x-text="form.id ? 'Editar usuário' : 'Novo usuário'"></h1>
      <div class="dialog-body">
        <label>Nome</label><input type="text" x-model="form.name" />
        <label>Usuário</label><input type="text" x-model="form.username" :disabled="!!form.id" />
        <label>E-mail</label><input type="text" x-model="form.email" />
        <label>Cargo</label>
        <select x-model="form.roleSlug">
          <template x-for="r in roles"><option :value="r" x-text="r" :selected="r === form.roleSlug"></option></template>
        </select>
        <label x-text="form.id ? 'Nova senha (deixe vazio para manter)' : 'Senha'"></label>
        <input type="password" x-model="form.password" />
        <template x-if="form.id">
          <label class="label-checkbox" style="margin-top:.7rem">
            <input type="checkbox" x-model="form.active" /> Ativo
          </label>
        </template>

        <%# Entrada rápida. O aviso é obrigatório e não é decorativo: a caixa liga login SEM
            SENHA, e quem marca precisa saber exatamente o que está trocando por comodidade. %>
        <label class="label-checkbox" style="margin-top:.9rem">
          <input type="checkbox" x-model="form.quickLogin" />
          Salvar perfil neste computador (entrar com um clique)
        </label>
        <p class="hint" style="margin:.4rem 0 0">
          O usuário vira um balão na tela de login e entra <strong>sem digitar senha</strong> —
          bom para a loja onde várias pessoas se revezam no mesmo caixa, para cada uma usar a
          própria conta em vez de todas no mesmo login.
        </p>
        <p class="hint" style="margin:.35rem 0 0">
          Vale <strong>só neste computador</strong> e só para quem está nele: pela rede local
          (celular, tablet) o balão não aparece e a senha continua obrigatória. Qualquer pessoa
          com acesso a este teclado consegue entrar como <span x-text="form.name || 'este usuário'"></span>.
        </p>

        <div class="error" x-text="dlgError"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlg.close()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg> Cancelar</button>
        <button class="btn" @click="save()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Salvar</button>
      </div>
    </dialog>

    <%# O link mostrado aqui É a credencial: ele não fica guardado em lugar nenhum (o banco
        só tem o sha256). Fechou o diálogo, para reaver é preciso gerar outro — o que também
        invalida o anterior. É por isso que o aviso é explícito. %>
    <dialog x-ref="remoteDlg" class="dialog-fixed">
      <h1>Acesso pelo celular</h1>
      <div class="dialog-body">
        <p class="hint mt-0">
          Usuário: <strong x-text="remote.user?.name"></strong>
          (<span x-text="remote.user?.username"></span>)
        </p>

        <template x-if="!remote.available">
          <div class="variant-guide" style="margin:.5rem 0">
            <p style="margin:0 0 .35rem"><strong>Disponível no plano Diamante.</strong></p>
            <p class="muted text-xs" style="margin:0">
              O Kivo Web deixa acompanhar a loja e montar orçamento pelo celular. Seu plano atual:
              <span x-text="remote.plan ?? '—'"></span>.
            </p>
          </div>
        </template>

        <template x-if="remote.available && !remote.url">
          <div>
            <p class="hint">
              Gera um link exclusivo deste usuário. Quem abrir o link entra no Kivo Web com o
              <strong>cargo e as permissões que ele já tem</strong> aqui — sem senha nova.
            </p>
            <template x-if="remote.existing">
              <p class="hint" style="color:var(--warning-text)">
                Este usuário já tem um acesso ativo (criado em <span x-text="remote.existing.created_at"></span>,
                último uso: <span x-text="remote.existing.last_used_at ?? 'nunca'"></span>).
                Gerar um novo <strong>invalida o anterior</strong>.
              </p>
            </template>
          </div>
        </template>

        <template x-if="remote.url">
          <div style="text-align:center">
            <img :src="remote.qr" alt="QR code do acesso" width="240" height="240"
                 style="border-radius:8px;background:#fff;padding:8px" />
            <p class="hint" style="margin:.6rem 0 .3rem">Aponte a câmera do celular para o QR, ou copie o link:</p>
            <div class="flex-row" style="align-items:center;gap:.5rem;justify-content:center">
              <code x-text="remote.url" style="font-size:.75rem;padding:.3rem .5rem;background:var(--surface-hover);border-radius:6px;word-break:break-all"></code>
              <button type="button" class="btn secondary small" @click="copyRemote()" x-text="remote.copied ? 'Copiado!' : 'Copiar'"></button>
            </div>
            <p class="hint" style="color:var(--danger);margin-top:.75rem">
              <strong>Guarde como se fosse uma senha.</strong> Quem tiver este link entra na conta.
              Ele não será mostrado de novo — se precisar, gere outro (o atual deixa de valer).
            </p>
          </div>
        </template>

        <div class="error" x-text="remote.error"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.remoteDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Fechar
        </button>
        <button class="btn danger" x-show="remote.existing && !remote.url" x-cloak
                :disabled="remote.saving" @click="revokeRemote()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          Revogar acesso
        </button>
        <button class="btn" x-show="remote.available && !remote.url" x-cloak
                :disabled="remote.saving" @click="generateRemote()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
          <span x-text="remote.saving ? 'Gerando…' : (remote.existing ? 'Gerar novo link' : 'Gerar link')"></span>
        </button>
      </div>
    </dialog>
  </main>
  <script src="/js/table-toolkit.js"></script>
  <script>
    function usersPage() {
      return {
        ...tableToolkit(),
        users: [], roles: ['administrador','gerente','operador','caixa','entregador','estoquista'],
        form: {}, q: '', error: '', dlgError: '',
        // Quantas pessoas conseguem redefinir a senha de outra (permissão users.edit).
        // `null` enquanto não carregou, para o aviso não piscar em toda abertura da tela.
        resetters: null,
        soloDismissed: localStorage.getItem('kivo-solo-admin-ok') === '1',
        remote: { user: null, available: false, plan: null, existing: null, url: '', qr: '', error: '', saving: false, copied: false },
        sortGetters: {
          name: (u) => u.name, username: (u) => u.username, role: (u) => u.role ?? '',
          active: (u) => (u.active ? 1 : 0), last_login_at: (u) => u.last_login_at ?? '',
        },
        get filteredRows() {
          if (!this.q.trim()) return this.users;
          const t = this.q.toLowerCase();
          return this.users.filter((u) =>
            (u.name ?? '').toLowerCase().includes(t) ||
            (u.username ?? '').toLowerCase().includes(t) ||
            (u.role ?? '').toLowerCase().includes(t));
        },
        get displayRows() { return this.sortedRows(this.filteredRows, this.sortGetters); },
        async load() {
          const r = await fetch('/api/users');
          if (r.ok) { this.users = await r.json(); this.pruneSelection(this.users); } else showToast((await r.json()).error, 'error');
          const roles = await fetch('/api/users/roles');
          if (roles.ok) this.roles = (await roles.json()).map((x) => x.slug);
          // Quem pode redefinir senha é decidido por permissão, não pelo nome do cargo —
          // um cargo personalizado pode ter `users.edit` sem se chamar "administrador".
          // Por isso vem do servidor em vez de ser contado aqui pela lista de cargos.
          try {
            const st = await fetch('/api/recovery/status');
            if (st.ok) {
              const body = await st.json();
              // Envelope { success, data } — ver shared/responseEnvelope.ts.
              this.resetters = (body && body.data ? body.data : body).administradores;
            }
          } catch (e) { /* aviso é melhoria, não pode derrubar a tela */ }
        },
        dismissSolo() {
          this.soloDismissed = true;
          localStorage.setItem('kivo-solo-admin-ok', '1');
        },
        // ─── Acesso pelo celular (Kivo Web) ───
        async openRemote(u) {
          this.remote = { user: u, available: false, plan: null, existing: null, url: '', qr: '', error: '', saving: false, copied: false };
          this.$refs.remoteDlg.showModal();
          const r = await fetch('/api/remote/status');
          if (!r.ok) { this.remote.error = ((await r.json()) || {}).error ?? 'Falha ao consultar o status.'; return; }
          const st = await r.json();
          this.remote.available = st.available;
          this.remote.plan = st.plan;
          this.remote.existing = (st.accesses || []).find((a) => a.user_id === u.id && !a.revoked_at) ?? null;
        },
        async generateRemote() {
          this.remote.saving = true; this.remote.error = '';
          const r = await fetch(`/api/remote/users/${this.remote.user.id}/grant`, { method: 'POST' });
          this.remote.saving = false;
          if (!r.ok) { this.remote.error = ((await r.json()) || {}).error ?? 'Falha ao gerar o acesso.'; return; }
          const d = await r.json();
          this.remote.url = d.url; this.remote.qr = d.qr;
        },
        async revokeRemote() {
          if (!await window.confirmDlg('Revogar o acesso pelo celular deste usuário? O link atual deixa de funcionar.')) return;
          this.remote.saving = true; this.remote.error = '';
          const r = await fetch(`/api/remote/users/${this.remote.user.id}/grant`, { method: 'DELETE' });
          this.remote.saving = false;
          if (!r.ok) { this.remote.error = ((await r.json()) || {}).error ?? 'Falha ao revogar.'; return; }
          this.remote.existing = null;
          showToast('Acesso revogado.', 'success');
        },
        copyRemote() {
          navigator.clipboard?.writeText(this.remote.url).then(() => {
            this.remote.copied = true;
            setTimeout(() => { this.remote.copied = false; }, 1500);
          });
        },
        onBulkDeleted(data) {
          this.load();
          if (data && data.selfSkipped) showToast('Seu próprio usuário não pode ser excluído em massa — foi mantido na lista.', 'warning');

        },
        openNew() { this.form = { roleSlug: 'operador', quickLogin: false }; this.dlgError = ''; this.$refs.dlg.showModal(); },
        openEdit(u) {
          this.form = { id: u.id, name: u.name, username: u.username, email: u.email ?? '', roleSlug: u.role,
                        active: !!u.active, password: '', quickLogin: !!u.quickLogin };
          this.dlgError = ''; this.$refs.dlg.showModal();
        },
        async save() {
          const isEdit = !!this.form.id;
          const body = { ...this.form };
          if (isEdit && !body.password) delete body.password;
          const r = await fetch(isEdit ? `/api/users/${this.form.id}` : '/api/users', {
            method: isEdit ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (r.ok) { this.$refs.dlg.close(); this.load(); showToast('Usuário salvo.', 'success'); }
          else { this.dlgError = (await r.json()).error ?? 'Erro ao salvar.'; showToast(this.dlgError, 'error'); }
        },
        async remove(u) {
          if (!await window.confirmDlg(`Excluir o usuário "${u.name}"?`)) return;
          const r = await fetch(`/api/users/${u.id}`, { method: 'DELETE' });
          if (r.ok) { this.load(); showToast('Usuário excluído.', 'success'); } else showToast((await r.json()).error ?? 'Erro ao excluir.', 'error');
        },
      };
    }
  </script>
</body>
</html>

