<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Configurações</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <script defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <%- include('partials/nav', { user, page: 'settings' }) %>
  <main x-data="settingsPage()" x-init="load()">
    <h1>Configurações</h1>

    <div class="tabs">
      <button :class="{ active: tab === 'license' }" @click="setTab('license')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></svg>
        Licença
      </button>
      <button :class="{ active: tab === 'empresa' }" @click="setTab('empresa')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/></svg>
        Empresa
      </button>
      <button :class="{ active: tab === 'stock' }" @click="setTab('stock')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
        Estoque
      </button>
      <button :class="{ active: tab === 'sales' }" @click="setTab('sales')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        Vendas
      </button>
      <button :class="{ active: tab === 'financeiro' }" @click="setTab('financeiro')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Financeiro
      </button>
      <button :class="{ active: tab === 'fidelidade' }" @click="setTab('fidelidade')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 8 8 12 8c4 0 5-4 7.5-4a2.5 2.5 0 0 1 0 5H18"/><path d="M12 9v10M18 9v10"/></svg>
        Fidelidade
      </button>
      <button :class="{ active: tab === 'interface' }" @click="setTab('interface')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        Interface
      </button>
      <% if (user.permissions.has('settings.edit')) { %>
      <button :class="{ active: tab === 'rede' }" @click="setTab('rede')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="18" x2="6.01" y2="18"/><line x1="10" y1="18" x2="10.01" y2="18"/><path d="M6 14V7a6 6 0 0 1 12 0v7"/></svg>
        Rede local
      </button>
      <% } %>
      <% if (user.permissions.has('settings.edit')) { %>
      <button :class="{ active: tab === 'cardapio' }" @click="setTab('cardapio')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Cardápio online
      </button>
      <% } %>
      <% if (user.permissions.has('settings.edit') || user.permissions.has('security.pin.manage')) { %>
      <button :class="{ active: tab === 'security' }" @click="setTab('security')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Segurança
      </button>
      <% } %>
      <% if (user.permissions.has('settings.edit')) { %>
      <button :class="{ active: tab === 'atualizacao' }" @click="setTab('atualizacao')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
        Atualização
        <span x-show="temAtualizacao" x-cloak class="badge ok" style="margin-left:.35rem">1</span>
      </button>
      <% } %>
      <% if (user.permissions.has('settings.edit')) { %>
      <button :class="{ active: tab === 'advanced' }" @click="setTab('advanced')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Avançado
      </button>
      <% } %>
    </div>

    <!-- ═══════ ABA: LICENÇA ═══════ -->
    <div x-show="tab === 'license'">
      <% if (user.permissions.has('license.view')) { %>
      <section class="panel">
        <h2>Status da licença</h2>
        <table>
          <tbody>
            <tr><th>Status</th><td><span class="badge" :class="license.status === 'valida' ? 'ok' : 'off'" x-text="license.message"></span></td></tr>
            <tr><th>Empresa (UUID)</th><td class="muted" x-text="license.companyUuid ?? 'não configurada'"></td></tr>
            <tr><th>Machine ID</th><td class="muted" x-text="license.machineId"></td></tr>
            <tr><th>Plano</th><td x-text="license.plan ?? '—'"></td></tr>
            <tr><th>Atualizações automáticas</th><td><span class="badge" :class="license.canAutoUpdate ? 'ok' : 'off'" x-text="license.canAutoUpdate ? 'Incluídas' : 'Não incluídas neste plano'"></span></td></tr>
            <tr><th>Sincronização/backup em nuvem</th><td><span class="badge" :class="license.canSaveToCloud ? 'ok' : 'off'" x-text="license.canSaveToCloud ? 'Incluído' : 'Não incluído neste plano'"></span></td></tr>
            <tr>
              <th>Módulos</th>
              <td>
                <template x-if="license.modules">
                  <template x-for="m in license.modules" :key="m"><span class="badge module" x-text="m"></span></template>
                </template>
                <span x-show="!license.modules" class="muted">sem restrição</span>
              </td>
            </tr>
            <tr><th>Válida até</th><td x-text="license.validUntil ?? '—'"></td></tr>
            <tr x-show="license.supportPhone || license.supportEmail"><th>Suporte</th><td>
              <span x-show="license.supportPhone" x-text="license.supportPhone"></span>
              <span x-show="license.supportPhone && license.supportEmail"> · </span>
              <span x-show="license.supportEmail" x-text="license.supportEmail"></span>
            </td></tr>
          </tbody>
        </table>
        <% if (user.permissions.has('license.edit')) { %>
        <div class="actions" style="margin-top:1rem">
          <button class="btn" @click="openLicenseDlg()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></svg>
            Ativar / trocar licença
          </button>
          <% if (user.permissions.has('sync.run')) { %>
           <button class="btn secondary" @click="syncNow()" :disabled="!license.canSaveToCloud" :title="!license.canSaveToCloud ? 'Não incluído no plano atual' : ''" x-text="syncing ? 'Sincronizando…' : 'Sincronizar agora'">
             <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
           </button>
          <% } %>
          <span class="error" x-text="licenseError"></span>
        </div>
        <% } %>
      </section>
      <% } %>
    </div>

    <!-- ═══════ ABA: EMPRESA ═══════ -->
    <div x-show="tab === 'empresa'" x-cloak>
      <section class="panel">
        <h2>Logo da empresa</h2>
        <p class="hint mt-0">
          Substitui a marca do Kivo no topo do sistema. PNG com fundo transparente fica melhor.
          Máximo 2MB.
        </p>
        <div class="logo-uploader">
          <div class="logo-preview" :class="logo.url ? '' : 'vazio'">
            <img x-show="logo.url" x-cloak :src="logo.url" alt="Logo da empresa" />
            <span x-show="!logo.url" class="hint">Nenhuma logo enviada</span>
          </div>
          <div class="logo-acoes">
            <input type="file" accept="image/png,image/jpeg,image/webp" x-ref="logoFile"
                   style="display:none" @change="enviarLogo($event)">
            <div class="logo-acoes-botoes">
              <button type="button" class="btn secondary" @click="$refs.logoFile.click()" :disabled="logo.enviando">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span x-text="logo.enviando ? 'Enviando…' : (logo.url ? 'Trocar logo' : 'Escolher logo')"></span>
              </button>
              <button type="button" class="btn danger" x-show="logo.url" x-cloak @click="removerLogo()" :disabled="logo.enviando">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                Remover
              </button>
            </div>
            <p class="hint">
              A logo fica gravada <strong>neste computador</strong>. Se a loja tem mais de um
              terminal, envie em cada um.
            </p>
            <p class="error" x-show="logo.erro" x-cloak x-text="logo.erro"></p>
          </div>
        </div>
      </section>

      <section class="panel">
        <h2>Dados da empresa</h2>
        <p class="hint mt-0">Usados no cabeçalho dos cupons de venda e orçamentos impressos.</p>
        <div class="field">
          <label>Nome fantasia</label>
          <input class="input" type="text" x-model="empresa.nome" placeholder="Nome que aparece no cupom/orçamento">
        </div>
        <div class="field">
          <label>Razão social</label>
          <input class="input" type="text" x-model="empresa.razaoSocial" placeholder="Nome jurídico completo">
        </div>
        <div class="field">
          <label>CNPJ ou CPF</label>
          <input class="input" type="text" x-model="empresa.documento" placeholder="00.000.000/0000-00">
        </div>
        <div class="field">
          <label>Inscrição estadual</label>
          <input class="input" type="text" x-model="empresa.ie" placeholder="Isento, se não tiver">
        </div>
        <div class="field">
          <label>E-mail</label>
          <input class="input" type="email" x-model="empresa.email" placeholder="empresa@exemplo.com">
        </div>
        <div class="field">
          <label>Telefone</label>
          <input class="input" type="text" x-model="empresa.telefone" placeholder="(00) 00000-0000">
        </div>
        <div class="field">
          <label>Endereço</label>
          <input class="input" type="text" x-model="empresa.endereco" placeholder="Rua, número, bairro, cidade — UF">
        </div>
        <% if (user.permissions.has('settings.edit')) { %>
        <div class="toolbar">
          <button class="btn" @click="saveEmpresa()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span x-text="savingEmpresa ? 'Salvando…' : 'Salvar dados da empresa'"></span>
          </button>
          <span class="muted" x-show="empresaSaved" x-text="empresaSaved"></span>
        </div>
        <% } %>
      </section>
      <% if (user.permissions.has('settings.edit')) { %>
      <section class="panel" x-data="onboardingWizard()">
        <h2>Assistente de configuração inicial</h2>
        <p class="hint mt-0">
          A mesma tela de boas-vindas do primeiro acesso — refaça as perguntas pra ajustar
          formas de pagamento e preferências, ou gere mesas/produtos de exemplo pra testar.
          Atenção: o assistente também <strong>liga e desliga recursos</strong> (mesas,
          complementos, grade de variações), e o resumo do final mostra o que vai sair do ar
          antes de você confirmar.
        </p>
        <div class="toolbar">
          <button class="btn secondary" @click="openReopen()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 4.1L6 9l4.1 1.9L12 15l1.9-4.1L18 9l-4.1-1.9L12 3Z"/><path d="M5 3v4M3 5h4M19 17v4M17 19h4"/></svg>
            Reabrir assistente de boas-vindas
          </button>
        </div>
        <%- include('partials/onboarding') %>
      </section>
      <% } %>
    </div>

    <!-- ═══════ ABA: ESTOQUE ═══════ -->
    <div x-show="tab === 'stock'" x-cloak>
      <section class="panel">
        <h2>Configurações de estoque</h2>
        <div class="field">
          <label class="label-checkbox">
            <input type="checkbox" x-model="stock.autoSku" />
            Gerar SKU automaticamente ao cadastrar produto
          </label>
        </div>
        <div class="field">
          <label>Valor padrão para estoque mínimo</label>
          <input class="input input-narrow" type="number" min="0" x-model="stock.minStockPadrao" placeholder="0" />
          <p class="hint">Todo produto novo será cadastrado com este valor como estoque mínimo.</p>
        </div>
        <% if (user.permissions.has('settings.edit')) { %>
        <div class="toolbar">
          <button class="btn" @click="saveStock()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span x-text="savingStock ? 'Salvando…' : 'Salvar configurações'"></span>
          </button>
          <span class="muted" x-show="stockSaved" x-text="stockSaved"></span>
        </div>
        <% } %>
      </section>
    </div>

    <!-- ═══════ ABA: VENDAS ═══════ -->
    <div x-show="tab === 'sales'" x-cloak>
      <section class="panel">
        <h2>Configurações de vendas</h2>
        <div class="field">
          <label class="label-checkbox">
            <input type="checkbox" x-model="sales.exibirCupom" />
            Exibir mensagem "Imprimir cupom fiscal" ao finalizar venda
          </label>
        </div>
        <div class="field">
          <label class="label-checkbox">
            <input type="checkbox" x-model="sales.lembreteCaixa24h" />
            Lembrar de fechar o caixa quando ficar aberto por mais de 24h
          </label>
        </div>
        <% if (user.permissions.has('settings.edit')) { %>
        <div class="toolbar">
          <button class="btn" @click="saveSales()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span x-text="savingSales ? 'Salvando…' : 'Salvar configurações'"></span>
          </button>
          <span class="muted" x-show="salesSaved" x-text="salesSaved"></span>
        </div>
        <% } %>
      </section>
    </div>

    <!-- ═══════ ABA: INTERFACE (preferências deste computador) ═══════ -->
    <div x-show="tab === 'interface'" x-cloak>
      <%# Vale só nesta máquina (machine-prefs.json ao lado do banco), não na tabela
          `settings` — que sincroniza e levaria o modo leve do PC fraco do balcão para todas
          as outras máquinas da empresa. %>
      <section class="panel" x-data="{
        modoLeve: document.documentElement.getAttribute('data-lite') === '1',
        saving: false, erro: '',
        async toggleLeve() {
          this.saving = true; this.erro = '';
          const alvo = !this.modoLeve;
          try {
            const r = await fetch('/api/settings/machine-prefs', {
              method: 'PUT', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ modoLeve: alvo }),
            });
            if (!r.ok) { this.erro = ((await r.json()) || {}).error || 'Não foi possível salvar.'; return; }
            this.modoLeve = alvo;
            location.reload();
          } catch (e) {
            this.erro = 'Erro de conexão ao salvar.';
          } finally {
            this.saving = false;
          }
        }
      }">
        <h2>Modo leve</h2>
        <p class="hint mt-0">
          Para computadores mais fracos ou sem driver de vídeo atualizado: remove o efeito de vidro
          fosco, as sombras, os gradientes e as animações, e desliga a aceleração de vídeo. A
          interface fica mais simples e responde bem mais rápido. Vale só neste computador — as
          outras máquinas da empresa não são afetadas.
        </p>
        <div class="field">
          <label class="label-checkbox">
            <input type="checkbox" :checked="modoLeve" :disabled="saving" @change="toggleLeve()" />
            Ativar modo leve neste computador
          </label>
        </div>
        <p class="hint" x-show="modoLeve" x-cloak>
          A aceleração de vídeo só é desligada de fato no <strong>próximo início</strong> do Kivo.
        </p>
        <p class="hint">
          O Kivo liga isto sozinho na primeira execução quando detecta pouca memória, poucos núcleos
          ou vídeo sem aceleração. Depois que você escolhe aqui, a detecção não mexe mais.
        </p>
        <p class="error" x-show="erro" x-cloak x-text="erro"></p>
      </section>

      <section class="panel" x-data="{
        enabled: (function(){ try { return (localStorage.getItem('kivo:recent-enabled') ?? '1') !== '0'; } catch(e){ return true; } })(),
        cleared: false,
        toggle() {
          this.enabled = !this.enabled;
          try { localStorage.setItem('kivo:recent-enabled', this.enabled ? '1' : '0'); } catch(e) {}
          // Some com o balão já visível na hora ao desligar (sem esperar recarregar).
          if (!this.enabled) { var fab = document.querySelector('.recent-fab'); if (fab) fab.remove(); }
        },
        clear() {
          try { localStorage.removeItem('kivo:recent'); } catch(e) {}
          this.cleared = true; setTimeout(() => this.cleared = false, 2500);
        }
      }">
        <h2>Atalhos de páginas recentes</h2>
        <p class="hint mt-0">
          Mostra balões flutuantes no canto inferior direito com atalhos para as últimas páginas que você abriu
          (até 3), facilitando voltar rapidamente. Esta preferência vale só neste computador.
        </p>
        <div class="field">
          <label class="label-checkbox">
            <input type="checkbox" :checked="enabled" @change="toggle()" />
            Mostrar atalhos flutuantes de páginas recentes
          </label>
        </div>
        <div class="toolbar">
          <button class="btn secondary small" @click="clear()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Limpar histórico de páginas recentes
          </button>
          <span class="muted" x-show="cleared" x-cloak>Histórico limpo.</span>
        </div>
      </section>

      <section class="panel" x-data="{
        interfaceMode: document.documentElement.getAttribute('data-interface') || 'cards',
        setInterfaceMode(v) {
          if (v === this.interfaceMode) return;
          this.interfaceMode = v;
          try { localStorage.setItem('kivo-interface', v); } catch (e) {}
          location.reload();
        },
        colorTheme: document.documentElement.getAttribute('data-color-theme') || 'orange',
        customColor: (function(){ try { return localStorage.getItem('kivo-color-custom') || '#ff8000'; } catch(e){ return '#ff8000'; } })(),
        setColorTheme(id) {
          this.colorTheme = id;
          var s = document.documentElement.style;
          s.removeProperty('--primary'); s.removeProperty('--icon-color');
          s.removeProperty('--primary-hover'); s.removeProperty('--primary-bg');
          document.documentElement.setAttribute('data-color-theme', id);
          try { localStorage.setItem('kivo-color-theme', id); } catch (e) {}
        },
        setCustomColor(hex) {
          this.customColor = hex; this.colorTheme = 'custom';
          document.documentElement.setAttribute('data-color-theme', 'custom');
          window.__kivoApplyCustomColor(hex);
          try { localStorage.setItem('kivo-color-theme', 'custom'); localStorage.setItem('kivo-color-custom', hex); } catch (e) {}
        },
      }">
        <h2>Interface e cores</h2>
        <p class="hint mt-0">Esta preferência vale só neste computador.</p>

        <div class="field">
          <label>Tela inicial</label>
          <div class="choice-grid" style="max-width:420px">
            <button type="button" class="choice-card" :class="interfaceMode === 'cards' ? 'selected' : ''" @click="setInterfaceMode('cards')">
              <span class="choice-label">Cartões</span>
              <span class="choice-desc">Tela inicial com ícones</span>
            </button>
            <button type="button" class="choice-card" :class="interfaceMode === 'sidebar' ? 'selected' : ''" @click="setInterfaceMode('sidebar')">
              <span class="choice-label">Menu lateral</span>
              <span class="choice-desc">Menu fixo à esquerda</span>
            </button>
          </div>
        </div>

        <div class="field">
          <label>Cor de destaque</label>
          <div class="color-swatch-row">
            <template x-for="p in KIVO_COLOR_PRESETS" :key="p.id">
              <button type="button" class="color-swatch" :class="colorTheme === p.id ? 'selected' : ''" :style="{ background: p.hex }" @click="setColorTheme(p.id)" :title="p.id"></button>
            </template>
            <input type="color" class="color-swatch color-swatch-custom" :value="customColor" @input="setCustomColor($event.target.value)" title="Cor personalizada" />
          </div>
        </div>
      </section>
    </div>

    <!-- ═══════ ABA: FINANCEIRO ═══════ -->
    <div x-show="tab === 'financeiro'" x-cloak>
      <section class="panel">
        <h2>Multa e juros por atraso</h2>
        <p class="hint mt-0">
          Aplicados sobre contas a pagar/receber vencidas. A multa é cobrada uma única vez
          quando a conta atrasa; os juros correm por dia de atraso.
        </p>
        <div class="field">
          <label class="label-checkbox">
            <input type="checkbox" x-model="financeiro.multaAtiva" />
            Cobrar multa por atraso
          </label>
        </div>
        <div class="field" x-show="financeiro.multaAtiva">
          <label>Percentual da multa (%)</label>
          <input class="input input-narrow" type="text" x-model="financeiro.multaPercentual" placeholder="2,00" />
          <p class="hint">Aplicado uma vez sobre o valor da conta assim que ela vence.</p>
        </div>
        <div class="field" style="margin-top:1.25rem">
          <label class="label-checkbox">
            <input type="checkbox" x-model="financeiro.jurosAtivo" />
            Cobrar juros por atraso (juros de mora)
          </label>
        </div>
        <div class="field" x-show="financeiro.jurosAtivo">
          <label>Percentual de juros ao dia (%)</label>
          <input class="input input-narrow" type="text" x-model="financeiro.jurosPercentualDia" placeholder="0,033" />
          <p class="hint">Juros corridos: incide a cada dia de atraso sobre o valor da conta (ex.: 0,033%/dia ≈ 1%/mês).</p>
        </div>
        <% if (user.permissions.has('settings.edit')) { %>
        <div class="toolbar">
          <button class="btn" @click="saveFinanceiro()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span x-text="savingFinanceiro ? 'Salvando…' : 'Salvar configurações'"></span>
          </button>
          <span class="muted" x-show="financeiroSaved" x-text="financeiroSaved"></span>
        </div>
        <% } %>
      </section>
    </div>

    <!-- ═══════ ABA: FIDELIDADE ═══════ -->
    <div x-show="tab === 'fidelidade'" x-cloak>
      <section class="panel">
        <h2>Clube de fidelidade</h2>
        <div class="field">
          <label class="label-checkbox">
            <input type="checkbox" x-model="fidelidade.ativo" />
            Ativar acúmulo de pontos por venda
          </label>
          <p class="hint">Desativado por padrão. Quando ativado, toda venda com cliente identificado acumula pontos automaticamente.</p>
        </div>
        <div class="field">
          <label>Pontos por real gasto</label>
          <input class="input input-narrow" type="number" min="0" step="1" x-model.number="fidelidade.pontosPorReal" />
        </div>
        <div class="field">
          <label>Pontos necessários para resgate</label>
          <input class="input input-narrow" type="number" min="1" x-model.number="fidelidade.pontosResgate" />
        </div>
        <div class="field">
          <label>Valor do resgate (R$)</label>
          <input class="input input-narrow" type="text" x-model="fidelidade.valorResgate" placeholder="0,00" @input="fidelidade.valorResgate = maskMoney(fidelidade.valorResgate)" />
          <p class="hint">Ex.: 100 pontos = R$5,00 — o cliente resgata 100 pontos e ganha R$5,00 de desconto na compra.</p>
        </div>
        <% if (user.permissions.has('settings.edit')) { %>
        <div class="toolbar">
          <button class="btn" @click="saveFidelidade()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span x-text="savingFidelidade ? 'Salvando…' : 'Salvar configurações'"></span>
          </button>
          <span class="muted" x-show="fidelidadeSaved" x-text="fidelidadeSaved"></span>
        </div>
        <% } %>
      </section>
    </div>

    <!-- ═══════ ABA: REDE LOCAL ═══════ -->
    <% if (user.permissions.has('settings.edit')) { %>
    <div x-show="tab === 'rede'" x-cloak>
      <section class="panel">
        <h2>Acesso pela rede local (Wi-Fi/cabo)</h2>
        <p class="hint mt-0">
          Permite abrir o Kivo no navegador de outro aparelho — celular do garçom pra
          lançar pedidos nas comandas, tablet fixo na cozinha pro painel de produção —
          desde que esteja na mesma rede local (Wi-Fi ou cabo) desta máquina. Nenhum dado
          sai da rede local; não é acesso pela internet.
        </p>
        <%# A chave grava sozinha (mesmo comportamento do "Modo leve" na aba Interface).
            Antes ela dependia de um "Salvar" próprio, logo acima de um SEGUNDO "Salvar"
            (o da sincronização) — quem marcava a chave e clicava no botão de baixo saía
            achando que tinha ligado, e no reinício seguinte a chave estava desmarcada
            porque nunca chegou a ser gravada. %>
        <div class="field">
          <label class="label-checkbox">
            <input type="checkbox" :checked="rede.acessoLocal" :disabled="savingRede" @change="toggleAcessoLocal($event.target.checked)" />
            Permitir acesso pela rede local
          </label>
          <p class="hint">
            Desligado por padrão. <strong>Não precisa salvar</strong> — a chave grava sozinha ao marcar.
          </p>
          <p class="hint" x-show="redeSaved" x-cloak x-text="redeSaved"></p>
        </div>

        <%# Estado REAL de agora (em que host o servidor subiu neste boot) x o que está
            salvo: é o que responde "liguei e mesmo assim o celular não abre". %>
        <div class="field" x-show="networkInfo.lanAtivo !== null && networkInfo.lanAtivo !== undefined" x-cloak>
          <template x-if="rede.acessoLocal && networkInfo.lanAtivo">
            <p class="hint mt-0"><span class="badge ok">Ativo agora</span> Outros aparelhos da mesma rede já conseguem abrir o Kivo nos endereços abaixo.</p>
          </template>
          <template x-if="rede.acessoLocal && !networkInfo.lanAtivo">
            <p class="hint mt-0"><span class="badge neutral">Falta reiniciar</span> Está ligado e salvo, mas só passa a valer quando você fechar e abrir o Kivo.</p>
          </template>
          <template x-if="!rede.acessoLocal && networkInfo.lanAtivo">
            <p class="hint mt-0"><span class="badge neutral">Falta reiniciar</span> Está desligado e salvo, mas continua acessível até você fechar e abrir o Kivo.</p>
          </template>
          <template x-if="!rede.acessoLocal && !networkInfo.lanAtivo">
            <p class="hint mt-0"><span class="badge off">Desligado</span> Só este computador consegue abrir o Kivo.</p>
          </template>
        </div>
        <div x-show="networkInfo.urls && networkInfo.urls.length" style="margin-top:1.25rem">
          <p class="hint mt-0">Endereço(s) desta máquina na rede local — acesse pelo navegador do celular/tablet, ou aponte a câmera para o QR:</p>
          <template x-for="u in networkInfo.urls" :key="u.url">
            <div class="flex-row" style="align-items:center;gap:.75rem;margin-bottom:.75rem">
              <img :src="u.qr" width="80" height="80" alt="QR code do endereço" style="border-radius:6px;background:#fff;padding:4px" />
              <div class="flex-row" style="align-items:center;gap:.5rem">
                <code x-text="u.url" style="font-size:1rem;padding:.3rem .6rem;background:var(--surface-hover);border-radius:6px"></code>
                <button type="button" class="btn secondary small" @click="copyUrl(u.url)" x-text="copiedUrl === u.url ? 'Copiado!' : 'Copiar'"></button>
              </div>
            </div>
          </template>
        </div>
        <p class="hint" x-show="rede.acessoLocal && networkInfo.urls && !networkInfo.urls.length">
          Nenhuma interface de rede local detectada — verifique se o cabo/Wi-Fi está conectado.
        </p>
        <p class="hint" style="margin-top:1rem">
          Recomendado: crie usuários com os cargos <strong>Garçom</strong> (só vê Mesas/Comandas) ou
          <strong>Cozinha (KDS)</strong> (só vê o painel de produção) em vez de compartilhar o login de
          administrador nesses aparelhos — veja <a href="/admin/usuarios">Usuários</a> e
          <a href="/admin/cargos">Cargos</a>.
        </p>
      </section>

      <%# O ciclo automático é o que mantém o painel do Kivo Web atual — sem ele o celular
          mostra o que sobrou do último clique em "Sincronizar agora". %>
      <section class="panel">
        <h2>Sincronização automática com a nuvem</h2>
        <p class="hint mt-0">
          De quanto em quanto tempo o Kivo envia o movimento desta máquina para a nuvem e busca o
          que veio das outras. É isto que mantém atualizado o acompanhamento pelo celular
          (<strong>Kivo Web</strong>) e o backup do dia. Fechar uma venda também dispara um envio
          alguns segundos depois, sem esperar o ciclo.
        </p>
        <div class="field">
          <label>Intervalo</label>
          <select x-model.number="rede.syncIntervalo">
            <option :value="0">Desligado (só manual)</option>
            <option :value="1">A cada 1 minuto</option>
            <option :value="3">A cada 3 minutos (recomendado)</option>
            <option :value="10">A cada 10 minutos</option>
            <option :value="30">A cada 30 minutos</option>
          </select>
          <p class="hint">Exige plano com sincronização em nuvem. <strong>Requer reiniciar o Kivo</strong> para valer.</p>
        </div>
        <% if (user.permissions.has('settings.edit')) { %>
        <div class="toolbar">
          <button class="btn" @click="saveSyncIntervalo()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span x-text="savingSync ? 'Salvando…' : 'Salvar'"></span>
          </button>
          <span class="muted" x-show="syncSaved" x-text="syncSaved"></span>
        </div>
        <% } %>
      </section>
    </div>
    <% } %>

    <!-- ═══════ ABA: CARDÁPIO ONLINE ═══════ -->
    <% if (user.permissions.has('settings.edit')) { %>
    <div x-show="tab === 'cardapio'" x-cloak>
      <section class="panel">
        <h2>Cardápio online</h2>
        <p class="hint mt-0">
          Página pública, sem login, com os produtos que você escolher — pra clientes verem o
          cardápio pelo celular antes de vir na loja. Fica hospedada na nuvem do Kivo, separada
          do app (não depende do computador estar ligado).
        </p>
        <p class="hint">
          Requer o recurso <strong>"Cardápio online"</strong> ligado em
          <a href="/admin/recursos">Configurações → Recursos</a> e um plano com salvamento em
          nuvem. Depois de ligado, marque os produtos em
          <a href="/app/commercial/produtos">Produtos</a> usando o ícone de globo em cada linha —
          só os marcados aparecem na página pública.
        </p>

        <div x-show="cardapio.loading" class="hint">Carregando…</div>

        <div x-show="!cardapio.loading && cardapio.url" style="margin-top:1rem">
          <div class="flex-row" style="align-items:center;gap:.75rem">
            <img :src="cardapio.qr" width="120" height="120" alt="QR code do cardápio" style="border-radius:6px;background:#fff;padding:6px" />
            <div>
              <code x-text="cardapio.url" style="font-size:.95rem;padding:.3rem .6rem;background:var(--surface-hover);border-radius:6px;word-break:break-all;display:inline-block"></code>
              <div style="margin-top:.5rem">
                <button type="button" class="btn secondary small" @click="copyCardapioUrl()" x-text="cardapio.copied ? 'Copiado!' : 'Copiar link'"></button>
                <a :href="cardapio.url" target="_blank" rel="noopener" class="btn secondary small">Abrir</a>
              </div>
            </div>
          </div>
        </div>

        <p class="hint" x-show="!cardapio.loading && !cardapio.url" style="margin-top:1rem">
          Ainda não é possível gerar o link: é preciso ativar a licença (Configurações → Licença)
          com um plano que inclua salvamento em nuvem.
        </p>
      </section>
    </div>
    <% } %>

    <!-- ═══════ ABA: SEGURANÇA ═══════ -->
    <% if (user.permissions.has('settings.edit') || user.permissions.has('security.pin.manage')) { %>
    <div x-show="tab === 'security'" x-cloak>
      <% if (user.permissions.has('settings.edit')) { %>
      <section class="panel">
        <h2>Confirmação por PIN</h2>
        <div class="field">
          <label class="label-checkbox">
            <input type="checkbox" x-model="security.pinRemoverItem" />
            Exigir PIN de administrador para remover item já lançado no carrinho do PDV
          </label>
          <p class="hint">Desativado por padrão. Quando ativado, o operador do caixa precisa digitar o PIN para confirmar a remoção.</p>
        </div>
        <div class="toolbar">
          <button class="btn" @click="saveSecurity()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span x-text="savingSecurity ? 'Salvando…' : 'Salvar configurações'"></span>
          </button>
          <span class="muted" x-show="securitySaved" x-text="securitySaved"></span>
        </div>
      </section>
      <% } %>
      <% if (user.permissions.has('security.pin.manage')) { %>
      <section class="panel">
        <h2>PIN de administrador</h2>
        <p class="hint mt-0">
          <span x-show="pinConfigured">PIN configurado nesta máquina.</span>
          <span x-show="!pinConfigured">Nenhum PIN configurado ainda nesta máquina.</span>
        </p>
        <div class="field">
          <label>Novo PIN (4 a 6 dígitos)</label>
          <input class="input input-narrow-lg" type="password" inputmode="numeric" maxlength="6" x-model="pinForm.pin">
        </div>
        <div class="field">
          <label>Confirmar PIN</label>
          <input class="input input-narrow-lg" type="password" inputmode="numeric" maxlength="6" x-model="pinForm.confirm">
        </div>
        <div class="toolbar">
          <button class="btn" @click="savePin()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></svg>
            <span x-text="savingPin ? 'Salvando…' : 'Salvar PIN'"></span>
          </button>
          <span class="error" x-text="pinError"></span>
          <span class="muted" x-show="pinSaved" x-text="pinSaved"></span>
        </div>
      </section>
      <% } %>
    </div>
    <% } %>

    <!-- ═══════ ABA: AVANÇADO ═══════ -->
    <% if (user.permissions.has('settings.edit')) { %>
    <%# ═══════ ABA: ATUALIZAÇÃO ═══════
        Cada etapa é um clique do lojista (verificar → baixar → instalar) em vez de o app
        baixar sozinho: numa loja, ~100 MB no meio do movimento disputam a mesma internet
        do TEF e da nuvem, e o reinício que vem depois cairia no pior momento possível.
        O estado real vem de /api/updates/status — ver core/updater. %>
    <div x-show="tab === 'atualizacao'" x-cloak>
      <section class="panel">
        <h2>Atualização do Kivo</h2>
        <p class="hint mt-0">
          Versão instalada nesta máquina: <strong x-text="atualizacao.versaoAtual"></strong>
        </p>

        <template x-if="!atualizacao.suportado">
          <p class="hint">
            <span class="badge neutral">Indisponível</span>
            <span x-text="atualizacao.motivo"></span>
          </p>
        </template>

        <template x-if="atualizacao.suportado">
          <div>
            <template x-if="atualizacao.status === 'ocioso'">
              <div>
                <p class="hint">
                  <span class="badge ok">Em dia</span>
                  Você já está com a versão mais recente.
                  <span x-show="atualizacao.verificadoEm" x-cloak x-text="'Última verificação: ' + fmtQuando(atualizacao.verificadoEm) + '.'"></span>
                </p>
                <div class="toolbar">
                  <button class="btn secondary" @click="procurarAtualizacao()" :disabled="atualizacao.ocupado">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
                    Procurar atualizações
                  </button>
                </div>
              </div>
            </template>

            <template x-if="atualizacao.status === 'verificando'">
              <p class="hint"><span class="badge neutral">Verificando</span> Procurando uma versão nova…</p>
            </template>

            <template x-if="atualizacao.status === 'disponivel'">
              <div>
                <p class="hint">
                  <span class="badge ok">Novidade</span>
                  A versão <strong x-text="atualizacao.versaoDisponivel"></strong> está disponível.
                </p>
                <p class="hint" x-show="atualizacao.notas" x-cloak x-text="atualizacao.notas" style="white-space:pre-wrap"></p>
                <p class="hint">
                  Baixar não interrompe nada: o Kivo continua funcionando normalmente enquanto
                  o download acontece. O reinício só ocorre quando você mandar.
                </p>
                <div class="toolbar">
                  <button class="btn" @click="baixarAtualizacao()" :disabled="atualizacao.ocupado">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Baixar atualização
                  </button>
                </div>
              </div>
            </template>

            <template x-if="atualizacao.status === 'baixando'">
              <div>
                <p class="hint">
                  <span class="badge neutral">Baixando</span>
                  Versão <strong x-text="atualizacao.versaoDisponivel"></strong> — pode continuar usando o Kivo.
                </p>
                <div class="update-bar" role="progressbar" :aria-valuenow="Math.round(pct)" aria-valuemin="0" aria-valuemax="100">
                  <div class="update-bar-fill" :style="'width:' + pct + '%'"></div>
                </div>
                <p class="hint" x-text="Math.round(pct) + '% — ' + fmtBytes(atualizacao.progresso && atualizacao.progresso.transferido) + ' de ' + fmtBytes(atualizacao.progresso && atualizacao.progresso.total) + (atualizacao.progresso && atualizacao.progresso.bytesPorSegundo ? ' (' + fmtBytes(atualizacao.progresso.bytesPorSegundo) + '/s)' : '')"></p>
              </div>
            </template>

            <template x-if="atualizacao.status === 'baixado'">
              <div>
                <p class="hint">
                  <span class="badge ok">Pronto</span>
                  A versão <strong x-text="atualizacao.versaoDisponivel"></strong> já está baixada nesta máquina.
                </p>
                <p class="hint">
                  Ao clicar em Atualizar, o Kivo fecha, instala sozinho (sem nenhuma tela de
                  instalação) e volta a abrir. Leva menos de um minuto —
                  <strong>feche a venda em aberto antes</strong>.
                </p>
                <template x-if="!atualizacao.confirmando">
                  <div class="toolbar">
                    <button class="btn" @click="atualizacao.confirmando = true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
                      Atualizar e reiniciar
                    </button>
                  </div>
                </template>
                <template x-if="atualizacao.confirmando">
                  <div class="toolbar">
                    <span class="muted">Fechar o Kivo agora e instalar?</span>
                    <button class="btn" @click="instalarAtualizacao()" :disabled="atualizacao.ocupado">
                      <span x-text="atualizacao.ocupado ? 'Reiniciando…' : 'Sim, atualizar agora'"></span>
                    </button>
                    <button class="btn secondary" @click="atualizacao.confirmando = false" :disabled="atualizacao.ocupado">Cancelar</button>
                  </div>
                </template>
              </div>
            </template>

            <template x-if="atualizacao.status === 'erro'">
              <div>
                <p class="hint">
                  <span class="badge off">Falhou</span>
                  <span x-text="atualizacao.erro || 'Não foi possível concluir.'"></span>
                </p>
                <p class="hint">Costuma ser internet instável. Nada foi alterado no Kivo instalado.</p>
                <div class="toolbar">
                  <button class="btn secondary" @click="procurarAtualizacao()" :disabled="atualizacao.ocupado">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
                    Tentar de novo
                  </button>
                </div>
              </div>
            </template>
          </div>
        </template>
      </section>
    </div>

    <div x-show="tab === 'advanced'" x-cloak>
      <section class="panel">
        <h2>Servidor de sincronização (cloud)</h2>
        <div class="field">
          <label>URL do servidor</label>
          <input class="input" type="text" x-model="cloudUrlForm.value" placeholder="https://kivo.buscamais.org (padrão do instalador)">
          <p class="hint">Deixe em branco para usar o padrão do instalador. Muda na hora — não precisa gerar novo instalador.</p>
        </div>
        <div class="toolbar">
          <button class="btn secondary" @click="saveCloudUrl()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span x-text="savingCloudUrl ? 'Salvando…' : 'Salvar servidor'"></span>
          </button>
        </div>
      </section>
      <div class="toolbar">
        <button class="btn secondary small" @click="openNew()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nova configuração
        </button>
        <span class="error" x-text="error"></span>
      </div>
      <table>
        <thead><tr><th>Chave</th><th>Valor</th><th>Atualizada</th><th></th></tr></thead>
        <tbody>
          <template x-for="s in settings" :key="s.key">
            <tr>
              <td x-text="s.key"></td>
              <td x-text="s.value ?? '—'"></td>
              <td class="muted" x-text="s.updated_at"></td>
              <td class="text-right">
                <button class="btn secondary small" @click="openEdit(s)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                  Editar
                </button>
              </td>
            </tr>
          </template>
        </tbody>
      </table>

      <%# Zona de perigo. Fica no fim da última aba de propósito: ninguém tropeça nela
          navegando, e quem chegou aqui veio procurando. %>
      <section class="panel danger-zone">
        <h2>Zona de perigo</h2>
        <div class="danger-item">
          <div class="danger-item-text">
            <h3>Recomeçar do zero (sair do modo de teste)</h3>
            <p class="hint mt-0">
              Apaga <strong>todo o histórico</strong> desta loja — produtos, clientes,
              fornecedores, vendas, compras, orçamentos, contas, caixa, comandas, estoque e
              auditoria — e reabre o assistente de boas-vindas para você começar a cadastrar
              os dados reais.
            </p>
            <p class="hint">
              <strong>Continuam como estão:</strong> a licença ativa, os usuários
              administradores (com as senhas), os cargos e permissões, os dados e a logo da
              empresa, as formas de pagamento, o PIN de administrador e as preferências deste
              computador.
            </p>
            <p class="hint">
              Antes de apagar, o Kivo tira um <strong>backup automático</strong> — se você se
              arrepender, dá para voltar por <a href="/admin/backup">Backup</a>.
              Os dados também são apagados da nuvem, senão a sincronização traria tudo de
              volta em poucos minutos.
            </p>
          </div>
          <button class="btn danger" @click="openReset()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L3 8"/></svg>
            Recomeçar do zero
          </button>
        </div>
      </section>
    </div>
    <% } %>

    <%# ─── MODAL: Reset de fábrica ───
        A confirmação digitada existe porque um "Tem certeza?" comum já foi clicado no
        automático mil vezes — e este é o único botão do app sem volta fácil. %>
    <% if (user.permissions.has('settings.edit')) { %>
    <dialog x-ref="resetDlg" class="dialog-fixed reset-dialog">
      <h1>Recomeçar do zero</h1>
      <div class="dialog-body">
        <template x-if="!reset.result">
          <div>
            <div class="danger-callout">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <span>Isto apaga o histórico da loja <strong>nesta máquina e na nuvem</strong>. Não dá para desfazer sem restaurar o backup.</span>
            </div>

            <%# Lado a lado, e não empilhados: as duas listas somadas passavam da altura do
                diálogo e empurravam o campo de confirmação — o controle mais importante da
                tela — para baixo da dobra, atrás de um scroll. %>
            <div class="reset-colunas">
              <div>
                <p class="hint mt-0"><strong>Vai ser apagado</strong></p>
                <ul class="reset-list">
                  <li>Produtos, categorias, complementos e variações</li>
                  <li>Clientes, fornecedores e listas de preço</li>
                  <li>Vendas, orçamentos, compras e comandas</li>
                  <li>Contas a pagar/receber, caixa e estoque</li>
                  <li>Notas fiscais, mesas e auditoria</li>
                  <li>Usuários que <strong>não</strong> são administradores</li>
                </ul>
              </div>
              <div>
                <p class="hint mt-0"><strong>Vai continuar</strong></p>
                <ul class="reset-list keep">
                  <li>Sua licença ativa (não precisa reativar)</li>
                  <li>Os administradores e suas senhas</li>
                  <li>Cargos, permissões e PIN</li>
                  <li>Dados e logo da empresa</li>
                  <li>Formas de pagamento</li>
                  <li>Seus backups, incluindo o desta operação</li>
                </ul>
              </div>
            </div>

            <label class="label-checkbox">
              <input type="checkbox" x-model="reset.includeCloudBackups" />
              Apagar também os backups guardados na nuvem
            </label>
            <p class="hint" style="margin:.4rem 0 0">
              Deixe desligado se quiser poder voltar atrás: o backup na nuvem não volta pela
              sincronização, então guardá-lo não atrapalha o recomeço.
            </p>

            <div class="field" style="margin-top:1rem">
              <label>Para confirmar, digite <strong>RESETAR</strong></label>
              <input class="input" type="text" x-model="reset.confirmacao" placeholder="RESETAR"
                     autocomplete="off" spellcheck="false"
                     @keydown.enter.prevent="reset.confirmacao.trim().toUpperCase() === 'RESETAR' && runReset()" />
            </div>
            <p class="error" x-show="reset.erro" x-cloak x-text="reset.erro"></p>
          </div>
        </template>

        <template x-if="reset.result">
          <div class="dialog-body-center">
            <div class="dialog-icon dialog-icon-primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <h2 class="dialog-heading-md">Pronto — pode começar</h2>
            <p class="dialog-text" x-text="reset.result.rowsRemoved + ' registro(s) de teste apagado(s).'"></p>
            <p class="muted muted-sm" x-show="reset.result.backupId" x-cloak>
              Backup de segurança nº <span x-text="reset.result.backupId"></span> guardado antes de apagar.
            </p>
            <p class="error muted-sm" x-show="reset.result.backupError" x-cloak
               x-text="'Não deu para tirar o backup de segurança (' + reset.result.backupError + ').'"></p>
            <p class="muted muted-sm" x-show="reset.result.cloudSkippedReason" x-cloak
               x-text="reset.result.cloudSkippedReason"></p>
            <p class="muted muted-sm">O assistente de boas-vindas abre assim que a tela recarregar.</p>
          </div>
        </template>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.resetDlg.close()" x-show="!reset.result" :disabled="reset.rodando">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn danger" @click="runReset()" x-show="!reset.result"
                :disabled="reset.rodando || reset.confirmacao.trim().toUpperCase() !== 'RESETAR'">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L3 8"/></svg>
          <span x-text="reset.rodando ? 'Apagando…' : 'Apagar tudo e recomeçar'"></span>
        </button>
        <button class="btn" @click="location.href = '/'" x-show="reset.result">Ir para o começo</button>
      </div>
    </dialog>
    <% } %>

    <!-- ─── MODAL: Ativar / trocar licença ─── -->
    <% if (user.permissions.has('license.edit')) { %>
    <dialog x-ref="licenseDlg">
      <h1>Ativar / trocar licença</h1>
      <label>Empresa (UUID)</label>
      <input type="text" x-model="licenseForm.companyUuid" placeholder="uuid fornecido na ativação" />
      <label>Chave de licença</label>
      <input type="text" x-model="licenseForm.licenseKey" placeholder="chave fornecida na ativação" />
      <div class="error" x-text="licenseError"></div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.licenseDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn" @click="saveLicense()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span x-text="savingLicense ? 'Salvando…' : 'Salvar licença'"></span>
        </button>
      </div>
    </dialog>
    <% } %>

    <!-- ─── MODAL: Licença ativada com sucesso ─── -->
    <% if (user.permissions.has('license.edit')) { %>
    <dialog x-ref="licenseThanksDlg" style="max-width:400px">
      <div class="dialog-body-center" style="padding:1.5rem 1.5rem .5rem">
        <div class="dialog-icon dialog-icon-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
        </div>
        <h2 class="dialog-heading-md">Licença ativada!</h2>
        <p class="dialog-text">Obrigado — já sincronizamos com a nuvem.</p>
        <table style="text-align:left;margin-bottom:.5rem" x-show="licenseThanks.sync && !licenseThanks.sync.skipped">
          <tbody>
            <tr><th>Enviado</th><td x-text="licenseThanks.sync ? licenseThanks.sync.pushed : 0"></td></tr>
            <tr><th>Recebido</th><td x-text="licenseThanks.sync ? licenseThanks.sync.pulled : 0"></td></tr>
          </tbody>
        </table>
        <p class="muted muted-sm" x-show="licenseThanks.sync && licenseThanks.sync.skipped">
          Sincronização em nuvem não incluída no plano atual — os dados continuam só nesta máquina.
        </p>
        <p class="error muted-sm" x-show="licenseThanks.syncError" x-text="'Não deu pra sincronizar agora (' + licenseThanks.syncError + ') — tente de novo em Sincronizar agora.'"></p>
      </div>
      <div class="actions actions-center" style="padding-bottom:1.5rem">
        <button class="btn" @click="$refs.licenseThanksDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Ok
        </button>
      </div>
    </dialog>
    <% } %>

    <!-- ─── MODAL: Configuração avulsa (aba Avançado) ─── -->
    <dialog x-ref="dlg">
      <h1>Configuração</h1>
      <label>Chave</label><input type="text" x-model="form.key" :disabled="form.locked" />
      <label>Valor</label><input type="text" x-model="form.value" />
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn" @click="save()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Salvar
        </button>
      </div>
    </dialog>
  </main>
  <script src="/js/masks.js"></script>
  <script src="/js/onboarding.js"></script>
  <script>
    // Abas válidas — a lista existe só para não confiar cegamente no que vem no #hash da
    // URL: um valor desconhecido esconderia todos os painéis e a tela ficaria em branco.
    const SETTINGS_TABS = ['license', 'empresa', 'stock', 'sales', 'financeiro', 'fidelidade',
                           'interface', 'rede', 'cardapio', 'security', 'atualizacao', 'advanced'];

    function settingsPage() {
      return {
        // A aba fica no #hash porque vários ajustes desta tela (modo leve, tela inicial)
        // só valem depois de um location.reload(), e o reload recriava o componente na
        // aba Licença — quem mexia em Interface era jogado pra primeira aba a cada clique.
        tab: (function () {
          // decodeURIComponent estoura em hash malformado (#%) — e um throw aqui mataria
          // o x-data inteiro, deixando a tela de configurações em branco.
          let h = '';
          try { h = decodeURIComponent((location.hash || '').slice(1)); } catch (e) { h = ''; }
          return SETTINGS_TABS.includes(h) ? h : 'license';
        })(),
        settings: [], license: {}, form: {}, error: '',
        licenseForm: { companyUuid: '', licenseKey: '' }, licenseError: '', savingLicense: false, syncing: false,
        licenseThanks: { sync: null, syncError: null },
        stock: { autoSku: true, minStockPadrao: 0 }, savingStock: false, stockSaved: '',
        sales: { exibirCupom: true, lembreteCaixa24h: true }, savingSales: false, salesSaved: '',
        financeiro: { multaAtiva: false, multaPercentual: '2,00', jurosAtivo: false, jurosPercentualDia: '0,033' },
        savingFinanceiro: false, financeiroSaved: '',
        empresa: { nome: '', razaoSocial: '', documento: '', ie: '', email: '', telefone: '', endereco: '' }, savingEmpresa: false, empresaSaved: '',
        logo: { url: '', enviando: false, erro: '' },
        cloudUrlForm: { value: '' }, savingCloudUrl: false,
        security: { pinRemoverItem: false }, savingSecurity: false, securitySaved: '',
        pinConfigured: false, pinForm: { pin: '', confirm: '' }, savingPin: false, pinError: '', pinSaved: '',
        fidelidade: { ativo: false, pontosPorReal: 1, pontosResgate: 100, valorResgate: '5,00' }, savingFidelidade: false, fidelidadeSaved: '',
        rede: { acessoLocal: false, syncIntervalo: 3 }, savingRede: false, redeSaved: '', networkInfo: { urls: [], port: null, lanAtivo: null }, copiedUrl: '',
        atualizacao: {
          suportado: false, motivo: '', status: 'ocioso', versaoAtual: '—', versaoDisponivel: null,
          notas: null, progresso: null, erro: null, verificadoEm: null, ocupado: false, confirmando: false,
        },
        pollAtualizacaoId: null,
        savingSync: false, syncSaved: '',
        cardapio: { url: '', qr: '', loading: true, copied: false },
        reset: { confirmacao: '', includeCloudBackups: false, rodando: false, erro: '', result: null },

        // replaceState em vez de `location.hash = v`: não empilha uma entrada no histórico
        // a cada aba clicada (o Voltar do navegador ficaria preso nesta tela) nem faz a
        // página pular para o topo.
        setTab(v) {
          this.tab = v;
          // O estado do updater vive na memória do processo principal e muda sozinho
          // (checagem de 6h, download em andamento): reler ao abrir a aba evita mostrar
          // uma foto velha de quando a página carregou.
          if (v === 'atualizacao') this.lerAtualizacao();
          // Preserva history.state: o botão Voltar do cabeçalho guarda a profundidade da
          // navegação ali (kivoDepth, ver partials/nav.ejs), e passar `null` a apagaria —
          // fazendo a seta achar que esta é a primeira tela da aba.
          try { history.replaceState(history.state, '', location.pathname + location.search + '#' + v); }
          catch (e) { location.hash = v; }
        },

        async load() {
          const r = await fetch('/api/settings');
          if (r.ok) {
            this.settings = await r.json();
            this.syncSettings();
          }
          <% if (user.permissions.has('license.view')) { %>
          const l = await fetch('/api/license');
          if (l.ok) this.license = await l.json();
          <% } %>
          <% if (user.permissions.has('security.pin.manage')) { %>
          const p = await fetch('/api/security/pin/status');
          if (p.ok) this.pinConfigured = (await p.json()).configured;
          <% } %>
          <% if (user.permissions.has('settings.edit')) { %>
          // Fora do `await` da fila: o selo de novidade na aba não deve atrasar o
          // desenho do resto da tela.
          this.lerAtualizacao();
          const n = await fetch('/api/settings/network-info');
          if (n.ok) this.networkInfo = await n.json();
          const c = await fetch('/api/settings/cardapio-info');
          if (c.ok) this.cardapio = { ...(await c.json()), loading: false, copied: false };
          else this.cardapio.loading = false;
          <% } %>
        },
        syncSettings() {
          const auto = this.settings.find(s => s.key === 'estoque.auto_sku');
          this.stock.autoSku = auto?.value !== '0';
          const minStock = this.settings.find(s => s.key === 'estoque.min_stock_padrao');
          this.stock.minStockPadrao = minStock?.value ? Number(minStock.value) : 0;
          const cupom = this.settings.find(s => s.key === 'vendas.exibir_cupom_fiscal');
          this.sales.exibirCupom = cupom?.value !== '0';
          const lembrete = this.settings.find(s => s.key === 'caixa.lembrete_24h');
          this.sales.lembreteCaixa24h = lembrete?.value !== '0';
          this.financeiro.multaAtiva = this.settings.find(s => s.key === 'financeiro.multa_atraso.ativa')?.value === '1';
          const multaPct = this.settings.find(s => s.key === 'financeiro.multa_atraso.percentual')?.value;
          this.financeiro.multaPercentual = (multaPct != null ? Number(multaPct) : 2).toFixed(2).replace('.', ',');
          this.financeiro.jurosAtivo = this.settings.find(s => s.key === 'financeiro.juros_atraso.ativo')?.value === '1';
          const jurosPct = this.settings.find(s => s.key === 'financeiro.juros_atraso.percentual_dia')?.value;
          this.financeiro.jurosPercentualDia = (jurosPct != null ? Number(jurosPct) : 0.033).toString().replace('.', ',');
          const pinRemove = this.settings.find(s => s.key === 'seguranca.pin_remover_item');
          this.security.pinRemoverItem = pinRemove?.value === '1';
          this.fidelidade.ativo = this.settings.find(s => s.key === 'fidelidade.ativo')?.value === '1';
          this.fidelidade.pontosPorReal = Number(this.settings.find(s => s.key === 'fidelidade.pontos_por_real')?.value ?? 1);
          this.fidelidade.pontosResgate = Number(this.settings.find(s => s.key === 'fidelidade.pontos_resgate')?.value ?? 100);
          const valorResgateCents = Number(this.settings.find(s => s.key === 'fidelidade.valor_resgate_cents')?.value ?? 500);
          this.fidelidade.valorResgate = (valorResgateCents / 100).toFixed(2).replace('.', ',');
          const cu = this.settings.find(s => s.key === 'sync.server_url');
          this.cloudUrlForm.value = cu?.value ?? '';
          this.empresa.nome = this.settings.find(s => s.key === 'empresa.nome')?.value ?? '';
          this.empresa.razaoSocial = this.settings.find(s => s.key === 'empresa.razao_social')?.value ?? '';
          this.empresa.documento = this.settings.find(s => s.key === 'empresa.documento')?.value ?? '';
          this.empresa.ie = this.settings.find(s => s.key === 'empresa.ie')?.value ?? '';
          this.empresa.email = this.settings.find(s => s.key === 'empresa.email')?.value ?? '';
          this.empresa.telefone = this.settings.find(s => s.key === 'empresa.telefone')?.value ?? '';
          this.empresa.endereco = this.settings.find(s => s.key === 'empresa.endereco')?.value ?? '';
          this.logo.url = this.settings.find(s => s.key === 'empresa.logo_url')?.value ?? '';
          this.rede.acessoLocal = this.settings.find(s => s.key === 'rede.acesso_local')?.value === '1';
          const iv = this.settings.find(s => s.key === 'sync.intervalo_minutos')?.value;
          this.rede.syncIntervalo = iv == null || iv === '' ? 3 : Number(iv);
        },
        // ─── Logo da empresa ───
        // O arquivo vira base64 aqui porque o resto do app já manda imagem assim (fotos de
        // produto e de categoria), e o servidor aceita data URI — não vale introduzir
        // multipart só para esta tela.
        async enviarLogo(event) {
          const file = event.target.files && event.target.files[0];
          event.target.value = '';
          if (!file) return;
          this.logo.erro = '';
          if (file.size > 2 * 1024 * 1024) {
            this.logo.erro = 'Logo muito grande (máximo 2MB).';
            return;
          }
          this.logo.enviando = true;
          try {
            const base64 = await new Promise((resolve, reject) => {
              const reader = new FileReader();
              reader.onload = () => resolve(reader.result);
              reader.onerror = () => reject(new Error('Não foi possível ler o arquivo.'));
              reader.readAsDataURL(file);
            });
            const r = await fetch('/api/settings/company-logo', {
              method: 'PUT', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ imageBase64: base64 }),
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) {
              this.logo.erro = body.error || 'Não foi possível enviar a logo.';
              return;
            }
            const dados = body.data !== undefined ? body.data : body;
            // O cabeçalho é renderizado pelo servidor (app.locals): só um reload mostra a
            // logo nova lá em cima. A prévia abaixo já muda na hora.
            this.logo.url = typeof dados === 'string' ? dados : dados.url;
            showToast('Logo atualizada.', 'success');
            setTimeout(() => location.reload(), 700);
          } catch (e) {
            this.logo.erro = e.message || 'Erro ao enviar.';
          } finally {
            this.logo.enviando = false;
          }
        },
        async removerLogo() {
          if (!await window.confirmDlg('Remover a logo e voltar a exibir a marca do Kivo?')) return;
          this.logo.enviando = true;
          this.logo.erro = '';
          try {
            const r = await fetch('/api/settings/company-logo', { method: 'DELETE' });
            if (!r.ok) {
              this.logo.erro = ((await r.json().catch(() => ({}))) || {}).error ?? 'Não foi possível remover.';
              return;
            }
            this.logo.url = '';
            setTimeout(() => location.reload(), 500);
          } finally {
            this.logo.enviando = false;
          }
        },

        openLicenseDlg() {
          this.licenseForm = { companyUuid: '', licenseKey: '' };
          this.licenseError = '';
          this.$refs.licenseDlg.showModal();
        },
        <% if (user.permissions.has('license.edit')) { %>
        async saveLicense() {
          if (!this.licenseForm.companyUuid || !this.licenseForm.licenseKey) {
            this.licenseError = 'Preencha empresa e chave de licença.'; return;
          }
          this.savingLicense = true; this.licenseError = '';
          const r = await fetch('/api/license', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ companyUuid: this.licenseForm.companyUuid, licenseKey: this.licenseForm.licenseKey }),
          });
          this.savingLicense = false;
          if (r.ok) {
            const body = await r.json();
            this.license = body;
            this.licenseThanks = { sync: body.sync, syncError: body.syncError };
            this.$refs.licenseDlg.close();
            this.$refs.licenseThanksDlg.showModal();
          } else this.licenseError = (await r.json()).error ?? 'Falha ao salvar licença.';
        },
        <% } %>
        <% if (user.permissions.has('sync.run')) { %>
        async syncNow() {
          this.syncing = true; this.licenseError = '';
          const r = await fetch('/api/sync/run', { method: 'POST' });
          this.syncing = false;
          if (r.ok) {
            const l = await fetch('/api/license');
            if (l.ok) this.license = await l.json();
          } else this.licenseError = (await r.json()).error ?? 'Falha ao sincronizar.';
        },
        <% } %>
        <% if (user.permissions.has('settings.edit')) { %>
        async saveCloudUrl() {
          this.savingCloudUrl = true;
          const r = await fetch('/api/settings/sync.server_url', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: this.cloudUrlForm.value || null }),
          });
          this.savingCloudUrl = false;
          if (r.ok) await this.load();
        },
        <% } %>
        async saveStock() {
          this.savingStock = true; this.stockSaved = '';
          const upsert = (key, value) => fetch(`/api/settings/${encodeURIComponent(key)}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value }),
          });
          const results = await Promise.all([
            upsert('estoque.auto_sku', this.stock.autoSku ? '1' : '0'),
            upsert('estoque.min_stock_padrao', String(this.stock.minStockPadrao)),
          ]);
          this.savingStock = false;
          this.stockSaved = results.every((r) => r.ok) ? 'Salvo.' : 'Falha ao salvar.';
          const r = await fetch('/api/settings');
          if (r.ok) { this.settings = await r.json(); this.syncSettings(); }
        },
        async saveSales() {
          this.savingSales = true; this.salesSaved = '';
          const upsert = (key, value) => fetch(`/api/settings/${encodeURIComponent(key)}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value }),
          });
          const results = await Promise.all([
            upsert('vendas.exibir_cupom_fiscal', this.sales.exibirCupom ? '1' : '0'),
            upsert('caixa.lembrete_24h', this.sales.lembreteCaixa24h ? '1' : '0'),
          ]);
          this.savingSales = false;
          this.salesSaved = results.every((r) => r.ok) ? 'Salvo.' : 'Falha ao salvar.';
          const r = await fetch('/api/settings');
          if (r.ok) { this.settings = await r.json(); this.syncSettings(); }
        },
        async saveFinanceiro() {
          this.savingFinanceiro = true; this.financeiroSaved = '';
          const pct = (s) => { const n = parseFloat(String(s || '0').replace(',', '.')); return isNaN(n) ? 0 : n; };
          const upsert = (key, value) => fetch(`/api/settings/${encodeURIComponent(key)}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ value }),
          });
          const results = await Promise.all([
            upsert('financeiro.multa_atraso.ativa', this.financeiro.multaAtiva ? '1' : '0'),
            upsert('financeiro.multa_atraso.percentual', String(pct(this.financeiro.multaPercentual))),
            upsert('financeiro.juros_atraso.ativo', this.financeiro.jurosAtivo ? '1' : '0'),
            upsert('financeiro.juros_atraso.percentual_dia', String(pct(this.financeiro.jurosPercentualDia))),
          ]);
          this.savingFinanceiro = false;
          this.financeiroSaved = results.every((r) => r.ok) ? 'Salvo.' : 'Falha ao salvar.';
          const s = await fetch('/api/settings');
          if (s.ok) { this.settings = await s.json(); this.syncSettings(); }
        },
        async saveEmpresa() {
          this.savingEmpresa = true; this.empresaSaved = '';
          const upsert = (key, value) => fetch(`/api/settings/${encodeURIComponent(key)}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: value || null }),
          });
          const results = await Promise.all([
            upsert('empresa.nome', this.empresa.nome),
            upsert('empresa.razao_social', this.empresa.razaoSocial),
            upsert('empresa.documento', this.empresa.documento),
            upsert('empresa.ie', this.empresa.ie),
            upsert('empresa.email', this.empresa.email),
            upsert('empresa.telefone', this.empresa.telefone),
            upsert('empresa.endereco', this.empresa.endereco),
          ]);
          this.savingEmpresa = false;
          this.empresaSaved = results.every((r) => r.ok) ? 'Salvo.' : 'Falha ao salvar.';
          const r = await fetch('/api/settings');
          if (r.ok) { this.settings = await r.json(); this.syncSettings(); }
        },
        async saveFidelidade() {
          this.savingFidelidade = true; this.fidelidadeSaved = '';
          const valorCents = Math.round(parseFloat(String(this.fidelidade.valorResgate || '0').replace(/\./g, '').replace(',', '.')) * 100);
          const upsert = (key, value) => fetch(`/api/settings/${encodeURIComponent(key)}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ value }),
          });
          const results = await Promise.all([
            upsert('fidelidade.ativo', this.fidelidade.ativo ? '1' : '0'),
            upsert('fidelidade.pontos_por_real', String(this.fidelidade.pontosPorReal)),
            upsert('fidelidade.pontos_resgate', String(this.fidelidade.pontosResgate)),
            upsert('fidelidade.valor_resgate_cents', String(valorCents)),
          ]);
          this.savingFidelidade = false;
          this.fidelidadeSaved = results.every((r) => r.ok) ? 'Salvo.' : 'Falha ao salvar.';
          const s = await fetch('/api/settings');
          if (s.ok) { this.settings = await s.json(); this.syncSettings(); }
        },
        // Grava na hora, sem botão. O valor local muda ANTES do fetch de propósito: se a
        // gravação falhar, devolver o valor anterior vira uma mudança de verdade para o
        // Alpine e a chave volta sozinha na tela — em vez de ficar marcada mentindo.
        async toggleAcessoLocal(alvo) {
          const anterior = this.rede.acessoLocal;
          this.rede.acessoLocal = alvo;
          this.savingRede = true; this.redeSaved = '';
          try {
            const r = await fetch('/api/settings/rede.acesso_local', {
              method: 'PUT', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ value: alvo ? '1' : '0' }),
            });
            if (!r.ok) throw new Error('falhou');
            this.redeSaved = alvo
              ? 'Ligado e salvo. Feche e abra o Kivo para os outros aparelhos alcançarem este computador.'
              : 'Desligado e salvo. Feche e abra o Kivo para fechar o acesso.';
            showToast(this.redeSaved, 'success');
          } catch (e) {
            this.rede.acessoLocal = anterior;
            this.redeSaved = '';
            showToast('Não foi possível salvar o acesso pela rede local. Tente de novo.', 'error');
          } finally {
            this.savingRede = false;
          }
        },
        // ─── Atualização do app ───
        // Tudo passa por /api/updates (core/updater): a tela é servida pelo Express local,
        // não é uma renderer com IPC, então não há `window.electron` para chamar aqui.
        get temAtualizacao() {
          return this.atualizacao.suportado
            && (this.atualizacao.status === 'disponivel' || this.atualizacao.status === 'baixando' || this.atualizacao.status === 'baixado');
        },
        get pct() {
          return this.atualizacao.progresso ? this.atualizacao.progresso.percent : 0;
        },
        fmtBytes(n) {
          n = Number(n) || 0;
          if (n < 1024) return n + ' B';
          if (n < 1024 * 1024) return (n / 1024).toFixed(0) + ' KB';
          return (n / 1024 / 1024).toFixed(1) + ' MB';
        },
        fmtQuando(iso) {
          const d = new Date(iso);
          return isNaN(d) ? '—' : d.toLocaleString('pt-BR');
        },
        async lerAtualizacao() {
          try {
            const r = await fetch('/api/updates/status');
            if (!r.ok) return;
            const d = await r.json();
            if (!d) return;
            // `ocupado`/`confirmando` são estado só da tela — o servidor não os conhece,
            // e sobrescrevê-los aqui reabilitaria um botão no meio de um clique.
            this.atualizacao = { ...this.atualizacao, ...d };
            if (this.atualizacao.status !== 'baixado') this.atualizacao.confirmando = false;
            this.acompanharAtualizacao();
          } catch (e) {
            // Sem rede local não há o que mostrar; a próxima leitura tenta de novo.
          }
        },
        // Só enquanto há algo em movimento: parado, a aba não fica batendo no servidor.
        acompanharAtualizacao() {
          const emMovimento = this.atualizacao.status === 'verificando' || this.atualizacao.status === 'baixando';
          if (emMovimento && !this.pollAtualizacaoId) {
            this.pollAtualizacaoId = setInterval(() => this.lerAtualizacao(), 1500);
          } else if (!emMovimento && this.pollAtualizacaoId) {
            clearInterval(this.pollAtualizacaoId);
            this.pollAtualizacaoId = null;
          }
        },
        async acaoAtualizacao(rota, erroPadrao) {
          this.atualizacao.ocupado = true;
          try {
            const r = await fetch('/api/updates/' + rota, { method: 'POST' });
            const body = await r.json().catch(() => null);
            if (!r.ok) {
              showToast((body && body.error) || erroPadrao, 'error');
              return null;
            }
            if (body) this.atualizacao = { ...this.atualizacao, ...body };
            this.acompanharAtualizacao();
            return body;
          } catch (e) {
            showToast(erroPadrao, 'error');
            return null;
          } finally {
            this.atualizacao.ocupado = false;
          }
        },
        async procurarAtualizacao() {
          this.atualizacao.erro = null;
          const r = await this.acaoAtualizacao('check', 'Não foi possível verificar agora.');
          if (r && r.status === 'ocioso') showToast('Nenhuma versão nova por enquanto.', 'info');
        },
        async baixarAtualizacao() {
          const r = await this.acaoAtualizacao('download', 'Não foi possível iniciar o download.');
          if (r) showToast('Download iniciado — pode continuar trabalhando.', 'info');
        },
        async instalarAtualizacao() {
          this.atualizacao.ocupado = true;
          try {
            const r = await fetch('/api/updates/install', { method: 'POST' });
            const body = await r.json().catch(() => null);
            if (!r.ok) {
              this.atualizacao.ocupado = false;
              this.atualizacao.confirmando = false;
              showToast((body && body.error) || 'Não foi possível instalar agora.', 'error');
              return;
            }
            // Não zera `ocupado`: o app fecha em seguida, e reabilitar o botão só daria
            // margem a um segundo clique enquanto a janela ainda está na tela.
            showToast('Atualizando… o Kivo vai fechar e abrir sozinho.', 'success');
          } catch (e) {
            this.atualizacao.ocupado = false;
            showToast('Não foi possível instalar agora.', 'error');
          }
        },
        async saveSyncIntervalo() {
          this.savingSync = true; this.syncSaved = '';
          const r = await fetch('/api/settings/sync.intervalo_minutos', {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: String(this.rede.syncIntervalo) }),
          });
          this.savingSync = false;
          this.syncSaved = r.ok ? 'Salvo — reinicie o Kivo para aplicar.' : 'Falha ao salvar.';
        },
        copyUrl(u) {
          navigator.clipboard?.writeText(u).then(() => {
            this.copiedUrl = u;
            setTimeout(() => { if (this.copiedUrl === u) this.copiedUrl = ''; }, 1500);
          });
        },
        copyCardapioUrl() {
          navigator.clipboard?.writeText(this.cardapio.url).then(() => {
            this.cardapio.copied = true;
            setTimeout(() => { this.cardapio.copied = false; }, 1500);
          });
        },
        async saveSecurity() {
          this.savingSecurity = true; this.securitySaved = '';
          const r = await fetch('/api/settings/seguranca.pin_remover_item', {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: this.security.pinRemoverItem ? '1' : '0' }),
          });
          this.savingSecurity = false;
          this.securitySaved = r.ok ? 'Salvo.' : 'Falha ao salvar.';
          const s = await fetch('/api/settings');
          if (s.ok) { this.settings = await s.json(); this.syncSettings(); }
        },
        async savePin() {
          this.pinError = ''; this.pinSaved = '';
          if (!this.pinForm.pin || this.pinForm.pin !== this.pinForm.confirm) {
            this.pinError = 'Os PINs não conferem.'; return;
          }
          this.savingPin = true;
          const r = await fetch('/api/security/pin', {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pin: this.pinForm.pin }),
          });
          this.savingPin = false;
          if (r.ok) {
            this.pinConfigured = true; this.pinSaved = 'PIN salvo.'; this.pinForm = { pin: '', confirm: '' };
          } else this.pinError = (await r.json()).error ?? 'Falha ao salvar PIN.';
        },
        // ─── Reset de fábrica (zona de perigo) ───
        openReset() {
          this.reset = { confirmacao: '', includeCloudBackups: false, rodando: false, erro: '', result: null };
          this.$refs.resetDlg.showModal();
        },
        async runReset() {
          if (this.reset.confirmacao.trim().toUpperCase() !== 'RESETAR' || this.reset.rodando) return;
          this.reset.rodando = true; this.reset.erro = '';
          try {
            const r = await fetch('/api/settings/factory-reset', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                confirmacao: this.reset.confirmacao.trim().toUpperCase(),
                includeCloudBackups: this.reset.includeCloudBackups,
              }),
            });
            const body = await r.json().catch(() => ({}));
            if (!r.ok) { this.reset.erro = body.error ?? 'Não foi possível concluir o reset.'; return; }
            this.reset.result = body;
            // Nada de recarregar sozinho: o lojista precisa ler o número do backup de
            // segurança antes de sair da tela. Sair é um clique dele, no botão do rodapé.
          } catch (e) {
            this.reset.erro = 'Erro de conexão — nada foi apagado.';
          } finally {
            this.reset.rodando = false;
          }
        },

        openNew() { this.form = { locked: false }; this.$refs.dlg.showModal(); },
        openEdit(s) { this.form = { key: s.key, value: s.value ?? '', locked: true }; this.$refs.dlg.showModal(); },
        async save() {
          if (!this.form.key) return;
          const r = await fetch(`/api/settings/${encodeURIComponent(this.form.key)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: this.form.value }),
          });
          if (r.ok) { this.$refs.dlg.close(); this.load(); showToast('Configuração salva.', 'success'); }
          else showToast((await r.json()).error ?? 'Erro ao salvar.', 'error');
        },
      };
    }
  </script>
</body>
</html>
