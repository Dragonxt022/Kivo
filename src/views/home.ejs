<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
  <style>
    .login-overlay {
      position: fixed; inset: 0; z-index: 200;
      display: grid; place-items: center;
      background: rgba(0,0,0,.45);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .login-card {
      background: var(--surface); border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg); padding: 2.5rem 2rem;
      width: 340px; text-align: center;
    }
    /* O resgate tem texto explicativo e um código para ler ao telefone; 340px espremeria
       o código em duas linhas, que é justamente onde a pessoa erra ao ditar. */
    .login-card.wide { width: min(420px, 92vw); max-height: 90vh; overflow-y: auto; }
    .login-card img.logo { width: 80px; margin-bottom: .75rem; }
    .login-card h1 { font-size: 1.2rem; font-weight: 600; margin-bottom: 1.25rem; }
    .login-card label { display: block; text-align: left; font-size: .82rem; color: var(--text-muted); margin-bottom: .25rem; }
    .login-card input[type="text"],
    .login-card input[type="password"] {
      width: 100%; padding: .6rem .75rem; border-radius: 10px;
      border: 1.5px solid var(--border-light); background: var(--surface-hover);
      color: var(--text); font-size: .95rem; margin-bottom: .85rem;
      transition: border-color var(--transition), box-shadow var(--transition);
    }
    .login-card input:focus {
      outline: none; border-color: var(--primary);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 15%, transparent);
    }
    .login-card .remember {
      display: flex; align-items: center; gap: .5rem;
      margin-bottom: 1rem; font-size: .85rem; color: var(--text-muted); cursor: pointer;
    }
    .login-card .remember input { width: 16px; height: 16px; cursor: pointer; }
    .login-card button[type="submit"] {
      width: 100%; padding: .7rem; border: 0; border-radius: 10px;
      background: var(--primary); color: #fff; font-size: .95rem; font-weight: 600;
      cursor: pointer; transition: background var(--transition), transform var(--transition);
    }
    .login-card button[type="submit"]:hover { background: var(--primary-hover); transform: translateY(-1px); }
    .login-card button[type="submit"]:active { transform: scale(.98); }
    .login-card .error { color: var(--danger); font-size: .85rem; margin-top: .75rem; min-height: 1.2em; }
    .login-card .version { color: var(--text-muted); font-size: .72rem; margin-top: 1.25rem; }
    .login-card .setup-intro { font-size: .84rem; color: var(--text-muted); text-align: left; margin-bottom: 1.1rem; line-height: 1.45; }
    .login-card .setup-hint { font-size: .76rem; color: var(--text-muted); text-align: left; margin: -.4rem 0 .9rem; }
    .login-card .link-btn {
      background: none; border: 0; color: var(--text-muted); font-family: inherit;
      font-size: .82rem; cursor: pointer; margin-top: .9rem; text-decoration: underline;
    }
    .login-card .link-btn:hover { color: var(--primary); }

    /* ─── Resgate de senha ─── */
    .recovery { text-align: left; }
    .recovery h1 { text-align: center; }
    .recovery-primary {
      border: 1.5px solid var(--border-light); border-radius: 12px;
      background: var(--surface-hover); padding: .85rem .9rem; margin-bottom: .3rem;
    }
    .recovery-primary strong { font-size: .9rem; }
    .recovery-primary p { font-size: .82rem; color: var(--text-muted); line-height: 1.45; margin: .35rem 0 0; }
    .recovery-count { font-size: .78rem !important; }
    .recovery-count.alone { color: var(--warning) !important; font-weight: 600; }
    .recovery-sep {
      display: flex; align-items: center; gap: .6rem; margin: 1rem 0 .85rem;
      color: var(--text-muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .05em;
    }
    .recovery-sep::before, .recovery-sep::after {
      content: ''; flex: 1; height: 1px; background: var(--border-light);
    }
    .btn-secondary-full {
      width: 100%; padding: .7rem; border-radius: 10px; cursor: pointer;
      border: 1.5px solid var(--primary); background: transparent; color: var(--primary);
      font-family: inherit; font-size: .92rem; font-weight: 600;
    }
    .btn-secondary-full:hover { background: color-mix(in srgb, var(--primary) 10%, transparent); }
    .recovery-warn {
      font-size: .82rem; line-height: 1.45; color: var(--text-muted);
      border: 1.5px solid var(--warning); border-radius: 10px;
      background: var(--warning-soft); padding: .7rem .8rem;
    }
    .recovery-support {
      display: flex; flex-direction: column; gap: .15rem;
      margin-top: 1rem; padding-top: .8rem; border-top: 1px solid var(--border-light);
      font-size: .78rem; color: var(--text-muted); text-align: center;
    }
    .recovery-challenge {
      display: flex; align-items: center; flex-wrap: wrap; gap: .4rem;
      border: 1.5px dashed var(--primary); border-radius: 12px;
      background: color-mix(in srgb, var(--primary) 8%, transparent);
      padding: .7rem .8rem; margin-bottom: .5rem;
    }
    .recovery-challenge .recovery-label {
      width: 100%; font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted);
    }
    /* O código é lido em voz alta ao telefone: monoespaçado e largo para não confundir
       caractere, e `user-select: all` para o clique único selecionar tudo. */
    .recovery-challenge code {
      flex: 1; font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
      font-size: 1.02rem; font-weight: 700; letter-spacing: .08em; color: var(--text);
      user-select: all;
    }
    .recovery-copy {
      background: none; border: 0; color: var(--primary); font-family: inherit;
      font-size: .78rem; font-weight: 600; cursor: pointer; padding: .1rem .2rem;
    }
    .login-card input.recovery-code-input {
      font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
      letter-spacing: .1em; text-transform: uppercase;
    }
    .recovery-ok { color: var(--success); font-weight: 600; text-align: center; margin-bottom: .5rem; }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: 'home' }) %>

  <main x-data="homePage()" x-init="init()">
    <!-- ─── Overlay de login (quando não autenticado ou ?login=1) ─── -->
    <div class="login-overlay" x-show="showLogin" x-cloak>
      <div class="login-card" :class="recovery.open ? 'wide' : ''">
        <img class="logo" :src="theme === 'dark' ? '/logo_kivo-horizontal_branco.svg' : '/logo_kivo-horizontal.svg'" alt="Kivo" />

        <!-- Primeiro acesso: instalação recém-ativada, ainda com o admin/admin de fábrica.
             Pedir login aqui é pedir uma senha que o lojista nunca recebeu — então em vez
             de perguntar, o sistema deixa ele criar o próprio acesso na hora. -->
        <template x-if="firstRun">
          <div>
            <h1>Crie seu acesso</h1>
            <p class="setup-intro">Este é o primeiro acesso deste computador. Escolha seu usuário e senha — é com eles que você vai entrar daqui pra frente.</p>
            <form @submit.prevent="completeFirstRun">
              <label for="setup-name">Seu nome</label>
              <input id="setup-name" type="text" x-model="setupName" autocomplete="name" x-ref="setupName" maxlength="80" />
              <label for="setup-user">Usuário (para entrar)</label>
              <input id="setup-user" type="text" x-model="setupUser" autocomplete="username" maxlength="32"
                     placeholder="ex.: maria" />
              <label for="setup-pass">Senha</label>
              <input id="setup-pass" type="password" x-model="setupPass" autocomplete="new-password" />
              <label for="setup-pass2">Repita a senha</label>
              <input id="setup-pass2" type="password" x-model="setupPass2" autocomplete="new-password" />
              <p class="setup-hint">Mínimo de 8 caracteres, com maiúscula, minúscula e número.</p>
              <button type="submit" x-text="setupLoading ? 'Criando…' : 'Criar acesso e entrar'"
                      :disabled="setupLoading"></button>
              <div class="error" x-text="setupError"></div>
            </form>
            <button type="button" class="link-btn" @click="firstRun = false">Já tenho um usuário</button>
          </div>
        </template>

        <%# Entrada rápida: balões de quem salvou o perfil NESTE computador. A rota devolve
            lista vazia fora do loopback, então pela rede local isto nem aparece — quem está
            no celular vê só o formulário normal. %>
        <template x-if="!firstRun && !recovery.open && quickProfiles.length">
          <div class="quick-profiles">
            <h1>Quem está usando?</h1>
            <div class="quick-profiles-grid">
              <template x-for="p in quickProfiles" :key="p.id">
                <button type="button" class="quick-profile" @click="quickLogin(p)"
                        :disabled="quickLoading" :title="'Entrar como ' + p.name">
                  <span class="quick-profile-bolha" :style="{ background: p.color }" x-text="p.initials"></span>
                  <span class="quick-profile-nome" x-text="p.name"></span>
                </button>
              </template>
            </div>
            <div class="error" x-text="quickError"></div>
            <button type="button" class="link-btn" @click="quickProfiles = []">Entrar com outro usuário</button>
          </div>
        </template>

        <template x-if="!firstRun && !recovery.open && !quickProfiles.length">
          <div>
            <h1>Entrar no Kivo</h1>
            <form @submit.prevent="login">
              <label for="login-user">Usuário</label>
              <input id="login-user" type="text" x-model="loginUser" autocomplete="username"
                     x-ref="loginUser" @keydown.escape.prevent="handleLoginEsc()" />
              <label for="login-pass">Senha</label>
              <input id="login-pass" type="password" x-model="loginPass" autocomplete="current-password"
                     @keydown.escape.prevent="handleLoginEsc()" />
              <button type="submit" x-text="loginLoading ? 'Entrando…' : 'Entrar'"
                      :disabled="loginLoading"></button>
              <div class="error" x-text="loginError"></div>
            </form>
            <button type="button" class="link-btn" @click="openRecovery()">Esqueci minha senha</button>
          </div>
        </template>

        <%# Resgate de senha. Ocupa o card inteiro em vez de abrir um <dialog>: a tela de
            login já é um overlay modal, e dois modais empilhados no mesmo canto viram
            confusão justamente com quem está nervoso por não conseguir entrar. %>
        <template x-if="recovery.open">
          <div class="recovery">
            <h1>Esqueci minha senha</h1>

            <!-- Passo 1: o caminho que resolve sem ligar para ninguém. -->
            <template x-if="recovery.step === 'inicio'">
              <div>
                <div class="recovery-primary">
                  <strong>Peça a outro administrador</strong>
                  <p>
                    Quem tem acesso de administrador entra no Kivo, abre
                    <strong>Usuários</strong>, clica no seu nome e define uma senha nova.
                    É o caminho mais rápido e não depende de internet nem do suporte.
                  </p>
                  <p class="recovery-count" x-show="recovery.status"
                     x-text="recovery.status && recovery.status.administradores > 1
                       ? 'Neste computador há ' + recovery.status.administradores + ' pessoas que podem fazer isso.'
                       : 'Atenção: neste computador só existe UM acesso capaz de redefinir senhas.'"
                     :class="recovery.status && recovery.status.administradores <= 1 ? 'alone' : ''"></p>
                </div>

                <div class="recovery-sep"><span>ou, se você é o único administrador</span></div>

                <template x-if="recovery.status && recovery.status.disponivel">
                  <div>
                    <p class="setup-intro" style="margin-bottom:.8rem">
                      O suporte gera um código de liberação para este computador. Funciona
                      mesmo sem internet — é só uma ligação.
                    </p>
                    <button type="button" class="btn-secondary-full" @click="recovery.step = 'usuario'">
                      Resgatar com o suporte
                    </button>
                  </div>
                </template>

                <template x-if="recovery.status && !recovery.status.disponivel">
                  <p class="recovery-warn">
                    O resgate por código ainda não está disponível neste computador: ele
                    precisa se conectar à internet uma vez para receber o código de
                    segurança da sua licença. Deixe o Kivo aberto e conectado por alguns
                    minutos e volte aqui.
                  </p>
                </template>

                <div class="recovery-support" x-show="recovery.status && (recovery.status.supportPhone || recovery.status.supportEmail)">
                  <span x-show="recovery.status && recovery.status.supportPhone"
                        x-text="'Suporte: ' + (recovery.status ? recovery.status.supportPhone : '')"></span>
                  <span x-show="recovery.status && recovery.status.supportEmail"
                        x-text="recovery.status ? recovery.status.supportEmail : ''"></span>
                </div>
              </div>
            </template>

            <!-- Passo 2: de quem é a senha a trocar. Digitado, não escolhido numa lista —
                 listar os usuários entregaria a equipe da loja a quem só alcançou esta
                 tela pela rede. -->
            <template x-if="recovery.step === 'usuario'">
              <form @submit.prevent="startRecovery()">
                <p class="setup-intro">De qual usuário é a senha que você precisa trocar?</p>
                <label for="rec-user">Usuário</label>
                <input id="rec-user" type="text" x-model="recovery.username" x-ref="recUser"
                       autocomplete="username" placeholder="ex.: maria" />
                <button type="submit" :disabled="recovery.loading"
                        x-text="recovery.loading ? 'Gerando…' : 'Gerar código'"></button>
                <div class="error" x-text="recovery.error"></div>
              </form>
            </template>

            <!-- Passo 3: ditar o desafio, digitar a resposta e a senha nova de uma vez. -->
            <template x-if="recovery.step === 'codigo'">
              <form @submit.prevent="finishRecovery()">
                <p class="setup-intro">
                  Ligue para o suporte e leia o código abaixo. Diga também que a instalação é
                  a <strong x-text="recovery.instalacao"></strong>.
                </p>

                <div class="recovery-challenge">
                  <span class="recovery-label">Código deste computador</span>
                  <code x-text="recovery.challenge"></code>
                  <button type="button" class="recovery-copy" @click="copyChallenge()"
                          x-text="recovery.copied ? 'Copiado!' : 'Copiar'"></button>
                </div>
                <p class="setup-hint" x-text="'Trocando a senha de ' + recovery.userLabel + '. Vale por ' + recovery.expiraEm + ' minutos.'"></p>

                <label for="rec-code">Código de liberação (o suporte dita)</label>
                <input id="rec-code" type="text" x-model="recovery.response" x-ref="recCode"
                       class="recovery-code-input" placeholder="XXXXX-XXXXX" autocomplete="off"
                       spellcheck="false" />

                <label for="rec-pass">Senha nova</label>
                <input id="rec-pass" type="password" x-model="recovery.pass" autocomplete="new-password" />
                <label for="rec-pass2">Repita a senha nova</label>
                <input id="rec-pass2" type="password" x-model="recovery.pass2" autocomplete="new-password" />
                <p class="setup-hint">Mínimo de 8 caracteres, com maiúscula, minúscula e número.</p>

                <button type="submit" :disabled="recovery.loading"
                        x-text="recovery.loading ? 'Trocando…' : 'Trocar a senha'"></button>
                <div class="error" x-text="recovery.error"></div>
              </form>
            </template>

            <!-- Passo 4 -->
            <template x-if="recovery.step === 'pronto'">
              <div>
                <p class="recovery-ok">Senha trocada.</p>
                <p class="setup-intro">
                  Agora entre com o usuário <strong x-text="recovery.userLabel"></strong> e a
                  senha que você acabou de definir.
                </p>
                <button type="button" @click="closeRecovery(recovery.username)">Ir para o login</button>
              </div>
            </template>

            <button type="button" class="link-btn" @click="recovery.step === 'inicio' || recovery.step === 'pronto' ? closeRecovery() : (recovery.step = 'inicio', recovery.error = '')"
                    x-text="recovery.step === 'inicio' || recovery.step === 'pronto' ? 'Voltar para o login' : 'Voltar'"></button>
          </div>
        </template>

        <p class="version">Versão <%= appVersion %></p>
      </div>
    </div>

    <% if (user) { %>
    <div class="greeting">
      <h1><span x-html="greetingIcon" style="vertical-align:-.3rem;margin-right:.4rem"></span><span x-text="greeting + ', '"></span><%= user.name %></h1>
      <p>Comida que alimenta, sistema que organiza.</p>
    </div>

    <%
      var showDashCash = user.permissions.has('finance.cash.view');
      var showDashBills = user.permissions.has('finance.payables.view') || user.permissions.has('finance.receivables.view');
      var showDashSales = user.permissions.has('store.reports.view');
    %>
    <% if (showDashCash || showDashBills || showDashSales) { %>
    <div x-data="homeDashboard()" x-init="init()">
      <div class="home-dashboard">
        <% if (showDashCash) { %>
        <a href="/app/finance/caixa" class="stat-tile">
          <div class="stat-tile-label">Caixa</div>
          <div class="stat-tile-value" x-text="loading ? '…' : (cash && cash.open ? brl(cash.expectedCents) : brl(0))"></div>
          <div class="stat-tile-status" :class="cash && cash.open ? 'good' : 'muted'" x-show="!loading" x-text="cash && cash.open ? 'Caixa aberto' : 'Caixa fechado'"></div>
        </a>
        <% } %>
        <% if (showDashBills) { %>
        <a href="/app/finance/pagar" class="stat-tile">
          <div class="stat-tile-label">Contas a vencer</div>
          <div class="stat-tile-value" x-text="loading ? '…' : (bills ? bills.count : 0)"></div>
          <div class="stat-tile-status" :class="bills && bills.count > 0 ? 'warning' : 'muted'" x-show="!loading">próximos 3 dias</div>
        </a>
        <% } %>
        <% if (showDashSales) { %>
        <a href="/app/store/vendas" class="stat-tile">
          <div class="stat-tile-label">Vendas hoje</div>
          <div class="stat-tile-value" x-text="loading ? '…' : brl(salesToday ? salesToday.total_cents : 0)"></div>
          <div class="stat-tile-status good" x-show="!loading" x-text="(salesToday ? salesToday.vendas : 0) + ' venda(s)'"></div>
        </a>
        <% } %>
      </div>

      <% if (showDashSales) { %>
      <div class="dashboard-chart-panel">
        <div class="dashboard-chart-header">
          <h2>Evolução do negócio</h2>
          <div class="dashboard-chart-tools">
            <div class="period-toggle" x-show="!chartHidden" x-cloak>
              <button type="button" :class="{ active: period === 'week' }" @click="setPeriod('week')">Semana</button>
              <button type="button" :class="{ active: period === 'month' }" @click="setPeriod('month')">Mês</button>
              <button type="button" :class="{ active: period === 'year' }" @click="setPeriod('year')">Ano</button>
            </div>
            <button type="button" class="chart-toggle-btn" @click="toggleChart()"
                    :title="chartHidden ? 'Mostrar gráfico' : 'Ocultar gráfico'"
                    :aria-label="chartHidden ? 'Mostrar gráfico' : 'Ocultar gráfico'">
              <svg x-show="!chartHidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg x-show="chartHidden" x-cloak width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
            </button>
          </div>
        </div>
        <div class="bar-chart" x-show="!chartHidden" x-cloak>
          <template x-for="(b, idx) in trend" :key="period + '-' + b.key">
            <div class="bar-col" @mouseenter="hoverBar = idx" @mouseleave="hoverBar = null">
              <div class="bar-tooltip" x-show="hoverBar === idx" x-text="b.label + ': ' + brl(b.totalCents)"></div>
              <div class="bar-fill" :style="{ height: (maxTrend ? (b.totalCents / maxTrend * 100) : 0) + '%' }"></div>
              <span class="bar-label" x-text="b.label"></span>
            </div>
          </template>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>

    <div class="search-wrap">
      <span class="search-icon"><%- svgIcon('search', 18, 18) %></span>
      <input type="text" placeholder="Buscar aplicativo…" x-model="q" @input="filter" />
    </div>

    <div class="app-grid" x-ref="grid">
      <template x-for="a in apps" :key="a.href">
        <a class="app-card drag-enabled" :href="a.href" :data-href="a.href" draggable="false"
           x-show="matches(a.label)"
           :class="[dragId === a.href ? 'dragging' : '', dropOverId === a.href ? 'drop-target' : '']"
           @pointerdown="onCardPointerDown($event, a)">
           <span class="card-icon" x-html="iconSvg(a.icon)"></span>
          <span class="card-title" x-text="a.label"></span>
          <span class="card-desc" x-text="a.description"></span>
        </a>
      </template>
      <%
        var moduleItems = [];
        (typeof moduleMenu !== 'undefined' ? moduleMenu : []).forEach(function (item) {
          if (!item.permission || user.permissions.has(item.permission)) {
            moduleItems.push(item);
          }
        });
        var visibleItemsForAlpine = moduleItems.map(function (item) {
          return { label: item.label, href: item.href, icon: item.icon, description: item.description ?? '' };
        });
        var visibleItems = moduleItems.slice();
        var adminItems = [];
        if (user.permissions.has('users.view')) adminItems.push({ label: 'Usuários', href: '/admin/usuarios', icon: 'user-cog', description: 'Contas, cargos e acesso.' });
        if (user.permissions.has('roles.view')) adminItems.push({ label: 'Cargos', href: '/admin/cargos', icon: 'key', description: 'Permissões por cargo.' });
        if (user.permissions.has('audit.view')) adminItems.push({ label: 'Auditoria', href: '/admin/auditoria', icon: 'audit', description: 'Quem fez o quê, quando e de onde.' });
        if (user.permissions.has('backup.view')) adminItems.push({ label: 'Backup', href: '/admin/backup', icon: 'database', description: 'Cópias de segurança do banco.' });
        if (user.permissions.has('settings.view')) adminItems.push({ label: 'Configurações', href: '/admin/configuracoes', icon: 'settings', description: 'Parâmetros do sistema e licença.' });
        if (user.permissions.has('dev.docs.view')) adminItems.push({ label: 'Documentação técnica', href: '/admin/documentacao', icon: 'file-text', description: 'Regras de negócio por módulo (suporte).' });
        visibleItems = visibleItems.concat(adminItems);
      %>

      <% if (adminItems.length) { %>
      <button type="button" class="app-card" @click="showMore = !showMore" x-show="!q">
        <span class="card-icon"><%- svgIcon('more', 40, 40) %></span>
        <span class="card-title" x-text="showMore ? 'Mostrar menos' : 'Mais'"></span>
        <span class="card-desc">Usuários, cargos, auditoria, backup e configurações.</span>
      </button>
      <% } %>

      <% adminItems.forEach(function (item) { %>
          <a class="app-card" href="<%= item.href %>" x-show="(showMore || q) && matches('<%= item.label %>')">
            <span class="card-icon"><%- svgIcon(item.icon, 40, 40) %></span>
            <span class="card-title"><%= item.label %></span>
            <span class="card-desc"><%= item.description %></span>
          </a>
      <% }) %>

      <%
        var rem = visibleItems.length % 6;
        if (rem > 0) {
          for (var i = 0; i < 6 - rem; i++) {
      %>
          <div class="app-card" style="visibility:hidden;border-color:transparent;box-shadow:none;cursor:default;pointer-events:none"></div>
      <%
          }
        }
      %>
    </div>
    <% } %>
  </main>

  <% if (user && user.permissions.has('settings.edit')) { %>
  <div x-data="onboardingWizard()" x-init="checkFirstRun()">
    <%- include('partials/onboarding') %>
  </div>
  <% } %>

  <%# Depois do assistente de propósito: o próprio componente só abre quando o onboarding
      está concluído, para os dois <dialog> nunca disputarem a camada superior. %>
  <% if (user) { %>
  <div x-data="novidadeAviso()">
    <%- include('partials/novidade') %>
  </div>
  <% } %>

  <% if (user) { %>
  <%- include('partials/urgent-message') %>
  <% } %>


  <% if (user && user.permissions.has('settings.edit')) { %>
  <script nonce="<%= cspNonce %>" src="/js/onboarding.js"></script>
  <% } %>
  <script nonce="<%= cspNonce %>">
    const HOME_APPS_SEED = <%- JSON.stringify(typeof visibleItemsForAlpine !== 'undefined' ? visibleItemsForAlpine : []) %>;
    const HOME_ORDER_KEY = 'kivo-home-order';
    const SVG_ICONS = <%- typeof svgIconMapJson !== 'undefined' ? svgIconMapJson : '{}' %>;

    function homePage() {
      return {
        greeting: '',
        greetingIcon: '',
        theme: document.documentElement.getAttribute('data-theme') || 'light',
        q: '',
        showMore: false,
        showLogin: false,
        loginUser: '',
        loginPass: '',
        loginLoading: false,
        loginError: '',
        firstRun: false,
        setupName: '',
        setupUser: '',
        setupPass: '',
        setupPass2: '',
        setupLoading: false,
        setupError: '',
        // Entrada rápida (balões). Lista vazia = nenhum perfil salvo nesta máquina, ou
        // acesso vindo da rede local — nos dois casos cai no formulário normal.
        quickProfiles: [],
        quickLoading: false,
        quickError: '',
        apps: [],
        dragId: null,
        dropOverId: null,
        iconSvg(name) { return SVG_ICONS[name] || ''; },

        loadOrder(items) {
          let saved = [];
          try { saved = JSON.parse(localStorage.getItem(HOME_ORDER_KEY) || '[]'); } catch {}
          if (!saved.length) return items;
          const byHref = new Map(items.map((i) => [i.href, i]));
          const ordered = [];
          saved.forEach((href) => {
            const it = byHref.get(href);
            if (it) { ordered.push(it); byHref.delete(href); }
          });
          byHref.forEach((it) => ordered.push(it));
          return ordered;
        },
        saveOrder() {
          localStorage.setItem(HOME_ORDER_KEY, JSON.stringify(this.apps.map((a) => a.href)));
        },

        onCardPointerDown(e, a) {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          const card = e.currentTarget;
          const startX = e.clientX, startY = e.clientY;
          const rect = card.getBoundingClientRect();
          let dragging = false;

          const activate = () => {
            dragging = true;
            this.dragId = a.href;
            card.style.width = rect.width + 'px';
            card.style.height = rect.height + 'px';
            card.style.left = rect.left + 'px';
            card.style.top = rect.top + 'px';
            try { card.setPointerCapture(e.pointerId); } catch {}
            card.addEventListener('click', suppressClick, { capture: true, once: true });
            if (navigator.vibrate) navigator.vibrate(12);
          };
          const suppressClick = (ev) => { ev.preventDefault(); ev.stopPropagation(); };

          const timer = setTimeout(activate, 260);

          const onMove = (ev) => {
            const dx = ev.clientX - startX, dy = ev.clientY - startY;
            if (!dragging) {
              if (Math.hypot(dx, dy) > 8) cleanup();
              return;
            }
            ev.preventDefault();
            card.style.transform = `translate(${dx}px, ${dy}px) scale(1.04)`;
            const under = document.elementFromPoint(ev.clientX, ev.clientY)?.closest('.app-card');
            this.dropOverId = under && under !== card && under.dataset.href ? under.dataset.href : null;
          };
          const onUp = () => {
            cleanup();
            if (dragging) this.finishDrag(a, card);
            else {}
          };
          const cleanup = () => {
            clearTimeout(timer);
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onUp);
          };

          window.addEventListener('pointermove', onMove);
          window.addEventListener('pointerup', onUp);
        },
        finishDrag(a, card) {
          card.removeAttribute('style');
          this.dragId = null;
          const overHref = this.dropOverId;
          this.dropOverId = null;
          const fromIdx = this.apps.findIndex((x) => x.href === a.href);
          const toIdx = overHref != null ? this.apps.findIndex((x) => x.href === overHref) : -1;
          if (fromIdx === -1 || toIdx === -1 || fromIdx === toIdx) return;
          this.reorder(fromIdx, toIdx);
        },
        async reorder(fromIdx, toIdx) {
          const grid = this.$refs.grid;
          const before = new Map();
          grid.querySelectorAll('.app-card').forEach((el) => before.set(el, el.getBoundingClientRect()));

          const [moved] = this.apps.splice(fromIdx, 1);
          this.apps.splice(toIdx, 0, moved);
          this.saveOrder();
          await this.$nextTick();

          grid.querySelectorAll('.app-card').forEach((el) => {
            const prev = before.get(el);
            if (!prev) return;
            const next = el.getBoundingClientRect();
            const dx = prev.left - next.left, dy = prev.top - next.top;
            if (!dx && !dy) return;
            el.style.transition = 'none';
            el.style.transform = `translate(${dx}px, ${dy}px)`;
            requestAnimationFrame(() => {
              el.style.transition = 'transform .32s cubic-bezier(.2,.8,.2,1)';
              el.style.transform = '';
            });
          });
        },

        init() {
          this.apps = this.loadOrder(HOME_APPS_SEED);
          const now = new Date();
          const h = now.getHours();
          const isWeekend = now.getDay() === 0 || now.getDay() === 6;

          if (isWeekend) {
            this.greetingIcon = '<svg width="22" height="22" viewBox="0 0 24 24" fill="var(--primary)" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
            this.greeting = 'Bom fim de semana';
          } else if (h < 12) {
            this.greetingIcon = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
            this.greeting = 'Bom dia';
          } else if (h < 18) {
            this.greetingIcon = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a5 5 0 0 0 .88-9.8A5.5 5.5 0 0 0 5.6 9.2 4 4 0 1 0 6 18Z"/><line x1="2" y1="2" x2="4" y2="4"/><line x1="20" y1="2" x2="22" y2="4"/><line x1="22" y1="20" x2="20" y2="22"/></svg>';
            this.greeting = 'Boa tarde';
          } else {
            this.greetingIcon = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
            this.greeting = 'Boa noite';
          }

          const isAuthed = <%= user ? 'true' : 'false' %>;
          const hasLoginParam = window.location.search.includes('login=1');
          this.showLogin = !isAuthed || hasLoginParam;

          if (this.showLogin) {
            // Sem sessão, o card pode ser de login ou de primeiro acesso — só o servidor
            // sabe se este computador ainda está com as credenciais de fábrica.
            if (!isAuthed) { this.checkFirstRun(); this.loadQuickProfiles(); }
            this.$nextTick(() => {
              const el = this.$refs.loginUser;
              if (el) el.focus();
            });
          }
        },

        async loadQuickProfiles() {
          try {
            const r = await fetch('/api/auth/quick-profiles');
            if (!r.ok) return;
            const d = await r.json();
            this.quickProfiles = d.data ?? d ?? [];
          } catch (e) { /* offline/erro: cai no formulário de sempre */ }
        },

        async quickLogin(p) {
          if (this.quickLoading) return;
          this.quickLoading = true;
          this.quickError = '';
          try {
            const r = await fetch('/api/auth/quick-login', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ profileId: p.id }),
            });
            if (!r.ok) {
              const b = await r.json().catch(() => ({}));
              this.quickError = b.error ?? 'Não foi possível entrar com este perfil.';
              return;
            }
            window.location.href = '/';
          } catch (e) {
            this.quickError = 'Erro de conexão.';
          } finally {
            this.quickLoading = false;
          }
        },

        async checkFirstRun() {
          try {
            const r = await fetch('/api/auth/first-run');
            if (!r.ok) return;
            const d = await r.json();
            this.firstRun = !!(d.pending ?? d.data?.pending);
            if (this.firstRun) this.$nextTick(() => { if (this.$refs.setupName) this.$refs.setupName.focus(); });
          } catch (e) { /* offline: segue com o login normal */ }
        },

        async completeFirstRun() {
          if (this.setupLoading) return;
          this.setupError = '';
          if (!this.setupName.trim() || !this.setupUser.trim()) {
            this.setupError = 'Informe seu nome e o usuário.';
            return;
          }
          if (this.setupPass !== this.setupPass2) {
            this.setupError = 'As senhas não conferem.';
            return;
          }
          this.setupLoading = true;
          try {
            const r = await fetch('/api/auth/first-run', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: this.setupName.trim(),
                username: this.setupUser.trim(),
                password: this.setupPass,
              }),
            });
            if (r.ok) {
              window.location.href = '/';
            } else {
              const data = await r.json();
              this.setupError = data.error || 'Não foi possível criar o acesso.';
            }
          } catch (e) {
            this.setupError = 'Erro de conexão.';
          } finally {
            this.setupLoading = false;
          }
        },

        matches(label) {
          if (!this.q) return true;
          return label.toLowerCase().includes(this.q.toLowerCase());
        },
        filter() {},

        async login() {
          if (this.loginLoading) return;
          if (!this.loginUser.trim() || !this.loginPass) {
            this.loginError = 'Informe usuário e senha.';
            return;
          }
          this.loginLoading = true;
          this.loginError = '';
          try {
            const r = await fetch('/api/auth/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                username: this.loginUser.trim(),
                password: this.loginPass,
                // Terminal de uso comercial, não dispositivo pessoal — não faz sentido
                // pedir pra derrubar a sessão em 12h por padrão. Sempre a de 30 dias.
                remember: true,
              }),
            });
            if (r.ok) {
              window.location.href = '/';
            } else {
              const data = await r.json();
              this.loginError = data.error || 'Erro ao autenticar.';
            }
          } catch (e) {
            this.loginError = 'Erro de conexão.';
          } finally {
            this.loginLoading = false;
          }
        },

        handleLoginEsc() {
          if (this.loginUser || this.loginPass) {
            this.loginUser = '';
            this.loginPass = '';
          }
        },

        // ─── Resgate de senha ───
        // Um objeto só (e não 12 propriedades soltas no componente) porque isto é um
        // fluxo com estado próprio, usado por poucas pessoas e raramente: agrupado, dá
        // para resetar tudo numa linha ao fechar.
        recovery: {
          open: false,
          step: 'inicio',
          status: null,
          username: '',
          userLabel: '',
          challenge: '',
          instalacao: '',
          expiraEm: 30,
          response: '',
          pass: '',
          pass2: '',
          loading: false,
          error: '',
          copied: false,
        },

        /** Tira o envelope { success, data } da API; aceita resposta crua também. */
        unwrap(body) {
          return body && typeof body === 'object' && 'success' in body ? (body.data ?? {}) : body;
        },

        async openRecovery() {
          this.recovery.open = true;
          this.recovery.step = 'inicio';
          this.recovery.error = '';
          // O usuário já digitado no login costuma ser o certo — poupa redigitar.
          this.recovery.username = this.loginUser.trim();
          try {
            const r = await fetch('/api/recovery/status');
            // A API embrulha tudo em { success, data } (shared/responseEnvelope.ts).
            if (r.ok) this.recovery.status = this.unwrap(await r.json());
          } catch (e) {
            // Sem status a tela ainda serve: o caminho do outro administrador aparece,
            // e o de código só some. Nunca deixar a tela vazia por causa disso.
            this.recovery.status = { disponivel: false, administradores: 0, supportPhone: null, supportEmail: null };
          }
        },

        closeRecovery(prefillUser) {
          const u = prefillUser || '';
          this.recovery = {
            open: false, step: 'inicio', status: null, username: '', userLabel: '',
            challenge: '', instalacao: '', expiraEm: 30, response: '', pass: '', pass2: '',
            loading: false, error: '', copied: false,
          };
          if (u) {
            this.loginUser = u;
            this.loginPass = '';
          }
          this.$nextTick(() => { if (this.$refs.loginUser) this.$refs.loginUser.focus(); });
        },

        async startRecovery() {
          if (this.recovery.loading) return;
          this.recovery.error = '';
          if (!this.recovery.username.trim()) {
            this.recovery.error = 'Informe o usuário.';
            return;
          }
          this.recovery.loading = true;
          try {
            const r = await fetch('/api/recovery/iniciar', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ username: this.recovery.username.trim() }),
            });
            const raw = await r.json();
            if (!r.ok) {
              this.recovery.error = raw.error || 'Não foi possível gerar o código.';
              return;
            }
            const d = this.unwrap(raw);
            this.recovery.challenge = d.challenge;
            this.recovery.userLabel = d.user.name || d.user.username;
            this.recovery.username = d.user.username;
            this.recovery.instalacao = d.instalacao;
            this.recovery.expiraEm = d.expiraEm;
            this.recovery.step = 'codigo';
            this.$nextTick(() => { if (this.$refs.recCode) this.$refs.recCode.focus(); });
          } catch (e) {
            this.recovery.error = 'Erro de conexão.';
          } finally {
            this.recovery.loading = false;
          }
        },

        async finishRecovery() {
          if (this.recovery.loading) return;
          this.recovery.error = '';
          if (!this.recovery.response.trim()) {
            this.recovery.error = 'Digite o código que o suporte passou.';
            return;
          }
          if (this.recovery.pass !== this.recovery.pass2) {
            this.recovery.error = 'As senhas não conferem.';
            return;
          }
          this.recovery.loading = true;
          try {
            const r = await fetch('/api/recovery/concluir', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                challenge: this.recovery.challenge,
                response: this.recovery.response.trim(),
                newPassword: this.recovery.pass,
              }),
            });
            const d = await r.json();
            if (!r.ok) {
              // A contagem de tentativas restantes já vem dentro da mensagem — em erro o
              // envelope da API descarta qualquer campo além de `error`.
              this.recovery.error = d.error || 'Não foi possível trocar a senha.';
              return;
            }
            this.recovery.step = 'pronto';
          } catch (e) {
            this.recovery.error = 'Erro de conexão.';
          } finally {
            this.recovery.loading = false;
          }
        },

        async copyChallenge() {
          try {
            await navigator.clipboard.writeText(this.recovery.challenge);
            this.recovery.copied = true;
            setTimeout(() => { this.recovery.copied = false; }, 2000);
          } catch (e) { /* sem clipboard: o código está na tela para ler mesmo assim */ }
        },
      };
    }

    function homeDashboard() {
      return {
        loading: true,
        cash: null,
        bills: null,
        salesToday: null,
        period: 'week',
        trend: [],
        hoverBar: null,
        // O gráfico pode ser ocultado (preferência desta máquina). Oculto, o painel fica só
        // com o título e o botão de mostrar de novo.
        chartHidden: (function () { try { return localStorage.getItem('kivo-dash-chart-hidden') === '1'; } catch { return false; } })(),
        toggleChart() {
          this.chartHidden = !this.chartHidden;
          try { localStorage.setItem('kivo-dash-chart-hidden', this.chartHidden ? '1' : '0'); } catch {}
        },
        brl(c) { return window.brl(c); },
        get maxTrend() { return Math.max(1, ...this.trend.map((b) => b.totalCents)); },
        async loadTrend() {
          const r = await fetch('/api/store/reports/revenue-trend?period=' + this.period);
          if (r.ok) this.trend = (await r.json()).buckets;
        },
        setPeriod(p) {
          if (p === this.period) return;
          this.period = p;
          this.loadTrend();
        },
        async init() {
          const jobs = [];
          <% if (user && user.permissions.has('finance.cash.view')) { %>
          jobs.push(fetch('/api/finance/cash/current').then((r) => r.ok ? r.json() : null).then((d) => { this.cash = d; }).catch(() => {}));
          <% } %>
          <% if (user && (user.permissions.has('finance.payables.view') || user.permissions.has('finance.receivables.view'))) { %>
          jobs.push(fetch('/api/finance/reports/upcoming-bills').then((r) => r.ok ? r.json() : null).then((d) => { this.bills = d; }).catch(() => {}));
          <% } %>
          <% if (user && user.permissions.has('store.reports.view')) { %>
          jobs.push(fetch('/api/store/reports/daily').then((r) => r.ok ? r.json() : null).then((d) => { this.salesToday = d ? d.totals : null; }).catch(() => {}));
          jobs.push(this.loadTrend());
          <% } %>
          await Promise.all(jobs);
          this.loading = false;
        },
      };
    }

  </script>
</body>
</html>
