<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <title>Cupom #<%= sale.id %></title>
  <style>
    * { margin: 0; box-sizing: border-box; }
    body { font-family: 'Courier New', monospace; font-size: 12px; color: #000; background: #fff;
      width: 80mm; margin: 0 auto; padding: 4mm; }
    .center { text-align: center; }
    .right { text-align: right; }
    h1 { font-size: 14px; text-transform: uppercase; }
    hr { border: 0; border-top: 1px dashed #000; margin: 6px 0; }
    table { width: 100%; border-collapse: collapse; }
    td { padding: 1px 0; vertical-align: top; }
    .total { font-size: 14px; font-weight: bold; }
    .muted { font-size: 10px; }
    @media print { body { width: auto; } .no-print { display: none; } }
    .no-print { text-align: center; margin-top: 10px; }
    .no-print button { padding: 8px 16px; font-size: 13px; cursor: pointer; }
  </style>
</head>
<body>
  <div class="center">
    <h1><%= company.name %></h1>
    <% if (company.document) { %><p class="muted"><%= company.document %></p><% } %>
    <% if (company.address) { %><p class="muted"><%= company.address %></p><% } %>
    <p class="muted">Cupom não fiscal</p>
  </div>
  <hr />
  <% function fmtDateTime(raw) {
    if (!raw) return '—';
    const d = new Date(String(raw).replace(' ', 'T').replace(/(\.\d+)?$/, '') + 'Z');
    if (isNaN(d.getTime())) return String(raw);
    return d.toLocaleString('pt-BR', { timeZone: appTimezone, day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }).replace(',', '');
  } %>
  <p>Venda: #<%= sale.id %><% if (sale.status === 'cancelada') { %> — <strong>CANCELADA</strong><% } %></p>
  <p>Data: <%= fmtDateTime(sale.created_at) %></p>
  <% if (sale.customer) { %><p>Cliente: <%= sale.customer %></p><% } %>
  <p>Vendedor: <%= sale.username ?? '—' %></p>
  <hr />
  <table>
    <% items.forEach(function (i) { %>
      <tr><td colspan="2"><%= i.product_name %></td></tr>
      <tr>
        <td class="muted"><%= i.qty %> × <%= brl(i.unit_price_cents) %></td>
        <td class="right"><%= brl(i.total_cents) %></td>
      </tr>
    <% }) %>
  </table>
  <hr />
  <table>
    <tr><td>Subtotal</td><td class="right"><%= brl(sale.subtotal_cents) %></td></tr>
    <% if (sale.discount_cents > 0) { %>
      <tr><td>Desconto</td><td class="right">-<%= brl(sale.discount_cents) %></td></tr>
    <% } %>
    <% if (sale.surcharge_cents > 0) { %>
      <tr><td>Acréscimo</td><td class="right">+<%= brl(sale.surcharge_cents) %></td></tr>
    <% } %>
    <tr class="total"><td>TOTAL</td><td class="right"><%= brl(sale.total_cents) %></td></tr>
    <% if (typeof payments !== 'undefined' && payments.length) { %>
      <% payments.forEach(function (p) { %>
        <tr><td><%= p.method_name %></td><td class="right"><%= brl(p.amount_cents) %></td></tr>
        <% if (p.received_cents != null && p.change_cents > 0) { %>
          <tr><td class="muted">Recebido / Troco</td><td class="right muted"><%= brl(p.received_cents) %> / <%= brl(p.change_cents) %></td></tr>
        <% } %>
      <% }) %>
    <% } else { %>
      <tr><td>Pagamento</td><td class="right"><%= { dinheiro: 'Dinheiro', cartao_debito: 'Débito', cartao_credito: 'Crédito', pix: 'PIX', prazo: 'A prazo' }[sale.payment_method] ?? sale.payment_method %></td></tr>
      <% if (sale.payment_method === 'dinheiro' && sale.paid_cents != null) { %>
        <tr><td>Recebido</td><td class="right"><%= brl(sale.paid_cents) %></td></tr>
        <tr><td>Troco</td><td class="right"><%= brl(sale.change_cents) %></td></tr>
      <% } %>
    <% } %>
  </table>
  <hr />
  <p class="center muted">Obrigado pela preferência!</p>
  <%
    /* Versão em texto do MESMO cupom, para a impressora térmica ESC/POS.
       Fica escondida na página: o navegador continua usando o CSS acima, e o
       Electron envia este texto direto pela serial/rede (ver electron/hardware.ts). */
    const COLS = 48;
    const linha = (esq, dir) => {
      const a = String(esq ?? '');
      const b = String(dir ?? '');
      const espaco = Math.max(1, COLS - a.length - b.length);
      return a + ' '.repeat(espaco) + b;
    };
    const centro = (txt) => {
      const t = String(txt ?? '');
      if (t.length >= COLS) return t.slice(0, COLS);
      return ' '.repeat(Math.floor((COLS - t.length) / 2)) + t;
    };
    const separador = '-'.repeat(COLS);
    const cupom = [];
    cupom.push(centro(company.name));
    if (company.document) cupom.push(centro(company.document));
    if (company.address) cupom.push(centro(company.address));
    cupom.push(centro('Cupom nao fiscal'));
    cupom.push(separador);
    cupom.push(linha('Venda #' + sale.id, fmtDateTime(sale.created_at)));
    if (sale.status === 'cancelada') cupom.push('*** CANCELADA ***');
    if (sale.customer) cupom.push('Cliente: ' + sale.customer);
    cupom.push('Vendedor: ' + (sale.username ?? '-'));
    cupom.push(separador);
    items.forEach((i) => {
      cupom.push(String(i.product_name));
      cupom.push(linha('  ' + i.qty + ' x ' + brl(i.unit_price_cents), brl(i.total_cents)));
    });
    cupom.push(separador);
    cupom.push(linha('Subtotal', brl(sale.subtotal_cents)));
    if (sale.discount_cents > 0) cupom.push(linha('Desconto', '-' + brl(sale.discount_cents)));
    if (sale.surcharge_cents > 0) cupom.push(linha('Acrescimo', '+' + brl(sale.surcharge_cents)));
    cupom.push(linha('TOTAL', brl(sale.total_cents)));
    if (typeof payments !== 'undefined' && payments.length) {
      payments.forEach((p) => {
        cupom.push(linha(p.method_name, brl(p.amount_cents)));
        if (p.received_cents != null && p.change_cents > 0) {
          cupom.push(linha('Recebido / Troco', brl(p.received_cents) + ' / ' + brl(p.change_cents)));
        }
      });
    } else {
      const rotulo = { dinheiro: 'Dinheiro', cartao_debito: 'Debito', cartao_credito: 'Credito', pix: 'PIX', prazo: 'A prazo' }[sale.payment_method] ?? sale.payment_method;
      cupom.push(linha('Pagamento', rotulo));
      if (sale.payment_method === 'dinheiro' && sale.paid_cents != null) {
        cupom.push(linha('Recebido', brl(sale.paid_cents)));
        cupom.push(linha('Troco', brl(sale.change_cents)));
      }
    }
    cupom.push(separador);
    cupom.push(centro('Obrigado pela preferencia!'));
    cupom.push('');
    cupom.push('');
  %>
  <pre id="cupom-thermal" hidden><%= cupom.join('\n') %></pre>
  <div class="no-print">
    <button id="btn-imprimir">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Imprimir
    </button>
    <button id="btn-fechar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
      Fechar
    </button>
  </div>
  <script nonce="<%= cspNonce %>">
    /*
      Ordem de impressão: ESC/POS primeiro (quando o Kivo está no desktop e a térmica
      está ligada em Configurações › Periféricos), diálogo do navegador como reserva.
      A ponte `window.kivo` só existe no Electron; no celular pela rede local cai
      direto no window.print(), como antes.
    */
    (function () {
      async function imprimir() {
        var pre = document.getElementById('cupom-thermal');
        var hw = window.kivo && window.kivo.hardware;
        if (hw && pre && typeof hw.print === 'function') {
          try {
            var r = await hw.print({ text: pre.textContent || '' });
            if (r && r.ok) return;
          } catch (e) { /* sem impressora: segue para o diálogo */ }
        }
        window.print();
      }
      window.addEventListener('load', function () { setTimeout(imprimir, 300); });
      // Por addEventListener: a CSP recusa `onclick="..."` no HTML (nonce vale para a tag
      // `script`, não para atributo de evento) e os botões ficariam sem reação nenhuma.
      document.getElementById('btn-imprimir')?.addEventListener('click', imprimir);
      document.getElementById('btn-fechar')?.addEventListener('click', function () { window.close(); });
    })();
  </script>
</body>
</html>
