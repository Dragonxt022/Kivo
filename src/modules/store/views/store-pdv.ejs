<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — PDV</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="stylesheet" href="/css/pdv.css" />
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
  <style>
    .pdv-favorites { margin: .5rem 0 1rem; }
    .pdv-favorites h3 { font-size: .8rem; text-transform: uppercase; color: var(--text-muted); margin: 0 0 .5rem; }
    .pdv-favorites-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: .5rem; }
    .pdv-fav { display: flex; flex-direction: column; align-items: center; gap: .25rem; padding: .6rem .4rem; cursor: pointer;
      background: var(--surface); border: 1.5px solid var(--border-light); border-radius: var(--radius); text-align: center; }
    .pdv-fav:hover { border-color: var(--primary); }
    .pdv-fav img { width: 42px; height: 42px; object-fit: cover; border-radius: 6px; }
    .pdv-fav span { font-size: .78rem; line-height: 1.15; }
    .pdv-customer-suggest { position: relative; }
    .pdv-customer-list { position: absolute; z-index: 30; left: 0; right: 0; background: var(--surface);
      border: 1px solid var(--border-light); border-radius: var(--radius); box-shadow: var(--shadow-xs); max-height: 240px; overflow: auto; }
    .pdv-customer-list button { display: flex; justify-content: space-between; width: 100%; padding: .4rem .6rem; background: none; border: 0; cursor: pointer; text-align: left; }
    .pdv-customer-list button:hover { background: var(--border-light); }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/store/pdv' }) %>
  <main x-data="pdvPage()" x-init="init()">
    <div class="pdv">

      <!-- ─── COLUNA ESQUERDA (carrinho) ─── -->
      <div class="pdv-left">
        <div class="sale-tabs-bar" id="tour-pdv-abas">
          <div class="sale-tabs">
            <template x-for="(s, idx) in slots" :key="idx">
              <div class="sale-tab" :class="{ active: idx === activeSlot }" @click="switchSlot(idx)"
                   @dblclick.stop="renameSlot(idx)" :title="'Duplo clique para nomear a venda' + (s.label ? ' (atual: ' + s.label + ')' : '')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                <span class="sale-tab-info">
                  <span class="sale-tab-name" x-text="s.label || ('Venda ' + String(idx + 1).padStart(2, '0'))"></span>
                  <span class="sale-tab-count" x-text="s.cart.length + (s.cart.length === 1 ? ' item' : ' itens')"></span>
                </span>
                <button type="button" class="close-tab" x-show="slots.length > 1" @click.stop="closeSlot(idx)" title="Fechar esta venda">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </div>
            </template>
          </div>
          <button type="button" class="sale-tab-add-btn" @click="addSlot()" title="Nova venda simultânea" x-show="slots.length < 4">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nova venda
          </button>
        </div>

        <div class="pdv-comanda-banner" x-show="slots[activeSlot].comandaId" x-cloak style="display:flex;align-items:center;gap:.5rem;padding:.6rem .9rem;margin-bottom:.75rem;border-radius:var(--radius);background:var(--primary-light,#eafaf0);border:1.5px solid var(--primary)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span x-text="'Fechando Comanda #' + slots[activeSlot].comandaId + (slots[activeSlot].tableLabel ? (' — ' + slots[activeSlot].tableLabel) : '')" style="flex:1;font-weight:600"></span>
          <button type="button" class="btn secondary small" @click="openBrowse()" title="Adicionar produtos">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            Adicionar produtos
          </button>
          <button type="button" class="btn secondary small" @click="cancelComanda()">Cancelar</button>
        </div>

        <!-- Orçamento reaberto: diferente da comanda, a busca de produtos CONTINUA visível —
             poder acrescentar item ao reabrir é justamente o ponto de montar orçamento no PDV. -->
        <div class="pdv-quote-banner" x-show="slots[activeSlot].quoteId" x-cloak style="display:flex;align-items:center;gap:.5rem;padding:.6rem .9rem;margin-bottom:.75rem;border-radius:var(--radius);background:var(--warning-bg,#fff8e6);border:1.5px solid var(--warning-text,#b7791f)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
          <span x-text="'Orçamento #' + slots[activeSlot].quoteId + (slots[activeSlot].quoteLabel ? (' — ' + slots[activeSlot].quoteLabel) : '')" style="flex:1;font-weight:600"></span>
          <% if (user.permissions.has('store.quotes.edit')) { %>
          <button type="button" class="btn secondary small" @click="openQuoteDlg()" title="Salvar as alterações no orçamento">Salvar alterações</button>
          <% } %>
          <button type="button" class="btn secondary small" @click="detachQuote()" title="Voltar a ser uma venda normal">Descartar</button>
        </div>

        <div class="pdv-search" x-show="!slots[activeSlot].comandaId">
          <div class="pdv-search-box" id="tour-pdv-busca">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" x-ref="search" x-model="q"
                   @input.debounce.250ms="search()"
                   @keydown.enter.prevent="quickAdd()"
                   @keydown.down.prevent="highlightNext()"
                   @keydown.up.prevent="highlightPrev()"
                   @keydown.escape="results = []"
                   placeholder="Código de barras, SKU ou nome do produto…" autofocus />
            <button type="button" class="pdv-search-scan-btn" @click="openBrowse()" title="Adicionar produtos do catálogo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"/><line x1="7" y1="5" x2="7" y2="19"/><line x1="11" y1="5" x2="11" y2="19"/><line x1="16" y1="5" x2="16" y2="19"/>
              </svg>
            </button>
          </div>

          <div class="pdv-results" x-show="results.length" x-cloak>
            <template x-for="(p, idx) in results" :key="p.id">
              <div class="pdv-result" :class="{ 'highlight': idx === highlightIdx }"
                   @click="add(p)" @mouseenter="highlightIdx = idx">
                <span class="pdv-result-thumb">
                  <img x-show="p.image_url" :src="p.image_url" alt="" />
                  <template x-if="!p.image_url"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg></template>
                </span>
                <span class="name">
                  <span x-text="p.name"></span>
                  <span class="kitchen-tag" x-show="p.goes_to_kitchen" x-cloak>Cozinha</span>
                </span>
                <span class="price" x-text="brl(p.price_cents)"></span>
                <span class="stock" :class="{ low: p.track_stock && p.stock_qty <= 3 && p.stock_qty >= 0, negative: p.track_stock && p.stock_qty < 0 }"
                      x-show="p.track_stock" x-text="'Est: ' + p.stock_qty"></span>
              </div>
            </template>
          </div>
          <p class="pdv-empty" x-show="q && !results.length && !searching" x-cloak>Nenhum produto encontrado.</p>
        </div>

        <div class="cart-header">
          <h2>Carrinho <span class="count" x-text="'(' + cart.length + ')'"></span></h2>
          <%# Cliente não é obrigatório e não exige cadastro: digitar um nome qualquer já
              identifica a venda no histórico. Se o nome digitado bater com um cliente
              cadastrado, o vínculo (customerId) é feito sozinho e volta a valer tabela de
              preço, crédito de loja, fidelidade e convênio. %>
          <div class="pdv-customer-suggest" @click.outside="customerSuggestions = []">
            <div class="cart-customer" id="tour-pdv-cliente" :class="customerId ? 'linked' : ''">
              <span class="cart-customer-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </span>
              <input type="text" list="pdv-customer-list" x-model="customerName" @input.debounce.250ms="onCustomerInput()"
                     @keydown.escape="customerSuggestions = []"
                     maxlength="120" autocomplete="off" spellcheck="false"
                     placeholder="Cliente (opcional)" title="Busque por nome, CPF/telefone ou digite um nome livre" />
              <button type="button" class="cart-customer-clear" x-show="customerName" x-cloak
                      @click="customerName = ''; onCustomerNameInput(); customerSuggestions = []" title="Limpar cliente">×</button>
              <% if (user.permissions.has('commercial.customers.create')) { %>
              <button type="button" class="cart-customer-clear" @click="openCustomerDlg()" title="Cadastrar novo cliente">+</button>
              <% } %>
              <datalist id="pdv-customer-list">
                <template x-for="c in customers" :key="c.id"><option :value="c.name"></option></template>
              </datalist>
            </div>
            <div class="pdv-customer-list" x-show="customerSuggestions.length" x-cloak>
              <template x-for="c in customerSuggestions" :key="'cs' + c.id">
                <button type="button" @click="pickCustomer(c)">
                  <span x-text="c.name"></span>
                  <span class="muted text-xs" x-text="c.document || c.phone || ''"></span>
                </button>
              </template>
            </div>
          </div>
        </div>

        <div class="pdv-favorites" x-show="!cart.length && !slots[activeSlot].comandaId && favorites.length" x-cloak>
          <h3>Acesso rápido</h3>
          <div class="pdv-favorites-grid">
            <template x-for="f in favorites" :key="'fav' + f.id">
              <button type="button" class="pdv-fav" @click="add(f)">
                <img x-show="f.image_url" :src="f.image_url" alt="" />
                <span x-text="f.name"></span>
                <span class="kitchen-tag" x-show="f.goes_to_kitchen" x-cloak>Cozinha</span>
                <span class="muted" x-text="brl(f.price_cents)"></span>
              </button>
            </template>
          </div>
        </div>

        <div class="cart-items" id="tour-pdv-carrinho">
          <template x-for="(i, idx) in cart" :key="idx">
            <div class="cart-line" :class="{ 'cart-line-complement': i.lineGroupUuid && idx > 0 && cart[idx - 1]?.lineGroupUuid === i.lineGroupUuid }">
              <div class="cart-line-thumb">
                <img x-show="i.image_url" :src="i.image_url" alt="" />
                <template x-if="!i.image_url">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
                </template>
              </div>
              <div>
                <div class="prod-name" style="display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">
                  <span x-text="i.name"></span>
                  <span class="kitchen-tag" :class="{ sent: i.kitchenSent === true }"
                        x-show="i.goesToKitchen" x-cloak x-text="kitchenStatusLabel(i)"></span>
                </div>
                <div class="prod-unit" x-text="(i.sku ? ('SKU: ' + i.sku + ' · ') : '') + brl(i.price_cents) + ((i.unit || 'un') === 'un' ? ' un.' : ' / ' + i.unit)"></div>
                <div class="prod-notes" x-show="i.notes" x-text="i.notes"></div>
                <button type="button" class="prod-note-btn"
                        x-show="!slots[activeSlot].comandaId && !(i.lineGroupUuid && idx > 0 && cart[idx-1]?.lineGroupUuid === i.lineGroupUuid)"
                        @click="openNoteDlg(idx)">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  <span x-text="i.notes ? 'Editar observação' : 'Observação'"></span>
                </button>
                <button type="button" class="prod-note-btn" x-show="canDiscount && !slots[activeSlot].comandaId"
                        @click="openPriceDlg(idx)" title="Alterar o preço deste item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                  <span x-text="i.priceOverridden ? 'Preço alterado' : 'Alterar preço'"></span>
                </button>
              </div>
              <div class="qty-wrap" x-show="!slots[activeSlot].comandaId">
                <button type="button" @click="qtyMinus(idx)" :disabled="i.qty <= 0.001" title="Diminuir quantidade">−</button>
                <button type="button" class="qty-open-btn" @click="openQtyDlg(idx)"
                        :title="'Alterar quantidade de ' + i.name"
                        :aria-label="'Alterar quantidade de ' + i.name"
                        x-text="fmtQty(i.qty)"></button>
                <button type="button" @click="qtyPlus(idx)" title="Aumentar quantidade">+</button>
              </div>
              <span class="qty-wrap" x-show="slots[activeSlot].comandaId" x-text="i.qty"></span>
              <span class="prod-total" x-text="brl(Math.round(i.price_cents * i.qty))"></span>
              <button class="remove-btn" @click="removeItem(idx)" title="Remover" x-show="!slots[activeSlot].comandaId">×</button>
            </div>
          </template>

          <div class="cart-empty" x-show="!cart.length">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <p>Carrinho vazio — busque ou bipe um produto para começar.</p>
          </div>
        </div>

        <div class="cart-footer-note" x-show="cart.length" x-cloak>
          <span class="cart-added-note">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span x-text="cart.length + (cart.length === 1 ? ' item adicionado' : ' itens adicionados')"></span>
          </span>
          <button type="button" class="cart-clear-link" @click="clearCart()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Limpar carrinho
          </button>
        </div>
      </div>

      <!-- ─── COLUNA DA DIREITA (resumo) ─── -->
      <div class="pdv-right">
        <div class="pdv-card">
          <h2>Resumo da venda</h2>

          <div class="pdv-scroll-body">
          <div class="pdv-totals">
            <div class="pdv-total-row">
              <span class="label">Subtotal</span>
              <span class="value" x-text="brl(subtotal())"></span>
            </div>
            <div class="pdv-total-row discount" x-show="discountCents > 0">
              <span class="label">Desconto</span>
              <span class="value" x-text="'−' + brl(discountCents)"></span>
            </div>
            <div class="pdv-total-row surcharge" x-show="surchargeCents > 0">
              <span class="label">Acréscimo</span>
              <span class="value" x-text="'+' + brl(surchargeCents)"></span>
            </div>
            <div class="pdv-total-row final">
              <span class="label">Total</span>
              <span class="value" x-text="brl(total())"></span>
            </div>
            <div class="pdv-total-row remaining" x-show="cart.length" x-cloak>
              <span class="label">Restante</span>
              <span class="value" x-text="brl(total())"></span>
            </div>
          </div>

          <div class="pdv-sale-info">
            <div class="pdv-sale-info-head">
              <span>Detalhes da venda</span>
              <span class="pdv-sale-chip" x-text="slots[activeSlot].label || ('Venda ' + String(activeSlot + 1).padStart(2, '0'))"></span>
            </div>
            <div class="pdv-meta-grid">
              <div class="pdv-meta">
                <span class="pdv-meta-icon" style="--meta-color:#3DA5F4">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                </span>
                <div><small>Itens</small><strong x-text="cart.length"></strong></div>
              </div>
              <div class="pdv-meta">
                <span class="pdv-meta-icon" style="--meta-color:#8B7CF6">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <div><small>Cliente</small><strong x-text="customerName || 'Consumidor'"></strong></div>
              </div>
              <div class="pdv-meta">
                <span class="pdv-meta-icon" style="--meta-color:#F5A623">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <div><small>Operador</small><strong><%= user.username %></strong></div>
              </div>
              <div class="pdv-meta">
                <span class="pdv-meta-icon" style="--meta-color:#34D399">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                </span>
                <div><small>Pagamento</small><strong x-text="cart.length ? 'Pendente' : '—'"></strong></div>
              </div>
            </div>
          </div>

          <div class="pdv-flow">
            <div class="pdv-flow-title">Fluxo da venda</div>
            <div class="pdv-step" :class="{ done: cart.length }">
              <span class="pdv-step-dot">1</span>
              <div><strong>Produtos</strong><small x-text="cart.length ? cart.length + (cart.length === 1 ? ' item' : ' itens') : 'Bipe ou busque'"></small></div>
            </div>
            <div class="pdv-step" :class="{ done: !!customerName }">
              <span class="pdv-step-dot">2</span>
              <div><strong>Cliente</strong><small x-text="customerName || 'Opcional'"></small></div>
            </div>
            <div class="pdv-step" :class="{ active: cart.length && !error }">
              <span class="pdv-step-dot">3</span>
              <div><strong>Pagamento</strong><small>Use F2 para finalizar</small></div>
            </div>
          </div>

          <div class="pdv-tip">
            <span class="pdv-tip-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/></svg>
            </span>
            <p x-show="!cart.length">Bipe um produto ou use a busca para começar a venda.</p>
            <p x-show="cart.length && !customerName">Venda em andamento. Selecione o cliente se quiser pontos, convênio ou crediário.</p>
            <p x-show="cart.length && customerName">Tudo pronto. Toque em <strong>Adicionar pagamento</strong> ou use <strong>F2</strong>.</p>
          </div>
          </div>

          <div class="pdv-checkout-footer">
          <button type="button" class="pdv-kitchen-btn" x-show="hasKitchenItems()" x-cloak
                  :disabled="!hasKitchenPending() || sendingKitchen"
                  @click="sendToKitchen()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            <span x-text="sendingKitchen ? 'Enviando…' : kitchenSendLabel()"></span>
          </button>
          <div class="pdv-actions" id="tour-pdv-acoes">
            <button type="button" class="pdv-action" style="--action-color:#3DA5F4" @click="printLast()"
                    :disabled="!lastSaleId" title="Imprimir última venda (F11)" aria-label="Imprimir última venda">
              <span class="pdv-action-icon"><svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg></span>
            </button>
            <%# Calculadora: F3 estava livre entre os atalhos do PDV, e conferir troco ou
                somar algo à parte é conta que o operador hoje faz no papel ou no celular. %>
            <button type="button" class="pdv-action" style="--action-color:#94A3B8" @click="abrirCalculadora()"
                    title="Calculadora (F3)" aria-label="Abrir calculadora">
              <span class="pdv-action-icon"><svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="11" x2="8" y2="11"/><line x1="12" y1="11" x2="12" y2="11"/><line x1="16" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="8" y2="15"/><line x1="12" y1="15" x2="12" y2="15"/><line x1="16" y1="15" x2="16" y2="19"/><line x1="8" y1="19" x2="12" y2="19"/></svg></span>
            </button>
            <button type="button" class="pdv-action" style="--action-color:#F2542D" @click="clearCart()" title="Limpar carrinho (F9)" aria-label="Limpar carrinho">
              <span class="pdv-action-icon"><svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></span>
            </button>
            <% if (user.permissions.has('store.quotes.create')) { %>
            <button type="button" class="pdv-action" style="--action-color:#8B7CF6" @click="openQuoteDlg()"
                    :disabled="!cart.length" title="Salvar como orçamento (F6)" aria-label="Salvar como orçamento">
              <span class="pdv-action-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg></span>
            </button>
            <% } %>
            <% if (user.permissions.has('store.sales.discount')) { %>
            <button type="button" class="pdv-action" style="--action-color:#F5C344" @click="openValue('acrescimo')" title="Acréscimo (F7)" aria-label="Aplicar acréscimo">
              <span class="pdv-action-icon"><svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
            </button>
            <button type="button" class="pdv-action" style="--action-color:#34D399" @click="openValue('desconto')" title="Desconto (F4)" aria-label="Aplicar desconto">
              <span class="pdv-action-icon"><svg viewBox="0 0 24 24"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg></span>
            </button>
            <% } %>
          </div>

          <div class="pdv-error" x-show="error" x-text="error"></div>

          <button class="btn-finalize" id="tour-pdv-finalizar" :disabled="!cart.length" @click="openPay()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            Adicionar pagamento
          </button>
          </div>
        </div>
      </div>
    </div>

    <%# Atalho fixo do celular: o resumo fica no fim da página, então sem esta barra o
        pagamento só aparecia depois de rolar o carrinho inteiro. Ela fica acima da
        navegação inferior (que ocupa a base da tela). %>
    <div class="pdv-mobile-bar" x-show="cart.length" x-cloak>
      <div class="pdv-mobile-bar-total">
        <span>Total</span>
        <strong x-text="brl(total())"></strong>
      </div>
      <button type="button" class="btn-finalize" @click="openPay()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        Pagamento
      </button>
    </div>
    <div class="pdv-mobile-bar-spacer" x-show="cart.length" x-cloak></div>

    <div class="pdv-footer-bar">
      <div class="pdv-footer-shortcuts" id="tour-pdv-atalhos">
        <span><kbd>F2</kbd>Pagamento</span>
        <span><kbd>F3</kbd>Calculadora</span>
        <% if (user.permissions.has('store.sales.discount')) { %>
        <span><kbd>F4</kbd>Desconto</span>
        <span><kbd>F7</kbd>Acréscimo</span>
        <% } %>
        <% if (user.permissions.has('store.quotes.create')) { %>
        <span><kbd>F6</kbd>Orçamento</span>
        <% } %>
        <span><kbd>F9</kbd>Limpar</span>
        <span><kbd>F11</kbd>Imprimir</span>
      </div>
      <div class="pdv-footer-status">
        <span class="pdv-status-dot" :class="{ online: cloudOnline }"></span>
        <span x-text="cloudOnline ? 'PDV Online' : 'PDV Offline'"></span>
        <span class="pdv-footer-sep" x-show="pendingSync > 0">|</span>
        <span x-show="pendingSync > 0" :title="'Vendas e cadastros ainda não enviados para a nuvem'" x-text="pendingSync + ' pendente(s) de sync'"></span>
        <span class="pdv-footer-sep">|</span>
        <button type="button" class="btn secondary small" id="tour-rever" title="Rever o tour guiado do PDV">Rever tour</button>
        <span class="pdv-footer-sep">|</span>
        <button type="button" class="btn secondary small" @click="toggleFullscreen()" title="Alternar tela cheia">Tela cheia</button>
        <span class="pdv-footer-sep">|</span>
        <span>Versão <%= appVersion %></span>
      </div>
    </div>

    <!-- ─── MODAL: Adicionar/consultar produtos ─── -->
    <dialog x-ref="browse" style="width:min(1100px, 94vw)">
      <h1>Adicionar produtos</h1>
      <input type="text" x-ref="browseInput" x-model="browseQ" @input.debounce.250ms="searchBrowse()"
             placeholder="Buscar por nome, código de barras ou SKU…" />

      <!-- A API já devolve image_url das categorias; o chip mostra a imagem quando
           existe e cai num ícone neutro quando não — reconhecer por imagem é mais
           rápido que ler, e num PDV velocidade é o produto. -->
      <div class="pdv-browse-cats" x-show="browseCategories.length">
        <button type="button" class="pdv-cat-chip" :class="{ active: !browseCategoryId }" @click="browseCategoryId = ''">
          <span class="pdv-cat-thumb all">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          </span>
          <span>Todas</span>
        </button>
        <template x-for="c in browseCategories" :key="c.id">
          <button type="button" class="pdv-cat-chip" :class="{ active: browseCategoryId === c.id }"
                  @click="browseCategoryId = browseCategoryId === c.id ? '' : c.id">
            <span class="pdv-cat-thumb">
              <!-- @error: imagem apagada/URL quebrada cairia no glifo de "imagem
                   quebrada" do navegador. Zerando image_url, o Alpine re-renderiza
                   no ícone neutro — o chip nunca fica feio. -->
              <template x-if="c.image_url">
                <img :src="c.image_url" :alt="c.name" loading="lazy" @error="c.image_url = null" />
              </template>
              <template x-if="!c.image_url">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
              </template>
            </span>
            <span x-text="c.name"></span>
          </button>
        </template>
      </div>

      <div class="prod-toolbar">
        <span class="muted text-sm" x-text="browseFiltered().length + (browseFiltered().length === 1 ? ' produto' : ' produtos')"></span>
        <div class="prod-view-toggle" role="group" aria-label="Modo de visualização">
          <button type="button" class="prod-view-btn" :class="{ active: productView === 'grid' }"
                  @click="productView = 'grid'" title="Ver em grade" aria-label="Ver em grade">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          </button>
          <button type="button" class="prod-view-btn" :class="{ active: productView === 'list' }"
                  @click="productView = 'list'" title="Ver em lista" aria-label="Ver em lista">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/></svg>
          </button>
        </div>
      </div>

      <div class="prod-grid" x-show="productView === 'grid'">
        <template x-for="p in browseFiltered()" :key="p.id">
          <button type="button" class="prod-card" @click="add(p).then(() => $refs.browse.close())">
            <span class="prod-thumb">
              <img x-show="p.image_url" :src="p.image_url" alt="" loading="lazy" />
              <template x-if="!p.image_url">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </template>
            </span>
            <span class="prod-name" x-text="p.name"></span>
            <span class="kitchen-tag" x-show="p.goes_to_kitchen" x-cloak style="align-self:flex-start">Cozinha</span>
            <span class="prod-meta">
              <span class="muted text-sm" x-show="p.category" x-text="p.category"></span>
              <span class="prod-stock"
                    :class="{ low: p.track_stock && p.stock_qty <= 3 && p.stock_qty >= 0, negative: p.track_stock && p.stock_qty < 0 }"
                    x-show="p.track_stock" x-text="'Est: ' + p.stock_qty"></span>
            </span>
            <span class="prod-price" x-text="brl(p.price_cents)"></span>
          </button>
        </template>
        <p class="pdv-empty" style="grid-column:1/-1" x-show="!browseFiltered().length">Nenhum produto encontrado.</p>
      </div>

      <div class="pdv-browse-list" x-show="productView === 'list'" x-cloak>
        <template x-for="p in browseFiltered()" :key="p.id">
          <div class="pdv-result" @click="add(p).then(() => $refs.browse.close())">
            <span class="pdv-result-thumb">
              <img x-show="p.image_url" :src="p.image_url" alt="" />
              <template x-if="!p.image_url"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg></template>
            </span>
            <span class="name">
              <span x-text="p.name"></span>
              <span class="kitchen-tag" x-show="p.goes_to_kitchen" x-cloak>Cozinha</span>
            </span>
            <span class="price" x-text="brl(p.price_cents)"></span>
            <span class="stock" :class="{ low: p.track_stock && p.stock_qty <= 3 && p.stock_qty >= 0, negative: p.track_stock && p.stock_qty < 0 }"
                  x-show="p.track_stock" x-text="'Est: ' + p.stock_qty"></span>
          </div>
        </template>
        <p class="pdv-empty" x-show="!browseFiltered().length">Nenhum produto encontrado.</p>
      </div>
      <p class="muted text-xs" style="margin-top:.5rem">Clique num item para adicioná-lo ao carrinho, ou só consulte o preço/estoque aqui.</p>
      <div class="actions">
        <button class="btn secondary" @click="$refs.browse.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Fechar (Esc)
        </button>
      </div>
    </dialog>

    <!-- ─── MODAL: Desconto / Acréscimo ─── -->
    <dialog x-ref="value">
      <h1 x-text="valueDlg.kind === 'desconto' ? 'Desconto (F4)' : 'Acréscimo (F7)'"></h1>
      <div class="flex-row" style="margin-bottom:.6rem">
        <button type="button" class="btn secondary" :class="{ active: valueDlg.mode === 'valor' }" @click="setValueMode('valor')" style="flex:1">R$</button>
        <button type="button" class="btn secondary" :class="{ active: valueDlg.mode === 'percentual' }" @click="setValueMode('percentual')" style="flex:1">%</button>
      </div>
      <label x-text="valueDlg.mode === 'valor' ? 'Valor em R$' : 'Percentual (%)'"></label>
      <input type="text" x-ref="valueInput" x-model="valueDlg.amount"
             :placeholder="valueDlg.mode === 'valor' ? '0,00' : '0'"
             @input="valueDlg.amount = valueDlg.mode === 'valor' ? maskMoney(valueDlg.amount) : valueDlg.amount.replace(/[^0-9,]/g, '')"
             @keydown.enter.prevent="saveValue()" @keydown.escape.prevent="$refs.value.close()" />
      <p class="muted text-xs" x-show="valueDlg.mode === 'percentual' && valueDlg.amount" x-text="'≈ ' + brl(percentToCents(valueDlg.amount))"></p>
      <label>Motivo</label>
      <input type="text" x-model="valueDlg.reason" maxlength="200" placeholder="Ex.: cliente antigo, promoção" />
      <div x-show="valueDlg.needPin" x-cloak>
        <label>PIN do administrador</label>
        <input type="password" inputmode="numeric" maxlength="6" x-model="valueDlg.pin" />
        <p class="hint">Desconto acima de <strong x-text="maxDiscountPct()"></strong>% exige autorização.</p>
      </div>
      <div class="error" x-text="valueDlg.error"></div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.value.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar (Esc)
        </button>
        <button class="btn" @click="saveValue()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Aplicar (Enter)
        </button>
      </div>
    </dialog>

    <!-- ─── MODAL: Observação do item ─── -->
    <dialog x-ref="noteDlg">
      <h1>Observação do item</h1>
      <p class="muted" style="margin-top:-.3rem">Ex.: sem cebola, com provolone, ponto da carne…</p>
      <textarea x-ref="noteInput" x-model="noteDlg.text" rows="3"
                placeholder="Digite a observação para a cozinha/balcão"
                @keydown.enter.meta.prevent="saveNote()" @keydown.escape.prevent="$refs.noteDlg.close()"
                style="width:100%"></textarea>
      <div class="actions">
        <button class="btn secondary" @click="$refs.noteDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar (Esc)
        </button>
        <button class="btn" @click="saveNote()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Salvar
        </button>
      </div>
    </dialog>

    <!-- ─── MODAL: Quantidade (teclado grande + teclado físico) ─── -->
    <dialog x-ref="qtyDlg" style="width:min(430px,94vw)" @close="qtyDlg.idx = null"
            @keydown="qtyKeyboard($event)">
      <h1>Quantidade</h1>
      <p class="muted" style="margin:-.25rem 0 .5rem" x-text="qtyDlg.name"></p>
      <div class="qty-dlg-display" :class="{ 'has-error': !!qtyDlg.error }">
        <span x-text="qtyDlg.raw || '0'"></span>
        <span class="qty-dlg-unit" x-text="qtyDlg.unit || 'un'"></span>
      </div>
      <p class="muted text-xs qty-dlg-hint"
         x-text="(qtyDlg.fractional ? 'Aceita vírgula ou ponto — ex.: 0,240' : 'Esta unidade só aceita quantidade inteira.') + ' · Enter salva'"></p>
      <div class="qty-dlg-error" x-text="qtyDlg.error"></div>
      <div class="qty-keypad">
        <button type="button" @click="qtyKey('7')">7</button>
        <button type="button" @click="qtyKey('8')">8</button>
        <button type="button" @click="qtyKey('9')">9</button>
        <button type="button" @click="qtyKey('4')">4</button>
        <button type="button" @click="qtyKey('5')">5</button>
        <button type="button" @click="qtyKey('6')">6</button>
        <button type="button" @click="qtyKey('1')">1</button>
        <button type="button" @click="qtyKey('2')">2</button>
        <button type="button" @click="qtyKey('3')">3</button>
        <button type="button" @click="qtyKey(',')" :disabled="!qtyDlg.fractional" title="Vírgula decimal">,</button>
        <button type="button" @click="qtyKey('0')">0</button>
        <button type="button" @click="qtyBackspace()" title="Apagar último dígito">⌫</button>
      </div>
      <div class="qty-dlg-steps">
        <button type="button" @click="qtyStep(-1)">−1</button>
        <button type="button" @click="qtyStep(-0.1)" :disabled="!qtyDlg.fractional">−0,1</button>
        <button type="button" @click="qtyStep(0.1)" :disabled="!qtyDlg.fractional">+0,1</button>
        <button type="button" @click="qtyStep(1)">+1</button>
      </div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="$refs.qtyDlg.close()">Cancelar</button>
        <button type="button" class="btn" @click="saveQtyDlg()">Salvar quantidade</button>
      </div>
    </dialog>

    <!-- ─── MODAL: Alterar preço do item ─── -->
    <dialog x-ref="priceDlg">
      <h1>Alterar preço do item</h1>
      <p class="muted" x-text="cart[priceDlg.idx]?.name || ''"></p>
      <label>Preço unitário (R$)</label>
      <input type="text" x-ref="priceInput" x-model="priceDlg.value" @input="priceDlg.value = maskMoney(priceDlg.value)"
             @keydown.enter.prevent="savePriceDlg()" @keydown.escape.prevent="$refs.priceDlg.close()" />
      <p class="muted text-xs">Preço de catálogo: <span x-text="brl(priceDlg.original || 0)"></span></p>
      <div class="error" x-text="priceDlg.error"></div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.priceDlg.close()">Cancelar (Esc)</button>
        <button class="btn" @click="savePriceDlg()">Aplicar (Enter)</button>
      </div>
    </dialog>

    <!-- ─── MODAL: Nomear a venda ─── -->
    <dialog x-ref="renameDlg">
      <h1>Nome desta venda</h1>
      <p class="muted" style="margin-top:-.3rem">
        Deixe vazio para voltar a
        <strong x-text="'Venda ' + String((renameDlg.idx ?? 0) + 1).padStart(2, '0')"></strong>.
      </p>
      <input type="text" x-ref="renameInput" x-model="renameDlg.value" maxlength="40"
             placeholder="Ex.: Mesa 4, Cliente João…"
             @keydown.enter.prevent="saveRenameSlot()" @keydown.escape.prevent="$refs.renameDlg.close()" />
      <div class="actions">
        <button class="btn secondary" @click="$refs.renameDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar (Esc)
        </button>
        <button class="btn" @click="saveRenameSlot()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Salvar (Enter)
        </button>
      </div>
    </dialog>

    <% if (user.permissions.has('commercial.customers.create')) { %>
    <!-- ─── MODAL: Cadastro rápido de cliente ─── -->
    <dialog x-ref="customerDlg">
      <h1>Novo cliente</h1>
      <div class="dialog-body">
        <label>Nome</label><input type="text" x-model="customerDlg.name" />
        <label>CPF/CNPJ</label><input type="text" x-model="customerDlg.document" @input="customerDlg.document = maskDoc(customerDlg.document)" placeholder="000.000.000-00" />
        <label>Telefone</label><input type="text" x-model="customerDlg.phone" @input="customerDlg.phone = maskPhone(customerDlg.phone)" placeholder="(00) 00000-0000" />
        <div class="error" x-text="customerDlg.error"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.customerDlg.close()">Cancelar</button>
        <button class="btn" @click="saveCustomerDlg()" :disabled="customerDlg.saving" x-text="customerDlg.saving ? 'Salvando…' : 'Cadastrar e vincular'"></button>
      </div>
    </dialog>
    <% } %>

    <!-- ─── MODAL: Limpar carrinho (F9) ─── -->
    <dialog x-ref="clearDlg">
      <div class="dialog-body-center">
        <div class="dialog-icon dialog-icon-danger">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
            <path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
          </svg>
        </div>
        <h2 class="dialog-heading-md">Limpar carrinho?</h2>
        <p class="dialog-muted">
          Todos os itens, descontos e acréscimos serão removidos.
        </p>
        <div class="actions actions-center">
          <button class="btn secondary" @click="$refs.clearDlg.close()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
            Não (Esc)
          </button>
          <button class="btn" @click="doClear()" x-ref="clearConfirm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Sim (Enter)
          </button>
        </div>
      </div>
    </dialog>

    <!-- ─── MODAL: Confirmação por PIN (remover item do carrinho) ─── -->
    <dialog x-ref="pinDlg">
      <h1>PIN de administrador</h1>
      <p class="muted" style="margin-top:-.3rem">Digite o PIN para confirmar a remoção do item.</p>
      <input type="password" inputmode="numeric" maxlength="6" x-model="pinInput" x-ref="pinInput"
             @keydown.enter.prevent="confirmPinRemove()" placeholder="PIN" />
      <div class="error" x-text="pinError"></div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.pinDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn" @click="confirmPinRemove()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Confirmar
        </button>
      </div>
    </dialog>

    <!-- ─── MODAL: Pagamento ─── -->
    <dialog x-ref="pay" class="pay-modal">
      <div class="pay-left">
        <header class="pay-header">
          <div class="pay-total-block">
            <span class="pay-total-label">Total da venda</span>
            <div class="pay-total-value" x-text="brl(total())"></div>
            <span class="pay-total-items" x-text="cart.length + (cart.length === 1 ? ' item' : ' itens')"></span>
          </div>
          <button type="button" class="pay-close-btn" @click="$refs.pay.close()" aria-label="Fechar pagamento" title="Fechar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </header>

        <section class="pay-step">
          <span class="pay-step-label">Forma de pagamento</span>
          <%# Um único seletor: os cartões abaixo. O <select> e o botão "Adicionar" que
              ficavam ao lado foram removidos — eram o mesmo controle duas vezes. %>
          <div class="pay-quick-methods">
            <template x-for="(m, idx) in visibleQuickMethods()" :key="'q' + m.id">
              <button type="button" class="pay-quick-method"
                      :class="{ selected: pay.methodId === m.id, blocked: !!quickMethodBlock(m) }"
                      :disabled="!!quickMethodBlock(m)"
                      :title="quickMethodBlock(m) ? m.name + ' — ' + quickMethodBlock(m) : m.name"
                      @click="selectQuickMethod(m)">
                <span class="pay-method-icon" x-html="methodIcon(m.type)"></span>
                <span class="pay-method-name" x-text="m.name"></span>
                <span class="shortcut" x-show="idx < 9 && !quickMethodBlock(m)" x-text="'F' + (idx + 1)"></span>
                <span class="pay-method-block" x-show="!!quickMethodBlock(m)" x-text="quickMethodBlock(m)"></span>
                <span class="pay-method-check" x-show="pay.methodId === m.id" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
              </button>
            </template>
          </div>
        </section>

        <%# Os campos mudam com a modalidade, mas o valor recebido em dinheiro é o único
            que pede um campo próprio: nele o operador digita o que o cliente entregou,
            não a parcela. O troco/restante fica logo abaixo, atualizando a cada tecla. %>
        <div class="pay-method-panel" x-show="selectedType() === 'dinheiro'" x-cloak>
          <label class="pay-field-label" for="pay-received">Valor recebido</label>
          <div class="pay-money-box pay-money-box--cash">
            <span class="prefix">R$</span>
            <input id="pay-received" type="text" inputmode="decimal" x-model="pay.received"
                   @input="onCashInput()"
                   @keydown.enter.prevent="remaining() === 0 ? finish() : addPayment()"
                   placeholder="0,00" autocomplete="off" spellcheck="false" />
          </div>
          <div class="pay-cash-chips">
            <template x-for="(v, i) in cashSuggestions()" :key="'cash' + v">
              <button type="button" class="pay-cash-chip" :class="{ exact: i === 0 }"
                      @click="setCashSuggestion(v)"
                      x-text="i === 0 ? 'Exato · ' + brl(v) : brl(v)"></button>
            </template>
            <button type="button" class="pay-cash-chip pay-cash-chip--clear" x-show="pay.received" x-cloak
                    @click="pay.received = ''">Limpar</button>
          </div>
          <div class="pay-cash-feedback" :class="'is-' + cashFeedbackKind()" aria-live="polite">
            <span x-text="cashFeedbackLabel()"></span>
            <strong x-show="cashFeedbackValue() > 0" x-text="brl(cashFeedbackValue())"></strong>
            <span class="pay-cash-check" x-show="cashFeedbackKind() === 'exact'">✓</span>
          </div>
        </div>

        <%# PIX, cartões, convênio e crédito de loja compartilham o mesmo campo de valor.
            Só o rótulo, a dica e o texto do botão mudam com a modalidade selecionada. %>
        <div class="pay-method-panel" x-show="showsAmountField()" x-cloak>
          <label class="pay-field-label" for="pay-amount" x-text="amountFieldLabel()"></label>
          <div class="pay-money-box">
            <span class="prefix">R$</span>
            <input id="pay-amount" type="text" inputmode="decimal" x-model="pay.amount"
                   @input="onAmountInput()"
                   @keydown.enter.prevent="remaining() === 0 ? finish() : addPayment()"
                   placeholder="0,00" autocomplete="off" spellcheck="false" />
          </div>
          <p class="pay-field-hint" x-show="selectedType() === 'pix'">Confirme o recebimento no aplicativo e registre aqui.</p>
          <p class="pay-field-hint" x-show="selectedType() === 'credito_loja'"
             x-text="'Disponível: ' + brl(customerBalances.storeCreditCents || 0)"></p>
          <p class="pay-field-hint" x-show="selectedType() === 'convenio' && !customerId">Selecione um cliente com convênio ativo.</p>
          <p class="pay-field-hint" x-show="selectedFee() > 0" x-text="selectedFeeLabel()"></p>
        </div>

        <div class="pay-method-panel" x-show="selectedType() === 'prazo'" x-cloak>
          <template x-if="prazoPayment()">
            <div class="pay-registered-note">
              <div class="pay-registered-main">
                <strong x-text="prazoCustomerName()"></strong>
                <span x-text="prazoSummary()"></span>
              </div>
              <strong class="pay-registered-value" x-text="brl(prazoPayment().amountCents)"></strong>
              <button type="button" class="pay-action-btn pay-action-btn--compact" @click="openPrazoDlg()">Editar</button>
            </div>
          </template>
          <template x-if="!prazoPayment()">
            <div>
              <p class="pay-field-hint">Informe o cliente e o parcelamento para lançar a venda a prazo.</p>
              <button type="button" class="pay-action-btn" @click="openPrazoDlg()">Identificar cliente e parcelar</button>
            </div>
          </template>
        </div>

        <div class="pay-method-panel" x-show="selectedType() === 'fidelidade'" x-cloak>
          <template x-if="fidelidadePayment()">
            <div class="pay-registered-note">
              <div class="pay-registered-main">
                <strong x-text="(fidelidadePayment().pointsUsed || 0) + ' pontos'"></strong>
                <span x-text="'Saldo: ' + (customerBalances.loyaltyPoints || 0) + ' pontos'"></span>
              </div>
              <strong class="pay-registered-value" x-text="brl(fidelidadePayment().amountCents)"></strong>
              <button type="button" class="pay-action-btn pay-action-btn--compact" @click="openFidelidadeDlg()">Editar</button>
            </div>
          </template>
          <template x-if="!fidelidadePayment()">
            <div>
              <p class="pay-field-hint" x-text="(customerBalances.loyaltyPoints || 0) + ' pontos disponíveis'"></p>
              <button type="button" class="pay-action-btn" :disabled="!!quickMethodBlock(selectedMethod())"
                      @click="openFidelidadeDlg()">Usar pontos</button>
            </div>
          </template>
        </div>

        <%# A ação de lançar o pagamento fica FORA dos painéis para existir uma só, com o
            rótulo da modalidade. Em "a prazo" e fidelidade quem conduz é o diálogo próprio. %>
        <button type="button" class="pay-add-btn" x-show="showsAddButton()" x-cloak
                :disabled="!canAddPayment()" @click="addPayment()" x-text="addLabel()"></button>

        <%# O campo de cliente do carrinho fica atrás deste modal: quem já chegou ao pagamento
            não conseguia mais vincular ninguém, e só a venda a prazo — que tem diálogo próprio
            com seletor — acabava saindo com cliente. Sem vínculo não há pontos de fidelidade,
            convênio nem crédito de loja, mesmo à vista. É o mesmo estado do carrinho, não uma
            cópia: mexer aqui reprecifica e recarrega saldos exatamente como lá. Fica depois dos
            campos de pagamento para não competir com o valor. %>
        <section class="pay-customer-section">
          <span class="pay-label pay-customer-label">
            Cliente
            <span class="pay-required-badge" x-show="customerRequired()" x-cloak>obrigatório</span>
            <span class="pay-optional-badge" x-show="!customerRequired()">opcional</span>
          </span>
          <div class="pdv-customer-suggest" @click.outside="customerSuggestions = []">
            <div class="cart-customer pay-customer" :class="customerId ? 'linked' : ''">
              <span class="cart-customer-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </span>
              <input type="text" list="pay-customer-list" x-model="customerName" @input.debounce.250ms="onCustomerInput()"
                     @keydown.escape="customerSuggestions = []"
                     maxlength="120" autocomplete="off" spellcheck="false"
                     placeholder="Buscar cliente ou digitar um nome"
                     title="Escolha um cliente cadastrado para usar pontos, convênio e crédito de loja" />
              <button type="button" class="cart-customer-clear" x-show="customerName" x-cloak
                      @click="customerName = ''; onCustomerNameInput(); customerSuggestions = []" title="Limpar cliente">×</button>
              <%# Datalist próprio, dentro do <dialog>: o do carrinho fica na parte inerte da
                  página enquanto o modal está aberto, e não dá para depender de o navegador
                  resolver a lista a partir de lá. %>
              <datalist id="pay-customer-list">
                <template x-for="c in customers" :key="'pc' + c.id"><option :value="c.name"></option></template>
              </datalist>
            </div>
            <div class="pdv-customer-list" x-show="customerSuggestions.length" x-cloak>
              <template x-for="c in customerSuggestions" :key="'pcs' + c.id">
                <button type="button" @click="pickCustomer(c)">
                  <span x-text="c.name"></span>
                  <span class="muted text-xs" x-text="c.document || c.phone || ''"></span>
                </button>
              </template>
            </div>
          </div>
          <p class="pay-customer-required-hint" x-show="customerRequired() && !customerId" x-cloak>
            Selecione um cliente para esta forma de pagamento.
          </p>
          <p class="pay-customer-hint" x-show="customerId" x-cloak>
            <span x-show="(customerBalances.loyaltyPoints || 0) > 0" x-text="customerBalances.loyaltyPoints + ' pontos'"></span>
            <span x-show="(customerBalances.storeCreditCents || 0) > 0" x-text="'crédito ' + brl(customerBalances.storeCreditCents)"></span>
            <span x-show="customerBalances.hasAgreement">convênio ativo</span>
            <span x-show="!(customerBalances.loyaltyPoints || 0) && !(customerBalances.storeCreditCents || 0) && !customerBalances.hasAgreement">
              cliente vinculado — esta venda vai acumular pontos
            </span>
          </p>
          <p class="pay-customer-hint muted" x-show="!customerId && customerName.trim()" x-cloak>
            Nome livre: identifica a venda, mas não usa pontos nem convênio. Escolha um cliente da lista para isso.
          </p>
        </section>

        <div class="pay-secondary">
          <button type="button" class="pay-helper-chip" :class="{ active: showSplit }"
                  @click="showSplit = !showSplit; if (showSplit) $nextTick(() => $refs.splitInput?.focus())">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M8 3H3v5"/><path d="M21 3 3 21"/><path d="M16 21h5v-5"/></svg>
            Dividir conta
          </button>
          <button type="button" class="pay-helper-chip" @click="$refs.pay.close()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Voltar
          </button>
        </div>

        <div class="pay-helper-panel" x-show="showSplit" x-cloak>
          <div class="pay-helper-row">
            <span class="pay-helper-label">Dividir por</span>
            <div class="pay-stepper">
              <button type="button" @click="pay.split = Math.max(2, (pay.split || 2) - 1)" aria-label="Menos uma pessoa">−</button>
              <input type="number" min="2" max="20" x-ref="splitInput" x-model.number="pay.split" aria-label="Número de pessoas" />
              <button type="button" @click="pay.split = Math.min(20, (pay.split || 2) + 1)" aria-label="Mais uma pessoa">+</button>
            </div>
            <span class="pay-helper-label">pessoas</span>
            <button type="button" class="pay-helper-apply" @click="splitEqual()">Dividir</button>
          </div>
          <!-- Diz o que o botão FAZ (substitui a lista), não só quanto dá por pessoa. -->
          <p class="pay-helper-hint" x-show="pay.split >= 2"
             x-text="'Cria ' + pay.split + ' pagamentos de ~' + brl(Math.floor(total() / (pay.split || 1))) + ' em ' + methodName(pay.methodId) + ', substituindo os já lançados.'"></p>
        </div>
      </div>

      <div class="pay-right">
        <div class="pay-summary-card">
          <div class="pay-summary-title">Resumo</div>

          <%# Total, pago e restante: o restante é o único que muda de cor e cresce quando
              ainda há saldo. O total já é o número grande da esquerda; aqui ele é só a
              referência do fechamento. %>
          <div class="pay-summary-totals">
            <div class="pay-summary-row"><span>Total</span><span x-text="brl(total())"></span></div>
            <div class="pay-summary-row"><span>Pago</span><span x-text="brl(paidSum())"></span></div>
            <div class="pay-summary-row pay-remaining" :class="{ pending: remaining() > 0 }">
              <span x-text="remaining() >= 0 ? 'Restante' : 'Excedente'"></span>
              <strong x-text="brl(Math.abs(remaining()))"></strong>
            </div>
          </div>

          <div class="pay-items-list">
            <template x-for="(p, idx) in pay.list" :key="idx">
              <div class="pay-item-card">
                <span class="pay-item-icon" x-html="methodIcon(methodType(p.methodId))"></span>
                <div class="info">
                  <div class="name" x-text="methodName(p.methodId)"></div>
                  <%# Com um único pagamento o valor já aparece em "Pago"; repetir aqui só
                      duplicaria a mesma informação. %>
                  <div class="amount" x-show="pay.list.length > 1" x-text="brl(p.amountCents)"></div>
                  <div class="meta" x-show="paymentMeta(p)" x-text="paymentMeta(p)"></div>
                </div>
                <div class="pay-item-actions">
                  <button type="button" class="pay-item-edit" @click="editPayment(idx)" title="Editar pagamento" aria-label="Editar pagamento">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                  </button>
                  <button type="button" class="pay-item-remove" @click="removePayment(idx)" title="Remover pagamento" aria-label="Remover pagamento">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </div>
              </div>
            </template>
            <p class="pay-empty" x-show="!pay.list.length">Nenhum pagamento registrado.</p>
          </div>

          <%# Troco em destaque e sempre à vista: é dinheiro que precisa voltar para o
              cliente. O x-show é reativo ao campo "Valor recebido" acima. %>
          <div class="pay-change-panel" x-show="changeDue() > 0" x-cloak aria-live="polite">
            <span>Troco</span>
            <strong x-text="brl(changeDue())"></strong>
          </div>

          <div class="pay-fees" x-show="paidFees() > 0" x-cloak>
            <span>Taxas <strong x-text="'- ' + brl(paidFees())"></strong></span>
            <span>Líquido <strong x-text="brl(paidSum() - paidFees())"></strong></span>
          </div>

          <div class="pay-ready-banner" x-show="remaining() === 0">Venda pronta para finalizar</div>

          <div class="error" x-text="payError"<% if (user.permissions.has('finance.cash.open')) { %> x-show="!payError.includes('Abra o caixa')"<% } %>></div>

          <div class="pay-confirm-dock">
            <button type="button" class="pay-confirm-btn" :disabled="!canConfirm()" @click="finish()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span x-text="saving ? 'Registrando…' : 'Confirmar venda'"></span>
            </button>
            <p class="pay-confirm-hint">Pressione <strong>ENTER</strong> para confirmar</p>
          </div>
        </div>
      </div>
    </dialog>

    <!-- ─── MODAL: Venda a prazo (parcelamento) ─── -->
    <dialog x-ref="prazoDlg" class="dialog-fixed">
      <h1>Venda a prazo</h1>
      <div class="dialog-body">
        <label>Cliente</label>
        <select x-model.number="prazoForm.customerId" @change="onPrazoCustomerChange()">
          <option value="">Selecione…</option>
          <template x-for="c in customers" :key="c.id"><option :value="c.id" x-text="c.name"></option></template>
        </select>
        <label class="label-checkbox-sm" style="margin-top:.5rem">
          <input type="radio" value="avista" x-model="prazoForm.mode" /> À vista (1 vencimento)
        </label>
        <label class="label-checkbox-sm">
          <input type="radio" value="parcelado" x-model="prazoForm.mode" /> Parcelado
        </label>
        <template x-if="prazoForm.mode === 'parcelado'">
          <div>
            <label>Número de parcelas (2 a <span x-text="prazoMax()"></span>)</label>
            <input type="number" min="2" :max="prazoMax()" x-model.number="prazoForm.installments" class="input-narrow-sm" />
          </div>
        </template>
        <label>Primeiro vencimento</label>
        <input type="date" x-model="prazoForm.firstDueDate" />
        <table style="margin-top:.75rem">
          <thead><tr><th>Parcela</th><th>Vencimento</th>            <th class="text-right">Valor</th></tr></thead>
          <tbody>
            <template x-for="p in prazoPreview()" :key="p.n">
              <tr><td x-text="p.n + '/' + p.count"></td><td x-text="fmtDate(p.dueDate)"></td><td class="text-right" x-text="brl(p.amountCents)"></td></tr>
            </template>
          </tbody>
        </table>
        <div class="error" x-text="prazoError"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.prazoDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn" @click="confirmPrazoDlg()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Confirmar
        </button>
      </div>
    </dialog>

    <!-- ─── MODAL: Pagamento com pontos de fidelidade ─── -->
    <dialog x-ref="fidelidadeDlg">
      <h1>Pontos de fidelidade</h1>
      <p class="muted" style="margin-top:-.3rem" x-text="'Saldo disponível: ' + (customerBalances.loyaltyPoints || 0) + ' pontos'"></p>
      <label>Quantos pontos usar</label>
      <input type="number" min="1" x-model.number="fidelidadeForm.pointsUsed" @input="fidelidadeError = ''" />
      <p class="muted" style="font-size:.85rem" x-text="'Equivale a ' + brl(Math.round((fidelidadeForm.pointsUsed || 0) * centsPerPointClient()))"></p>
      <div class="error" x-text="fidelidadeError"></div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.fidelidadeDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn" @click="confirmFidelidadeDlg()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Confirmar
        </button>
      </div>
    </dialog>

    <!-- ─── MODAL: Complementos / opcionais ─── -->
    <dialog x-ref="complementDlg" style="width:min(600px,94vw)">
      <h1 x-text="'Complementos — ' + (complementDlg.product?.name || '')"></h1>
      <p class="muted">Selecione os opcionais desejados e confirme para adicionar ao carrinho.</p>
      <template x-for="g in complementDlg.groups" :key="g.group_id">
        <div class="complement-group" style="margin:1rem 0;padding:.75rem;border:1.5px solid var(--border-light);border-radius:var(--radius)">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <strong x-text="g.group_name"></strong>
            <span class="muted text-xs" x-text="(g.min_select > 0 ? ('Min: ' + g.min_select) : 'Opcional') + (g.max_select ? (' · Max: ' + g.max_select) : '')"></span>
          </div>
          <div style="margin-top:.5rem">
            <template x-for="item in (typeof g.items === 'string' ? [] : g.items)" :key="item.id">
              <div class="complement-item" style="display:flex;align-items:center;gap:.5rem;padding:.3rem 0">
                <input type="checkbox" :checked="complementDlg.selections[g.group_id]?.some(s => s.product_id === item.product_id)"
                       @change="toggleComplement(g.group_id, item)" />
                <span x-text="item.product_name" style="flex:1"></span>
                <span class="text-sm" x-text="brl(item.price_override_cents != null ? item.price_override_cents : item.price_cents)"></span>
                <template x-if="complementDlg.selections[g.group_id]?.some(s => s.product_id === item.product_id)">
                  <div style="display:flex;align-items:center;gap:.25rem">
                    <button class="btn secondary small" @click="complementQty(g.group_id, item.product_id, -1)" style="padding:.1rem .4rem">−</button>
                    <span x-text="complementDlg.selections[g.group_id]?.find(s => s.product_id === item.product_id)?.qty || 1" style="min-width:1.5rem;text-align:center"></span>
                    <button class="btn secondary small" @click="complementQty(g.group_id, item.product_id, 1)" style="padding:.1rem .4rem">+</button>
                  </div>
                </template>
              </div>
            </template>
          </div>
          <div class="error text-xs" x-show="complementDlg.errors[g.group_id]" x-text="complementDlg.errors[g.group_id]"></div>
        </div>
      </template>
      <div style="margin-bottom:.75rem">
        <label class="text-sm" style="display:block;margin-bottom:.25rem">Observação (opcional)</label>
        <input type="text" x-model="complementDlg.mainNotes" placeholder="Ex.: sem cebola, bem passado..." style="width:100%" />
      </div>
      <div class="error" x-text="complementDlg.errors._general"></div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.complementDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn" @click="confirmComplementSelection()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Adicionar ao carrinho
        </button>
      </div>
    </dialog>

    <% if (user.permissions.has('store.quotes.create')) { %>
    <!-- ─── MODAL: Salvar carrinho como orçamento ─── -->
    <dialog x-ref="quoteDlg" style="width:min(460px,94vw)">
      <h1 x-text="slots[activeSlot].quoteId ? ('Orçamento #' + slots[activeSlot].quoteId) : 'Salvar como orçamento'"></h1>
      <p class="muted muted-sm">Os preços do carrinho ficam congelados até a validade.</p>
      <%# O cliente vem do campo do carrinho — um lugar só, cadastrado ou não. Dois campos
          de nome (aqui e no carrinho) já causaram orçamento salvo no nome errado. %>
      <p class="muted muted-sm" style="margin-bottom:.75rem">
        <strong>Cliente:</strong>
        <span x-show="customerName" x-text="customerName + (customerId ? ' (cadastrado)' : '')"></span>
        <span x-show="!customerName">nenhum — informe um nome no carrinho para identificar o orçamento.</span>
      </p>
      <label>Válido até</label>
      <input type="date" x-model="quoteForm.validUntil" />
      <label>Observações</label>
      <input type="text" x-model="quoteForm.notes" placeholder="Ex.: prazo de entrega, condições" />
      <div class="error" x-text="quoteForm.error"></div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.quoteDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn" @click="saveQuote()" :disabled="quoteForm.saving">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Salvar orçamento
        </button>
      </div>
    </dialog>
    <% } %>

    <% if (user.permissions.has('finance.cash.open')) { %>
    <!-- ─── MODAL: Aviso de caixa fechado ─── -->
    <dialog x-ref="cashClosedWarnDlg" style="width:360px">
      <div class="dialog-body-center">
        <div class="dialog-icon dialog-icon-warning">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--warning-text)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <h2 class="dialog-heading-md">Caixa fechado</h2>
        <p class="dialog-muted">
          É preciso abrir o caixa antes de realizar uma venda. Deseja abrir agora?
        </p>
        <div class="actions actions-center">
          <button class="btn secondary" @click="$refs.cashClosedWarnDlg.close()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
            Não
          </button>
          <button class="btn" @click="$refs.cashClosedWarnDlg.close(); openRegisterFromSale()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Sim
          </button>
        </div>
      </div>
    </dialog>

    <!-- ─── MODAL: Abrir caixa (sem sair da venda em andamento) ─── -->
    <dialog x-ref="openRegisterDlg" style="width:360px">
      <h1>Abrir caixa</h1>
      <p class="muted muted-sm">O carrinho e o pagamento em andamento não serão perdidos.</p>
      <label>Valor inicial da gaveta (R$)</label>
      <input type="text" x-ref="openRegisterInput" x-model="openRegisterForm.opening" placeholder="0,00"
             @input="openRegisterForm.opening = maskMoney(openRegisterForm.opening)"
             @keydown.enter.prevent="confirmOpenRegister()" />
      <div class="error" x-text="openRegisterForm.error"></div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.openRegisterDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn" @click="confirmOpenRegister()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Abrir caixa
        </button>
      </div>
    </dialog>
    <% } %>

    <!-- ─── MODAL: Venda concluída — imprimir cupom? ─── -->
    <dialog x-ref="postSale" @close="onPostSaleClose()">
      <div class="dialog-body-center">
        <div class="dialog-icon dialog-icon-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
        </div>
        <h2 class="dialog-heading-sm">Venda finalizada!</h2>
        <p class="dialog-muted">Deseja imprimir o cupom desta venda?</p>
        <div class="actions actions-center">
          <button class="btn secondary" @click="$refs.postSale.close()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
            Não (Esc)
          </button>
          <button class="btn secondary" x-show="lastSaleHasCarne" @click="printCarne()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Imprimir carnê
          </button>
          <button class="btn" autofocus @click="printLast(); $refs.postSale.close()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Imprimir (Enter)
          </button>
        </div>
      </div>
    </dialog>
  </main>

  <script nonce="<%= cspNonce %>" src="/js/tour.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/masks.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/datetime.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/payment-methods.js"></script>
  <script nonce="<%= cspNonce %>">
    const PDV_CAN_DISCOUNT = <%= user.permissions.has('store.sales.discount') %>;
    function pdvPage() {
      return {
        // ─── Estado ───
        // Vendas simultâneas (até 4 "guichês" no mesmo PDV — atender outro cliente sem
        // perder o carrinho do anterior) + persistência em localStorage (sobrevive a
        // navegar pra outra tela e voltar, ou recarregar a página sem querer).
        slots: [{ cart: [], discountCents: 0, surchargeCents: 0, discountReason: '', lastSaleId: null, customerId: '', customerName: '', comandaId: null, tableLabel: null, quoteId: null, quoteLabel: null, label: null }],
        justClosedComandaId: null,
        activeSlot: 0,
        q: '', results: [], customers: [], methods: [],
        highlightIdx: -1, searching: false,
        favorites: [], customerSuggestions: [], pendingSync: 0,
        canDiscount: PDV_CAN_DISCOUNT,
        priceDlg: { idx: null, value: '', original: 0, error: '' },
        renameDlg: { idx: null, value: '' },
        customerDlg: { name: '', document: '', phone: '', error: '', saving: false },
        get cart() { return this.slots[this.activeSlot].cart; },
        set cart(v) { this.slots[this.activeSlot].cart = v; },
        get discountCents() { return this.slots[this.activeSlot].discountCents; },
        set discountCents(v) { this.slots[this.activeSlot].discountCents = v; },
        get surchargeCents() { return this.slots[this.activeSlot].surchargeCents; },
        set surchargeCents(v) { this.slots[this.activeSlot].surchargeCents = v; },
        get discountReason() { return this.slots[this.activeSlot].discountReason ?? ''; },
        set discountReason(v) { this.slots[this.activeSlot].discountReason = v; },
        get lastSaleId() { return this.slots[this.activeSlot].lastSaleId; },
        set lastSaleId(v) { this.slots[this.activeSlot].lastSaleId = v; },
        get customerId() { return this.slots[this.activeSlot].customerId ?? ''; },
        set customerId(v) { this.slots[this.activeSlot].customerId = v; },
        get customerName() { return this.slots[this.activeSlot].customerName ?? ''; },
        set customerName(v) { this.slots[this.activeSlot].customerName = v; },
        valueDlg: { kind: 'desconto', amount: '', mode: 'valor', reason: '', pin: '', needPin: false, error: '' },
        pay: { methodId: null, amount: '', list: [], split: 2, received: '', clientRequestId: '' },
        showSplit: false,
        error: '', payError: '', saving: false, sendingKitchen: false, appSettings: [],
        pinInput: '', pinError: '', pendingRemoveIdx: null,
        browseQ: '', browseResults: [], browseCategories: [], browseCategoryId: '', productView: 'grid',
        openRegisterForm: { opening: '', error: '' },
        customerBalances: {}, lastSaleHasCarne: false,
        prazoForm: { customerId: '', mode: 'avista', installments: 3, firstDueDate: '', amountCents: 0 }, prazoError: '',
        fidelidadeForm: { pointsUsed: 0 }, fidelidadeError: '',
        cloudOnline: false,
        complementDlg: { product: null, groups: [], selections: {}, mainNotes: '', errors: {} },
        noteDlg: { idx: null, text: '' },
        qtyDlg: { idx: null, name: '', unit: 'un', fractional: false, raw: '', error: '' },
        quoteForm: { validUntil: '', notes: '', error: '', saving: false },

        // ─── Complementos ───
        openComplementDlg(product, groups) {
          this.complementDlg.product = product;
          this.complementDlg.groups = groups;
          this.complementDlg.selections = {};
          this.complementDlg.mainNotes = '';
          this.complementDlg.errors = {};
          for (const g of groups) {
            this.complementDlg.selections[g.group_id] = [];
            // Parse items JSON (vem como string do json_group_array)
            if (typeof g.items === 'string') {
              try { g.items = JSON.parse(g.items); } catch { g.items = []; }
            }
          }
          // Espera o x-for desenhar os grupos antes de abrir. O showModal() foca o primeiro
          // campo disponível; sem os checkboxes, ele focava a observação e abria o teclado
          // no celular, cobrindo o dialog inteiro.
          this.$nextTick(() => this.$refs.complementDlg.showModal());
        },
        toggleComplement(groupId, item) {
          const sel = this.complementDlg.selections[groupId];
          const g = this.complementDlg.groups.find((gr) => gr.group_id === groupId);
          const idx = sel.findIndex((s) => s.product_id === item.product_id);
          if (idx >= 0) {
            sel.splice(idx, 1);
          } else {
            if (g && g.max_select === 1) {
              sel.length = 0;
            }
            sel.push({ ...item });
          }
          this.complementDlg.errors = {};
        },
        complementQty(groupId, productId, delta) {
          const sel = this.complementDlg.selections[groupId];
          const item = sel.find((s) => s.product_id === productId);
          if (item) {
            item.qty = Math.max(1, (item.qty || 1) + delta);
          }
        },
        validateComplementSelection() {
          const errors = {};
          for (const g of this.complementDlg.groups) {
            const sel = this.complementDlg.selections[g.group_id];
            const totalQty = sel.reduce((s, i) => s + (i.qty || 1), 0);
            if (g.min_select > 0 && totalQty < g.min_select) {
              errors[g.group_id] = `Selecione ao menos ${g.min_select} opcao(oes).`;
            }
            if (g.max_select != null && totalQty > g.max_select) {
              errors[g.group_id] = `Maximo de ${g.max_select} opcao(oes) excedido.`;
            }
          }
          this.complementDlg.errors = errors;
          return Object.keys(errors).length === 0;
        },
        confirmComplementSelection() {
          if (!this.validateComplementSelection()) return;
          const p = this.complementDlg.product;
          const lineGroupUuid = window.crypto?.randomUUID?.() || (Date.now() + '-' + Math.random());
          // Adiciona o produto principal
          this.addToCart(p, 1, lineGroupUuid, this.complementDlg.mainNotes || null);
          // Adiciona cada complemento selecionado
          for (const g of this.complementDlg.groups) {
            for (const sel of this.complementDlg.selections[g.group_id]) {
              const qty = sel.qty || 1;
              const complementProduct = {
                id: sel.product_id,
                name: sel.product_name,
                price_cents: sel.price_override_cents != null ? sel.price_override_cents : sel.price_cents,
                sku: null,
                image_url: null,
              };
              // priceLocked: o preço do complemento vem do grupo (override/catálogo) e
              // não pode ser sobrescrito pelo repriceCart com o preço de catálogo do
              // produto. O servidor recalcula esse mesmo valor ao fechar a venda.
              this.addToCart(complementProduct, qty, lineGroupUuid, this.complementDlg.mainNotes || null, true);
            }
          }
          this.$refs.complementDlg.close();
        },

        // ─── Utilitários ───
        brl(c) { return window.brl(c); },
        kitchenStatusLabel(i) {
          if (!i?.goesToKitchen) return '';
          if (i.kitchenSent === true) {
            const labels = { pendente: 'na fila', preparo: 'em preparo', pronto: 'pronto', entregue: 'entregue' };
            return 'Cozinha · ' + (labels[i.kitchenStatus] || 'enviado');
          }
          // Venda direta ainda não tem ticket (null) — o selo só informa que o item
          // passa pela cozinha. Comanda carregada manda false e mostra o que falta.
          return i.kitchenSent === false ? 'Cozinha · a enviar' : 'Cozinha';
        },
        cents(s) { const n = parseFloat(String(s || '0').replace(/\./g, '').replace(',', '.')); return isNaN(n) ? 0 : Math.round(n * 100); },
        focusSearch() { this.$nextTick(() => { this.$refs.search?.focus(); }); },
        methodIcon: paymentMethodIcon,
        // Sinal sonoro do PDV (Web Audio, sem arquivo): curto e distinto para sucesso/erro.
        pdvSomEnabled() { return this.appSettings?.find((s) => s.key === 'pdv.som')?.value !== '0'; },
        beep(ok = true) {
          if (!this.pdvSomEnabled()) return;
          try {
            const Ctx = window.AudioContext || window.webkitAudioContext;
            if (!Ctx) return;
            this._audioCtx = this._audioCtx || new Ctx();
            const ctx = this._audioCtx;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain); gain.connect(ctx.destination);
            osc.type = 'sine';
            osc.frequency.value = ok ? 880 : 220;
            gain.gain.setValueAtTime(0.06, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.12);
            osc.start();
            osc.stop(ctx.currentTime + 0.13);
          } catch (e) { /* áudio indisponível: segue sem som */ }
        },
        // Termo de busca sem o prefixo de quantidade ("3*789" → "789").
        cleanQuery() { return this.q.trim().replace(/^(\d+(?:[.,]\d+)?)\s*[*x]\s*/i, ''); },
        parseQtyPrefix() {
          const m = /^(\d+(?:[.,]\d+)?)\s*[*x]\s*/i.exec(this.q.trim());
          const n = m ? parseFloat(m[1].replace(',', '.')) : 1;
          return Number.isFinite(n) && n > 0 ? n : 1;
        },
        async toggleFullscreen() {
          try {
            if (document.fullscreenElement) await document.exitFullscreen();
            else await document.documentElement.requestFullscreen();
          } catch (e) { /* navegador bloqueou — sem problema */ }
        },
        async loadFavorites() {
          const r = await fetch('/api/commercial/products?scope=favorites&limit=24');
          if (r.ok) this.favorites = await r.json();
        },

        // ─── Vendas simultâneas + persistência ───
        persistSlots() {
          try { localStorage.setItem('kivo:pdv:slots', JSON.stringify({ slots: this.slots, activeSlot: this.activeSlot })); } catch (e) {}
        },
        restoreSlots() {
          try {
            const raw = localStorage.getItem('kivo:pdv:slots');
            if (!raw) return;
            const saved = JSON.parse(raw);
            if (Array.isArray(saved?.slots) && saved.slots.length) {
              this.slots = saved.slots;
              this.activeSlot = Math.min(saved.activeSlot ?? 0, this.slots.length - 1);
            }
          } catch (e) {}
        },
        addSlot() {
          if (this.slots.length >= 4) return;
          this.slots.push({ cart: [], discountCents: 0, surchargeCents: 0, discountReason: '', lastSaleId: null, customerId: '', customerName: '', comandaId: null, tableLabel: null, quoteId: null, quoteLabel: null, label: null });
          this.activeSlot = this.slots.length - 1;
          this.persistSlots();
          this.focusSearch();
        },
        switchSlot(idx) {
          if (idx === this.activeSlot) return;
          this.activeSlot = idx;
          this.q = ''; this.results = []; this.highlightIdx = -1;
          this.persistSlots();
          this.focusSearch();
        },
        async closeSlot(idx) {
          if (this.slots.length <= 1) return;
          if (this.slots[idx].cart.length && !await window.confirmDlg('Fechar esta venda? Os itens ainda não finalizados serão perdidos.')) return;
          this.slots.splice(idx, 1);
          if (this.activeSlot >= this.slots.length) this.activeSlot = this.slots.length - 1;
          else if (this.activeSlot > idx) this.activeSlot -= 1;
          this.persistSlots();
        },

        renameSlot(idx) {
          this.renameDlg.idx = idx;
          this.renameDlg.value = this.slots[idx]?.label || '';
          this.$nextTick(() => {
            this.$refs.renameDlg?.showModal();
            this.$refs.renameInput?.focus();
            this.$refs.renameInput?.select();
          });
        },
        saveRenameSlot() {
          const idx = this.renameDlg.idx;
          if (idx == null || !this.slots[idx]) {
            this.$refs.renameDlg?.close();
            return;
          }
          this.slots[idx].label = this.renameDlg.value.trim() || null;
          this.persistSlots();
          this.$refs.renameDlg?.close();
        },

        // ─── Inicialização ───
        async init() {
          // Alpine chama init() 2x (hook automático de lifecycle + x-init="init()" explicito) —
          // inofensivo na maioria das telas (fetch+set idempotente), mas loadComanda() não é
          // idempotente (duplicaria a comanda em 2 abas de venda), por isso o guard aqui.
          if (this._initDone) return;
          this._initDone = true;
          this.restoreSlots();
          const [m, s, c, p] = await Promise.all([
            fetch('/api/store/payment-methods'),
            fetch('/api/settings'),
            fetch('/api/commercial/customers'),
            // scope=sellable inclui as variantes: sem isso, toda linha de produto com grade
            // era descartada do carrinho restaurado como se o produto não existisse mais.
            fetch('/api/commercial/products?scope=sellable'),
          ]);
          if (m.ok) { this.methods = await m.json(); if (this.methods.length) this.pay.methodId = this.methods[0].id; }
          if (s.ok) this.appSettings = await s.json();
          if (c.ok) {
            this.customers = await c.json();
            // Carrinho salvo antes do campo de nome existir só tem o customerId: sem este
            // preenchimento o campo apareceria vazio com um cliente ainda vinculado.
            this.slots.forEach((slot) => {
              if (!slot.customerId || slot.customerName) return;
              const known = this.customers.find((cust) => cust.id === slot.customerId);
              if (known) slot.customerName = known.name;
            });
          }
          if (p.ok) {
            // Carrinho persistido em localStorage pode referenciar produto excluído/inativado
            // desde a última sessão — sem essa limpeza, o item fica "fantasma" no carrinho e
            // quebra o checkout (o backend rejeita productId inexistente). A mesma lista
            // atualiza o selo de cozinha de carrinhos salvos antes desse campo existir.
            const products = await p.json();
            const byProductId = new Map(products.map((prod) => [prod.id, prod]));
            this.slots.forEach((slot) => {
              slot.cart = slot.cart.filter((i) => byProductId.has(i.productId));
              for (const item of slot.cart) {
                const prod = byProductId.get(item.productId);
                // Linha de comanda já enviada carrega o status real; venda direta usa o
                // roteamento atual do produto.
                if (item.kitchenSent == null) item.goesToKitchen = !!prod.goes_to_kitchen;
                if (item.kitchenSent === undefined) item.kitchenSent = null;
                if (item.kitchenStatus === undefined) item.kitchenStatus = null;
                // Carrinhos antigos não têm `unit`: recupera do catálogo para a linha
                // mostrar "/kg" em vez de "un." e a modal usar a precisão certa.
                if (!item.unit) item.unit = prod.unit || 'un';
              }
            });
            this.persistSlots();
          }
          const params = new URLSearchParams(location.search);
          const comandaIdParam = params.get('comandaId');
          if (comandaIdParam) await this.loadComanda(Number(comandaIdParam));
          const quoteIdParam = params.get('quoteId');
          if (quoteIdParam) await this.loadQuote(Number(quoteIdParam));
          if (this.customerId) this.loadCustomerBalances();
          this.focusSearch();
          this.$watch('slots', () => this.persistSlots());
          this.loadFavorites();
          this.checkOnline();
          setInterval(() => this.checkOnline(), 25000);
          document.addEventListener('keydown', (e) => {
            const dialogsOpen = document.querySelectorAll('dialog[open]').length > 0;
            if (!dialogsOpen) {
              switch (e.key) {
                case 'F2': e.preventDefault(); if (this.cart.length) this.openPay(); return;
                case 'F3': e.preventDefault(); abrirCalculadora(); return;
                case 'F4': e.preventDefault(); this.openValue('desconto'); return;
                <% if (user.permissions.has('store.quotes.create')) { %>
                case 'F6': e.preventDefault(); if (this.cart.length) this.openQuoteDlg(); return;
                <% } %>
                case 'F7': e.preventDefault(); this.openValue('acrescimo'); return;
                case 'F9': e.preventDefault(); this.clearCart(); return;
                case 'F11': e.preventDefault(); this.printLast(); return;
              }
            }
            if (this.$refs.pay && this.$refs.pay.open) {
              const fMatch = /^F([1-9])$/.exec(e.key);
              if (fMatch) {
                // Pelo mesmo caminho do clique: o atalho de "a prazo" abre o diálogo do cliente
                // e o de fidelidade o de pontos, em vez de só marcar a forma e travar depois.
                const m = this.methods[Number(fMatch[1]) - 1];
                if (m) { e.preventDefault(); this.selectQuickMethod(m); }
                return;
              }
              const inField = e.target.matches('input, select, textarea');
              if (e.key === 'Enter' && !inField && this.remaining() === 0) {
                e.preventDefault();
                this.finish();
                return;
              }
            }
            if (e.key === 'Enter') {
              const dlg = document.querySelector('dialog[open]');
              if (dlg && dlg.id === 'confirm-dlg') {
                const confirmBtn = dlg.querySelector('.btn:not(.secondary)');
                if (confirmBtn) confirmBtn.click();
              }
            }
          });
        },
        // ─── Comanda → PDV (fechar comanda pelo caixa, preço já congelado) ───
        async loadComanda(id) {
          const r = await fetch(`/api/comandas/comandas/${id}`);
          if (!r.ok) { showToast('Comanda não encontrada ou já fechada.', 'error'); return; }
          const c = await r.json();
          if (c.status !== 'aberta') { showToast('Esta comanda não está mais aberta.', 'error'); return; }
          const cart = (c.items || []).map((i) => ({
            productId: i.product_id, name: i.product_name, price_cents: i.unit_price_cents, qty: i.qty,
            unit: i.unit || 'un',
            sku: i.sku || null, image_url: i.image_url || null,
            lineGroupUuid: i.line_group_uuid || null, notes: i.notes || null,
            goesToKitchen: !!i.goes_to_kitchen,
            kitchenSent: i.kitchen_sent === true,
            kitchenStatus: i.kitchen_status || null,
          }));
          const needsNewSlot = this.slots[this.activeSlot].cart.length > 0 || this.slots[this.activeSlot].comandaId;
          if (needsNewSlot) {
            this.slots.push({ cart: [], discountCents: 0, surchargeCents: 0, discountReason: '', lastSaleId: null, customerId: '', customerName: '', comandaId: null, tableLabel: null, quoteId: null, quoteLabel: null, label: null });
            this.activeSlot = this.slots.length - 1;
          }
          this.slots[this.activeSlot] = {
            cart, discountCents: 0, surchargeCents: 0, discountReason: '', lastSaleId: null,
            customerId: c.customer_id || '', customerName: c.customer_name || '',
            comandaId: id, tableLabel: c.table_label || null,
          };
          // A comanda só guarda o FK; o nome do cadastro vem da lista já carregada.
          if (this.customerId && !this.customerName) {
            const known = this.customers.find((cust) => cust.id === this.customerId);
            if (known) this.customerName = known.name;
          }
          this.persistSlots();
        },
        // ─── Orçamento ↔ PDV ───
        // Reabre o orçamento no carrinho para o operador ajustar e faturar. Os preços vêm
        // congelados de quote_items — repriceCart() não roda em slot de orçamento.
        async loadQuote(id) {
          const r = await fetch(`/api/store/quotes/${id}`);
          if (!r.ok) { showToast('Orçamento não encontrado.', 'error'); return; }
          const q = await r.json();
          if (q.status !== 'aberto') { showToast(`Este orçamento já está "${q.status}".`, 'error'); return; }
          const cart = (q.items || []).map((i) => ({
            productId: i.product_id, name: i.product_name, price_cents: i.unit_price_cents, qty: i.qty,
            unit: i.unit || 'un',
            sku: i.sku || null, image_url: i.image_url || null,
            lineGroupUuid: i.line_group_uuid || null, notes: i.notes || null,
            goesToKitchen: !!i.goes_to_kitchen, kitchenSent: null, kitchenStatus: null,
          }));
          const slot = this.slots[this.activeSlot];
          if (slot.cart.length || slot.comandaId || slot.quoteId) {
            this.slots.push({ cart: [], discountCents: 0, surchargeCents: 0, discountReason: '', lastSaleId: null, customerId: '', customerName: '', comandaId: null, tableLabel: null, quoteId: null, quoteLabel: null, label: null });
            this.activeSlot = this.slots.length - 1;
          }
          this.slots[this.activeSlot] = {
            cart, discountCents: q.discount_cents || 0, surchargeCents: q.surcharge_cents || 0,
            lastSaleId: null, customerId: q.customer_id || '',
            // Cliente cadastrado devolve o nome pelo JOIN (q.customer); orçamento de balcão
            // só tem o texto livre. Os dois preenchem o mesmo campo do carrinho.
            customerName: q.customer || q.customer_name || '',
            comandaId: null, tableLabel: null,
            quoteId: id, quoteLabel: q.customer || q.customer_name || null,
          };
          this.quoteForm = {
            validUntil: q.valid_until || '', notes: q.notes || '', error: '', saving: false,
          };
          this.persistSlots();
          if (this.customerId) this.loadCustomerBalances();
        },
        openQuoteDlg() {
          if (!this.cart.length) return;
          this.quoteForm.error = ''; this.quoteForm.saving = false;
          this.$refs.quoteDlg.showModal();
        },
        // unitPriceCents em cada linha é obrigatório: é o que faz o preço cotado valer na
        // hora de faturar, em vez de o servidor re-resolver o preço de catálogo do dia.
        quoteItemsPayload() {
          return this.cart.map((i) => ({
            productId: i.productId, qty: i.qty, unitPriceCents: i.price_cents,
            notes: i.notes || undefined, lineGroupUuid: i.lineGroupUuid || undefined,
          }));
        },
        async saveQuote() {
          if (this.quoteForm.saving || !this.cart.length) return;
          this.quoteForm.saving = true; this.quoteForm.error = '';
          const quoteId = this.slots[this.activeSlot].quoteId;
          // Cliente cadastrado já é identificado pelo customerId — gravar o nome de novo
          // em customer_name só criaria uma cópia que envelhece se o cadastro for renomeado.
          const freeName = this.customerId ? '' : (this.customerName || '').trim();
          const body = {
            items: this.quoteItemsPayload(),
            customerId: this.customerId || (quoteId ? null : undefined),
            customerName: freeName || (quoteId ? null : undefined),
            validUntil: this.quoteForm.validUntil || (quoteId ? null : undefined),
            notes: this.quoteForm.notes || (quoteId ? null : undefined),
            discountCents: this.discountCents || 0,
            surchargeCents: this.surchargeCents || 0,
          };
          const r = quoteId
            ? await fetch(`/api/store/quotes/${quoteId}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
            : await fetch('/api/store/quotes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          this.quoteForm.saving = false;
          if (!r.ok) {
            this.quoteForm.error = (await r.json()).error ?? 'Erro ao salvar o orçamento.';
            return;
          }
          const d = await r.json();
          this.$refs.quoteDlg.close();
          if (quoteId) {
            showToast(`Orçamento #${quoteId} atualizado.`, 'success');
          } else {
            // O carrinho vira o orçamento recém-criado: continuar montando a mesma venda
            // e salvar de novo criaria um orçamento duplicado.
            this.slots[this.activeSlot].quoteId = d.id;
            this.slots[this.activeSlot].quoteLabel = this.customerName || null;
            this.persistSlots();
            showToast(`Orçamento #${d.id} salvo.`, 'success');
          }
        },
        detachQuote() {
          this.slots[this.activeSlot].quoteId = null;
          this.slots[this.activeSlot].quoteLabel = null;
          this.persistSlots();
          this.repriceCart();
          this.focusSearch();
        },
        onPostSaleClose() {
          if (this.justClosedComandaId) {
            this.justClosedComandaId = null;
            window.location.href = '/app/comandas/mesas';
            return;
          }
          this.focusSearch();
        },
        async checkOnline() {
          try {
            const r = await fetch('/api/sync/status');
            const d = r.ok ? await r.json() : null;
            this.cloudOnline = !!(d && d.online);
            this.pendingSync = Number(d?.pending ?? 0);
          } catch {
            this.cloudOnline = false;
          }
        },

        // ─── Busca ───
        async search() {
          const term = this.cleanQuery();
          if (!term) { this.results = []; this.highlightIdx = -1; return; }
          this.searching = true;
          this.highlightIdx = -1;
          // Cancela a busca anterior: sem isso, digitar rápido deixa respostas fora de
          // ordem sobrescrevendo a lista atual.
          if (this._searchAbort) this._searchAbort.abort();
          this._searchAbort = new AbortController();
          const signal = this._searchAbort.signal;
          try {
            // Código de barras/SKU exato primeiro (bipe), depois busca textual limitada.
            if (!/\s/.test(term)) {
              const b = await fetch('/api/commercial/products/by-barcode/' + encodeURIComponent(term), { signal });
              if (b.ok) { this.results = [await b.json()]; return; }
            }
            const r = await fetch('/api/commercial/products?limit=20&q=' + encodeURIComponent(term), { signal });
            if (r.ok) this.results = await r.json();
          } catch (e) {
            if (e?.name !== 'AbortError') this.results = [];
          } finally {
            this.searching = false;
          }
        },
        // ─── Consultar produtos (modal separado, sem afetar o carrinho) ───
        async openBrowse() {
          this.browseQ = ''; this.browseResults = []; this.browseCategoryId = '';
          this.$refs.browse.showModal();
          this.$nextTick(() => this.$refs.browseInput.focus());
          if (!this.browseCategories.length) {
            const c = await fetch('/api/commercial/categories');
            if (c.ok) this.browseCategories = await c.json();
          }
          this.searchBrowse();
        },
        async searchBrowse() {
          // scope=sellable é obrigatório na listagem sem busca: o padrão da rota é
          // listTopLevel(), que só devolve produtos SEM pai — ou seja, descarta toda
          // variante filha, justamente a que se vende. Num catálogo inteiro em grade
          // (sofá P/M/G etc.) esta tela mostrava "Nenhum produto encontrado" com o
          // catálogo cheio. Com busca não é preciso: search() já inclui as filhas.
          const qs = this.browseQ.trim()
            ? '?q=' + encodeURIComponent(this.browseQ.trim())
            : '?scope=sellable';
          const r = await fetch('/api/commercial/products' + qs);
          if (r.ok) this.browseResults = await r.json();
        },
        browseFiltered() {
          if (!this.browseCategoryId) return this.browseResults;
          return this.browseResults.filter((p) => p.category_id === this.browseCategoryId);
        },

        highlightNext() {
          if (!this.results.length) return;
          this.highlightIdx = (this.highlightIdx + 1) % this.results.length;
          const el = document.querySelector('.pdv-result.highlight');
          if (el) el.scrollIntoView({ block: 'nearest' });
        },
        highlightPrev() {
          if (!this.results.length) return;
          this.highlightIdx = (this.highlightIdx - 1 + this.results.length) % this.results.length;
          const el = document.querySelector('.pdv-result.highlight');
          if (el) el.scrollIntoView({ block: 'nearest' });
        },
        async quickAdd() {
          const qty = this.parseQtyPrefix();
          const term = this.cleanQuery();
          if (this.results.length === 1) { await this.add(this.results[0], qty); }
          else if (this.results.length > 1) {
            if (this.highlightIdx >= 0) {
              await this.add(this.results[this.highlightIdx], qty);
              return;
            }
            const exact = this.results.find((p) => p.barcode === term || p.sku === term);
            if (exact) await this.add(exact, qty);
          }
        },
        async add(p, qty = 1) {
          const existing = this.cart.find((i) => i.productId === p.id && !i.lineGroupUuid);
          if (existing) { existing.qty += qty; this.persistSlots(); this.repriceCart(); this.beep(true); return; }
          // Checar se produto tem complementos
          const r = await fetch(`/api/commercial/products/${p.id}/complement-groups`);
          const groups = r.ok ? await r.json() : [];
          if (groups.length > 0) {
            this.openComplementDlg(p, groups);
            return;
          }
          this.addToCart(p, qty, null, null);
        },
        addToCart(p, qty, lineGroupUuid, notes, priceLocked = false) {
          // Linha nova numa comanda ainda não tem ticket: o selo precisa dizer "a enviar"
          // para o operador não fechar a conta achando que a cozinha já recebeu. Na venda
          // direta (sem comanda) o selo é só informativo.
          const emComanda = !!this.slots[this.activeSlot].comandaId;
          this.cart.push({
            productId: p.id, name: p.name, price_cents: p.price_cents, qty,
            unit: p.unit ?? 'un',
            sku: p.sku ?? null, image_url: p.image_url ?? null,
            lineGroupUuid, notes, ...(priceLocked ? { priceLocked: true } : {}),
            goesToKitchen: !!p.goes_to_kitchen,
            kitchenSent: emComanda ? false : null,
            kitchenStatus: null,
          });
          this.q = ''; this.results = []; this.highlightIdx = -1;
          this.focusSearch();
          this.persistSlots();
          this.repriceCart();
          this.beep(true);
        },
        // ─── Observação por item (ex.: "sem cebola, com provolone") ───
        openNoteDlg(idx) {
          this.noteDlg = { idx, text: this.cart[idx]?.notes ?? '' };
          this.$refs.noteDlg.showModal();
          this.$nextTick(() => this.$refs.noteInput?.focus());
        },
        saveNote() {
          const { idx, text } = this.noteDlg;
          if (idx == null || !this.cart[idx]) { this.$refs.noteDlg.close(); return; }
          this.cart[idx].notes = text.trim() || null;
          this.persistSlots();
          this.$refs.noteDlg.close();
        },

        // ─── Tabelas de preço (atacado/varejo/cliente) ───
        async repriceCart() {
          if (!this.cart.length) return;
          // Preço congelado: na comanda (congelado no pedido) e no orçamento (o cliente
          // recebeu um papel com o valor). Re-resolver aqui apagaria o preço cotado.
          if (this.slots[this.activeSlot].comandaId || this.slots[this.activeSlot].quoteId) return;
          // Complementos têm preço próprio do grupo (`price_override_cents`); re-resolver
          // por productId trocaria pelo catálogo e sumiria com o adicional do total.
          const lines = this.cart.filter((i) => !i.priceLocked);
          if (!lines.length) return;
          const r = await fetch('/api/commercial/pricing/resolve', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ customerId: this.customerId || null, items: lines.map((i) => ({ productId: i.productId, qty: i.qty })) }),
          });
          if (!r.ok) return;
          const { prices } = await r.json();
          // A resposta vem na mesma ordem do pedido — parear por índice evita aplicar
          // o preço da primeira ocorrência a outra linha do mesmo produto.
          for (let i = 0; i < prices.length && i < lines.length; i++) {
            lines[i].price_cents = prices[i].unitCents;
          }
          this.persistSlots();
        },

        // ─── Carrinho ───
        qtyUnitStep(unit) {
          const u = String(unit || '').trim();
          if (u === 'g' || u === 'ml') return 1;
          if (this.isFractionalUnit(u)) return 0.1;
          return 1;
        },
        qtyPlus(idx) {
          const i = this.cart[idx];
          if (!i) return;
          const step = this.qtyUnitStep(i.unit);
          i.qty = Math.round((Number(i.qty) + step) * 1000) / 1000;
          this.persistSlots();
          this.repriceCart();
        },
        qtyMinus(idx) {
          const i = this.cart[idx];
          if (!i) return;
          const step = this.qtyUnitStep(i.unit);
          const min = this.isFractionalUnit(i.unit) ? 0.001 : 1;
          i.qty = Math.max(min, Math.round((Number(i.qty) - step) * 1000) / 1000);
          this.persistSlots();
          this.repriceCart();
        },
        isFractionalUnit(unit) { return ['kg', 'g', 'L', 'ml'].includes(String(unit || '').trim()); },
        parseQty(v) {
          const raw = String(v ?? '').trim().replace(',', '.');
          const n = Number(raw);
          return raw === '' || isNaN(n) ? NaN : n;
        },
        fmtQty(q) {
          const n = Number(q);
          if (!Number.isFinite(n)) return String(q ?? '');
          if (n % 1 === 0) return String(n);
          return n.toFixed(3).replace(/0+$/, '').replace(/\.$/, '').replace('.', ',');
        },
        openQtyDlg(idx) {
          const item = this.cart[idx];
          if (!item) return;
          this.qtyDlg = {
            idx,
            name: item.name,
            unit: item.unit || 'un',
            fractional: this.isFractionalUnit(item.unit),
            raw: '',
            error: '',
          };
          this.$refs.qtyDlg.showModal();
        },
        qtyKey(ch) {
          let raw = this.qtyDlg.raw || '';
          if (ch === ',') {
            if (!this.qtyDlg.fractional || raw.includes(',') || raw.includes('.')) return;
            raw = (raw || '0') + ',';
          } else {
            if (raw.replace(/[,.]/g, '').length >= 9) return;
            // Mesma precisão que o visor e o total usam: 3 casas (gramas no kg).
            const sep = raw.search(/[,.]/);
            if (sep >= 0 && raw.length - sep - 1 >= 3) return;
            raw += ch;
          }
          this.qtyDlg.raw = raw;
          this.qtyDlg.error = '';
        },
        qtyBackspace() {
          this.qtyDlg.raw = (this.qtyDlg.raw || '').slice(0, -1);
          this.qtyDlg.error = '';
        },
        qtyStep(delta) {
          const current = this.parseQty(this.qtyDlg.raw);
          let next = (Number.isFinite(current) ? current : 0) + delta;
          if (!this.qtyDlg.fractional) next = Math.round(next);
          next = Math.max(this.qtyDlg.fractional ? 0.001 : 1, Math.round(next * 1000) / 1000);
          this.qtyDlg.raw = this.fmtQty(next);
          this.qtyDlg.error = '';
        },
        // Mesmo atalho do modal de comandas: dígitos, vírgula/ponto e Backspace.
        qtyKeyboard(ev) {
          if (!this.$refs.qtyDlg?.open) return;
          if (ev.ctrlKey || ev.metaKey || ev.altKey) return;
          if (/^[0-9]$/.test(ev.key)) {
            ev.preventDefault();
            this.qtyKey(ev.key);
            return;
          }
          if (ev.key === ',' || ev.key === '.') {
            ev.preventDefault();
            this.qtyKey(',');
            return;
          }
          if (ev.key === 'Backspace') {
            ev.preventDefault();
            this.qtyBackspace();
            return;
          }
          if (ev.key === 'Enter' && !ev.shiftKey && !ev.target?.closest?.('.actions')) {
            ev.preventDefault();
            this.saveQtyDlg();
          }
        },
        saveQtyDlg() {
          const item = this.cart[this.qtyDlg.idx];
          if (!item) { this.$refs.qtyDlg.close(); return; }
          const qty = this.parseQty(this.qtyDlg.raw);
          if (!Number.isFinite(qty) || !(qty > 0)) {
            this.qtyDlg.error = 'Digite uma quantidade maior que zero.';
            return;
          }
          if (!this.qtyDlg.fractional && !Number.isInteger(qty)) {
            this.qtyDlg.error = 'Esta unidade só aceita quantidade inteira.';
            return;
          }
          // Arredonda o PESO para a mesma precisão que aparece no visor (3 casas).
          // Antes o total usava 0,2345 kg enquanto a tela mostrava 0,235 kg, e o
          // valor saía alguns centavos diferente do que o operador via.
          item.qty = this.qtyDlg.fractional ? Math.round(qty * 1000) / 1000 : qty;
          this.persistSlots();
          this.repriceCart();
          this.$refs.qtyDlg.close();
        },
        // ─── Enviar para a cozinha (venda direta) ───
        // A venda ainda não existe, então o ticket usa um id negativo de rascunho;
        // ao concluir, o servidor adota os tickets para o id real da venda.
        hasKitchenItems() {
          const slot = this.slots[this.activeSlot];
          return !slot.comandaId && !slot.quoteId && this.cart.some((i) => i.goesToKitchen);
        },
        hasKitchenPending() {
          const slot = this.slots[this.activeSlot];
          return !slot.comandaId && !slot.quoteId
            && this.cart.some((i) => i.goesToKitchen && i.kitchenSent !== true);
        },
        kitchenSendLabel() {
          return this.hasKitchenPending() ? 'Enviar para cozinha' : 'Cozinha enviada';
        },
        ensureKitchenDraftId() {
          const slot = this.slots[this.activeSlot];
          if (!slot.kitchenDraftId) {
            slot.kitchenDraftId = Math.floor(Math.random() * 1000000000) + 1;
            this.persistSlots();
          }
          return slot.kitchenDraftId;
        },
        async sendToKitchen(silent = false) {
          if (!this.hasKitchenPending() || this.sendingKitchen) return true;
          const items = this.cart.filter((i) => i.goesToKitchen && i.kitchenSent !== true);
          this.sendingKitchen = true;
          try {
            const r = await fetch('/api/store/kitchen/send', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                draftId: this.ensureKitchenDraftId(),
                items: items.map((i) => ({
                  productId: i.productId, name: i.name, qty: i.qty, notes: i.notes || undefined,
                })),
              }),
            });
            const raw = await r.json().catch(() => ({}));
            if (!r.ok || raw.success === false) throw new Error(raw.error || 'Não foi possível enviar para a cozinha.');
            const body = raw.success ? (raw.data || {}) : raw;
            const sent = Number(body.sent ?? 0);
            for (const item of items) {
              item.kitchenSent = true;
              item.kitchenStatus = 'pendente';
            }
            this.persistSlots();
            if (!silent) {
              showToast(
                sent > 0
                  ? `Enviado para a cozinha (${sent} ${sent === 1 ? 'item' : 'itens'}).`
                  : 'Nenhum item deste pedido está roteado para a cozinha.',
                sent > 0 ? 'success' : 'info',
              );
            }
            return true;
          } catch (e) {
            if (!silent) showToast(e.message || 'Não foi possível enviar para a cozinha.', 'error');
            return false;
          } finally {
            this.sendingKitchen = false;
          }
        },
        removeItem(idx) {
          if (this.pinRequiredForRemove()) { this.openPinConfirm(idx); return; }
          this.cart.splice(idx, 1); this.persistSlots();
        },
        pinRequiredForRemove() {
          return this.appSettings?.find((s) => s.key === 'seguranca.pin_remover_item')?.value === '1';
        },
        openPinConfirm(idx) {
          this.pendingRemoveIdx = idx; this.pinInput = ''; this.pinError = '';
          this.$refs.pinDlg.showModal();
          this.$nextTick(() => this.$refs.pinInput.focus());
        },
        async confirmPinRemove() {
          if (!this.pinInput) return;
          const r = await fetch('/api/security/pin/verify', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: this.pinInput }),
          });
          const body = r.ok ? await r.json() : { ok: false };
          if (body.ok) {
            this.cart.splice(this.pendingRemoveIdx, 1);
            this.persistSlots();
            this.$refs.pinDlg.close();
          } else {
            this.pinError = 'PIN incorreto.';
          }
        },
        subtotal() { return this.cart.reduce((a, i) => a + Math.round(i.price_cents * i.qty), 0); },
        total() { return Math.max(0, this.subtotal() - this.discountCents + this.surchargeCents); },

        // ─── Desconto / Acréscimo ───
        maxDiscountPct() {
          const n = Number(this.appSettings?.find((s) => s.key === 'pdv.desconto_maximo_percentual')?.value ?? 0);
          return Number.isFinite(n) && n > 0 ? n : 0;
        },
        discountRequiresReason() {
          return this.appSettings?.find((s) => s.key === 'pdv.desconto_exige_motivo')?.value === '1';
        },
        async verifyPin(pin) {
          if (!pin) return false;
          try {
            const r = await fetch('/api/security/pin/verify', {
              method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin }),
            });
            return r.ok && (await r.json()).ok === true;
          } catch { return false; }
        },
        openValue(kind) {
          this.valueDlg = { kind, amount: '', mode: 'valor', reason: '', pin: '', needPin: false, error: '' };
          this.$refs.value.showModal();
          this.$nextTick(() => this.$refs.valueInput.focus());
        },
        setValueMode(mode) {
          if (this.valueDlg.mode === mode) return;
          this.valueDlg.mode = mode; this.valueDlg.amount = ''; this.valueDlg.error = '';
          this.$nextTick(() => this.$refs.valueInput.focus());
        },
        percentToCents(pct) {
          const p = parseFloat(String(pct || '0').replace(',', '.'));
          if (isNaN(p) || p <= 0) return 0;
          return Math.round(this.subtotal() * (p / 100));
        },
        async saveValue() {
          const v = this.valueDlg.mode === 'valor' ? this.cents(this.valueDlg.amount) : this.percentToCents(this.valueDlg.amount);
          if (v < 0) { this.valueDlg.error = 'Valor inválido.'; return; }
          const reason = (this.valueDlg.reason || '').trim();
          if (this.valueDlg.kind === 'desconto') {
            if (v > this.subtotal() + this.surchargeCents) { this.valueDlg.error = 'Desconto maior que o total.'; return; }
            if (this.discountRequiresReason() && !reason) { this.valueDlg.error = 'Informe o motivo do desconto.'; return; }
            const maxPct = this.maxDiscountPct();
            const pct = this.subtotal() > 0 ? (v / this.subtotal()) * 100 : 0;
            if (maxPct > 0 && pct > maxPct + 0.001) {
              this.valueDlg.needPin = true;
              if (!this.valueDlg.pin) { this.valueDlg.error = `Desconto acima de ${maxPct}% — informe o PIN do administrador.`; return; }
              if (!(await this.verifyPin(this.valueDlg.pin))) { this.valueDlg.error = 'PIN incorreto.'; return; }
            }
            this.discountCents = v;
          } else {
            if (this.discountRequiresReason() && !reason) { this.valueDlg.error = 'Informe o motivo do acréscimo.'; return; }
            this.surchargeCents = v;
          }
          this.discountReason = reason;
          this.$refs.value.close();
          this.focusSearch();
          this.persistSlots();
        },

        // ─── Limpar carrinho ───
        clearCart() {
          if (!this.cart.length) return;
          this.$refs.clearDlg.showModal();
          this.$nextTick(() => this.$refs.clearConfirm.focus());
        },
        doClear() {
          this.cart = []; this.discountCents = 0; this.surchargeCents = 0; this.discountReason = ''; this.customerId = ''; this.customerName = ''; this.customerBalances = {};
          // Limpar o carrinho desfaz o vínculo com o orçamento reaberto — o que sobra é um
          // carrinho vazio, não um orçamento sem itens. O orçamento em si continua aberto.
          this.slots[this.activeSlot].quoteId = null;
          this.slots[this.activeSlot].quoteLabel = null;
          this.slots[this.activeSlot].kitchenDraftId = null;
          this.quoteForm = { validUntil: '', notes: '', error: '', saving: false };
          this.$refs.clearDlg.close();
          this.focusSearch();
          this.persistSlots();
        },

        // ─── Impressão ───
        printLast() {
          if (this.lastSaleId) window.open(`/app/store/vendas/${this.lastSaleId}/cupom`, '_blank', 'width=380,height=600');
        },
        printCarne() {
          if (this.lastSaleId) window.open(`/app/store/vendas/${this.lastSaleId}/carne`, '_blank', 'width=380,height=700');
        },

        // ─── Pagamento ───
        methodName(id) { const m = this.methods.find((x) => x.id === id); return m ? m.name : '?'; },
        methodType(id) { const m = this.methods.find((x) => x.id === id); return m ? m.type : ''; },
        selectedMethod() { return this.methods.find((x) => x.id === this.pay.methodId) || null; },
        selectedType() { return this.methodType(this.pay.methodId); },
        moneyInput(cents) { return (Math.max(0, Math.round(cents || 0)) / 100).toFixed(2).replace('.', ','); },
        paidSum() { return this.pay.list.reduce((a, p) => a + p.amountCents, 0); },
        remaining() { return this.total() - this.paidSum(); },
        customerRequiredType(type) {
          return type === 'prazo' || type === 'convenio' || type === 'credito_loja' || type === 'fidelidade';
        },
        customerRequired() {
          return this.customerRequiredType(this.selectedType())
            || this.pay.list.some((p) => this.customerRequiredType(this.methodType(p.methodId)));
        },
        customerMissing() { return !this.customerId && this.customerRequired(); },
        canConfirm() { return this.remaining() === 0 && !this.saving && !this.customerMissing(); },
        // Fidelidade, convênio e crédito de loja sumiam da tela quando não havia cliente
        // vinculado. O operador não descobria que existiam e ficava com a impressão de que só a
        // venda a prazo dá benefício — era o pedido. Agora aparecem sempre, desabilitados e
        // dizendo o que falta. De quebra, a lista volta a ser exatamente `methods`: o atalho
        // F1..F9 sempre indexou `methods` cru (init(), keydown), então enquanto a lista era
        // filtrada o "F3" impresso no botão podia acionar outra forma de pagamento.
        visibleQuickMethods() {
          return this.methods;
        },
        quickMethodBlock(m) {
          if (!m) return '';
          if (m.type !== 'credito_loja' && m.type !== 'fidelidade' && m.type !== 'convenio') return '';
          if (!this.customerId) return 'Selecione o cliente';
          if (m.type === 'credito_loja') return (this.customerBalances.storeCreditCents || 0) > 0 ? '' : 'Sem crédito';
          if (m.type === 'fidelidade') return (this.customerBalances.loyaltyPoints || 0) > 0 ? '' : 'Sem pontos';
          return this.customerBalances.hasAgreement ? '' : 'Sem convênio';
        },
        selectQuickMethod(m) {
          if (!m || this.quickMethodBlock(m)) return;
          const changed = this.pay.methodId !== m.id;
          this.pay.methodId = m.id;
          this.payError = '';
          this.showSplit = false;
          if (m.type === 'prazo') { this.openPrazoDlg(); return; }
          if (m.type === 'fidelidade') { this.openFidelidadeDlg(); return; }
          if (changed) this.syncAmountToRemaining(true);
        },
        // Preenche o campo da modalidade com o que ainda falta receber. Em dinheiro o
        // campo é "Valor recebido"; nos demais, o valor da parcela. Depois de lançar um
        // pagamento em espécie não pré-preenchemos de novo: isso convidaria a um duplo
        // lançamento por ENTER.
        syncAmountToRemaining(prefillCash = true) {
          const rest = Math.max(0, this.remaining());
          const value = rest > 0 ? this.moneyInput(rest) : '';
          this.pay.amount = value;
          if (this.selectedType() === 'dinheiro') {
            this.pay.received = prefillCash ? value : '';
          } else {
            this.pay.received = '';
          }
        },
        showsAmountField() {
          return !!this.pay.methodId && !['dinheiro', 'prazo', 'fidelidade'].includes(this.selectedType());
        },
        showsAddButton() {
          return this.selectedType() === 'dinheiro' || this.showsAmountField();
        },
        amountFieldLabel() {
          const type = this.selectedType();
          if (type === 'debito' || type === 'credito') return 'Valor da transação';
          if (type === 'pix') return 'Valor a receber';
          if (type === 'credito_loja') return 'Valor a usar';
          if (type === 'convenio') return 'Valor do convênio';
          return 'Valor do pagamento';
        },
        pendingAmount() {
          if (!this.pay.methodId || this.remaining() <= 0) return 0;
          const type = this.selectedType();
          if (type === 'prazo' || type === 'fidelidade') return 0;
          const raw = type === 'dinheiro' ? this.cents(this.pay.received) : this.cents(this.pay.amount);
          return Math.min(Math.max(0, raw), Math.max(0, this.remaining()));
        },
        canAddPayment() {
          const m = this.selectedMethod();
          if (!m || this.quickMethodBlock(m)) return false;
          const type = this.selectedType();
          if (type === 'prazo' || type === 'fidelidade') return false;
          if (this.customerRequiredType(type) && !this.customerId) return false;
          const rest = this.remaining();
          if (rest <= 0) return false;
          const raw = type === 'dinheiro' ? this.cents(this.pay.received) : this.cents(this.pay.amount);
          if (raw <= 0) return false;
          if (type !== 'dinheiro' && raw > rest) return false;
          if (type === 'credito_loja' && Math.min(raw, rest) > (this.customerBalances.storeCreditCents || 0)) return false;
          return true;
        },
        addLabel() {
          const type = this.selectedType();
          if (type === 'dinheiro') {
            return this.cents(this.pay.received) > this.remaining() ? 'Registrar e calcular troco' : 'Registrar recebimento';
          }
          if (type === 'pix') return 'Registrar recebimento';
          if (type === 'credito_loja') return 'Usar crédito';
          if (type === 'convenio') return 'Lançar convênio';
          return 'Adicionar pagamento';
        },
        selectedFee() {
          const m = this.selectedMethod();
          if (!m || !m.fee_bps) return 0;
          return Math.round((this.pendingAmount() * m.fee_bps) / 10000);
        },
        selectedFeeLabel() {
          const m = this.selectedMethod();
          if (!m || !m.fee_bps) return '';
          return 'Taxa ' + (m.fee_bps / 100).toFixed(2).replace('.', ',') + '% · ' + this.brl(this.selectedFee());
        },
        onAmountInput() {
          this.pay.amount = window.maskMoney(this.pay.amount);
          const raw = this.cents(this.pay.amount);
          if (raw > this.remaining()) this.payError = 'Valor maior que o restante.';
          else if (this.selectedType() === 'credito_loja' && raw > (this.customerBalances.storeCreditCents || 0)) {
            this.payError = 'Saldo de crédito de loja insuficiente.';
          } else if (this.payError === 'Valor maior que o restante.' || this.payError === 'Saldo de crédito de loja insuficiente.') {
            this.payError = '';
          }
        },
        onCashInput() {
          this.pay.received = window.maskMoney(this.pay.received);
          this.payError = '';
        },
        cashSuggestions() {
          const rest = this.remaining();
          if (rest <= 0) return [];
          const out = [rest];
          for (const step of [1000, 2000, 5000, 10000]) {
            const v = Math.ceil(rest / step) * step;
            if (v > rest && !out.includes(v)) out.push(v);
          }
          return out.slice(0, 4);
        },
        setCashSuggestion(cents) {
          this.pay.received = this.moneyInput(cents);
          this.payError = '';
        },
        cashFeedbackKind() {
          const rest = this.remaining();
          const received = this.cents(this.pay.received);
          if (rest <= 0) return 'settled';
          if (received <= 0 || received < rest) return 'remaining';
          if (received === rest) return 'exact';
          return 'change';
        },
        cashFeedbackLabel() {
          const kind = this.cashFeedbackKind();
          if (kind === 'change') return 'Troco';
          if (kind === 'exact') return 'Valor exato';
          if (kind === 'settled') return 'Venda paga';
          return 'Falta';
        },
        cashFeedbackValue() {
          const rest = this.remaining();
          const received = this.cents(this.pay.received);
          if (rest <= 0 || received <= 0 || received === rest) return 0;
          return received < rest ? rest - received : received - rest;
        },
        // Troco de pagamentos em dinheiro já lançados: o valor que o cliente entregou
        // menos a parcela efetivamente aplicada na venda.
        registeredChangeCents() {
          return this.pay.list.reduce((sum, p) => {
            if (this.methodType(p.methodId) !== 'dinheiro') return sum;
            return sum + Math.max(0, (p.receivedCents ?? p.amountCents) - p.amountCents);
          }, 0);
        },
        // O painel da direita mostra o troco já lançado e também o que está sendo digitado
        // agora, antes de adicionar — é o que faz o valor acompanhar a digitação.
        changeDue() {
          const preview = this.selectedType() === 'dinheiro' && this.cashFeedbackKind() === 'change'
            ? this.cashFeedbackValue()
            : 0;
          return this.registeredChangeCents() + preview;
        },
        paymentMeta(p) {
          const type = this.methodType(p.methodId);
          if (type === 'dinheiro' && (p.receivedCents || 0) > p.amountCents) return 'Recebido ' + this.brl(p.receivedCents);
          if (type === 'prazo') {
            const n = (p.installments && p.installments.count) || 1;
            const due = p.dueDate ? window.fmtDate(p.dueDate) : '';
            return (n > 1 ? n + 'x' : 'À vista') + (due ? ' · ' + due : '');
          }
          if (type === 'fidelidade') return (p.pointsUsed || 0) + ' pontos';
          return '';
        },
        prazoPayment() { return this.pay.list.find((p) => this.methodType(p.methodId) === 'prazo'); },
        prazoCustomerName() {
          const p = this.prazoPayment();
          if (!p) return '';
          const c = this.customers.find((x) => x.id === p.customerId);
          return c ? c.name : (this.customerName || 'Cliente não identificado');
        },
        prazoSummary() {
          const p = this.prazoPayment();
          if (!p) return '';
          const n = (p.installments && p.installments.count) || 1;
          const due = p.dueDate ? window.fmtDate(p.dueDate) : '';
          return (n > 1 ? n + ' parcelas' : 'À vista') + (due ? ' · 1º vencimento ' + due : '');
        },
        fidelidadePayment() { return this.pay.list.find((p) => this.methodType(p.methodId) === 'fidelidade'); },
        // O campo de cliente é um só: o nome digitado vira vínculo com o cadastro quando
        // bate exatamente com um cliente existente (foi o que a datalist ofereceu), e
        // continua sendo só um nome quando não bate. Reprecificar e recarregar saldos
        // custa uma volta no servidor, então só roda quando o vínculo realmente mudou —
        // não a cada tecla digitada.
        // O texto em si já é persistido pelo $watch('slots') montado no init().
        onCustomerNameInput() {
          const typed = (this.customerName || '').trim().toLowerCase();
          const match = typed ? this.customers.find((c) => (c.name || '').trim().toLowerCase() === typed) : null;
          const nextId = match ? match.id : '';
          if (nextId === this.customerId) return;
          this.customerId = nextId;
          this.repriceCart();
          this.loadCustomerBalances();
        },
        // Busca de cliente por nome/CPF/telefone (a API de clientes já cobre os três).
        async onCustomerInput() {
          this.onCustomerNameInput();
          const term = (this.customerName || '').trim();
          if (term.length < 2) { this.customerSuggestions = []; return; }
          const r = await fetch('/api/commercial/customers?limit=6&active=1&q=' + encodeURIComponent(term));
          if (r.ok) this.customerSuggestions = await r.json();
        },
        pickCustomer(c) {
          this.customerId = c.id;
          this.customerName = c.name;
          this.customerSuggestions = [];
          this.repriceCart();
          this.loadCustomerBalances();
        },
        openCustomerDlg() {
          this.customerDlg = { name: (this.customerName || '').trim(), document: '', phone: '', error: '', saving: false };
          this.$refs.customerDlg.showModal();
        },
        async saveCustomerDlg() {
          if (!this.customerDlg.name.trim()) { this.customerDlg.error = 'Informe o nome.'; return; }
          this.customerDlg.saving = true; this.customerDlg.error = '';
          const r = await fetch('/api/commercial/customers', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: this.customerDlg.name.trim(),
              document: this.customerDlg.document || undefined,
              phone: this.customerDlg.phone || undefined,
            }),
          });
          this.customerDlg.saving = false;
          if (!r.ok) { this.customerDlg.error = (await r.json()).error ?? 'Erro ao cadastrar.'; return; }
          const c = await r.json();
          this.customers.push(c);
          this.pickCustomer(c);
          this.$refs.customerDlg.close();
          showToast('Cliente cadastrado.', 'success');
        },
        // ─── Preço por item (desconto/acréscimo na linha) ───
        openPriceDlg(idx) {
          const i = this.cart[idx];
          if (!i) return;
          this.priceDlg = { idx, value: (i.price_cents / 100).toFixed(2).replace('.', ','), original: i.price_cents, error: '' };
          this.$refs.priceDlg.showModal();
          this.$nextTick(() => this.$refs.priceInput?.focus());
        },
        savePriceDlg() {
          const i = this.cart[this.priceDlg.idx];
          if (!i) { this.$refs.priceDlg.close(); return; }
          const cents = this.cents(this.priceDlg.value);
          if (cents < 0) { this.priceDlg.error = 'Valor inválido.'; return; }
          i.price_cents = cents;
          i.priceOverridden = true;
          this.persistSlots();
          this.$refs.priceDlg.close();
          this.focusSearch();
        },
        async loadCustomerBalances() {
          if (!this.customerId) { this.customerBalances = {}; return; }
          const r = await fetch(`/api/commercial/customers/${this.customerId}`);
          if (r.ok) {
            const c = await r.json();
            this.customerBalances = { storeCreditCents: c.store_credit_cents || 0, loyaltyPoints: c.loyalty_points || 0, hasAgreement: !!c.agreement_company_id };
          } else this.customerBalances = {};
        },
        centsPerPointClient() {
          const pontos = Number(this.appSettings?.find((s) => s.key === 'fidelidade.pontos_resgate')?.value ?? 100);
          const valor = Number(this.appSettings?.find((s) => s.key === 'fidelidade.valor_resgate_cents')?.value ?? 500);
          return pontos > 0 ? valor / pontos : 0;
        },
        async openPay() {
          this.payError = '';
          this.pay.list = [];
          this.pay.received = '';
          this.pay.clientRequestId = (window.crypto && window.crypto.randomUUID) ? window.crypto.randomUUID() : (Date.now() + '-' + Math.random());
          this.showSplit = false;
          // Reabre na última forma usada, desde que ainda esteja disponível; senão cai na
          // primeira que não depende de cliente/saldo.
          const current = this.methods.find((m) => m.id === this.pay.methodId && !this.quickMethodBlock(m));
          const first = current || this.methods.find((m) => !this.quickMethodBlock(m)) || this.methods[0];
          if (first) {
            this.pay.methodId = first.id;
            this.syncAmountToRemaining(true);
          }
          if (!this.customers.length) {
            const r = await fetch('/api/commercial/customers');
            if (r.ok) this.customers = await r.json();
          }
          this.$refs.pay.showModal();
        },
        addPayment() {
          const method = this.selectedMethod();
          const type = this.selectedType();
          if (!method) { this.payError = 'Escolha a forma de pagamento.'; return; }
          if (type === 'prazo') { this.openPrazoDlg(); return; }
          if (type === 'fidelidade') { this.openFidelidadeDlg(); return; }
          const block = this.quickMethodBlock(method);
          if (block) { this.payError = block; return; }
          const rest = this.remaining();
          if (rest <= 0) { this.payError = 'Venda já está totalmente paga.'; return; }
          const raw = type === 'dinheiro' ? this.cents(this.pay.received) : this.cents(this.pay.amount);
          if (raw <= 0) {
            this.payError = type === 'dinheiro' ? 'Informe o valor recebido.' : 'Informe o valor do pagamento.';
            return;
          }
          if (type !== 'dinheiro' && raw > rest) { this.payError = 'Valor maior que o restante.'; return; }
          if (this.customerRequiredType(type) && !this.customerId) {
            this.payError = 'Selecione o cliente para esta forma de pagamento.'; return;
          }
          // Em dinheiro o valor recebido pode passar do restante: a diferença é o troco.
          const amount = type === 'dinheiro' ? Math.min(raw, rest) : raw;
          if (type === 'credito_loja' && amount > (this.customerBalances.storeCreditCents || 0)) {
            this.payError = 'Saldo de crédito de loja insuficiente.'; return;
          }
          this.payError = '';
          const extra = (type === 'credito_loja' || type === 'convenio') ? { customerId: this.customerId || undefined } : {};
          const payment = { methodId: method.id, amountCents: amount, ...extra };
          if (type === 'dinheiro') payment.receivedCents = Math.max(amount, raw);
          this.pay.list.push(payment);
          this.showSplit = false;
          this.syncAmountToRemaining(type !== 'dinheiro');
        },
        editPayment(idx) {
          const p = this.pay.list[idx];
          if (!p) return;
          const type = this.methodType(p.methodId);
          this.pay.methodId = p.methodId;
          this.payError = '';
          this.showSplit = false;
          if (type === 'prazo') { this.openPrazoDlg(); return; }
          if (type === 'fidelidade') { this.openFidelidadeDlg(); return; }
          // Devolve o pagamento para o campo: o operador corrige e lança de novo. Em
          // dinheiro volta o valor ENTREGUE (não a parcela), para o troco ser recalculado.
          this.pay.list.splice(idx, 1);
          if (type === 'dinheiro') {
            this.pay.amount = this.moneyInput(this.remaining());
            this.pay.received = this.moneyInput(p.receivedCents ?? p.amountCents);
          } else {
            this.pay.amount = this.moneyInput(p.amountCents);
            this.pay.received = '';
          }
        },
        removePayment(idx) {
          const removed = this.pay.list[idx];
          if (!removed) return;
          this.pay.list.splice(idx, 1);
          // Devolve a forma removida como selecionada e joga o restante de volta no campo,
          // pronto pra reeditar/readicionar.
          this.pay.methodId = removed.methodId;
          this.payError = '';
          this.showSplit = false;
          this.syncAmountToRemaining(true);
        },
        splitEqual() {
          const n = this.pay.split;
          if (!n || n < 2) return;
          const method = this.selectedMethod();
          const type = this.selectedType();
          if (!method) { this.payError = 'Escolha a forma de pagamento.'; return; }
          if (type === 'prazo' || type === 'fidelidade') {
            this.payError = 'Divida com uma forma de pagamento à vista.'; return;
          }
          const block = this.quickMethodBlock(method);
          if (block) { this.payError = block; return; }
          if (this.customerRequiredType(type) && !this.customerId) {
            this.payError = 'Selecione o cliente para esta forma de pagamento.'; return;
          }
          if (type === 'credito_loja' && this.total() > (this.customerBalances.storeCreditCents || 0)) {
            this.payError = 'Saldo de crédito de loja insuficiente.'; return;
          }
          this.pay.list = [];
          const base = Math.floor(this.total() / n);
          for (let i = 0; i < n; i++) {
            const amount = i === 0 ? this.total() - base * (n - 1) : base;
            if (amount > 0) {
              const payment = { methodId: method.id, amountCents: amount };
              if (type === 'dinheiro') payment.receivedCents = amount;
              if (type === 'credito_loja' || type === 'convenio') payment.customerId = this.customerId || undefined;
              this.pay.list.push(payment);
            }
          }
          this.pay.amount = '';
          this.pay.received = '';
          this.showSplit = false;
          this.payError = '';
        },
        paidFees() {
          return this.pay.list.reduce((s, p) => {
            const m = this.methods.find((x) => x.id === p.methodId);
            return s + (m ? Math.round((p.amountCents * m.fee_bps) / 10000) : 0);
          }, 0);
        },
        prazoMax() {
          const n = Number(this.appSettings?.find((s) => s.key === 'pdv.parcelas_max')?.value ?? 12);
          return Number.isFinite(n) && n > 0 ? Math.min(Math.floor(n), 24) : 12;
        },

        // ─── Venda a prazo (parcelamento) ───
        openPrazoDlg() {
          const existing = this.pay.list.find((p) => this.methodType(p.methodId) === 'prazo');
          const amt = existing ? existing.amountCents : (this.remaining() > 0 ? this.remaining() : this.total());
          this.prazoForm = {
            customerId: (existing && existing.customerId) || this.customerId || '',
            mode: existing && existing.installments ? 'parcelado' : 'avista',
            installments: (existing && existing.installments && existing.installments.count) || 3,
            firstDueDate: (existing && existing.dueDate) || new Date(Date.now() + 30 * 24 * 3600e3).toISOString().slice(0, 10),
            amountCents: amt,
          };
          this.prazoError = '';
          this.$refs.prazoDlg.showModal();
        },
        // O vínculo acontece na ESCOLHA, não no confirmar, porque vincular reprecifica o
        // carrinho (tabela de preço do cliente) e o servidor re-resolve os mesmos preços ao
        // fechar. Se o vínculo fosse feito só no fim, o total mudaria depois dos pagamentos
        // prontos e a venda seria recusada por "pagamentos não fecham o total".
        async onPrazoCustomerChange() {
          const c = this.customers.find((x) => x.id === this.prazoForm.customerId);
          if (!c || this.customerId === c.id) return;
          this.customerId = c.id;
          this.customerName = c.name;
          await this.repriceCart();
          await this.loadCustomerBalances();
          const rest = this.remaining();
          this.prazoForm.amountCents = rest > 0 ? rest : this.total();
        },
        prazoPreview() {
          const count = this.prazoForm.mode === 'parcelado' ? Math.max(2, Number(this.prazoForm.installments) || 2) : 1;
          const amt = this.prazoForm.amountCents || 0;
          const base = Math.floor(amt / count);
          const rem = amt - base * count;
          const out = [];
          for (let i = 0; i < count; i++) {
            const d = new Date((this.prazoForm.firstDueDate || new Date().toISOString().slice(0, 10)) + 'T00:00:00Z');
            d.setUTCDate(d.getUTCDate() + 30 * i);
            out.push({ n: i + 1, count, dueDate: d.toISOString().slice(0, 10), amountCents: i === 0 ? base + rem : base });
          }
          return out;
        },
        confirmPrazoDlg() {
          if (!this.prazoForm.customerId) { this.prazoError = 'Selecione o cliente.'; return; }
          const count = this.prazoForm.mode === 'parcelado' ? Number(this.prazoForm.installments) : 1;
          if (this.prazoForm.mode === 'parcelado' && (count < 2 || count > this.prazoMax())) { this.prazoError = `Parcelamento deve ser de 2 a ${this.prazoMax()} vezes.`; return; }
          if (!this.prazoForm.firstDueDate) { this.prazoError = 'Informe o vencimento.'; return; }
          const prazoMethod = this.methods.find((m) => m.type === 'prazo');
          if (!prazoMethod) { this.prazoError = 'Nenhuma forma de pagamento "a prazo" ativa.'; return; }
          this.pay.list = this.pay.list.filter((p) => this.methodType(p.methodId) !== 'prazo');
          this.pay.list.push({
            methodId: prazoMethod.id, amountCents: this.prazoForm.amountCents,
            customerId: this.prazoForm.customerId, dueDate: this.prazoForm.firstDueDate,
            installments: count > 1 ? { count, firstDueDate: this.prazoForm.firstDueDate } : undefined,
          });
          // Rede de segurança: se por algum caminho o vínculo não foi feito na escolha
          // (onPrazoCustomerChange), faz aqui — sem ele `sales.customer_id` sai NULL e a venda
          // a prazo não pontua fidelidade. Sem reprecificar: os valores já foram fechados.
          const prazoCustomer = this.customers.find((c) => c.id === this.prazoForm.customerId);
          if (prazoCustomer && this.customerId !== prazoCustomer.id) {
            this.customerId = prazoCustomer.id;
            this.customerName = prazoCustomer.name;
            this.loadCustomerBalances();
          }
          this.syncAmountToRemaining(false);
          this.$refs.prazoDlg.close();
        },

        // ─── Pagamento com pontos de fidelidade ───
        openFidelidadeDlg() {
          // Ao editar, o valor já lançado volta para a base do cálculo; senão o diálogo
          // limitaria os pontos ao que sobrou DEPOIS do próprio pagamento.
          const existing = this.fidelidadePayment();
          const base = this.remaining() + (existing ? existing.amountCents : 0);
          const maxByRemaining = this.centsPerPointClient() > 0 ? Math.ceil(base / this.centsPerPointClient()) : 0;
          const available = this.customerBalances.loyaltyPoints || 0;
          this.fidelidadeForm = {
            pointsUsed: existing ? (existing.pointsUsed || 0) : Math.max(0, Math.min(available, maxByRemaining)),
          };
          this.fidelidadeError = '';
          this.$refs.fidelidadeDlg.showModal();
        },
        confirmFidelidadeDlg() {
          const pts = Number(this.fidelidadeForm.pointsUsed);
          if (!pts || pts <= 0) { this.fidelidadeError = 'Informe quantos pontos usar.'; return; }
          if (pts > (this.customerBalances.loyaltyPoints || 0)) { this.fidelidadeError = 'Saldo de pontos insuficiente.'; return; }
          const existing = this.fidelidadePayment();
          const amountCents = Math.round(pts * this.centsPerPointClient());
          const max = this.remaining() + (existing ? existing.amountCents : 0);
          if (amountCents > max) { this.fidelidadeError = 'Valor maior que o restante.'; return; }
          const method = this.methods.find((m) => m.type === 'fidelidade');
          if (!method) { this.fidelidadeError = 'Forma de pagamento "Pontos de fidelidade" não está ativa.'; return; }
          this.pay.list = this.pay.list.filter((p) => this.methodType(p.methodId) !== 'fidelidade');
          this.pay.list.push({ methodId: method.id, amountCents, pointsUsed: pts, customerId: this.customerId || undefined });
          this.syncAmountToRemaining(false);
          this.$refs.fidelidadeDlg.close();
        },

        async cancelComanda() {
          const comandaId = this.slots[this.activeSlot].comandaId;
          if (!comandaId || !await window.confirmDlg('Cancelar esta comanda? Os itens serão perdidos.')) return;
          const r = await fetch('/api/comandas/comandas/' + comandaId + '/cancel', { method: 'POST' });
          if (r.ok) {
            this.slots[this.activeSlot].comandaId = null;
            this.slots[this.activeSlot].cart = [];
            this.persistSlots();
            window.location.href = '/app/comandas/mesas';
          } else {
            const err = (await r.json()).error ?? 'Erro ao cancelar.';
            showToast(err, 'error');
          }
        },
        async finish() {
          if (this.saving || !this.canConfirm()) return;
          this.saving = true; this.payError = '';
          const directSale = !this.slots[this.activeSlot].comandaId && !this.slots[this.activeSlot].quoteId;
          // Garante que os itens de cozinha já saíram antes de a venda existir. Se o
          // envio falhar, não fecha a venda: o operador precisa saber que a cozinha
          // não recebeu o pedido.
          if (directSale && this.hasKitchenPending()) {
            const okKitchen = await this.sendToKitchen(true);
            if (!okKitchen) {
              this.saving = false;
              this.payError = 'Não foi possível enviar para a cozinha. Tente de novo.';
              return;
            }
          }
          const hasCarne = this.pay.list.some((p) => p.installments && p.installments.count > 1);
          const payments = this.pay.list.map((p) => {
            const out = { methodId: p.methodId, amountCents: p.amountCents };
            // O valor entregue é por pagamento: com dois recebimentos em dinheiro, cada um
            // carrega o próprio troco. O campo global não existe mais.
            if (this.methodType(p.methodId) === 'dinheiro') {
              out.receivedCents = Math.max(p.amountCents, p.receivedCents ?? p.amountCents);
            }
            if (p.customerId) out.customerId = p.customerId;
            if (p.dueDate) out.dueDate = p.dueDate;
            if (p.installments) out.installments = p.installments;
            if (p.pointsUsed) out.pointsUsed = p.pointsUsed;
            return out;
          });
          const comandaId = this.slots[this.activeSlot].comandaId;
          const quoteId = this.slots[this.activeSlot].quoteId;
          let r;
          // Só vai o nome livre: com cliente cadastrado o servidor copia o nome do cadastro.
          const freeName = this.customerId ? undefined : ((this.customerName || '').trim() || undefined);
          const commonBody = {
            payments,
            discountCents: this.discountCents || undefined,
            surchargeCents: this.surchargeCents || undefined,
            discountReason: this.discountReason || undefined,
            customerId: this.customerId || undefined,
            customerName: freeName,
            clientRequestId: this.pay.clientRequestId || undefined,
          };
          if (directSale) {
            const kitchenDraftId = this.slots[this.activeSlot].kitchenDraftId;
            if (kitchenDraftId) {
              // Os itens já foram enviados pelo rascunho; a venda apenas adota os
              // tickets, sem criar um segundo pedido na cozinha.
              commonBody.skipKitchenNotify = true;
              commonBody.kitchenDraftId = kitchenDraftId;
            }
          }
          if (!comandaId) {
            commonBody.items = this.cart.map((i) => ({
              productId: i.productId, qty: i.qty, notes: i.notes || undefined, lineGroupUuid: i.lineGroupUuid || undefined,
              // Só envia o preço da linha quando o operador o alterou de propósito (desconto
              // por item). Sem isso, o servidor re-resolve o preço de catálogo — e nos
              // complementos ele aplica o override/catálogo do grupo.
              unitPriceCents: i.priceOverridden ? i.price_cents : undefined,
            }));
          }
          if (comandaId) {
            // A comanda é a fonte da verdade do preço congelado (inclusive complementos).
            // O carrinho aqui é só espelho e não pode ser editado, então o servidor lê os
            // itens do banco e recalcula o override dos adicionais ao fechar.
            r = await fetch(`/api/comandas/comandas/${comandaId}/close`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(commonBody) });
          } else if (quoteId) {
            // Faturar o orçamento: os itens vão com o preço cotado (o servidor honra via
            // allowPriceOverride) e o desconto/acréscimo vêm do próprio orçamento.
            r = await fetch(`/api/store/quotes/${quoteId}/convert`, {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                items: this.quoteItemsPayload(),
                payments, customerId: this.customerId || undefined,
                customerName: freeName,
                clientRequestId: this.pay.clientRequestId || undefined,
              }),
            });
          } else {
            r = await fetch('/api/store/sales', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(commonBody) });
          }
          this.saving = false;
          if (r.ok) {
            const d = await r.json();
            this.lastSaleId = comandaId ? d.saleId : d.id;
            this.lastSaleHasCarne = hasCarne;
            this.$refs.pay.close();
            this.beep(true);
            this.cart = []; this.discountCents = 0; this.surchargeCents = 0; this.discountReason = ''; this.customerId = ''; this.customerName = ''; this.customerBalances = {};
            if (comandaId) { this.slots[this.activeSlot].comandaId = null; this.justClosedComandaId = comandaId; }
            if (quoteId) {
              this.slots[this.activeSlot].quoteId = null;
              this.slots[this.activeSlot].quoteLabel = null;
              this.quoteForm = { validUntil: '', notes: '', error: '', saving: false };
            }
            this.slots[this.activeSlot].kitchenDraftId = null;
            this.persistSlots();
            const exibir = this.appSettings?.find(s => s.key === 'vendas.exibir_cupom_fiscal')?.value;
            const autoPrint = this.appSettings?.find(s => s.key === 'pdv.imprimir_automatico')?.value === '1';
            if (exibir === '0') { this.onPostSaleClose(); }
            else if (autoPrint) { this.printLast(); this.onPostSaleClose(); }
            else this.$refs.postSale.showModal();
          } else {
            const err = (await r.json()).error ?? 'Erro ao registrar a venda.';
            this.beep(false);
            this.payError = err;
            <% if (user.permissions.has('finance.cash.open')) { %>
            if (err.includes('Abra o caixa')) this.$refs.cashClosedWarnDlg.showModal();
            <% } %>
          }
        },

        // ─── Abrir caixa sem perder a venda em andamento ───
        openRegisterFromSale() {
          this.openRegisterForm = { opening: '', error: '' };
          this.$refs.openRegisterDlg.showModal();
          this.$nextTick(() => this.$refs.openRegisterInput.focus());
        },
        async confirmOpenRegister() {
          const r = await fetch('/api/finance/cash/open', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ openingCents: this.cents(this.openRegisterForm.opening) }),
          });
          if (r.ok) {
            this.$refs.openRegisterDlg.close();
            this.payError = '';
          } else {
            this.openRegisterForm.error = (await r.json()).error ?? 'Erro ao abrir o caixa.';
          }
        },
      };
    }
  </script>
  <script nonce="<%= cspNonce %>">
    // Tour guiado do PDV (motor em /js/tour.js). Aparece uma vez por máquina e pode ser
    // reaberto pelo botão "Rever tour" no rodapé. Passos cujo alvo não existe — botão sem
    // permissão, por exemplo — são pulados pelo próprio motor.
    (function () {
      var TOUR_KEY = 'kivo-tour-pdv-v1';

      function pdvTourSteps() {
        return [
          { el: '#tour-pdv-abas', title: 'Várias vendas ao mesmo tempo', body: 'Cada aba é uma venda independente — ótimo para atender mais de um cliente sem perder o carrinho. O "+ Nova venda" abre outra e o × fecha.' },
          { el: '#tour-pdv-busca', title: 'Bipe ou busque o produto', body: 'Passe o leitor de código de barras ou digite nome/SKU. A lista aparece enquanto você digita; setas ↑ ↓ escolhem e Enter adiciona.' },
          { el: '#tour-pdv-carrinho', title: 'Carrinho', body: 'Os itens entram aqui. Ajuste a quantidade no +/−, remova no ×, ou clique no item para editar. Cliente e observações ficam em cada linha.' },
          { el: '#tour-pdv-cliente', title: 'Cliente (opcional)', body: 'Digite o nome para identificar a venda. Se bater com um cliente cadastrado, o vínculo é feito sozinho e valem pontos, crédito de loja e convênio.' },
          { el: '#tour-pdv-acoes', title: 'Desconto e acréscimo', body: 'Desconto (F4), acréscimo (F7), orçamento (F6), imprimir (F11), calculadora (F3) e limpar (F9). O desconto acima do limite pede o PIN do administrador.' },
          { el: '#tour-pdv-finalizar', title: 'Adicionar pagamento (F2)', body: 'Abre o pagamento: escolha a forma, divida a conta, calcule o troco e confirme. O cupom sai na impressora configurada.' },
          { el: '#tour-pdv-atalhos', title: 'Atalhos do teclado', body: 'Tudo o que se faz o dia inteiro tem atalho. Decorando esses, a venda sai sem tirar a mão do teclado.' },
        ];
      }

      function startPdvTour() {
        if (!window.KivoTour) return;
        window.KivoTour.start(pdvTourSteps());
      }
      window.startPdvTour = startPdvTour;

      var rever = document.getElementById('tour-rever');
      if (rever) rever.addEventListener('click', startPdvTour);

      // Os alvos do tour são estáticos (barra, busca, resumo), então não precisa esperar o
      // init() carregar dados — só um respiro para a tela pintar.
      setTimeout(function () {
        if (!window.KivoTour || window.KivoTour.isActive()) return;
        if (document.querySelector('dialog[open]')) return;
        window.KivoTour.autoStart(TOUR_KEY, pdvTourSteps(), {
          // Fim do tutorial: confete e parabéns (motor em /js/tour.js).
          celebrate: {
            title: 'Venda dominada! 🎉',
            body: 'Você já sabe o caminho da venda: buscar, montar o carrinho, escolher a forma de pagamento e finalizar. Bons negócios!',
          },
        });
      }, 900);
    })();
  </script>
</body>
</html>
