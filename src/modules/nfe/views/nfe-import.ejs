<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Importar NF-e</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/nfe/importar' }) %>
  <main x-data="nfeImportPage(<%- JSON.stringify(user.permissions.has('nfe.import.run')) %>)" x-init="init()">
    <h1 x-text="editingId ? 'Editar importação de NF-e' : 'Importar NF-e'">Importar NF-e</h1>
    <p class="muted" x-show="!editingId">Envie o XML da nota do fornecedor (NF-e modelo 55, versão 4.00). Nada é alterado antes da sua conferência.</p>
    <p class="muted" x-show="editingId" x-cloak>Altere a conferência e salve. A versão anterior é estornada e a nova é aplicada na mesma nota.</p>

    <%# ── Passo 1: escolher o arquivo ── %>
    <div x-show="!preview" x-cloak>
      <div class="panel nfe-upload">
        <h2>Escolha o arquivo</h2>
        <p class="muted text-sm">Envie o XML da NF-e (modelo 55, versão 4.00) ou cole o conteúdo abaixo.</p>
        <div class="nfe-upload-row">
          <input type="file" accept=".xml,.XML,text/xml,application/xml" x-ref="file"
                 style="display:none" @change="onFile($event.target.files)" />
          <button class="btn" @click="$refs.file.click()" :disabled="parsing">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span x-text="parsing ? 'Lendo o XML…' : 'Escolher arquivo XML'"></span>
          </button>
          <span class="muted text-sm">ou cole o XML abaixo</span>
        </div>
        <textarea x-ref="pasteXml" rows="6" class="input nfe-paste" placeholder="<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>…"></textarea>
        <div class="nfe-upload-actions">
          <span class="error" x-text="error"></span>
          <button class="btn secondary" @click="previewPasted()" :disabled="parsing">
            <span x-text="parsing ? 'Analisando…' : 'Analisar XML'"></span>
          </button>
        </div>
      </div>

      <%# Histórico recente ── %>
      <h2 class="nfe-section-title">Importações recentes</h2>
      <div class="nfe-table-card" x-show="history.length">
        <table class="nfe-table">
          <thead><tr><th>NF-e</th><th>Fornecedor</th><th>Emitida em</th><th class="num">Total</th><th class="num">Itens aceitos</th><th></th></tr></thead>
          <tbody>
            <template x-for="h in history" :key="h.id">
              <tr>
                <td>
                  <div x-text="'NF ' + (h.invoice_number || '') + (h.series ? '/S' + h.series : '')"></div>
                  <div class="muted text-xs" style="font-family:var(--font-mono,monospace)" x-text="h.access_key"></div>
                </td>
                <td x-text="h.supplier_name || '—'"></td>
                <td x-text="h.issued_at || '—'"></td>
                <td class="num" x-text="brl(h.total_cents)"></td>
                <td class="num" x-text="h.imported_count + ' / ' + h.items_count"></td>
                <td class="num">
                  <div class="nfe-row-actions">
                    <a class="btn small secondary" :href="'/api/nfe/invoices/' + h.id + '/xml'"
                       title="Baixar o XML desta NF-e (original do fornecedor)">XML</a>
                    <button type="button" class="btn small secondary" x-show="canRun"
                            @click="edit(h)"
                            title="Editar esta importação (trocar vínculos, quantidades, custos e preços)">
                      Editar
                    </button>
                    <button type="button" class="btn small secondary" x-show="canRun"
                            @click="revert(h)" :disabled="reverting === h.id"
                            title="Desfazer esta importação (volta estoque, custo e remove o que ela criou)">
                      <span x-text="reverting === h.id ? 'Revertendo…' : 'Desfazer'"></span>
                    </button>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <div x-show="!history.length" x-cloak>
        <%- include('partials/empty-state', { message: 'Nenhuma NF-e importada ainda.' }) %>
      </div>
    </div>

    <%# ── Passo 2: conferência ── %>
    <div x-show="preview" x-cloak>
      <section class="panel nfe-head">
        <div class="nfe-head-supplier">
          <span class="nfe-head-label">Fornecedor</span>
          <strong x-text="preview ? (preview.supplier.name || '—') : ''"></strong>
          <div class="nfe-head-sub">
            <span class="muted text-xs" x-text="preview ? ('CNPJ ' + preview.supplier.cnpj) : ''"></span>
            <span class="badge neutral nfe-badge-info" x-show="preview && !preview.supplier.exists"
                  title="O fornecedor ainda não existe no Kivo. Ele será cadastrado automaticamente com os dados da nota (razão social, CNPJ, IE e endereço).">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
              Fornecedor novo — será cadastrado
            </span>
            <span class="badge ok" x-show="preview && preview.supplier.exists">Fornecedor cadastrado</span>
          </div>
        </div>
        <div class="nfe-head-meta">
          <div>
            <span class="nfe-head-label">NF-e</span>
            <span x-text="preview ? ('nº ' + (preview.number || '—') + (preview.serie ? ' · Série ' + preview.serie : '')) : ''"></span>
          </div>
          <div>
            <span class="nfe-head-label">Emissão</span>
            <span x-text="preview && preview.issuedAt ? preview.issuedAt.slice(0, 10) : '—'"></span>
          </div>
          <div>
            <span class="nfe-head-label">Total da nota</span>
            <strong x-text="preview ? brl(preview.totalCents) : ''"></strong>
          </div>
        </div>
      </section>

      <div class="nfe-filters">
        <div class="nfe-tabs" role="tablist">
          <button type="button" class="nfe-tab" :class="{ active: filter === 'todas' }" @click="filter = 'todas'">
            Todos <span class="nfe-tab-count" x-text="tabCount('todas')"></span>
          </button>
          <button type="button" class="nfe-tab" :class="{ active: filter === 'revisar' }" @click="filter = 'revisar'">
            Precisam de atenção <span class="nfe-tab-count" x-text="tabCount('revisar')"></span>
          </button>
          <button type="button" class="nfe-tab" :class="{ active: filter === 'reconhecidas' }" @click="filter = 'reconhecidas'">
            Reconhecidos <span class="nfe-tab-count" x-text="tabCount('reconhecidas')"></span>
          </button>
          <button type="button" class="nfe-tab" :class="{ active: filter === 'ignoradas' }" @click="filter = 'ignoradas'">
            Ignorados <span class="nfe-tab-count" x-text="tabCount('ignoradas')"></span>
          </button>
        </div>
        <span class="toolbar-spacer"></span>
        <button type="button" class="btn small secondary" @click="criarTodosNovos()" :disabled="newCount === 0"
                :title="newCount ? 'Marca todos os itens novos para criar' : 'Nenhum item novo'">
          <span x-text="newCount ? 'Criar todos os novos (' + newCount + ')' : 'Criar todos os novos'"></span>
        </button>
        <label class="nfe-markup" title="Markup aplicado sobre o custo para sugerir o preço de venda">
          <span class="muted text-xs">Markup sugerido</span>
          <input type="text" inputmode="decimal" class="input nfe-input-sm" x-model="markupPct"
                 @change="onMarkupChange()" :disabled="!canRun" />
          <span class="muted text-xs">%</span>
        </label>
        <button type="button" class="btn small secondary" @click="applySuggestions()" :disabled="suggestionDiffCount === 0"
                :title="suggestionDiffCount ? 'Devolve as linhas à sugestão do sistema' : 'Nenhuma linha divergindo da sugestão'">
          <span x-text="suggestionDiffCount ? 'Aplicar sugestões (' + suggestionDiffCount + ')' : 'Aplicar sugestões'"></span>
        </button>
      </div>

      <%# Progresso da conferência: reforça o status do rodapé e dá noção de quanto falta. %>
      <div class="nfe-progress" x-show="rows.length" x-cloak>
        <div class="nfe-progress-track"><span :style="'width:' + progressPct + '%'"></span></div>
        <span class="muted text-xs" x-text="acceptedCount + ' de ' + rows.length + ' itens marcados para importar'"></span>
        <span class="muted text-xs" x-show="conflictCount">· <strong x-text="conflictCount"></strong> com conflito a revisar</span>
        <span class="muted text-xs" x-show="novosTotal">· <strong x-text="novosTotal"></strong> produto(s) novo(s)</span>
      </div>

      <div class="nfe-table-card">
      <table class="nfe-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Item da nota</th>
            <th>Produto no Kivo / ação</th>
            <th>Qtd. e conversão</th>
            <th>Custo</th>
            <th>Preço de venda</th>
            <th class="num">Total</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="row in visibleRows" :key="row.line">
            <tr :class="{ 'nfe-ignored': row.action === 'ignore', 'nfe-attention': (row.flags.length > 0 || row.error || rowNeedsConversion(row)) && row.action !== 'ignore' }">
              <td class="muted" x-text="row.line"></td>
              <td style="min-width:200px">
                <div class="nfe-item-head">
                  <span class="badge nfe-reason" :class="'nfe-reason-' + rowReason(row).tone"
                        x-show="rowReason(row).label" :title="rowReason(row).hint">
                    <span x-text="rowReason(row).icon"></span><span x-text="rowReason(row).label"></span>
                  </span>
                  <span style="font-weight:600" x-text="row.description"></span>
                </div>
                <div class="muted text-xs" x-text="'Cód. ' + row.cProd + (row.ean ? ' · EAN ' + row.ean : '')"></div>
                <div class="muted text-xs" x-text="[row.ncm && ('NCM ' + row.ncm), row.cfop && ('CFOP ' + row.cfop), row.unit].filter(Boolean).join(' · ')"></div>
                <div style="margin-top:.2rem">
                  <template x-for="f in row.flags" :key="f">
                    <span class="badge nfe-flag" x-text="flagLabel(f)" :title="flagLabel(f)"></span>
                  </template>
                  <span class="badge neutral" x-show="row.error" x-text="row.error"></span>
                  <span class="badge nfe-flag" x-show="row.eanBox" title="EAN da caixa — não vira o código do produto">EAN de caixa</span>
                </div>
              </td>
              <td style="min-width:270px">
                <div class="nfe-acts">
                  <button type="button" class="btn small" :class="row.action === 'link' ? 'active' : ''"
                          @click="setAction(row, 'link')" :disabled="row.kind === 'invalid'">Vincular</button>
                  <button type="button" class="btn small" :class="row.action === 'create' ? 'active' : ''"
                          @click="setAction(row, 'create')" :disabled="row.kind === 'invalid'">Criar</button>
                  <button type="button" class="btn small" :class="row.action === 'ignore' ? 'active danger' : ''"
                          @click="setAction(row, 'ignore')">Ignorar</button>
                </div>
                <div x-show="row.action === 'link' && row.productId" class="text-sm" style="margin-top:.35rem">
                  <span class="badge ok" x-text="row.productName"></span>
                  <button type="button" class="btn-link" @click="openSearch(row)">Trocar produto…</button>
                </div>
                <div x-show="row.action === 'link' && !row.productId" class="text-sm" style="margin-top:.35rem">
                  <button type="button" class="btn small secondary" @click="openSearch(row)">Buscar produto…</button>
                </div>
                <div x-show="row.action === 'create'" class="text-sm" style="margin-top:.35rem">
                  <span class="muted text-xs">Novo produto · venda em <strong x-text="row.saleUnit"></strong></span>
                  <div class="nfe-conv" x-show="categories.length">
                    <span class="muted text-xs">Categoria</span>
                    <select class="input nfe-input-sm" style="width:auto" x-model="row.categoryId">
                      <option value="">Sem categoria</option>
                      <template x-for="c in categories" :key="c.id"><option :value="c.id" x-text="c.name"></option></template>
                    </select>
                  </div>
                </div>
                <div x-show="row.action === 'ignore'" class="muted text-sm">linha ignorada — não vira compra</div>
              </td>
              <td style="min-width:135px">
                <div class="nfe-qty-line">
                  <input type="number" min="0" step="any" x-model="row.qty" :disabled="row.action === 'ignore'" class="input nfe-input" />
                  <span class="muted text-xs" x-text="row.unit || 'un'"></span>
                </div>
                <template x-if="row.action !== 'ignore' && (row.conversionUnit || row.conversionSource === 'needs_input')">
                  <div class="nfe-conv">
                    <span class="muted text-xs">1 <span x-text="(row.conversionUnit || row.unit || '').toUpperCase()"></span> =</span>
                    <input type="number" min="0" step="any" class="input nfe-input-sm" x-model="row.conversionQty"
                           @input="row.conversionManual = true" placeholder="?" />
                    <span class="muted text-xs" x-text="row.saleUnit"></span>
                    <div class="text-xs" :class="rowNeedsConversion(row) ? 'error' : 'muted'"
                         x-text="rowNeedsConversion(row) ? 'informe quantas unidades vêm na embalagem' : ('= ' + fmtQty(rowSaleQty(row)) + ' ' + row.saleUnit)"></div>
                  </div>
                </template>
              </td>
              <td style="min-width:130px">
                <input type="text" inputmode="decimal" x-model="row.cost" :disabled="row.action === 'ignore'"
                       class="input nfe-input" @input="row.cost = maskMoney(row.cost)" />
                <div class="muted text-xs" x-show="row.action !== 'ignore'"
                     x-text="'= ' + brl(rowCostSaleCents(row)) + '/' + row.saleUnit"></div>
              </td>
              <td style="min-width:140px">
                <input type="text" inputmode="decimal" x-model="row.price" :disabled="row.action === 'ignore'"
                       class="input nfe-input" @input="row.price = maskMoney(row.price); row.priceTouched = true" />
                <div class="text-xs">
                  <button type="button" class="btn-link" x-show="row.action !== 'ignore' && row.suggestedPrice !== row.price"
                          @click="row.price = row.suggestedPrice; row.priceTouched = false"
                          title="Usar o preço sugerido pelo markup">sugerido <span x-text="row.suggestedPrice"></span></button>
                </div>
                <div class="muted text-xs" x-show="margemLabel(row)" x-text="margemLabel(row)"></div>
              </td>
              <td class="num" style="min-width:110px">
                <span x-text="brl(lineTotal(row))"></span>
              </td>
            </tr>
          </template>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="6" class="num muted">Total conferido (linhas aceitas)</td>
            <td class="num" style="font-weight:600" x-text="brl(acceptedTotal)"></td>
          </tr>
          <tr>
            <td colspan="6" class="num muted">Total da nota</td>
            <td class="num muted" x-text="preview ? brl(preview.totalCents) : ''"></td>
          </tr>
        </tfoot>
      </table>
        <div x-show="!visibleRows.length" class="nfe-empty">Nenhuma linha nesta visão.</div>
      </div>

      <div class="nfe-footer">
        <div class="nfe-footer-stats">
          <span class="nfe-stat"><strong x-text="rows.length"></strong> itens</span>
          <span class="nfe-stat"><strong x-text="acceptedCount"></strong> aceitos</span>
          <span class="nfe-stat muted"><strong x-text="ignoredCount"></strong> ignorados</span>
        </div>
        <div class="nfe-footer-total">
          <span class="nfe-head-label">Total conferido</span>
          <strong x-text="brl(acceptedTotal)"></strong>
          <span class="muted text-xs" x-text="preview ? ('nota ' + brl(preview.totalCents)) : ''"></span>
        </div>
        <span class="error" x-text="commitError"></span>
        <button class="btn secondary" @click="backToUpload()" x-text="editingId ? 'Cancelar edição' : 'Outro arquivo'">Outro arquivo</button>
        <% if (user.permissions.has('nfe.import.run')) { %>
        <button class="btn" @click="confirmImport()" :disabled="committing || saving || acceptedCount === 0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span x-text="editingId ? (saving ? 'Salvando…' : 'Salvar alterações') : (committing ? 'Importando…' : 'Confirmar importação')"></span>
        </button>
        <% } else { %>
        <span class="muted text-sm">A confirmação exige a permissão de importar.</span>
        <% } %>
      </div>
    </div>

    <%# Modal: buscar produto para vincular ── %>
    <dialog x-ref="searchDlg" @close="searchOpenRow = null">
      <h1>Vincular produto</h1>
      <p class="muted dialog-text" x-text="searchOpenRow ? ('Linha ' + searchOpenRow.line + ' — ' + searchOpenRow.description) : ''"></p>
      <input type="text" x-ref="searchInput" placeholder="Buscar por nome, código de barras ou SKU…"
             x-model="searchQ" @input.debounce.350ms="doSearch()" style="width:100%" />
      <div class="dialog-body" style="max-height:300px;overflow-y:auto;margin-top:.5rem">
        <template x-for="r in searchResults" :key="r.id">
          <button type="button" class="row-option" @click="pickSearchResult(r)">
            <span style="font-weight:600" x-text="r.name"></span>
            <span class="muted text-xs" x-text="[r.barcode && ('EAN ' + r.barcode), r.sku && ('SKU ' + r.sku), r.unit].filter(Boolean).join(' · ')"></span>
          </button>
        </template>
        <p x-show="!searchResults.length && searchQ.trim().length >= 2" class="muted text-xs" style="text-align:center;padding:.75rem">Nenhum produto encontrado.</p>
        <p x-show="searchQ.trim().length < 2" class="muted text-xs" style="text-align:center;padding:.75rem">Digite ao menos 2 caracteres.</p>
      </div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="$refs.searchDlg.close()">Cancelar</button>
      </div>
    </dialog>

    <%# Modal: como reconciliar o estoque quando algo foi vendido/ajustado ── %>
    <dialog x-ref="stockDlg" @close="pendingDecisions = null">
      <h1>Estoque alterado desde a importação</h1>
      <p class="muted dialog-text">Alguns produtos foram vendidos ou ajustados depois desta nota. Como deseja reconciliar o estoque?</p>
      <div class="dialog-body" style="max-height:220px;overflow-y:auto;margin:.5rem 0">
        <template x-for="d in (divergence ? divergence.items.filter(i => i.changed) : [])" :key="d.productId">
          <div class="row-option" style="cursor:default">
            <span style="font-weight:600" x-text="d.name"></span>
            <span class="muted text-xs" x-text="'importado ' + fmtQty(d.importedQty) + ' · saldo atual ' + fmtQty(d.stockQty)"></span>
          </div>
        </template>
      </div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="cancelStockChoice()">Cancelar</button>
        <button type="button" class="btn secondary" @click="chooseStockMode('restore')"
                title="Estorna a entrada antiga e aplica a nova; falha se o produto já foi vendido">
          Restaurar estado da nota
        </button>
        <button type="button" class="btn" @click="chooseStockMode('keep')"
                title="Mantém as vendas/ajustes e aplica a diferença das novas quantidades">
          Manter estoque atual
        </button>
      </div>
    </dialog>
  </main>

  <style>
    /* Mantém a largura padrão das outras telas (main = 1100px, alinhada ao nav). A
       conferência tem 7 colunas: quando não couber, o card da tabela rola na horizontal
       (overflow-x:auto), em vez de alargar a página inteira. */
    /* Laranja escurecido para texto pequeno sobre fundo claro (contraste AA); no tema
       escuro, clareia para manter a leitura. */
    main { --nfe-accent-text: color-mix(in srgb, var(--primary) 68%, #000); }
    :root[data-theme='dark'] main { --nfe-accent-text: color-mix(in srgb, var(--primary) 72%, #fff); }
    .nfe-section-title { margin: 1.75rem 0 .75rem; }

    /* Passo 1 — upload */
    .nfe-upload { max-width: 760px; }
    .nfe-upload h2 { margin-bottom: .35rem; }
    .nfe-upload-row { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap; margin:1rem 0; }
    .nfe-paste { width:100%; resize:vertical; min-height:130px; font-family:var(--font-mono,monospace); font-size:.8rem; }
    .nfe-upload-actions { display:flex; align-items:center; gap:.75rem; margin-top:.75rem; }
    .nfe-upload-actions .btn { margin-left:auto; }

    /* Passo 2 — cabeçalho da nota */
    .nfe-head { display:flex; flex-wrap:wrap; gap:1.25rem 2.5rem; align-items:flex-start; justify-content:space-between; }
    .nfe-head-label { display:block; font-size:.68rem; text-transform:uppercase; letter-spacing:.04em; color:var(--text-muted); margin-bottom:.2rem; }
    .nfe-head-supplier strong { font-size:1.1rem; }
    .nfe-head-sub { display:flex; align-items:center; gap:.5rem; margin-top:.35rem; flex-wrap:wrap; }
    .nfe-head-meta { display:flex; gap:2rem; flex-wrap:wrap; }
    .nfe-head-meta > div { display:flex; flex-direction:column; }
    .nfe-head-meta strong { font-variant-numeric:tabular-nums; }

    /* Passo 2 — rodapé fixo de confirmação */
    .nfe-footer { position:sticky; bottom:0; z-index:5; display:flex; align-items:center; gap:1rem; flex-wrap:wrap;
      margin-top:1rem; padding:.75rem 1rem;
      background:var(--glass-strong); backdrop-filter:blur(var(--glass-blur)) saturate(180%);
      -webkit-backdrop-filter:blur(var(--glass-blur)) saturate(180%);
      border:1px solid var(--glass-border); border-radius:var(--radius); box-shadow:var(--shadow); }
    .nfe-footer-stats { display:flex; gap:.6rem; flex-wrap:wrap; }
    .nfe-stat { display:inline-flex; align-items:baseline; gap:.3rem; font-size:.82rem; color:var(--text-secondary); }
    .nfe-stat strong { color:var(--text); font-variant-numeric:tabular-nums; }
    .nfe-footer-total { display:flex; flex-direction:column; margin-left:auto; text-align:right; }
    .nfe-footer-total strong { font-size:1.05rem; font-variant-numeric:tabular-nums; }

    /* Passo 2 — filtros */
    .nfe-filters { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap; margin-bottom:.75rem; }
    .nfe-tabs { display:inline-flex; gap:.2rem; padding:.25rem; background:var(--surface-hover);
      border:1px solid var(--border-light); border-radius:9999px; flex-wrap:wrap; }
    .nfe-tab { border:0; background:transparent; color:var(--text-secondary); font-size:.82rem;
      padding:.35rem .85rem; border-radius:9999px; cursor:pointer; display:inline-flex; align-items:center; gap:.4rem; }
    .nfe-tab:hover { color:var(--text); }
    .nfe-tab.active { background:var(--primary); color:#fff; }
    .nfe-tab-count { font-size:.72rem; opacity:.7; font-variant-numeric:tabular-nums; }
    .nfe-tab.active .nfe-tab-count { opacity:.9; }

    /* Passo 2 — tabela */
    .nfe-table-card { background:var(--surface); border:1px solid var(--border-light);
      border-radius:var(--radius); overflow-x:auto; scrollbar-width:thin; scrollbar-color:var(--border) transparent; }
    /* Barra de rolagem horizontal sempre visível/óbvia quando a tabela não couber. */
    .nfe-table-card::-webkit-scrollbar { height:10px; }
    .nfe-table-card::-webkit-scrollbar-track { background:transparent; }
    .nfe-table-card::-webkit-scrollbar-thumb { background:var(--border); border-radius:99px; border:2px solid var(--surface); }
    .nfe-table-card::-webkit-scrollbar-thumb:hover { background:var(--text-muted); }
    /* min-width garante que as colunas não sejam esmagadas (texto truncado); a tabela rola. */
    .nfe-table { width:100%; min-width:1040px; border-collapse:collapse; }
    /* Coluna de Total fixa à direita: continua legível ao rolar na horizontal. */
    .nfe-table th:last-child, .nfe-table td:last-child { position:sticky; right:0; background:var(--surface);
      box-shadow:inset 1px 0 0 var(--border-light); }
    .nfe-table thead th:last-child { background:var(--surface-hover); }
    .nfe-table tfoot td:last-child { background:var(--surface-hover); }
    .nfe-table th { text-align:left; font-size:.68rem; text-transform:uppercase; letter-spacing:.04em;
      color:var(--text-muted); padding:.7rem .9rem; background:var(--surface-hover); border-bottom:1px solid var(--border); }
    .nfe-table td { padding:.85rem .9rem; border-bottom:1px solid var(--border-light); vertical-align:top; }
    .nfe-table tbody tr:last-child td { border-bottom:none; }
    .nfe-table tfoot td { background:var(--surface-hover); border-top:2px solid var(--border); padding:.7rem .9rem; }
    .nfe-table th.num, .nfe-table td.num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .nfe-empty { padding:1.5rem; text-align:center; color:var(--text-muted); font-size:.85rem; }
    .nfe-row-actions { display:flex; gap:.35rem; justify-content:flex-end; flex-wrap:wrap; }

    /* Ação por linha — controle segmentado */
    .nfe-acts { display:inline-flex; gap:.15rem; padding:.2rem; background:var(--surface-hover);
      border:1px solid var(--border-light); border-radius:9px; }
    /* A ação selecionada usa tom suave (contorno + fundo tingido). O laranja SÓLIDO fica
       reservado para o CTA principal "Confirmar importação" — antes, toda linha "Criar"
       saía laranja cheio e competia com o botão de confirmar. */
    .nfe-acts .btn { border:1px solid transparent; background:transparent; color:var(--text-secondary);
      padding:.45rem .85rem; border-radius:7px; min-height:2.1rem; }
    .nfe-acts .btn:hover:not(:disabled) { background:var(--surface); color:var(--text); }
    .nfe-acts .btn.active, .nfe-acts .btn.active:hover {
      background:var(--primary-bg); color:var(--nfe-accent-text); border-color:var(--primary); }
    .nfe-acts .btn.active.danger, .nfe-acts .btn.active.danger:hover {
      background:var(--danger-bg); color:var(--danger-text); border-color:var(--danger); }

    /* Motivo de "precisam de atenção" por linha (ícone + rótulo + tooltip) */
    .nfe-item-head { display:flex; align-items:center; gap:.4rem; flex-wrap:wrap; }
    .nfe-reason { display:inline-flex; align-items:center; gap:.25rem; font-weight:600; }
    .nfe-reason-primary { background:var(--primary-bg); color:var(--nfe-accent-text); }
    .nfe-reason-warning { background:var(--warning-bg); color:var(--warning-text); }
    .nfe-reason-danger { background:var(--danger-bg); color:var(--danger-text); }
    .nfe-badge-info { display:inline-flex; align-items:center; gap:.3rem; }

    /* Progresso da conferência */
    .nfe-progress { display:flex; align-items:center; gap:.6rem; flex-wrap:wrap; margin:.1rem 0 .75rem; }
    .nfe-progress-track { flex:0 0 220px; max-width:40%; height:6px; border-radius:99px;
      background:var(--border-light); overflow:hidden; }
    .nfe-progress-track > span { display:block; height:100%; background:var(--primary); border-radius:99px;
      transition:width .25s ease; }

    tr.nfe-ignored td { opacity:.5; }
    tr.nfe-attention td:first-child { box-shadow: inset 3px 0 0 var(--warning-text); }
    .nfe-flag { background:var(--warning-bg); color:var(--warning-text); margin-right:.2rem; }
    .nfe-input { width:100%; padding:.45rem .55rem; box-sizing:border-box; }
    .nfe-input-sm { width:4.5rem; padding:.35rem .45rem; box-sizing:border-box; }
    .nfe-qty-line { display:flex; align-items:center; gap:.4rem; }
    .nfe-qty-line .nfe-input { flex:1 1 auto; }
    .nfe-conv { display:flex; align-items:center; gap:.3rem; flex-wrap:wrap; margin-top:.3rem; }
    .nfe-conv > .text-xs { flex-basis:100%; }
    .nfe-markup { display:inline-flex; align-items:center; gap:.35rem; padding:.25rem .5rem;
      border:1px solid var(--border-light); border-radius:9px; background:var(--surface-hover); }
    .btn-link { background:none; border:0; color:var(--nfe-accent-text); cursor:pointer; padding:.15rem .2rem; font-size:.8rem; text-decoration:underline; }
    .row-option { display:flex; flex-direction:column; align-items:flex-start; width:100%; text-align:left;
      background:var(--surface); border:1px solid var(--border-light); border-radius:var(--radius);
      padding:.55rem .7rem; margin-top:.35rem; cursor:pointer; }
    .row-option:hover { border-color:var(--primary); }
  </style>
  <script nonce="<%= cspNonce %>" src="/js/masks.js"></script>
  <script nonce="<%= cspNonce %>">
    function nfeImportPage(canRun) {
      return {
        canRun: canRun,
        parsing: false, committing: false, saving: false,
        preview: null, rows: [], filter: 'revisar',
        error: '', commitError: '',
        markupPct: '100',
        history: [], reverting: null,
        editingId: null, divergence: null, pendingDecisions: null,
        categories: [],
        searchOpenRow: null, searchQ: '', searchResults: [],
        brl: (c) => window.brl(c),
        async init() { await this.loadHistory(); this.loadCategories(); },
        async loadCategories() {
          try {
            const r = await fetch('/api/nfe/categories');
            if (r.ok) this.categories = await r.json();
          } catch { /* sem categorias: o produto novo entra sem categoria */ }
        },
        async loadHistory() {
          const r = await fetch('/api/nfe/invoices');
          if (r.ok) this.history = await r.json();
        },
        async revert(h) {
          const ok = await window.confirmDlg(
            'Desfazer a importação da NF-e ' + (h.invoice_number || h.access_key) + '? ' +
            'O estoque e o custo voltam ao estado anterior e o que a nota criou (produtos sem uso, fornecedor e vínculos) será removido. ' +
            'A nota sai do histórico e poderá ser importada de novo.'
          );
          if (!ok) return;
          this.reverting = h.id;
          try {
            const r = await fetch('/api/nfe/invoices/' + h.id + '/revert', { method: 'POST' });
            const d = r.ok ? await r.json() : { error: (await r.json().catch(() => ({}))).error ?? 'Falha ao reverter.' };
            if (!r.ok) { showToast(d.error, 'error'); return; }
            showToast('Importação desfeita: ' + d.productsDeleted + ' produto(s) removido(s), estoque devolvido.', 'success');
            this.loadHistory();
          } finally { this.reverting = null; }
        },
        /** Reabre a conferência de uma importação já feita, pré-preenchida. */
        async edit(h) {
          this.error = '';
          try {
            const r = await fetch('/api/nfe/invoices/' + h.id + '/edit');
            const d = r.ok ? await r.json() : { error: (await r.json().catch(() => ({}))).error ?? 'Falha ao abrir a edição.' };
            if (!r.ok) { showToast(d.error, 'error'); return; }
            this.editingId = h.id;
            this.preview = d.preview;
            this.markupPct = String((d.preview.markupBps ?? 10000) / 100).replace('.', ',');
            this.rows = d.preview.items.map((it) => this.rowFromPreview(it));
            for (const dec of d.decisions) {
              const row = this.rows.find((x) => x.line === dec.line);
              if (!row) continue;
              row.action = dec.action;
              row.productId = dec.productId;
              row.productName = dec.productName || '';
              row.qty = String(dec.qty);
              row.cost = maskMoney(String(dec.unitCostCents));
              if (dec.salePriceCents != null) { row.price = maskMoney(String(dec.salePriceCents)); row.priceTouched = true; }
              if (dec.conversionQty != null) {
                row.conversionQty = String(dec.conversionQty);
                if (dec.conversionUnit) { row.conversionUnit = dec.conversionUnit; row.conversionSource = 'needs_input'; }
              } else if (dec.action !== 'ignore') {
                row.conversionQty = '1'; row.conversionUnit = null; row.conversionSource = 'same_unit';
              }
              if (dec.saleUnit) row.saleUnit = dec.saleUnit;
            }
            this.divergence = d.divergence;
            this.filter = 'todas';
            this.commitError = '';
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } catch { showToast('Falha ao abrir a edição.', 'error'); }
        },
        /** Fecha a conferência e limpa o estado de edição/importação. */
        closeConference() {
          this.preview = null; this.rows = []; this.commitError = '';
          this.editingId = null; this.divergence = null; this.pendingDecisions = null;
          if (this.$refs.stockDlg && this.$refs.stockDlg.open) this.$refs.stockDlg.close();
        },
        /** Decisões no formato aceito pelo commit/edição. */
        buildDecisions() {
          return this.rows.map((r) => ({
            line: r.line,
            action: r.action,
            productId: r.action === 'link' ? r.productId : null,
            qty: this.num(r.qty),
            unitCostCents: this.brlToCents(r.cost),
            salePriceCents: this.brlToCents(r.price),
            conversionQty: r.conversionQty === '' || r.conversionQty == null ? null : this.num(r.conversionQty),
            unit: r.saleUnit,
            categoryId: r.action === 'create' && r.categoryId !== '' ? Number(r.categoryId) : null,
          }));
        },
        /** Validações comuns da conferência (produto vinculado e conversão informada). */
        validateConference() {
          const semProduto = this.rows.filter((r) => r.action === 'link' && !r.productId);
          if (semProduto.length) {
            this.commitError = 'Vincule um produto às linhas ' + semProduto.map((r) => r.line).join(', ') + ' ou crie/ignore.';
            return false;
          }
          const semConversao = this.rows.filter((r) => this.rowNeedsConversion(r));
          if (semConversao.length) {
            this.commitError = 'Informe a conversão de unidade (quantas unidades de venda vêm na embalagem) nas linhas ' +
              semConversao.map((r) => r.line).join(', ') + '.';
            return false;
          }
          return true;
        },
        /** Salva a edição (estorna a versão antiga e aplica a nova). */
        async saveEdit(decisions, stockMode) {
          this.commitError = '';
          this.saving = true;
          try {
            const r = await fetch('/api/nfe/invoices/' + this.editingId + '/edit', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ decisions, stockMode }),
            });
            if (r.status === 409) {
              const d = await r.json().catch(() => ({}));
              this.pendingDecisions = decisions;
              if (d.divergence) this.divergence = d.divergence;
              this.openStockDialog();
              return;
            }
            const d = r.ok ? await r.json() : { error: (await r.json().catch(() => ({}))).error ?? 'Falha ao salvar a edição.' };
            if (!r.ok) { this.commitError = d.error; return; }
            showToast('Importação atualizada: ' + d.created + ' criado(s), ' + d.linked + ' vinculado(s), ' + d.ignored + ' ignorado(s).', 'success');
            this.closeConference();
            this.loadHistory();
          } finally { this.saving = false; }
        },
        openStockDialog() { if (this.$refs.stockDlg && !this.$refs.stockDlg.open) this.$refs.stockDlg.showModal(); },
        cancelStockChoice() { this.pendingDecisions = null; if (this.$refs.stockDlg) this.$refs.stockDlg.close(); },
        chooseStockMode(mode) {
          const decisions = this.pendingDecisions;
          if (this.$refs.stockDlg) this.$refs.stockDlg.close();
          if (decisions) this.saveEdit(decisions, mode);
        },
        brlToCents(s) {
          if (s == null || s === '') return 0;
          const t = String(s).trim();
          const num = t.includes(',') ? parseFloat(t.replace(/\./g, '').replace(',', '.')) : parseFloat(t);
          return Number.isFinite(num) ? Math.round(num * 100) : 0;
        },
        async onFile(files) {
          if (!files || !files.length) return;
          const f = files[0];
          if (f.size > 9 * 1024 * 1024) { this.error = 'Arquivo muito grande (máx. 9 MB).'; return; }
          try { this.previewXml(await f.text()); }
          catch { this.error = 'Não foi possível ler o arquivo.'; }
        },
        async previewPasted() {
          const xml = this.$refs.pasteXml.value;
          if (!xml.trim()) { this.error = 'Cole o conteúdo do XML ou escolha um arquivo.'; return; }
          this.previewXml(xml);
        },
        async previewXml(xml) {
          this.parsing = true; this.error = '';
          try {
            const r = await fetch('/api/nfe/preview', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ xml }),
            });
            const d = r.ok ? await r.json() : { error: (await r.json().catch(() => ({}))).error ?? 'Não foi possível analisar a NF-e.' };
            if (!r.ok) { this.error = d.error; this.preview = null; this.rows = []; return; }
            this.xml = xml;
            this.preview = d;
            this.markupPct = String((d.markupBps ?? 10000) / 100).replace('.', ',');
            this.rows = d.items.map((it) => this.rowFromPreview(it));
            this.filter = 'revisar';
            this.error = '';
          } finally { this.parsing = false; }
        },
        rowFromPreview(it) {
          let action = it.kind === 'new' ? 'create' : it.kind === 'invalid' ? 'ignore' : 'link';
          let productId = null;
          if (it.kind === 'matched' && it.product) { action = 'link'; productId = it.product.id; }
          else if (it.kind === 'possible') { action = it.product ? 'link' : (it.candidates.length ? 'link' : 'create'); productId = (it.product || it.candidates[0])?.id ?? null; }
          const selected = it.candidates.find((c) => c.id === productId) || (it.product && it.product.id === productId ? it.product : null);
          const productName = selected ? selected.name : '';
          return {
            line: it.line, description: it.description, cProd: it.cProd, ean: it.ean,
            ncm: it.ncm, cfop: it.cfop, unit: it.unit, unitTrib: it.unitTrib,
            flags: it.flags, error: it.error, kind: it.kind,
            candidates: it.candidates || [],
            action, productId, productName,
            categoryId: '',
            suggestedAction: action, suggestedProductId: productId, suggestedProductName: productName,
            qty: String(it.qty),
            cost: it.unitCostCents > 0 ? maskMoney(String(it.unitCostCents)) : '0,00',
            saleUnit: it.saleUnit || it.unit || 'un',
            conversionQty: it.conversionQty != null ? String(it.conversionQty) : '',
            conversionUnit: it.conversionUnit || null,
            conversionSource: it.conversionSource || 'same_unit',
            conversionManual: false,
            suggestedSaleUnit: it.saleUnit || it.unit || 'un',
            suggestedConversionQty: it.conversionQty != null ? String(it.conversionQty) : '',
            suggestedConversionUnit: it.conversionUnit || null,
            suggestedConversionSource: it.conversionSource || 'same_unit',
            costSaleCents: it.costSaleCents || it.unitCostCents,
            suggestedPrice: maskMoney(String(it.suggestedPriceCents || 0)),
            defaultPrice: maskMoney(String(it.salePriceCents || 0)),
            price: maskMoney(String(it.salePriceCents || 0)),
            priceTouched: false,
            eanBox: it.eanBox || null, eanUnit: it.eanUnit || null,
          };
        },
        num(v) {
          const n = Number(String(v ?? '').replace(',', '.'));
          return Number.isFinite(n) ? n : 0;
        },
        rowFactor(row) {
          const f = this.num(row.conversionQty);
          return f > 0 ? f : 1;
        },
        rowNeedsConversion(row) {
          if (row.action === 'ignore') return false;
          const relevant = row.conversionUnit || row.conversionSource === 'needs_input';
          return !!relevant && !(this.num(row.conversionQty) > 0);
        },
        rowSaleQty(row) {
          const f = this.rowNeedsConversion(row) ? 1 : this.rowFactor(row);
          return this.num(row.qty) * f;
        },
        rowCostSaleCents(row) {
          const f = this.rowNeedsConversion(row) ? 1 : this.rowFactor(row);
          return Math.round(this.brlToCents(row.cost) / (f > 0 ? f : 1));
        },
        fmtQty(n) {
          const v = Number(n) || 0;
          return (Number.isInteger(v) ? String(v) : v.toFixed(3).replace(/0+$/, '').replace(/\.$/, ''))
            .replace('.', ',');
        },
        margemLabel(row) {
          const price = this.brlToCents(row.price);
          const cost = this.rowCostSaleCents(row);
          if (!(price > 0) || !(cost > 0)) return '';
          const pct = Math.round(((price - cost) / price) * 1000) / 10;
          return 'margem ' + String(pct).replace('.', ',') + '%';
        },
        async onMarkupChange() {
          const pct = this.num(this.markupPct);
          for (const row of this.rows) {
            row.costSaleCents = this.rowCostSaleCents(row);
            row.suggestedPrice = maskMoney(String(Math.round(row.costSaleCents * (1 + pct / 100))));
            if (!row.priceTouched) row.price = row.suggestedPrice;
          }
          if (!this.canRun) return;
          try {
            await fetch('/api/nfe/markup', {
              method: 'PUT', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ markupBps: Math.max(0, Math.round(pct * 100)) }),
            });
          } catch { /* preferência local: falha ao salvar não bloqueia a conferência */ }
        },
        applyProductToRow(row, product) {
          row.action = 'link';
          row.productId = product.id;
          row.productName = product.name;
          const saleUnit = product.unit || 'un';
          row.saleUnit = saleUnit;
          const noteUnit = String(row.unit || '').trim().toUpperCase();
          const tribUnit = String(row.unitTrib || '').trim().toUpperCase();
          const sale = String(saleUnit).trim().toUpperCase();
          if (noteUnit === sale || (tribUnit && tribUnit === sale)) {
            row.conversionQty = '1'; row.conversionUnit = null; row.conversionSource = 'same_unit';
          } else {
            row.conversionQty = ''; row.conversionUnit = row.unit || saleUnit; row.conversionSource = 'needs_input';
          }
          row.costSaleCents = this.rowCostSaleCents(row);
          const pct = this.num(this.markupPct);
          row.suggestedPrice = maskMoney(String(Math.round(row.costSaleCents * (1 + pct / 100))));
          row.defaultPrice = row.suggestedPrice;
          if (!row.priceTouched) row.price = row.suggestedPrice;
        },
        flagLabel(f) {
          return { ean_conflict: 'EAN diferente do cadastrado', ean_invalid: 'EAN da nota com dígito verificador inválido',
                   name_conflict: 'Mais de um produto com este nome',
                   supplier_code_conflict: 'Código do fornecedor ambíguo', unit_conflict: 'Unidade diferente',
                   ncm_conflict: 'NCM diferente do cadastrado', price_changed: 'Custo diferente do cadastrado' }[f] || f;
        },
        /** Por que esta linha aparece em "Precisam de atenção" (ícone + motivo + dica). */
        rowReason(row) {
          if (row.action === 'ignore') return { icon: '', label: '', tone: 'ok', hint: '' };
          if (row.kind === 'invalid' || row.error) {
            return { icon: '!', label: 'Inválido', tone: 'danger', hint: row.error || 'Item com dados insuficientes.' };
          }
          if (this.rowNeedsConversion(row)) {
            return { icon: '!', label: 'Conversão', tone: 'warning', hint: 'Informe quantas unidades de venda vêm na embalagem da nota.' };
          }
          if (row.kind === 'new') {
            return { icon: '+', label: 'Novo', tone: 'primary', hint: 'Não existe no catálogo — será criado como produto novo.' };
          }
          if (row.flags.length) {
            return { icon: '!', label: 'Conflito', tone: 'warning', hint: row.flags.map((f) => this.flagLabel(f)).join('; ') };
          }
          if (row.kind === 'possible') {
            return { icon: '?', label: 'Sem vínculo', tone: 'warning', hint: 'Encontrado por semelhança — confirme o produto, crie ou ignore.' };
          }
          return { icon: '', label: '', tone: 'ok', hint: '' };
        },
        get novosTotal() {
          return this.rows.filter((r) => r.kind === 'new').length;
        },
        get conflictCount() {
          return this.rows.filter((r) => {
            const t = this.rowReason(r).tone;
            return t === 'warning' || t === 'danger';
          }).length;
        },
        get progressPct() {
          return this.rows.length ? Math.round((this.acceptedCount / this.rows.length) * 100) : 0;
        },
        setAction(row, action) {
          row.action = action;
          if (action !== 'link') return;
          if (row.productId) return;
          const first = (row.candidates && row.candidates[0]);
          if (first) this.applyProductToRow(row, first);
        },
        async openSearch(row) {
          this.searchOpenRow = row;
          this.searchQ = ''; this.searchResults = [];
          this.$refs.searchDlg.showModal();
          this.$nextTick(() => this.$refs.searchInput.focus());
        },
        async doSearch() {
          const q = this.searchQ.trim();
          if (q.length < 2) { this.searchResults = []; return; }
          const r = await fetch('/api/nfe/products?q=' + encodeURIComponent(q));
          this.searchResults = r.ok ? await r.json() : [];
        },
        pickSearchResult(r) {
          const row = this.searchOpenRow;
          if (row) this.applyProductToRow(row, r);
          this.$refs.searchDlg.close();
        },
        get acceptedCount() {
          return this.rows.filter((r) => r.action !== 'ignore').length;
        },
        get newCount() {
          return this.rows.filter((r) => r.kind === 'new' && r.action !== 'create').length;
        },
        criarTodosNovos() {
          for (const row of this.rows) if (row.kind === 'new') row.action = 'create';
        },
        get ignoredCount() {
          return this.rows.filter((r) => r.action === 'ignore').length;
        },
        get suggestionDiffCount() {
          return this.rows.filter((r) => r.action !== r.suggestedAction || r.productId !== r.suggestedProductId).length;
        },
        get visibleRows() {
          if (this.filter === 'todas') return this.rows;
          if (this.filter === 'reconhecidas') return this.rows.filter((r) => r.kind === 'matched');
          if (this.filter === 'ignoradas') return this.rows.filter((r) => r.action === 'ignore');
          return this.rows.filter((r) => r.kind !== 'matched');
        },
        tabCount(kind) {
          if (kind === 'todas') return this.rows.length;
          if (kind === 'reconhecidas') return this.rows.filter((r) => r.kind === 'matched').length;
          if (kind === 'ignoradas') return this.rows.filter((r) => r.action === 'ignore').length;
          return this.rows.filter((r) => r.kind !== 'matched').length;
        },
        applySuggestions() {
          for (const row of this.rows) {
            row.action = row.suggestedAction;
            row.productId = row.suggestedProductId;
            row.productName = row.suggestedProductName;
            row.saleUnit = row.suggestedSaleUnit;
            row.conversionQty = row.suggestedConversionQty;
            row.conversionUnit = row.suggestedConversionUnit;
            row.conversionSource = row.suggestedConversionSource;
            row.price = row.defaultPrice;
            row.priceTouched = false;
          }
          showToast('Sugestões do sistema aplicadas a todas as linhas.', 'success');
        },
        lineTotal(row) {
          const qty = Number(String(row.qty).replace(',', '.'));
          return Number.isFinite(qty) ? Math.round(this.brlToCents(row.cost) * qty) : 0;
        },
        get acceptedTotal() {
          return this.rows.filter((r) => r.action !== 'ignore').reduce((sum, r) => sum + this.lineTotal(r), 0);
        },
        backToUpload() { this.closeConference(); },
        async confirmImport() {
          this.commitError = '';
          if (!this.validateConference()) return;
          const decisions = this.buildDecisions();
          // Edição: pergunta como reconciliar o estoque quando algo foi vendido/ajustado.
          if (this.editingId) {
            if (this.divergence && this.divergence.changed) {
              this.pendingDecisions = decisions;
              this.openStockDialog();
              return;
            }
            await this.saveEdit(decisions, 'restore');
            return;
          }
          if (!window.confirmDlg || !(await window.confirmDlg('Confirmar a importação? Produtos novos serão criados e a compra entrará no estoque com os custos e preços conferidos.'))) return;
          this.committing = true;
          try {
            const r = await fetch('/api/nfe/commit', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ xml: this.xml, decisions }),
            });
            const d = r.ok ? await r.json() : { error: (await r.json().catch(() => ({}))).error ?? 'Falha ao importar.' };
            if (!r.ok) { this.commitError = d.error; return; }
            showToast(`NF-e importada: ${d.created} criado(s), ${d.linked} vinculado(s), ${d.ignored} ignorado(s).`, 'success');
            this.preview = null; this.rows = [];
            this.loadHistory();
          } finally { this.committing = false; }
        },
      };
    }
  </script>
</body>
</html>
