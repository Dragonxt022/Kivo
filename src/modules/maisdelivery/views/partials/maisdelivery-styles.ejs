<style>
  /* Mais Delivery — estilos compartilhados entre Pedidos e Integração. */
  [x-cloak] { display: none !important; }
  .md-page { max-width: 1200px; }
  .md-head { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
  .md-logo {
    width: 60px; height: 60px; object-fit: contain; background: #fff;
    border: 1px solid var(--border-light); border-radius: 14px; padding: 5px; flex: 0 0 auto;
  }
  .md-head-text { min-width: 220px; flex: 1 1 260px; }
  .md-head h1 { margin: 0; }
  .md-head p { margin: .2rem 0 0; }
  .md-head-actions { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; margin-left: auto; }
  .md-sync { color: var(--text-muted); font-size: .74rem; font-variant-numeric: tabular-nums; }
  .md-auto {
    display: inline-flex; align-items: center; gap: .35rem; padding: .32rem .6rem;
    border: 1px solid var(--border-light); border-radius: 999px; background: var(--surface);
    color: var(--text-muted); font-size: .76rem; cursor: pointer; user-select: none;
  }
  .md-auto input { accent-color: var(--primary); margin: 0; }
  .md-banner {
    display: flex; gap: .75rem; align-items: center; flex-wrap: wrap;
    padding: .85rem 1rem; border-radius: 12px; border: 1px solid var(--warning-bg);
    background: var(--warning-bg); color: var(--warning-text); margin-bottom: 1rem;
  }
  .md-banner .btn { margin-left: auto; }
  .md-alert {
    display: flex; gap: .7rem; align-items: flex-start; flex-wrap: wrap;
    padding: .75rem .9rem; border-radius: 12px; margin-bottom: 1rem;
    border: 1px solid color-mix(in srgb, var(--danger) 28%, var(--border-light));
    background: color-mix(in srgb, var(--danger) 8%, var(--surface));
    color: var(--danger-text); font-size: .84rem;
  }
  .md-alert .btn { margin-left: auto; }
  .md-note { color: var(--success-text); font-size: .86rem; }

  /* Toolbar de filtros */
  .md-toolbar.panel { padding: .85rem 1rem; margin-bottom: 1rem; }
  .md-toolbar-row { display: flex; gap: .65rem; align-items: center; flex-wrap: wrap; }
  .md-toolbar-row + .md-toolbar-row { margin-top: .65rem; padding-top: .65rem; border-top: 1px solid var(--border-light); }
  .md-presets {
    display: inline-flex; gap: 2px; padding: 3px; border-radius: 10px;
    border: 1px solid var(--border-light); background: var(--surface-hover);
  }
  .md-preset {
    border: 0; background: transparent; color: var(--text-secondary); cursor: pointer;
    padding: .38rem .72rem; border-radius: 8px; font-size: .8rem; font-weight: 600;
    font-family: inherit; white-space: nowrap;
  }
  .md-preset:hover { color: var(--text); }
  .md-preset.active { background: var(--surface); color: var(--primary); box-shadow: var(--shadow-xs); }
  .md-range { display: flex; gap: .45rem; align-items: center; flex-wrap: wrap; }
  .md-range label { display: flex; align-items: center; gap: .35rem; font-size: .76rem; color: var(--text-muted); }
  .md-range .input { padding: .38rem .55rem; font-size: .8rem; min-width: 128px; }
  .md-search { position: relative; flex: 1 1 230px; min-width: 180px; display: flex; align-items: center; }
  .md-search .input { width: 100%; padding-left: 2rem; padding-right: 1.9rem; }
  .md-search svg { position: absolute; left: .62rem; width: 15px; height: 15px; color: var(--text-muted); pointer-events: none; }
  .md-search-clear {
    position: absolute; right: .38rem; border: 0; background: transparent; color: var(--text-muted);
    cursor: pointer; font-size: 1rem; line-height: 1; padding: .2rem .3rem; border-radius: 6px;
  }
  .md-search-clear:hover { background: var(--surface-hover); color: var(--text); }
  .md-toolbar-meta { margin-left: auto; display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }

  /* Chips de situação */
  .md-chips { display: flex; gap: .4rem; flex-wrap: wrap; align-items: center; }
  .md-chip {
    display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .58rem;
    border-radius: 999px; border: 1px solid var(--border-light); background: var(--surface);
    color: var(--text-secondary); font-size: .77rem; cursor: pointer; font-family: inherit;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
  }
  .md-chip:hover { border-color: color-mix(in srgb, var(--primary) 35%, var(--border-light)); }
  .md-chip.active {
    border-color: var(--primary); background: var(--primary-bg); color: var(--primary); font-weight: 600;
  }
  .md-chip-count {
    min-width: 1.15rem; padding: 0 .3rem; border-radius: 999px; text-align: center;
    background: var(--surface-hover); color: var(--text-muted); font-size: .68rem;
    font-variant-numeric: tabular-nums;
  }
  .md-chip.active .md-chip-count { background: color-mix(in srgb, var(--primary) 18%, transparent); color: var(--primary); }
  .md-chip-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-muted); flex: 0 0 auto; }
  .md-chip-dot.pendente { background: #f59e0b; }
  .md-chip-dot.preparando { background: var(--primary); }
  .md-chip-dot.pronto { background: #10b981; }
  .md-chip-dot.em-rota { background: #3b82f6; }
  .md-chip-dot.concluido { background: #22c55e; }
  .md-chip-dot.cancelado { background: var(--danger); }

  /* Resumo do período */
  .md-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .7rem; margin-bottom: .55rem; }
  .md-summary-card {
    position: relative; border: 1px solid var(--border-light); border-radius: 14px;
    background: var(--surface); padding: .78rem .9rem .75rem 1rem; overflow: hidden;
  }
  .md-summary-card::before {
    content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--border);
  }
  .md-summary-card.orders::before { background: var(--primary); }
  .md-summary-card.revenue::before { background: #22c55e; }
  .md-summary-card.ticket::before { background: #3b82f6; }
  .md-summary-card.pending::before { background: #f59e0b; }
  .md-summary-card span {
    display: block; color: var(--text-muted); font-size: .7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .045em;
  }
  .md-summary-card strong {
    display: block; font-size: 1.32rem; line-height: 1.2; margin-top: .18rem;
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .md-summary-card small { display: block; color: var(--text-muted); font-size: .7rem; margin-top: .15rem; }
  .md-progress { height: 3px; border-radius: 999px; background: var(--border-light); overflow: hidden; margin: 0 0 1rem; }
  .md-progress span { display: block; height: 100%; background: var(--primary); transition: width .3s ease; }

  /* Lista de pedidos */
  .md-list-head { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; margin: 0 0 .55rem; }
  .md-list-head h2 { font-size: 1rem; margin: 0; }
  .md-orders { display: flex; flex-direction: column; gap: .55rem; }
  .md-order {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto;
    gap: .8rem; align-items: center; padding: .78rem .9rem .78rem 1.05rem;
    border: 1px solid var(--border-light); border-radius: 14px; background: var(--surface);
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .md-order::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--border); }
  .md-order:hover { border-color: color-mix(in srgb, var(--primary) 28%, var(--border-light)); box-shadow: var(--shadow-sm); }
  .md-order.pendente::before { background: #f59e0b; }
  .md-order.preparando::before { background: var(--primary); }
  .md-order.pronto::before { background: #10b981; }
  .md-order.em-rota::before { background: #3b82f6; }
  .md-order.concluido::before { background: #22c55e; }
  .md-order.cancelado::before { background: var(--danger); }
  .md-order-avatar {
    width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    background: var(--primary-bg); color: var(--primary); font-weight: 700; font-size: .88rem;
    flex: 0 0 auto; text-transform: uppercase;
  }
  .md-order-main { min-width: 0; }
  .md-order-title { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
  .md-order-id { font-size: .72rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .md-order-customer {
    font-weight: 700; font-size: .95rem; margin-top: .08rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .md-order-meta { color: var(--text-muted); font-size: .77rem; margin-top: .08rem; }
  .md-order-address {
    color: var(--text-secondary); font-size: .77rem; margin-top: .12rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .md-order-note { color: var(--danger-text); font-size: .75rem; margin-top: .12rem; }
  .md-order-tags { display: inline-flex; gap: .3rem; flex-wrap: wrap; }
  .md-tag {
    display: inline-flex; align-items: center; padding: .08rem .42rem; border-radius: 999px;
    font-size: .67rem; font-weight: 600; background: var(--surface-hover);
    color: var(--text-muted); border: 1px solid var(--border-light); white-space: nowrap;
  }
  .md-tag.new {
    background: color-mix(in srgb, #22c55e 14%, transparent);
    color: color-mix(in srgb, #15803d 75%, var(--text)); border-color: transparent;
  }
  .md-order-side { display: flex; flex-direction: column; align-items: flex-end; gap: .3rem; text-align: right; }
  .md-order-total { font-size: 1.02rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .md-order-side .muted { font-size: .71rem; }
  .md-order.is-loading .md-order-avatar { background: var(--surface-hover); color: transparent; }
  .md-skel {
    display: inline-block; height: .7rem; border-radius: 6px; vertical-align: middle;
    background: linear-gradient(90deg, var(--surface-hover) 25%, var(--border-light) 50%, var(--surface-hover) 75%);
    background-size: 200% 100%; animation: md-shimmer 1.4s linear infinite;
  }
  .md-skel.w-24 { width: 6rem; }
  .md-skel.w-40 { width: 10rem; }
  .md-skel.w-56 { width: 14rem; }
  @keyframes md-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .md-skel { animation: none; } }

  .md-status { font-size: .72rem; font-weight: 600; white-space: nowrap; }
  .md-status.pendente { background: var(--warning-bg); color: var(--warning-text); }
  .md-status.preparando { background: var(--primary-bg); color: var(--primary); }
  .md-status.pronto { background: color-mix(in srgb, #10b981 16%, transparent); color: color-mix(in srgb, #047857 80%, var(--text)); }
  .md-status.em-rota { background: color-mix(in srgb, #3b82f6 14%, transparent); color: color-mix(in srgb, #1d4ed8 80%, var(--text)); }
  .md-status.concluido { background: var(--success-bg); color: var(--success-text); }
  .md-status.cancelado { background: var(--danger-bg); color: var(--danger-text); }
  .md-status.neutral { background: var(--surface-hover); color: var(--text-muted); }

  .md-empty {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: .25rem;
    border: 1px dashed var(--border-light); border-radius: 14px; padding: 2.4rem 1rem;
    background: var(--surface); color: var(--text-muted);
  }
  .md-empty-icon {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: var(--primary-bg); color: var(--primary); margin-bottom: .35rem;
  }
  .md-empty strong { color: var(--text); }
  .md-empty .btn { margin-top: .5rem; }
  .md-pager { display: flex; align-items: center; justify-content: center; gap: .6rem; margin-top: .9rem; }
  .md-pager span { font-size: .78rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }

  /* Drawer de detalhe */
  dialog.md-drawer {
    width: min(520px, 100vw); height: 100dvh; max-height: 100dvh; margin: 0 0 0 auto;
    padding: 0; border-radius: 0; border-top: 0; border-right: 0; border-bottom: 0;
    overflow: hidden; animation: md-drawer-in .22s cubic-bezier(.22, 1, .36, 1);
  }
  dialog.md-drawer[open] { display: flex; flex-direction: column; }
  @keyframes md-drawer-in { from { opacity: .6; transform: translateX(28px); } to { opacity: 1; transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { dialog.md-drawer { animation: none; } }
  .md-drawer-head {
    position: sticky; top: 0; z-index: 2; display: flex; gap: .75rem; align-items: flex-start;
    justify-content: space-between; padding: 1rem 1.1rem .85rem;
    background: var(--glass-strong); border-bottom: 1px solid var(--border-light);
  }
  .md-drawer-title { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin: 0; font-size: 1.12rem; }
  .md-drawer-sub { color: var(--text-muted); font-size: .79rem; margin-top: .2rem; }
  .md-drawer-body { flex: 1; overflow-y: auto; padding: 1rem 1.1rem calc(1.3rem + env(safe-area-inset-bottom)); }
  .md-drawer-hero {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .75rem; align-items: center;
    padding: .9rem 1rem; border-radius: 14px; margin-bottom: 1rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 12%, var(--surface)), var(--surface));
    border: 1px solid var(--border-light);
  }
  .md-drawer-total { font-size: 1.55rem; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .md-drawer-hero small { color: var(--text-muted); font-size: .71rem; display: block; }
  .md-drawer-pills { display: flex; gap: .35rem; flex-wrap: wrap; justify-content: flex-end; }
  .md-pill {
    display: inline-flex; align-items: center; gap: .3rem; padding: .2rem .52rem;
    border-radius: 999px; background: var(--surface); border: 1px solid var(--border-light);
    font-size: .71rem; color: var(--text-secondary); white-space: nowrap;
  }
  .md-section { padding: .9rem 0; border-top: 1px solid var(--border-light); }
  .md-section:first-of-type { border-top: 0; padding-top: 0; }
  .md-section h3 {
    margin: 0 0 .55rem; font-size: .72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: var(--text-muted);
  }
  .md-customer { display: flex; gap: .7rem; align-items: center; }
  .md-customer .md-order-avatar { width: 44px; height: 44px; font-size: .95rem; }
  .md-customer-name { font-weight: 700; }
  .md-customer-meta { color: var(--text-muted); font-size: .78rem; margin-top: .1rem; }
  .md-info-row { display: flex; gap: .6rem; align-items: flex-start; padding: .22rem 0; font-size: .85rem; }
  .md-info-row .label { flex: 0 0 88px; color: var(--text-muted); font-size: .77rem; padding-top: .06rem; }
  .md-info-row .value { min-width: 0; word-break: break-word; }
  .md-copy {
    border: 0; background: transparent; color: var(--primary); font-size: .71rem;
    cursor: pointer; padding: 0 .18rem; font-family: inherit;
  }
  .md-copy:hover { text-decoration: underline; }
  .md-values { display: flex; flex-direction: column; gap: .32rem; }
  .md-value-row { display: flex; justify-content: space-between; gap: .75rem; font-size: .85rem; }
  .md-value-row .muted { color: var(--text-muted); }
  .md-value-row.total {
    padding-top: .45rem; margin-top: .12rem; border-top: 1px solid var(--border-light);
    font-weight: 700; font-size: .95rem;
  }
  .md-items { width: 100%; border-collapse: collapse; margin: .1rem 0; }
  .md-items th, .md-items td {
    text-align: left; padding: .38rem .3rem; border-bottom: 1px solid var(--border-light); font-size: .83rem;
  }
  .md-items th.num, .md-items td.num { text-align: right; }
  .md-note-box {
    padding: .68rem .78rem; border-radius: 10px; background: var(--warning-bg);
    color: var(--warning-text); font-size: .81rem; line-height: 1.45;
  }
  .md-note-box.danger { background: var(--danger-bg); color: var(--danger-text); }
  .md-timeline { list-style: none; margin: 0; padding: 0; }
  .md-timeline-item { position: relative; padding: 0 0 .85rem 1.2rem; }
  .md-timeline-item::before {
    content: ''; position: absolute; left: 3px; top: .5rem; bottom: -.05rem; width: 1px;
    background: var(--border-light);
  }
  .md-timeline-item:last-child::before { display: none; }
  .md-timeline-item:last-child { padding-bottom: 0; }
  .md-timeline-dot {
    position: absolute; left: 0; top: .3rem; width: 7px; height: 7px; border-radius: 50%;
    background: var(--border); box-shadow: 0 0 0 3px var(--surface);
  }
  .md-timeline-item.current .md-timeline-dot { background: var(--primary); }
  .md-timeline-title { display: flex; gap: .4rem; align-items: baseline; flex-wrap: wrap; font-size: .84rem; }
  .md-timeline-title strong { font-weight: 600; }
  .md-timeline-item.current .md-timeline-title strong { color: var(--primary); }
  .md-timeline-detail { color: var(--text-muted); font-size: .75rem; margin-top: .08rem; }
  .md-section-toggle {
    width: 100%; display: flex; justify-content: space-between; align-items: center; gap: .5rem;
    border: 0; background: transparent; color: var(--text); font-weight: 600; font-size: .85rem;
    padding: 0; cursor: pointer; font-family: inherit;
  }
  .md-status-form { display: flex; flex-direction: column; gap: .55rem; margin-top: .65rem; }
  .md-status-form .input { width: 100%; }
  .md-status-form .btn { align-self: flex-start; }
  .md-raw { margin-top: 1rem; }
  .md-raw summary { cursor: pointer; color: var(--text-muted); font-size: .81rem; }
  .md-raw pre {
    margin: .5rem 0 0; padding: .65rem; border-radius: 8px; background: var(--surface);
    border: 1px solid var(--border-light); font-size: .72rem; line-height: 1.45;
    max-height: 260px; overflow: auto; white-space: pre-wrap; word-break: break-word;
  }

  /* Tela de integração */
  .md-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 1rem; align-items: start; }
  .md-field { display: flex; flex-direction: column; gap: .3rem; margin-bottom: .8rem; }
  .md-field label { margin: 0; font-size: .85rem; font-weight: 600; }
  .md-field .hint { color: var(--text-muted); font-size: .76rem; }
  .md-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; }
  .md-check { display: flex; gap: .5rem; align-items: flex-start; margin: .6rem 0; font-size: .9rem; }
  .md-check input { margin-top: .2rem; accent-color: var(--primary); }
  .md-status-list { display: flex; flex-direction: column; gap: .45rem; margin: .6rem 0; }
  .md-status-item { display: flex; gap: .5rem; align-items: center; font-size: .87rem; }
  .md-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--danger); flex: 0 0 auto; }
  .md-dot.on { background: #22c55e; }
  .md-actions { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; margin-top: .9rem; }
  .md-test { margin-top: 1rem; }
  .md-test-card { border: 1px solid var(--border-light); border-radius: 12px; padding: .85rem; background: var(--surface-hover); }
  .md-test-card.ok { border-color: color-mix(in srgb, #22c55e 35%, var(--border-light)); }
  .md-test-card.err { border-color: color-mix(in srgb, var(--danger) 35%, var(--border-light)); }
  .md-test-card h3 { margin: 0 0 .25rem; font-size: .95rem; }
  .md-password-wrap { position: relative; }
  .md-password-wrap .input { width: 100%; padding-right: 4.6rem; }
  .md-password-toggle {
    position: absolute; right: .38rem; top: 50%; transform: translateY(-50%);
    border: 0; background: transparent; color: var(--text-muted); font-size: .72rem;
    cursor: pointer; padding: .25rem .38rem; border-radius: 6px; font-family: inherit;
  }
  .md-password-toggle:hover { background: var(--surface-hover); color: var(--text); }
  .md-config-summary { display: flex; gap: .35rem; flex-wrap: wrap; margin-top: .4rem; }
  .md-config-chip {
    display: inline-flex; align-items: center; gap: .3rem; padding: .22rem .55rem;
    border-radius: 999px; border: 1px solid var(--border-light); background: var(--surface);
    font-size: .73rem; color: var(--text-secondary);
  }
  .md-config-chip strong { color: var(--text); font-variant-numeric: tabular-nums; }
  .md-config-chip.sandbox { background: var(--warning-bg); color: var(--warning-text); border-color: transparent; }
  .md-help { margin: .5rem 0 0; padding: 0; list-style: none; counter-reset: md-step; }
  .md-help li { position: relative; padding: 0 0 .55rem 1.7rem; font-size: .81rem; color: var(--text-secondary); }
  .md-help li::before {
    counter-increment: md-step; content: counter(md-step);
    position: absolute; left: 0; top: -.05rem; width: 1.15rem; height: 1.15rem;
    display: grid; place-items: center; border-radius: 50%; background: var(--primary-bg);
    color: var(--primary); font-size: .68rem; font-weight: 700;
  }
  .md-help a { color: var(--primary); }

  @media (max-width: 900px) {
    .md-grid { grid-template-columns: 1fr; }
    .md-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    dialog.md-drawer {
      inset: 0; width: 100%; height: 100dvh; max-height: 100dvh; margin: 0;
      padding: 0; border: 0; border-radius: 0; animation: md-drawer-in .2s ease;
    }
    .md-drawer-head { padding: .85rem .95rem; }
    .md-drawer-body { padding: .85rem .95rem calc(1.2rem + env(safe-area-inset-bottom)); }
