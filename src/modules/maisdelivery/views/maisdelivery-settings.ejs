<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Integração Mais Delivery</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <style>
    .btn.disabled {
      opacity: 0.5;
      cursor: not-allowed;
      pointer-events: none;
    }
  </style>
  <%- include('partials/maisdelivery-styles') %>
  <script nonce="<%= cspNonce %>">
    window.MAISDELIVERY_CONFIG = <%- JSON.stringify(config) %>;
  </script>
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/maisdelivery/configuracoes' }) %>
  <main class="md-page" x-data="maisdeliverySettingsPage()" x-init="loadCloudCredentials()">
    <header class="md-head">
      <img src="/img/maisdelivery.png" alt="Mais Delivery" class="md-logo" />
      <div class="md-head-text">
        <h1>Integração Mais Delivery</h1>
        <p class="muted">Conecte o painel do Mais Delivery para acompanhar os pedidos do marketplace dentro do Kivo.</p>
        <div class="md-config-summary" x-show="isConfigured()" x-cloak>
          <span class="md-config-chip">Empresa <strong x-text="form.empresaIntegrada || '—'"></strong></span>
          <span class="md-config-chip">Restaurante <strong x-text="form.restaurante || '—'"></strong></span>
          <span class="md-config-chip" x-show="form.marketplace">Marketplace <strong x-text="form.marketplace"></strong></span>
          <span class="md-config-chip" :class="{ sandbox: form.sandbox }" x-text="form.sandbox ? 'Sandbox' : 'Produção'"></span>
        </div>
      </div>
      <div class="md-head-actions">
        <a class="btn secondary" href="https://maisdeliveryapp.com.br/web/institucional.auth.api.publica.php" target="_blank" rel="noopener">Abrir painel</a>
        <a class="btn" :href="isConfigured() ? '/app/maisdelivery/pedidos' : '#'" @click.prevent="!isConfigured()" :class="{ disabled: !isConfigured() }">Ver pedidos</a>
      </div>
    </header>

    <div class="md-banner" x-show="config.sandbox" x-cloak>
      <strong>Modo sandbox ligado.</strong>
      <span>Os pedidos exibidos são do ambiente de teste do Mais Delivery. Desligue somente quando for usar o token de produção.</span>
    </div>

    <div class="md-grid">
      <section class="panel">
        <h2>Código de integração da sua loja</h2>
        <p class="muted text-sm">
          Informe o código de integração fornecido pelo suporte do Mais Delivery. Ele identifica o seu restaurante ou marketplace.
          As credenciais (Access token e Basic Auth) já vêm configuradas pela sede.
        </p>

        <div class="md-field" :disabled="!canEditCodigo">
          <label for="md-codigo-integracao">Código de integração</label>
          <input id="md-codigo-integracao" type="number" min="1" step="1" class="input" x-model="form.codigoIntegracao"
                 :placeholder="config.restaurante || config.marketplace ? '•••••••• (salvo)' : 'Ex.: 50451'"
                 :disabled="!canEditCodigo" />
          <span class="hint">Fornecido pelo suporte do Mais Delivery. Use apenas números.</span>
        </div>

        <div class="md-field" :disabled="!canEditCodigo">
          <label>Tipo de integração</label>
          <div class="md-radio-group" role="radiogroup">
            <label class="md-radio">
              <input type="radio" name="mdTipo" value="restaurante" x-model="form.tipo" :disabled="!canEditCodigo" />
              <span>Restaurante</span>
            </label>
            <label class="md-radio">
              <input type="radio" name="mdTipo" value="marketplace" x-model="form.tipo" :disabled="!canEditCodigo" />
              <span>Marketplace</span>
            </label>
          </div>
          <span class="hint">O suporte do Mais Delivery informa qual usar. O tipo determina se o pedido é consultado pelo ID do restaurante ou pelo ID do marketplace.</span>
        </div>

        <div class="md-actions">
          <button type="button" class="btn" @click="salvarCodigo()" :disabled="saving || !canEditCodigo">
            <span x-text="saving ? 'Integrando…' : 'Salvar código de integração'"></span>
          </button>
        </div>
        <p class="error" x-text="errorCodigo" x-show="errorCodigo" x-cloak></p>
        <p class="md-note" x-text="noticeCodigo" x-show="noticeCodigo" x-cloak></p>
      </section>

      <section class="panel">
        <h2>Status da integração</h2>
        <div class="md-status-list">
          <div class="md-status-item">
            <span class="md-dot" :class="{ on: config.hasAccessTokenProducao || config.hasAccessTokenSandbox }"></span>
            <span x-text="(config.hasAccessTokenProducao || config.hasAccessTokenSandbox) ? 'Access token da sede configurado na VPS' : 'Access token da sede não configurado'"></span>
          </div>
          <div class="md-status-item">
            <span class="md-dot" :class="{ on: config.hasBasicAuth }"></span>
            <span x-text="config.hasBasicAuth ? 'Basic Auth da sede configurado na VPS' : 'Basic Auth da sede não configurado'"></span>
          </div>
          <div class="md-status-item">
            <span class="md-dot" :class="{ on: isConfigured() }"></span>
            <span x-text="isConfigured() ? 'Pronto para listar pedidos' : 'Faltam dados para listar pedidos'"></span>
          </div>
          <div class="md-status-item">
            <span class="md-dot" :class="{ on: !config.sandbox }"></span>
            <span x-text="config.sandbox ? 'Modo sandbox (teste)' : 'Modo produção'"></span>
          </div>
        </div>

        <div class="md-test" x-show="testResult || testError" x-cloak>
          <div class="md-test-card" :class="testResult ? 'ok' : 'err'">
            <h3 x-text="testResult ? (testResult.establishment && testResult.establishment.name ? testResult.establishment.name : 'Conexão validada') : 'Falha no teste'"></h3>
            <p class="muted text-sm" x-text="testResult ? establishmentLine() : testError"></p>
            <div class="md-actions" x-show="testResult">
              <a class="btn small" href="/app/maisdelivery/pedidos">Ver pedidos</a>
            </div>
            <details class="md-raw" x-show="testResult">
              <summary>Resposta original da API</summary>
              <pre x-text="testResult ? JSON.stringify(testResult.raw, null, 2) : ''"></pre>
            </details>
          </div>
        </div>

        <div style="margin-top:1.1rem">
          <h3>Como configurar</h3>
          <ol class="md-help">
            <li>O administrador salva o Access token, o Basic Auth e o ID da empresa integrada no painel cloud (Integrações &rarr; Mais Delivery).</li>
            <li>Informe o código de integração da sua loja (Restaurante ou Marketplace) recebido do suporte do Mais Delivery.</li>
            <li>Salve e teste a conexão. Quando o estabelecimento aparecer, abra <a href="/app/maisdelivery/pedidos">Pedidos</a>.</li>
          </ol>
        </div>

        <p class="muted text-xs" style="margin-top:1rem">
          O modo sandbox envia <code>sandBox: true</code> em todas as operações. Para obter as credenciais,
          <a href="https://maisdeliveryapp.com.br/web/institucional.cadastro.api.publica.php" target="_blank" rel="noopener">cadastre a empresa</a>
          e faça login no painel. O administrador salva o Access token e o Basic Auth na nuvem (painel cloud),
          e eles são compartilhados com todas as lojas.
        </p>
      </section>
    </div>
  </main>

  <script nonce="<%= cspNonce %>">
    function maisdeliverySettingsPage() {
      const cfg = window.MAISDELIVERY_CONFIG || {};
      // A tela inteira já fica atrás de `maisdelivery.settings.manage` (pages.ts), então
      // editar o código de integração não deve depender da permissão de VER pedidos.
      const canSettings = <%- canSettings ? 'true' : 'false' %>;
      return {
        canOrders,
        canEditCodigo() {
          return canSettings;
        },
        form: {
          empresaIntegrada: cfg.empresaIntegrada ?? '',
          restaurante: cfg.restaurante ?? '',
          marketplace: cfg.marketplace ?? '',
          sandbox: cfg.sandbox !== false,
          codigoIntegracao: '',
          tipo: cfg.restaurante ? 'restaurante' : (cfg.marketplace ? 'marketplace' : 'restaurante'),
        },
        hasAccessTokenProducao: !!cfg.hasAccessTokenProducao,
        hasAccessTokenSandbox: !!cfg.hasAccessTokenSandbox,
        hasBasicAuth: !!cfg.hasBasicAuth,
        cloudLoading: true,
        cloudError: '',
        saving: false,
        testing: false,
        error: '',
        notice: '',
        errorCodigo: '',
        noticeCodigo: '',
        testResult: null,
        testError: '',
        isConfigured() {
          return !!(
            (this.hasAccessTokenProducao || this.hasAccessTokenSandbox) &&
            this.hasBasicAuth &&
            Number(this.form.empresaIntegrada) > 0 &&
            (Number(this.form.restaurante) > 0 || Number(this.form.marketplace) > 0)
          );
        },
        establishmentLine() {
          if (!this.testResult || !this.testResult.establishment) {
            return 'A API respondeu sem os dados do estabelecimento.';
          }
          const e = this.testResult.establishment;
          return [e.document, e.phone, e.address].filter(Boolean).join(' · ')
            || 'Estabelecimento consultado com sucesso.';
        },
        applyConfig(data) {
          this.form.empresaIntegrada = data.empresaIntegrada ?? '';
          this.form.restaurante = data.restaurante ?? '';
          this.form.marketplace = data.marketplace ?? '';
          this.form.sandbox = data.sandbox !== false;
        },
        async loadCloudCredentials() {
          this.cloudLoading = true;
          this.cloudError = '';
          try {
            const cloudUrl = await this.getCloudUrl();
            if (!cloudUrl) {
              this.cloudError = 'Não foi possível resolver a URL do cloud.';
              return;
            }
            const licenseKey = await this.getLicenseKey();
            const companyUuid = await this.getCompanyUuid();
            if (!licenseKey || !companyUuid) {
              this.cloudError = 'Licença não configurada.';
              return;
            }
            const res = await fetch(`${cloudUrl}/api/maisdelivery/credentials`, {
              headers: {
                'X-Kivo-Company': companyUuid,
                'X-Kivo-License-Key': licenseKey,
              },
            });
            if (!res.ok) {
              this.cloudError = 'Não foi possível buscar credenciais da sede.';
              return;
            }
            const data = await res.json();
            this.hasAccessTokenProducao = !!data.hasAccessTokenProducao;
            this.hasAccessTokenSandbox = !!data.hasAccessTokenSandbox;
            this.hasBasicAuth = !!data.hasBasicAuth;
            if (data.idEmpresaIntegrada) {
              this.form.empresaIntegrada = String(data.idEmpresaIntegrada);
              // Persiste o ID da empresa da sede no banco local para as chamadas à API.
              await this.saveEmpresaIntegrada();
            }
            if (data.sandbox !== undefined) {
              this.form.sandbox = !!data.sandbox;
              await this.saveSandbox();
            }
          } catch (e) {
            this.cloudError = 'Erro ao buscar credenciais da nuvem.';
          } finally {
            this.cloudLoading = false;
          }
        },
        async saveEmpresaIntegrada() {
          try {
            await fetch('/api/maisdelivery/settings', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                empresaIntegrada: numOrNull(this.form.empresaIntegrada),
              }),
            });
          } catch {
            // Falha ao persistir empresa integrada; o teste de conexão vai falhar com mensagem clara.
          }
        },
        async saveSandbox() {
          try {
            await fetch('/api/maisdelivery/settings', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                sandbox: this.form.sandbox,
              }),
            });
          } catch {
            // Falha ao persistir sandbox.
          }
        },
        async getCloudUrl() {
          try {
            const res = await fetch('/api/sync/settings', { credentials: 'same-origin' });
            if (res.ok) {
              const data = await res.json();
              return data.serverUrl || null;
            }
          } catch { /* ignore */ }
          return null;
        },
        async getLicenseKey() {
          try {
            const res = await fetch('/api/license/info', { credentials: 'same-origin' });
            if (res.ok) {
              const data = await res.json();
              return data.licenseKey || null;
            }
          } catch { /* ignore */ }
          return null;
        },
        async getCompanyUuid() {
          try {
            const res = await fetch('/api/company/info', { credentials: 'same-origin' });
            if (res.ok) {
              const data = await res.json();
              return data.companyUuid || null;
            }
          } catch { /* ignore */ }
          return null;
        },
        async salvarCodigo() {
          if (this.saving) return false;
          this.saving = true;
          this.errorCodigo = '';
          this.noticeCodigo = '';
          this.testResult = null;
          this.testError = '';

          const codigo = Number(this.form.codigoIntegracao);
          if (!Number.isInteger(codigo) || codigo <= 0) {
            this.errorCodigo = 'Informe um código de integração válido.';
            this.saving = false;
            return false;
          }

          try {
            const body = {
              empresaIntegrada: numOrNull(this.form.empresaIntegrada),
              restaurante: this.form.tipo === 'restaurante' ? codigo : null,
              marketplace: this.form.tipo === 'marketplace' ? codigo : null,
              sandbox: !!this.form.sandbox,
            };
            const response = await fetch('/api/maisdelivery/settings', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            const data = await response.json().catch(() => ({}));
            if (!response.ok) {
              this.errorCodigo = data.error || 'Não foi possível salvar o código de integração.';
              return false;
            }
            this.applyConfig(data);
            this.noticeCodigo = 'Código de integração salvo.';
            if (data.restaurante || data.marketplace) {
              this.testResult = null;
              this.testError = '';
              try {
                const testResponse = await fetch('/api/maisdelivery/test', { method: 'POST' });
                const testData = await testResponse.json().catch(() => ({}));
                if (testResponse.ok) {
                  this.testResult = testData;
                  this.noticeCodigo = 'Código de integração salvo e conexão validada.';
                } else {
                  this.testError = testData.error || 'Código salvo, mas a validação da conexão falhou.';
                }
              } catch {
                this.testError = 'Código salvo, mas não foi possível validar a conexão.';
              }
            }
            return true;
          } catch {
            this.errorCodigo = 'Erro de conexão ao salvar o código de integração.';
            return false;
          } finally {
            this.saving = false;
          }
        },
      };

      function numOrNull(value) {
        const parsed = Number(value);
        return Number.isInteger(parsed) && parsed > 0 ? parsed : null;
      }
    }
  </script>
</body>
</html>
