<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Integração Mais Delivery</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <%- include('partials/maisdelivery-styles') %>
  <script nonce="<%= cspNonce %>">
    window.MAISDELIVERY_CONFIG = <%- JSON.stringify(config) %>;
  </script>
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/maisdelivery/configuracoes' }) %>
  <main class="md-page" x-data="maisdeliverySettingsPage()">
    <header class="md-head">
      <img src="/img/maisdelivery.png" alt="Mais Delivery" class="md-logo" />
      <div class="md-head-text">
        <h1>Integração Mais Delivery</h1>
        <p class="muted" x-text="configured ? 'Sua loja está conectada ao marketplace.' : 'Conecte o painel do Mais Delivery para acompanhar os pedidos do marketplace dentro do Kivo.'"></p>
        <div class="md-config-summary" x-show="configured" x-cloak>
          <span class="md-config-chip" x-text="restauranteLabel()"></span>
          <span class="md-config-chip">Empresa <strong x-text="empresaIntegrada"></strong></span>
          <span class="md-config-chip" :class="{ sandbox }" x-text="sandbox ? 'Sandbox' : 'Produção'"></span>
        </div>
      </div>
      <div class="md-head-actions">
        <a class="btn secondary" href="https://maisdeliveryapp.com.br/web/institucional.auth.api.publica.php" target="_blank" rel="noopener">Abrir painel</a>
        <a class="btn" x-show="configured && canOrders" x-cloak href="/app/maisdelivery/pedidos">Ver pedidos</a>
      </div>
    </header>

    <div class="md-banner" x-show="configured && sandbox" x-cloak>
      <strong>Modo sandbox ligado.</strong>
      <span>Os pedidos exibidos são do ambiente de teste do Mais Delivery. Desligue somente quando for usar o token de produção.</span>
    </div>

    <% if (configured) { %>
      <!-- Loja já integrada: visão enxuta, só status e atalhos. -->
      <div class="md-grid">
        <section class="panel">
          <h2>Status da integração</h2>
          <div class="md-status-list">
            <div class="md-status-item">
              <span class="md-dot" :class="tokenDotClass()"></span>
              <span x-text="sedeTokenLabel()"></span>
            </div>
            <div class="md-status-item">
              <span class="md-dot" :class="basicAuthDotClass()"></span>
              <span x-text="basicAuthLabel()"></span>
            </div>
            <div class="md-status-item">
              <span class="md-dot" :class="{ on: !sandbox, wait: sandbox && !cloudLoading }"></span>
              <span x-text="sandbox ? 'Modo sandbox (teste)' : 'Modo produção'"></span>
            </div>
            <div class="md-status-item">
              <span class="md-dot" :class="sedeDotClass()"></span>
              <span x-text="sedeStatusLabel()"></span>
            </div>
          </div>
          <p class="error" x-text="cloudError" x-show="cloudError" x-cloak></p>
        </section>

        <section class="panel">
          <h2>Sua integração</h2>
          <p class="muted text-sm">
            O código de integração identifica o seu restaurante ou marketplace no Mais Delivery.
          </p>
          <div class="md-status-list">
            <div class="md-status-item"><strong x-text="restauranteLabel()"></strong></div>
            <div class="md-status-item" style="color:var(--text-muted)">
              <span>Empresa integrada: <strong x-text="empresaIntegrada"></strong></span>
            </div>
          </div>
          <div class="md-actions">
            <a class="btn" x-show="canOrders" href="/app/maisdelivery/pedidos">Ver pedidos</a>
            <button type="button" class="btn secondary" @click="openModal()" :disabled="!canSettings">
              Alterar código de integração
            </button>
          </div>
        </section>
      </div>
    <% } else { %>
      <!-- Loja ainda não integrada: onboarding com CTA único. -->
      <section class="md-onboard">
        <div class="md-onboard-icon" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 17h4V5H2v12h3" /><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5" /><path d="M14 17h1" /><circle cx="7.5" cy="17.5" r="2.5" /><circle cx="17.5" cy="17.5" r="2.5" />
          </svg>
        </div>
        <h2>Conectar minha loja</h2>
        <p>
          Você só precisa do <strong>código de integração</strong> que o suporte do Mais Delivery te passou.
          As credenciais já são configuradas pela sede automaticamente.
        </p>
        <button type="button" class="btn primary md-btn-xl" @click="openModal()" :disabled="!canSettings">
          <span x-text="canSettings ? 'Integrar agora' : 'Sem permissão para integrar'"></span>
        </button>
        <details class="md-onboard-details">
          <summary>Como funciona a integração</summary>
          <ol class="md-help">
            <li>O administrador salva as credenciais da sede no painel cloud (Integrações &rarr; Mais Delivery).</li>
            <li>Aqui, você coloca apenas o código de integração da sua loja (Restaurante ou Marketplace).</li>
            <li>Ao integrar, o Kivo valida a conexão e já abre a tela de pedidos sincronizada.</li>
          </ol>
        </details>
      </section>
    <% } %>

    <!-- Modal de integração -->
    <dialog x-ref="integrateDlg" class="md-modal" @keydown.escape.prevent="closeModalIfIdle()" @click="backdropClose($event)">
      <div class="md-modal-body">
        <template x-if="!connecting && !done">
          <div>
            <h2 x-text="restaurante || marketplace ? 'Alterar código de integração' : 'Integrar minha loja'"></h2>
            <p class="muted">
              Cole o código de integração fornecido pelo suporte do Mais Delivery e selecione o tipo.
            </p>
            <div class="md-field">
              <label for="md-codigo-integracao">Código de integração</label>
              <input id="md-codigo-integracao" type="number" min="1" step="1" class="input" x-model="form.codigoIntegracao"
                     :placeholder="restaurante || marketplace ? 'Atual: ' + (restaurante || marketplace) : 'Ex.: 50451'"
                     @keydown.enter.prevent="integrar()" />
              <span class="hint">Use apenas números.</span>
            </div>
            <div class="md-field">
              <label>Tipo de integração</label>
              <div class="md-radio-group" role="radiogroup">
                <label class="md-radio">
                  <input type="radio" name="mdTipo" value="restaurante" x-model="form.tipo" />
                  <span>Restaurante</span>
                </label>
                <label class="md-radio">
                  <input type="radio" name="mdTipo" value="marketplace" x-model="form.tipo" />
                  <span>Marketplace</span>
                </label>
              </div>
              <span class="hint">O suporte do Mais Delivery informa qual usar.</span>
            </div>
            <div class="md-modal-actions">
              <button type="button" class="btn secondary" @click="closeModal()">Cancelar</button>
              <button type="button" class="btn" @click="integrar()">
                <span x-text="restaurante || marketplace ? 'Salvar e conectar' : 'Integrar'"></span>
              </button>
            </div>
            <div class="md-modal-error" x-show="integrarError" x-cloak>
              <span x-text="integrarError"></span>
            </div>
          </div>
        </template>

        <template x-if="connecting && !done">
          <div>
            <h2>Conectando sua loja…</h2>
            <p class="muted">Isso leva alguns segundos.</p>
            <div class="md-connecting">
              <div class="md-step" :class="stepClass(1)">
                <span class="md-step-dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                <span>Salvando código de integração</span>
              </div>
              <div class="md-step" :class="stepClass(2)">
                <span class="md-step-dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                <span>Conectando ao Mais Delivery</span>
              </div>
              <div class="md-step" :class="stepClass(3)">
                <span class="md-step-dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                <span>Validando credenciais da sede</span>
              </div>
            </div>
            <div class="md-modal-error" x-show="integrarError" x-cloak>
              <span x-text="integrarError"></span>
            </div>
            <div class="md-modal-actions" x-show="integrarError" x-cloak>
              <button type="button" class="btn secondary" @click="resetFlow()">Voltar e corrigir</button>
            </div>
          </div>
        </template>

        <template x-if="done">
          <div class="md-modal-success">
            <div class="md-modal-success-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h2>Loja integrada!</h2>
            <p class="muted" x-text="canOrders ? 'Tudo certo, já vamos abrir seus pedidos sincronizados…' : 'Conexão validada. Use o menu para abrir a tela de Pedidos.'"></p>
          </div>
        </template>
      </div>
    </dialog>
  </main>

  <script nonce="<%= cspNonce %>">
    function maisdeliverySettingsPage() {
      const cfg = window.MAISDELIVERY_CONFIG || {};
      const canOrders = <%- canOrders ? 'true' : 'false' %>;
      const canSettings = <%- canSettings ? 'true' : 'false' %>;
      return {
        canOrders,
        canSettings,
        // Estado local da integração (espelha o settings.ts via API).
        empresaIntegrada: cfg.empresaIntegrada ?? '',
        restaurante: cfg.restaurante ?? null,
        marketplace: cfg.marketplace ?? null,
        sandbox: cfg.sandbox !== false,
        hasAccessTokenProducao: false,
        hasAccessTokenSandbox: false,
        hasBasicAuth: false,
        cloudLoading: true,
        cloudError: '',
        // Modal
        form: {
          codigoIntegracao: '',
          tipo: cfg.restaurante ? 'restaurante' : (cfg.marketplace ? 'marketplace' : 'restaurante'),
        },
        connecting: false,
        step: 0,
        done: false,
        integrarError: '',
        get configured() {
          return Number(this.empresaIntegrada) > 0 && (Number(this.restaurante) > 0 || Number(this.marketplace) > 0);
        },
        restauranteLabel() {
          if (Number(this.restaurante) > 0) return `Restaurante · ${this.restaurante}`;
          if (Number(this.marketplace) > 0) return `Marketplace · ${this.marketplace}`;
          return 'Sem código de integração';
        },
        sedeConfigured() {
          return (this.hasAccessTokenProducao || this.hasAccessTokenSandbox) && this.hasBasicAuth;
        },
        /* Three-state das bolinhas: verde = ok, amarelo = validando na nuvem, vermelho = falta. */
        hasSedeToken() {
          return this.hasAccessTokenProducao || this.hasAccessTokenSandbox;
        },
        tokenDotClass() {
          if (this.hasSedeToken()) return { on: true };
          return { wait: this.cloudLoading };
        },
        basicAuthDotClass() {
          if (this.hasBasicAuth) return { on: true };
          return { wait: this.cloudLoading };
        },
        sedeDotClass() {
          if (this.sedeConfigured()) return { on: true };
          if (this.cloudError) return {};
          return { wait: this.cloudLoading };
        },
        sedeTokenLabel() {
          if (this.hasSedeToken()) return 'Access token da sede configurado na VPS';
          return this.cloudLoading ? 'Validando access token da sede…' : 'Access token da sede não configurado';
        },
        basicAuthLabel() {
          if (this.hasBasicAuth) return 'Basic Auth da sede configurado na VPS';
          return this.cloudLoading ? 'Validando Basic Auth da sede…' : 'Basic Auth da sede não configurado';
        },
        sedeStatusLabel() {
          if (this.cloudLoading) return 'Buscando credenciais da sede…';
          if (this.sedeConfigured()) return 'Sede em ordem: credenciais prontas para uso';
          return 'Faltam credenciais da sede no painel cloud';
        },
        /* Ao abrir a página (loja já integrada) valida as credenciais da sede na hora:
           sem isso as bolinhas ficavam eternamente "validando" até alguém integrar. */
        init() {
          if (Number(this.empresaIntegrada) > 0 || Number(this.restaurante) > 0 || Number(this.marketplace) > 0) {
            void this.buscarCredenciaisSede();
          }
        },
        stepClass(n) {
          return { done: n < this.step || this.done, active: n === this.step };
        },
        /* ---- modal ---- */
        openModal() {
          if (!this.canSettings) return;
          this.integrarError = '';
          this.step = 0;
          this.done = false;
          this.connecting = false;
          this.$refs.integrateDlg.showModal();
          this.$nextTick(() => document.getElementById('md-codigo-integracao')?.focus());
        },
        closeModal() {
          if (this.connecting && !this.integrarError) return; // não fecha no meio da animação
          this.$refs.integrateDlg.close();
        },
        closeModalIfIdle() {
          // ESC não fecha no meio da animação de conexão.
          if (!this.connecting || this.integrarError) this.$refs.integrateDlg.close();
        },
        backdropClose(event) {
          if (event.target === this.$refs.integrateDlg) this.closeModal();
        },
        resetFlow() {
          this.connecting = false;
          this.step = 0;
          this.integrarError = '';
        },
        async integrar() {
          if (this.connecting) return;
          this.integrarError = '';
          const codigo = Number(this.form.codigoIntegracao);
          if (!Number.isInteger(codigo) || codigo <= 0) {
            this.integrarError = 'Informe um código de integração válido.';
            return;
          }
          this.connecting = true;
          this.step = 1;
          try {
            const body = {
              empresaIntegrada: numOrNull(this.empresaIntegrada),
              restaurante: this.form.tipo === 'restaurante' ? codigo : null,
              marketplace: this.form.tipo === 'marketplace' ? codigo : null,
              sandbox: !!this.sandbox,
            };
            const response = await fetch('/api/maisdelivery/settings', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            const data = await response.json().catch(() => ({}));
            if (!response.ok) {
              throw new Error(data.error || 'Não foi possível salvar o código de integração.');
            }
            this.empresaIntegrada = data.empresaIntegrada ?? this.empresaIntegrada;
            this.restaurante = data.restaurante ?? null;
            this.marketplace = data.marketplace ?? null;
            if (data.sandbox !== undefined) this.sandbox = !!data.sandbox;

            this.step = 2;
            await this.buscarCredenciaisSede()

            this.step = 3;
            const testResponse = await fetch('/api/maisdelivery/test', { method: 'POST' });
            const testData = await testResponse.json().catch(() => ({}));
            if (!testResponse.ok) {
              throw new Error(testData.error || 'A conexão com o Mais Delivery falhou. Revise o código e tente de novo.');
            }

            this.done = true;
            if (this.canOrders) {
              setTimeout(() => { window.location.href = '/app/maisdelivery/pedidos'; }, 1400);
            }
          } catch (error) {
            this.integrarError = error instanceof Error ? error.message : 'Erro de conexão ao integrar.';
          }
        },
        /* ---- credenciais da sede (cloud) ---- */
        async buscarCredenciaisSede() {
          this.cloudLoading = true;
          this.cloudError = '';
          try {
            const cloudUrl = await this.getCloudUrl();
            if (!cloudUrl) throw new Error('cloud-url');
            const licenseKey = await this.getLicenseKey();
            const companyUuid = await this.getCompanyUuid();
            if (!licenseKey || !companyUuid) throw new Error('license');
            const res = await fetch(`${cloudUrl}/api/maisdelivery/credentials`, {
              headers: {
                'X-Kivo-Company': companyUuid,
                'X-Kivo-License-Key': licenseKey,
              },
            });
            if (!res.ok) throw new Error('cloud-fetch');
            const data = await res.json();
            this.hasAccessTokenProducao = !!data.hasAccessTokenProducao;
            this.hasAccessTokenSandbox = !!data.hasAccessTokenSandbox;
            this.hasBasicAuth = !!data.hasBasicAuth;
            if (data.idEmpresaIntegrada && Number(data.idEmpresaIntegrada) > 0) {
              this.empresaIntegrada = String(data.idEmpresaIntegrada);
              await this.saveEmpresaIntegrada();
            }
            if (data.sandbox !== undefined) {
              this.sandbox = !!data.sandbox;
              await this.saveSandbox();
            }
          } catch (e) {
            this.cloudError = 'Não foi possível validar as credenciais da sede proando a nuvem. A integração ainda pode funcionar, mas confira o painel cloud.';
          } finally {
            this.cloudLoading = false;
          }
        },
        async saveEmpresaIntegrada() {
          try {
            await fetch('/api/maisdelivery/settings', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ empresaIntegrada: numOrNull(this.empresaIntegrada) }),
            });
          } catch { /* o teste de conexão mostra erro claro se faltar */ }
        },
        async saveSandbox() {
          try {
            await fetch('/api/maisdelivery/settings', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ sandbox: this.sandbox }),
            });
          } catch { /* sem back de persistência */ }
        },
        async getCloudUrl() {
          try {
            const res = await fetch('/api/sync/settings', { credentials: 'same-origin' });
            if (res.ok) {
              const data = await res.json();
              return data.serverUrl || null;
            }
          } catch { /* ignore */ }
          return null;
        },
        async getLicenseKey() {
          try {
            const res = await fetch('/api/license/info', { credentials: 'same-origin' });
            if (res.ok) {
              const data = await res.json();
              return data.licenseKey || null;
            }
          } catch { /* ignore */ }
          return null;
        },
        async getCompanyUuid() {
          try {
            const res = await fetch('/api/company/info', { credentials: 'same-origin' });
            if (res.ok) {
              const data = await res.json();
              return data.companyUuid || null;
            }
          } catch { /* ignore */ }
          return null;
        },
      };
    }

    function numOrNull(value) {
      const parsed = Number(value);
      return Number.isInteger(parsed) && parsed > 0 ? parsed : null;
    }
  </script>
</body>
</html>
