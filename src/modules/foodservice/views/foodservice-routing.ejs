<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Roteamento para Cozinha</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/foodservice/roteamento' }) %>
  <main x-data="routingPage()" x-init="init()">
    <a href="/app/foodservice/cozinha" class="back-link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Painel de cozinha
    </a>
    <h1>Enviar para a cozinha</h1>
    <p class="muted muted-block">
      Os produtos desta lista geram pedido no <a href="/app/foodservice/cozinha">Painel de cozinha</a>
      sempre que forem lançados numa comanda ou vendidos no PDV. Produto fora da lista
      (refrigerante de geladeira, um boné) não incomoda a cozinha.
    </p>

    <table class="routing-table" x-show="list.length">
      <thead>
        <tr><th>Produto</th><th>SKU</th><th>Estação</th><th style="width:140px">Tempo estimado</th><th></th></tr>
      </thead>
      <tbody>
        <template x-for="r in list" :key="r.id">
          <tr>
            <td data-label="Produto" x-text="r.product_name"></td>
            <td data-label="SKU" class="muted" x-text="r.sku || '—'"></td>
            <td data-label="Estação"><input type="text" x-model="r.station" class="input input-narrow-lg" placeholder="Ex.: Chapa" /></td>
            <td data-label="Tempo estimado">
              <div class="flex-center" style="gap:.35rem">
                <input type="number" x-model="r.estimated_minutes" class="input input-narrow-sm" min="1" />
                <span class="muted text-xs">min</span>
              </div>
            </td>
            <td class="actions-cell">
              <button type="button" class="icon-btn" @click="update(r)" title="Salvar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span class="mobile-label">Salvar</span>
              </button>
              <button type="button" class="icon-btn active" @click="remove(r)" title="Remover">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                <span class="mobile-label">Remover</span>
              </button>
            </td>
          </tr>
        </template>
      </tbody>
    </table>

    <div x-show="!list.length" x-cloak>
      <%- include('partials/empty-state', { message: 'Nenhum produto vai para a cozinha ainda — enquanto isso, o painel de produção fica vazio.' }) %>
    </div>

    <div class="panel mt-2">
      <h2>Adicionar produto</h2>
      <%# Grade visual com foto: garçom/dono acha o produto DE VISTA, sem depender de
          decorar nome/SKU. A lista já abre mostrando o catálogo; buscar filtra nela. %>
      <input type="text" class="input" style="width:100%" x-model="searchQ"
             @input.debounce.300ms="loadPicker()" placeholder="Buscar produto por nome ou SKU…" />
      <div class="picker-grid" x-show="searchResults.length" x-cloak>
        <template x-for="p in searchResults" :key="p.id">
          <button type="button" class="pick-card" @click="addProduct(p)" :title="'Enviar ' + p.name + ' para a cozinha'">
            <span class="pick-thumb">
              <img x-show="p.image_url" :src="p.image_url" alt="" loading="lazy" />
              <template x-if="!p.image_url">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </template>
            </span>
            <span class="pick-name" x-text="p.name"></span>
            <span class="pick-meta">
              <span class="muted text-sm" x-show="p.category" x-text="p.category"></span>
              <strong x-text="brl(p.price_cents)"></strong>
            </span>
          </button>
        </template>
      </div>
      <p class="muted text-sm" x-show="!searchResults.length" x-cloak style="margin-top:.6rem">
        <span x-show="searchQ.trim()">Nenhum produto encontrado para “<span x-text="searchQ"></span>”.</span>
        <span x-show="!searchQ.trim()">Todos os produtos do catálogo já vão para a cozinha.</span>
      </p>
      <div class="error" x-text="error"></div>
    </div>
  </main>
  <style>
    /* Mesma seta de voltar da tela de comanda — a classe é local lá, não global. */
    .back-link {
      display: inline-flex; align-items: center; gap: .3rem;
      font-size: .8rem; color: var(--text-muted); text-decoration: none; margin-bottom: .4rem;
      transition: color var(--transition);
    }
    .back-link:hover { color: var(--primary); }

    /* ─── Grade de produtos com foto (escolher o que vai para a cozinha) ─── */
    .picker-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: .7rem;
      margin-top: .75rem;
    }
    .pick-card {
      display: flex; flex-direction: column; gap: .25rem;
      border: 1.5px solid var(--border-light); border-radius: var(--radius);
      background: var(--surface); padding: .5rem; cursor: pointer; text-align: left;
      transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
    }
    .pick-card:hover {
      border-color: var(--primary); transform: translateY(-2px);
      box-shadow: var(--shadow-sm, 0 4px 12px rgba(0,0,0,.08));
    }
    .pick-thumb {
      aspect-ratio: 1 / 1; width: 100%; border-radius: calc(var(--radius) - 4px);
      overflow: hidden; background: var(--surface-hover); border: 1px solid var(--border-light);
      display: grid; place-items: center; color: var(--text-muted);
    }
    .pick-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .pick-name {
      font-weight: 600; font-size: .88rem; line-height: 1.25; color: var(--text);
      min-width: 0; overflow-wrap: anywhere;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .pick-meta {
      display: flex; justify-content: space-between; align-items: baseline; gap: .35rem; min-width: 0;
    }
    .pick-meta .text-sm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pick-meta strong { color: var(--primary); font-size: .9rem; white-space: nowrap; }

    .mobile-label { display: none; }
    /* ─── Celular: tabela vira lista de cards (tabela larga é ilegível em tela estreita) ─── */
    @media (max-width: 640px) {
      .routing-table, .routing-table tbody, .routing-table tr, .routing-table td { display: block; width: 100%; }
      .routing-table thead { display: none; }
      .routing-table { box-shadow: none; }
      .routing-table tr {
        margin-bottom: .85rem; background: var(--surface); border: 1.5px solid var(--border-light);
        border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-xs);
      }
      .routing-table td {
        display: flex; align-items: center; justify-content: space-between; gap: .75rem;
        padding: .65rem .9rem; border-bottom: 1px solid var(--border-light); border-radius: 0 !important;
      }
      .routing-table td:last-child { border-bottom: 0; }
      .routing-table td[data-label]::before {
        content: attr(data-label); flex-shrink: 0;
        font-size: .78rem; font-weight: 600; color: var(--text-muted);
      }
      .routing-table td .input { width: auto; flex: 1; max-width: 60%; }
      .routing-table td.actions-cell { justify-content: flex-end; gap: .25rem; }
      .routing-table .icon-btn {
        width: auto; height: 38px; padding: 0 .8rem; gap: .4rem;
        border: 1.5px solid var(--border-light); border-radius: 8px;
      }
      .routing-table .mobile-label { display: inline; font-size: .82rem; font-weight: 600; }
    }
  </style>
  <script nonce="<%= cspNonce %>">
    function routingPage() {
      return {
        list: [],
        searchQ: '',
        searchResults: [],
        error: '',
        async init() { await this.load(); await this.loadPicker(); },
        async load() {
          const r = await fetch('/api/foodservice/kitchen-routing');
          if (r.ok) this.list = await r.json();
        },
        // Sem busca: catálogo vendável inteiro (scope=sellable inclui variantes).
        // Com busca: resultado da busca. Em ambos, quem já está roteado some da lista.
        async loadPicker() {
          const qs = this.searchQ.trim()
            ? '?q=' + encodeURIComponent(this.searchQ.trim())
            : '?scope=sellable';
          const r = await fetch('/api/commercial/products' + qs);
          if (r.ok) {
            const all = await r.json();
            const routedIds = new Set(this.list.map((x) => x.product_id));
            this.searchResults = all.filter((p) => !routedIds.has(p.id) && !p.deleted_at);
          }
        },
        brl(c) { return window.brl(c); },
        async addProduct(p) {
          const r = await fetch('/api/foodservice/kitchen-routing', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId: p.id }),
          });
          if (r.ok) { this.searchQ = ''; await this.load(); await this.loadPicker(); showToast(p.name + ' agora vai para a cozinha.', 'success'); }
          else showToast((await r.json()).error ?? 'Erro ao adicionar produto.', 'error');
        },
        async update(r) {
          const res = await fetch(`/api/foodservice/kitchen-routing/${r.id}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ station: r.station, estimatedMinutes: Number(r.estimated_minutes) || null }),
          });
          if (!res.ok) showToast((await res.json()).error ?? 'Erro ao salvar.', 'error');
        },
        async remove(r) {
          if (!await window.confirmDlg('Remover ' + r.product_name + ' do roteamento?')) return;
          const res = await fetch(`/api/foodservice/kitchen-routing/${r.id}`, { method: 'DELETE' });
          if (res.ok) await this.load();
          else showToast((await res.json()).error ?? 'Erro ao remover.', 'error');
        },
      };
    }
  </script>
</body>
</html>
