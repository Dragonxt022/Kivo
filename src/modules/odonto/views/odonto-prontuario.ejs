<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Prontuário</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <%- include('partials/odonto-ui') %>
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
  <style>
    .evolucao { border: 1px solid var(--border-light); border-radius: 12px; padding: 14px 16px; margin-bottom: 14px; background: var(--surface); }
    .evolucao.retificada { border-style: dashed; opacity: .9; }
    .evolucao h3 { margin: 0 0 4px; font-size: 1rem; }
    .evolucao .meta { color: var(--text-secondary); font-size: .78rem; margin-bottom: 10px; }
    /* Procedimentos separados dos campos por uma linha: antes tudo ficava colado. */
    .evolucao .proc { display: flex; gap: 6px; flex-wrap: wrap; padding-bottom: 10px; margin-bottom: 10px; border-bottom: 1px dashed var(--border-light); }
    .evolucao .proc .tag { background: var(--surface-hover); border: 1px solid var(--border-light); border-radius: 8px; padding: 3px 9px; font-size: .78rem; }
    /* Campos em grade: rótulo à esquerda, resposta à direita, com separador leve por linha
       (antes as linhas ficavam grudadas e o rótulo curto deixava um vão irregular). */
    .evolucao dl { display: grid; grid-template-columns: 136px 1fr; gap: 0 14px; margin: 0; font-size: .88rem; }
    .evolucao dl > div dt, .evolucao dl > div dd { padding: 7px 0; border-top: 1px solid var(--border-light); }
    .evolucao dl > div:first-child dt, .evolucao dl > div:first-child dd { border-top: 0; }
    .evolucao dt { color: var(--text-secondary); font-weight: 600; }
    .evolucao dd { margin: 0; white-space: pre-wrap; }
    .proc-linha { display: grid; grid-template-columns: 2fr 90px 2fr auto; gap: 6px; align-items: center; margin-bottom: 4px; }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/odonto/pacientes' }) %>
  <main id="tour-odonto-conteudo" x-data="prontuarioPage(<%= patientId %>, <%= canEditClinical ? 'true' : 'false' %>, <%= canRetify ? 'true' : 'false' %>)" x-init="load()">
    <h1 style="display:flex;align-items:center;gap:10px"><%- include('partials/odonto-icon', { name: 'file-text', size: 24 }) %> Prontuário <span class="patient-ref" x-show="paciente" x-cloak><%- include('partials/odonto-icon', { name: 'users', size: 14 }) %><span x-text="paciente ? paciente.name : ''"></span></span></h1>

    <div id="tour-odonto-secoes"><%- include('partials/odonto-paciente-tabs', { patientId: patientId, atual: 'prontuario' }) %></div>

    <div class="toolbar" id="tour-odonto-toolbar">
      <% if (canEditClinical) { %>
        <button class="btn" @click="nova()">
          <%- include('partials/odonto-icon', { name: 'plus' }) %>
          <span>Nova evolução</span>
        </button>
      <% } %>
      <span class="toolbar-note">
        <%- include('partials/odonto-icon', { name: 'clipboard', size: 14 }) %>
        <span x-text="resumo.vigentes + ' evolução(ões)' + (resumo.retificadas ? ' · ' + resumo.retificadas + ' retificada(s)' : '') + (resumo.ultima ? ' · última ' + fmtDateTimeLocal(resumo.ultima) : '')"></span>
      </span>
      <span class="error" x-text="error"></span>
    </div>

    <p class="helper">
      <%- include('partials/odonto-icon', { name: 'info', size: 15 }) %>
      <span>Registro clínico <strong>não é apagado</strong>: para corrigir, use a <strong>retificação</strong> — o texto anterior fica no histórico com o motivo, quem corrigiu e quando.</span>
    </p>

    <div id="tour-odonto-prontuario"></div>
    <template x-for="n in notes" :key="n.id">
      <div class="evolucao" :class="{ retificada: n.status === 'retificado' }">
        <h3 x-text="fmtDateTimeLocal(n.happened_at) + (n.title ? ' · ' + n.title : '')"></h3>
        <div class="meta">
          <span x-text="n.professional_name ? (n.professional_name + (n.professional_cro ? ' · CRO ' + n.professional_cro : '')) : 'Profissional não informado'"></span>
          <span x-show="n.created_by_name" x-text="' · registrado por ' + n.created_by_name"></span>
          <span x-show="n.version > 1" x-text="' · versão ' + n.version + ' (retificação)'"></span>
          <span class="badge" x-show="n.status === 'retificado'" style="margin-left:6px">retificada</span>
          <span x-show="n.replaced_by_name" x-text="' por ' + n.replaced_by_name"></span>
          <span x-show="n.retification_reason" x-text="' · motivo: ' + n.retification_reason"></span>
        </div>

        <div class="proc" x-show="n.procedures.length" style="margin-bottom:8px">
          <template x-for="(p, i) in n.procedures" :key="i">
            <span class="tag" x-text="p.name + (p.tooth ? ' · dente ' + p.tooth : '') + (p.note ? ' · ' + p.note : '')"></span>
          </template>
        </div>

        <dl>
          <!-- x-for com um único raiz (o Alpine não repete múltiplos): `display:contents`
               deixa os dt/dd participarem da grade do dl. -->
          <template x-for="c in campos(n)" :key="c.label">
            <div style="display:contents">
              <dt x-text="c.label"></dt>
              <dd x-text="c.value"></dd>
            </div>
          </template>
        </dl>

        <div class="toolbar" style="margin:0">
          <button class="btn secondary small" @click="verHistorico(n)"><%- include('partials/odonto-icon', { name: 'clock', size: 14 }) %><span>Histórico de versões</span></button>
          <% if (canRetify) { %>
            <button class="btn secondary small" x-show="n.status === 'vigente'" @click="retificar(n)" title="Cria uma versão corrigida; a atual vai para o histórico com o motivo"><%- include('partials/odonto-icon', { name: 'pencil', size: 14 }) %><span>Retificar</span></button>
          <% } %>
        </div>
      </div>
    </template>

    <div x-show="!notes.length">
      <%- include('partials/empty-state', { message: 'Nenhuma evolução registrada ainda.' }) %>
    </div>

    <% if (canEditClinical) { %>
    <!-- Um diálogo para os dois atos: registrar (novo) e retificar (correção com motivo). -->
    <dialog x-ref="dlg" class="dialog-fixed">
      <h1 x-text="modo === 'retificar' ? 'Retificar registro clínico' : 'Nova evolução'"></h1>
      <div class="dialog-body">
        <p class="muted text-xs" style="margin-top:0" x-show="modo === 'retificar'">
          A correção cria a versão seguinte; o texto atual continua no histórico, com o motivo.
        </p>

        <div class="pm-grid">
          <div class="pm-field"><label>Data e hora do atendimento</label><input class="input" type="datetime-local" x-model="form.happened_at" /></div>
          <div class="pm-field">
            <label>Profissional responsável</label>
            <select class="input" x-model="form.professional_id">
              <option value="">—</option>
              <template x-for="p in profissionais" :key="p.id">
                <option :value="p.id" x-text="p.name + (p.cro ? ' · CRO ' + p.cro : '')"></option>
              </template>
            </select>
          </div>
        </div>

        <div class="pm-grid">
          <div class="pm-field">
            <label>Consulta (opcional)</label>
            <select class="input" x-model="form.appointment_id">
              <option value="">—</option>
              <template x-for="a in atendimentos" :key="a.id">
                <option :value="a.id" x-text="fmtDateTimeLocal(a.starts_at) + ' · ' + a.professional_name"></option>
              </template>
            </select>
          </div>
          <div class="pm-field"><label>Assunto</label><input class="input" type="text" x-model="form.title" maxlength="120" placeholder="Ex.: Restauração dente 26" /></div>
        </div>

        <label>Procedimentos realizados</label>
        <template x-for="(p, i) in form.procedures" :key="i">
          <div class="proc-linha">
            <select class="input" x-model="p.procedure_id">
              <option value="">Escolha…</option>
              <template x-for="proc in procedimentos" :key="proc.id">
                <option :value="proc.id" x-text="proc.name"></option>
              </template>
            </select>
            <input class="input" type="text" x-model="p.tooth" placeholder="dente" maxlength="8" />
            <input class="input" type="text" x-model="p.note" placeholder="observação do procedimento" maxlength="300" />
            <button class="btn secondary small danger" @click.prevent="form.procedures.splice(i, 1)" title="Remover procedimento"><%- include('partials/odonto-icon', { name: 'trash', size: 14 }) %></button>
          </div>
        </template>
        <button class="btn secondary small" @click.prevent="form.procedures.push({ procedure_id: '', tooth: '', note: '' })"><%- include('partials/odonto-icon', { name: 'plus', size: 14 }) %><span>Procedimento</span></button>

        <label>Observações do atendimento</label>
        <textarea class="input" x-model="form.observations" rows="3" placeholder="O que foi feito, como o paciente respondeu…"></textarea>
        <div class="pm-grid">
          <div class="pm-field"><label>Diagnóstico</label><textarea class="input" x-model="form.diagnosis" rows="2"></textarea></div>
          <div class="pm-field"><label>Conduta</label><textarea class="input" x-model="form.conduct" rows="2"></textarea></div>
        </div>
        <label>Próximos passos</label>
        <textarea class="input" x-model="form.next_steps" rows="2" placeholder="Ex.: retorno em 15 dias para controle; aguardar exame…"></textarea>

        <template x-if="modo === 'retificar'">
          <div>
            <label>Motivo da retificação *</label>
            <textarea class="input" x-model="form.motivo" rows="2" placeholder="Ex.: troquei o dente no registro (era 36, não 26)."></textarea>
          </div>
        </template>

        <div class="error" x-text="dlgError"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlg.close()"><%- include('partials/odonto-icon', { name: 'x' }) %><span>Cancelar</span></button>
        <button class="btn" @click="salvar()" :disabled="salvando">
          <span x-show="modo !== 'retificar'"><%- include('partials/odonto-icon', { name: 'save' }) %></span>
          <span x-show="modo === 'retificar'"><%- include('partials/odonto-icon', { name: 'pencil' }) %></span>
          <span x-text="salvando ? 'Salvando…' : (modo === 'retificar' ? 'Retificar registro' : 'Registrar evolução')"></span>
        </button>
      </div>
    </dialog>
    <% } %>

    <dialog x-ref="dlgHist" class="dialog-fixed">
      <h1>Histórico de versões</h1>
      <div class="dialog-body">
        <template x-for="v in historico" :key="v.id">
          <div class="evolucao" :class="{ retificada: v.status === 'retificado' }">
            <h3 x-text="'Versão ' + v.version + ' · ' + fmtDateTimeLocal(v.happened_at)"></h3>
            <div class="meta">
              <span x-text="v.professional_name ? (v.professional_name + (v.professional_cro ? ' · CRO ' + v.professional_cro : '')) : '—'"></span>
              <span x-show="v.created_by_name" x-text="' · registrado por ' + v.created_by_name"></span>
              <span class="badge" x-text="v.status"></span>
              <span x-show="v.retification_reason" x-text="' · motivo: ' + v.retification_reason"></span>
            </div>
            <dl>
              <template x-for="c in campos(v)" :key="c.label">
                <div style="display:contents">
                  <dt x-text="c.label"></dt>
                  <dd x-text="c.value"></dd>
                </div>
              </template>
            </dl>
            <div class="proc" x-show="v.procedures.length">
              <template x-for="(p, i) in v.procedures" :key="i">
                <span class="tag" x-text="p.name + (p.tooth ? ' · ' + p.tooth : '')"></span>
              </template>
            </div>
          </div>
        </template>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlgHist.close()"><%- include('partials/odonto-icon', { name: 'x' }) %><span>Fechar</span></button>
      </div>
    </dialog>

  <%- include('partials/odonto-tour') %>
  </main>

  <script nonce="<%= cspNonce %>" src="/js/datetime.js"></script>
  <script nonce="<%= cspNonce %>">
    function prontuarioPage(patientId, podeEditar, podeRetificar) {
      const agoraLocal = () => {
        const d = new Date();
        const p = (n) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
      };
      return {
        patientId,
        podeEditar,
        podeRetificar,
        paciente: null,
        notes: [],
        resumo: { vigentes: 0, retificadas: 0, ultima: null },
        profissionais: [],
        procedimentos: [],
        atendimentos: [],
        historico: [],
        error: '',
        dlgError: '',
        salvando: false,
        modo: 'nova',
        retificandoId: null,
        form: {},

        async load() {
          const [p, n] = await Promise.all([
            fetch('/api/odonto/patients/' + patientId),
            fetch('/api/odonto/patients/' + patientId + '/notes?retificadas=1'),
          ]);
          if (p.ok) this.paciente = await p.json();
          if (n.ok) {
            const data = await n.json();
            this.notes = data.items || [];
            this.resumo = data.resumo || this.resumo;
          } else {
            this.error = (await n.json()).error ?? 'Erro ao carregar o prontuário.';
          }
          <% if (canEditClinical) { %>
          if (!this.profissionais.length) {
            const pr = await fetch('/api/odonto/professionals?active=true');
            if (pr.ok) this.profissionais = await pr.json();
          }
          if (!this.procedimentos.length) {
            const pc = await fetch('/api/odonto/procedures?active=true');
            if (pc.ok) this.procedimentos = await pc.json();
          }
          <% } %>
        },

        /**
         * Campos preenchidos do registro, para a tela mostrar só o que existe.
         * (Um `x-for` de um raiz só: o Alpine não repete múltiplos elementos.)
         */
        campos(n) {
          const lista = [
            { label: 'Observações', value: n.observations },
            { label: 'Diagnóstico', value: n.diagnosis },
            { label: 'Conduta', value: n.conduct },
            { label: 'Próximos passos', value: n.next_steps },
          ];
          if (n.appointment_id) lista.push({ label: 'Consulta', value: 'agendamento #' + n.appointment_id });
          if (n.status === 'retificado' && n.replaced_by_id) {
            lista.push({ label: 'Substituído por', value: 'versão seguinte (#' + n.replaced_by_id + ')' + (n.replaced_by_name ? ' · ' + n.replaced_by_name : '') });
          }
          return lista.filter((c) => c.value);
        },

        // Só sob demanda: a lista de atendimentos do paciente serve para vincular a evolução.
        async carregarAtendimentos() {
          const r = await fetch(`/api/odonto/appointments?view=todos&patient_id=${patientId}`);
          if (r.ok) {
            const data = await r.json();
            this.atendimentos = (data.items || []).filter((a) => a.status === 'atendido' || a.status === 'em_atendimento');
          }
        },

        limparFormulario(nota) {
          return {
            happened_at: nota ? String(nota.happened_at).replace(' ', 'T').slice(0, 16) : agoraLocal(),
            professional_id: nota ? (nota.professional_id || '') : '',
            appointment_id: nota ? (nota.appointment_id || '') : '',
            title: nota ? (nota.title || '') : '',
            procedures: nota && nota.procedures.length
              ? nota.procedures.map((p) => ({ procedure_id: p.procedure_id || '', tooth: p.tooth || '', note: p.note || '' }))
              : [{ procedure_id: '', tooth: '', note: '' }],
            observations: nota ? (nota.observations || '') : '',
            diagnosis: nota ? (nota.diagnosis || '') : '',
            conduct: nota ? (nota.conduct || '') : '',
            next_steps: nota ? (nota.next_steps || '') : '',
            motivo: '',
          };
        },

        async nova() {
          this.modo = 'nova';
          this.retificandoId = null;
          this.dlgError = '';
          this.form = this.limparFormulario(null);
          await this.carregarAtendimentos();
          this.$refs.dlg.showModal();
        },

        async retificar(nota) {
          this.modo = 'retificar';
          this.retificandoId = nota.id;
          this.dlgError = '';
          // Pré-preenche com o texto atual: retificar é corrigir, não reescrever do zero.
          this.form = this.limparFormulario(nota);
          await this.carregarAtendimentos();
          this.$refs.dlg.showModal();
        },

        async salvar() {
          this.salvando = true;
          this.dlgError = '';
          const procedures = (this.form.procedures || [])
            .filter((p) => p.procedure_id)
            .map((p) => ({
              procedure_id: Number(p.procedure_id),
              tooth: p.tooth || null,
              note: p.note || null,
            }));
          const corpo = {
            happened_at: String(this.form.happened_at || '').replace('T', ' '),
            professional_id: this.form.professional_id ? Number(this.form.professional_id) : null,
            appointment_id: this.form.appointment_id ? Number(this.form.appointment_id) : null,
            title: this.form.title || null,
            procedures,
            observations: this.form.observations || null,
            diagnosis: this.form.diagnosis || null,
            conduct: this.form.conduct || null,
            next_steps: this.form.next_steps || null,
          };
          try {
            const url = this.modo === 'retificar'
              ? `/api/odonto/notes/${this.retificandoId}/retify`
              : `/api/odonto/patients/${patientId}/notes`;
            const r = await fetch(url, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(this.modo === 'retificar' ? { ...corpo, motivo: this.form.motivo } : corpo),
            });
            if (r.ok) {
              this.$refs.dlg.close();
              showToast(this.modo === 'retificar' ? 'Registro retificado — a versão anterior ficou no histórico.' : 'Evolução registrada.', 'success');
              await this.load();
            } else {
              this.dlgError = (await r.json()).error ?? 'Erro ao salvar o registro.';
            }
          } finally {
            this.salvando = false;
          }
        },

        async verHistorico(nota) {
          const r = await fetch('/api/odonto/notes/' + nota.id);
          if (r.ok) {
            this.historico = (await r.json()).history || [];
            this.$refs.dlgHist.showModal();
          } else {
            this.error = (await r.json()).error ?? 'Erro ao abrir o histórico.';
          }
        },
      };
    }
  </script>
</body>
</html>
