<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Ficha do paciente</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <%- include('partials/odonto-ui') %>
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/odonto/pacientes' }) %>
  <main id="tour-odonto-conteudo" x-data="patientFicha(<%= patientId %>, <%= canViewClinical ? 'true' : 'false' %>, <%= user.permissions.has('odonto.plans.view') ? 'true' : 'false' %>, <%= user.permissions.has('odonto.documents.view') ? 'true' : 'false' %>)" x-init="load()">
    <header class="odonto-patient-head" id="tour-odonto-toolbar">
      <a class="btn secondary" href="/app/odonto/pacientes">← Pacientes</a>
      <div class="odonto-photo-field">
        <span class="odonto-avatar lg">
          <img x-show="photoPreview" :src="photoPreview || ''" alt="" x-cloak />
          <span x-show="!photoPreview" x-text="initials(p.name)"></span>
        </span>
        <% if (user.permissions.has('odonto.patients.edit')) { %>
        <div class="odonto-photo-actions">
          <input type="file" class="sr-only" style="display:none" accept="image/jpeg,image/png,image/webp,image/avif" x-ref="photoFile" @change="onPhotoFile($event)" />
          <button type="button" class="btn secondary small" @click="$refs.photoFile.click()">Trocar foto</button>
          <button type="button" class="btn secondary small danger" x-show="photoPreview" @click="removePhoto()">Remover</button>
        </div>
        <% } %>
      </div>
      <div class="odonto-patient-titles">
        <h1 x-text="p.name || 'Paciente'"></h1>
        <div class="odonto-patient-meta">
          <span class="badge" x-show="p.id" :class="p.active ? 'ok' : 'off'" x-text="p.active ? 'Ativo' : 'Inativo'"></span>
          <span class="muted text-xs" x-show="p.document" x-text="'CPF/CNPJ ' + p.document"></span>
          <span class="muted text-xs" x-show="p.phone" x-text="p.phone"></span>
          <span class="error" x-text="error"></span>
        </div>
      </div>
      <% if (user.permissions.has('odonto.patients.edit')) { %>
      <div class="toolbar odonto-head-actions">
        <button class="btn" @click="openEdit()">Editar cadastro</button>
        <% if (user.permissions.has('commercial.customers.view')) { %>
        <a class="btn secondary" :href="'/app/commercial/clientes/' + p.customer_id + '/financeiro'">Financeiro</a>
        <% } %>
      </div>
      <% } %>
      <div id="tour-odonto-ficha"></div>
    </header>

    <template x-if="!p.id && !error">
      <p class="muted">Carregando…</p>
    </template>

    <template x-if="p.id">
      <div>
        <section class="odonto-section">
          <h2>Cadastro</h2>
          <table>
            <tbody>
              <tr><th>CPF/CNPJ</th><td x-text="p.document || '—'"></td><th>Nascimento</th><td x-text="fmtDate(p.birthday)"></td></tr>
              <tr><th>Telefone</th><td x-text="p.phone || '—'"></td><th>E-mail</th><td x-text="p.email || '—'"></td></tr>
              <tr><th>Sexo</th><td x-text="sexLabel(p.sex)"></td><th>RG</th><td x-text="p.rg || '—'"></td></tr>
              <tr><th>CEP</th><td x-text="p.cep || '—'"></td><th>Endereço</th><td x-text="p.address || '—'"></td></tr>
              <tr><th>Observações</th><td colspan="3" x-text="p.notes || '—'"></td></tr>
            </tbody>
          </table>
        </section>

        <% if (canViewClinical) { %>
        <section class="odonto-section">
        <h2>Ficha clínica</h2>
        <p class="page-subtitle">
          Dado de saúde: só quem tem a permissão clínica vê este bloco. A auditoria registra quem alterou —
          o conteúdo não é copiado para o log.
        </p>
        <% if (canEditClinical) { %>
          <div class="pm-grid">
            <div class="pm-field"><label>Histórico médico</label><textarea class="input" x-model="clinical.medical_history" rows="3"></textarea></div>
            <div class="pm-field"><label>Histórico odontológico</label><textarea class="input" x-model="clinical.dental_history" rows="3"></textarea></div>
          </div>
          <div class="pm-grid">
            <div class="pm-field"><label>Alergias</label><textarea class="input" x-model="clinical.allergies" rows="2"></textarea></div>
            <div class="pm-field"><label>Medicamentos em uso</label><textarea class="input" x-model="clinical.medications" rows="2"></textarea></div>
          </div>
          <div class="pm-grid">
            <div class="pm-field"><label>Condições relevantes</label><textarea class="input" x-model="clinical.conditions" rows="2"></textarea></div>
            <div class="pm-field"><label>Observações clínicas</label><textarea class="input" x-model="clinical.clinical_notes" rows="3"></textarea></div>
          </div>
          <div class="toolbar">
            <button class="btn" @click="saveClinical()">Salvar ficha clínica</button>
            <span class="muted text-xs" x-show="clinicalSaved">Ficha salva.</span>
            <span class="error" x-text="clinicalError"></span>
          </div>
        <% } else { %>
          <table>
            <tbody>
              <tr><th>Histórico médico</th><td x-text="val('medical_history')"></td></tr>
              <tr><th>Histórico odontológico</th><td x-text="val('dental_history')"></td></tr>
              <tr><th>Alergias</th><td x-text="val('allergies')"></td></tr>
              <tr><th>Medicamentos</th><td x-text="val('medications')"></td></tr>
              <tr><th>Condições relevantes</th><td x-text="val('conditions')"></td></tr>
              <tr><th>Observações clínicas</th><td x-text="val('clinical_notes')"></td></tr>
            </tbody>
          </table>
        <% } %>
        </section>
        <% } %>

        <% if (canViewClinical) { %>
        <section class="odonto-section">
        <h2>Anamnese</h2>
        <p class="page-subtitle">
          Questionário respondido em revisões: cada salvamento vira uma revisão nova e o
          histórico não é reescrito.
        </p>
        <table>
          <tbody>
            <tr>
              <th style="width:32%">Situação</th>
              <td>
                <span x-show="anamnesis.revisions > 0" x-cloak>
                  <span class="badge" x-text="'respondida · ' + anamnesis.revisions + ' revisão(ões)'"></span>
                  <span class="muted text-xs" x-show="anamnesis.last_filled_at"
                        x-text="' · última ' + fmtDateTime(anamnesis.last_filled_at)"></span>
                  <span class="muted text-xs" x-show="anamnesis.last_template_name"
                        x-text="' · ' + anamnesis.last_template_name"></span>
                </span>
                <span class="muted" x-show="anamnesis.revisions === 0" x-cloak>Pendente</span>
              </td>
            </tr>
          </tbody>
        </table>
        <div class="toolbar">
          <a class="btn" :href="'/app/odonto/pacientes/' + id + '/anamnese'"
             x-text="anamnesis.revisions > 0 ? 'Ver anamnese' : 'Responder anamnese'"></a>
        </div>
        </section>
        <% } %>

        <% if (canViewClinical) { %>
        <section class="odonto-section">
        <h2>Prontuário</h2>
        <p class="page-subtitle">
          Evolução clínica do paciente: cada atendimento vira um registro com procedimentos,
          observações, diagnóstico, conduta e próximos passos. Registro clínico não se apaga —
          corrige-se por retificação, com motivo e histórico.
        </p>
        <table>
          <tbody>
            <tr>
              <th style="width:32%">Situação</th>
              <td>
                <span x-show="records.vigentes > 0" x-cloak>
                  <span class="badge" x-text="records.vigentes + ' evolução(ões)'"></span>
                  <span class="muted text-xs" x-show="records.ultima" x-text="' · última ' + fmtDateTimeLocal(records.ultima)"></span>
                  <span class="muted text-xs" x-show="records.retificadas" x-text="' · ' + records.retificadas + ' retificada(s)'"></span>
                </span>
                <span class="muted" x-show="records.vigentes === 0" x-cloak>Sem evolução registrada</span>
              </td>
            </tr>
          </tbody>
        </table>
        <div class="toolbar">
          <a class="btn" :href="'/app/odonto/pacientes/' + id + '/prontuario'">Abrir prontuário</a>
        </div>
        </section>
        <% } %>

        <% if (canViewClinical) { %>
        <section class="odonto-section">
        <h2>Odontograma</h2>
        <p class="page-subtitle">
          Mapa dos dentes (numeração FDI) com situação por face e por dente, histórico de cada
          mudança e os procedimentos já realizados.
        </p>
        <table>
          <tbody>
            <tr>
              <th style="width:32%">Situação</th>
              <td>
                <span x-show="odontogram.dentes_com_situacao > 0" x-cloak
                      x-text="odontogram.dentes_com_situacao + ' dente(s) com situação' + (odontogram.planejados ? ' · ' + odontogram.planejados + ' com tratamento planejado' : '')"></span>
                <span class="muted" x-show="odontogram.dentes_com_situacao === 0" x-cloak>Nenhum dente avaliado ainda</span>
              </td>
            </tr>
          </tbody>
        </table>
        <div class="toolbar">
          <a class="btn" :href="'/app/odonto/pacientes/' + id + '/odontograma'">Abrir odontograma</a>
        </div>
        </section>
        <% } %>

        <% if (user.permissions.has('odonto.documents.view')) { %>
        <section class="odonto-section">
        <h2>Documentos</h2>
        <p class="page-subtitle">
          TCLE, receita, atestado, encaminhamento, contrato e alta gerados a partir dos modelos da
          clínica, com os dados do paciente substituídos. Emitido não muda: corrige-se pela versão
          seguinte, e o que foi entregue fica no histórico.
        </p>
        <table>
          <tbody>
            <tr>
              <th style="width:32%">Situação</th>
              <td>
                <span x-show="documents.total > 0" x-cloak
                      x-text="documents.emitidos + ' emitido(s)' + (documents.rascunhos ? ' · ' + documents.rascunhos + ' rascunho(s)' : '') + (documents.ultimo_em ? ' · último em ' + fmtDate(documents.ultimo_em) : '')"></span>
                <span class="muted" x-show="documents.total === 0" x-cloak>Nenhum documento ainda</span>
              </td>
            </tr>
          </tbody>
        </table>
        <div class="toolbar">
          <a class="btn" :href="'/app/odonto/pacientes/' + id + '/documentos'">Abrir documentos</a>
        </div>
        </section>
        <% } %>

        <% if (user.permissions.has('odonto.plans.view')) { %>
        <section class="odonto-section">
        <h2>Planos de tratamento</h2>
        <p class="page-subtitle">
          O que está previsto, com valor por item e dente. O plano aprovado gera a cobrança no
          Financeiro do Kivo (conta a receber do cliente, com parcelamento).
        </p>
        <table>
          <tbody>
            <tr>
              <th style="width:32%">Em aberto</th>
              <td>
                <span x-show="plans.planos_abertos > 0" x-cloak
                      x-text="plans.planos_abertos + ' plano(s) · ' + plans.itens_pendentes + ' item(ns) pendente(s) · ' + brl(plans.total_aberto_cents)"></span>
                <span class="muted" x-show="plans.planos_abertos === 0" x-cloak>Nenhum plano em aberto</span>
              </td>
            </tr>
          </tbody>
        </table>
        <div class="toolbar">
          <a class="btn" :href="'/app/odonto/pacientes/' + id + '/planos'">Abrir planos de tratamento</a>
        </div>
        </section>
        <% } %>

        <% if (user.permissions.has('odonto.exams.view')) { %>
        <section class="odonto-section">
        <h2>Exames e imagens</h2>
        <p class="page-subtitle">
          Radiografia, tomografia e fotografia clínica do paciente, marcadas como antes, durante ou
          depois do tratamento para comparar a evolução lado a lado. O arquivo fica guardado no
          computador da clínica.
        </p>
        <div class="toolbar">
          <a class="btn" :href="'/app/odonto/pacientes/' + id + '/exames'">Abrir exames e imagens</a>
        </div>
        </section>
        <% } %>

        <section class="odonto-section">
        <h2>Próximas fases do módulo</h2>
        <table>
          <thead><tr><th>Recurso</th><th>Situação</th></tr></thead>
          <tbody>
            <tr><td>Anamnese</td><td><span class="badge">Disponível</span></td></tr>
            <tr><td>Agenda e atendimento</td><td><span class="badge">Disponível</span></td></tr>
            <tr><td>Prontuário e evolução</td><td><span class="badge">Disponível com retificação</span></td></tr>
            <tr><td>Odontograma</td><td><span class="badge">Disponível</span></td></tr>
            <tr><td>Plano de tratamento e cobrança</td><td><span class="badge">Disponível</span></td></tr>
            <tr><td>Documentos (TCLE, receita, atestado, contrato)</td><td><span class="badge">Disponível</span></td></tr>
            <tr><td>Exames e imagens</td><td><span class="badge">Disponível</span></td></tr>
          </tbody>
        </table>
        </section>
      </div>
    </template>

    <dialog x-ref="dlg" class="dialog-fixed">
      <h1>Editar cadastro</h1>
      <div class="dialog-body">
        <label>Nome completo</label><input class="input" type="text" x-model="form.name" />
        <div class="pm-grid">
          <div class="pm-field"><label>CPF/CNPJ</label><input class="input" type="text" x-model="form.document" @input="form.document = maskDoc(form.document)" /></div>
          <div class="pm-field"><label>Nascimento</label><input class="input" type="date" x-model="form.birthday" /></div>
        </div>
        <div class="pm-grid">
          <div class="pm-field"><label>Telefone</label><input class="input" type="text" x-model="form.phone" @input="form.phone = maskPhone(form.phone)" /></div>
          <div class="pm-field"><label>E-mail</label><input class="input" type="text" x-model="form.email" /></div>
        </div>
        <div class="pm-grid">
          <div class="pm-field"><label>CEP</label><input class="input" type="text" x-model="form.cep" @input="form.cep = maskCEP(form.cep)" /></div>
          <div class="pm-field"><label>RG</label><input class="input" type="text" x-model="form.rg" /></div>
        </div>
        <label>Endereço</label><input class="input" type="text" x-model="form.address" />
        <div class="pm-grid">
          <div class="pm-field">
            <label>Sexo</label>
            <select class="input" x-model="form.sex">
              <option value="">Não informado</option>
              <option value="feminino">Feminino</option>
              <option value="masculino">Masculino</option>
              <option value="outro">Outro</option>
              <option value="nao_informado">Prefere não informar</option>
            </select>
          </div>
          <div class="pm-field">
            <label>Situação</label>
            <select class="input" x-model="form.active">
              <option :value="true">Ativo</option>
              <option :value="false">Inativo</option>
            </select>
          </div>
        </div>
        <label>Observações do atendimento</label><textarea class="input" x-model="form.notes" rows="2"></textarea>
        <div class="error" x-text="dlgError"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlg.close()">Cancelar</button>
        <button class="btn" @click="saveCadastro()">Salvar</button>
      </div>
    </dialog>

  <%- include('partials/odonto-tour') %>
  </main>
  <script nonce="<%= cspNonce %>" src="/js/masks.js"></script>
  <script nonce="<%= cspNonce %>" src="/js/datetime.js"></script>
  <script nonce="<%= cspNonce %>">
    function patientFicha(id, podeVerClinica, podeVerPlanos, podeVerDocumentos) {
      const CLINICAL_KEYS = ['medical_history', 'dental_history', 'allergies', 'medications', 'conditions', 'clinical_notes'];
      const emptyClinical = () => CLINICAL_KEYS.reduce((acc, k) => { acc[k] = ''; return acc; }, {});
      return {
        id,
        p: {},
        form: {},
        clinical: emptyClinical(),
        // Resumo da anamnese e do prontuário (sem conteúdo clínico): a ficha mostra o estado.
        anamnesis: { revisions: 0, last_filled_at: null, last_revision: null, last_template_name: null },
        records: { vigentes: 0, retificadas: 0, ultima: null },
        odontogram: { dentes_com_situacao: 0, planejados: 0, registros: 0 },
        plans: { planos_abertos: 0, itens_pendentes: 0, total_aberto_cents: 0 },
        documents: { total: 0, emitidos: 0, rascunhos: 0, ultimo_em: null },
        error: '', dlgError: '', clinicalError: '', clinicalSaved: false,
        photoPreview: null,

        /** Iniciais para o avatar quando não há foto: "Maria Souza" → "MS". */
        initials(name) {
          const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
          if (!parts.length) return '?';
          return ((parts[0][0] || '') + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
        },
        sexLabel(v) {
          return { feminino: 'Feminino', masculino: 'Masculino', outro: 'Outro', nao_informado: 'Prefere não informar' }[v] || '—';
        },
        val(key) {
          return (this.p.clinical && this.p.clinical[key]) || '—';
        },
        brl(cents) {
          return (Number(cents || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        },
        onPhotoFile(e) {
          const file = e.target.files[0];
          e.target.value = '';
          if (!file) return;
          if (file.size > 6 * 1024 * 1024) { this.error = 'Imagem muito grande (máximo 6MB).'; return; }
          const reader = new FileReader();
          reader.onload = () => {
            const dataUrl = String(reader.result);
            this.photoPreview = dataUrl;
            this.enviarFoto(dataUrl.split(',')[1] ?? '');
          };
          reader.readAsDataURL(file);
        },
        async enviarFoto(base64) {
          this.error = '';
          const r = await fetch(`/api/odonto/patients/${this.id}/photo`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ photoBase64: base64 }),
          });
          if (r.ok) {
            this.p.photo_file = (await r.json()).photo_file;
            window.showToast('Foto atualizada.', 'success');
          } else {
            this.photoPreview = this.p.photo_file || null;
            this.error = (await r.json()).error ?? 'Erro ao enviar a foto.';
          }
        },
        async removePhoto() {
          const r = await fetch(`/api/odonto/patients/${this.id}/photo`, { method: 'DELETE' });
          if (r.ok) { this.photoPreview = null; this.p.photo_file = null; }
          else this.error = (await r.json()).error ?? 'Erro ao remover a foto.';
        },
        async load() {
          const r = await fetch('/api/odonto/patients/' + this.id);
          if (r.ok) {
            const data = await r.json();
            this.p = { ...data, active: !!data.active };
            this.clinical = { ...emptyClinical(), ...(data.clinical || {}) };
            this.photoPreview = data.photo_file || null;
          } else {
            this.error = (await r.json()).error ?? 'Erro ao carregar a ficha.';
          }
          // A anamnese/odontograma só são consultados por quem tem a permissão clínica (a API
          // recusaria). Os planos são outra permissão: a Recepção vê (ela cobra), não o clínico.
          this.carregarPlanos();
          this.carregarDocumentos();
          if (!podeVerClinica) return;
          const a = await fetch('/api/odonto/patients/' + this.id + '/anamnesis');
          if (a.ok) this.anamnesis = (await a.json()).summary;
          const rec = await fetch('/api/odonto/patients/' + this.id + '/notes');
          if (rec.ok) this.records = (await rec.json()).resumo;
          const od = await fetch('/api/odonto/patients/' + this.id + '/odontogram');
          if (od.ok) this.odontogram = (await od.json()).resumo;
        },
        async carregarPlanos() {
          if (!podeVerPlanos) return;
          const pl = await fetch('/api/odonto/patients/' + this.id + '/treatment-plans');
          if (pl.ok) this.plans = (await pl.json()).resumo;
        },
        async carregarDocumentos() {
          if (!podeVerDocumentos) return;
          const d = await fetch('/api/odonto/patients/' + this.id + '/documents');
          if (d.ok) this.documents = (await d.json()).resumo;
        },
        openEdit() {
          // Copia para o formulário: cancelar não pode deixar a tela mostrando dado não salvo.
          this.form = { ...this.p, active: !!this.p.active };
          this.dlgError = '';
          this.$refs.dlg.showModal();
        },
        async saveCadastro() {
          const payload = {
            name: this.form.name,
            document: this.form.document || null,
            phone: this.form.phone || null,
            email: this.form.email || null,
            birthday: this.form.birthday || null,
            cep: this.form.cep || null,
            address: this.form.address || null,
            sex: this.form.sex || null,
            rg: this.form.rg || null,
            notes: this.form.notes || null,
            active: !!this.form.active,
          };
          const r = await fetch('/api/odonto/patients/' + this.id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (r.ok) { this.$refs.dlg.close(); this.load(); }
          else this.dlgError = (await r.json()).error ?? 'Erro ao salvar.';
        },
        async saveClinical() {
          this.clinicalError = '';
          this.clinicalSaved = false;
          const body = {};
          for (const k of CLINICAL_KEYS) body[k] = this.clinical[k] || null;
          const r = await fetch('/api/odonto/patients/' + this.id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clinical: body }),
          });
          if (r.ok) { this.clinicalSaved = true; this.load(); }
          else this.clinicalError = (await r.json()).error ?? 'Erro ao salvar a ficha clínica.';
        },
      };
    }
  </script>
</body>
</html>
