<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Planos de tratamento</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <%- include('partials/odonto-ui') %>
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
  <style>
    .plano { border: 1px solid var(--border-light); border-radius: 12px; padding: 12px; margin-bottom: 12px; }
    .plano h3 { margin: 0 0 2px; font-size: 1rem; }
    .plano .meta { color: var(--muted); font-size: .78rem; }
    .plano .total { font-weight: 700; }
    /* Cada item do plano é um BLOCO com campos rotulados. O formulário antigo era uma grade
       única de 7 colunas sem cabeçalho: os campos cortavam o texto e ninguém sabia o que era
       cada um ("26" é dente? "900,00" é unitário ou total?). */
    .item-card { border: 1px solid var(--border-light); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; background: var(--surface-hover); }
    .item-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
    .item-card-head .item-card-num { font-size: .78rem; font-weight: 600; color: var(--text-secondary); }
    .item-card .pm-field label { color: var(--text-secondary); }
    .subtotal { display: flex; align-items: center; min-height: 38px; padding: .4rem .7rem; border-radius: 10px; background: var(--surface); border: 1.5px solid var(--border-light); font-weight: 600; font-variant-numeric: tabular-nums; }
    .plano-resumo { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-light); }
    .plano-total { display: flex; align-items: baseline; gap: 8px; }
    .plano-total span { color: var(--muted); font-size: .85rem; }
    .plano-total strong { font-size: 1.15rem; font-variant-numeric: tabular-nums; }
    /* Modal do plano mais largo: os campos não podem mais pedir scroll horizontal. */
    .dialog-plano { width: min(720px, calc(100vw - 2rem)); }
    .dialog-plano > h1 { padding-right: 40px; }
    .acoes-linha { display: flex; gap: 6px; flex-wrap: wrap; }
    /* Rodapé do plano: UMA ação primária à esquerda e o resto no menu "···" à direita —
       antes eram cinco botões coloridos competindo, com o destrutivo no mesmo peso do principal. */
    .plano-acoes { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--border-light); }
    .plano-acoes .dropdown { margin-left: auto; }
    .previa { margin: 6px 0 0; padding: 8px 10px; border-radius: 8px; background: var(--surface-hover); font-size: .82rem; color: var(--muted); }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/odonto/pacientes' }) %>
  <main id="tour-odonto-conteudo" x-data="planosPage(<%= patientId %>, <%= user.permissions.has('odonto.plans.manage') ? 'true' : 'false' %>, <%= user.permissions.has('odonto.plans.charge') ? 'true' : 'false' %>)" x-init="load()">
    <h1 style="display:flex;align-items:center;gap:10px"><%- include('partials/odonto-icon', { name: 'wallet', size: 24 }) %> Planos de tratamento <span class="patient-ref" x-show="paciente" x-cloak><%- include('partials/odonto-icon', { name: 'users', size: 14 }) %><span x-text="paciente ? paciente.name : ''"></span></span></h1>

    <div id="tour-odonto-secoes"><%- include('partials/odonto-paciente-tabs', { patientId: patientId, atual: 'planos' }) %></div>

    <div class="toolbar" id="tour-odonto-toolbar">
      <% if (user.permissions.has('odonto.plans.manage')) { %>
        <button class="btn" @click="novo()">
          <%- include('partials/odonto-icon', { name: 'plus' }) %>
          <span>Novo plano</span>
        </button>
      <% } %>
      <span class="muted text-xs"
            x-text="resumo.planos_abertos + ' plano(s) em aberto · ' + resumo.itens_pendentes + ' item(ns) pendente(s) · ' + brl(resumo.total_aberto_cents)"></span>
      <span class="error" x-text="error"></span>
    </div>

    <div id="tour-odonto-planos"></div>
    <template x-for="p in planos" :key="p.id">
      <div class="plano">
        <h3>
          <span x-text="p.title || ('Plano #' + p.id)"></span>
          <span class="badge" :class="classePlano(p.status)" x-text="rotulo(p.status)"></span>
        </h3>
        <div class="meta">
          <span x-text="p.items_count + ' item(ns) · total ' + brl(p.total_cents)"></span>
          <span x-show="p.professional_name" x-text="' · ' + p.professional_name + (p.professional_cro ? ' (CRO ' + p.professional_cro + ')' : '')"></span>
          <span x-show="p.approved_at" x-text="' · aprovado em ' + fmtDate(p.approved_at)"></span>
          <span x-show="p.charged_at" x-text="' · cobrado em ' + fmtDate(p.charged_at) + (p.installments ? ' em ' + p.installments + 'x' : '')"></span>
          <span x-show="p.cancel_reason" x-text="' · motivo: ' + p.cancel_reason"></span>
        </div>

        <table style="margin-top:8px">
          <thead><tr><th>Dente</th><th>Procedimento</th><th class="text-right">Qtd</th><th class="text-right">Valor</th><th class="text-right">Total</th><th>Situação</th><th></th></tr></thead>
          <tbody>
            <template x-for="i in (detalhes[p.id] || [])" :key="i.id">
              <tr>
                <td class="muted" x-text="i.tooth || '—'"></td>
                <td><span x-text="i.description"></span><div class="muted text-xs" x-show="i.professional_name" x-text="i.professional_name"></div></td>
                <td class="text-right tabular" x-text="i.quantity"></td>
                <td class="text-right tabular" x-text="brl(i.amount_cents)"></td>
                <td class="text-right tabular" x-text="brl(i.total_cents)"></td>
                <td><span class="badge" :class="classePlano(i.status)" x-text="rotulo(i.status)"></span></td>
                <td class="text-right">
                  <% if (user.permissions.has('odonto.plans.manage')) { %>
                    <div class="acoes-linha" style="justify-content:flex-end;flex-wrap:nowrap">
                      <button class="btn secondary small" x-show="i.status === 'planejado'" @click="itemStatus(p, i, 'aprovado')" title="Aprova este item"><%- include('partials/odonto-icon', { name: 'check', size: 14 }) %><span>Aprovar item</span></button>
                      <button class="btn secondary small" x-show="i.status === 'aprovado'" @click="itemStatus(p, i, 'em_andamento')" title="Inicia este item"><%- include('partials/odonto-icon', { name: 'play', size: 14 }) %><span>Iniciar item</span></button>
                      <button class="btn secondary small" x-show="i.status === 'em_andamento'" @click="itemStatus(p, i, 'concluido')" title="Conclui este item"><%- include('partials/odonto-icon', { name: 'check-check', size: 14 }) %><span>Concluir item</span></button>
                      <button class="icon-btn" x-show="i.status !== 'concluido' && i.status !== 'cancelado'" @click="itemStatus(p, i, 'cancelado')" title="Cancelar este item (não o plano inteiro)" aria-label="Cancelar este item"><%- include('partials/odonto-icon', { name: 'ban', size: 15 }) %></button>
                    </div>
                  <% } %>
                </td>
              </tr>
            </template>
          </tbody>
        </table>

        <div class="plano-acoes">
          <!-- UMA ação primária: o próximo passo lógico do plano (ou a cobrança, quando é o que falta). -->
          <% if (user.permissions.has('odonto.plans.manage')) { %>
            <button class="btn" x-show="p.status === 'planejado' || p.status === 'apresentado'" @click="status(p, 'aprovado')" title="Aprova o plano e marca todos os itens"><%- include('partials/odonto-icon', { name: 'check' }) %><span>Aprovar plano</span></button>
            <button class="btn" x-show="p.status === 'aprovado' && (p.charged_at || !podeCobrar)" @click="status(p, 'em_andamento')"><%- include('partials/odonto-icon', { name: 'play' }) %><span>Iniciar tratamento</span></button>
            <button class="btn" x-show="p.status === 'em_andamento'" @click="status(p, 'concluido')"><%- include('partials/odonto-icon', { name: 'check-check' }) %><span>Concluir plano</span></button>
          <% } %>
          <% if (user.permissions.has('odonto.plans.charge')) { %>
            <button class="btn" x-show="!p.charged_at && (p.status === 'aprovado' || p.status === 'concluido')" @click="abrirCobranca(p)" title="Cria a conta a receber no Financeiro do Kivo (com parcelamento), no nome do cliente do paciente"><%- include('partials/odonto-icon', { name: 'wallet' }) %><span>Gerar cobrança</span></button>
          <% } %>

          <!-- Secundárias e destrutivas ficam no menu "···", longe do caminho principal. -->
          <% if (user.permissions.has('odonto.plans.manage') || user.permissions.has('odonto.plans.charge')) { %>
          <div class="dropdown">
            <button class="icon-btn" @click="menuAberto = menuAberto === p.id ? null : p.id" title="Mais opções" aria-label="Mais opções" aria-haspopup="true"><%- include('partials/odonto-icon', { name: 'more', size: 18 }) %></button>
            <div class="dropdown-menu" x-show="menuAberto === p.id" x-cloak @click.outside="menuAberto = null">
              <% if (user.permissions.has('odonto.plans.manage')) { %>
                <button x-show="p.status === 'planejado'" @click="menuAberto = null; status(p, 'apresentado')"><%- include('partials/odonto-icon', { name: 'send', size: 15 }) %><span>Marcar como apresentado</span></button>
                <button x-show="p.status === 'aprovado' && !p.charged_at && podeCobrar" @click="menuAberto = null; status(p, 'em_andamento')"><%- include('partials/odonto-icon', { name: 'play', size: 15 }) %><span>Iniciar tratamento</span></button>
                <button x-show="p.status !== 'concluido' && p.status !== 'cancelado'" @click="menuAberto = null; editar(p)"><%- include('partials/odonto-icon', { name: 'pencil', size: 15 }) %><span>Editar itens</span></button>
              <% } %>
              <% if (user.permissions.has('odonto.plans.charge')) { %>
                <button x-show="!p.charged_at && p.status === 'em_andamento' && podeCobrar" @click="menuAberto = null; abrirCobranca(p)"><%- include('partials/odonto-icon', { name: 'wallet', size: 15 }) %><span>Gerar cobrança</span></button>
              <% } %>
              <% if (user.permissions.has('odonto.plans.manage')) { %>
                <button class="danger" x-show="p.status !== 'concluido' && p.status !== 'cancelado'" @click="menuAberto = null; cancelar(p)"><%- include('partials/odonto-icon', { name: 'ban', size: 15 }) %><span>Cancelar plano</span></button>
                <button class="danger" x-show="!p.charged_at && p.status !== 'concluido'" @click="menuAberto = null; apagar(p)"><%- include('partials/odonto-icon', { name: 'trash', size: 15 }) %><span>Apagar plano</span></button>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </template>

    <div x-show="!planos.length">
      <%- include('partials/empty-state', { message: 'Nenhum plano de tratamento ainda.' }) %>
    </div>

    <!-- ─────────── Plano (novo/editar) ─────────── -->
    <% if (user.permissions.has('odonto.plans.manage')) { %>
    <dialog x-ref="dlg" class="dialog-fixed dialog-plano">
      <button type="button" class="dialog-close" @click="$refs.dlg.close()" title="Fechar" aria-label="Fechar"><%- include('partials/odonto-icon', { name: 'x', size: 18 }) %></button>
      <h1 x-text="form.id ? ('Editar plano #' + form.id) : 'Novo plano de tratamento'"></h1>
      <div class="dialog-body">
        <div class="pm-grid">
          <div class="pm-field"><label>Assunto</label><input class="input" type="text" x-model="form.title" maxlength="120" placeholder="Ex.: Reabilitação do lado direito" /></div>
          <div class="pm-field">
            <label>Profissional responsável</label>
            <select class="input" x-model="form.professional_id">
              <option value="">—</option>
              <template x-for="p in profissionais" :key="p.id">
                <option :value="p.id" x-text="p.name + (p.cro ? ' · CRO ' + p.cro : '')"></option>
              </template>
            </select>
          </div>
        </div>

        <label>Itens do plano</label>
        <template x-for="(it, idx) in form.items" :key="idx">
          <div class="item-card">
            <div class="item-card-head">
              <span class="item-card-num" x-text="'Item ' + (idx + 1)"></span>
              <button class="icon-btn" @click.prevent="form.items.splice(idx, 1)" title="Remover este item" aria-label="Remover este item"><%- include('partials/odonto-icon', { name: 'trash', size: 15 }) %></button>
            </div>
            <div class="pm-grid">
              <div class="pm-field">
                <label>Procedimento</label>
                <select class="input" x-model="it.procedure_id" @change="preencherItem(it)">
                  <option value="">Escolha o procedimento…</option>
                  <template x-for="proc in procedimentos" :key="proc.id">
                    <option :value="proc.id" x-text="proc.name"></option>
                  </template>
                </select>
              </div>
              <div class="pm-field"><label>Dente (FDI)</label><input class="input" type="text" x-model="it.tooth" maxlength="2" placeholder="Ex.: 26" /></div>
            </div>
            <div class="pm-field"><label>Descrição</label><input class="input" type="text" x-model="it.description" maxlength="200" placeholder="Descrição do item" /></div>
            <div class="pm-grid">
              <div class="pm-field"><label>Quantidade</label><input class="input" type="number" x-model.number="it.quantity" min="1" max="999" /></div>
              <div class="pm-field"><label>Valor unitário (R$)</label><input class="input" type="text" inputmode="decimal" :value="centavosParaTexto(it.amount_cents)" @input="it.amount_cents = textoParaCentavos($event.target.value)" placeholder="0,00" /></div>
              <div class="pm-field">
                <label>Profissional</label>
                <select class="input" x-model="it.professional_id">
                  <option value="">—</option>
                  <template x-for="p in profissionais" :key="p.id">
                    <option :value="p.id" x-text="p.name"></option>
                  </template>
                </select>
              </div>
              <div class="pm-field"><label>Subtotal</label><div class="subtotal" x-text="brl((Number(it.amount_cents) || 0) * (Number(it.quantity) || 0))"></div></div>
            </div>
          </div>
        </template>
        <div class="plano-resumo">
          <button class="btn secondary small" @click.prevent="adicionarItem()"><%- include('partials/odonto-icon', { name: 'plus', size: 14 }) %><span>Adicionar item</span></button>
          <div class="plano-total"><span>Total do plano</span><strong x-text="brl(totalFormulario())"></strong></div>
        </div>

        <label>Observações</label>
        <textarea class="input" x-model="form.notes" rows="2" placeholder="Ex.: prioridade do lado direito, paciente pediu para parcelar…"></textarea>
        <div class="error" x-text="dlgError"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlg.close()"><%- include('partials/odonto-icon', { name: 'x' }) %><span>Cancelar</span></button>
        <button class="btn" @click="salvar()" :disabled="salvando"><%- include('partials/odonto-icon', { name: 'save' }) %><span x-text="salvando ? 'Salvando…' : 'Salvar plano'"></span></button>
      </div>
    </dialog>
    <% } %>

    <!-- ─────────── Cobrança no financeiro ─────────── -->
    <% if (user.permissions.has('odonto.plans.charge')) { %>
    <dialog x-ref="dlgCobranca" class="dialog-fixed">
      <button type="button" class="dialog-close" @click="$refs.dlgCobranca.close()" title="Fechar" aria-label="Fechar"><%- include('partials/odonto-icon', { name: 'x', size: 18 }) %></button>
      <h1>Gerar cobrança no Financeiro</h1>
      <div class="dialog-body">
        <p class="muted" style="margin-top:0" x-show="cobrando">
          Plano <strong x-text="cobrando ? (cobrando.title || '#' + cobrando.id) : ''"></strong>
          · total <strong x-text="cobrando ? brl(cobrando.total_cents) : ''"></strong>
        </p>
        <div class="pm-grid">
          <div class="pm-field">
            <label>Parcelas</label>
            <input class="input" type="number" x-model.number="cobranca.installments" min="1" max="36" />
          </div>
          <div class="pm-field"><label>Primeiro vencimento</label><input class="input" type="date" x-model="cobranca.first_due_date" /></div>
        </div>
        <p class="previa" x-text="previaCobranca()"></p>
        <p class="helper"><%- include('partials/odonto-icon', { name: 'info', size: 14 }) %><span>A cobrança é criada no <strong>Financeiro do Kivo</strong>, no nome do cliente que responde pelo paciente, com o parcelamento escolhido.</span></p>
        <div class="error" x-text="erroCobranca"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlgCobranca.close()"><%- include('partials/odonto-icon', { name: 'x' }) %><span>Cancelar</span></button>
        <button class="btn" @click="cobrar()" :disabled="cobrandoAgora"><%- include('partials/odonto-icon', { name: 'wallet' }) %><span x-text="cobrandoAgora ? 'Gerando…' : 'Gerar cobrança'"></span></button>
      </div>
    </dialog>
    <% } %>

  <%- include('partials/odonto-tour') %>
  </main>

  <script nonce="<%= cspNonce %>" src="/js/datetime.js"></script>
  <script nonce="<%= cspNonce %>">
    function planosPage(patientId, podeGerenciar, podeCobrar) {
      const ROTULOS = {
        planejado: 'Planejado', apresentado: 'Apresentado', aprovado: 'Aprovado',
        em_andamento: 'Em andamento', concluido: 'Concluído', cancelado: 'Cancelado',
      };
      const CLASSES = { concluido: 'ok', cancelado: '', apresentado: 'off', aprovado: 'ok' };
      const hoje = () => new Date().toISOString().slice(0, 10);
      return {
        patientId,
        podeGerenciar,
        podeCobrar,
        paciente: null,
        planos: [],
        detalhes: {},
        resumo: { planos_abertos: 0, itens_pendentes: 0, total_aberto_cents: 0 },
        profissionais: [],
        procedimentos: [],
        form: { items: [] },
        cobranca: { installments: 1, first_due_date: hoje() },
        cobrando: null,
        cobrandoAgora: false,
        erroCobranca: '',
        error: '',
        dlgError: '',
        salvando: false,
        menuAberto: null,

        rotulo(s) { return ROTULOS[s] || s; },
        classePlano(s) { return CLASSES[s] ?? 'off'; },
        brl(cents) { return (Number(cents || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); },
        centavosParaTexto(c) { return (Number(c || 0) / 100).toFixed(2).replace('.', ','); },
        textoParaCentavos(t) {
          const s = String(t || '').replace(/[^\d,.]/g, '');
          const norm = s.includes(',') ? s.replace(/\./g, '').replace(',', '.') : s;
          const n = parseFloat(norm);
          return isFinite(n) ? Math.round(n * 100) : 0;
        },

        async load() {
          const [p, l] = await Promise.all([
            fetch('/api/odonto/patients/' + patientId),
            fetch('/api/odonto/patients/' + patientId + '/treatment-plans'),
          ]);
          if (p.ok) this.paciente = await p.json();
          if (l.ok) {
            const data = await l.json();
            this.planos = data.items || [];
            this.resumo = data.resumo || this.resumo;
            // Detalhe (itens) de cada plano: uma chamada por plano, em paralelo.
            const pares = await Promise.all(this.planos.map(async (pl) => {
              const r = await fetch('/api/odonto/plans/' + pl.id);
              return [pl.id, r.ok ? ((await r.json()).items || []) : []];
            }));
            this.detalhes = Object.fromEntries(pares);
          } else {
            this.error = (await l.json()).error ?? 'Erro ao carregar os planos.';
          }
          <% if (user.permissions.has('odonto.plans.manage')) { %>
          if (!this.profissionais.length) {
            const pr = await fetch('/api/odonto/professionals?active=true');
            if (pr.ok) this.profissionais = await pr.json();
          }
          if (!this.procedimentos.length) {
            const pc = await fetch('/api/odonto/procedures?active=true');
            if (pc.ok) this.procedimentos = await pc.json();
          }
          <% } %>
        },

        // ── Formulário ──
        adicionarItem() {
          this.form.items.push({ procedure_id: '', tooth: '', description: '', quantity: 1, amount_cents: 0, professional_id: '' });
        },
        preencherItem(item) {
          const proc = this.procedimentos.find((p) => p.id === Number(item.procedure_id));
          if (!proc) return;
          item.description = proc.name;
          if (!item.amount_cents) item.amount_cents = proc.default_price_cents || 0;
        },
        totalFormulario() {
          return (this.form.items || []).reduce((s, i) => s + (Number(i.amount_cents) || 0) * (Number(i.quantity) || 0), 0);
        },
        novo() {
          this.dlgError = '';
          this.form = { id: null, title: '', notes: '', professional_id: '', items: [] };
          this.adicionarItem();
          this.$refs.dlg.showModal();
        },
        async editar(plano) {
          this.dlgError = '';
          const r = await fetch('/api/odonto/plans/' + plano.id);
          const dados = r.ok ? await r.json() : { items: [] };
          this.form = {
            id: plano.id,
            title: plano.title || '',
            notes: plano.notes || '',
            professional_id: plano.professional_id || '',
            items: (dados.items || []).map((i) => ({
              id: i.id,
              procedure_id: i.procedure_id || '',
              tooth: i.tooth || '',
              description: i.description,
              quantity: i.quantity,
              amount_cents: i.amount_cents,
              professional_id: i.professional_id || '',
            })),
          };
          if (!this.form.items.length) this.adicionarItem();
          this.$refs.dlg.showModal();
        },
        async salvar() {
          const itens = (this.form.items || []).filter((i) => i.description && i.description.trim());
          if (!itens.length) {
            this.dlgError = 'Inclua pelo menos um item com descrição.';
            return;
          }
          this.salvando = true;
          this.dlgError = '';
          const corpo = {
            title: this.form.title || null,
            notes: this.form.notes || null,
            professional_id: this.form.professional_id ? Number(this.form.professional_id) : null,
            items: itens.map((i) => ({
              ...(i.id ? { id: i.id } : {}),
              procedure_id: i.procedure_id ? Number(i.procedure_id) : null,
              tooth: i.tooth || null,
              description: i.description,
              amount_cents: Number(i.amount_cents) || 0,
              quantity: Number(i.quantity) || 1,
              professional_id: i.professional_id ? Number(i.professional_id) : null,
            })),
          };
          try {
            const r = await fetch(
              this.form.id ? '/api/odonto/plans/' + this.form.id : `/api/odonto/patients/${patientId}/treatment-plans`,
              { method: this.form.id ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) },
            );
            if (r.ok) {
              this.$refs.dlg.close();
              showToast(this.form.id ? 'Plano atualizado.' : 'Plano criado.', 'success');
              await this.load();
            } else {
              this.dlgError = (await r.json()).error ?? 'Erro ao salvar o plano.';
            }
          } finally {
            this.salvando = false;
          }
        },

        // ── Situações ──
        async status(plano, novo) {
          const r = await fetch(`/api/odonto/plans/${plano.id}/status`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: novo }),
          });
          if (r.ok) { showToast('Situação do plano atualizada.', 'success'); await this.load(); }
          else this.error = (await r.json()).error ?? 'Erro ao mudar a situação.';
        },
        async itemStatus(plano, item, novo) {
          const r = await fetch(`/api/odonto/plans/${plano.id}/items/${item.id}/status`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: novo }),
          });
          if (r.ok) await this.load();
          else this.error = (await r.json()).error ?? 'Erro ao mudar a situação do item.';
        },
        async cancelar(plano) {
          const ok = await window.confirmDlg(`Cancelar o plano "${plano.title || '#' + plano.id}"? As contas já geradas continuam no Financeiro.`);
          if (!ok) return;
          const r = await fetch(`/api/odonto/plans/${plano.id}/status`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: 'cancelado', motivo: 'cancelado pela tela de planos' }),
          });
          if (r.ok) await this.load();
          else this.error = (await r.json()).error ?? 'Erro ao cancelar.';
        },
        async apagar(plano) {
          const ok = await window.confirmDlg(`Apagar o plano "${plano.title || '#' + plano.id}"? Use só para plano lançado por engano.`);
          if (!ok) return;
          const r = await fetch('/api/odonto/plans/' + plano.id, { method: 'DELETE' });
          if (r.ok) await this.load();
          else this.error = (await r.json()).error ?? 'Erro ao apagar.';
        },

        // ── Cobrança (vai para o financeiro) ──
        abrirCobranca(plano) {
          this.cobrando = plano;
          this.erroCobranca = '';
          this.cobranca = { installments: 1, first_due_date: hoje() };
          this.$refs.dlgCobranca.showModal();
        },
        previaCobranca() {
          if (!this.cobrando) return '';
          const n = Math.max(1, Number(this.cobranca.installments) || 1);
          const total = Number(this.cobrando.total_cents) || 0;
          const base = Math.floor(total / n);
          const resto = total - base * n;
          if (n === 1) return 'Uma conta a receber de ' + this.brl(total) + ' vencendo em ' + this.cobranca.first_due_date + '.';
          return n + ' parcelas de ' + this.brl(base)
            + (resto ? ' (a última com ' + this.brl(base + resto) + ')' : '')
            + ', a primeira em ' + this.cobranca.first_due_date + '.';
        },
        async cobrar() {
          this.cobrandoAgora = true;
          this.erroCobranca = '';
          try {
            const r = await fetch(`/api/odonto/plans/${this.cobrando.id}/charge`, {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                installments: Number(this.cobranca.installments) || 1,
                first_due_date: this.cobranca.first_due_date,
              }),
            });
            if (r.ok) {
              const dados = await r.json();
              this.$refs.dlgCobranca.close();
              showToast(`${dados.installments} conta(s) gerada(s) no Financeiro.`, 'success');
              await this.load();
            } else {
              this.erroCobranca = (await r.json()).error ?? 'Erro ao gerar a cobrança.';
            }
          } finally {
            this.cobrandoAgora = false;
          }
        },
      };
    }
  </script>
</body>
</html>
