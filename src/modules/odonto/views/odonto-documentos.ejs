<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Documentos do paciente</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <%- include('partials/odonto-ui') %>
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
  <style>
    .doc { background: var(--surface); border: 1px solid var(--border-light); border-radius: 12px; padding: 14px 16px; margin-bottom: 12px; box-shadow: var(--shadow-xs); }
    .doc-head { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; flex-wrap: wrap; }
    .doc-head h3 { margin: 0; font-size: 1rem; display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .doc .meta { color: var(--muted); font-size: .78rem; line-height: 1.6; margin-top: .3rem; }
    .doc-actions { margin: .85rem 0 0; }
    .variaveis { display: flex; gap: 6px; flex-wrap: wrap; margin: 4px 0 10px; }
    .variaveis button { font-size: .72rem; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--border-light);
                        background: var(--surface-hover); color: var(--muted); cursor: pointer; }
    .editor textarea { font-family: ui-monospace, Consolas, monospace; font-size: .82rem; }
    .aviso { display: inline-block; color: var(--warning-text); background: var(--warning-bg); border-radius: 8px;
             padding: .3rem .6rem; font-size: .78rem; margin: .55rem 0 0; }
    /* Zoom do modo de leitura (o documento abre na modal, sem nova janela). */
    .doc-zoom { display: inline-flex; align-items: center; gap: 4px; margin-top: 10px; }
    .doc-zoom .icon-btn { border: 1px solid var(--border-light); }
    .doc-zoom .pct { min-width: 44px; text-align: center; }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/odonto/pacientes' }) %>
  <main id="tour-odonto-conteudo" x-data="documentosPage(<%= patientId %>, <%= user.permissions.has('odonto.documents.manage') ? 'true' : 'false' %>)" x-init="load()">
    <h1 style="display:flex;align-items:center;gap:10px"><%- include('partials/odonto-icon', { name: 'file-text', size: 24 }) %> Documentos <span class="patient-ref" x-show="paciente" x-cloak><%- include('partials/odonto-icon', { name: 'users', size: 14 }) %><span x-text="paciente ? paciente.name : ''"></span></span></h1>

    <div id="tour-odonto-secoes"><%- include('partials/odonto-paciente-tabs', { patientId: patientId, atual: 'documentos' }) %></div>

    <div class="toolbar" id="tour-odonto-toolbar">
      <% if (user.permissions.has('odonto.documents.manage')) { %>
        <button class="btn" @click="novo()">
          <%- include('partials/odonto-icon', { name: 'plus' }) %>
          <span>Novo documento</span>
        </button>
      <% } %>
      <select class="input" x-model="filtroTipo" @change="load()" style="max-width:220px">
        <option value="">Todos os tipos</option>
        <template x-for="t in types" :key="t.type">
          <option :value="t.type" x-text="t.label"></option>
        </template>
      </select>
      <span class="muted text-xs"
            x-text="resumo.total + ' documento(s) · ' + resumo.emitidos + ' emitido(s)' + (resumo.rascunhos ? ' · ' + resumo.rascunhos + ' rascunho(s)' : '')"></span>
      <a class="btn secondary small" href="/app/odonto/modelos-documentos"><%- include('partials/odonto-icon', { name: 'settings', size: 14 }) %><span>Modelos da clínica</span></a>
      <span class="error" x-text="error"></span>
    </div>

    <div id="tour-odonto-documentos"></div>
    <template x-for="d in documentos" :key="d.id">
      <div class="doc">
        <div class="doc-head">
          <h3>
            <span x-text="d.title"></span>
            <span class="badge" :class="d.status === 'emitido' ? 'ok' : (d.status === 'cancelado' ? 'off' : 'neutral')" x-text="d.status"></span>
            <span class="muted text-xs" x-show="d.version > 1" x-text="'versão ' + d.version"></span>
          </h3>
        </div>
        <div class="meta">
          <span x-text="d.type_label"></span>
          <span x-show="d.template_name" x-text="' · modelo: ' + d.template_name"></span>
          <span x-show="d.professional_name" x-text="' · ' + d.professional_name + (d.professional_cro ? ' (CRO ' + d.professional_cro + ')' : '')"></span>
          <span x-show="d.appointment_at" x-text="' · consulta ' + fmtDateTimeLocal(d.appointment_at)"></span>
          <span x-show="d.plan_title || d.plan_id" x-text="' · plano ' + (d.plan_title || ('#' + d.plan_id))"></span>
          <span x-text="' · criado ' + fmtDateTimeLocal(d.created_at)"></span>
          <span x-show="d.issued_at" x-text="' · emitido ' + fmtDateTimeLocal(d.issued_at)"></span>
          <span x-show="d.cancel_reason" x-text="' · cancelado: ' + d.cancel_reason"></span>
          <span x-show="d.replaced_by_id" x-text="' · substituído pela versão seguinte'"></span>
        </div>
        <p class="aviso" x-show="d.missing_variables.length"
           x-text="'Faltou preencher: ' + d.missing_variables.join(', ')"></p>
        <div class="toolbar doc-actions">
          <button class="btn secondary small" @click="ver(d)"><%- include('partials/odonto-icon', { name: 'eye', size: 14 }) %><span>Ver</span></button>
          <a class="btn secondary small" :href="'/app/odonto/documentos/' + d.id + '/imprimir'"><%- include('partials/odonto-icon', { name: 'printer', size: 14 }) %><span>Imprimir / PDF</span></a>
          <% if (user.permissions.has('odonto.documents.manage')) { %>
            <button class="btn secondary small" x-show="d.status === 'rascunho'" @click="editar(d)"><%- include('partials/odonto-icon', { name: 'pencil', size: 14 }) %><span>Editar rascunho</span></button>
            <button class="btn small" x-show="d.status === 'rascunho'" @click="emitir(d)"><%- include('partials/odonto-icon', { name: 'send', size: 14 }) %><span>Emitir</span></button>
            <button class="btn secondary small" x-show="d.status === 'emitido'" @click="novaVersao(d)"><%- include('partials/odonto-icon', { name: 'refresh', size: 14 }) %><span>Nova versão</span></button>
            <button class="btn secondary small danger" x-show="d.status === 'emitido'" @click="cancelar(d)"><%- include('partials/odonto-icon', { name: 'ban', size: 14 }) %><span>Cancelar</span></button>
            <button class="btn secondary small danger" x-show="d.status === 'rascunho'" @click="apagar(d)"><%- include('partials/odonto-icon', { name: 'trash', size: 14 }) %><span>Apagar</span></button>
          <% } %>
        </div>
      </div>
    </template>

    <div x-show="!documentos.length">
      <%- include('partials/empty-state', { message: 'Nenhum documento deste paciente ainda.' }) %>
    </div>

    <% if (user.permissions.has('odonto.documents.manage')) { %>
    <!-- ─────────── Novo documento / editar rascunho ─────────── -->
    <dialog x-ref="dlg" class="dialog-fixed">
      <h1 x-text="form.id ? ('Editar rascunho #' + form.id) : 'Novo documento'"></h1>
      <div class="dialog-body">
        <div class="pm-grid">
          <div class="pm-field">
            <label>Modelo</label>
            <select class="input" x-model="form.template_id" @change="aplicarModelo()" :disabled="!!form.id">
              <option value="">Documento em branco</option>
              <template x-for="t in modelos" :key="t.id">
                <option :value="t.id" x-text="t.name + ' (' + t.type_label + ')'"></option>
              </template>
            </select>
          </div>
          <div class="pm-field"><label>Título</label><input class="input" type="text" x-model="form.title" maxlength="160" /></div>
        </div>
        <div class="pm-grid">
          <div class="pm-field">
            <label>Profissional</label>
            <select class="input" x-model="form.professional_id">
              <option value="">—</option>
              <template x-for="p in profissionais" :key="p.id">
                <option :value="p.id" x-text="p.name + (p.cro ? ' · CRO ' + p.cro : '')"></option>
              </template>
            </select>
          </div>
          <div class="pm-field">
            <label>Consulta (opcional)</label>
            <select class="input" x-model="form.appointment_id">
              <option value="">—</option>
              <template x-for="a in atendimentos" :key="a.id">
                <option :value="a.id" x-text="fmtDateTimeLocal(a.starts_at) + ' · ' + a.professional_name"></option>
              </template>
            </select>
          </div>
        </div>
        <div class="pm-grid">
          <div class="pm-field">
            <label>Plano de tratamento (opcional)</label>
            <select class="input" x-model="form.plan_id">
              <option value="">—</option>
              <template x-for="p in planos" :key="p.id">
                <option :value="p.id" x-text="(p.title || ('Plano #' + p.id)) + ' · ' + brl(p.total_cents)"></option>
              </template>
            </select>
          </div>
        </div>

        <label>Variáveis (clique para inserir no fim do texto)</label>
        <div class="variaveis">
          <template x-for="v in variaveis" :key="v.key">
            <button type="button" @click="inserir(v.key)" :title="v.label + ' — ex.: ' + v.exemplo" x-text="'{{' + v.key + '}}'"></button>
          </template>
        </div>

        <label>Conteúdo do documento</label>
        <div class="editor">
          <textarea class="input" x-model="form.body" rows="16" placeholder="Escreva o documento ou escolha um modelo acima."></textarea>
        </div>
        <div class="error" x-text="dlgError"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlg.close()"><%- include('partials/odonto-icon', { name: 'x' }) %><span>Cancelar</span></button>
        <button class="btn" @click="salvar()" :disabled="salvando"><%- include('partials/odonto-icon', { name: 'save' }) %><span x-text="salvando ? 'Salvando…' : (form.id ? 'Salvar rascunho' : 'Gerar documento')"></span></button>
      </div>
    </dialog>
    <% } %>

    <!-- ─────────── Ver documento ─────────── -->
    <dialog x-ref="dlgVer" class="dialog-doc">
      <button type="button" class="dialog-close" @click="$refs.dlgVer.close()" title="Fechar" aria-label="Fechar"><%- include('partials/odonto-icon', { name: 'x', size: 18 }) %></button>
      <h1 x-text="vendo.title || 'Documento'"></h1>
      <div class="dialog-body">
        <p class="muted text-xs" style="margin-top:0"
           x-text="vendo.type_label + (vendo.template_name ? ' · modelo: ' + vendo.template_name : '') + ' · versão ' + (vendo.version || 1) + ' · ' + vendo.status"></p>
        <p class="aviso" x-show="(vendo.missing_variables || []).length"
           x-text="'Faltou preencher: ' + (vendo.missing_variables || []).join(', ')"></p>
        <div class="doc-preview full">
          <pre :style="'font-size: ' + docZoom + 'rem'" x-text="vendo.body"></pre>
        </div>
        <div class="doc-zoom">
          <button type="button" class="icon-btn" @click="docZoomOut()" title="Diminuir zoom" aria-label="Diminuir zoom"><%- include('partials/odonto-icon', { name: 'minus', size: 16 }) %></button>
          <span class="pct muted text-xs" x-text="Math.round(docZoom / 0.82 * 100) + '%'"></span>
          <button type="button" class="icon-btn" @click="docZoomIn()" title="Aumentar zoom" aria-label="Aumentar zoom"><%- include('partials/odonto-icon', { name: 'plus', size: 16 }) %></button>
          <button type="button" class="btn secondary small" @click="docZoomReset()"><%- include('partials/odonto-icon', { name: 'refresh', size: 14 }) %><span>Tamanho original</span></button>
        </div>
        <template x-if="(vendo.revision_chain || []).length > 1">
          <div style="margin-top:.9rem">
            <label>Versões deste documento</label>
            <template x-for="v in vendo.revision_chain" :key="v.id">
              <div class="meta" x-text="'versão ' + v.version + ' · ' + v.status + ' · ' + fmtDateTimeLocal(v.created_at)"></div>
            </template>
          </div>
        </template>
      </div>
      <div class="actions">
        <a class="btn secondary" :href="'/app/odonto/documentos/' + vendo.id + '/imprimir'" target="_blank"><%- include('partials/odonto-icon', { name: 'printer' }) %><span>Imprimir / PDF</span></a>
        <button class="btn secondary" @click="$refs.dlgVer.close()"><%- include('partials/odonto-icon', { name: 'x' }) %><span>Fechar</span></button>
      </div>
    </dialog>

  <%- include('partials/odonto-tour') %>
  </main>

  <script nonce="<%= cspNonce %>" src="/js/datetime.js"></script>
  <script nonce="<%= cspNonce %>">
    function documentosPage(patientId, podeGerenciar) {
      return {
        patientId,
        podeGerenciar,
        paciente: null,
        documentos: [],
        resumo: { total: 0, emitidos: 0, rascunhos: 0, ultimo_em: null },
        types: [],
        modelos: [],
        profissionais: [],
        atendimentos: [],
        planos: [],
        variaveis: [],
        filtroTipo: '',
        form: {},
        vendo: {},
        docZoom: 0.82,
        error: '',
        dlgError: '',
        salvando: false,

        brl(cents) { return (Number(cents || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); },

        async load() {
          const q = this.filtroTipo ? ('?type=' + this.filtroTipo) : '';
          const [p, l] = await Promise.all([
            fetch('/api/odonto/patients/' + patientId),
            fetch('/api/odonto/patients/' + patientId + '/documents' + q),
          ]);
          if (p.ok) this.paciente = await p.json();
          if (l.ok) {
            const data = await l.json();
            this.documentos = data.items || [];
            this.resumo = data.resumo || this.resumo;
            this.types = data.types || [];
          } else {
            this.error = (await l.json()).error ?? 'Erro ao carregar os documentos.';
          }
          <% if (user.permissions.has('odonto.documents.manage')) { %>
          const m = await fetch('/api/odonto/document-templates');
          if (m.ok) this.modelos = await m.json();
          if (!this.profissionais.length) {
            const pr = await fetch('/api/odonto/professionals?active=true');
            if (pr.ok) this.profissionais = await pr.json();
          }
          <% } %>
        },

        async carregarVinculos() {
          const [a, pl] = await Promise.all([
            fetch(`/api/odonto/appointments?view=todos&patient_id=${patientId}`),
            fetch(`/api/odonto/patients/${patientId}/treatment-plans`),
          ]);
          if (a.ok) {
            const data = await a.json();
            this.atendimentos = (data.items || []).filter((x) => x.status !== 'cancelado');
          }
          if (pl.ok) this.planos = (await pl.json()).items || [];
        },

        async carregarVariaveis() {
          if (this.variaveis.length) return;
          const r = await fetch('/api/odonto/document-variables');
          if (r.ok) this.variaveis = await r.json();
        },

        async novo() {
          this.dlgError = '';
          this.form = { id: null, template_id: '', title: '', body: '', professional_id: '', appointment_id: '', plan_id: '' };
          await Promise.all([this.carregarVinculos(), this.carregarVariaveis()]);
          this.$refs.dlg.showModal();
        },

        aplicarModelo() {
          const t = this.modelos.find((x) => x.id === Number(this.form.template_id));
          if (!t) return;
          this.form.body = t.body;
          if (!this.form.title) this.form.title = t.name;
        },

        inserir(chave) {
          this.form.body = (this.form.body || '') + '{{' + chave + '}}';
        },

        async editar(d) {
          this.dlgError = '';
          const r = await fetch('/api/odonto/documents/' + d.id);
          const cheio = r.ok ? await r.json() : {};
          this.form = {
            id: d.id,
            template_id: cheio.template_id || '',
            title: cheio.title || '',
            body: cheio.body || '',
            professional_id: cheio.professional_id || '',
            appointment_id: cheio.appointment_id || '',
            plan_id: cheio.plan_id || '',
          };
          await Promise.all([this.carregarVinculos(), this.carregarVariaveis()]);
          this.$refs.dlg.showModal();
        },

        async salvar() {
          if (!String(this.form.body || '').trim()) {
            this.dlgError = 'O documento precisa de conteúdo.';
            return;
          }
          this.salvando = true;
          this.dlgError = '';
          const corpo = {
            template_id: this.form.template_id ? Number(this.form.template_id) : null,
            title: this.form.title || null,
            body: this.form.body,
            professional_id: this.form.professional_id ? Number(this.form.professional_id) : null,
            appointment_id: this.form.appointment_id ? Number(this.form.appointment_id) : null,
            plan_id: this.form.plan_id ? Number(this.form.plan_id) : null,
          };
          try {
            const r = await fetch(
              this.form.id
                ? '/api/odonto/documents/' + this.form.id
                : `/api/odonto/patients/${patientId}/documents`,
              { method: this.form.id ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) },
            );
            if (r.ok) {
              const salvo = await r.json();
              this.$refs.dlg.close();
              await this.load();
              if (salvo.missing_variables && salvo.missing_variables.length) {
                showToast('Documento gerado, mas faltou preencher: ' + salvo.missing_variables.join(', '), 'error');
              } else {
                showToast(this.form.id ? 'Rascunho atualizado.' : 'Documento gerado.', 'success');
              }
            } else {
              this.dlgError = (await r.json()).error ?? 'Erro ao salvar o documento.';
            }
          } finally {
            this.salvando = false;
          }
        },

        async ver(d) {
          const r = await fetch('/api/odonto/documents/' + d.id);
          if (r.ok) {
            this.vendo = await r.json();
            this.docZoomReset();
            this.$refs.dlgVer.showModal();
          } else {
            this.error = (await r.json()).error ?? 'Erro ao abrir o documento.';
          }
        },
        docZoomReset() { this.docZoom = 0.82; },
        docZoomIn() { this.docZoom = Math.min(1.8, Math.round((this.docZoom + 0.1) * 100) / 100); },
        docZoomOut() { this.docZoom = Math.max(0.6, Math.round((this.docZoom - 0.1) * 100) / 100); },

        async emitir(d) {
          const r = await fetch(`/api/odonto/documents/${d.id}/issue`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}),
          });
          if (r.ok) { showToast('Documento emitido.', 'success'); await this.load(); }
          else this.error = (await r.json()).error ?? 'Erro ao emitir.';
        },

        async novaVersao(d) {
          const ok = await window.confirmDlg('Criar a versão seguinte deste documento? A versão atual fica no histórico.');
          if (!ok) return;
          const r = await fetch(`/api/odonto/documents/${d.id}/new-version`, { method: 'POST' });
          if (r.ok) { showToast('Nova versão criada como rascunho.', 'success'); await this.load(); }
          else this.error = (await r.json()).error ?? 'Erro ao criar a versão.';
        },

        async cancelar(d) {
          const ok = await window.confirmDlg(`Cancelar o documento "${d.title}"?`);
          if (!ok) return;
          const r = await fetch(`/api/odonto/documents/${d.id}/cancel`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ motivo: 'cancelado pela tela de documentos' }),
          });
          if (r.ok) { showToast('Documento cancelado.', 'success'); await this.load(); }
          else this.error = (await r.json()).error ?? 'Erro ao cancelar.';
        },

        async apagar(d) {
          const ok = await window.confirmDlg('Apagar este rascunho?');
          if (!ok) return;
          const r = await fetch('/api/odonto/documents/' + d.id, { method: 'DELETE' });
          if (r.ok) await this.load();
          else this.error = (await r.json()).error ?? 'Erro ao apagar.';
        },
      };
    }
  </script>
</body>
</html>
