<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Odontograma</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <%- include('partials/odonto-ui') %>
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
  <style>
    .odonto-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 16px; align-items: start; }
    @media (max-width: 1150px) { .odonto-grid { grid-template-columns: 1fr; } }

    /* ── Cabeçalho do desenho ── */
    .chart-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
    .chart-head h2 { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1.02rem; }
    .chart-head h2 svg { color: var(--primary); }

    /* Arcadas RESPONSIVAS: os dentes encolhem juntos para caber na largura do card. Antes a
       arcada pedia rolagem horizontal e um dente podia ficar fora da vista sem o usuário notar. */
    .arcadas { padding: 8px 2px 4px; }
    .arcada { display: flex; justify-content: center; align-items: center; gap: 2px; }
    .arcada + .arcada { margin-top: 2px; }
    .quadrante { display: flex; gap: 1px; }
    .midline { align-self: stretch; flex: none; width: 2px; margin: 4px 6px; border-radius: 2px; background: repeating-linear-gradient(to bottom, var(--border) 0 4px, transparent 4px 8px); }

    .dente { flex: 0 1 40px; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 1px; padding: 2px 1px; border-radius: 10px; transition: background var(--transition); }
    .dente .num { font-size: .68rem; line-height: 1; color: var(--muted); cursor: pointer; font-variant-numeric: tabular-nums; padding: 1px 3px; border-radius: 6px; }
    .dente .num:hover { color: var(--text); background: var(--surface-hover); }
    .dente.selecionado { background: var(--primary-bg); }
    .dente.selecionado .num { color: var(--primary); font-weight: 700; }

    /* ── O dente (silhueta anatômica: coroa + raiz) ── */
    .tooth { display: block; width: 100%; height: auto; aspect-ratio: 44 / 58; transition: transform var(--transition), filter var(--transition); }
    .tooth .tooth-body { fill: var(--surface-hover); stroke: var(--border); stroke-width: 1; }
    .tooth .sup { stroke: var(--border-light); stroke-width: 1; cursor: pointer; transition: stroke var(--transition); }
    .tooth .sup:hover { stroke: var(--primary); stroke-width: 1.6; }
    .tooth-sigla { font-size: 8px; font-weight: 700; fill: var(--text-secondary); pointer-events: none; }
    .dente:hover .tooth { transform: translateY(-2px); }
    .dente.selecionado .tooth { filter: drop-shadow(0 0 3px color-mix(in srgb, var(--primary) 65%, transparent)); }

    /* ── Legenda ── */
    .legenda { display: flex; gap: 6px; flex-wrap: wrap; margin: 14px 0 2px; padding-top: 12px; border-top: 1px dashed var(--border-light); }
    .legenda .item { display: inline-flex; align-items: center; gap: 6px; font-size: .76rem; color: var(--muted);
                     padding: 3px 9px; border-radius: 999px; background: var(--surface-hover); }
    .legenda .cor { width: 12px; height: 12px; border-radius: 4px; border: 1px solid var(--border-light); flex: none; }

    /* ── Painel lateral ── */
    .painel-secao { margin-top: 14px; }
    .painel-secao > h3 { display: flex; align-items: center; gap: 7px; font-size: .86rem; margin: 0 0 6px; color: var(--text); }
    .painel-secao > h3 svg { color: var(--muted); }
    .painel-linha { display: flex; justify-content: space-between; gap: 8px; font-size: .82rem; padding: 5px 0; border-bottom: 1px dashed var(--border-light); }
    .painel-linha:last-child { border-bottom: 0; }
    .painel-linha.off { opacity: .55; text-decoration: line-through; }
    .atual-box { border: 1px solid var(--border-light); border-radius: 10px; padding: 8px 10px; background: var(--surface-hover); margin-bottom: 10px; }
    .situacao-linha { display: grid; grid-template-columns: 34px 1fr 110px 78px auto; gap: 6px; align-items: center; margin-bottom: 5px; }
    .situacao-linha input[type='color'] { width: 34px; height: 30px; padding: 0; }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/odonto/pacientes' }) %>
  <main id="tour-odonto-conteudo" x-data="odontogramaPage(<%= patientId %>, <%= canEditClinical ? 'true' : 'false' %>)" x-init="load()">
    <h1 style="display:flex;align-items:center;gap:10px"><%- include('partials/odonto-icon', { name: 'tooth', size: 26 }) %> Odontograma <span class="patient-ref" x-show="paciente" x-cloak><%- include('partials/odonto-icon', { name: 'users', size: 14 }) %><span x-text="paciente ? paciente.name : ''"></span></span></h1>

    <div id="tour-odonto-secoes"><%- include('partials/odonto-paciente-tabs', { patientId: patientId, atual: 'odontograma' }) %></div>

    <p class="page-subtitle">
      Cada dente tem quatro faces e o centro (oclusal/incisal): <strong>M</strong> mesial ·
      <strong>D</strong> distal · <strong>V</strong> vestibular · <strong>L</strong> lingual/palatina ·
      <strong>O</strong> oclusal. O mesial olha para a linha média da boca. Clique numa face (ou no
      número do dente) para registrar a situação — o registro anterior vai para o histórico do
      dente, nunca é apagado.
    </p>

    <div class="toolbar" id="tour-odonto-toolbar">
      <span class="muted text-xs"
            x-text="resumo.dentes_com_situacao + ' dente(s) com situação · ' + resumo.planejados + ' com tratamento planejado · ' + resumo.registros + ' registro(s) no histórico'"></span>
      <label class="label-checkbox-sm" style="display:flex;align-items:center;gap:6px">
        <input type="checkbox" x-model="mostrarPlanejados" />
        <span>Destacar tratamentos planejados</span>
      </label>
      <% if (canEditClinical) { %>
        <button class="btn secondary small" @click="abrirSituacoes()"><%- include('partials/odonto-icon', { name: 'settings', size: 15 }) %><span>Situações odontológicas</span></button>
      <% } %>
      <span class="error" x-text="error"></span>
    </div>

    <div class="odonto-grid">
      <!-- ─────────── Desenho ─────────── -->
      <div class="card">
        <div class="chart-head">
          <h2><%- include('partials/odonto-icon', { name: 'tooth', size: 18 }) %> Arcadas <span class="muted text-xs">numeração FDI</span></h2>
          <span class="muted text-xs">Superior 18–28 · Inferior 48–38</span>
        </div>

        <div class="arcadas" id="tour-odonto-odontograma">
          <% const supEsq = ['18','17','16','15','14','13','12','11']; %>
          <% const supDir = ['21','22','23','24','25','26','27','28']; %>
          <% const infEsq = ['48','47','46','45','44','43','42','41']; %>
          <% const infDir = ['31','32','33','34','35','36','37','38']; %>
          <div class="arcada">
            <div class="quadrante"><% supEsq.forEach(function (t) { %><%- include('partials/odonto-tooth', { t: t, upper: true, mirror: true }) %><% }); %></div>
            <span class="midline" aria-hidden="true"></span>
            <div class="quadrante"><% supDir.forEach(function (t) { %><%- include('partials/odonto-tooth', { t: t, upper: true, mirror: false }) %><% }); %></div>
          </div>
          <div class="arcada">
            <div class="quadrante"><% infEsq.forEach(function (t) { %><%- include('partials/odonto-tooth', { t: t, upper: false, mirror: true }) %><% }); %></div>
            <span class="midline" aria-hidden="true"></span>
            <div class="quadrante"><% infDir.forEach(function (t) { %><%- include('partials/odonto-tooth', { t: t, upper: false, mirror: false }) %><% }); %></div>
          </div>
        </div>

        <div class="legenda">
          <template x-for="c in conditions" :key="c.id">
            <span class="item">
              <span class="cor" :style="'background:' + c.color"></span>
              <span x-text="c.name"></span>
            </span>
          </template>
          <span class="item" x-show="!conditions.length">Nenhuma situação cadastrada.</span>
        </div>
      </div>

      <!-- ─────────── Painel do dente ─────────── -->
      <div class="card">
        <h2 style="margin-top:0" x-text="selecionado.tooth ? ('Dente ' + selecionado.tooth + (selecionado.surface ? ' · face ' + nomeSuperficie(selecionado.surface) : ' (dente inteiro)')) : 'Selecione um dente'"></h2>

        <template x-if="!selecionado.tooth">
          <p class="muted">Clique num dente ou numa face para ver o histórico e registrar.</p>
        </template>

        <template x-if="selecionado.tooth">
          <div>
            <div class="atual-box muted text-xs">
              <span x-show="estadoAtual()">Situação atual: <strong x-text="estadoAtual() ? estadoAtual().condition_name : ''"></strong></span>
              <span x-show="!estadoAtual()">Sem situação registrada neste ponto.</span>
            </div>

            <% if (canEditClinical) { %>
            <label>Situação</label>
            <select class="input" x-model="form.condition_id">
              <option value="">Escolha a situação…</option>
              <template x-for="c in conditionsFiltradas()" :key="c.id">
                <option :value="c.id" x-text="c.name"></option>
              </template>
            </select>

            <div class="pm-field">
              <label>Data e hora do exame</label>
              <input class="input" type="datetime-local" x-model="form.recorded_at" />
            </div>

            <label>Profissional</label>
            <select class="input" x-model="form.professional_id">
              <option value="">—</option>
              <template x-for="p in profissionais" :key="p.id">
                <option :value="p.id" x-text="p.name + (p.cro ? ' · CRO ' + p.cro : '')"></option>
              </template>
            </select>

            <label>Observação</label>
            <input class="input" type="text" x-model="form.note" maxlength="500" placeholder="Ex.: cárie oclusal profunda, sem exposição pulpar" />
            <div class="toolbar" style="margin-top:10px">
              <button class="btn" @click="registrar()" :disabled="salvando"><%- include('partials/odonto-icon', { name: 'check', size: 16 }) %><span x-text="salvando ? 'Salvando…' : 'Registrar no odontograma'"></span></button>
            </div>
            <p class="muted text-xs" style="margin-top:6px">
              Aqui se registra a <strong>situação</strong> do dente/face. Tratamento previsto é no
              <a :href="'/app/odonto/pacientes/' + patientId + '/planos'">plano de tratamento</a>
              (com valor e aprovação) — o “P” do desenho vem de lá.
            </p>
            <div class="error" x-text="dlgError"></div>
            <% } %>

            <div class="painel-secao">
              <h3><%- include('partials/odonto-icon', { name: 'clipboard', size: 15 }) %> Histórico deste dente</h3>
              <template x-for="h in historico" :key="h.id">
                <div class="painel-linha" :class="{ off: !!h.undone_at }">
                  <span>
                    <strong x-text="h.condition_name"></strong>
                    <span class="muted text-xs" x-text="' · ' + (h.surface ? nomeSuperficie(h.surface) : 'dente inteiro') + (h.kind === 'planejado' ? ' · planejado' : '')"></span>
                    <span class="muted text-xs" x-text="' · ' + fmtDateTimeLocal(h.recorded_at)"></span>
                    <span class="muted text-xs" x-show="h.note" x-text="' · ' + h.note"></span>
                    <span class="muted text-xs" x-show="h.created_by_name" x-text="' · por ' + h.created_by_name"></span>
                    <span class="muted text-xs" x-show="h.undone_at" x-text="' · desfeito por ' + (h.undone_by_name || '—')"></span>
                  </span>
                  <% if (canEditClinical) { %>
                  <span><button class="btn secondary small" x-show="!h.undone_at" @click="desfazer(h)"><%- include('partials/odonto-icon', { name: 'rotate-ccw', size: 14 }) %><span>Desfazer</span></button></span>
                  <% } %>
                </div>
              </template>
              <div class="odonto-vazio" x-show="!historico.length"><strong>Nenhuma situação registrada neste dente</strong>
Clique numa face acima e escolha a situação (cárie, restaurado, ausente...) para começar o histórico do dente.</div>
            </div>

            <div class="painel-secao">
              <h3><%- include('partials/odonto-icon', { name: 'wallet', size: 15 }) %> Tratamento planejado</h3>
              <template x-for="(p, i) in planejadosDoDente()" :key="i">
                <div class="painel-linha">
                  <span x-text="p.description + ' · ' + p.status"></span>
                  <span class="muted text-xs" x-text="'plano #' + p.plan_id"></span>
                </div>
              </template>
              <div class="odonto-vazio" x-show="!planejadosDoDente().length"><strong>Nada previsto para este dente</strong>
Quando houver tratamento planejado, ele aparece aqui e marca o dente com "P" no desenho.
<a :href="'/app/odonto/pacientes/' + patientId + '/planos'">Abrir planos de tratamento</a></div>
            </div>

            <div class="painel-secao">
              <h3><%- include('partials/odonto-icon', { name: 'file-text', size: 15 }) %> Tratamentos realizados</h3>
              <template x-for="p in procedimentos" :key="p.id">
                <div class="painel-linha">
                  <span x-text="p.name + (p.note ? ' · ' + p.note : '')"></span>
                  <span class="muted text-xs" x-text="fmtDateTimeLocal(p.happened_at)"></span>
                </div>
              </template>
              <div class="odonto-vazio" x-show="!procedimentos.length"><strong>Nenhum procedimento neste dente</strong>
Os procedimentos aparecem aqui quando você registra uma evolução no prontuário citando este dente.</div>
            </div>
          </div>
        </template>
      </div>
    </div>

    <% if (canEditClinical) { %>
    <dialog x-ref="dlgSit" class="dialog-fixed">
      <h1>Situações odontológicas</h1>
      <div class="dialog-body">
        <p class="muted text-xs" style="margin-top:0">
          A lista é da clínica, não do sistema: crie a situação que precisar, com a cor que
          aparece no desenho. Situação em uso não é apagada — é desativada.
        </p>

        <template x-for="c in todasCondicoes" :key="c.id">
          <div class="situacao-linha">
            <input type="color" x-model="c.color" @change="salvarCondicao(c)" />
            <input class="input" type="text" x-model="c.name" @change="salvarCondicao(c)" maxlength="60" />
            <select class="input" x-model="c.applies_to" @change="salvarCondicao(c)">
              <option value="ambos">Dente e face</option>
              <option value="dente">Só dente</option>
              <option value="superficie">Só face</option>
            </select>
            <span class="badge" :class="c.active ? 'ok' : 'off'" x-text="c.active ? 'ativa' : 'inativa'"></span>
            <span class="acoes-linha">
              <button class="btn secondary small" @click="alternarCondicao(c)"><span x-show="c.active"><%- include('partials/odonto-icon', { name: 'ban', size: 14 }) %></span><span x-show="!c.active"><%- include('partials/odonto-icon', { name: 'check', size: 14 }) %></span><span x-text="c.active ? 'Desativar' : 'Ativar'"></span></button>
              <button class="btn secondary small danger" @click="removerCondicao(c)" title="Excluir"><%- include('partials/odonto-icon', { name: 'trash', size: 14 }) %></button>
            </span>
          </div>
        </template>

        <h3 style="font-size:.9rem">Nova situação</h3>
        <div class="pm-grid">
          <div class="pm-field"><label>Nome</label><input class="input" type="text" x-model="nova.name" maxlength="60" placeholder="Ex.: Selante" /></div>
          <div class="pm-field"><label>Código</label><input class="input" type="text" x-model="nova.code" maxlength="30" placeholder="selante" @input="nova.code = nova.code.toLowerCase().replace(/[^a-z0-9_]/g, '_')" /></div>
        </div>
        <div class="pm-grid">
          <div class="pm-field"><label>Cor</label><input type="color" x-model="nova.color" /></div>
          <div class="pm-field">
            <label>Vale para</label>
            <select class="input" x-model="nova.applies_to">
              <option value="ambos">Dente e face</option>
              <option value="dente">Só dente</option>
              <option value="superficie">Só face</option>
            </select>
          </div>
        </div>
        <div class="toolbar">
          <button class="btn" @click="criarCondicao()"><%- include('partials/odonto-icon', { name: 'plus' }) %><span>Adicionar situação</span></button>
          <span class="error" x-text="erroCondicao"></span>
        </div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlgSit.close()"><%- include('partials/odonto-icon', { name: 'x' }) %><span>Fechar</span></button>
      </div>
    </dialog>
    <% } %>

  <%- include('partials/odonto-tour') %>
  </main>

  <script nonce="<%= cspNonce %>" src="/js/datetime.js"></script>
  <script nonce="<%= cspNonce %>">
    function odontogramaPage(patientId, podeEditar) {
      const NOMES = { M: 'mesial', D: 'distal', O: 'oclusal/incisal', V: 'vestibular', L: 'lingual/palatina' };
      const agoraLocal = () => {
        const d = new Date();
        const p = (n) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
      };
      return {
        patientId,
        podeEditar,
        paciente: null,
        superficies: ['V', 'M', 'O', 'D', 'L'],
        conditions: [],
        todasCondicoes: [],
        states: [],
        /** Planejado vem do PLANO de tratamento (fase 6) — não há dois lugares dizendo o previsto. */
        planned: [],
        current: {},
        resumo: { dentes_com_situacao: 0, planejados: 0, registros: 0 },
        profissionais: [],
        selecionado: { tooth: null, surface: null },
        historico: [],
        procedimentos: [],
        mostrarPlanejados: true,
        form: {},
        nova: { name: '', code: '', color: '#9ca3af', applies_to: 'ambos' },
        erroCondicao: '',
        error: '',
        dlgError: '',
        salvando: false,

        async load() {
          const [p, o] = await Promise.all([
            fetch('/api/odonto/patients/' + patientId),
            fetch('/api/odonto/patients/' + patientId + '/odontogram'),
          ]);
          if (p.ok) this.paciente = await p.json();
          if (o.ok) {
            const data = await o.json();
            this.conditions = data.conditions || [];
            this.states = data.states || [];
            this.planned = data.planned || [];
            this.current = data.current || {};
            this.resumo = data.resumo || this.resumo;
          } else {
            this.error = (await o.json()).error ?? 'Erro ao carregar o odontograma.';
          }
          <% if (canEditClinical) { %>
          if (!this.profissionais.length) {
            const pr = await fetch('/api/odonto/professionals?active=true');
            if (pr.ok) this.profissionais = await pr.json();
          }
          <% } %>
        },

        // ── Desenho ──
        /** Sigla desenhada dentro do dente (situação do dente inteiro, quando houver). */
        sigla(t) {
          const st = this.current[t];
          const planejado = this.mostrarPlanejados && this.planned.some((p) => p.tooth === t);
          if (st && st.whole && !st.whole.is_neutral) return st.whole.condition_name.slice(0, 3).toUpperCase();
          return planejado ? 'P' : '';
        },
        /** Cor da face: a situação da própria face ou, na falta, a do dente inteiro. */
        cor(t, s) {
          const st = this.current[t];
          const planejado = this.mostrarPlanejados && this.planned.some((p) => p.tooth === t);
          if (!st) return planejado ? '#f3f4f6' : '#ffffff';
          const face = st.surfaces ? st.surfaces[s] : null;
          if (face) return face.is_neutral ? '#ffffff' : face.condition_color;
          if (st.whole && !st.whole.is_neutral) return st.whole.condition_color;
          return planejado ? '#f3f4f6' : '#ffffff';
        },

        /** Tratamentos previstos para o dente selecionado (do plano de tratamento). */
        planejadosDoDente() {
          return this.planned.filter((p) => p.tooth === this.selecionado.tooth);
        },

        nomeSuperficie(s) { return NOMES[s] || s; },

        estadoAtual() {
          const st = this.current[this.selecionado.tooth];
          if (!st) return null;
          if (this.selecionado.surface) return (st.surfaces && st.surfaces[this.selecionado.surface]) || null;
          return st.whole || null;
        },

        conditionsFiltradas() {
          return this.conditions.filter((c) => {
            if (!this.selecionado.surface) return c.applies_to !== 'superficie';
            return c.applies_to !== 'dente';
          });
        },

        async selecionar(tooth, surface) {
          this.selecionado = { tooth, surface };
          this.dlgError = '';
          this.form = {
            condition_id: '',
            kind: 'situacao',
            note: '',
            recorded_at: agoraLocal(),
            professional_id: '',
          };
          const r = await fetch(`/api/odonto/patients/${patientId}/odontogram/${tooth}`);
          if (r.ok) {
            const data = await r.json();
            this.historico = data.history || [];
            this.procedimentos = data.procedures || [];
          } else {
            this.error = (await r.json()).error ?? 'Erro ao carregar o dente.';
          }
        },

        async registrar() {
          if (!this.form.condition_id) {
            this.dlgError = 'Escolha a situação a registrar.';
            return;
          }
          this.salvando = true;
          this.dlgError = '';
          try {
            const r = await fetch(`/api/odonto/patients/${patientId}/odontogram`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                tooth: this.selecionado.tooth,
                surface: this.selecionado.surface,
                kind: this.form.kind,
                condition_id: Number(this.form.condition_id),
                note: this.form.note || null,
                recorded_at: String(this.form.recorded_at || '').replace('T', ' '),
                professional_id: this.form.professional_id ? Number(this.form.professional_id) : null,
              }),
            });
            if (r.ok) {
              showToast('Registro incluído no odontograma.', 'success');
              await this.load();
              await this.selecionar(this.selecionado.tooth, this.selecionado.surface);
            } else {
              this.dlgError = (await r.json()).error ?? 'Erro ao registrar.';
            }
          } finally {
            this.salvando = false;
          }
        },

        async desfazer(registro) {
          const ok = await window.confirmDlg('Desfazer este registro? Ele sai do estado atual, mas continua no histórico.');
          if (!ok) return;
          const r = await fetch(`/api/odonto/odontogram/${registro.id}/undo`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ motivo: 'corrigido pela tela do odontograma' }),
          });
          if (r.ok) {
            showToast('Registro desfeito — o estado anterior volta a valer.', 'success');
            await this.load();
            await this.selecionar(this.selecionado.tooth, this.selecionado.surface);
          } else {
            this.error = (await r.json()).error ?? 'Erro ao desfazer.';
          }
        },

        // ── Catálogo de situações (PR §10) ──
        async abrirSituacoes() {
          this.erroCondicao = '';
          const r = await fetch('/api/odonto/tooth-conditions?active=false');
          if (r.ok) this.todasCondicoes = await r.json();
          this.$refs.dlgSit.showModal();
        },
        async criarCondicao() {
          this.erroCondicao = '';
          const r = await fetch('/api/odonto/tooth-conditions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.nova),
          });
          if (r.ok) {
            this.nova = { name: '', code: '', color: '#9ca3af', applies_to: 'ambos' };
            await this.abrirSituacoes();
            await this.load();
          } else {
            this.erroCondicao = (await r.json()).error ?? 'Erro ao criar a situação.';
          }
        },
        async salvarCondicao(c) {
          const r = await fetch('/api/odonto/tooth-conditions/' + c.id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: c.name, color: c.color, applies_to: c.applies_to, active: c.active }),
          });
          if (r.ok) await this.load();
          else this.erroCondicao = (await r.json()).error ?? 'Erro ao salvar.';
        },
        async alternarCondicao(c) {
          await this.salvarCondicao({ ...c, active: c.active ? 0 : 1 });
          await this.abrirSituacoes();
        },
        async removerCondicao(c) {
          const ok = await window.confirmDlg(`Excluir a situação "${c.name}"? Se estiver em uso, ela é apenas desativada.`);
          if (!ok) return;
          const r = await fetch('/api/odonto/tooth-conditions/' + c.id, { method: 'DELETE' });
          if (r.ok) {
            await this.abrirSituacoes();
            await this.load();
          } else {
            this.erroCondicao = (await r.json()).error ?? 'Erro ao excluir.';
          }
        },
      };
    }
  </script>
</body>
</html>
