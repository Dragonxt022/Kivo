<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Agenda</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <%- include('partials/odonto-ui') %>
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
  <style>
    /* ── Cores por situação (pastel, adaptam ao tema) ── */
    .st-agendado { --stc: #3b82f6; }
    .st-confirmado { --stc: #10b981; }
    .st-em_atendimento { --stc: #f59e0b; }
    .st-atendido { --stc: #64748b; }
    .st-faltou { --stc: #ef4444; }
    .st-cancelado { --stc: #94a3b8; }
    .badge[class*='st-'] {
      background: color-mix(in srgb, var(--stc) 16%, var(--surface));
      color: color-mix(in srgb, var(--stc) 82%, var(--text));
      border: 1px solid color-mix(in srgb, var(--stc) 38%, transparent);
    }
    .badge.st-cancelado { text-decoration: line-through; }

    /* ── Grade temporal (Dia) ── */
    .grid-wrap { border: 1px solid var(--border-light); border-radius: 12px; overflow: hidden; background: var(--surface); }
    .grid-head { display: flex; border-bottom: 1px solid var(--border-light); background: var(--surface-hover); position: sticky; top: 0; z-index: 4; }
    .grid-corner { flex: 0 0 58px; border-right: 1px solid var(--border-light); }
    .grid-colhead { flex: 1 1 0; min-width: 130px; padding: 8px 10px; font-size: .82rem; font-weight: 600; color: var(--text-secondary); border-left: 1px solid var(--border-light); text-align: center; }
    .grid-body { display: flex; max-height: 68vh; overflow-y: auto; }
    .grid-times { flex: 0 0 58px; border-right: 1px solid var(--border-light); background: var(--surface-hover); }
    .grid-time { height: 30px; font-size: .68rem; color: var(--text-muted); text-align: right; padding-right: 6px; font-variant-numeric: tabular-nums; }
    .grid-time span { position: relative; top: -5px; }
    .grid-col { flex: 1 1 0; min-width: 130px; position: relative; border-left: 1px solid var(--border-light); }
    .grid-col.passada { background: color-mix(in srgb, var(--border-light) 22%, transparent); }
    .grid-slot { height: 30px; border-bottom: 1px dashed var(--border-light); }
    .grid-slot.clicavel:hover { background: color-mix(in srgb, var(--primary) 8%, transparent); cursor: pointer; }

    /* Bloco do atendimento */
    .ag-block { position: absolute; left: 3px; right: 3px; text-align: left; overflow: hidden; cursor: pointer;
      padding: 4px 8px; border-radius: 8px; border: 1px solid color-mix(in srgb, var(--stc) 34%, transparent);
      border-left: 3px solid var(--stc); background: color-mix(in srgb, var(--stc) 15%, var(--surface));
      color: color-mix(in srgb, var(--stc) 78%, var(--text)); display: flex; flex-direction: column; gap: 1px; }
    .ag-block:hover { background: color-mix(in srgb, var(--stc) 24%, var(--surface)); box-shadow: var(--shadow-xs); }
    .ag-block .b-time { font-size: .68rem; font-weight: 700; }
    .ag-block .b-name { font-size: .78rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ag-block .b-sub { font-size: .7rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: .9; }
    .ag-block.st-faltou { border-left-style: dashed; }
    .ag-block.st-cancelado { opacity: .6; text-decoration: line-through; }
    .ag-fit { position: absolute; top: 3px; right: 4px; font-size: .58rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: .04em; color: var(--stc); background: var(--surface); border-radius: 999px; padding: 0 5px; }

    /* ── Semana / Mês ── */
    .semana { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; }
    .semana .dia { border: 1px solid var(--border-light); border-radius: 10px; padding: 8px; min-height: 140px; background: var(--surface); }
    .semana .dia.hoje { border-color: var(--primary); }
    .semana .dia h4 { margin: 0 0 6px; font-size: .8rem; color: var(--text-secondary); }
    .semana-item { display: block; width: 100%; text-align: left; font-size: .74rem; padding: 4px 7px; border-radius: 8px; margin-bottom: 4px; cursor: pointer;
      border: 1px solid color-mix(in srgb, var(--stc) 30%, transparent); border-left: 3px solid var(--stc);
      background: color-mix(in srgb, var(--stc) 14%, var(--surface)); color: color-mix(in srgb, var(--stc) 78%, var(--text)); }
    .semana-item:hover { background: color-mix(in srgb, var(--stc) 22%, var(--surface)); }
    .mes { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
    .mes .cab { font-size: .72rem; color: var(--text-muted); text-align: center; padding: 4px 0; }
    .mes .cel { border: 1px solid var(--border-light); border-radius: 8px; min-height: 78px; padding: 6px; font-size: .75rem; cursor: pointer; background: var(--surface); }
    .mes .cel.fora { opacity: .45; }
    .mes .cel.hoje { border-color: var(--primary); }
    .mes .cel .n { font-weight: 700; }
    .mes .cel .qtd { color: var(--text-muted); font-size: .68rem; }

    /* ── Popover de ações ── */
    .ag-popover { position: fixed; z-index: 60; width: 236px; background: var(--surface); border: 1px solid var(--border-light);
      border-radius: 12px; box-shadow: var(--shadow-lg); padding: 8px; }
    .ag-pop-head { padding: 4px 6px 8px; border-bottom: 1px solid var(--border-light); margin-bottom: 6px; display: flex; flex-direction: column; gap: 3px; }
    .ag-pop-name { font-weight: 700; font-size: .9rem; }
    .ag-pop-actions { display: flex; flex-direction: column; }
    .ag-pop-item { display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; padding: 8px 9px; border: 0; border-radius: 8px;
      background: transparent; color: var(--text); font-size: .85rem; cursor: pointer; text-decoration: none; }
    .ag-pop-item:hover { background: var(--surface-hover); }
    .ag-pop-item.danger { color: var(--danger); }
    .ag-pop-item svg { color: var(--muted); }
    .ag-pop-item.danger svg { color: var(--danger); }

    /* ── Modal ── */
    .dialog-agenda { width: min(760px, calc(100vw - 2rem)); }
    .combo { position: relative; }
    .combo-list { position: absolute; z-index: 12; left: 0; right: 0; top: calc(100% + 4px); max-height: 220px; overflow-y: auto;
      background: var(--surface); border: 1px solid var(--border-light); border-radius: 10px; box-shadow: var(--shadow); padding: 4px; }
    .combo-item { display: flex; flex-direction: column; gap: 1px; width: 100%; text-align: left; padding: 7px 9px; border: 0; border-radius: 8px; background: transparent; color: var(--text); cursor: pointer; }
    .combo-item:hover { background: var(--surface-hover); }
    .combo-name { font-weight: 600; font-size: .88rem; }
    .slots { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
    .slot { font-size: .68rem; padding: 3px 8px; border-radius: 999px; border: 1px solid var(--border-light); background: var(--surface-hover); color: var(--text-secondary); cursor: pointer; font-variant-numeric: tabular-nums; }
    .slot.livre { background: color-mix(in srgb, #10b981 14%, var(--surface)); border-color: color-mix(in srgb, #10b981 40%, transparent); color: color-mix(in srgb, #10b981 80%, var(--text)); }
    .slot.ocupado { opacity: .5; text-decoration: line-through; cursor: not-allowed; }
    .slot.escolhido { border-color: var(--primary); box-shadow: inset 0 0 0 1px var(--primary); font-weight: 700; }
    .conflito { display: flex; gap: 7px; align-items: flex-start; margin-top: 8px; padding: 8px 10px; border-radius: 8px;
      background: var(--warning-bg); color: var(--warning-text); font-size: .78rem; line-height: 1.45; }
    .conflito svg { flex: none; margin-top: 1px; }
  </style>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/odonto/agenda' }) %>
  <main id="tour-odonto-conteudo" x-data="agendaPage(<%= user.permissions.has('odonto.agenda.manage') ? 'true' : 'false' %>)" x-init="load()">
    <h1 style="display:flex;align-items:center;gap:10px"><%- include('partials/odonto-icon', { name: 'calendar', size: 24 }) %> Agenda</h1>
    <p class="page-subtitle">Clique num horário livre para agendar, e num atendimento para as ações. Um profissional não atende dois pacientes no mesmo horário — o encaixe é a exceção declarada.</p>

    <div class="toolbar" id="tour-odonto-toolbar">
      <div class="filter-chips" id="tour-odonto-agenda" role="group" aria-label="Visão da agenda">
        <button type="button" class="chip" :class="{ active: view === 'dia' }" @click="mudarVisao('dia')"><%- include('partials/odonto-icon', { name: 'calendar', size: 15 }) %><span>Dia</span></button>
        <button type="button" class="chip" :class="{ active: view === 'semana' }" @click="mudarVisao('semana')"><%- include('partials/odonto-icon', { name: 'calendar-range', size: 15 }) %><span>Semana</span></button>
        <button type="button" class="chip" :class="{ active: view === 'mes' }" @click="mudarVisao('mes')"><%- include('partials/odonto-icon', { name: 'layout-grid', size: 15 }) %><span>Mês</span></button>
      </div>

      <button class="btn secondary small" @click="passo(-1)"><%- include('partials/odonto-icon', { name: 'chevron-left', size: 15 }) %><span>Anterior</span></button>
      <button class="btn secondary small" @click="irHoje()"><%- include('partials/odonto-icon', { name: 'clock', size: 15 }) %><span>Hoje</span></button>
      <button class="btn secondary small" @click="passo(1)"><span>Próximo</span><%- include('partials/odonto-icon', { name: 'chevron-right', size: 15 }) %></button>
      <input class="input" type="date" x-model="date" @change="load()" />

      <select class="input" x-model="professionalId" @change="load()">
        <option value="">Todos os profissionais</option>
        <template x-for="p in professionals" :key="p.id">
          <option :value="p.id" x-text="p.name"></option>
        </template>
      </select>

      <% if (user.permissions.has('odonto.agenda.manage')) { %>
        <button class="btn" @click="novo()">
          <%- include('partials/odonto-icon', { name: 'calendar-plus' }) %>
          <span>Novo agendamento</span>
        </button>
      <% } %>

      <span class="muted text-xs" x-text="titulo()"></span>
      <span class="error" x-text="error"></span>
    </div>

    <!-- ─────────── Dia (grade temporal) ─────────── -->
    <div class="grid-wrap" x-show="view === 'dia'" x-cloak>
      <div class="grid-head">
        <div class="grid-corner"></div>
        <template x-for="col in colunas()" :key="col.key">
          <div class="grid-colhead" x-text="col.label"></div>
        </template>
      </div>
      <div class="grid-body">
        <div class="grid-times">
          <template x-for="t in horas()" :key="t.min">
            <div class="grid-time"><span x-text="t.label"></span></div>
          </template>
        </div>
        <template x-for="col in colunas()" :key="col.key">
          <div class="grid-col">
            <template x-for="t in horas()" :key="t.min">
              <div class="grid-slot" :class="{ clicavel: podeGerenciar }" @click="novoNoSlot(col, t)"></div>
            </template>
            <template x-for="a in itensDaColuna(col)" :key="a.id">
              <button type="button" class="ag-block" :class="'st-' + a.status" :style="blocoEstilo(a)" @click="abrirPopover($event, a)"
                      :title="a.patient_name + ' · ' + hora(a.starts_at) + '–' + hora(a.ends_at)">
                <span class="b-time" x-text="hora(a.starts_at) + '–' + hora(a.ends_at)"></span>
                <span class="b-name" x-text="a.patient_name"></span>
                <span class="b-sub" x-text="resumo(a)"></span>
                <span class="ag-fit" x-show="a.is_fit_in">encaixe</span>
              </button>
            </template>
          </div>
        </template>
      </div>
      <div class="odonto-vazio" style="border:0;border-radius:0" x-show="!items.length">
        <strong>Nenhum atendimento neste dia</strong>
        Clique num horário livre acima para agendar — ou use “Novo agendamento”.
      </div>
    </div>

    <!-- ─────────── Semana ─────────── -->
    <div class="semana" x-show="view === 'semana'" x-cloak>
      <template x-for="d in diasDaSemana()" :key="d.data">
        <div class="dia" :class="{ hoje: d.data === hoje() }">
          <h4 x-text="d.rotulo"></h4>
          <template x-for="a in itensDoDia(d.data)" :key="a.id">
            <button type="button" class="semana-item" :class="'st-' + a.status" @click="abrirPopover($event, a)">
              <strong x-text="hora(a.starts_at)"></strong> <span x-text="a.patient_name"></span>
              <div class="muted text-xs" x-text="a.professional_name + (a.is_fit_in ? ' · encaixe' : '')"></div>
            </button>
          </template>
          <p class="muted text-xs" x-show="!itensDoDia(d.data).length">—</p>
        </div>
      </template>
    </div>

    <!-- ─────────── Mês ─────────── -->
    <div x-show="view === 'mes'" x-cloak>
      <div class="mes">
        <template x-for="c in ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb']" :key="c">
          <div class="cab" x-text="c"></div>
        </template>
        <template x-for="c in celulasDoMes()" :key="c.data">
          <div class="cel" :class="{ fora: !c.doMes, hoje: c.data === hoje() }" @click="abrirDia(c.data)">
            <div class="n" x-text="c.dia"></div>
            <div class="qtd" x-show="contagem(c.data)" x-text="contagem(c.data) + ' atendimento(s)'"></div>
            <template x-for="a in itensDoDia(c.data).slice(0, 2)" :key="a.id">
              <div class="muted text-xs" x-text="hora(a.starts_at) + ' ' + a.patient_name"></div>
            </template>
          </div>
        </template>
      </div>
      <p class="muted text-xs" style="margin-top:6px">Clique em um dia para abrir a visão diária.</p>
    </div>

    <!-- ─────────── Popover de ações do atendimento ─────────── -->
    <div class="ag-popover" x-show="pop.aberto" x-cloak @click.outside="fecharPop()"
         :style="'top:' + pop.top + 'px; left:' + pop.left + 'px'">
      <template x-if="pop.a">
        <div>
          <div class="ag-pop-head">
            <span class="ag-pop-name" x-text="pop.a.patient_name"></span>
            <span class="muted text-xs" x-text="hora(pop.a.starts_at) + '–' + hora(pop.a.ends_at) + ' · ' + pop.a.professional_name + (pop.a.room ? ' · ' + pop.a.room : '')"></span>
            <span class="badge" :class="'st-' + pop.a.status" x-text="rotulo(pop.a.status)"></span>
          </div>
          <div class="ag-pop-actions">
            <a class="ag-pop-item" :href="'/app/odonto/pacientes/' + pop.a.patient_id"><%- include('partials/odonto-icon', { name: 'file-text', size: 15 }) %><span>Abrir ficha</span></a>
            <% if (user.permissions.has('odonto.agenda.manage')) { %>
            <button type="button" class="ag-pop-item" x-show="pop.a.status === 'agendado'" @click="fecharPop(true); mudarStatus(pop.a, 'confirmado')"><%- include('partials/odonto-icon', { name: 'user-check', size: 15 }) %><span>Confirmar</span></button>
            <button type="button" class="ag-pop-item" x-show="pop.a.status === 'confirmado'" @click="fecharPop(true); mudarStatus(pop.a, 'em_atendimento')"><%- include('partials/odonto-icon', { name: 'play', size: 15 }) %><span>Iniciar atendimento</span></button>
            <button type="button" class="ag-pop-item" x-show="pop.a.status === 'em_atendimento'" @click="fecharPop(true); mudarStatus(pop.a, 'atendido')"><%- include('partials/odonto-icon', { name: 'check', size: 15 }) %><span>Marcar atendido</span></button>
            <button type="button" class="ag-pop-item" x-show="pop.a.status === 'agendado' || pop.a.status === 'confirmado'" @click="fecharPop(true); mudarStatus(pop.a, 'faltou')"><%- include('partials/odonto-icon', { name: 'user-x', size: 15 }) %><span>Registrar falta</span></button>
            <button type="button" class="ag-pop-item" x-show="pop.a.status !== 'atendido'" @click="fecharPop(true); editar(pop.a)"><%- include('partials/odonto-icon', { name: 'calendar-clock', size: 15 }) %><span>Reagendar / editar</span></button>
            <button type="button" class="ag-pop-item danger" x-show="pop.a.status !== 'atendido' && pop.a.status !== 'cancelado'" @click="fecharPop(true); cancelar(pop.a)"><%- include('partials/odonto-icon', { name: 'ban', size: 15 }) %><span>Cancelar</span></button>
            <% } %>
          </div>
        </div>
      </template>
    </div>

    <% if (user.permissions.has('odonto.agenda.manage')) { %>
    <!-- Cancelamento: motivo em diálogo próprio (o Electron não tem window.prompt). -->
    <dialog x-ref="dlgCancelar" class="dialog-fixed">
      <button type="button" class="dialog-close" @click="$refs.dlgCancelar.close()" title="Fechar" aria-label="Fechar"><%- include('partials/odonto-icon', { name: 'x', size: 18 }) %></button>
      <h1>Cancelar atendimento</h1>
      <div class="dialog-body">
        <p class="muted" style="margin-top:0" x-show="cancelando"
           x-text="cancelando ? (cancelando.patient_name + ' · ' + fmtDateTimeLocal(cancelando.starts_at)) : ''"></p>
        <label>Motivo (opcional)</label>
        <textarea class="input" x-model="motivoCancelamento" rows="2" placeholder="Ex.: paciente pediu para remarcar, faltou luz na clínica…"></textarea>
        <div class="error" x-text="dlgError"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlgCancelar.close()"><%- include('partials/odonto-icon', { name: 'arrow-left' }) %><span>Voltar</span></button>
        <button class="btn secondary danger" @click="confirmarCancelamento()"><%- include('partials/odonto-icon', { name: 'ban' }) %><span>Cancelar atendimento</span></button>
      </div>
    </dialog>

    <dialog x-ref="dlg" class="dialog-fixed dialog-agenda">
      <button type="button" class="dialog-close" @click="$refs.dlg.close()" title="Fechar" aria-label="Fechar"><%- include('partials/odonto-icon', { name: 'x', size: 18 }) %></button>
      <h1 x-text="form.id ? 'Reagendar / editar atendimento' : 'Novo agendamento'"></h1>
      <div class="dialog-body">
        <div class="combo pm-field">
          <label>Paciente</label>
          <input class="input" type="text" x-model="buscaPaciente" @focus="patAberto = true" @input="patAberto = true"
                 @blur="setTimeout(() => patAberto = false, 180)" placeholder="Busque por nome, CPF ou telefone…" autocomplete="off"
                 @keydown.escape="patAberto = false" />
          <div class="combo-list" x-show="patAberto && pacientesFiltrados().length" x-cloak>
            <template x-for="p in pacientesFiltrados()" :key="p.id">
              <button type="button" class="combo-item" @mousedown.prevent="escolherPaciente(p)">
                <span class="combo-name" x-text="p.name"></span>
                <span class="muted text-xs" x-text="[p.document, p.phone].filter(Boolean).join(' · ') || '—'"></span>
              </button>
            </template>
          </div>
          <span class="muted text-xs" x-show="form.patient_id" x-cloak>Selecionado: <strong x-text="pacienteNome()"></strong></span>
        </div>

        <div class="pm-grid">
          <div class="pm-field">
            <label>Profissional</label>
            <select class="input" x-model="form.professional_id" @change="atualizarDisponibilidade()">
              <option value="">Escolha…</option>
              <template x-for="p in professionals" :key="p.id">
                <option :value="p.id" x-text="p.name + (p.cro ? ' · CRO ' + p.cro : '')"></option>
              </template>
            </select>
          </div>
          <div class="pm-field">
            <label>Procedimento</label>
            <select class="input" x-model="form.procedure_id" @change="preencherDuracao()">
              <option value="">—</option>
              <template x-for="p in procedures" :key="p.id">
                <option :value="p.id" x-text="p.name + (p.duration_min ? ' (' + p.duration_min + ' min)' : '')"></option>
              </template>
            </select>
          </div>
        </div>

        <div class="pm-grid">
          <div class="pm-field"><label>Data</label><input class="input" type="date" x-model="form.data" @change="atualizarDisponibilidade()" /></div>
          <div class="pm-field"><label>Hora</label><input class="input" type="time" x-model="form.hora" @change="atualizarDisponibilidade()" /></div>
          <div class="pm-field"><label>Duração (min)</label><input class="input" type="number" x-model="form.duration_min" min="5" max="480" step="5" @change="atualizarDisponibilidade()" /></div>
          <div class="pm-field"><label>Sala / cadeira</label><input class="input" type="text" x-model="form.room" maxlength="40" /></div>
        </div>

        <div x-show="form.data" x-cloak style="margin-top:8px">
          <label style="margin-top:0">Horários do dia <span class="muted text-xs">— verde = livre, cinza = ocupado; clique para escolher</span></label>
          <p class="muted text-xs" x-show="!form.professional_id" style="margin:4px 0 0">Escolha o profissional (acima) para ver os horários livres.</p>
          <div class="slots" x-show="form.professional_id">
            <template x-for="s in slots()" :key="s.min">
              <button type="button" class="slot" :class="[s.ocupado ? 'ocupado' : 'livre', form.hora === s.label ? 'escolhido' : '']"
                      :disabled="s.ocupado" @click="form.hora = s.label" x-text="s.label"></button>
            </template>
          </div>
          <div class="conflito" x-show="form.professional_id && conflito() && !form.is_fit_in">
            <%- include('partials/odonto-icon', { name: 'info', size: 15 }) %>
            <span>Horário ocupado: <strong x-text="conflito() ? conflito().patient_name : ''"></strong> <span x-text="conflito() ? ('das ' + hora(conflito().starts_at) + ' às ' + hora(conflito().ends_at)) : ''"></span>. Marque <strong>Encaixe</strong> para sobrepor.</span>
          </div>
        </div>

        <label class="label-checkbox-sm" style="display:flex;align-items:center;gap:8px;margin-top:10px">
          <input type="checkbox" x-model="form.is_fit_in" />
          <span>Encaixe (pode sobrepor outro atendimento do mesmo profissional)</span>
        </label>

        <label>Observação do agendamento</label>
        <textarea class="input" x-model="form.notes" rows="2" placeholder="Ex.: paciente pediu para avisar 1h antes, traz exame…"></textarea>

        <template x-if="form.id && historico.length">
          <details style="margin-top:10px">
            <summary style="cursor:pointer;font-size:.85rem;color:var(--text-secondary)">Histórico deste atendimento</summary>
            <table style="margin-top:6px">
              <tbody>
                <template x-for="e in historico" :key="e.id">
                  <tr>
                    <td class="muted text-xs" x-text="fmtDateTime(e.created_at)"></td>
                    <td x-text="textoEvento(e)"></td>
                    <td class="muted text-xs" x-text="e.username || '—'"></td>
                  </tr>
                </template>
              </tbody>
            </table>
          </details>
        </template>

        <div class="error" x-text="dlgError"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.dlg.close()"><%- include('partials/odonto-icon', { name: 'x' }) %><span>Cancelar</span></button>
        <button class="btn" @click="salvar()" :disabled="salvando"><%- include('partials/odonto-icon', { name: 'save' }) %><span x-text="salvando ? 'Salvando…' : 'Salvar'"></span></button>
      </div>
    </dialog>
    <% } %>

  <%- include('partials/odonto-tour') %>
  </main>

  <script nonce="<%= cspNonce %>" src="/js/datetime.js"></script>
  <script nonce="<%= cspNonce %>">
    const ROTULOS = {
      agendado: 'Agendado', confirmado: 'Confirmado', em_atendimento: 'Em atendimento',
      atendido: 'Atendido', faltou: 'Faltou', cancelado: 'Cancelado',
    };

    function agendaPage(podeGerenciar) {
      const H0 = 7 * 60;   // 07:00
      const H1 = 20 * 60;  // 20:00
      const STEP = 30;     // minutos por linha
      const PX = 1;        // px por minuto (30 min = 30px)
      const hhmm = (m) => String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');
      const minutosDe = (v) => Number(String(v || '').slice(11, 13)) * 60 + Number(String(v || '').slice(14, 16));

      return {
        podeGerenciar,
        H0, H1, STEP, PX,
        view: 'dia',
        date: new Date().toISOString().slice(0, 10),
        professionalId: '',
        items: [],
        porDia: [],
        professionals: [],
        procedures: [],
        pacientes: [],
        buscaPaciente: '',
        patAberto: false,
        diaItems: [],
        historico: [],
        error: '',
        dlgError: '',
        salvando: false,
        form: {},
        cancelando: null,
        motivoCancelamento: '',
        pop: { aberto: false, a: null, top: 0, left: 0 },
        _popAt: 0,

        hoje() { return new Date().toISOString().slice(0, 10); },
        rotulo(s) { return ROTULOS[s] || s; },
        hora(v) { return String(v || '').slice(11, 16); },
        minutos(v) { return minutosDe(v); },
        resumo(a) { return (a.procedure_name || (a.room ? a.room : '')) || (a.patient_phone || ''); },

        // ── Grade ──
        horas() {
          const out = [];
          for (let m = this.H0; m < this.H1; m += this.STEP) out.push({ min: m, label: hhmm(m) });
          return out;
        },
        colunas() {
          const ativos = this.professionalId
            ? this.professionals.filter((p) => p.id === Number(this.professionalId))
            : this.professionals.slice();
          const cols = ativos.map((p) => ({ key: 'p' + p.id, id: p.id, label: p.name }));
          // Itens de profissionais fora da lista (inativo, removido) ainda ganham coluna, para não sumir.
          for (const a of this.items) {
            if (!cols.some((c) => c.id === a.professional_id)) {
              cols.push({ key: 'p' + a.professional_id, id: a.professional_id, label: a.professional_name || 'Profissional' });
            }
          }
          if (!cols.length) cols.push({ key: 'all', id: null, label: 'Todos os profissionais' });
          return cols;
        },
        itensDaColuna(col) { return this.items.filter((a) => (col.id == null ? true : a.professional_id === col.id)); },
        blocoEstilo(a) {
          const ini = Math.max(this.H0, minutosDe(a.starts_at));
          const dur = Number(a.duration_min) || 30;
          const top = (ini - this.H0) * this.PX;
          const h = Math.max(24, dur * this.PX - 2);
          return 'top:' + top + 'px;height:' + h + 'px';
        },

        async load() {
          const params = new URLSearchParams({ view: this.view, date: this.date });
          if (this.professionalId) params.set('professional_id', String(this.professionalId));
          const r = await fetch('/api/odonto/appointments?' + params.toString());
          if (r.ok) {
            const data = await r.json();
            this.items = data.items || [];
            this.porDia = data.porDia || [];
          } else {
            this.error = (await r.json()).error ?? 'Erro ao carregar a agenda.';
          }
          if (!this.professionals.length) {
            const p = await fetch('/api/odonto/professionals?active=true');
            if (p.ok) this.professionals = await p.json();
          }
          <% if (user.permissions.has('odonto.agenda.manage')) { %>
          if (!this.procedures.length) {
            const pr = await fetch('/api/odonto/procedures?active=true');
            if (pr.ok) this.procedures = await pr.json();
          }
          if (!this.pacientes.length) {
            const pa = await fetch('/api/odonto/patients?active=true');
            if (pa.ok) this.pacientes = await pa.json();
          }
          <% } %>
        },

        // ── Navegação por período ──
        mudarVisao(v) { this.view = v; this.fecharPop(true); this.load(); },
        irHoje() { this.date = this.hoje(); this.load(); },
        passo(direcao) {
          const d = new Date(this.date + 'T00:00:00');
          if (this.view === 'dia') d.setDate(d.getDate() + direcao);
          else if (this.view === 'semana') d.setDate(d.getDate() + 7 * direcao);
          else d.setMonth(d.getMonth() + direcao, 1);
          this.date = d.toISOString().slice(0, 10);
          this.load();
        },
        abrirDia(data) { this.date = data; this.view = 'dia'; this.load(); },

        titulo() {
          const d = new Date(this.date + 'T00:00:00');
          if (this.view === 'dia') return d.toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: 'long' });
          if (this.view === 'mes') return d.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
          const dias = this.diasDaSemana();
          return dias.length ? dias[0].rotulo.split(',')[1] + ' a ' + dias[6].rotulo.split(',')[1] : '';
        },

        // ── Agrupamentos ──
        diasDaSemana() {
          const base = new Date(this.date + 'T00:00:00');
          const domingo = new Date(base);
          domingo.setDate(base.getDate() - base.getDay());
          const saida = [];
          for (let i = 0; i < 7; i++) {
            const d = new Date(domingo);
            d.setDate(domingo.getDate() + i);
            const iso = d.toISOString().slice(0, 10);
            saida.push({ data: iso, rotulo: d.toLocaleDateString('pt-BR', { weekday: 'short', day: '2-digit', month: '2-digit' }) });
          }
          return saida;
        },
        celulasDoMes() {
          const base = new Date(this.date + 'T00:00:00');
          const primeiro = new Date(base.getFullYear(), base.getMonth(), 1);
          const inicio = new Date(primeiro);
          inicio.setDate(1 - primeiro.getDay());
          const celulas = [];
          for (let i = 0; i < 42; i++) {
            const d = new Date(inicio);
            d.setDate(inicio.getDate() + i);
            celulas.push({ data: d.toISOString().slice(0, 10), dia: d.getDate(), doMes: d.getMonth() === base.getMonth() });
          }
          return celulas;
        },
        itensDoDia(data) { return this.items.filter((a) => String(a.starts_at).slice(0, 10) === data); },
        contagem(data) {
          const achado = this.porDia.find((c) => String(c.dia).slice(0, 10) === data);
          return achado ? Number(achado.total) : this.itensDoDia(data).length;
        },

        // ── Popover ──
        abrirPopover(ev, a) {
          const r = ev.currentTarget.getBoundingClientRect();
          const left = Math.max(8, Math.min(r.left, window.innerWidth - 252));
          const top = Math.min(r.bottom + 4, window.innerHeight - 300);
          this.pop = { aberto: true, a, top: Math.max(8, top), left };
          this._popAt = Date.now();
        },
        fecharPop(force) {
          // Sem isto, o `click.outside` fecharia no MESMO clique que abriu o popover.
          if (!force && Date.now() - this._popAt < 250) return;
          this.pop.aberto = false;
        },

        // ── Formulário ──
        pacientesFiltrados() {
          const q = this.buscaPaciente.trim().toLowerCase();
          const lista = q
            ? this.pacientes.filter((p) => [p.name, p.document, p.phone].filter(Boolean).join(' ').toLowerCase().includes(q))
            : this.pacientes;
          return lista.slice(0, 40);
        },
        pacienteNome() {
          const p = this.pacientes.find((x) => x.id === Number(this.form.patient_id));
          return p ? p.name : '';
        },
        escolherPaciente(p) {
          this.form.patient_id = p.id;
          this.buscaPaciente = p.name;
          this.patAberto = false;
        },
        preencherDuracao() {
          const proc = this.procedures.find((p) => p.id === Number(this.form.procedure_id));
          if (proc && proc.duration_min) this.form.duration_min = proc.duration_min;
        },

        novoNoSlot(col, t) {
          if (!this.podeGerenciar) return;
          this.novo({ professional_id: col.id || '', hora: t.label });
        },
        novo(prefill) {
          this.dlgError = '';
          this.historico = [];
          this.patAberto = false;
          this.buscaPaciente = '';
          this.form = {
            id: null,
            patient_id: '',
            professional_id: (prefill && prefill.professional_id) || this.professionalId || '',
            procedure_id: '',
            data: this.date,
            hora: (prefill && prefill.hora) || '09:00',
            duration_min: 30,
            room: '',
            notes: '',
            is_fit_in: false,
          };
          this.diaItems = [];
          this.atualizarDisponibilidade();
          this.$refs.dlg.showModal();
        },
        async editar(a) {
          this.dlgError = '';
          this.patAberto = false;
          this.form = {
            id: a.id,
            patient_id: a.patient_id,
            professional_id: a.professional_id,
            procedure_id: a.procedure_id || '',
            data: String(a.starts_at).slice(0, 10),
            hora: this.hora(a.starts_at),
            duration_min: a.duration_min,
            room: a.room || '',
            notes: a.notes || '',
            is_fit_in: !!a.is_fit_in,
          };
          this.buscaPaciente = a.patient_name;
          const r = await fetch('/api/odonto/appointments/' + a.id);
          this.historico = r.ok ? (await r.json()).history : [];
          this.atualizarDisponibilidade();
          this.$refs.dlg.showModal();
        },
        textoEvento(e) {
          const de = e.from || '';
          const para = e.to || '';
          const nome = {
            criado: 'Criado', reagendado: 'Reagendado', confirmado: 'Confirmado',
            em_atendimento: 'Atendimento iniciado', atendido: 'Atendimento concluído',
            faltou: 'Registrada falta', cancelado: 'Cancelado', reativado: 'Reativado',
            encaixe: 'Marcado como encaixe', editado: 'Editado',
          }[e.event] || e.event;
          const quando = de && para && de !== para ? ` (${de.slice(11, 16)} → ${para.slice(11, 16)})` : '';
          return nome + quando + (e.notes ? ' · ' + e.notes : '');
        },

        // ── Disponibilidade do profissional no dia ──
        async atualizarDisponibilidade() {
          if (!this.form.data || !this.form.professional_id) { this.diaItems = []; return; }
          const q = new URLSearchParams({ view: 'dia', date: this.form.data, professional_id: String(this.form.professional_id) });
          const r = await fetch('/api/odonto/appointments?' + q.toString());
          if (r.ok) this.diaItems = (await r.json()).items || [];
        },
        _bloqueia(a) { return a.status !== 'cancelado' && a.status !== 'faltou' && a.id !== this.form.id; },
        _overlap(i1, f1, i2, f2) { return i1 < f2 && i2 < f1; },
        intervaloForm() {
          const [h, m] = String(this.form.hora || '00:00').split(':');
          const ini = Number(h) * 60 + Number(m);
          return [ini, ini + (Number(this.form.duration_min) || 30)];
        },
        conflito() {
          const [ini, fim] = this.intervaloForm();
          return this.diaItems.find((a) => this._bloqueia(a) && this._overlap(ini, fim, minutosDe(a.starts_at), minutosDe(a.starts_at) + (Number(a.duration_min) || 30))) || null;
        },
        slots() {
          const dur = Number(this.form.duration_min) || 30;
          const out = [];
          for (let m = this.H0; m + dur <= this.H1; m += this.STEP) {
            const ocupado = this.diaItems.some((a) => this._bloqueia(a) && this._overlap(m, m + dur, minutosDe(a.starts_at), minutosDe(a.starts_at) + (Number(a.duration_min) || 30)));
            out.push({ min: m, label: hhmm(m), ocupado });
          }
          return out;
        },

        async salvar() {
          if (!this.form.patient_id) { this.dlgError = 'Escolha o paciente.'; return; }
          if (!this.form.professional_id || !this.form.data || !this.form.hora) {
            this.dlgError = 'Profissional, data e hora são obrigatórios.';
            return;
          }
          this.salvando = true;
          this.dlgError = '';
          const corpo = {
            patient_id: Number(this.form.patient_id),
            professional_id: Number(this.form.professional_id),
            procedure_id: this.form.procedure_id ? Number(this.form.procedure_id) : null,
            starts_at: `${this.form.data} ${this.form.hora}`,
            duration_min: Number(this.form.duration_min) || 30,
            room: this.form.room || null,
            notes: this.form.notes || null,
            is_fit_in: !!this.form.is_fit_in,
          };
          try {
            const r = await fetch(this.form.id ? '/api/odonto/appointments/' + this.form.id : '/api/odonto/appointments', {
              method: this.form.id ? 'PUT' : 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(corpo),
            });
            if (r.ok) {
              this.$refs.dlg.close();
              showToast(this.form.id ? 'Atendimento reagendado.' : 'Atendimento agendado.', 'success');
              await this.load();
            } else {
              this.dlgError = (await r.json()).error ?? 'Erro ao salvar o agendamento.';
            }
          } finally {
            this.salvando = false;
          }
        },
        async mudarStatus(a, status) {
          const r = await fetch('/api/odonto/appointments/' + a.id + '/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status }),
          });
          if (r.ok) await this.load();
          else this.error = (await r.json()).error ?? 'Erro ao mudar a situação.';
        },
        async cancelar(a) {
          this.dlgError = '';
          this.motivoCancelamento = '';
          this.cancelando = a;
          this.$refs.dlgCancelar.showModal();
        },
        async confirmarCancelamento() {
          const a = this.cancelando;
          if (!a) return;
          const r = await fetch('/api/odonto/appointments/' + a.id + '/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: 'cancelado', motivo: this.motivoCancelamento || null }),
          });
          if (r.ok) {
            this.$refs.dlgCancelar.close();
            showToast('Atendimento cancelado.', 'success');
            await this.load();
          } else {
            this.dlgError = (await r.json()).error ?? 'Erro ao cancelar.';
          }
        },
      };
    }
  </script>
</body>
</html>
