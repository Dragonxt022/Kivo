<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Histórico financeiro do cliente</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <script defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/commercial/clientes' }) %>
  <main x-data="receivablesPage(<%= customerId %>)" x-init="load()">
    <a :href="'/app/commercial/clientes/' + id" class="muted text-sm">← Voltar para ficha</a>
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
      <h1 style="margin:0">Histórico financeiro — <span x-text="customerName"></span></h1>
      <%- include('partials/month-nav') %>
    </div>
    <section class="panel">
      <table>
        <thead><tr><th>Descrição</th><th>Vencimento</th><th>Situação</th><th class="text-right">Valor</th><th></th></tr></thead>
        <tbody>
          <template x-for="r in receivables.filter(r => String(r.due_date).slice(0, 7) === key)" :key="r.id">
            <tr>
              <td x-text="r.description"></td>
              <td class="muted" x-text="fmtDate(r.due_date)"></td>
              <td><span class="badge" :class="r.status === 'recebida' ? 'ok' : (r.status === 'cancelada' ? 'off' : '')" x-text="r.status"></span></td>
              <td class="text-right" x-text="brl(r.amount_cents)"></td>
              <td class="text-right">
                <% if (user.permissions.has('finance.receivables.receive')) { %>
                <button class="btn small" x-show="r.status === 'aberta'" @click="openSettle(r)">Receber</button>
                <% } %>
              </td>
            </tr>
          </template>
          <tr x-show="!receivables.length"><td colspan="5"><%- include('partials/empty-state', { message: 'Nenhum lançamento financeiro.' }) %></td></tr>
        </tbody>
      </table>
    </section>

    <dialog x-ref="settleDlg" class="dialog-fixed" style="width:min(480px,calc(100vw - 2rem))">
      <h1>Receber</h1>
      <div class="dialog-body">
        <p class="muted" x-text="settleForm.description"></p>
        <p>Valor devido: <strong x-text="brl(settleForm.amountCents)"></strong></p>
        <p x-show="settleForm.diasAtraso > 0" class="muted text-xs">
          Vencida há <strong x-text="settleForm.diasAtraso"></strong> dia(s) —
          com multa/juros: <strong x-text="brl(settleOwedCents())"></strong>
        </p>

        <label style="margin-top:.6rem">Forma de pagamento</label>
        <template x-for="(p, idx) in settleForm.payments" :key="idx">
          <div style="margin-bottom:.6rem">
            <div class="form-grid" style="grid-template-columns:1fr 110px 32px">
              <select x-model.number="p.methodId">
                <option value="">Selecione…</option>
                <template x-for="m in settleMethods" :key="m.id">
                  <option :value="m.id" x-text="m.name"></option>
                </template>
              </select>
              <input type="text" x-model="p.amount" placeholder="0,00" @input="p.amount = maskMoney(p.amount)" />
              <button type="button" class="btn secondary small" @click="removeSettlePaymentRow(idx)" x-show="settleForm.payments.length > 1">×</button>
            </div>
            <%- include('partials/payment-quick-methods', { modelExpr: 'p.methodId' }) %>
          </div>
        </template>
        <button type="button" class="btn secondary small" @click="addSettlePaymentRow()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Adicionar forma
        </button>

        <p class="hint" style="margin-top:.6rem">
          Total informado: <strong x-text="brl(settleTotalCents())"></strong>
        </p>
        <p class="hint" style="color:var(--warning-text)" x-show="settleTotalCents() > 0 && settleTotalCents() < settleOwedCents()">
          Faltam <strong x-text="brl(settleOwedCents() - settleTotalCents())"></strong> —
          serão transferidos automaticamente pra próxima parcela em aberto, ou uma parcela nova será criada se não houver uma.
        </p>

        <label style="margin-top:.6rem">Data do pagamento</label>
        <input type="date" x-model="settleForm.settledAt" />
        <p class="hint">Pagamento adiantado? Ajuste a data acima — o padrão é hoje.</p>
        <div class="error" x-text="settleError"></div>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.settleDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button class="btn" @click="confirmSettle()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Receber
        </button>
      </div>
    </dialog>

    <%- include('partials/cash-register-inline-open', { retryExpr: 'confirmSettle()' }) %>
  </main>
  <script src="/js/masks.js"></script>
  <script src="/js/datetime.js"></script>
  <script src="/js/payment-methods.js"></script>
  <script>
    function receivablesPage(id) {
      const _d = new Date();
      return {
        ...paymentMethodsMixin(),
        ...cashRegisterInlineOpenMixin(),
        id, customerName: 'Cliente', receivables: [],
        year: _d.getFullYear(), month: _d.getMonth(),
        get label() { return new Date(this.year, this.month).toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' }).replace('.', ''); },
        get key() { return `${this.year}-${String(this.month + 1).padStart(2, '0')}`; },
        prev() { if (this.month === 0) { this.month = 11; this.year--; } else this.month--; },
        next() { if (this.month === 11) { this.month = 0; this.year++; } else this.month++; },
        settleForm: { id: null, description: '', amountCents: 0, settledAt: '', diasAtraso: 0, suggestedSettleCents: 0, payments: [] },
        settleError: '',
        brl(c) { return 'R$ ' + ((c ?? 0) / 100).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); },
        cents(s) { const n = parseFloat(String(s || '0').replace(/\./g, '').replace(',', '.')); return isNaN(n) ? 0 : Math.round(n * 100); },
        async load() {
          const [c, r] = await Promise.all([
            fetch(`/api/commercial/customers/${this.id}`),
            fetch(`/api/finance/receivables?partyId=${this.id}`),
          ]);
          if (c.ok) { const d = await c.json(); this.customerName = d.name ?? 'Cliente'; }
          if (r.ok) this.receivables = await r.json();
        },
        settleOwedCents() { return this.settleForm.suggestedSettleCents || this.settleForm.amountCents; },
        settleTotalCents() { return (this.settleForm.payments || []).reduce((s, p) => s + this.cents(p.amount), 0); },
        addSettlePaymentRow() { this.settleForm.payments.push({ methodId: '', amount: '' }); },
        removeSettlePaymentRow(idx) { this.settleForm.payments.splice(idx, 1); },
        async openSettle(r) {
          const owed = r.suggestedSettleCents ?? r.amount_cents;
          this.settleForm = {
            id: r.id, description: r.description, amountCents: r.amount_cents, settledAt: todayLocal(),
            diasAtraso: r.diasAtraso || 0, suggestedSettleCents: owed,
            payments: [{ methodId: '', amount: (owed / 100).toFixed(2).replace('.', ',') }],
          };
          this.settleError = '';
          await this.loadPaymentMethods();
          if (this.settleMethods.length === 1) this.settleForm.payments[0].methodId = this.settleMethods[0].id;
          this.$refs.settleDlg.showModal();
        },
        async confirmSettle() {
          const payments = this.settleForm.payments.map((p) => ({ paymentMethodId: p.methodId, amountCents: this.cents(p.amount) }));
          if (!payments.length || payments.some((p) => !p.paymentMethodId || !(p.amountCents > 0))) {
            this.settleError = 'Preencha forma de pagamento e valor em cada linha.';
            return;
          }
          const r = await fetch(`/api/finance/receivables/${this.settleForm.id}/settle`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ settledAt: this.settleForm.settledAt, payments }),
          });
          if (r.ok) { this.$refs.settleDlg.close(); this.load(); return; }
          const data = await r.json();
          if (data.code === 'no_register') { this.$refs.settleDlg.close(); this.$refs.cashClosedWarnDlg.showModal(); return; }
          this.settleError = data.error ?? 'Erro ao registrar recebimento.';
        },
      };
    }
  </script>
</body>
</html>
