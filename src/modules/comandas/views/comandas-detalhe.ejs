<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — Comanda</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/comandas/mesas' }) %>
  <main x-data="comandaDetalhePage()" x-init="init()">
    <div class="comanda-header">
      <div>
        <a href="/app/comandas/mesas" class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Mesas
        </a>
        <h1 x-text="comanda ? 'Comanda #' + comanda.id + (comanda.table_label ? ' — ' + comanda.table_label : '') : 'Carregando…'"></h1>
        <p class="muted" x-show="comanda?.notes" x-text="'Obs.: ' + (comanda?.notes ?? '')"></p>
      </div>
      <div class="toolbar header-actions" x-show="isOpen" x-cloak>
        <%# Envio explícito: enquanto monta o pedido o cliente pode desistir/trocar —
            a cozinha só vê o que o garçom confirmar aqui. %>
        <button type="button" class="btn secondary" @click="enviarCozinha()" :disabled="enviandoCozinha || !items.length" title="Enviar itens para o painel da cozinha">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
          <span class="btn-label" x-text="enviandoCozinha ? 'Enviando…' : 'Enviar p/ cozinha'"></span>
        </button>
        <button type="button" class="btn secondary" @click="openTransferDlg()" title="Transferir">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>
          <span class="btn-label">Transferir</span>
        </button>
        <button type="button" class="btn secondary" @click="openSplitDlg()" :disabled="items.length < 2" title="Dividir">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
          <span class="btn-label">Dividir</span>
        </button>
        <button type="button" class="btn secondary" @click="openMergeDlg()" title="Unir">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/></svg>
          <span class="btn-label">Unir</span>
        </button>
        <button type="button" class="btn danger" @click="cancelComanda()" title="Cancelar comanda">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>
          <span class="btn-label">Cancelar</span>
        </button>
      </div>
    </div>
    <div class="error" x-text="error"></div>

    <div class="panel comanda-panel">
      <div class="comanda-items" x-show="items.length">
        <template x-for="(item, idx) in items" :key="item.id">
          <div class="comanda-item" :class="{ 'is-complement': item.line_group_uuid && idx > 0 && items[idx-1]?.line_group_uuid === item.line_group_uuid }">
            <div class="comanda-item-qty" x-show="!isOpen || (item.line_group_uuid && idx > 0 && items[idx-1]?.line_group_uuid === item.line_group_uuid)" x-text="(item.qty % 1 === 0 ? item.qty : item.qty.toFixed(3)) + 'x'"></div>
            <div class="qty-wrap" x-show="isOpen && !(item.line_group_uuid && idx > 0 && items[idx-1]?.line_group_uuid === item.line_group_uuid)">
              <button type="button" class="qty-btn" @click="changeItemQty(item, -1)" title="Diminuir">−</button>
              <%# x-model.number + step="any" (mesmo padrão do PDV): sem isso o valor era
                  formatado com vírgula num <input type="number">, que o navegador não
                  entende — o campo aparecia vazio (qtd "zerada") para unidade fracionada.
                  @change/@keydown.enter: mesmo sem sair do campo (Enter) a quantidade é
                  gravada. %>
              <input type="number" step="any" :min="isFractionalUnit(item.unit) ? '0.001' : '1'" x-model.number="item.qty"
                     @change="onQtyInput(item)" @keydown.enter.prevent="onQtyInput(item)"
                     @focus="$event.target.select()" :title="isFractionalUnit(item.unit) ? 'Qtd em ' + item.unit : 'Qtd inteira'" />
              <button type="button" class="qty-btn" @click="changeItemQty(item, 1)" title="Aumentar">+</button>
            </div>
            <div x-show="item.line_group_uuid && idx > 0 && items[idx-1]?.line_group_uuid === item.line_group_uuid" style="color:var(--text-muted)">↳</div>
            <div class="comanda-item-info">
              <%# Clicar no nome abre o editor de observação (como no PDF): clicou de novo,
                  editou de novo — enquanto a comanda estiver aberta. %>
              <button type="button" class="comanda-item-name-btn" :disabled="!isOpen" @click="openNotes(item)"
                      :title="item.notes ? 'Editar observação' : 'Adicionar observação'">
                <span class="comanda-item-name" x-text="item.product_name"></span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     :class="{ 'obs-on': item.notes }">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
              </button>
              <div class="comanda-item-meta" x-show="item.notes" x-text="'Obs.: ' + item.notes"></div>
            </div>
            <div class="comanda-item-price" x-text="brl(item.unit_price_cents * item.qty)"></div>
            <button type="button" class="icon-btn active" @click="voidItem(item.id, idx)" :disabled="!isOpen" title="Remover item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            </button>
          </div>
        </template>
      </div>
      <div x-show="!items.length" x-cloak>
        <%- include('partials/empty-state', { message: 'Comanda vazia — busque um produto abaixo para adicionar.' }) %>
      </div>

      <div class="comanda-total" x-show="items.length">
        <span>Total</span>
        <strong x-text="brl(total())"></strong>
      </div>
    </div>

    <div class="panel" x-show="isOpen" x-cloak>
      <h2>Adicionar item</h2>
      <div class="combo-wrap">
        <%# `min-width:0` no input: item flex não encolhe abaixo do tamanho intrínseco
            por padrão, e era isso que empurrava o botão "Procurar" para fora do cartão
            no celular (o print do garçom mostra ele colado na borda). %>
        <div style="display:flex;gap:.5rem;min-width:0">
          <input type="text" class="input" style="flex:1;min-width:0" x-model="searchQ"
                 @input.debounce.300ms="searchProducts" @keydown.enter.prevent="quickAdd"
                 placeholder="Buscar produto por nome, SKU ou código de barras…" x-ref="searchInput" />
          <button type="button" class="btn secondary" @click="openBrowse()" title="Procurar produtos">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Procurar
          </button>
        </div>
        <div class="combo-results" x-show="searchResults.length" x-cloak>
          <template x-for="p in searchResults" :key="p.id">
            <button type="button" class="combo-result" @click="addItem(p)">
              <span class="combo-thumb">
                <img x-show="p.image_url" :src="p.image_url" alt="" loading="lazy" />
                <template x-if="!p.image_url">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </template>
              </span>
              <span style="flex:1;min-width:0;text-align:left">
                <span x-text="p.name" style="display:block;font-weight:600;font-size:.92rem"></span>
                <span class="muted text-sm" x-text="(p.category ? p.category + ' · ' : '') + (p.sku || '')"></span>
              </span>
              <strong style="color:var(--primary);white-space:nowrap" x-text="brl(p.price_cents)"></strong>
            </button>
          </template>
        </div>
        <div style="display:flex;gap:.5rem;margin-top:.5rem">
          <input type="text" class="input" style="width:110px" x-model="pendingQtyRaw" @input="pendingQty = parseQty(pendingQtyRaw)" min="0.001" step="0.001" placeholder="Qtd" title="Quantidade (ex: 0,350 kg)" />
          <input type="text" class="input" style="flex:1;min-width:0" x-model="itemNotes"
                 maxlength="500" placeholder="Obs. próximo item (ex.: sem cebola) — opcional" />
        </div>
        <p class="muted text-sm" style="margin:.35rem 0 0" x-show="pendingQty !== 1">Qtd para o próximo lançamento: <strong x-text="pendingQty"></strong></p>
      </div>
    </div>

    <%# Duas saídas diferentes, decididas pela permissão de venda:
        quem opera o caixa (`store.sales.create`) vai ao PDV receber o pagamento;
        o garçom, que não tem essa permissão, chama o caixa. Antes o botão era um só e
        mandava todo mundo para /app/store/pdv — quem não podia entrar era devolvido à
        home sem aviso nenhum (ver o redirect em core/server.ts). %>
    <div class="toolbar close-bar" x-show="isOpen && items.length" x-cloak style="justify-content:flex-end">
      <% if (user.permissions.has('store.sales.create')) { %>
      <button type="button" class="btn" @click="openCloseDlg()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        Fechar comanda
      </button>
      <% } else { %>
      <button type="button" class="btn" @click="chamarCaixa()" :disabled="chamandoCaixa || prontaParaPagamento">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        <span x-text="prontaParaPagamento ? 'Caixa avisado' : (chamandoCaixa ? 'Enviando…' : 'Enviar para o caixa')"></span>
      </button>
      <% } %>
    </div>
    <p class="hint caixa-avisado" x-show="prontaParaPagamento && isOpen" x-cloak>
      Conta enviada ao caixa. Pode continuar lançando itens — se lançar, avise o caixa de novo.
    </p>
    <div class="close-bar-spacer"></div>

    <!-- Dialog Transferir -->
    <dialog x-ref="transferDlg">
      <h1>Transferir para mesa</h1>
      <p class="dialog-text">Escolha a mesa de destino:</p>
      <div class="tables-mini-grid">
        <template x-for="t in availableTables" :key="t.id">
          <button type="button" class="mini-table" :class="{ selected: transferTarget === t.id }" @click="transferTarget = t.id">
            <span x-text="t.label"></span>
          </button>
        </template>
        <p class="muted text-sm" x-show="!availableTables.length">Nenhuma mesa livre no momento.</p>
      </div>
      <div class="error" x-text="dlgError"></div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="$refs.transferDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button type="button" class="btn" :disabled="!transferTarget" @click="confirmTransfer()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Transferir
        </button>
      </div>
    </dialog>

    <!-- Dialog Dividir -->
    <dialog x-ref="splitDlg" class="dialog-fixed">
      <h1>Dividir comanda</h1>
      <div class="dialog-body">
        <p class="dialog-text">Selecione os itens que vão para uma nova comanda:</p>
        <template x-for="item in items" :key="item.id">
          <label class="split-item">
            <input type="checkbox" x-model="splitItemIds" :value="item.id" />
            <span x-text="item.qty + 'x ' + item.product_name"></span>
            <span class="muted text-sm" x-text="brl(item.unit_price_cents * item.qty)"></span>
          </label>
        </template>
        <div class="error" x-text="dlgError"></div>
      </div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="$refs.splitDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button type="button" class="btn" :disabled="!splitItemIds.length" @click="confirmSplit()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Dividir
        </button>
      </div>
    </dialog>

    <!-- Dialog Unir -->
    <dialog x-ref="mergeDlg" class="dialog-fixed">
      <h1>Unir comanda</h1>
      <div class="dialog-body">
        <p class="dialog-text">Escolha a comanda que será unida a esta:</p>
        <template x-for="c in otherComandas" :key="c.id">
          <label class="split-item">
            <input type="radio" name="mergeComanda" x-model="mergeSourceId" :value="c.id" />
            <span x-text="'Comanda #' + c.id + (c.table_label ? ' — ' + c.table_label : '')"></span>
          </label>
        </template>
        <p class="muted text-sm" x-show="!otherComandas.length">Nenhuma outra comanda aberta.</p>
        <div class="error" x-text="dlgError"></div>
      </div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="$refs.mergeDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button type="button" class="btn" :disabled="!mergeSourceId" @click="confirmMerge()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Unir
        </button>
      </div>
    </dialog>

    <!-- Dialog Fechar (encaminha para o PDV) -->
    <dialog x-ref="closeDlg" style="width:360px">
      <div class="dialog-body-center">
        <div class="dialog-icon dialog-icon-primary">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><rect x="1" y="7" width="22" height="14" rx="2"/><path d="M1 10h22"/><circle cx="12" cy="14" r="2"/></svg>
        </div>
        <h2 class="dialog-heading-md">Fechar comanda</h2>
        <p class="dialog-muted">Você será encaminhado ao PDV para finalizar o pagamento.</p>
        <div class="actions actions-center">
          <button type="button" class="btn secondary" @click="$refs.closeDlg.close()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
            Cancelar
          </button>
          <button type="button" class="btn" @click="confirmClose()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            Ir para o PDV
          </button>
        </div>
      </div>
    </dialog>

    <!-- Dialog: observação do item -->
    <dialog x-ref="notesDlg">
      <h1>Observação do item</h1>
      <p class="muted dialog-text" x-text="notesItemName"></p>
      <textarea class="input obs-input" rows="3" maxlength="500" x-model="notesDraft" x-ref="notesInput"
                placeholder="Ex.: sem cebola, sem picles, ponto da carne…"></textarea>
      <%# Observação vai para a cozinha em DESTAQUE vermelho no painel — vale caprichar. %>
      <p class="muted text-sm">Essa observação aparece em destaque no painel da cozinha.</p>
      <div class="toolbar" style="justify-content:flex-end;gap:.5rem;margin-top:.75rem">
        <button type="button" class="btn secondary" @click="$refs.notesDlg.close()">Cancelar</button>
        <button type="button" class="btn" :disabled="salvandoObs" @click="salvarObs()"
                x-text="salvandoObs ? 'Salvando…' : 'Salvar observação'"></button>
      </div>
    </dialog>

    <!-- ─── Modal: Complementos / Adicionais (igual PDV) ─── -->
    <dialog x-ref="complementDlg" style="width:min(640px,94vw)">
      <h1 x-text="'Complementos — ' + (complementDlg.product?.name || '')"></h1>
      <div style="display:flex;flex-direction:column;gap:1rem;margin:.75rem 0">
        <template x-for="g in complementDlg.groups" :key="g.group_id">
          <div style="border:1px solid var(--border-light);border-radius:10px;padding:.75rem">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem">
              <strong x-text="g.group_name"></strong>
              <span class="muted text-sm" x-text="(g.min_select>0 ? 'Min: '+g.min_select : 'Opcional') + (g.max_select ? ' · Max: '+g.max_select : '')"></span>
            </div>
            <div class="error text-sm" x-show="complementDlg.errors[g.group_id]" x-text="complementDlg.errors[g.group_id]"></div>
            <template x-for="item in (typeof g.items === 'string' ? [] : g.items)" :key="item.id">
              <label style="display:flex;align-items:center;gap:.5rem;padding:.35rem 0;border-bottom:1px solid var(--border-light)">
                <input type="checkbox" :checked="complementDlg.selections[g.group_id]?.some(s=>s.product_id===item.product_id)" @change="toggleComplement(g.group_id, item)" />
                <span style="flex:1" x-text="item.product_name"></span>
                <span style="white-space:nowrap;font-weight:600" x-text="brl(item.price_override_cents!=null ? item.price_override_cents : item.price_cents)"></span>
                <template x-if="complementDlg.selections[g.group_id]?.some(s=>s.product_id===item.product_id)">
                  <span style="display:flex;align-items:center;gap:.25rem">
                    <button type="button" class="qty-btn" style="width:28px;height:28px" @click="complementQty(g.group_id,item.product_id,-1)">−</button>
                    <span style="min-width:18px;text-align:center" x-text="complementDlg.selections[g.group_id]?.find(s=>s.product_id===item.product_id)?.qty || 1"></span>
                    <button type="button" class="qty-btn" style="width:28px;height:28px" @click="complementQty(g.group_id,item.product_id,1)">+</button>
                  </span>
                </template>
              </label>
            </template>
          </div>
        </template>
        <label style="display:flex;flex-direction:column;gap:.25rem">
          <span class="muted text-sm">Observação do pedido (vai para todos os itens do grupo)</span>
          <input type="text" class="input" x-model="complementDlg.mainNotes" maxlength="500" placeholder="Ex.: sem cebola" />
        </label>
      </div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="$refs.complementDlg.close()">Cancelar</button>
        <button type="button" class="btn" @click="confirmComplementSelection()">Adicionar</button>
      </div>
    </dialog>

    <!-- ─── Modal: Procurar produtos (grade visual com foto) ─── -->
    <dialog x-ref="browseDlg" style="width:min(960px, 94vw)">
      <h1>Adicionar produtos</h1>
      <input type="text" x-ref="browseInput" x-model="browseQ"
             @input.debounce.250ms="searchBrowse()"
             placeholder="Buscar por nome, código de barras ou SKU…" />
      <div class="browse-cats" x-show="browseCategories.length">
        <button type="button" class="browse-cat-chip"
                :class="{ active: !browseCategoryId }"
                @click="browseCategoryId = ''">Todas</button>
        <template x-for="c in browseCategories" :key="c.id">
          <button type="button" class="browse-cat-chip"
                  :class="{ active: browseCategoryId === c.id }"
                  @click="browseCategoryId = browseCategoryId === c.id ? '' : c.id"
                  x-text="c.name"></button>
        </template>
      </div>
      <div class="prod-grid">
        <template x-for="p in browseFiltered()" :key="p.id">
          <button type="button" class="prod-card" @click="addItem(p); $refs.browseDlg.close()">
            <span class="prod-thumb">
              <img x-show="p.image_url" :src="p.image_url" alt="" loading="lazy" />
              <template x-if="!p.image_url">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </template>
            </span>
            <span class="prod-name" x-text="p.name"></span>
            <span class="prod-meta">
              <span class="muted text-sm" x-show="p.category" x-text="p.category"></span>
              <span class="prod-stock"
                    :class="{ low: p.track_stock && p.stock_qty <= 3 && p.stock_qty >= 0, negative: p.track_stock && p.stock_qty < 0 }"
                    x-show="p.track_stock"
                    x-text="'Est: ' + p.stock_qty"></span>
            </span>
            <span class="prod-price" x-text="brl(p.price_cents)"></span>
          </button>
        </template>
        <p class="browse-empty" x-show="!browseFiltered().length">Nenhum produto encontrado.</p>
      </div>
      <div class="actions">
        <button class="btn secondary" @click="$refs.browseDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Fechar
        </button>
      </div>
    </dialog>
  </main>
  <style>
    .comanda-header {
      display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;
      margin-bottom: 1.25rem;
    }
    .comanda-header h1 { margin-bottom: .15rem; }
    .back-link {
      display: inline-flex; align-items: center; gap: .3rem;
      font-size: .8rem; color: var(--text-muted); text-decoration: none; margin-bottom: .4rem;
      transition: color var(--transition);
    }
    .back-link:hover { color: var(--primary); }
    .comanda-panel { padding: 0; overflow: hidden; }
    .comanda-items { display: flex; flex-direction: column; }
    .comanda-item {
      display: flex; align-items: center; gap: .85rem; padding: .85rem 1.25rem;
      border-bottom: 1px solid var(--border-light);
    }
    .comanda-item:last-child { border-bottom: 0; }
    .comanda-item-qty {
      font-weight: 700; min-width: 2.4rem; text-align: center; color: var(--primary);
      background: var(--primary-bg); border-radius: 8px; padding: .2rem 0; font-size: .85rem;
    }
    .comanda-item-info { flex: 1; min-width: 0; }
    .comanda-item-name-btn {
      display: inline-flex; align-items: center; gap: .35rem;
      background: none; border: 0; padding: 0; cursor: pointer; text-align: left; color: inherit;
      font: inherit; max-width: 100%;
    }
    .comanda-item-name-btn:disabled { cursor: default; }
    .comanda-item-name-btn:not(:disabled):hover .comanda-item-name { color: var(--primary); text-decoration: underline dotted; }
    .comanda-item-name-btn svg { color: var(--text-muted); flex-shrink: 0; }
    /* Item COM observação: balão fica vermelho — mesmo destaque que o KDS mostra. */
    .comanda-item-name-btn svg.obs-on { color: var(--danger-text); }
    .obs-input { width: 100%; resize: vertical; margin-top: .5rem; }
    .comanda-item-name { font-weight: 500; }
    .comanda-item-meta { font-size: .82rem; color: var(--text-muted); margin-top: .1rem; }
    .comanda-item-price { font-weight: 600; font-size: .92rem; white-space: nowrap; }
    .comanda-item.is-complement { background: var(--surface-hover); padding-left: 2.2rem; }
    .qty-wrap { display:flex;align-items:center;gap:.2rem; }
    .qty-wrap input { width:64px;text-align:center;padding:.25rem;border:1.5px solid var(--border-light);border-radius:8px;font-weight:600; }
    .qty-btn { width:32px;height:32px;border-radius:8px;border:1.5px solid var(--border-light);background:var(--surface);cursor:pointer;font-weight:700;display:grid;place-items:center; }
    .qty-btn:hover { border-color:var(--primary);color:var(--primary); }
    .comanda-total {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1rem 1.25rem; background: var(--surface-hover); border-top: 1.5px solid var(--border-light);
      font-size: 1.05rem;
    }
    .comanda-total strong { color: var(--primary); font-size: 1.25rem; }

    .tables-mini-grid { display: flex; flex-wrap: wrap; gap: .5rem; margin: .5rem 0 1rem; }
    .mini-table {
      padding: .55rem 1.1rem; border-radius: 10px; border: 1.5px solid var(--border-light);
      background: var(--surface); color: var(--text); cursor: pointer; font-size: .88rem; font-weight: 600;
      transition: border-color var(--transition), background var(--transition), color var(--transition);
    }
    .mini-table:hover { border-color: var(--primary); }
    .mini-table.selected { border-color: var(--primary); background: var(--primary); color: #fff; }

    .split-item {
      display: flex; align-items: center; gap: .6rem; padding: .6rem .5rem; border-radius: 8px; cursor: pointer;
      font-size: .88rem;
    }
    .split-item:hover { background: var(--surface-hover); }
    .split-item span:nth-child(2) { flex: 1; }

    /* ─── Barra "Fechar comanda" fixa embaixo no celular (como o botão Finalizar do PDV) ─── */
    .close-bar-spacer { display: none; }
    @media (max-width: 720px) {
      .close-bar-spacer { display: block; height: 4.5rem; }
      .close-bar {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 80;
        margin: 0; padding: .75rem 1rem calc(.75rem + env(safe-area-inset-bottom));
        background: color-mix(in srgb, var(--surface) 92%, transparent);
        backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
        border-top: 1px solid var(--border-light); box-shadow: 0 -4px 16px rgba(0,0,0,.06);
      }
      .close-bar .btn { flex: 1; padding: .8rem; font-size: 1rem; }
    }

    /* ─── Ações do cabeçalho: só ícone no celular (título vira o rótulo acessível) ─── */
    @media (max-width: 560px) {
      .comanda-header { flex-direction: column; }
      .header-actions .btn-label { display: none; }
      .header-actions .btn { width: 42px; height: 42px; padding: 0; justify-content: center; }
      .header-actions .btn svg { margin-right: 0; }
    }

    /* ─── Toque/mobile: alvos maiores nos itens da comanda ─── */
    @media (hover: none), (max-width: 560px) {
      .comanda-item { padding: .95rem 1rem; }
      .comanda-item .icon-btn { width: 40px; height: 40px; }
    }

    .browse-cats { display: flex; gap: .4rem; flex-wrap: wrap; margin-top: .7rem; }
    .browse-cat-chip {
      border: 1.5px solid var(--border-light); background: var(--surface-hover); color: var(--text-secondary);
      border-radius: 999px; padding: .35rem .85rem; font-size: .82rem; font-weight: 600; cursor: pointer;
      transition: border-color var(--transition), background var(--transition), color var(--transition);
    }
    .browse-cat-chip:hover { border-color: var(--primary); color: var(--primary); }
    .browse-cat-chip.active { border-color: var(--primary); background: var(--primary-bg); color: var(--primary); }

    /* ─── Grade de produtos com foto (modal "Adicionar produtos") ─── */
    .prod-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .75rem;
      max-height: min(62vh, 640px); overflow-y: auto; margin-top: .75rem; padding: 2px;
    }
    .prod-card {
      display: flex; flex-direction: column; align-items: stretch; gap: .3rem;
      border: 1.5px solid var(--border-light); border-radius: var(--radius);
      background: var(--surface); padding: .55rem; cursor: pointer; text-align: left;
      transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
    }
    .prod-card:hover {
      border-color: var(--primary); transform: translateY(-2px);
      box-shadow: var(--shadow-sm, 0 4px 12px rgba(0,0,0,.08));
    }
    .prod-thumb {
      aspect-ratio: 1 / 1; width: 100%; border-radius: calc(var(--radius) - 4px);
      overflow: hidden; background: var(--surface-hover); border: 1px solid var(--border-light);
      display: grid; place-items: center; color: var(--text-muted);
    }
    .prod-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .prod-name {
      font-weight: 600; font-size: .9rem; line-height: 1.25; color: var(--text);
      min-width: 0; overflow-wrap: anywhere;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .prod-meta { display: flex; justify-content: space-between; gap: .35rem; min-width: 0; }
    .prod-meta .text-sm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .prod-stock { font-size: .76rem; color: var(--text-muted); white-space: nowrap; }
    .prod-stock.low, .prod-stock.negative { color: var(--danger); font-weight: 700; }
    .prod-price { font-weight: 700; font-size: .95rem; color: var(--primary); }
    .browse-empty { grid-column: 1 / -1; padding: .9rem; text-align: center; color: var(--text-muted); font-size: .9rem; }
    @media (max-width: 560px) {
      .prod-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: .55rem; }
    }

    /* Miniatura nos resultados da busca rápida (fora do modal) */
    .combo-result { align-items: center; }
    .combo-thumb {
      width: 34px; height: 34px; border-radius: 8px; overflow: hidden; flex-shrink: 0;
      background: var(--surface-hover); border: 1px solid var(--border-light);
      display: grid; place-items: center; color: var(--text-muted);
    }
    .combo-thumb img { width: 100%; height: 100%; object-fit: cover; }

    .caixa-avisado {
      margin-top: .75rem; padding: .7rem .9rem; border-radius: var(--radius);
      background: var(--success-bg); color: var(--success-text);
      border: 1.5px solid color-mix(in srgb, var(--success-text) 25%, transparent);
    }
  </style>
  <script nonce="<%= cspNonce %>">
    function comandaDetalhePage() {
      return {
        comandaId: <%= comandaId %>,
        comanda: null,
        chamandoCaixa: false,
        enviandoCozinha: false,
        items: [],
        searchQ: '',
        itemNotes: '',
        notesItemId: null,
        notesItemName: '',
        notesDraft: '',
        salvandoObs: false,
        searchResults: [],
        isOpen: false,
        error: '', dlgError: '',
        availableTables: [],
        transferTarget: null,
        splitItemIds: [],
        otherComandas: [],
        mergeSourceId: null,
        pollTimer: null,
        browseQ: '',
        browseResults: [],
        browseCategories: [],
        browseCategoryId: '',
        pendingQty: 1,
        pendingQtyRaw: '1',
        complementDlg: { product:null, groups:[], selections:{}, mainNotes:'', errors:{} },

        async init() {
          await this.load();
          this.pollTimer = setInterval(() => this.load(), 5000);
        },
        async load() {
          const r = await fetch('/api/comandas/comandas/' + this.comandaId);
          if (!r.ok) { window.handleApiError(r, await r.json().catch(() => ({})), 'Erro ao carregar comanda.'); return; }
          const data = await r.json();
          this.comanda = data;
          this.items = data.items || [];
          this.isOpen = data.status === 'aberta';
        },
        brl(c) { return window.brl(c); },
        total() { return this.items.reduce((a, i) => a + i.unit_price_cents * i.qty, 0); },
        async searchProducts() {
          if (!this.searchQ.trim()) { this.searchResults = []; return; }
          const r = await fetch('/api/commercial/products?q=' + encodeURIComponent(this.searchQ.trim()));
          if (r.ok) this.searchResults = await r.json();
        },
        quickAdd() {
          if (this.searchResults.length === 1) this.addItem(this.searchResults[0]);
        },
        async openBrowse() {
          this.browseQ = '';
          this.browseResults = [];
          this.browseCategoryId = '';
          this.$refs.browseDlg.showModal();
          this.$nextTick(() => this.$refs.browseInput?.focus());
          if (!this.browseCategories.length) {
            const c = await fetch('/api/commercial/categories');
            if (c.ok) this.browseCategories = await c.json();
          }
          this.searchBrowse();
        },
        async searchBrowse() {
          // scope=sellable: sem isto a listagem sem busca cai em listTopLevel(), que
          // descarta as variantes filhas — a comanda não conseguia lançar nenhum item
          // de produto com grade. Ver a mesma correção no PDV.
          const qs = this.browseQ.trim()
            ? '?q=' + encodeURIComponent(this.browseQ.trim())
            : '?scope=sellable';
          const r = await fetch('/api/commercial/products' + qs);
          if (r.ok) this.browseResults = await r.json();
        },
        browseFiltered() {
          if (!this.browseCategoryId) return this.browseResults;
          return this.browseResults.filter((p) => p.category_id === this.browseCategoryId);
        },
        isFractionalUnit(unit) { return ['kg','g','L','ml'].includes(String(unit||'').trim()); },
        parseQty(v) { const n = Number(String(v).replace(',', '.')); return isNaN(n) ? NaN : n; },
        async addItem(p) {
          const rawQty = this.parseQty(this.pendingQtyRaw);
          let qty = Math.max(0.001, (!isNaN(rawQty) && rawQty>0 ? rawQty : 1));
          if (!this.isFractionalUnit(p.unit) && qty % 1 !== 0) { qty = Math.round(qty); showToast('Ajustado para '+qty+' — unidade "'+(p.unit||'un')+'" só aceita inteiro.', 'info'); this.pendingQty = qty; this.pendingQtyRaw = String(qty); }
          const notes = this.itemNotes.trim();
          try {
            const cr = await fetch('/api/commercial/products/' + p.id + '/complement-groups');
            const groups = cr.ok ? await cr.json() : [];
            if (groups.length) { this.openComplementDlg(p, groups); return; }
          } catch {}
          const r = await fetch('/api/comandas/comandas/' + this.comandaId + '/items', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId: p.id, qty, ...(notes ? { notes } : {}) }),
          });
          if (r.ok) { this.searchQ = ''; this.itemNotes = ''; this.searchResults = []; this.pendingQty = 1; this.pendingQtyRaw = '1'; await this.load(); this.$refs.searchInput?.focus(); showToast(`${p.name} adicionado.`, 'success'); }
          else showToast((await r.json().catch(()=>({}))).error ?? 'Erro ao adicionar item.', 'error');
        },
        openComplementDlg(product, groups) {
          this.complementDlg.product = product;
          this.complementDlg.groups = groups;
          this.complementDlg.selections = {};
          this.complementDlg.mainNotes = this.itemNotes.trim();
          this.complementDlg.errors = {};
          for (const g of groups) {
            this.complementDlg.selections[g.group_id] = [];
            if (typeof g.items === 'string') { try { g.items = JSON.parse(g.items); } catch { g.items = []; } }
          }
          this.$refs.complementDlg.showModal();
        },
        toggleComplement(groupId, item) {
          const sel = this.complementDlg.selections[groupId];
          const g = this.complementDlg.groups.find(gr=>gr.group_id===groupId);
          const idx = sel.findIndex(s=>s.product_id===item.product_id);
          if (idx>=0) sel.splice(idx,1);
          else { if (g && g.max_select===1) sel.length=0; sel.push({ ...item, qty:1 }); }
        },
        complementQty(groupId, productId, delta) {
          const sel = this.complementDlg.selections[groupId].find(s=>s.product_id===productId);
          if (!sel) return;
          sel.qty = Math.max(1, (sel.qty||1)+delta);
        },
        validateComplementSelection() {
          let ok=true; this.complementDlg.errors={};
          for (const g of this.complementDlg.groups) {
            const sel=this.complementDlg.selections[g.group_id]||[];
            const total=sel.reduce((a,i)=>a+(i.qty||1),0);
            if (g.min_select>0 && total<g.min_select) { this.complementDlg.errors[g.group_id]=`Selecione ao menos ${g.min_select} opção(ões).`; ok=false; }
            if (g.max_select!=null && total>g.max_select) { this.complementDlg.errors[g.group_id]=`Máximo de ${g.max_select} excedido.`; ok=false; }
          }
          return ok;
        },
        async confirmComplementSelection() {
          if (!this.validateComplementSelection()) return;
          const p=this.complementDlg.product;
          const notes=this.complementDlg.mainNotes || this.itemNotes.trim() || null;
          const rawQ=this.parseQty(this.pendingQtyRaw);
          const qty=Math.max(0.001, (!isNaN(rawQ) && rawQ>0 ? rawQ : 1));
          if (!this.isFractionalUnit(p.unit) && qty % 1 !== 0) { qty = Math.round(qty); }
          const lineGroupUuid = window.crypto?.randomUUID?.() || (Date.now()+'-'+Math.random());
          const post = async (productId, q, uuid) => {
            const r=await fetch('/api/comandas/comandas/'+this.comandaId+'/items', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ productId, qty:q, ...(notes?{notes}:{}), ...(uuid?{lineGroupUuid:uuid}:{}) }) });
            if (!r.ok) throw new Error((await r.json().catch(()=>({}))).error || 'Erro ao adicionar');
          };
          try {
            await post(p.id, qty, lineGroupUuid);
            for (const g of this.complementDlg.groups) {
              for (const sel of (this.complementDlg.selections[g.group_id]||[])) {
                await post(sel.product_id, sel.qty||1, lineGroupUuid);
              }
            }
            this.$refs.complementDlg.close();
            this.searchQ=''; this.itemNotes=''; this.searchResults=[];
            this.pendingQty = 1; this.pendingQtyRaw = '1';
            await this.load(); showToast(`${p.name} adicionado com complementos.`, 'success');
          } catch(e) { showToast(e.message || 'Erro ao adicionar complementos.', 'error'); }
        },
        async changeItemQty(item, dir) {
          const cur = Number(item.qty) || 0;
          const fractional = this.isFractionalUnit(item.unit);
          let step = 1;
          if (fractional) {
            if (cur < 1) step = cur % 0.5 !== 0 ? 0.1 : 0.5;
            else step = cur % 1 !== 0 ? 0.5 : 1;
          }
          // unidade inteira nunca fraciona: - em 1 não vai para 0.5
          let newQty = cur + (dir > 0 ? step : -step);
          if (!fractional) newQty = Math.round(newQty);
          if (newQty < (fractional ? 0.001 : 1)) newQty = fractional ? 0.001 : 1;
          if (fractional) newQty = Math.round(newQty * 1000) / 1000;
          await this.updateItemQty(item, newQty);
        },
        async onQtyInput(item) {
          const v = Number(item.qty);
          if (!Number.isFinite(v) || !(v > 0)) { showToast('Quantidade deve ser positiva.', 'error'); await this.load(); return; }
          const fractional = this.isFractionalUnit(item.unit);
          if (!fractional && !Number.isInteger(v)) { showToast('Produto com unidade "'+(item.unit||'un')+'" só aceita quantidade inteira.', 'error'); await this.load(); return; }
          await this.updateItemQty(item, v);
        },
        async updateItemQty(item, qty) {
          const r = await fetch('/api/comandas/comandas/' + this.comandaId + '/items/' + item.id + '/qty', {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ qty })
          });
          if (r.ok) await this.load();
          else showToast((await r.json().catch(()=>({}))).error ?? 'Erro ao alterar quantidade.', 'error');
        },
        openNotes(item) {
          this.notesItemId = item.id;
          this.notesItemName = (item.qty % 1 === 0 ? item.qty : item.qty.toFixed(3)) + 'x ' + item.product_name;
          this.notesDraft = item.notes || '';
          this.$refs.notesDlg.showModal();
          this.$nextTick(() => this.$refs.notesInput?.focus());
        },
        async salvarObs() {
          if (this.salvandoObs || !this.notesItemId) return;
          this.salvandoObs = true;
          try {
            const r = await fetch(`/api/comandas/comandas/${this.comandaId}/items/${this.notesItemId}/notes`, {
              method: 'PUT', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ notes: this.notesDraft }),
            });
            if (!r.ok) {
              const b = await r.json().catch(() => null);
              showToast((b && b.error) || 'Erro ao salvar observação.', 'error');
              return;
            }
            const tinhaObs = !!this.notesDraft.trim();
            this.$refs.notesDlg.close();
            await this.load();
            showToast(tinhaObs ? 'Observação salva — vai para a cozinha no "Enviar p/ cozinha".' : 'Observação removida.', 'success');
          } catch {
            showToast('Sem conexão com o Kivo. Tente de novo.', 'error');
          } finally {
            this.salvandoObs = false;
          }
        },
        async enviarCozinha() {
          this.enviandoCozinha = true;
          try {
            const r = await fetch(`/api/comandas/comandas/${this.comandaId}/enviar-cozinha`, { method: 'POST' });
            if (!r.ok) {
              const b = await r.json().catch(() => null);
              showToast((b && b.error) || 'Não foi possível enviar para a cozinha.', 'error');
              return;
            }
            // Envelope global: { success, data: { sent, estimatedMinutes } }
            const body = await r.json().catch(() => null);
            const sent = Number(body?.data?.sent ?? 0);
            const min = Number(body?.data?.estimatedMinutes ?? 0);
            if (sent > 0) {
              const itens = sent === 1 ? '1 item enviado para a cozinha' : `${sent} itens enviados para a cozinha`;
              showToast(min > 0 ? `${itens} — pronto em ~${min} min.` : `${itens}.`, 'success');
            } else {
              showToast('Nada novo para a cozinha — itens já enviados ou que não são da cozinha.', 'info');
            }
          } catch {
            showToast('Sem conexão com o Kivo. Tente de novo.', 'error');
          } finally {
            this.enviandoCozinha = false;
          }
        },
        async voidItem(itemId, idx) {
          if (!await window.confirmDlg('Remover ' + this.items[idx].product_name + ' da comanda?')) return;
          const r = await fetch('/api/comandas/comandas/' + this.comandaId + '/items/' + itemId, { method: 'DELETE' });
          if (r.ok) { await this.load(); showToast('Item removido.', 'success'); }
          else showToast((await r.json()).error ?? 'Erro ao remover item.', 'error');
        },
        async openTransferDlg() {
          this.transferTarget = null; this.dlgError = '';
          const r = await fetch('/api/comandas/tables/status');
          if (r.ok) this.availableTables = (await r.json()).filter((t) => t.status === 'livre');
          this.$refs.transferDlg.showModal();
        },
        async confirmTransfer() {
          if (!this.transferTarget) return;
          const r = await fetch('/api/comandas/comandas/' + this.comandaId + '/transfer', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tableId: this.transferTarget }),
          });
          if (!r.ok) { this.dlgError = (await r.json()).error ?? 'Erro ao transferir.'; showToast(this.dlgError, 'error'); return; }
          this.$refs.transferDlg.close();
          await this.load();
        },
        openSplitDlg() {
          this.splitItemIds = []; this.dlgError = '';
          this.$refs.splitDlg.showModal();
        },
        async confirmSplit() {
          if (!this.splitItemIds.length) return;
          const r = await fetch('/api/comandas/comandas/' + this.comandaId + '/split', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ itemIds: this.splitItemIds }),
          });
          if (!r.ok) { this.dlgError = (await r.json()).error ?? 'Erro ao dividir.'; showToast(this.dlgError, 'error'); return; }
          const data = await r.json();
          this.$refs.splitDlg.close();
          window.location.href = '/app/comandas/mesas/' + data.newComandaId;
        },
        async openMergeDlg() {
          this.mergeSourceId = null; this.dlgError = '';
          const r = await fetch('/api/comandas/comandas?status=aberta');
          if (r.ok) this.otherComandas = (await r.json()).filter((c) => c.id !== this.comandaId);
          this.$refs.mergeDlg.showModal();
        },
        async confirmMerge() {
          if (!this.mergeSourceId) return;
          const r = await fetch('/api/comandas/comandas/' + this.comandaId + '/merge', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sourceComandaId: this.mergeSourceId }),
          });
          if (!r.ok) { this.dlgError = (await r.json()).error ?? 'Erro ao unir.'; showToast(this.dlgError, 'error'); return; }
          this.$refs.mergeDlg.close();
          await this.load();
        },
        openCloseDlg() { this.$refs.closeDlg.showModal(); },
        // O servidor é a fonte da verdade: o caixa pode ter fechado a conta de outro
        // aparelho enquanto esta tela estava aberta.
        get prontaParaPagamento() {
          return !!(this.comanda && this.comanda.ready_for_payment_at);
        },
        async chamarCaixa() {
          this.chamandoCaixa = true;
          try {
            const r = await fetch(`/api/comandas/comandas/${this.comandaId}/ready-for-payment`, {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ pronta: true }),
            });
            if (!r.ok) {
              const b = await r.json().catch(() => null);
              showToast((b && b.error) || 'Não foi possível avisar o caixa.', 'error');
              return;
            }
            await this.load();
            showToast('Caixa avisado — leve a comanda para o cliente pagar.', 'success');
          } catch (e) {
            showToast('Sem conexão com o Kivo. Tente de novo.', 'error');
          } finally {
            this.chamandoCaixa = false;
          }
        },
        confirmClose() {
          this.$refs.closeDlg.close();
          window.location.href = '/app/store/pdv?comandaId=' + this.comandaId;
        },
        async cancelComanda() {
          if (!await window.confirmDlg('Cancelar esta comanda? Os itens serão perdidos.')) return;
          const r = await fetch('/api/comandas/comandas/' + this.comandaId + '/cancel', { method: 'POST' });
          if (r.ok) window.location.href = '/app/comandas/mesas';
          else showToast((await r.json()).error ?? 'Erro ao cancelar.', 'error');
        },
      };
    }
  </script>
</body>
</html>
