<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <%- include('partials/theme-init') %>
  <title>Kivo — <%= comandasLabels.plural %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg" />
  <link rel="stylesheet" href="/css/app.css" />
  <script nonce="<%= cspNonce %>" src="/js/datetime.js"></script>
  <script nonce="<%= cspNonce %>" defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <%- include('partials/nav', { user, page: '/app/comandas/mesas' }) %>
  <%# O JSON.stringify dos rótulos é escapado de propósito: as aspas viram entidades
      e não fecham o atributo x-data. Sem isso o HTML cortava o x-data no primeiro ",
      o Alpine não montava o componente e nenhum botão da página funcionava
      (inclusive o "Nova mesa"/"Novo balcão"). %>
  <main x-data="mesasPage(<%- JSON.stringify(user.permissions.has('comandas.tables.manage')) %>, <%= JSON.stringify(comandasLabels) %>)" x-init="init()">
    <h1><%= comandasLabels.plural %></h1>
    <div class="toolbar">
      <% if (user.permissions.has('comandas.tables.manage')) { %>
      <button class="btn" @click="openNew()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        <%= comandasLabels.novo %>
      </button>
      <% } %>
      <%# Som de "pedido pronto": quando a cozinha marca um pedido pronto, a grade toca
          um som e pisca a mesa — aviso pro garçom levar sem ficar olhando o painel.
          Fica no aparelho (localStorage), como o som de novo pedido do painel. %>
      <button type="button" class="icon-btn mesas-som-btn" :class="somProntoAtivo ? 'mesas-som-on' : ''"
              @click="toggleSomPronto()"
              :title="somProntoAtivo ? 'Desligar o som de pedido pronto' : 'Ligar o som de pedido pronto'"
              aria-label="Som de pedido pronto">
        <svg x-show="somProntoAtivo" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
        <svg x-show="!somProntoAtivo" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
      </button>
      <span class="error" x-text="error"></span>
      <div class="mesas-tools">
        <button type="button" class="icon-btn" @click="openHistory()"
                title="Histórico de abertura, fechamento e itens"
                aria-label="Histórico de abertura, fechamento e itens">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </button>
        <% if (user.permissions.has('comandas.tables.manage')) { %>
        <button type="button" class="icon-btn" @click="openGenerate()"
                title="Configurar: gerar <%= comandasLabels.plural.toLowerCase() %> em sequência"
                aria-label="Configurar geração de <%= comandasLabels.plural.toLowerCase() %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
        <% } %>
      </div>
    </div>

    <div class="tables-grid" x-ref="grid" x-show="tables.length">
      <template x-for="t in tables" :key="t.id">
        <div class="table-card"
             :data-id="t.id"
             :class="[t.status === 'livre' ? 'table-livre' : 'table-ocupada', t.ready_for_payment_at ? 'table-quer-pagar' : '', kitchenReady(t) ? 'table-pedido-pronto' : '', flashReady(t) ? 'table-pronto-flash' : '', canManage ? 'drag-enabled' : '', dragId === t.id ? 'dragging' : '', dropOverId === t.id ? 'drop-target' : '']"
             @pointerdown="onCardPointerDown($event, t)">
          <% if (user.permissions.has('comandas.tables.manage')) { %>
          <button type="button" class="icon-btn table-remove" x-show="t.status === 'livre'"
                  @pointerdown.stop @click.stop="removeTable(t)" title="<%= comandasLabels.removerTitulo %>">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </button>
          <% } %>
          <button type="button" class="table-card-body" @click="openTable(t)"
                  :title="t.label + ' — ' + (t.ready_for_payment_at ? 'Quer pagar' : (t.status === 'livre' ? 'Livre' : 'Ocupada'))">
            <div class="table-icon">
              <% if (comandasLabels.rotulo === 'balcao') { %>
              <%# No modo balcão não existe mesa: o mesmo ícone de balcão do menu/cards. %>
              <%- svgIcon('counter', 26, 26) %>
              <% } else { %>
              <template x-if="t.status === 'livre'">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
              </template>
              <template x-if="t.status === 'ocupada'">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </template>
              <% } %>
            </div>
            <div class="table-label" x-text="t.label"></div>
            <%# "Pedido pronto" (a cozinha marcou — selo verde) e "Quer pagar" (o garçom
                chamou o caixa — selo azul) são avisos independentes: os dois podem
                aparecer juntos. Sem eles, o selo é o estado da mesa (Livre/Ocupada). %>
            <template x-if="kitchenReady(t)">
              <span class="badge pedido-pronto">Pedido pronto</span>
            </template>
            <template x-if="t.ready_for_payment_at">
              <span class="badge quer-pagar">Quer pagar</span>
            </template>
            <template x-if="!kitchenReady(t) && !t.ready_for_payment_at">
              <span class="badge" :class="t.status === 'livre' ? 'ok' : 'off'" x-text="t.status === 'livre' ? 'Livre' : 'Ocupada'"></span>
            </template>
          </button>
        </div>
      </template>
    </div>

    <div x-show="!tables.length" x-cloak>
      <%- include('partials/empty-state', { message: comandasLabels.vazia }) %>
    </div>

    <dialog x-ref="addTableDlg">
      <h1><%= comandasLabels.novoDialogo %></h1>
      <label>Nome ou número</label>
      <input type="text" x-ref="tableInput" x-model="newTableLabel" placeholder="<%= comandasLabels.placeholder %>"
             @keydown.enter.prevent="createTable" />
      <div class="error" x-text="dlgError"></div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="$refs.addTableDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button type="button" class="btn" @click="createTable()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Criar
        </button>
      </div>
    </dialog>

    <dialog x-ref="generateDlg">
      <h1>Gerar <%= comandasLabels.plural.toLowerCase() %> em sequência</h1>
      <p class="muted" style="margin:.25rem 0 .5rem">
        Cria várias de uma vez seguindo a numeração dos nomes. Números que já existem são pulados.
      </p>
      <label>Nome base</label>
      <input type="text" x-ref="genBase" x-model="gen.base"
             placeholder="<%= comandasLabels.rotulo === 'balcao' ? 'Balcão' : 'Mesa' %>"
             @keydown.enter.prevent="generateTables()" />
      <div class="gen-grid">
        <div>
          <label>Primeiro número</label>
          <input type="number" min="1" max="1000000" x-model.number="gen.start" placeholder="Automático"
                 @keydown.enter.prevent="generateTables()" />
        </div>
        <div>
          <label>Quantidade</label>
          <input type="number" min="1" max="200" x-model.number="gen.count"
                 @keydown.enter.prevent="generateTables()" />
        </div>
      </div>
      <label>Zeros à esquerda</label>
      <select x-model.number="gen.pad">
        <option value="0">Sem zeros (1, 2, 3)</option>
        <option value="2">2 dígitos (01, 02, 03)</option>
        <option value="3">3 dígitos (001, 002)</option>
        <option value="4">4 dígitos (0001, 0002)</option>
      </select>
      <div class="gen-preview">
        <span class="muted">Prévia:</span> <strong x-text="generatePreview()"></strong>
        <div class="muted" style="font-size:.8rem;margin-top:.2rem"
             x-show="gen.start === '' || gen.start == null">
          Sem o primeiro número, a sequência continua a partir da maior numeração já cadastrada.
        </div>
      </div>
      <div class="error" x-text="genError"></div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="$refs.generateDlg.close()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
          Cancelar
        </button>
        <button type="button" class="btn" @click="generateTables()" :disabled="generating">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          <span x-text="generating ? 'Gerando…' : 'Gerar'"></span>
        </button>
      </div>
    </dialog>

    <dialog x-ref="historyDlg" class="mesas-dialog-wide">
      <h1>Histórico de <%= comandasLabels.plural.toLowerCase() %></h1>
      <div class="hist-filters">
        <div style="flex:1;min-width:180px">
          <label for="hist-table">Filtrar por <%= comandasLabels.singular %></label>
          <select id="hist-table" x-model="history.tableId" @change="loadHistory()">
            <option value="">Todas</option>
            <template x-for="t in tables" :key="t.id">
              <option :value="String(t.id)" x-text="t.label"></option>
            </template>
          </select>
        </div>
        <button type="button" class="btn secondary small" @click="loadHistory()" :disabled="history.loading">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-9 9 9 9 0 0 1-9-9 9 9 0 0 1 9-9"/><path d="M21 3v6h-6"/></svg>
          Atualizar
        </button>
      </div>
      <div class="error" x-text="history.error"></div>
      <div class="hist-empty" x-show="history.loading">Carregando histórico…</div>
      <div class="hist-empty" x-show="!history.loading && !history.error && !history.sessions.length">
        Nenhum registro de abertura ou fechamento encontrado.
      </div>
      <div class="hist-list" x-show="!history.loading && history.sessions.length">
        <template x-for="s in history.sessions" :key="s.comanda_id">
          <details class="hist-session">
            <summary>
              <span class="hist-session-table" x-text="s.table_label || 'Sem <%= comandasLabels.singular %>'"></span>
              <span class="badge" :class="statusClass(s.status)" x-text="statusLabel(s.status)"></span>
              <span class="muted" style="font-size:.78rem" x-text="'#' + s.comanda_id"></span>
              <span class="hist-session-period" x-text="sessionPeriod(s)"></span>
              <span class="hist-session-total" x-text="brl(s.total_cents)"></span>
            </summary>
            <div class="hist-body">
              <div class="hist-meta">
                <span>
                  <strong>Aberta</strong>
                  <span x-text="'em ' + fmtDateTime(s.opened_at)"></span>
                  <span x-show="s.opened_by" x-text="'por ' + s.opened_by"></span>
                </span>
                <span x-show="s.status !== 'aberta'">
                  <strong x-text="s.status === 'cancelada' ? 'Cancelada' : 'Fechada'"></strong>
                  <span x-text="'em ' + fmtDateTime(s.closed_at)"></span>
                  <span x-show="s.closed_by" x-text="'por ' + s.closed_by"></span>
                </span>
              </div>
              <div x-show="s.status === 'cancelada'" class="muted" style="font-size:.8rem;margin-top:.25rem">
                Comanda cancelada: os itens abaixo não foram vendidos.
              </div>
              <div class="hist-section">Itens (<span x-text="s.items.length"></span>)</div>
              <div x-show="!s.items.length" class="muted" style="font-size:.85rem">Nenhum item lançado.</div>
              <template x-for="it in s.items" :key="it.id">
                <div class="hist-item" :class="it.voided ? 'voided' : ''">
                  <span class="hist-item-name" x-text="qtyText(it.qty) + '× ' + it.product_name"></span>
                  <span class="hist-item-meta" x-text="itemMeta(it)"></span>
                  <span class="hist-item-value" x-text="brl(it.total_cents)"></span>
                </div>
              </template>
              <div class="hist-totals">
                <span>
                  <span x-text="s.status === 'cancelada' ? 'Total cancelado' : 'Total dos itens'"></span>:
                  <strong x-text="brl(s.status === 'cancelada' ? s.items_total_cents : s.total_cents)"
                          :style="s.status === 'cancelada' ? 'color:var(--danger)' : ''"></strong>
                </span>
                <span x-show="s.voided_total_cents > 0" style="color:var(--danger)">
                  Itens anulados: <strong x-text="brl(s.voided_total_cents)"></strong>
                </span>
                <span x-show="s.sale_id" class="muted" x-text="'Venda #' + s.sale_id"></span>
              </div>
              <div class="hist-section">Linha do tempo</div>
              <div x-show="!s.events.length" class="muted" style="font-size:.85rem">
                Sem eventos de auditoria para este período.
              </div>
              <ul class="hist-events">
                <template x-for="ev in s.events" :key="ev.id">
                  <li>
                    <span class="hist-ev-time" x-text="fmtDateTime(ev.at)"></span>
                    <span class="hist-ev-user" x-text="ev.username || 'sistema'"></span>
                    <span x-text="ev.label"></span>
                    <span class="hist-ev-detail" x-text="ev.detail"></span>
                  </li>
                </template>
              </ul>
            </div>
          </details>
        </template>
      </div>
      <div class="actions">
        <button type="button" class="btn secondary" @click="$refs.historyDlg.close()">Fechar</button>
      </div>
    </dialog>
  </main>
  <style>
    /* Verde de "pedido pronto": nem o vermelho de ocupada, nem o laranja de quer pagar. */
    :root { --mesa-pronto: #16a34a; --mesa-pronto-bg: color-mix(in srgb, #16a34a 13%, transparent); }
    :root[data-theme="dark"] { --mesa-pronto: #4ade80; --mesa-pronto-bg: color-mix(in srgb, #4ade80 15%, transparent); }
    .tables-grid {
      display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem;
    }
    @media (max-width: 1200px) { .tables-grid { grid-template-columns: repeat(4, 1fr); } }
    @media (max-width: 900px)  { .tables-grid { grid-template-columns: repeat(3, 1fr); } }
    .table-card {
      position: relative;
      background: var(--surface); border: 1.5px solid var(--border-light); border-radius: var(--radius-lg);
      box-shadow: var(--shadow-xs);
      transition: border-color var(--transition), box-shadow var(--transition), transform .15s ease;
    }
    .table-card.drag-enabled { cursor: grab; touch-action: manipulation; }
    .table-card.drag-enabled:active { cursor: grabbing; }
    .table-card.dragging {
      position: fixed; top: 0; left: 0; z-index: 60; margin: 0;
      cursor: grabbing; pointer-events: none;
      box-shadow: 0 20px 40px rgba(0,0,0,.28);
      transition: box-shadow .15s ease;
    }
    .table-card.drop-target {
      outline: 2px dashed var(--primary); outline-offset: 3px;
      transition: outline-color .15s ease;
    }
    .table-card.table-livre:hover { border-color: var(--primary); box-shadow: 0 8px 24px color-mix(in srgb, var(--primary) 16%, transparent); }
    .table-card.table-ocupada:hover { border-color: var(--danger); box-shadow: 0 8px 24px color-mix(in srgb, var(--danger) 16%, transparent); }
    .table-card.table-ocupada { background: var(--danger-bg); }
    /* Mesa com pedido pronto (a cozinha marcou): o garçom precisa achar de longe que
       tem coisa para levar. Regras vêm ANTES do quer-pagar — se a mesa também chamou a
       conta, o destaque azul do caixa prevalece e o selo verde segue no card. */
    .table-card.table-pedido-pronto {
      background: var(--mesa-pronto-bg);
      border-color: var(--mesa-pronto);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--mesa-pronto) 35%, transparent);
    }
    .table-card.table-pedido-pronto .table-icon { background: color-mix(in srgb, var(--mesa-pronto) 18%, transparent); color: var(--mesa-pronto); }
    .badge.pedido-pronto { background: var(--mesa-pronto); color: #fff; font-weight: 700; }
    /* Recém-pronto: pulso por alguns segundos pra chamar o olho; some sozinho (a classe
       é removida no JS ~8s depois de detectar a virada pra pronto). */
    .table-card.table-pedido-pronto.table-pronto-flash { animation: mesa-pronto-pulse 1.1s ease-in-out 4; }
    @keyframes mesa-pronto-pulse {
      0%, 100% { box-shadow: 0 0 0 2px color-mix(in srgb, var(--mesa-pronto) 35%, transparent); }
      50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--mesa-pronto) 55%, transparent); }
    }
    .mesas-som-btn { color: var(--text-muted); }
    .mesas-som-btn:hover { color: var(--text); }
    .mesas-som-btn.mesas-som-on { color: var(--mesa-pronto); }
    /* Mesa que chamou a conta: destaque próprio para o caixa achar de longe, sem se
       confundir com o vermelho de "ocupada" — são estados diferentes. */
    .table-card.table-quer-pagar {
      background: var(--primary-bg);
      border-color: var(--primary);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 30%, transparent);
    }
    .table-card.table-quer-pagar .table-icon { background: color-mix(in srgb, var(--primary) 18%, transparent); color: var(--primary); }
    .badge.quer-pagar { background: var(--primary); color: #fff; font-weight: 700; }
    .table-card-body {
      width: 100%; background: none; border: 0; cursor: pointer; font: inherit; color: inherit;
      display: flex; flex-direction: column; align-items: center; gap: .5rem;
      padding: 1.4rem 1rem 1.1rem;
      transition: transform var(--transition);
    }
    .table-card-body:active { transform: scale(.97); }
    .table-icon {
      width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
      color: var(--primary);
    }
    .table-livre .table-icon { background: var(--primary-bg); color: var(--primary); }
    .table-ocupada .table-icon { background: color-mix(in srgb, var(--danger) 16%, transparent); color: var(--danger); }
    .table-label { font-size: 1.05rem; font-weight: 700; }
    .table-remove {
      position: absolute; top: .4rem; right: .4rem; z-index: 1;
      width: 30px; height: 30px;
      background: var(--surface); box-shadow: var(--shadow-xs);
      opacity: 0; transition: opacity var(--transition), background var(--transition), color var(--transition);
    }
    .table-card:hover .table-remove { opacity: 1; }
    .table-remove:hover { background: var(--danger-bg); color: var(--danger); }

    /* ─── Engrenagem e relógio: alinhados à direita, longe do "Nova mesa" ─── */
    .mesas-tools { margin-left: auto; display: flex; align-items: center; gap: .35rem; }
    .mesas-tools .icon-btn { color: var(--text-muted); }
    .mesas-tools .icon-btn:hover { color: var(--text); }

    /* ─── Geração em lote ─── */
    .gen-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
    .gen-preview {
      margin: .85rem 0 .25rem; padding: .65rem .75rem; border-radius: 10px;
      background: var(--surface-hover); border: 1px solid var(--border-light);
      font-size: .88rem;
    }

    /* ─── Histórico ─── */
    dialog.mesas-dialog-wide { width: min(820px, calc(100vw - 2rem)); }
    .hist-filters { display: flex; gap: .6rem; align-items: flex-end; flex-wrap: wrap; }
    .hist-filters label { margin-top: .2rem; }
    .hist-list { display: flex; flex-direction: column; gap: .55rem; margin: .85rem 0; }
    .hist-session {
      border: 1.5px solid var(--border-light); border-radius: 10px; background: var(--surface);
    }
    .hist-session > summary {
      display: flex; gap: .55rem; align-items: center; flex-wrap: wrap;
      padding: .7rem .8rem; cursor: pointer; list-style: none;
    }
    .hist-session > summary::-webkit-details-marker { display: none; }
    .hist-session[open] > summary { border-bottom: 1px solid var(--border-light); }
    .hist-session-table { font-weight: 700; }
    .hist-session-period { color: var(--text-muted); font-size: .8rem; }
    .hist-session-total { margin-left: auto; font-weight: 700; font-variant-numeric: tabular-nums; }
    .hist-body { padding: .7rem .8rem .9rem; }
    .hist-meta {
      display: flex; flex-direction: column; gap: .2rem;
      font-size: .85rem; color: var(--text-muted);
    }
    .hist-meta strong { color: var(--text); }
    .hist-section {
      font-size: .78rem; text-transform: uppercase; letter-spacing: .04em;
      color: var(--text-muted); margin: .85rem 0 .35rem;
    }
    .hist-item {
      display: flex; gap: .5rem; align-items: baseline; flex-wrap: wrap;
      padding: .32rem 0; border-bottom: 1px dashed var(--border-light);
      font-size: .9rem;
    }
    .hist-item:last-of-type { border-bottom: 0; }
    .hist-item-name { font-weight: 600; }
    .hist-item-meta { color: var(--text-muted); font-size: .78rem; }
    .hist-item-value { margin-left: auto; font-variant-numeric: tabular-nums; }
    .hist-item.voided .hist-item-name { text-decoration: line-through; color: var(--text-muted); }
    .hist-item.voided .hist-item-value { color: var(--danger); text-decoration: line-through; }
    .hist-totals {
      display: flex; gap: .85rem; flex-wrap: wrap; align-items: baseline;
      margin-top: .55rem; padding-top: .55rem; border-top: 1px solid var(--border-light);
      font-size: .88rem;
    }
    .hist-events { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .35rem; }
    .hist-events li { display: flex; gap: .45rem; flex-wrap: wrap; align-items: baseline; font-size: .85rem; }
    .hist-ev-time { color: var(--text-muted); font-variant-numeric: tabular-nums; font-size: .78rem; }
    .hist-ev-user { font-weight: 600; }
    .hist-ev-detail { color: var(--text-muted); }
    .hist-empty { padding: 1rem 0; color: var(--text-muted); }

    /* ─── Toque/mobile: sem hover, o botão de remover precisa ficar sempre visível ─── */
    @media (hover: none), (max-width: 820px) {
      .table-remove { opacity: 1; }
      .tables-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: .75rem; }
      .table-card-body { padding: 1.15rem .75rem .95rem; }
    }
    @media (max-width: 560px) {
      .gen-grid { grid-template-columns: 1fr; }
      dialog.mesas-dialog-wide { width: calc(100vw - 1.25rem); }
      .hist-session-total { margin-left: 0; }
    }
  </style>
  <script nonce="<%= cspNonce %>">
    function mesasPage(canManage, labels) {
      return {
        labels: labels,
        tables: [],
        newTableLabel: '',
        error: '', dlgError: '',
        // Geração em lote (engrenagem) e histórico (relógio).
        gen: { base: '', start: '', count: 1, pad: 0 },
        genError: '',
        generating: false,
        history: { loading: false, tableId: '', sessions: [], error: '' },
        pollTimer: null,
        canManage: !!canManage,
        dragId: null,
        dropOverId: null,
        // Som de "pedido pronto": a preferência é do APARELHO e vive no canal global
        // (partials/ready-alerts), que avisa em qualquer tela. O botão daqui só reflete e
        // alterna essa mesma chave — antes o som só existia enquanto a grade estava aberta.
        // `knownReady` continua sendo o baseline das mesas já prontas, exclusivo para
        // piscar o card (o aviso sonoro/toast agora é global).
        somProntoAtivo: localStorage.getItem('mesas-som-pronto') !== '0',
        knownReady: null,
        flashIds: [],
        eventSource: null,
        reloadTimer: null,
        onVisible: null,
        started: false,
        async init() {
          // `init()` pode ser chamado pelo Alpine e pelo x-init: sem a guarda, cada
          // chamada abriria um EventSource e um timer de poll extras.
          if (this.started) return;
          this.started = true;
          // O canal global pode ter uma preferência mais nova (menu "Mais" de outra tela).
          if (window.KivoReadyAlerts) this.somProntoAtivo = window.KivoReadyAlerts.isSoundOn();
          this.connectEvents();
          // Reserva do SSE: se a conexão cair, a grade ainda se atualiza sozinha.
          // Em aba oculta o navegador estrangula timers; ao voltar, o listener abaixo
          // recarrega na hora em vez de esperar o próximo ciclo.
          this.pollTimer = setInterval(() => { if (!document.hidden) this.load(); }, 5000);
          this.onVisible = () => { if (!document.hidden) this.load(); };
          document.addEventListener('visibilitychange', this.onVisible);
          window.addEventListener('focus', this.onVisible);
          await this.load();
        },
        connectEvents() {
          if (this.eventSource || typeof EventSource === 'undefined') return;
          try {
            this.eventSource = new EventSource('/api/comandas/tables/events');
            this.eventSource.addEventListener('tables', () => this.scheduleReload());
            // Sem tratamento no `onerror`: o EventSource reconecta sozinho e o poll cobre.
          } catch { /* navegador sem SSE: fica só o poll */ }
        },
        scheduleReload() {
          // Várias mutações seguidas (ex.: salvar a ordem gera um PUT por mesa)
          // viram uma única recarga.
          if (this.reloadTimer) return;
          this.reloadTimer = setTimeout(() => {
            this.reloadTimer = null;
            if (!document.hidden) this.load();
          }, 150);
        },
        destroy() {
          clearInterval(this.pollTimer);
          clearTimeout(this.reloadTimer);
          if (this.eventSource) this.eventSource.close();
          if (this.onVisible) {
            document.removeEventListener('visibilitychange', this.onVisible);
            window.removeEventListener('focus', this.onVisible);
          }
        },
        async load() {
          if (this.dragId !== null) return;
          const r = await fetch('/api/comandas/tables/status');
          if (!r.ok) { window.handleApiError(r, await r.json().catch(() => ({})), 'Erro ao carregar ' + this.labels.plural.toLowerCase() + '.'); return; }
          const next = await r.json();
          // Detecta mesas que ACABARAM de ficar com pedido pronto para piscar o card. O
          // som/toast fica no canal global; aqui é só o destaque visual da grade.
          const agora = new Set(next.filter((t) => this.kitchenReady(t)).map((t) => t.id));
          const novos = this.knownReady !== null ? [...agora].filter((id) => !this.knownReady.has(id)) : [...agora];
          this.knownReady = agora;
          if (novos.length) {
            // Pisca o card sempre (inclusive ao abrir a tela já com pedido pronto). O som
            // e o toast da virada são do canal global, que também alcança as outras telas
            // e a aba em segundo plano — aqui só fica o destaque visual da grade.
            this.flashTables(novos);
          }
          this.tables = next;
        },
        kitchenReady(t) { return (t.kitchen_ready_count || 0) > 0; },
        flashReady(t) { return this.flashIds.includes(t.id); },
        flashTables(ids) {
          ids.forEach((id) => {
            if (!this.flashIds.includes(id)) this.flashIds.push(id);
            setTimeout(() => { this.flashIds = this.flashIds.filter((x) => x !== id); }, 8000);
          });
        },
        toggleSomPronto() {
          if (window.KivoReadyAlerts) {
            this.somProntoAtivo = window.KivoReadyAlerts.toggleSound();
            return;
          }
          // Reserva se o partial global não tiver carregado (não deveria acontecer).
          this.somProntoAtivo = !this.somProntoAtivo;
          localStorage.setItem('mesas-som-pronto', this.somProntoAtivo ? '1' : '0');
          if (this.somProntoAtivo) showToast('Som de pedido pronto ativado.', 'success');
          else showToast('Som de pedido pronto desligado.', 'info');
        },
        onCardPointerDown(e, t) {
          if (!this.canManage || e.pointerType === 'mouse' && e.button !== 0) return;
          const card = e.currentTarget;
          /* Um arraste que não gerou clique deixa o supressor armado; sem desarmá-lo
             aqui, ele engoliria este novo toque no mesmo card. */
          if (card._dragClickSuppressor) {
            card.removeEventListener('click', card._dragClickSuppressor, { capture: true });
            card._dragClickSuppressor = null;
          }
          const startX = e.clientX, startY = e.clientY;
          const rect = card.getBoundingClientRect();
          let dragging = false;

          const suppressClick = (ev) => { ev.preventDefault(); ev.stopPropagation(); };

          const activate = () => {
            dragging = true;
            this.dragId = t.id;
            card.style.width = rect.width + 'px';
            card.style.height = rect.height + 'px';
            card.style.left = rect.left + 'px';
            card.style.top = rect.top + 'px';
            try { card.setPointerCapture(e.pointerId); } catch {}
            card._dragClickSuppressor = suppressClick;
            card.addEventListener('click', suppressClick, { capture: true, once: true });
            if (navigator.vibrate) navigator.vibrate(12);
          };

          const timer = setTimeout(activate, 260);

          const onMove = (ev) => {
            const dx = ev.clientX - startX, dy = ev.clientY - startY;
            if (!dragging) {
              if (Math.hypot(dx, dy) > 8) cleanup();
              return;
            }
            ev.preventDefault();
            card.style.transform = `translate(${dx}px, ${dy}px) scale(1.04)`;
            const under = document.elementFromPoint(ev.clientX, ev.clientY)?.closest('.table-card');
            this.dropOverId = under && under !== card ? Number(under.dataset.id) : null;
          };
          /* O dedo rola a grade normalmente até o toque longo virar arraste. Só então
             a rolagem é cancelada — daí em diante o card precisa acompanhar o dedo. */
          const onTouchMove = (ev) => {
            if (dragging) ev.preventDefault();
          };
          /* No toque, o menu de contexto (abrir em nova aba etc.) aparece no meio do
             toque longo e atrapalha o arraste. No mouse continua intacto. */
          const blockContextMenu = (ev) => { ev.preventDefault(); };
          if (e.pointerType !== 'mouse') window.addEventListener('contextmenu', blockContextMenu);
          const onUp = () => {
            cleanup();
            if (dragging) this.finishDrag(t, card);
          };
          /* O navegador tomou o gesto para rolar a página: não reordena, só devolve o card. */
          const onCancel = () => {
            card.removeEventListener('click', suppressClick, { capture: true });
            card._dragClickSuppressor = null;
            cleanup();
            if (dragging) {
              card.removeAttribute('style');
              this.dragId = null;
              this.dropOverId = null;
            }
          };
          const cleanup = () => {
            clearTimeout(timer);
            window.removeEventListener('pointermove', onMove);
            window.removeEventListener('pointerup', onUp);
            window.removeEventListener('pointercancel', onCancel);
            window.removeEventListener('touchmove', onTouchMove);
            window.removeEventListener('contextmenu', blockContextMenu);
          };

          window.addEventListener('pointermove', onMove);
          window.addEventListener('pointerup', onUp);
          window.addEventListener('pointercancel', onCancel);
          window.addEventListener('touchmove', onTouchMove, { passive: false });
        },
        finishDrag(t, card) {
          card.removeAttribute('style');
          this.dragId = null;
          const overId = this.dropOverId;
          this.dropOverId = null;
          const fromIdx = this.tables.findIndex((x) => x.id === t.id);
          const toIdx = overId != null ? this.tables.findIndex((x) => x.id === overId) : -1;
          if (fromIdx === -1 || toIdx === -1 || fromIdx === toIdx) return;
          this.reorder(fromIdx, toIdx);
        },
        async reorder(fromIdx, toIdx) {
          const grid = this.$refs.grid;
          const before = new Map();
          grid.querySelectorAll('.table-card').forEach((el) => before.set(el.dataset.id, el.getBoundingClientRect()));

          const [moved] = this.tables.splice(fromIdx, 1);
          this.tables.splice(toIdx, 0, moved);
          await this.$nextTick();

          grid.querySelectorAll('.table-card').forEach((el) => {
            const prev = before.get(el.dataset.id);
            if (!prev) return;
            const next = el.getBoundingClientRect();
            const dx = prev.left - next.left, dy = prev.top - next.top;
            if (!dx && !dy) return;
            el.style.transition = 'none';
            el.style.transform = `translate(${dx}px, ${dy}px)`;
            requestAnimationFrame(() => {
              el.style.transition = 'transform .32s cubic-bezier(.2,.8,.2,1)';
              el.style.transform = '';
            });
          });

          const updates = this.tables.map((tb, i) => ({ id: tb.id, sortOrder: i }));
          const results = await Promise.allSettled(updates.map((u) => fetch('/api/comandas/tables/' + u.id, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sortOrder: u.sortOrder }),
          })));
          if (results.some((r) => r.status === 'rejected' || !r.value.ok)) {
            showToast('Erro ao salvar nova ordem.', 'error');
          }
        },
        async openTable(t) {
          this.error = '';
          if (t.status === 'ocupada') {
            // O status já traz a comanda aberta da mesa; a busca na lista completa
            // continua como plano B para uma grade carregada antes desta versão.
            if (t.comanda_id) { window.location.href = '/app/comandas/mesas/' + t.comanda_id; return; }
            const r = await fetch('/api/comandas/comandas?status=aberta');
            if (!r.ok) return;
            const list = await r.json();
            const c = list.find((c) => c.table_id === t.id);
            if (c) window.location.href = '/app/comandas/mesas/' + c.id;
            return;
          }
          const r = await fetch('/api/comandas/comandas', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tableId: t.id }),
          });
          if (r.ok) {
            const c = await r.json();
            window.location.href = '/app/comandas/mesas/' + c.id;
          } else {
            showToast((await r.json()).error ?? 'Erro ao abrir comanda.', 'error');
          }
        },
        openNew() {
          this.newTableLabel = ''; this.dlgError = '';
          this.$refs.addTableDlg.showModal();
          this.$nextTick(() => this.$refs.tableInput?.focus());
        },
        async createTable() {
          if (!this.newTableLabel.trim()) { this.dlgError = 'Informe um nome ou número.'; return; }
          const r = await fetch('/api/comandas/tables', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ label: this.newTableLabel.trim() }),
          });
          if (r.ok) { this.$refs.addTableDlg.close(); await this.load(); showToast(this.labels.criada, 'success'); }
          else { this.dlgError = (await r.json()).error ?? 'Erro ao criar registro.'; showToast(this.dlgError, 'error'); }
        },
        defaultBase() {
          return this.labels.rotulo === 'balcao' ? 'Balcão' : 'Mesa';
        },
        /** Número final de "Mesa 01" para a base "Mesa"; `null` se o nome não seguir o padrão. */
        labelNumber(label, base) {
          const cleanBase = String(base || '').trim();
          if (!cleanBase) return null;
          const escaped = cleanBase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          const match = new RegExp('^\\s*' + escaped + '\\s*0*(\\d+)\\s*$', 'i').exec(String(label || ''));
          if (!match) return null;
          const number = Number(match[1]);
          return Number.isFinite(number) && number > 0 ? number : null;
        },
        nextTableNumber(base) {
          let max = 0;
          for (const table of this.tables) {
            const number = this.labelNumber(table.label, base);
            if (number != null && number > max) max = number;
          }
          return max + 1;
        },
        generatePreview() {
          const base = (this.gen.base || '').trim() || this.defaultBase();
          const pad = Math.max(0, Math.min(6, Number(this.gen.pad) || 0));
          const count = Math.max(1, Math.min(200, Math.floor(Number(this.gen.count) || 0)));
          const rawStart = this.gen.start;
          let number = rawStart === '' || rawStart == null
            ? this.nextTableNumber(base)
            : Math.max(1, Math.floor(Number(rawStart) || 1));
          const existing = new Set();
          for (const table of this.tables) {
            const used = this.labelNumber(table.label, base);
            if (used != null) existing.add(used);
          }
          const labels = [];
          let guard = 0;
          while (labels.length < count && guard++ < count + existing.size + 1000) {
            if (!existing.has(number)) labels.push(base + ' ' + String(number).padStart(pad, '0'));
            number++;
          }
          if (!labels.length) return '—';
          const shown = labels.slice(0, 6).join(', ');
          return labels.length > 6 ? shown + ' … (+' + (labels.length - 6) + ')' : shown;
        },
        openGenerate() {
          this.gen.base = this.defaultBase();
          this.gen.start = '';
          this.gen.count = 1;
          this.gen.pad = 0;
          this.genError = '';
          this.$refs.generateDlg.showModal();
          this.$nextTick(() => this.$refs.genBase?.focus());
        },
        async generateTables() {
          this.genError = '';
          const base = (this.gen.base || '').trim() || this.defaultBase();
          const count = Math.floor(Number(this.gen.count));
          if (!Number.isFinite(count) || count < 1 || count > 200) {
            this.genError = 'Informe uma quantidade entre 1 e 200.';
            return;
          }
          const payload = {
            base,
            count,
            pad: Math.max(0, Math.min(6, Math.floor(Number(this.gen.pad) || 0))),
          };
          const rawStart = this.gen.start;
          if (rawStart !== '' && rawStart != null) {
            const start = Math.floor(Number(rawStart));
            if (!Number.isFinite(start) || start < 1) {
              this.genError = 'O primeiro número deve ser 1 ou maior.';
              return;
            }
            payload.start = start;
          }
          this.generating = true;
          try {
            const r = await fetch('/api/comandas/tables/generate', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const data = await r.json().catch(() => ({}));
            if (!r.ok) { this.genError = data.error ?? 'Erro ao gerar registros.'; return; }
            this.$refs.generateDlg.close();
            await this.load();
            const total = data.created?.length ?? 0;
            if (total === 1) {
              showToast(this.labels.rotulo === 'balcao' ? '1 balcão criado.' : '1 mesa criada.', 'success');
            } else {
              showToast(total + (this.labels.rotulo === 'balcao' ? ' balcões criados.' : ' mesas criadas.'), 'success');
            }
          } catch {
            this.genError = 'Erro de conexão. Tente de novo.';
          } finally {
            this.generating = false;
          }
        },
        openHistory() {
          this.history.tableId = '';
          this.history.sessions = [];
          this.history.error = '';
          this.$refs.historyDlg.showModal();
          this.loadHistory();
        },
        async loadHistory() {
          this.history.loading = true;
          this.history.error = '';
          try {
            const query = this.history.tableId ? '?tableId=' + encodeURIComponent(this.history.tableId) : '';
            const r = await fetch('/api/comandas/tables/history' + query);
            const data = await r.json().catch(() => ({}));
            if (!r.ok) {
              this.history.error = data.error ?? 'Erro ao carregar o histórico.';
              this.history.sessions = [];
              return;
            }
            this.history.sessions = Array.isArray(data.sessions) ? data.sessions : [];
          } catch {
            this.history.error = 'Erro de conexão. Tente de novo.';
            this.history.sessions = [];
          } finally {
            this.history.loading = false;
          }
        },
        statusLabel(status) {
          return status === 'aberta' ? 'Aberta' : (status === 'fechada' ? 'Fechada' : 'Cancelada');
        },
        statusClass(status) {
          return status === 'aberta' ? 'neutral' : (status === 'fechada' ? 'ok' : 'off');
        },
        sessionPeriod(session) {
          if (!session.opened_at && !session.closed_at) return 'Sem datas registradas';
          const start = session.opened_at ? fmtDateTime(session.opened_at) : '—';
          if (session.status === 'aberta') return start + ' → em aberto';
          return start + ' → ' + (session.closed_at ? fmtDateTime(session.closed_at) : '—');
        },
        qtyText(qty) {
          const number = Number(qty);
          if (!Number.isFinite(number)) return '0';
          return Number.isInteger(number)
            ? String(number)
            : number.toLocaleString('pt-BR', { maximumFractionDigits: 3 });
        },
        itemMeta(item) {
          if (item.voided) {
            const by = item.canceled_by ? ' por ' + item.canceled_by : '';
            const at = item.voided_at ? ' em ' + fmtDateTime(item.voided_at) : '';
            return 'Cancelado' + by + at;
          }
          const by = item.added_by ? ' por ' + item.added_by : '';
          const at = item.added_at ? ' em ' + fmtDateTime(item.added_at) : '';
          return 'Lançado' + by + at;
        },
        async removeTable(t) {
          if (!await window.confirmDlg(this.labels.removerTitulo + ` "${t.label}"?`)) return;
          const r = await fetch('/api/comandas/tables/' + t.id, { method: 'DELETE' });
          if (r.ok) { await this.load(); showToast(this.labels.removida, 'success'); }
          else showToast((await r.json()).error ?? 'Erro ao remover registro.', 'error');
        },
      };
    }
  </script>
</body>
</html>
