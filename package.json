{
  "name": "kuruk",
  "version": "2.1.20",
  "description": "Kuruk — plataforma comercial modular desktop-first",
  "author": "Kuruk",
  "private": true,
  "main": "dist/electron/bootstrap.js",
  "scripts": {
    "dev": "node scripts/kuruk dev",
    "dev:electron": "node scripts/kuruk dev:electron",
    "build": "node scripts/kuruk build",
    "dist:win": "node scripts/kuruk dist:win",
    "release:win": "node scripts/kuruk release:win",
    "lint": "node scripts/kuruk lint",
    "format": "node scripts/kuruk format",
    "smoke": "node scripts/kuruk smoke",
    "test": "node scripts/kuruk test",
    "postinstall": "node scripts/kuruk postinstall",
    "kuruk": "node scripts/kuruk"
  },
  "dependencies": {
    "alpinejs": "^3.14.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.11.1",
    "bwip-js": "^4.11.4",
    "drizzle-orm": "^0.44.0",
    "ejs": "^3.1.10",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "node-forge": "^1.4.0",
    "node-machine-id": "^1.1.12",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@floating-ui/dom": "^1.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "c8": "^11.0.0",
    "drizzle-kit": "^0.31.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.0",
    "flatpickr": "^4.6.13",
    "playwright": "^1.61.1",
    "prettier": "^3.5.0",
    "sortablejs": "^1.15.7",
    "tom-select": "^2.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.0",
    "uplot": "^1.6.32"
  },
  "build": {
    "appId": "com.kuruk.desktop",
    "productName": "Kuruk",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/*.node"
    ],
    "files": [
      "dist/**/*",
      "drizzle/migrations/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "artifactName": "Kuruk-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Dragonxt022",
      "repo": "kuruk",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    }
  },
  "optionalDependencies": {
    "node-thermal-printer": "^4.6.1",
    "serialport": "^13.0.0"
  }
}
