# Porta do servidor HTTP (default: 4000)
CLOUD_PORT=4000

# Conexão com o banco MySQL
CLOUD_DB_HOST=127.0.0.1
CLOUD_DB_PORT=3307
CLOUD_DB_USER=root
CLOUD_DB_PASSWORD=kuruk
CLOUD_DB_NAME=kuruk_cloud

# KURUK IA — Ollama que roda nesta VPS (o cloud encaminha as requisições do app local para cá).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_MS=120000

# KURUK IA — chaves de reserva dos provedores externos (opcionais). O normal é configurar os
# provedores no painel (Configurações › KURUK IA); as variáveis abaixo só valem como fallback.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# URL de download do instalador do Kuruk (opcional — usado na landing page)
# KURUK_DOWNLOAD_URL=https://example.com/kuruk-setup.exe

# Versão do app exibida na landing page (opcional)
# KURUK_APP_VERSION=1.0.0

# Configurações de deploy (usadas por scripts/deploy-cloud.js e .sh)
# Servidor OLD: acesso por chave/agente SSH. O diretório precisa ser um clone
# deste repositório; o PM2 é gerenciado pelo usuário nodeapps.
# KURUK_VPS_HOST=100.87.5.89
# KURUK_VPS_SSH_USER=bruno
# KURUK_VPS_CLOUD_DIR=/opt/apps/kuruk-cloud/cloud
# KURUK_VPS_SSH_KEY=C:\Users\Administrador\.ssh\id_ed25519
# KURUK_VPS_PM2_NAME=kuruk-cloud
# KURUK_VPS_PM2_USER=nodeapps
# KURUK_CLOUD_HEALTH_URL=https://kuruk.com.br/api/health
