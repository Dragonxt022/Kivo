# Porta do servidor HTTP (default: 4000)
CLOUD_PORT=4000

# Conexão com o banco MySQL
CLOUD_DB_HOST=127.0.0.1
CLOUD_DB_PORT=3307
CLOUD_DB_USER=root
CLOUD_DB_PASSWORD=kivo
CLOUD_DB_NAME=kivo_cloud

# KIVO IA — Ollama que roda nesta VPS (o cloud encaminha as requisições do app local para cá).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_MS=120000

# KIVO IA — chaves de reserva dos provedores externos (opcionais). O normal é configurar os
# provedores no painel (Configurações › KIVO IA); as variáveis abaixo só valem como fallback.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# URL de download do instalador do Kivo (opcional — usado na landing page)
# KIVO_DOWNLOAD_URL=https://example.com/kivo-setup.exe

# Versão do app exibida na landing page (opcional)
# KIVO_APP_VERSION=1.0.0

# Configurações de deploy (usadas pelo scripts/deploy-cloud.sh)
# KIVO_VPS_HOST=187.77.251.231
# KIVO_VPS_SSH_USER=root
# KIVO_VPS_SITE_USER=buscamais-kivo
# KIVO_VPS_CLOUD_DIR=/home/buscamais-kivo/htdocs/kivo.buscamais.org/cloud
# KIVO_VPS_SSH_KEY=C:\Users\Administrador\.ssh\kivo_vps_deploy
# KIVO_VPS_PM2_NAME=kivo-cloud
