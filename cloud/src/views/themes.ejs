<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Temas</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <script defer src="/vendor/alpine.min.js"></script>
  <style>
    .theme-card { display: flex; flex-direction: column; gap: 14px; }
    .theme-card-head { display: flex; gap: 14px; align-items: flex-start; }
    .theme-cover { width: 120px; height: 76px; flex: none; border-radius: 10px; overflow: hidden; background: #f4f4f5; display: grid; place-items: center; border: 1px solid #e5e7eb; }
    .theme-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .theme-cover-empty { font-size: 12px; color: #888; }
    .theme-card-info { flex: 1; min-width: 0; }
    .theme-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; margin-top: 4px; }
    .theme-grants { border-top: 1px solid #eee; padding-top: 12px; display: flex; flex-direction: column; gap: 8px; }
    .theme-grant-form { display: flex; gap: 8px; flex-wrap: wrap; }
    .theme-grant-form select { min-width: 240px; }
    .theme-granted { display: flex; flex-wrap: wrap; gap: 8px; }
    .theme-grant-chip { display: inline-flex; align-items: center; gap: 6px; background: #f4f4f5; border: 1px solid #e5e7eb; border-radius: 999px; padding: 3px 4px 3px 10px; font-size: 12px; }
    .theme-grant-chip form { display: inline; margin: 0; }
    .theme-grant-chip button { border: 0; background: transparent; cursor: pointer; font-size: 14px; line-height: 1; color: #888; padding: 0 4px; }
    .theme-grant-chip button:hover { color: #dc2626; }
    .preview-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .preview-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 10px; max-height: 60vh; overflow-y: auto; padding: 6px; border-radius: 10px; }
    .preview-grid.dark { background: #1c1f26; }
    .preview-cell { display: flex; flex-direction: column; align-items: center; gap: 5px; padding: 8px 6px; border-radius: 10px; border: 1px solid #eee; }
    .preview-grid.dark .preview-cell { border-color: #2a2d36; }
    .preview-cell svg { width: 30px; height: 30px; }
    .preview-cell span { font-size: 10px; color: #888; text-align: center; word-break: break-word; line-height: 1.15; }
    .preview-grid.dark .preview-cell span { color: #9aa0aa; }
    /* Upload estilizado: o <input type=file> nativo fica escondido dentro do label; o
       clique no label abre o seletor e o nome do arquivo aparece ao lado. */
    .file-pick { display: flex; align-items: center; gap: 10px; cursor: pointer; border: 1.5px dashed #d4d4d8; border-radius: 10px; padding: 10px 12px; background: #fafafa; margin: 2px 0 6px; transition: border-color .15s, background .15s; }
    .file-pick:hover { border-color: var(--primary, #ff8000); background: #fff7ed; }
    .file-pick-input { display: none; }
    .file-pick-btn { display: inline-flex; align-items: center; gap: 6px; background: var(--primary, #ff8000); color: #fff; font-weight: 600; font-size: 13px; padding: 7px 13px; border-radius: 8px; flex: none; }
    .file-pick-btn svg { width: 15px; height: 15px; }
    .file-pick-name { font-size: 12px; color: #666; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'themes' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'themes' }) %>

      <div class="page">
        <div class="page-header">
          <h1>Temas</h1>
          <button class="btn" onclick="openNewTheme()">+ Novo tema</button>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="error-banner"><%= error %></div>
        <% } %>
        <% if (typeof ok !== 'undefined' && ok) { %>
          <div class="success-banner">Feito: <%= ok %>.</div>
        <% } %>

        <div class="card">
          <p class="card-intro" style="margin:0">
            Cadastre pacotes de ícones (temas). Tema <strong>grátis</strong> fica disponível para
            todas as empresas; tema <strong>pago</strong> só para as empresas que você liberar
            abaixo. O cliente baixa e ativa em <em>Configurações → Interface</em>.
          </p>
        </div>

        <% if (!themes.length) { %>
          <div class="card"><%- include('partials/empty-state', { message: 'Nenhum tema cadastrado ainda.' }) %></div>
        <% } %>

        <% themes.forEach(function(t) { %>
          <% var lista = grants.get(Number(t.id)) || []; %>
          <div class="card theme-card">
            <div class="theme-card-head">
              <div class="theme-cover">
                <% if (t.cover_path) { %>
                  <img src="/admin/themes/<%= t.id %>/cover" alt="Capa de <%= t.name %>">
                <% } else { %>
                  <span class="theme-cover-empty">sem capa</span>
                <% } %>
              </div>
              <div class="theme-card-info">
                <h2 style="margin:0"><%= t.name %></h2>
                <div class="theme-meta">
                  <% if (t.price_cents > 0) { %>
                    <span class="badge">Pago</span>
                    <span>R$ <%= (t.price_cents / 100).toFixed(2).replace('.', ',') %></span>
                  <% } else { %>
                    <span class="badge paga">Grátis</span>
                  <% } %>
                  <span class="cell-muted">· <%= t.files_count %> ícone(s) · slug <code><%= t.slug %></code></span>
                </div>
                <% if (t.description) { %><p class="cell-muted" style="margin:.35rem 0 0"><%= t.description %></p><% } %>
              </div>
              <div style="display:flex; gap:8px; flex: none;">
                <button type="button" class="btn secondary small" onclick="openPreviewTheme(<%= t.id %>)">Pré-visualizar</button>
                <button type="button" class="btn secondary small" onclick="openEditTheme(<%= t.id %>)">Editar</button>
                <form method="post" action="/admin/themes/<%= t.id %>/delete" onsubmit="return confirm('Remover o tema <%= t.name %>? Empresas que já baixaram mantêm os ícones.');">
                  <button type="submit" class="btn danger small">Excluir</button>
                </form>
              </div>
            </div>

            <div class="theme-grants">
              <% if (t.price_cents > 0) { %>
                <form method="post" action="/admin/themes/<%= t.id %>/grant" class="theme-grant-form">
                  <select name="companyUuid" required>
                    <option value="">Liberar para…</option>
                    <% companies.forEach(function(c) { %>
                      <option value="<%= c.company_uuid %>"><%= c.name || c.company_uuid %></option>
                    <% }); %>
                  </select>
                  <button type="submit" class="btn small">Liberar</button>
                </form>
                <div class="theme-granted">
                  <% if (!lista.length) { %>
                    <span class="cell-muted">Nenhuma empresa liberada.</span>
                  <% } else { %>
                    <% lista.forEach(function(g) { %>
                      <span class="theme-grant-chip">
                        <%= g.company_name || g.company_uuid %>
                        <form method="post" action="/admin/themes/<%= t.id %>/revoke" onsubmit="return confirm('Revogar o acesso desta empresa?');">
                          <input type="hidden" name="companyUuid" value="<%= g.company_uuid %>">
                          <button type="submit" title="Revogar">&times;</button>
                        </form>
                      </span>
                    <% }); %>
                  <% } %>
                </div>
              <% } else { %>
                <span class="cell-muted">Tema grátis — disponível para todas as empresas.</span>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </main>
  </div>

  <dialog id="modal-new-theme">
    <form id="new-theme-form" onsubmit="return false;">
      <div class="modal-header">
        <h2>Novo tema</h2>
        <button type="button" class="modal-close" onclick="document.getElementById('modal-new-theme').close()">&times;</button>
      </div>
      <div class="modal-body">
        <label>Nome do tema</label>
        <input type="text" id="theme-name" required maxlength="120" placeholder="Ex.: 3D Max, Linha fina, Neon">

        <label>Descrição (opcional)</label>
        <input type="text" id="theme-desc" maxlength="500" placeholder="Uma linha explicando o estilo">

        <label class="label-checkbox" style="margin-top:.5rem">
          <input type="checkbox" id="theme-free" checked onchange="document.getElementById('theme-price-wrap').style.display = this.checked ? 'none' : 'block'">
          Tema grátis para todos
        </label>
        <div id="theme-price-wrap" style="display:none">
          <label>Preço (R$)</label>
          <input type="text" id="theme-price" placeholder="0,00" inputmode="decimal">
        </div>

        <label>Foto de capa (jpg, png ou webp)</label>
        <label class="file-pick">
          <input type="file" id="theme-cover" accept="image/jpeg,image/png,image/webp" class="file-pick-input"
                 onchange="document.getElementById('theme-cover-name').textContent = this.files.length ? this.files[0].name : 'Nenhum arquivo escolhido'">
          <span class="file-pick-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            Escolher capa
          </span>
          <span class="file-pick-name" id="theme-cover-name">Nenhum arquivo escolhido</span>
        </label>

        <label>Arquivos do tema (selecione os .svg — e o manifest.json, se houver)</label>
        <label class="file-pick">
          <input type="file" id="theme-files" accept=".svg,.json" multiple class="file-pick-input"
                 onchange="document.getElementById('theme-files-name').textContent = this.files.length ? (this.files.length + ' arquivo(s) selecionado(s)') : 'Nenhum arquivo escolhido'">
          <span class="file-pick-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Escolher ícones
          </span>
          <span class="file-pick-name" id="theme-files-name">Nenhum arquivo escolhido</span>
        </label>
        <p class="field-hint">Os ícones devem ter os mesmos nomes do conjunto padrão (cart, users, …) ou vir com um manifest.json mapeando os nomes.</p>

        <div class="error" id="theme-error"></div>
      </div>
      <div class="actions">
        <button type="button" class="btn secondary" onclick="document.getElementById('modal-new-theme').close()">Cancelar</button>
        <button type="button" class="btn" id="theme-submit" onclick="criarTema()">Cadastrar tema</button>
      </div>
    </form>
  </dialog>

  <dialog id="modal-edit-theme">
    <form id="edit-theme-form" onsubmit="return false;">
      <div class="modal-header">
        <h2>Editar tema</h2>
        <button type="button" class="modal-close" onclick="document.getElementById('modal-edit-theme').close()">&times;</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="edit-theme-id">
        <label>Nome do tema</label>
        <input type="text" id="edit-theme-name" required maxlength="120">

        <label>Descrição (opcional)</label>
        <input type="text" id="edit-theme-desc" maxlength="500">

        <label class="label-checkbox" style="margin-top:.5rem">
          <input type="checkbox" id="edit-theme-free" onchange="document.getElementById('edit-theme-price-wrap').style.display = this.checked ? 'none' : 'block'">
          Tema grátis para todos
        </label>
        <div id="edit-theme-price-wrap" style="display:none">
          <label>Preço (R$)</label>
          <input type="text" id="edit-theme-price" placeholder="0,00" inputmode="decimal">
        </div>

        <label>Foto de capa</label>
        <div id="edit-theme-cover-preview" style="margin:6px 0"></div>
        <label class="file-pick">
          <input type="file" id="edit-theme-cover" accept="image/jpeg,image/png,image/webp" class="file-pick-input"
                 onchange="document.getElementById('edit-theme-cover-name').textContent = this.files.length ? this.files[0].name : 'Manter a capa atual'">
          <span class="file-pick-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            Trocar capa
          </span>
          <span class="file-pick-name" id="edit-theme-cover-name">Manter a capa atual</span>
        </label>
        <p class="field-hint">Deixe em branco para manter a capa atual.</p>

        <label>Substituir os ícones (opcional)</label>
        <label class="file-pick">
          <input type="file" id="edit-theme-files" accept=".svg,.json" multiple class="file-pick-input"
                 onchange="document.getElementById('edit-theme-files-name').textContent = this.files.length ? (this.files.length + ' arquivo(s) selecionado(s)') : 'Manter os ícones atuais'">
          <span class="file-pick-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Trocar ícones
          </span>
          <span class="file-pick-name" id="edit-theme-files-name">Manter os ícones atuais</span>
        </label>
        <p class="field-hint">Selecione os .svg para trocar o pacote inteiro; em branco mantém os atuais.</p>

        <div class="error" id="edit-theme-error"></div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn secondary" onclick="document.getElementById('modal-edit-theme').close()">Cancelar</button>
        <button type="button" class="btn" id="edit-theme-submit" onclick="salvarTema()">Salvar alterações</button>
      </div>
    </form>
  </dialog>

  <dialog id="modal-preview-theme" style="width:min(780px, 94vw)">
    <div class="modal-header">
      <h2 id="preview-title">Pré-visualização</h2>
      <button type="button" class="modal-close" onclick="document.getElementById('modal-preview-theme').close()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="preview-toolbar">
        <span class="cell-muted" id="preview-count"></span>
        <span style="flex:1"></span>
        <button type="button" class="btn secondary small" id="preview-bg-toggle" onclick="togglePreviewBg()">Fundo escuro</button>
      </div>
      <div class="preview-grid" id="preview-grid"></div>
    </div>
  </dialog>

  <script>
    window.KIVO_THEMES = <%- JSON.stringify(themes.map(function (t) {
      return { id: t.id, name: t.name, description: t.description || '', price_cents: t.price_cents, cover: t.cover_path ? ('/admin/themes/' + t.id + '/cover') : null };
    })) %>;
    // Aceita "19,90" e "19.90" sem ambiguidade: se há vírgula, ela é o decimal e os pontos
    // são milhar; sem vírgula, o ponto é o decimal.
    function parsePreco(txt) {
      let s = String(txt || '').replace(/[^\d,.]/g, '');
      if (s.includes(',')) s = s.replace(/\./g, '').replace(',', '.');
      const n = parseFloat(s);
      return isFinite(n) ? Math.round(n * 100) : 0;
    }

    function openNewTheme() {
      document.getElementById('theme-name').value = '';
      document.getElementById('theme-desc').value = '';
      document.getElementById('theme-free').checked = true;
      document.getElementById('theme-price-wrap').style.display = 'none';
      document.getElementById('theme-price').value = '';
      document.getElementById('theme-cover').value = '';
      document.getElementById('theme-files').value = '';
      document.getElementById('theme-cover-name').textContent = 'Nenhum arquivo escolhido';
      document.getElementById('theme-files-name').textContent = 'Nenhum arquivo escolhido';
      document.getElementById('theme-error').textContent = '';
      document.getElementById('modal-new-theme').showModal();
    }

    async function criarTema() {
      const erro = document.getElementById('theme-error');
      const btn = document.getElementById('theme-submit');
      erro.textContent = '';
      const name = document.getElementById('theme-name').value.trim();
      if (name.length < 2) { erro.textContent = 'Informe o nome do tema.'; return; }

      const files = {};
      const input = document.getElementById('theme-files');
      for (const f of Array.from(input.files || [])) {
        const nome = f.name.toLowerCase();
        if (!nome.endsWith('.svg') && nome !== 'manifest.json') continue;
        files[f.name] = await f.text();
      }
      if (!Object.keys(files).some((f) => f.toLowerCase().endsWith('.svg'))) {
        erro.textContent = 'Selecione ao menos um arquivo .svg.';
        return;
      }

      let coverBase64 = '';
      const cover = document.getElementById('theme-cover').files[0];
      if (cover) {
        coverBase64 = await new Promise((res, rej) => {
          const r = new FileReader();
          r.onload = () => res(String(r.result));
          r.onerror = rej;
          r.readAsDataURL(cover);
        });
      }

      const free = document.getElementById('theme-free').checked;
      const priceCents = free ? 0 : parsePreco(document.getElementById('theme-price').value);

      btn.disabled = true;
      btn.textContent = 'Cadastrando…';
      try {
        const resp = await fetch('/admin/themes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            description: document.getElementById('theme-desc').value.trim(),
            free,
            priceCents,
            coverBase64,
            files,
          }),
        });
        if (!resp.ok) {
          const d = await resp.json().catch(() => ({}));
          erro.textContent = d.error || 'Não foi possível cadastrar o tema.';
          return;
        }
        location.reload();
      } catch (e) {
        erro.textContent = 'Erro de conexão.';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Cadastrar tema';
      }
    }

    function openEditTheme(id) {
      const t = (window.KIVO_THEMES || []).find((x) => x.id === id);
      if (!t) return;
      document.getElementById('edit-theme-id').value = t.id;
      document.getElementById('edit-theme-name').value = t.name;
      document.getElementById('edit-theme-desc').value = t.description || '';
      const free = Number(t.price_cents) === 0;
      document.getElementById('edit-theme-free').checked = free;
      document.getElementById('edit-theme-price-wrap').style.display = free ? 'none' : 'block';
      document.getElementById('edit-theme-price').value = free ? '' : (Number(t.price_cents) / 100).toFixed(2).replace('.', ',');
      document.getElementById('edit-theme-cover').value = '';
      document.getElementById('edit-theme-files').value = '';
      document.getElementById('edit-theme-cover-name').textContent = 'Manter a capa atual';
      document.getElementById('edit-theme-files-name').textContent = 'Manter os ícones atuais';
      document.getElementById('edit-theme-error').textContent = '';
      document.getElementById('edit-theme-cover-preview').innerHTML = t.cover
        ? '<img src="' + t.cover + '" alt="" style="width:160px;height:100px;object-fit:cover;border-radius:8px;border:1px solid #e5e7eb">'
        : '<span class="cell-muted">sem capa</span>';
      document.getElementById('modal-edit-theme').showModal();
    }

    async function salvarTema() {
      const erro = document.getElementById('edit-theme-error');
      const btn = document.getElementById('edit-theme-submit');
      erro.textContent = '';
      const id = document.getElementById('edit-theme-id').value;
      const name = document.getElementById('edit-theme-name').value.trim();
      if (name.length < 2) { erro.textContent = 'Informe o nome do tema.'; return; }

      const files = {};
      for (const f of Array.from(document.getElementById('edit-theme-files').files || [])) {
        const nome = f.name.toLowerCase();
        if (!nome.endsWith('.svg') && nome !== 'manifest.json') continue;
        files[f.name] = await f.text();
      }
      let coverBase64 = '';
      const cover = document.getElementById('edit-theme-cover').files[0];
      if (cover) {
        coverBase64 = await new Promise((res, rej) => {
          const r = new FileReader();
          r.onload = () => res(String(r.result));
          r.onerror = rej;
          r.readAsDataURL(cover);
        });
      }
      const free = document.getElementById('edit-theme-free').checked;
      const priceCents = free ? 0 : parsePreco(document.getElementById('edit-theme-price').value);

      btn.disabled = true;
      btn.textContent = 'Salvando…';
      try {
        const resp = await fetch('/admin/themes/' + id + '/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, description: document.getElementById('edit-theme-desc').value.trim(), free, priceCents, coverBase64, files }),
        });
        if (!resp.ok) {
          const d = await resp.json().catch(() => ({}));
          erro.textContent = d.error || 'Não foi possível salvar o tema.';
          return;
        }
        location.reload();
      } catch (e) {
        erro.textContent = 'Erro de conexão.';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Salvar alterações';
      }
    }

    let previewDark = false;
    function togglePreviewBg() {
      previewDark = !previewDark;
      document.getElementById('preview-grid').classList.toggle('dark', previewDark);
      document.getElementById('preview-bg-toggle').textContent = previewDark ? 'Fundo claro' : 'Fundo escuro';
    }

    async function openPreviewTheme(id) {
      const grid = document.getElementById('preview-grid');
      grid.innerHTML = '<p class="cell-muted">Carregando…</p>';
      document.getElementById('preview-count').textContent = '';
      document.getElementById('modal-preview-theme').showModal();
      try {
        const r = await fetch('/admin/themes/' + id + '/icons');
        if (!r.ok) { grid.innerHTML = '<p class="cell-muted">Não foi possível carregar os ícones.</p>'; return; }
        const d = await r.json();
        document.getElementById('preview-title').textContent = 'Pré-visualização — ' + (d.name || 'tema');
        const entries = Object.entries(d.icons || {}).filter(([n]) => n.toLowerCase().endsWith('.svg'));
        document.getElementById('preview-count').textContent = entries.length + ' ícone(s)';
        if (!entries.length) { grid.innerHTML = '<p class="cell-muted">Este tema não tem ícones.</p>'; return; }
        grid.innerHTML = entries
          .map(([name, svg]) => '<div class="preview-cell">' + svg + '<span>' + name.replace(/\.svg$/i, '') + '</span></div>')
          .join('');
      } catch (e) {
        grid.innerHTML = '<p class="cell-muted">Erro de conexão.</p>';
      }
    }
  </script>
</body>
</html>
