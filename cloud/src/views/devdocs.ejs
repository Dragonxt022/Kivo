<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Documentação técnica</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <style>
    .devdocs { display: grid; grid-template-columns: 260px 1fr; gap: 1.25rem; align-items: start; }
    .devdocs-nav { position: sticky; top: 1rem; }
    .devdocs-nav a { display: block; padding: .45rem .6rem; border-radius: 8px; color: inherit; text-decoration: none; }
    .devdocs-nav a:hover { background: rgba(127,127,127,.12); }
    .devdocs-nav a.active { background: rgba(127,127,127,.18); font-weight: 600; }
    .devdocs-nav .dd-title { font-size: .95rem; }
    .devdocs-nav .dd-sum { font-size: .75rem; opacity: .7; margin-top: .15rem; }
    .devdocs-article { max-width: 900px; }
    .devdocs-article h1 { margin-top: 0; }
    .devdocs-article h2 { margin-top: 1.6rem; padding-bottom: .3rem; border-bottom: 1px solid rgba(127,127,127,.25); }
    .devdocs-article h3 { margin-top: 1.2rem; }
    .devdocs-article table { width: 100%; border-collapse: collapse; }
    .devdocs-article th, .devdocs-article td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid rgba(127,127,127,.2); }
    .devdocs-article code { background: rgba(127,127,127,.15); padding: .1rem .3rem; border-radius: 4px; font-size: .85em; }
    .devdocs-article pre { background: rgba(127,127,127,.15); padding: .8rem 1rem; border-radius: 8px; overflow-x: auto; }
    .devdocs-article pre code { background: none; padding: 0; }
    .devdocs-article blockquote { border-left: 3px solid rgba(127,127,127,.35); margin: .8rem 0; padding: .2rem 1rem; opacity: .85; }
    @media (max-width: 820px) { .devdocs { grid-template-columns: 1fr; } .devdocs-nav { position: static; } }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'documentacao' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'documentacao' }) %>

      <div class="page">
        <div class="page-header">
          <div>
            <div class="breadcrumb">Sistema</div>
            <h1>Documentação técnica</h1>
          </div>
        </div>

        <p class="muted" style="margin-top:-.5rem">
          Regras de negócio por módulo, para suporte e treinamento. Mesmo conteúdo do app local
          (<code>src/docs/dev</code>).
        </p>

        <div class="devdocs">
          <nav class="devdocs-nav">
            <% if (!docs.length) { %>
              <p class="muted">Nenhum documento disponível.</p>
            <% } %>
            <% docs.forEach(function (d) { %>
              <a href="/admin/documentacao?doc=<%= encodeURIComponent(d.slug) %>"
                 class="<%= current && current.slug === d.slug ? 'active' : '' %>">
                <div class="dd-title"><%= d.title %></div>
                <% if (d.summary) { %><div class="dd-sum"><%= d.summary %></div><% } %>
              </a>
            <% }); %>
          </nav>

          <article class="devdocs-article">
            <%- current.html %>
          </article>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
