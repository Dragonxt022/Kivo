<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kuruk Cloud — Documentação técnica</title>
  <link rel="icon" type="image/png" href="/logo_kuruk-icon.png">
  <%- include('partials/styles') %>
  <style>
    .devdocs { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 16px; align-items: start; }
    .devdocs-nav {
      position: sticky;
      top: 84px;
      max-height: calc(100vh - 108px);
      overflow: auto;
      padding: 12px;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }
    .dd-heading {
      margin: 2px 6px 8px;
      color: var(--muted);
      font-size: .64rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    .devdocs-nav a {
      display: block;
      padding: 8px 9px;
      border-left: 2px solid transparent;
      border-radius: 8px;
      color: inherit;
      text-decoration: none;
    }
    .devdocs-nav a + a { margin-top: 2px; }
    .devdocs-nav a:hover { background: var(--surface-hover); }
    .devdocs-nav a.active { background: var(--primary-soft); border-left-color: var(--primary); }
    .devdocs-nav .dd-title { font-size: .85rem; font-weight: 600; line-height: 1.35; }
    .devdocs-nav .dd-sum {
      display: -webkit-box;
      overflow: hidden;
      margin-top: 2px;
      color: var(--muted);
      font-size: .71rem;
      line-height: 1.35;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .devdocs-article {
      min-width: 0;
      padding: 24px 28px;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      color: var(--text-secondary);
      font-size: .92rem;
      line-height: 1.7;
      overflow-wrap: anywhere;
    }
    .devdocs-article > :first-child { margin-top: 0; }
    .devdocs-article h1 { margin: 0 0 .6rem; color: var(--text); font-size: 1.5rem; line-height: 1.2; letter-spacing: -.03em; }
    .devdocs-article h2 { margin: 1.7rem 0 .5rem; padding-bottom: .35rem; border-bottom: 1px solid var(--border-light); color: var(--text); font-size: 1.15rem; }
    .devdocs-article h3 { margin: 1.3rem 0 .4rem; color: var(--text); font-size: 1rem; }
    .devdocs-article p { margin: .65rem 0; }
    .devdocs-article ul,
    .devdocs-article ol { margin: .6rem 0 .9rem; padding-left: 1.35rem; }
    .devdocs-article li { margin: .25rem 0; }
    .devdocs-article li::marker { color: var(--primary); }
    .devdocs-article a { color: var(--primary); font-weight: 600; text-decoration: none; }
    .devdocs-article a:hover { text-decoration: underline; }
    .devdocs-article strong { color: var(--text); }
    .devdocs-article code {
      padding: .08rem .32rem;
      border: 1px solid var(--border-light);
      border-radius: 5px;
      background: var(--surface-hover);
      font-size: .84em;
    }
    .devdocs-article pre {
      padding: .9rem 1rem;
      border: 1px solid var(--border-light);
      border-radius: 10px;
      background: var(--surface-hover);
      overflow-x: auto;
    }
    .devdocs-article pre code { padding: 0; border: 0; background: none; }
    .devdocs-article table {
      display: block;
      width: 100%;
      margin: .8rem 0 1.2rem;
      border-collapse: collapse;
      overflow-x: auto;
      font-size: .85rem;
    }
    .devdocs-article th,
    .devdocs-article td {
      padding: .5rem .65rem;
      border-bottom: 1px solid var(--border-light);
      text-align: left;
      vertical-align: top;
    }
    .devdocs-article th {
      background: var(--surface-hover);
      color: var(--muted);
      font-size: .7rem;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .devdocs-article blockquote {
      margin: .9rem 0;
      padding: .4rem 1rem;
      border-left: 3px solid var(--primary);
      border-radius: 0 8px 8px 0;
      background: var(--primary-soft);
      color: var(--text-secondary);
    }
    .devdocs-article hr { margin: 1.4rem 0; border: 0; border-top: 1px solid var(--border-light); }
    .devdocs-article img { max-width: 100%; height: auto; }
    @media (max-width: 900px) {
      .devdocs { grid-template-columns: 1fr; }
      .devdocs-nav { position: static; max-height: none; }
      .devdocs-article { padding: 18px; }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'documentacao' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'documentacao' }) %>

      <div class="page">
        <div class="page-header">
          <div>
            <div class="breadcrumb">Sistema</div>
            <h1>Documentação técnica</h1>
            <p class="page-subtitle">
              Regras de negócio por módulo, para suporte e treinamento. Mesmo conteúdo do app local
              (<code>src/docs/dev</code>).
            </p>
          </div>
        </div>

        <div class="devdocs">
          <nav class="devdocs-nav">
            <div class="dd-heading">Documentos</div>
            <% if (!docs.length) { %>
              <p class="muted">Nenhum documento disponível.</p>
            <% } %>
            <% docs.forEach(function (d) { %>
              <a href="/admin/documentacao?doc=<%= encodeURIComponent(d.slug) %>"
                 class="<%= current && current.slug === d.slug ? 'active' : '' %>">
                <div class="dd-title"><%= d.title %></div>
                <% if (d.summary) { %><div class="dd-sum"><%= d.summary %></div><% } %>
              </a>
            <% }); %>
          </nav>

          <article class="devdocs-article">
            <%- current.html %>
          </article>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
