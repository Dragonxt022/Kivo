<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Inventário</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <script defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'hardware' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'hardware' }) %>

      <div class="page" x-data="hardwarePage()">
        <div class="page-header">
          <h1>Inventário de hardware</h1>
        </div>
        <p class="field-hint" style="margin-top:0">
          Dados técnicos anônimos de cada instalação (OS, CPU, RAM, GPU, tela e versões). Sem nome de usuário, hostname
          ou qualquer dado pessoal. O resumo por perfil ajuda a achar padrões de máquina que dão problema.
        </p>

        <h2>Resumo por perfil</h2>
        <div class="card" style="padding: 0;">
          <table>
            <thead><tr>
              <th>OS</th><th>CPU</th><th>RAM</th><th>Máquinas</th><th>Empresas</th>
            </tr></thead>
            <tbody>
              <template x-for="p in profiles" :key="(p.os || '') + (p.cpu || '') + (p.ram_gb || '')">
                <tr>
                  <td x-text="p.os || '—'"></td>
                  <td x-text="p.cpu || '—'"></td>
                  <td x-text="p.ram_gb ? p.ram_gb + ' GB' : '—'"></td>
                  <td x-text="p.machines"></td>
                  <td x-text="p.companies"></td>
                </tr>
              </template>
              <tr x-show="!profiles.length"><td colspan="5"><%- include('partials/empty-state', { message: 'Nenhum inventário recebido ainda.' }) %></td></tr>
            </tbody>
          </table>
        </div>

        <h2 style="margin-top: 28px;">Instalações</h2>
        <div class="toolbar" style="margin-bottom: 14px;">
          <input type="text" class="input-search" placeholder="Buscar por empresa, OS, CPU…" x-model="q">
        </div>
        <div class="card" style="padding: 0;">
          <table>
            <thead><tr>
              <th class="sortable" @click="sortCycle('company_name')">Empresa<span class="sort-arrow" x-text="sortArrow('company_name')"></span></th>
              <th>OS</th><th>CPU</th><th>RAM</th><th>GPU</th><th>Tela</th>
              <th class="sortable" @click="sortCycle('app_version')">Versão<span class="sort-arrow" x-text="sortArrow('app_version')"></span></th>
              <th class="sortable" @click="sortCycle('last_seen_at')">Visto por último<span class="sort-arrow" x-text="sortArrow('last_seen_at')"></span></th>
            </tr></thead>
            <tbody>
              <template x-for="m in displayRows" :key="m.company_uuid + '|' + m.machine_id">
                <tr>
                  <td><a :href="'/admin/companies/' + m.company_uuid" x-text="m.company_name || m.company_uuid"></a></td>
                  <td x-text="m.os || '—'"></td>
                  <td x-text="m.cpu || '—'"></td>
                  <td x-text="m.ram_gb ? m.ram_gb + ' GB' : '—'"></td>
                  <td x-text="gpu(m)"></td>
                  <td x-text="screen(m)"></td>
                  <td class="muted" x-text="m.app_version || '—'"></td>
                  <td x-text="m.last_seen_at"></td>
                </tr>
              </template>
              <tr x-show="!displayRows.length"><td colspan="8"><%- include('partials/empty-state', { message: 'Nenhum inventário recebido ainda.' }) %></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/table-toolkit.js"></script>
  <script>
    function hardwarePage() {
      return {
        ...tableToolkit(),
        rows: <%- JSON.stringify(machines) %>,
        profiles: <%- JSON.stringify(profiles) %>,
        q: '',
        sortGetters: {
          company_name: (m) => m.company_name || m.company_uuid,
          app_version: (m) => m.app_version || '',
          last_seen_at: (m) => m.last_seen_at || '',
        },
        gpu(m) {
          const g = m.data && m.data.gpu;
          if (!g) return '—';
          return (g.status || 'desconhecida') + (g.software ? ' (software)' : '');
        },
        screen(m) {
          const s = m.data && m.data.screen;
          if (!s) return '—';
          return s.width + '×' + s.height + (s.scaleFactor && s.scaleFactor !== 1 ? ' @' + s.scaleFactor + 'x' : '');
        },
        get displayRows() {
          const q = this.q.trim().toLowerCase();
          const filtered = q
            ? this.rows.filter((m) => [m.company_name, m.os, m.cpu].some((v) => String(v ?? '').toLowerCase().includes(q)))
            : this.rows;
          return this.sortedRows(filtered, this.sortGetters);
        },
      };
    }
  </script>
</body>
</html>
