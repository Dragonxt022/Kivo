<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Nova senha</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <div class="card login-card">
    <div class="brand"><img id="brand-logo" src="/logo_kivo-icon.svg" alt=""> Kivo Cloud</div>
    <h2 style="margin-top:0">Nova senha</h2>
    <% if (typeof error !== 'undefined' && error) { %><p class="error-banner"><%= error %></p><% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <p class="success-banner"><%= success %></p>
      <a class="btn" href="/admin/login" style="width:100%;justify-content:center;">Ir para o login</a>
    <% } else if (!valid) { %>
      <a class="btn secondary" href="/admin/forgot" style="width:100%;justify-content:center;">Pedir novo link</a>
    <% } else { %>
      <form method="post" action="/admin/reset-password">
        <input type="hidden" name="token" value="<%= token %>">
        <label>Nova senha</label>
        <input type="password" name="newPassword" required minlength="8" autocomplete="new-password" autofocus>
        <label>Confirmar nova senha</label>
        <input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password">
        <button type="submit" class="btn">Salvar nova senha</button>
      </form>
    <% } %>
    <p class="login-help"><a href="/admin/login">&larr; Voltar para o login</a></p>
  </div>
  <script>
    if (document.documentElement.getAttribute('data-theme') === 'dark') {
      document.getElementById('brand-logo').src = '/logo_kivo-icon_branco.svg';
    }
  </script>
</body>
</html>
