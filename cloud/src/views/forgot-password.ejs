<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Recuperar senha</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <div class="card login-card">
    <div class="brand"><img id="brand-logo" src="/logo_kivo-icon.svg" alt=""> Kivo Cloud</div>
    <h2 style="margin-top:0">Recuperar senha</h2>
    <% if (typeof error !== 'undefined' && error) { %><p class="error-banner"><%= error %></p><% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <p class="success-banner"><%= success %></p>
    <% } else { %>
      <p class="field-hint" style="margin-top:0">
        Informe seu usuário ou o e-mail cadastrado no seu perfil. Enviaremos um link para criar uma nova senha.
      </p>
      <form method="post" action="/admin/forgot">
        <label>Usuário ou e-mail</label>
        <input type="text" name="identity" required autofocus>
        <button type="submit" class="btn">Enviar link</button>
      </form>
    <% } %>
    <p class="login-help"><a href="/admin/login">&larr; Voltar para o login</a></p>
  </div>
  <script>
    if (document.documentElement.getAttribute('data-theme') === 'dark') {
      document.getElementById('brand-logo').src = '/logo_kivo-icon_branco.svg';
    }
  </script>
</body>
</html>
