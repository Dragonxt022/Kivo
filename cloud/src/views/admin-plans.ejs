<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Planos e preços</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <style>
    .price-editor { display: flex; flex-direction: column; gap: 16px; }
    .plan-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
      gap: 14px;
      align-items: start;
    }
    .plan-editor {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 18px;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }
    .plan-editor.has-promo {
      border-color: color-mix(in srgb, var(--primary) 35%, var(--border-light));
    }
    .plan-editor-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }
    .plan-editor-head h2 { margin: 0; font-size: 1.1rem; letter-spacing: -0.02em; }
    .plan-desc { margin: 3px 0 0; font-size: 0.78rem; line-height: 1.45; color: var(--muted); }
    .plan-price-now { flex: none; text-align: right; }
    .plan-price-now span {
      display: block;
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .plan-price-now strong { display: block; font-size: 1.3rem; line-height: 1.2; letter-spacing: -0.035em; }
    .plan-price-now del { color: var(--muted); font-size: 0.72rem; }
    .price-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; }
    .price-grid label {
      display: block;
      margin-bottom: 4px;
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--muted);
    }
    .price-grid input { width: 100%; min-height: 38px; margin-bottom: 0; }
    .price-preview {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 5px 8px;
      margin-top: auto;
      padding: 9px 11px;
      border: 1px solid var(--border-light);
      border-radius: 10px;
      background: var(--surface-hover);
      font-size: 0.8rem;
      color: var(--muted);
    }
    .price-preview strong { color: var(--text); }
    .price-preview del { color: var(--muted); }
    .price-preview .promo { color: var(--primary); font-weight: 800; }
    .promo-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
      align-self: flex-start;
    }
    .promo-pill.on { background: var(--primary-soft); color: var(--primary); }
    .promo-pill.off { background: var(--surface-hover); color: var(--muted); }
    .price-help { margin: 0; max-width: 720px; font-size: 0.78rem; line-height: 1.5; color: var(--muted); }
    @media (max-width: 720px) {
      .plan-grid { grid-template-columns: 1fr; }
      .plan-editor-head { flex-direction: column; }
      .plan-price-now { text-align: left; }
      .price-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'plans' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'plans' }) %>
      <div class="page">
        <% if (typeof ok !== 'undefined' && ok) { %><p class="success-banner"><%= ok %></p><% } %>
        <% if (typeof error !== 'undefined' && error) { %><p class="error-banner"><%= error %></p><% } %>

        <div class="page-header">
          <div>
            <div class="breadcrumb">Comercial</div>
            <h1>Planos e preços</h1>
            <p class="page-subtitle">
              Defina o preço normal de cada plano e, se quiser, uma promoção com prazo.
              O app e a página pública mostram o valor original riscado ao lado do promocional;
              depois do prazo, o preço normal volta sozinho.
            </p>
          </div>
        </div>

        <form method="post" action="/admin/plans" class="price-editor">
          <div class="plan-grid">
            <% definitions.forEach(function (p) {
                 var cfg = pricing[p.key];
                 var hoje = new Date().toISOString().slice(0, 10);
                 var promoAtiva = cfg.promoPriceCents && cfg.promoPriceCents > 0
                   && cfg.promoPriceCents < cfg.priceCents
                   && (!cfg.promoUntil || cfg.promoUntil >= hoje);
                 var reais = function (cents) { return Number(cents || 0) / 100; };
                 var fmt = function (cents) { return reais(cents).toFixed(2).replace('.', ','); };
            %>
            <section class="plan-editor<%= promoAtiva ? ' has-promo' : '' %>">
              <div class="plan-editor-head">
                <div>
                  <h2><%= p.label %></h2>
                  <p class="plan-desc"><%= p.description %></p>
                </div>
                <div class="plan-price-now">
                  <span>Hoje o cliente paga</span>
                  <strong>R$ <%= fmt(promoAtiva ? cfg.promoPriceCents : cfg.priceCents) %></strong>
                  <% if (promoAtiva) { %><del>R$ <%= fmt(cfg.priceCents) %>/mês</del><% } %>
                </div>
              </div>

              <div class="price-grid">
                <div>
                  <label for="price-<%= p.key %>">Preço normal (R$)</label>
                  <input id="price-<%= p.key %>" type="text" inputmode="decimal" name="price_<%= p.key %>"
                         value="<%= fmt(cfg.priceCents) %>" placeholder="0,00" required>
                </div>
                <div>
                  <label for="promo-<%= p.key %>">Preço promocional (R$)</label>
                  <input id="promo-<%= p.key %>" type="text" inputmode="decimal" name="promo_<%= p.key %>"
                         value="<%= cfg.promoPriceCents ? fmt(cfg.promoPriceCents) : '' %>"
                         placeholder="Sem promoção">
                </div>
                <div>
                  <label for="promo-label-<%= p.key %>">Nome da promoção</label>
                  <input id="promo-label-<%= p.key %>" type="text" maxlength="60" name="promo_label_<%= p.key %>"
                         value="<%= cfg.promoLabel || '' %>" placeholder="Ex.: Black Friday">
                </div>
                <div>
                  <label for="promo-until-<%= p.key %>">Promoção válida até</label>
                  <input id="promo-until-<%= p.key %>" type="date" name="promo_until_<%= p.key %>"
                         value="<%= cfg.promoUntil || '' %>">
                </div>
              </div>

              <div class="price-preview">
                <% if (promoAtiva) { %>
                  <span>No app:</span>
                  <del>R$ <%= fmt(cfg.priceCents) %></del>
                  <span class="promo">R$ <%= fmt(cfg.promoPriceCents) %>/mês</span>
                  <% if (cfg.promoLabel) { %><strong><%= cfg.promoLabel %></strong><% } %>
                <% } else { %>
                  <span>No app:</span>
                  <strong>R$ <%= fmt(cfg.priceCents) %>/mês</strong>
                  <% if (cfg.promoPriceCents) { %><span>· promoção fora do prazo</span><% } %>
                <% } %>
              </div>

              <span class="promo-pill <%= promoAtiva ? 'on' : 'off' %>">
                <%= promoAtiva ? 'Promoção ativa' : (cfg.promoPriceCents ? 'Promoção programada/expirada' : 'Sem promoção') %>
              </span>
            </section>
            <% }); %>
          </div>

          <div class="form-actions-bar">
            <p class="price-help">
              A promoção vale apenas para novas assinaturas e compras à vista.
              Assinaturas já criadas mantêm o valor contratado.
            </p>
            <button type="submit" class="btn">Salvar preços e promoções</button>
          </div>
        </form>
      </div>
    </main>
  </div>
</body>
</html>
