<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Planos e preços</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <style>
    .price-editor { display: flex; flex-direction: column; gap: 18px; }
    .plan-editor {
      padding: 18px 20px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface);
      box-shadow: var(--shadow-xs);
    }
    .plan-editor-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
    .plan-editor-head h2 { margin: 0; font-size: 1.1rem; }
    .plan-editor-head p { margin: 4px 0 0; }
    .price-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    .price-grid label { display: block; font-size: .78rem; color: var(--muted); margin-bottom: 4px; font-weight: 600; }
    .price-grid input { width: 100%; }
    .price-preview {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
      margin-top: 12px; padding: 10px 12px; border-radius: 10px;
      background: var(--surface-hover); border: 1px solid var(--border);
      font-size: .84rem; color: var(--muted);
    }
    .price-preview strong { color: var(--text); }
    .price-preview del { color: var(--muted); }
    .price-preview .promo { color: var(--primary); font-weight: 800; }
    .promo-pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: 999px; font-size: .66rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
    .promo-pill.on { background: var(--primary-soft); color: var(--primary); }
    .promo-pill.off { background: var(--surface-hover); color: var(--muted); }
    .price-help { margin: 8px 0 0; font-size: .78rem; line-height: 1.5; color: var(--muted); }
    @media (max-width: 1000px) { .price-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 560px) { .price-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'plans' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'plans' }) %>
      <div class="page">
        <% if (typeof ok !== 'undefined' && ok) { %><p class="success-banner"><%= ok %></p><% } %>
        <% if (typeof error !== 'undefined' && error) { %><p class="error-banner"><%= error %></p><% } %>

        <div class="page-header">
          <h1>Planos e preços</h1>
          <p class="field-hint" style="margin-top:0">
            Defina o preço normal de cada plano e, se quiser, uma promoção com preço menor e
            prazo. O app e a página pública mostram o preço original riscado ao lado do
            promocional. Depois do prazo, o preço normal volta sozinho.
          </p>
        </div>

        <form method="post" action="/admin/plans" class="price-editor">
          <% definitions.forEach(function (p) {
               var cfg = pricing[p.key];
               var hoje = new Date().toISOString().slice(0, 10);
               var promoAtiva = cfg.promoPriceCents && cfg.promoPriceCents > 0
                 && cfg.promoPriceCents < cfg.priceCents
                 && (!cfg.promoUntil || cfg.promoUntil >= hoje);
               var reais = function (cents) { return Number(cents || 0) / 100; };
               var fmt = function (cents) { return reais(cents).toFixed(2).replace('.', ','); };
          %>
          <section class="panel plan-editor">
            <div class="plan-editor-head">
              <div>
                <h2><%= p.label %></h2>
                <p class="field-hint"><%= p.description %></p>
              </div>
              <span class="promo-pill <%= promoAtiva ? 'on' : 'off' %>">
                <%= promoAtiva ? 'Promoção ativa' : (cfg.promoPriceCents ? 'Promoção programada/expirada' : 'Preço normal') %>
              </span>
            </div>

            <div class="price-grid">
              <div>
                <label for="price-<%= p.key %>">Preço normal (R$)</label>
                <input id="price-<%= p.key %>" type="text" inputmode="decimal" name="price_<%= p.key %>"
                       value="<%= fmt(cfg.priceCents) %>" placeholder="0,00" required>
              </div>
              <div>
                <label for="promo-<%= p.key %>">Preço promocional (R$)</label>
                <input id="promo-<%= p.key %>" type="text" inputmode="decimal" name="promo_<%= p.key %>"
                       value="<%= cfg.promoPriceCents ? fmt(cfg.promoPriceCents) : '' %>"
                       placeholder="Vazio = sem promoção">
              </div>
              <div>
                <label for="promo-label-<%= p.key %>">Nome da promoção</label>
                <input id="promo-label-<%= p.key %>" type="text" maxlength="60" name="promo_label_<%= p.key %>"
                       value="<%= cfg.promoLabel || '' %>" placeholder="Ex.: Black Friday">
              </div>
              <div>
                <label for="promo-until-<%= p.key %>">Promoção válida até</label>
                <input id="promo-until-<%= p.key %>" type="date" name="promo_until_<%= p.key %>"
                       value="<%= cfg.promoUntil || '' %>">
              </div>
            </div>

            <div class="price-preview">
              <% if (promoAtiva) { %>
                <span>Hoje o cliente vê</span>
                <del>R$ <%= fmt(cfg.priceCents) %></del>
                <span class="promo">R$ <%= fmt(cfg.promoPriceCents) %>/mês</span>
                <% if (cfg.promoLabel) { %><strong><%= cfg.promoLabel %></strong><% } %>
              <% } else { %>
                <span>Hoje o cliente vê</span>
                <strong>R$ <%= fmt(cfg.priceCents) %>/mês</strong>
                <% if (cfg.promoPriceCents) { %><span>· promoção fora do prazo</span><% } %>
              <% } %>
            </div>
            <p class="price-help">
              A promoção vale para novas assinaturas e compras à vista. Assinaturas já criadas
              mantêm o valor contratado.
            </p>
          </section>
          <% }); %>

          <div class="actions" style="justify-content:flex-start">
            <button type="submit" class="btn">Salvar preços e promoções</button>
          </div>
        </form>
      </div>
    </main>
  </div>
</body>
</html>
