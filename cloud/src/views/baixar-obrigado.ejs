<!doctype html>
<html lang="pt-BR">
<head>
  <%- include('partials/site/head', {
    title: 'Cadastro confirmado — baixe o Kuruk',
    description: 'Seu cadastro foi confirmado. Baixe o instalador do Kuruk para Windows e comece o teste grátis de 15 dias.'
  }) %>
  <meta name="robots" content="noindex" />
</head>
<body>
  <%- include('partials/site/topbar', { page: 'baixar', downloadUrl: downloadUrl }) %>

  <section class="page-head">
    <div class="wrap">
      <div class="crumb"><a href="/">Início</a> <span>›</span> <span>Baixar</span></div>
      <h1>Cadastro confirmado. <br /><em>Baixe o Kuruk agora.</em></h1>
      <p>
        Seu download está liberado. Se ele não começar automaticamente em alguns segundos,
        use o botão abaixo.
      </p>
    </div>
  </section>

  <section class="sec-tight">
    <div class="wrap" style="max-width:760px">
      <div class="form-card" style="text-align:center; padding:2.5rem 1.75rem">
        <div style="width:64px; height:64px; margin:0 auto 1rem; border-radius:50%; display:flex; align-items:center; justify-content:center; background:var(--primary-soft); color:var(--primary)">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </div>

        <h2 style="margin-top:0">Seu download está pronto</h2>
        <p style="color:var(--muted); font-size:1.02rem; margin-top:0">
          Instalador do Kuruk para Windows · versão <%= appVersion %>
        </p>

        <a class="btn big" href="<%= fileUrl %>" rel="noopener" style="justify-content:center">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Baixar o Kuruk para Windows
        </a>

        <p class="hero-note" style="margin-top:1rem">
          O download começa automaticamente em instantes. Se não começar, clique no botão acima.
        </p>

        <p style="margin-top:1.5rem; font-size:0.9rem; color:var(--muted)">
          Depois de instalar, é só abrir o Kuruk e ativar o teste de 15 dias.
          Precisa de ajuda? <a href="/contato">Fale com a gente</a> ou consulte a
          <a href="/wiki">wiki</a>.
        </p>
      </div>
    </div>
  </section>

  <%- include('partials/site/footer', { downloadUrl: downloadUrl, appVersion: appVersion }) %>

  <script>
    (function () {
      var url = <%- JSON.stringify(fileUrl) %>;
      window.setTimeout(function () { window.location.href = url; }, 1500);
    })();
  </script>
</body>
</html>
