<%
  var _adminPerms = typeof adminPermissions !== 'undefined' ? adminPermissions : [];
  var _adminRoleName = typeof adminRole !== 'undefined' && adminRole ? adminRole.name : 'Administrador';
%>
<div class="navbar">
  <div class="left">
    <a href="/admin" class="icon-btn" title="Início — aplicações" aria-label="Início — aplicações">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
    </a>
    <div class="navbar-search">
      <input type="search" id="global-search" placeholder="Buscar empresa, machine ID…" autocomplete="off" />
      <div id="global-search-results"></div>
    </div>
  </div>
  <a href="/admin" class="brand">
    <img id="brand-logo" class="logo-light" src="/img/landing/logo_kivo-horizontal.svg" alt="Kivo" />
    <img id="brand-logo-dark" class="logo-dark" src="/img/landing/logo_kivo-horizontal_branco.svg" alt="Kivo" style="display:none" />
  </a>
  <div class="right">
    <div class="user-menu">
      <button type="button" class="icon-btn" id="notif-btn" title="Notificações" aria-label="Notificações">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span class="notif-badge" id="notif-bell-badge" style="display:none">0</span>
      </button>
      <div class="notif-dropdown" id="notif-dropdown">
        <div class="notif-dropdown-header">Notificações</div>
        <div id="notif-list"></div>
      </div>
    </div>
    <a href="/wiki" class="icon-btn nav-wiki-btn" title="Wiki — Documentação" aria-label="Wiki — Documentação">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="17" height="17">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
      </svg>
    </a>
    <button type="button" class="theme-toggle" id="theme-toggle" title="Alternar tema" aria-label="Alternar tema">
      <svg id="theme-icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
      </svg>
      <svg id="theme-icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
    <div class="user-menu">
      <button type="button" class="user-menu-btn" id="user-menu-btn">
        <span class="avatar"><%= (typeof adminUsername !== 'undefined' && adminUsername ? adminUsername : '?').charAt(0).toUpperCase() %></span>
        <span class="username"><%= typeof adminUsername !== 'undefined' ? adminUsername : '' %></span>
      </button>
      <div class="user-menu-dropdown" id="user-menu-dropdown">
        <div class="user-menu-role">
          <span>Grupo de acesso</span>
          <strong><%= _adminRoleName %></strong>
        </div>
        <a href="/admin">Aplicações</a>
        <a href="/admin/profile">Meu perfil</a>
        <a href="/wiki">Wiki / Documentação</a>
        <% if (_adminPerms.indexOf('roles') !== -1) { %>
        <a href="/admin/cargos">Grupos de permissão</a>
        <% } %>
        <form method="post" action="/admin/logout"><button type="submit">Sair</button></form>
      </div>
    </div>
  </div>
</div>
<script>
  (function () {
    var root = document.documentElement;
    var sun = document.getElementById('theme-icon-sun');
    var moon = document.getElementById('theme-icon-moon');
    var logo = document.getElementById('brand-logo');
    var logoDark = document.getElementById('brand-logo-dark');
    function applyIcons() {
      var dark = root.getAttribute('data-theme') === 'dark';
      sun.style.display = dark ? 'none' : 'block';
      moon.style.display = dark ? 'block' : 'none';
      logo.style.display = dark ? 'none' : 'block';
      logoDark.style.display = dark ? 'block' : 'none';
    }
    applyIcons();
    document.getElementById('theme-toggle').addEventListener('click', function () {
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('kivo-theme', next); } catch (e) {}
      applyIcons();
    });

    var userBtn = document.getElementById('user-menu-btn');
    var userDropdown = document.getElementById('user-menu-dropdown');
    userBtn.addEventListener('click', function (e) { e.stopPropagation(); notifDropdown.classList.remove('open'); userDropdown.classList.toggle('open'); });

    var notifBtn = document.getElementById('notif-btn');
    var notifDropdown = document.getElementById('notif-dropdown');
    notifBtn.addEventListener('click', function (e) { e.stopPropagation(); userDropdown.classList.remove('open'); notifDropdown.classList.toggle('open'); });

    document.addEventListener('click', function () {
      userDropdown.classList.remove('open');
      notifDropdown.classList.remove('open');
    });

    // Busca global: empresa (nome/documento/uuid) e máquina (machine id).
    var searchInput = document.getElementById('global-search');
    var searchBox = document.getElementById('global-search-results');
    if (searchInput && searchBox) {
      var searchTimer = null;
      var closeSearch = function () { searchBox.style.display = 'none'; searchBox.innerHTML = ''; };
      searchInput.addEventListener('input', function () {
        var q = searchInput.value.trim();
        clearTimeout(searchTimer);
        if (q.length < 2) { closeSearch(); return; }
        searchTimer = setTimeout(function () {
          fetch('/admin/api/search?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : { results: [] }; })
            .then(function (d) {
              if (!d.results || !d.results.length) { closeSearch(); return; }
              searchBox.innerHTML = d.results.map(function (r) {
                var label = String(r.label).replace(/</g, '&lt;');
                var sub = String(r.sub).replace(/</g, '&lt;');
                return '<a href="' + r.href + '" style="display:block;padding:8px 12px;text-decoration:none;color:inherit;border-bottom:1px solid var(--border);">'
                  + '<div style="font-size:.85rem;font-weight:600;">' + label + '</div>'
                  + '<div style="font-size:.72rem;color:var(--text-muted);">' + r.type + ' · ' + sub + '</div></a>';
              }).join('');
              searchBox.style.display = 'block';
            })
            .catch(closeSearch);
        }, 220);
      });
      document.addEventListener('click', function (e) { if (!e.target.closest('.navbar-search')) closeSearch(); });
      searchInput.addEventListener('keydown', function (e) { if (e.key === 'Escape') { searchInput.value = ''; closeSearch(); } });
    }
  })();
</script>
<%- include('admin-notifications') %>
