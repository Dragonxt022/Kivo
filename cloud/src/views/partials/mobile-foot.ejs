<%#
  Barra de navegação fixa embaixo — alcance do polegar. Cada item só aparece se o usuário
  tiver a permissão correspondente, usando exatamente as mesmas chaves do desktop
  (`store.sales.view`, `finance.receivables.view`…), que vieram na concessão do acesso.

  Espera nos locals: `grant`, `ativo`.
-%>
  </main>

  <nav class="m-nav">
    <a href="/m" class="<%= ativo === 'inicio' ? 'on' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Início</span>
    </a>
    <% if (grant.permissions.includes('store.sales.view')) { %>
    <a href="/m/vendas" class="<%= ativo === 'vendas' ? 'on' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span>Vendas</span>
    </a>
    <% } %>
    <% if (grant.permissions.includes('store.quotes.view')) { %>
    <a href="/m/orcamentos" class="<%= ativo === 'orcamentos' ? 'on' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/></svg>
      <span>Orçam.</span>
    </a>
    <% } %>
    <%# Clientes entra na barra: é por onde a cobrança acontece, e cobrar é a tarefa que
        mais tira o lojista de perto do computador. %>
    <% if (grant.permissions.includes('commercial.customers.view')) { %>
    <a href="/m/clientes" class="<%= ativo === 'clientes' ? 'on' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>
      <span>Clientes</span>
    </a>
    <% } %>
    <%# Analíticos e Estoque ficam fora da barra e são alcançados pela tela inicial: cinco
        itens já é o limite de uma barra inferior legível no celular, e a cobrança ganha a
        vaga por ser tarefa diária. O estoque também segue no card de estoque crítico dos
        analíticos. %>
    <% if (grant.permissions.includes('finance.payables.view') || grant.permissions.includes('finance.receivables.view')) { %>
    <a href="/m/financeiro" class="<%= ativo === 'financeiro' ? 'on' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
      <span>Financeiro</span>
    </a>
    <% } %>
  </nav>
</body>
</html>
