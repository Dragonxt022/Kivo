<%#
  Topo de toda tela do Kivo Web. Sem engine de layout no projeto, o par head/foot é o
  padrão EJS puro — mesma abordagem do resto da nuvem.

  Espera nos locals: `titulo`, `grant`, `fresh`.
-%>
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ff8000">
  <%- include('theme-init') %>
  <title><%= titulo %> — Kivo</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%# Instalável na tela inicial: o manifest deixa o painel abrir em tela cheia, sem a
      barra do navegador, com ícone e cor próprios. O service worker (escopo /m/) só
      acelera CSS/imagens — HTML autenticado nunca é cacheado. %>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Kivo">
  <%- include('styles') %>
  <link rel="stylesheet" href="/css/mobile.css">
  <%# Camada de componentes (KPI, folha inferior, stepper, barra de ação). Arquivo à
      parte e não dentro de mobile.css para deixar claro o que é casca e o que é
      componente — e para o diff de um ajuste de layout não se misturar com o da casca. %>
  <link rel="stylesheet" href="/css/mobile-pro.css">
</head>
<%# `bodyClass` deixa a tela pedir espaço extra embaixo quando tem barra de ação fixa. %>
<body class="m-body <%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <header class="m-header">
    <%# Voltar. Nasce escondido e é revelado pelo script no fim deste arquivo só fora da
        tela inicial — assim não pisca antes de o JS decidir. Sem ele, a única saída de uma
        tela interna era a barra de baixo (que algumas telas escondem) ou o gesto do
        navegador, que boa parte dos lojistas não usa. %>
    <button type="button" class="m-header-back" id="m-voltar" hidden
            onclick="mVoltar()" aria-label="Voltar para a tela anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
    </button>
    <div class="m-header-text">
      <span class="m-header-company"><%= grant.companyName || 'Minha loja' %></span>
      <h1 class="m-header-title"><%= titulo %></h1>
    </div>
    <%# Pede ao computador da loja um sync agora. O painel lê o último sync, então sem
        isto o lojista só espera o ciclo automático (até 3 min) para ver a venda que acabou
        de sair no caixa. %>
    <button type="button" class="m-header-sync" id="m-sync-btn" onclick="mSincronizar()"
            title="Pedir atualização ao computador da loja" aria-label="Atualizar dados">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
    </button>
    <a class="m-header-user" href="/m/sair" title="Sair">
      <span><%= (grant.name || grant.username).split(' ')[0] %></span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    </a>
  </header>

  <%# O painel mostra o estado do ÚLTIMO sync do computador da loja. Número velho
      apresentado como atual seria pior do que número nenhum — por isso o aviso é parte
      fixa da casca, e não um detalhe de uma tela só. %>
  <% if (fresh.minutesAgo === null) { %>
    <p class="m-stale m-stale-hard">O computador da loja ainda não sincronizou nada.</p>
  <% } else if (fresh.minutesAgo > 30) { %>
    <p class="m-stale m-stale-hard">
      Dados de <%= fresh.minutesAgo >= 120 ? Math.round(fresh.minutesAgo / 60) + ' h' : fresh.minutesAgo + ' min' %> atrás — o computador da loja não está sincronizando.
    </p>
  <% } else { %>
    <p class="m-stale">Atualizado há <%= fresh.minutesAgo %> min</p>
  <% } %>

  <script>
    // Profundidade da navegação gravada na própria entrada do histórico. Serve para o
    // Voltar saber se existe tela ANTERIOR DENTRO do Kivo Web: quem abriu o app pelo link
    // do WhatsApp já cai numa tela interna, e um history.back() cru o mandaria de volta
    // para a conversa, para fora do app. Profundidade 1 = primeira tela desta aba.
    (function () {
      var st = history.state || {};
      if (st.mDepth == null) {
        var anterior = 0;
        try { anterior = Number(sessionStorage.getItem('kivo-m-depth') || 0); } catch (e) {}
        st.mDepth = anterior + 1;
        history.replaceState(st, '');
        try { sessionStorage.setItem('kivo-m-depth', String(st.mDepth)); } catch (e) {}
      } else {
        try { sessionStorage.setItem('kivo-m-depth', String(st.mDepth)); } catch (e) {}
      }
      var b = document.getElementById('m-voltar');
      if (b && location.pathname !== '/m' && location.pathname !== '/m/') b.hidden = false;
    })();
    function mVoltar() {
      var d = (history.state || {}).mDepth || 1;
      if (d > 1) history.back();
      else location.href = '/m';
    }
  </script>

  <script>
    // PWA: escopo /m/ para o worker nunca tocar no painel admin nem nas APIs. Falha é
    // silenciosa — o painel funciona igual sem o service worker.
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js', { scope: '/m/' }).catch(function () {});
      });
    }

    /**
     * Pede ao desktop um sync agora e recarrega quando ele deve ter terminado. O recado de
     * "computador desligado" vem do servidor (canal SSE aberto), não de um timeout: prometer
     * atualização com ninguém escutando seria mentir.
     */
    function mSincronizar() {
      var b = document.getElementById('m-sync-btn');
      if (!b || b.disabled) return;
      b.disabled = true;
      b.classList.add('girando');
      function parar() {
        b.disabled = false;
        b.classList.remove('girando');
      }
      fetch('/api/mobile/sync-now', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (d) {
          if (!d.desktopOnline) {
            parar();
            alert('O computador da loja parece estar desligado ou sem internet. Assim que ele voltar, os dados se atualizam sozinhos.');
            return;
          }
          // Dá tempo do desktop puxar/empurrar antes de reler o painel.
          setTimeout(function () { location.reload(); }, 4000);
        })
        .catch(function () {
          parar();
          alert('Não foi possível pedir a atualização agora. Tente de novo.');
        });
    }
  </script>

  <main class="m-main">
