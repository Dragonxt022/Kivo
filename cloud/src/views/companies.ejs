<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kuruk Cloud — Empresas</title>
  <link rel="icon" type="image/png" href="/logo_kuruk-icon.png">
  <%- include('partials/styles') %>
  <script defer src="/vendor/alpine.min.js"></script>
  <style>
    .module-pills { display: flex; flex-wrap: wrap; gap: 3px; max-width: 220px; }
    .module-pill {
      padding: 2px 7px;
      border: 1px solid var(--border-light);
      border-radius: 999px;
      background: var(--surface-hover);
      color: var(--text-secondary);
      font-size: 0.66rem;
      white-space: nowrap;
    }
    .module-more { color: var(--muted); font-size: 0.68rem; line-height: 1.6; }
    .contract-link {
      color: var(--primary);
      border-color: color-mix(in srgb, var(--primary) 32%, var(--border));
      background: var(--primary-soft);
    }
  </style>
</head>
<body>
  <%- include('partials/plan-icons') %>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'companies' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'companies' }) %>

      <div class="page page-wide" x-data="companiesTable()">
        <% if (typeof ok !== 'undefined' && ok) { %><p class="success-banner"><%= ok %></p><% } %>
        <div class="page-header">
          <div>
            <div class="breadcrumb">Geral</div>
            <h1>Empresas</h1>
          </div>
          <div class="header-actions">
            <a href="/admin/companies/export.csv" class="btn secondary">Exportar CSV</a>
            <button type="button" class="btn danger" x-show="expiredTrials.length" x-cloak
                    @click="document.getElementById('modal-purge-trials').showModal()">
              Excluir testes vencidos (<span x-text="expiredTrials.length"></span>)
            </button>
            <button class="btn" onclick="document.getElementById('modal-new-company').showModal()">+ Nova empresa</button>
          </div>
        </div>

        <div class="card table-card">
          <div class="table-toolbar">
            <div class="table-search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" placeholder="Buscar por nome…" x-model="q" @input="page = 1" aria-label="Buscar empresa por nome">
            </div>
            <div class="filter-chips" role="group" aria-label="Filtrar por plano">
              <button type="button" class="chip" :class="{ active: planFilter === '' }" @click="planFilter = ''; page = 1">Todas</button>
              <% planTiers.forEach(function (tier) { %>
              <button type="button" class="chip" :class="{ active: planFilter === '<%= tier %>' }" @click="planFilter = '<%= tier %>'; page = 1"><%= planLabels[tier] %></button>
              <% }) %>
              <button type="button" class="chip" :class="{ active: planFilter === '__none' }" @click="planFilter = '__none'; page = 1">Sem plano</button>
              <button type="button" class="chip" :class="{ active: planFilter === '__expired_trial' }"
                      @click="planFilter = '__expired_trial'; page = 1">
                Teste vencido (<span x-text="expiredTrials.length"></span>)
              </button>
            </div>
            <div class="table-count" x-text="countLabel"></div>
          </div>

          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th class="sortable" @click="sortCycle('name')">Nome<span class="sort-arrow" x-text="sortArrow('name')"></span></th>
                  <th class="sortable" @click="sortCycle('plan')">Plano<span class="sort-arrow" x-text="sortArrow('plan')"></span></th>
                  <th>Módulos</th>
                  <th class="sortable" @click="sortCycle('valid_until')">Validade<span class="sort-arrow" x-text="sortArrow('valid_until')"></span></th>
                  <th class="sortable text-right" @click="sortCycle('sync_count')">Sincronizações<span class="sort-arrow" x-text="sortArrow('sync_count')"></span></th>
                  <th class="sortable" @click="sortCycle('last_activity')">Última atividade<span class="sort-arrow" x-text="sortArrow('last_activity')"></span></th>
                  <th class="sortable text-right" @click="sortCycle('pending_cents')">Pendente<span class="sort-arrow" x-text="sortArrow('pending_cents')"></span></th>
                  <th class="text-right">Ações</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="c in displayRows" :key="c.company_uuid">
                  <tr>
                    <td>
                      <div class="company-line">
                        <a :href="'/admin/companies/' + c.company_uuid" class="cell-name" x-text="c.name || c.company_uuid"></a>
                        <button type="button" class="icon-btn xs contract-link" x-show="c.contracts && c.contracts.length" x-cloak
                                @click="openContracts(c)"
                                :title="(c.contracts || []).length + ' contrato(s) vinculado(s)'"
                                aria-label="Ver contratos vinculados">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
                        </button>
                      </div>
                      <div class="cell-sub" x-show="c.contact_name || c.phone"
                           x-text="[c.contact_name, c.phone].filter(Boolean).join(' · ')"></div>
                      <div class="cell-sub" x-show="!c.contact_name && !c.phone" x-text="c.company_uuid.slice(0, 8)"></div>
                    </td>
                    <td>
                      <span class="plan-seal" :class="'plan-seal--' + sealKey(c.plan)">
                        <svg class="plan-seal-icon"><use :href="'#plan-icon-' + sealKey(c.plan)"/></svg>
                        <span x-text="c.plan ? (planLabels[c.plan] || c.plan) : 'Sem plano'"></span>
                      </span>
                    </td>
                    <td class="cell-modules">
                      <template x-if="c.modules && c.modules.length">
                        <div class="module-pills">
                          <template x-for="mod in c.modules.slice(0, 2)" :key="mod">
                            <span class="module-pill" x-text="mod"></span>
                          </template>
                          <span class="module-more" x-show="c.modules.length > 2" x-text="'+' + (c.modules.length - 2)"></span>
                        </div>
                      </template>
                      <span class="cell-muted" x-show="!c.modules || !c.modules.length">sem restrição</span>
                    </td>
                    <td>
                      <span :class="expiryClass(c.valid_until)" x-text="c.valid_until ? fmtDate(c.valid_until) : '—'"></span>
                    </td>
                    <td class="text-right tabular" x-text="Number(c.sync_count).toLocaleString('pt-BR')"></td>
                    <td class="cell-muted" x-text="c.last_activity ? fmtDateTime(c.last_activity) : 'nunca'"></td>
                    <td class="text-right tabular">
                      <span class="badge money-pending" x-show="c.pending_cents > 0" x-text="brl(c.pending_cents)"></span>
                      <span class="cell-muted" x-show="!(c.pending_cents > 0)">—</span>
                    </td>
                    <td class="text-right">
                      <div class="companies-actions">
                        <form method="post" :action="'/admin/companies/' + c.company_uuid + '/delete'"
                              @submit.prevent="if (confirm('Excluir ' + (c.plan === 'trial' ? 'o teste' : 'a licença') + ' de ' + (c.name || c.company_uuid) + '? Todos os dados dessa empresa serão apagados. Não dá para desfazer.')) $el.submit()">
                          <button type="submit" class="icon-btn xs danger"
                                  :title="c.plan === 'trial' ? 'Excluir teste' : 'Excluir empresa'"
                                  :aria-label="c.plan === 'trial' ? 'Excluir teste' : 'Excluir empresa'">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                </template>
                <tr x-show="!displayRows.length">
                  <td colspan="8">
                    <div class="empty-state-box">
                      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                      <p x-text="rows.length ? 'Nenhuma empresa corresponde ao filtro.' : 'Nenhuma empresa cadastrada ainda.'"></p>
                      <button type="button" class="btn secondary small" x-show="rows.length" @click="q = ''; planFilter = ''; page = 1">Limpar filtros</button>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="table-footer">
            <%- include('partials/pager') %>
          </div>
        </div>

        <dialog id="modal-purge-trials">
          <form method="post" action="/admin/companies/purge-expired-trials">
            <div class="modal-header">
              <h2>Excluir testes vencidos?</h2>
              <button type="button" class="modal-close" onclick="document.getElementById('modal-purge-trials').close()">&times;</button>
            </div>
            <div class="modal-body">
              <p>
                Isso vai apagar <strong x-text="expiredTrials.length"></strong> empresa(s) de teste com o prazo
                vencido e <strong>todos os dados</strong> delas: sincronizações, backups, cobranças, chamados,
                uso de IA e telemetria.
              </p>
              <p class="field-hint">
                As imagens do banco de imagens são compartilhadas e permanecem. A máquina volta a poder
                solicitar o teste grátis. Não dá para desfazer.
              </p>
            </div>
            <div class="modal-actions">
              <button type="button" class="btn secondary" onclick="document.getElementById('modal-purge-trials').close()">Cancelar</button>
              <button type="submit" class="btn danger">Sim, excluir tudo</button>
            </div>
          </form>
        </dialog>

        <dialog id="modal-company-contracts" class="modal-wide">
          <div class="modal-header">
            <h2>Contratos vinculados</h2>
            <button type="button" class="modal-close" @click="closeContracts()">&times;</button>
          </div>
          <div class="modal-body">
            <p class="field-hint" style="margin-top:0" x-show="contractsFor">
              Empresa: <strong x-text="contractsFor ? (contractsFor.name || contractsFor.company_uuid) : ''"></strong>
            </p>
            <div class="contract-list">
              <template x-for="ct in (contractsFor ? contractsFor.contracts : [])" :key="ct.id">
                <div class="contract-item">
                  <div class="contract-item-head">
                    <strong x-text="ct.contract_number"></strong>
                    <span class="badge" :class="ct.status" x-text="ct.status"></span>
                  </div>
                  <div class="contract-item-title" x-text="ct.title || 'Sem descrição'"></div>
                  <div class="contract-item-meta">
                    <span>Prazo: <strong x-text="ct.months + ' meses'"></strong></span>
                    <span>Mensal: <strong x-text="brl(ct.monthly_amount_cents)"></strong></span>
                    <span>Parcelas: <strong x-text="Number(ct.pagas) + '/' + Number(ct.parcelas)"></strong></span>
                    <span>Próximo venc.: <strong x-text="ct.proximo_vencimento ? fmtDate(ct.proximo_vencimento) : '—'"></strong></span>
                  </div>
                  <div class="contract-item-actions">
                    <a class="btn secondary small" :href="'/admin/contracts/' + ct.id">Abrir contrato</a>
                    <a class="btn secondary small" x-show="ct.document_file" x-cloak
                       :href="'/admin/contracts/' + ct.id + '/document'" target="_blank" rel="noopener">PDF assinado</a>
                  </div>
                </div>
              </template>
              <p class="field-hint" style="margin:0" x-show="contractsFor && (!contractsFor.contracts || !contractsFor.contracts.length)">
                Nenhum contrato vinculado a esta empresa.
              </p>
            </div>
          </div>
          <div class="modal-actions">
            <button type="button" class="btn secondary" @click="closeContracts()">Fechar</button>
          </div>
        </dialog>
      </div>
    </main>
  </div>

  <dialog id="modal-new-company">
    <form method="post" action="/admin/companies">
      <div class="modal-header">
        <h2>Nova empresa</h2>
        <button type="button" class="modal-close" onclick="document.getElementById('modal-new-company').close()">&times;</button>
      </div>
      <div class="modal-body">
        <label>Nome</label>
        <input type="text" name="name" required autofocus>
        <label>Plano</label>
        <%- include('partials/plan-picker', { selectedPlan: '' }) %>
        <label>Válido até</label>
        <input type="date" name="validUntil">
        <p class="field-hint">Deixe em branco no plano Trial para usar automaticamente hoje + 15 dias.</p>
        <%- include('partials/module-toggles', { checkedModules: [] }) %>
        <div class="modal-actions">
          <button type="button" class="btn secondary" onclick="document.getElementById('modal-new-company').close()">Cancelar</button>
          <button type="submit" class="btn">Criar empresa</button>
        </div>
      </div>
    </form>
  </dialog>

  <script src="/js/table-toolkit.js"></script>
  <script>
    function companiesTable() {
      return {
        ...tableToolkit(),
        rows: <%- JSON.stringify(companies).replace(/</g, '\\u003c') %>,
        planLabels: <%- JSON.stringify(planLabels) %>,
        planTiers: <%- JSON.stringify(planTiers) %>,
        q: '',
        planFilter: '',
        contractsFor: null,
        openContracts(company) {
          this.contractsFor = company;
          document.getElementById('modal-company-contracts').showModal();
        },
        closeContracts() {
          const dialog = document.getElementById('modal-company-contracts');
          if (dialog.open) dialog.close();
          this.contractsFor = null;
        },
        /** Plano legado (fora dos tiers) não tem selo próprio — cai no neutro. */
        sealKey(plan) {
          return plan && this.planTiers.includes(plan) ? plan : 'none';
        },
        /** Teste grátis cujo prazo já passou — candidato à limpeza em lote. */
        isExpiredTrial(c) {
          if (c.plan !== 'trial' || !c.valid_until) return false;
          return new Date(String(c.valid_until).slice(0, 10)) < new Date(new Date().setHours(0, 0, 0, 0));
        },
        get expiredTrials() {
          return this.rows.filter((c) => this.isExpiredTrial(c));
        },
        sortGetters: {
          name: (c) => (c.name || c.company_uuid).toLowerCase(),
          plan: (c) => c.plan || '',
          valid_until: (c) => c.valid_until || '',
          sync_count: (c) => Number(c.sync_count),
          last_activity: (c) => c.last_activity || '',
          pending_cents: (c) => Number(c.pending_cents),
        },
        brl(cents) {
          return (Number(cents) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        },
        fmtDate(v) {
          const s = String(v).slice(0, 10).split('-');
          return s[2] + '/' + s[1] + '/' + s[0];
        },
        fmtDateTime(v) {
          const s = String(v);
          return this.fmtDate(s) + ' ' + s.slice(11, 16);
        },
        /** Validade vencida/próxima merece destaque — é o dado que o admin caça nesta tela. */
        expiryClass(v) {
          if (!v) return 'cell-muted';
          const days = (new Date(String(v).slice(0, 10)) - new Date().setHours(0, 0, 0, 0)) / 86400000;
          if (days < 0) return 'expiry expired';
          if (days <= 7) return 'expiry soon';
          return '';
        },
        get filteredRows() {
          const q = this.q.trim().toLowerCase();
          return this.rows.filter((c) => {
            if (q && !(c.name || c.company_uuid).toLowerCase().includes(q)) return false;
            if (this.planFilter === '__none') return !c.plan;
            if (this.planFilter === '__expired_trial') return this.isExpiredTrial(c);
            if (this.planFilter) return c.plan === this.planFilter;
            return true;
          });
        },
        /** O paginador do partial lê `pageTotal`: total já filtrado, antes de fatiar. */
        get pageTotal() {
          return this.filteredRows.length;
        },
        get displayRows() {
          return this.pagedRows(this.sortedRows(this.filteredRows, this.sortGetters));
        },
        get countLabel() {
          const n = this.pageTotal;
          const total = this.rows.length;
          return n === total ? `${total} empresa${total === 1 ? '' : 's'}` : `${n} de ${total}`;
        },
      };
    }
  </script>
</body>
</html>
