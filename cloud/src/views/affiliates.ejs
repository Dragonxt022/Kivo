<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Afiliados</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <script defer src="/vendor/alpine.min.js"></script>
  <style>
    .affiliate-note { display: flex; gap: 10px; align-items: flex-start; }
    .affiliate-note svg { flex: none; color: var(--primary, #ff8000); margin-top: 2px; }
    .aff-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .aff-actions form { display: inline; margin: 0; }
    .aff-actions button { border: 0; background: transparent; cursor: pointer; color: #2563eb; font-size: 12px; padding: 2px 4px; }
    .aff-actions button.danger { color: #dc2626; }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'affiliates' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'affiliates' }) %>

      <%
        function brl(c) { return (Number(c || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }
        var t = totals || { available: 0, requested: 0, paid: 0, activeCount: 0 };
      %>

      <div class="page">
        <div class="page-header">
          <div>
            <div class="breadcrumb">Geral</div>
            <h1>Afiliados</h1>
          </div>
          <button class="btn" onclick="window.document.getElementById('modal-new-affiliate').showModal()">+ Novo afiliado</button>
        </div>

        <% if (typeof ok !== 'undefined' && ok) { %><p class="success-banner">Operação realizada com sucesso.</p><% } %>
        <% if (typeof error !== 'undefined' && error) { %><p class="error-banner"><%= error %></p><% } %>

        <div class="card">
          <div class="stat-row">
            <div class="stat"><div class="value"><%= t.activeCount %></div><div class="label">Afiliados ativos</div></div>
            <div class="stat"><div class="value"><%= brl(t.available) %></div><div class="label">Comissões disponíveis</div></div>
            <div class="stat"><div class="value"><%= brl(t.requested) %></div><div class="label">Aguardando pagamento</div></div>
            <div class="stat"><div class="value"><%= brl(t.paid) %></div><div class="label">Já pago (total)</div></div>
          </div>
        </div>

        <div class="card affiliate-note">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <div>
            <strong>Como funciona o afiliado</strong>
            <p style="margin:6px 0 0; font-size:13px; line-height:1.5;">
              Cadastre cada representante (por cidade) e defina o <strong>percentual de comissão</strong> que ele
              ganha sobre o que for recebido das empresas que indicar. Na ficha da empresa (aba <em>Licença</em>)
              você escolhe o afiliado responsável. Toda cobrança marcada como <strong>paga</strong> lança
              automaticamente o crédito de comissão. O pagamento é feito em <a href="/admin/payouts">Pagamentos</a>,
              e o afiliado pode acompanhar tudo pelo próprio portal em <code>/afiliado</code>.
            </p>
          </div>
        </div>

        <div class="card table-card">
          <div class="table-toolbar">
            <h2 style="margin:0; font-size:1.05rem;">Afiliados cadastrados</h2>
            <div class="table-count"><%= affiliates.length %> afiliado<%= affiliates.length === 1 ? '' : 's' %></div>
          </div>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Nome</th>
                  <th>Cidade</th>
                  <th class="text-right">Desconto</th>
                  <th class="text-right">Comissão</th>
                  <th class="text-right">Empresas</th>
                  <th class="text-right">Disponível</th>
                  <th>Portal</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% affiliates.forEach(function(a) { %>
                <tr>
                  <td>
                    <a href="/admin/affiliates/<%= a.id %>"><strong><%= a.name %></strong></a>
                    <% if (a.contact) { %><div class="cell-sub"><%= a.contact %></div><% } %>
                  </td>
                  <td class="cell-muted"><%= a.city || '—' %></td>
                  <td class="text-right tabular"><%= a.discount_pct %>%</td>
                  <td class="text-right tabular"><strong><%= a.commission_pct %>%</strong></td>
                  <td class="text-right tabular"><%= a.companies_count %></td>
                  <td class="text-right tabular"><%= brl(a.available_cents) %></td>
                  <td>
                    <% if (a.username) { %><span class="badge paga">Sim</span><% } else { %><span class="cell-muted">—</span><% } %>
                  </td>
                  <td><span class="badge <%= a.active ? 'paga' : 'cancelada' %>"><%= a.active ? 'Ativo' : 'Inativo' %></span></td>
                  <td>
                    <div class="aff-actions">
                      <a href="/admin/affiliates/<%= a.id %>" style="font-size:12px;color:#2563eb;padding:2px 4px;">Ver</a>
                      <form method="post" action="/admin/affiliates/<%= a.id %>/toggle">
                        <button type="submit"><%= a.active ? 'Desativar' : 'Ativar' %></button>
                      </form>
                      <form method="post" action="/admin/affiliates/<%= a.id %>/delete"
                            onsubmit="return confirm('Remover <%= a.name %>? As empresas ligadas a ele voltam a pagar o valor cheio.');">
                        <button type="submit" class="danger">Excluir</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }); %>
                <% if (!affiliates.length) { %>
                  <tr><td colspan="9"><%- include('partials/empty-state', { message: 'Nenhum afiliado cadastrado ainda.' }) %></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <dialog id="modal-new-affiliate">
    <form method="post" action="/admin/affiliates">
      <div class="modal-header">
        <h2>Novo afiliado</h2>
        <button type="button" class="modal-close" onclick="window.document.getElementById('modal-new-affiliate').close()">&times;</button>
      </div>
      <div class="modal-body">
        <label>Nome</label>
        <input type="text" name="name" required maxlength="120" placeholder="Quem indica / representa">

        <div class="form-grid">
          <div class="field col-6">
            <label>Cidade</label>
            <input type="text" name="city" maxlength="120" placeholder="Cidade de atuação">
          </div>
          <div class="field col-6">
            <label>Documento (opcional)</label>
            <input type="text" name="document" maxlength="40" placeholder="CPF/CNPJ">
          </div>
        </div>

        <label>Contato (opcional)</label>
        <input type="text" name="contact" maxlength="160" placeholder="WhatsApp, e-mail…">

        <div class="form-grid">
          <div class="field col-6">
            <label>Desconto para o cliente (%)</label>
            <input type="number" name="discountPct" min="0" max="100" value="0" required>
          </div>
          <div class="field col-6">
            <label>Comissão do afiliado (%)</label>
            <input type="number" name="commissionPct" min="0" max="100" value="10" required>
          </div>
        </div>
        <p class="field-hint">O desconto é aplicado à cobrança da empresa indicada; a comissão é o quanto o afiliado ganha quando essa cobrança é recebida.</p>

        <label>Chave PIX (opcional)</label>
        <input type="text" name="pixKey" maxlength="160" placeholder="Para pagamento das comissões">

        <label>Observações (opcional)</label>
        <input type="text" name="notes" maxlength="255" placeholder="Anotações internas">

        <hr style="border:0;border-top:1px solid var(--border);margin:16px 0">
        <label style="margin-bottom:6px">Acesso ao portal (opcional)</label>
        <p class="field-hint" style="margin-top:0">Se preencher usuário e senha, o afiliado entra em <code>/afiliado</code> e acompanha as indicações e comissões dele.</p>
        <div class="form-grid">
          <div class="field col-6">
            <label>Usuário</label>
            <input type="text" name="portalUser" maxlength="60" autocomplete="off" placeholder="ex.: joao.centro">
          </div>
          <div class="field col-6">
            <label>Senha</label>
            <input type="text" name="portalPassword" maxlength="60" autocomplete="off" placeholder="mínimo 6 caracteres">
          </div>
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn secondary" onclick="window.document.getElementById('modal-new-affiliate').close()">Cancelar</button>
        <button type="submit" class="btn">Cadastrar afiliado</button>
      </div>
    </form>
  </dialog>
</body>
</html>
