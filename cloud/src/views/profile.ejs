<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Meu perfil</title>
  <%- include('partials/styles') %>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', {}) %>
    <main class="content">
      <%- include('partials/navbar', {}) %>

      <div class="page" style="max-width: 560px;">
        <div class="page-header">
          <h1>Meu perfil</h1>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <p class="error-banner"><%= error %></p>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <p class="success-banner"><%= success %></p>
        <% } %>

        <div class="card">
          <h2>Conta</h2>
          <table>
            <tbody>
              <tr><th>Usuário</th><td><%= admin.username %></td></tr>
              <tr><th>Criado em</th><td><%= fmtDateTimeBr(admin.created_at) %></td></tr>
            </tbody>
          </table>

          <h3 style="margin:18px 0 4px;">E-mail de recuperação</h3>
          <p class="field-hint" style="margin-top:0">
            Usado pelo "Esqueci minha senha" na tela de login. Sem um e-mail aqui, a recuperação automática não funciona.
          </p>
          <form method="post" action="/admin/profile/email">
            <label>E-mail</label>
            <input type="email" name="email" value="<%= admin.email || '' %>" placeholder="seu_email@gmail.com">
            <div class="modal-actions" style="justify-content: flex-start;">
              <button type="submit" class="btn">Salvar e-mail</button>
            </div>
          </form>
        </div>

        <div class="card">
          <h2>Trocar senha</h2>
          <form method="post" action="/admin/profile/password">
            <label>Senha atual</label>
            <input type="password" name="currentPassword" required autocomplete="current-password">
            <label>Nova senha</label>
            <input type="password" name="newPassword" required minlength="8" autocomplete="new-password">
            <label>Confirmar nova senha</label>
            <input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password">
            <div class="modal-actions" style="justify-content: flex-start;">
              <button type="submit" class="btn">Salvar nova senha</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
