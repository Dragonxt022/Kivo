<%- include('partials/mobile-head', { titulo: 'Orçamentos', grant, fresh }) %>

<% if (!quotes.length) { %>
  <p class="m-empty">Nenhum orçamento sincronizado ainda.</p>
<% } else { %>
  <ul class="m-list">
    <% quotes.forEach(function (q) { %>
      <li>
        <div class="m-list-static">
          <span class="m-list-main">
            <%= q.payload.customer_name || 'Sem cliente' %>
            <% if (q.payload.status !== 'aberto') { %>
              <span class="m-badge m-badge-off"><%= q.payload.status %></span>
            <% } %>
          </span>
          <span class="m-list-meta">
            <%= (q.payload.created_at || '').slice(0, 10).split('-').reverse().join('/') %>
            <% if (q.payload.valid_until) { %> · vale até <%= q.payload.valid_until.split('-').reverse().join('/') %><% } %>
          </span>
          <strong class="m-list-value">R$ <%= brl(q.payload.total_cents) %></strong>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>

<% if (podeCriar) { %>
  <a class="m-fab" href="/m/orcamentos/novo">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Novo
  </a>
<% } %>

<%- include('partials/mobile-foot', { grant, ativo: 'orcamentos' }) %>
