<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Contratos</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <style>
    .contrato-num { font-weight: 700; }
    .contrato-titulo { color: var(--muted); font-size: .82rem; }
    .contrato-acoes { display: flex; gap: 6px; justify-content: flex-end; flex-wrap: wrap; }
    .contrato-acoes form { margin: 0; }
    .filtros { display: flex; gap: 6px; flex-wrap: wrap; }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'contracts' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'contracts' }) %>

      <div class="page">
        <% if (typeof ok !== 'undefined' && ok) { %><p class="success-banner"><%= ok %></p><% } %>
        <% if (typeof error !== 'undefined' && error) { %><p class="error-banner"><%= error %></p><% } %>

        <div class="page-header">
          <h1>Contratos</h1>
          <p class="field-hint" style="margin-top:0">
            O contrato assinado do cliente e o bloco de cobranças que ele gera: 12 meses viram
            12 parcelas mensais, cada uma com vencimento próprio e pagável por Pix, boleto ou
            cartão — e a licença anda sozinha a cada parcela paga.
          </p>
        </div>

        <div class="card table-card">
          <div class="table-toolbar">
            <div class="filtros" role="group" aria-label="Filtrar por situação">
              <a class="chip <%= filtroStatus === '' ? 'active' : '' %>" href="/admin/contracts">Todos</a>
              <a class="chip <%= filtroStatus === 'ativo' ? 'active' : '' %>" href="/admin/contracts?status=ativo">Ativos</a>
              <a class="chip <%= filtroStatus === 'concluido' ? 'active' : '' %>" href="/admin/contracts?status=concluido">Concluídos</a>
              <a class="chip <%= filtroStatus === 'cancelado' ? 'active' : '' %>" href="/admin/contracts?status=cancelado">Cancelados</a>
            </div>
            <div class="table-count"><%= contratos.length %> contrato(s)</div>
            <button class="btn small" type="button" onclick="document.getElementById('modal-novo-contrato').showModal()">+ Novo contrato</button>
          </div>

          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Contrato</th><th>Empresa</th><th>Prazo</th><th class="text-right">Valor mensal</th>
                  <th>Parcelas</th><th>Situação</th><th>PDF</th><th></th>
                </tr>
              </thead>
              <tbody>
                <% contratos.forEach(function (c) { %>
                  <tr>
                    <td>
                      <div class="contrato-num"><a href="/admin/contracts/<%= c.id %>"><%= c.contract_number %></a></div>
                      <% if (c.title) { %><div class="contrato-titulo"><%= c.title %></div><% } %>
                    </td>
                    <td><a href="/admin/companies/<%= c.company_uuid %>"><%= c.company_name || '—' %></a></td>
                    <td><%= c.months %> meses</td>
                    <td class="text-right tabular">R$ <%= (c.monthly_amount_cents / 100).toFixed(2).replace('.', ',') %></td>
                    <td><%= progresso(c) %></td>
                    <td><span class="badge <%= c.status %>"><%= c.status %></span></td>
                    <td>
                      <% if (c.document_file) { %>
                        <a href="/admin/contracts/<%= c.id %>/document" target="_blank" rel="noopener" title="<%= c.document_name %>">assinado</a>
                      <% } else { %>
                        <span class="cell-muted">—</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="contrato-acoes">
                        <a class="btn secondary small" href="/admin/contracts/<%= c.id %>">Abrir</a>
                        <form method="post" action="/admin/contracts/<%= c.id %>/charges">
                          <button type="submit" class="btn secondary small" title="Gera as parcelas que faltarem">Parcelas</button>
                        </form>
                        <% if (c.status === 'ativo') { %>
                          <form method="post" action="/admin/contracts/<%= c.id %>/cancel"
                                onsubmit="return confirm('Cancelar o contrato <%= c.contract_number %> e as parcelas em aberto? As já pagas continuam no histórico.');">
                            <button type="submit" class="btn secondary small danger">Cancelar</button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
                <% if (!contratos.length) { %>
                  <tr><td colspan="8"><%- include('partials/empty-state', { message: 'Nenhum contrato ainda. Crie o primeiro depois do teste de 15 dias.' }) %></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <dialog id="modal-novo-contrato">
    <form id="form-contrato">
      <div class="modal-header">
        <h2>Novo contrato</h2>
        <button type="button" class="modal-close" onclick="document.getElementById('modal-novo-contrato').close()">&times;</button>
      </div>
      <div class="modal-body">
        <label>Empresa</label>
        <select name="companyUuid" id="f-empresa" required>
          <option value="">Escolha a empresa…</option>
          <% empresas.forEach(function (e) { %>
            <option value="<%= e.company_uuid %>"><%= e.name %></option>
          <% }); %>
        </select>

        <label>Descrição do contrato</label>
        <input type="text" name="title" id="f-titulo" maxlength="160" placeholder="Ex.: Assinatura Kivo — plano Diamante">
        <p class="field-hint">Aparece na descrição de cada parcela, na tela de Cobranças do cliente.</p>

        <label>Número do contrato</label>
        <input type="text" name="contractNumber" id="f-numero" maxlength="40" placeholder="deixe em branco para gerar (KIVO-2026-0001)">
        <p class="field-hint">Pode digitar o número do seu modelo; em branco o Kivo numera sozinho.</p>

        <label>Prazo (meses)</label>
        <input type="number" name="months" id="f-meses" min="1" max="120" value="12" required oninput="preverContrato()">

        <label>Valor mensal (R$)</label>
        <input type="text" name="monthlyAmount" id="f-valor" inputmode="decimal" placeholder="199,90" required oninput="preverContrato()">

        <label>Primeiro vencimento</label>
        <input type="date" name="firstDueDate" id="f-venc" required oninput="preverContrato()">
        <p class="field-hint">As outras parcelas caem no mesmo dia dos meses seguintes (dia 31 vira o último dia do mês).</p>

        <label>Estende a licença em (dias por parcela paga)</label>
        <input type="number" name="extendsDays" id="f-dias" min="0" max="3650" value="30">

        <label>E-mail do pagador (opcional)</label>
        <input type="email" name="payerEmail" id="f-email" placeholder="financeiro@cliente.com.br">
        <p class="field-hint">O Pix exige e-mail. Em branco, o Kivo usa o e-mail do cadastro da empresa.</p>

        <label>Data de assinatura (opcional)</label>
        <input type="date" name="signedOn" id="f-assinatura">

        <label>Contrato em PDF (até <%= maxPdfMb %> MB)</label>
        <input type="file" id="f-pdf" accept="application/pdf">
        <p class="field-hint">Fica guardado no servidor e disponível para baixar no contrato.</p>

        <label>Observações (opcional)</label>
        <textarea name="notes" id="f-obs" rows="2" placeholder="Ex.: combinado reajuste anual, contato do financeiro..."></textarea>

        <p class="contrato-previa" id="previsao">Preencha prazo, valor e o primeiro vencimento para ver o que será gerado.</p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn secondary" onclick="document.getElementById('modal-novo-contrato').close()">Cancelar</button>
        <button type="submit" class="btn" id="btn-criar-contrato">Criar contrato e parcelas</button>
      </div>
    </form>
  </dialog>

  <script src="/js/contrato.js"></script>
  <script>
    // As contas (centavos, vencimentos das parcelas, base64 do PDF) vêm de /js/contrato.js —
    // as três telas de contrato usam a mesma, e ela bate com a do servidor.
    function preverContrato() {
      const meses = Number(document.getElementById('f-meses').value || 0);
      const valor = Contrato.valorEmCentavos(document.getElementById('f-valor').value);
      const primeiro = document.getElementById('f-venc').value;
      document.getElementById('previsao').textContent = Contrato.textoPrevia(meses, valor, primeiro);
    }

    document.getElementById('form-contrato').addEventListener('submit', async function (ev) {
      ev.preventDefault();
      const dados = {
        voltar: 'lista',
        companyUuid: document.getElementById('f-empresa').value,
        title: document.getElementById('f-titulo').value,
        contractNumber: document.getElementById('f-numero').value,
        months: document.getElementById('f-meses').value,
        monthlyAmount: document.getElementById('f-valor').value,
        firstDueDate: document.getElementById('f-venc').value,
        extendsDays: document.getElementById('f-dias').value,
        payerEmail: document.getElementById('f-email').value,
        signedOn: document.getElementById('f-assinatura').value,
        notes: document.getElementById('f-obs').value,
      };
      const arquivo = document.getElementById('f-pdf').files[0];
      if (arquivo) {
        if (arquivo.size > <%= maxPdfMb %> * 1024 * 1024) {
          alert('O PDF tem ' + (arquivo.size / 1048576).toFixed(1) + ' MB — o limite é <%= maxPdfMb %> MB.');
          return;
        }
        dados.documentName = arquivo.name;
        dados.documentBase64 = await Contrato.arquivoEmBase64(arquivo);
      }
      await Contrato.enviarJson('/admin/contracts', dados, document.getElementById('btn-criar-contrato'), 'Criar contrato e parcelas');
    });

    preverContrato();
  </script>
</body>
</html>
