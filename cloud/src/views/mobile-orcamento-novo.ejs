<%- include('partials/mobile-head', { titulo: 'Novo orçamento', grant, fresh, bodyClass: 'm-body-actionbar m-body-foco' }) %>

<div id="form-area">
  <%# Cliente primeiro, e como BOTÃO que abre uma folha com busca — não um <select> com
      dois mil nomes, onde o vendedor rola procurando "Silva" enquanto o cliente espera. %>
  <div class="m-field">
    <label>Cliente</label>
    <button type="button" class="m-selected" id="btn-cliente">
      <span class="m-ini" id="cliente-ini">—</span>
      <span class="m-selected-body">
        <span class="m-selected-name" id="cliente-nome">Sem cliente</span>
        <span class="m-selected-meta" id="cliente-meta">Toque para escolher ou digitar um nome</span>
      </span>
      <svg class="m-selected-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <p class="m-field-hint">O preço final usa a tabela do cliente.</p>
  </div>

  <%# Cabeçalho da lista com a contagem, e o botão de adicionar LOGO DEPOIS dos itens (não
      antes): montando um orçamento a pessoa vai empilhando produtos, e um botão fixo no
      topo obriga a rolar de volta a cada item. Assim ele desce junto com a lista e fica
      sempre embaixo do último que ela acabou de acrescentar. %>
  <div class="m-itens-head" id="itens-head" hidden>
    <span class="m-itens-titulo">Itens</span>
    <span class="m-itens-contagem" id="itens-contagem">0</span>
  </div>

  <div id="vazio" class="m-empty" style="padding:1.5rem 1rem">
    Nenhum item ainda.
  </div>

  <div id="itens"></div>

  <button type="button" class="m-btn m-btn-sec" id="btn-add" style="margin-bottom:1rem">
    + Adicionar produto
  </button>

  <div class="m-totals" id="totais" hidden>
    <div class="m-total-row"><span>Subtotal</span><strong id="t-subtotal">R$ 0,00</strong></div>
    <div class="m-total-row desc" id="linha-desconto" hidden><span>Desconto</span><strong id="t-desconto">−R$ 0,00</strong></div>
    <div class="m-total-row" id="linha-acrescimo" hidden><span>Acréscimo</span><strong id="t-acrescimo">R$ 0,00</strong></div>
    <div class="m-total-row grande"><span>Total</span><strong id="t-total">R$ 0,00</strong></div>
  </div>

  <% if (podeDesconto) { %>
  <div class="m-chip-row" style="margin-top:1rem">
    <button type="button" class="m-chip-btn" id="btn-ajuste">Desconto / acréscimo</button>
  </div>
  <div id="ajuste-box" hidden>
    <div class="m-field-2">
      <div class="m-field">
        <label for="desconto">Desconto (R$)</label>
        <input type="text" inputmode="numeric" id="desconto" placeholder="0,00">
      </div>
      <div class="m-field">
        <label for="acrescimo">Acréscimo (R$)</label>
        <input type="text" inputmode="numeric" id="acrescimo" placeholder="0,00">
      </div>
    </div>
  </div>
  <% } %>

  <div class="m-field-2" style="margin-top:.5rem">
    <div class="m-field">
      <label for="validade">Validade</label>
      <input type="date" id="validade" value="<%= validadeSugerida %>">
    </div>
    <div class="m-field">
      <label for="vendedor">Vendedor</label>
      <input type="text" id="vendedor" value="<%= (grant.name || grant.username) %>" readonly>
    </div>
  </div>

  <div class="m-field">
    <label for="obs">Observação do orçamento</label>
    <textarea id="obs" rows="3" maxlength="500" placeholder="Prazo de entrega, condições, o que combinaram…"></textarea>
  </div>

  <p class="m-note m-note-warn" id="aviso-offline" hidden></p>
  <p class="m-note" id="erro" hidden style="color:var(--danger)"></p>

  <%# A navegação inferior sai nesta tela (ver .m-body-foco), então a saída precisa
      existir aqui — sem isto, quem desiste no meio fica sem caminho de volta visível. %>
  <p style="text-align:center;margin:1.25rem 0 0">
    <a href="/m/orcamentos" style="color:var(--text-muted);font-size:.88rem">Cancelar e voltar</a>
  </p>
</div>

<%# Enquanto o desktop não confirma, a tela troca para o estado de espera. A transição
    chega pelo SSE (~1s); o polling é a rede de segurança se um proxy bloquear o canal. %>
<div id="status-area" class="m-status" hidden>
  <div class="m-status-spinner" id="spinner"></div>
  <h2 id="status-titulo">Enviando para o computador da loja…</h2>
  <p id="status-texto" class="m-card-sub"></p>
  <div id="status-acoes" hidden style="margin-top:1.5rem;display:flex;flex-direction:column;gap:.6rem">
    <a class="m-btn" id="link-ver" href="#">Ver orçamento</a>
    <a class="m-btn m-btn-sec" href="/m/orcamentos/novo">Fazer outro</a>
    <a class="m-btn m-btn-sec" href="/m/orcamentos">Voltar à lista</a>
  </div>
</div>

<div class="m-actionbar" id="barra">
  <div class="m-actionbar-info">
    <span class="m-actionbar-label" id="barra-label">Nenhum item</span>
    <span class="m-actionbar-value" id="barra-total">R$ 0,00</span>
  </div>
  <button class="m-btn" id="enviar" type="button" disabled>Enviar</button>
</div>

<%# ── Folha: escolher produto ── %>
<div class="m-sheet" id="sheet-produto" hidden>
  <div class="m-sheet-box">
    <div class="m-sheet-head">
      <h2>Adicionar produto</h2>
      <button type="button" class="m-sheet-close" data-fechar="sheet-produto">&times;</button>
    </div>
    <div class="m-sheet-body">
      <div class="m-search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" id="busca-produto" placeholder="Nome ou código do produto" autocomplete="off">
      </div>
      <div id="lista-produto"></div>
    </div>
  </div>
</div>

<%# ── Folha: escolher cliente ── %>
<div class="m-sheet" id="sheet-cliente" hidden>
  <div class="m-sheet-box">
    <div class="m-sheet-head">
      <h2>Cliente</h2>
      <button type="button" class="m-sheet-close" data-fechar="sheet-cliente">&times;</button>
    </div>
    <div class="m-sheet-body">
      <div class="m-search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" id="busca-cliente" placeholder="Nome, telefone ou documento" autocomplete="off">
      </div>
      <div id="lista-cliente"></div>
    </div>
  </div>
</div>

<script>
  (function () {
    var PRODUTOS = <%- JSON.stringify(produtos) %>;
    var CLIENTES = <%- JSON.stringify(clientes) %>;
    var PODE_DESCONTO = <%= podeDesconto ? 'true' : 'false' %>;

    var itens = [];
    var cliente = null;      // { uuid, name } vindo do cadastro
    var clienteLivre = '';   // nome digitado quando não há cadastro
    // Quais observações o vendedor abriu à mão nesta sessão (índice → true). Item que já
    // tem texto abre sozinho, sem depender disto.
    var notaAberta = {};

    var el = function (id) { return document.getElementById(id); };
    var brl = function (c) { return 'R$ ' + (c / 100).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
      });
    }
    // Dígitos entram como centavos — a mesma digitação do caixa no desktop (maskMoney).
    function mascaraDinheiro(v) {
      var d = String(v || '').replace(/\D/g, '');
      if (!d) return '';
      return (parseInt(d, 10) / 100).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }
    function paraCentavos(s) {
      var d = String(s || '').replace(/\D/g, '');
      return d ? parseInt(d, 10) : 0;
    }
    function inicial(nome) {
      return (String(nome || '?').trim()[0] || '?').toUpperCase();
    }

    // ─── Folhas ───
    function abrir(id) {
      el(id).hidden = false;
      // O foco só depois de a folha aparecer; no iOS, focar um campo escondido não abre
      // o teclado e a busca fica parecendo travada.
      var campo = el(id).querySelector('input[type=search]');
      if (campo) setTimeout(function () { campo.focus(); }, 60);
    }
    function fechar(id) { el(id).hidden = true; }
    Array.prototype.forEach.call(document.querySelectorAll('[data-fechar]'), function (b) {
      b.addEventListener('click', function () { fechar(b.getAttribute('data-fechar')); });
    });
    // Tocar fora fecha — é o gesto que todo mundo espera de uma folha inferior.
    Array.prototype.forEach.call(document.querySelectorAll('.m-sheet'), function (s) {
      s.addEventListener('click', function (e) { if (e.target === s) s.hidden = true; });
    });

    // ─── Produtos ───
    function renderListaProduto() {
      var termo = el('busca-produto').value.trim().toLowerCase();
      var base = termo.length
        ? PRODUTOS.filter(function (p) {
            return p.name.toLowerCase().indexOf(termo) !== -1
              || (p.sku || '').toLowerCase().indexOf(termo) !== -1
              || (p.barcode || '').toLowerCase().indexOf(termo) !== -1;
          })
        // Sem busca, mostra os primeiros do catálogo em vez de tela vazia: numa loja
        // pequena isso já é a lista inteira, e o vendedor toca direto.
        : PRODUTOS;
      var achados = base.slice(0, 40);
      if (!achados.length) {
        el('lista-produto').innerHTML = '<p class="m-empty">Nenhum produto encontrado.</p>';
        return;
      }
      el('lista-produto').innerHTML = achados.map(function (p) {
        var noCarrinho = itens.filter(function (i) { return i.uuid === p.uuid; })[0];
        return '<button type="button" class="m-pick" data-uuid="' + esc(p.uuid) + '">'
          + '<span class="m-pick-body">'
          + '<span class="m-pick-name">' + esc(p.name) + '</span>'
          + '<span class="m-pick-meta">' + esc(p.sku || 'sem código') + '</span>'
          + '</span>'
          + '<span class="m-pick-val">' + brl(p.price_cents) + '</span>'
          + (noCarrinho
              ? '<span class="m-pick-qtd">' + noCarrinho.qty + '</span>'
              : '<span class="m-pick-add">+</span>')
          + '</button>';
      }).join('');
      Array.prototype.forEach.call(el('lista-produto').querySelectorAll('[data-uuid]'), function (b) {
        b.addEventListener('click', function () { adicionar(b.getAttribute('data-uuid')); });
      });
    }

    function adicionar(uuid) {
      var p = PRODUTOS.filter(function (x) { return x.uuid === uuid; })[0];
      if (!p) return;
      var existente = itens.filter(function (i) { return i.uuid === uuid; })[0];
      if (existente) existente.qty += 1;
      else itens.push({ uuid: uuid, name: p.name, price_cents: p.price_cents, qty: 1, note: '' });
      // A folha CONTINUA aberta: montar orçamento é adicionar vários itens seguidos, e
      // fechar a cada toque obrigaria a reabrir e rebuscar. O contador na linha mostra
      // o que já entrou.
      renderListaProduto();
      renderItens();
    }

    // ─── Clientes ───
    function renderListaCliente() {
      var termo = el('busca-cliente').value.trim().toLowerCase();
      var achados = (termo.length
        ? CLIENTES.filter(function (c) {
            return c.name.toLowerCase().indexOf(termo) !== -1
              || (c.phone || '').toLowerCase().indexOf(termo) !== -1
              || (c.document || '').toLowerCase().indexOf(termo) !== -1;
          })
        : CLIENTES).slice(0, 40);

      var html = '<button type="button" class="m-pick" data-cli="">'
        + '<span class="m-ini">—</span>'
        + '<span class="m-pick-body"><span class="m-pick-name">Sem cliente</span>'
        + '<span class="m-pick-meta">Orçamento avulso</span></span></button>';

      // Nome digitado que não existe no cadastro: vira o nome livre do orçamento, sem
      // obrigar a cadastrar o cliente antes (o desktop aceita `customerName`).
      var jaExiste = achados.some(function (c) { return c.name.toLowerCase() === termo; });
      if (termo.length >= 2 && !jaExiste) {
        html += '<button type="button" class="m-pick" data-livre="' + esc(el('busca-cliente').value.trim()) + '">'
          + '<span class="m-ini">+</span>'
          + '<span class="m-pick-body"><span class="m-pick-name">Usar "' + esc(el('busca-cliente').value.trim()) + '"</span>'
          + '<span class="m-pick-meta">Sem cadastrar — só o nome no orçamento</span></span></button>';
      }

      html += achados.map(function (c) {
        return '<button type="button" class="m-pick" data-cli="' + esc(c.uuid) + '">'
          + '<span class="m-ini">' + esc(inicial(c.name)) + '</span>'
          + '<span class="m-pick-body"><span class="m-pick-name">' + esc(c.name) + '</span>'
          + '<span class="m-pick-meta">' + esc(c.phone || c.document || 'sem contato') + '</span></span></button>';
      }).join('');

      if (!achados.length && termo.length < 2) html += '<p class="m-empty">Nenhum cliente cadastrado.</p>';
      el('lista-cliente').innerHTML = html;

      Array.prototype.forEach.call(el('lista-cliente').querySelectorAll('[data-cli]'), function (b) {
        b.addEventListener('click', function () {
          var uuid = b.getAttribute('data-cli');
          cliente = uuid ? CLIENTES.filter(function (c) { return c.uuid === uuid; })[0] : null;
          clienteLivre = '';
          renderCliente();
          fechar('sheet-cliente');
        });
      });
      Array.prototype.forEach.call(el('lista-cliente').querySelectorAll('[data-livre]'), function (b) {
        b.addEventListener('click', function () {
          cliente = null;
          clienteLivre = b.getAttribute('data-livre');
          renderCliente();
          fechar('sheet-cliente');
        });
      });
    }

    function renderCliente() {
      var nome = cliente ? cliente.name : (clienteLivre || 'Sem cliente');
      el('cliente-nome').textContent = nome;
      el('cliente-ini').textContent = (cliente || clienteLivre) ? inicial(nome) : '—';
      el('cliente-meta').textContent = cliente
        ? (cliente.phone || cliente.document || 'cliente cadastrado')
        : (clienteLivre ? 'nome livre, sem cadastro' : 'Toque para escolher ou digitar um nome');
    }

    // ─── Itens ───
    function subtotal() {
      return itens.reduce(function (a, i) { return a + Math.round(i.price_cents * i.qty); }, 0);
    }
    function totalFinal() {
      var d = PODE_DESCONTO ? paraCentavos(el('desconto') ? el('desconto').value : '') : 0;
      var a = PODE_DESCONTO ? paraCentavos(el('acrescimo') ? el('acrescimo').value : '') : 0;
      return Math.max(0, subtotal() - d + a);
    }

    /**
     * Linha do item.
     *
     * A observação fica RECOLHIDA atrás de um link, e não como campo sempre aberto: ela é
     * usada em pouquíssimos itens, mas o campo custava ~90px em TODOS — um orçamento de 6
     * produtos virava uma rolagem interminável, e era isso que fazia a tela parecer confusa.
     * Item que já tem observação nasce aberto, para nada ficar escondido sem aviso.
     */
    function renderItens() {
      el('vazio').hidden = itens.length > 0;
      el('itens-head').hidden = itens.length === 0;
      el('itens-contagem').textContent = itens.length;

      el('itens').innerHTML = itens.map(function (i, idx) {
        var temNota = !!(i.note && i.note.trim());
        var aberta = temNota || notaAberta[idx];
        return '<div class="m-cart-item">'
          + '<div class="m-cart-top">'
          + '<span class="m-cart-name">' + esc(i.name)
          + '<span class="m-cart-unit">' + brl(i.price_cents) + ' cada</span></span>'
          + '<span class="m-cart-total">' + brl(Math.round(i.price_cents * i.qty)) + '</span>'
          + '<button type="button" class="m-cart-x" data-remove="' + idx + '" aria-label="Remover ' + esc(i.name) + '">'
          + '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>'
          + '</button>'
          + '</div>'
          + '<div class="m-cart-actions">'
          + '<span class="m-step">'
          + '<button type="button" data-menos="' + idx + '" aria-label="Diminuir">−</button>'
          + '<input type="number" inputmode="decimal" step="any" min="0" value="' + i.qty + '" data-qtd="' + idx + '">'
          + '<button type="button" data-mais="' + idx + '" aria-label="Aumentar">+</button>'
          + '</span>'
          + (aberta ? '' : '<button type="button" class="m-cart-obs-link" data-abrenota="' + idx + '">+ observação</button>')
          + '</div>'
          + (aberta
              ? '<input class="m-cart-note" type="text" maxlength="200" data-nota="' + idx + '" '
                + 'value="' + esc(i.note) + '" placeholder="Observação deste item">'
              : '')
          + '</div>';
      }).join('');

      var box = el('itens');
      // O botão de remover existia na marcação desde sempre, mas nunca teve listener: dava
      // para tocar em "Remover" à vontade que o item continuava no orçamento.
      Array.prototype.forEach.call(box.querySelectorAll('[data-remove]'), function (b) {
        b.addEventListener('click', function () {
          itens.splice(+b.getAttribute('data-remove'), 1);
          notaAberta = {}; // os índices deslocam ao remover — reabrir o que tiver texto basta
          renderItens();
        });
      });
      Array.prototype.forEach.call(box.querySelectorAll('[data-abrenota]'), function (b) {
        b.addEventListener('click', function () {
          var i = +b.getAttribute('data-abrenota');
          notaAberta[i] = true;
          renderItens();
          var campo = box.querySelector('[data-nota="' + i + '"]');
          if (campo) campo.focus();
        });
      });
      Array.prototype.forEach.call(box.querySelectorAll('[data-mais]'), function (b) {
        b.addEventListener('click', function () { itens[+b.getAttribute('data-mais')].qty += 1; renderItens(); });
      });
      Array.prototype.forEach.call(box.querySelectorAll('[data-menos]'), function (b) {
        b.addEventListener('click', function () {
          var i = +b.getAttribute('data-menos');
          itens[i].qty -= 1;
          if (itens[i].qty <= 0) { itens.splice(i, 1); notaAberta = {}; }
          renderItens();
        });
      });
      Array.prototype.forEach.call(box.querySelectorAll('[data-qtd]'), function (inp) {
        inp.addEventListener('change', function () {
          var i = +inp.getAttribute('data-qtd');
          itens[i].qty = Number(inp.value) || 0;
          if (itens[i].qty <= 0) { itens.splice(i, 1); notaAberta = {}; }
          renderItens();
        });
      });
      Array.prototype.forEach.call(box.querySelectorAll('[data-nota]'), function (inp) {
        // `input` e não `change`: se a pessoa envia com o teclado ainda aberto, o
        // `change` não dispara e a observação se perderia em silêncio.
        inp.addEventListener('input', function () { itens[+inp.getAttribute('data-nota')].note = inp.value; });
      });
      renderTotais();
    }

    function renderTotais() {
      var sub = subtotal();
      var d = PODE_DESCONTO && el('desconto') ? paraCentavos(el('desconto').value) : 0;
      var a = PODE_DESCONTO && el('acrescimo') ? paraCentavos(el('acrescimo').value) : 0;
      el('totais').hidden = itens.length === 0;
      el('t-subtotal').textContent = brl(sub);
      el('t-total').textContent = brl(totalFinal());
      if (el('linha-desconto')) {
        el('linha-desconto').hidden = d === 0;
        el('t-desconto').textContent = '−' + brl(d);
      }
      if (el('linha-acrescimo')) {
        el('linha-acrescimo').hidden = a === 0;
        el('t-acrescimo').textContent = brl(a);
      }
      var qtdItens = itens.reduce(function (n, i) { return n + i.qty; }, 0);
      el('barra-label').textContent = itens.length
        ? qtdItens + (qtdItens === 1 ? ' item' : ' itens')
        : 'Nenhum item';
      el('barra-total').textContent = brl(totalFinal());
      el('enviar').disabled = itens.length === 0;
    }

    // ─── Ligações ───
    el('btn-add').addEventListener('click', function () { renderListaProduto(); abrir('sheet-produto'); });
    el('btn-cliente').addEventListener('click', function () { renderListaCliente(); abrir('sheet-cliente'); });
    el('busca-produto').addEventListener('input', renderListaProduto);
    el('busca-cliente').addEventListener('input', renderListaCliente);

    if (PODE_DESCONTO) {
      el('btn-ajuste').addEventListener('click', function () {
        var box = el('ajuste-box');
        box.hidden = !box.hidden;
        el('btn-ajuste').classList.toggle('on', !box.hidden);
        if (!box.hidden) el('desconto').focus();
      });
      ['desconto', 'acrescimo'].forEach(function (id) {
        el(id).addEventListener('input', function () {
          el(id).value = mascaraDinheiro(el(id).value);
          renderTotais();
        });
      });
    }

    // Se o computador da loja não sincroniza há muito, avisar ANTES de montar tudo: o
    // orçamento ficaria na fila até ele voltar, e é melhor a pessoa saber disso agora.
    var minutos = <%= fresh.minutesAgo === null ? 'null' : fresh.minutesAgo %>;
    if (minutos === null || minutos > 30) {
      el('aviso-offline').hidden = false;
      el('aviso-offline').textContent = 'O computador da loja não está sincronizando. O orçamento vai ficar na fila e só será criado quando ele voltar.';
    }

    function acompanhar(id) {
      var pronto = false;
      function checar() {
        if (pronto) return;
        fetch('/api/mobile/commands/' + id).then(function (r) { return r.json(); }).then(function (d) {
          if (!d || d.status === 'pendente') return;
          pronto = true;
          el('spinner').hidden = true;
          el('status-acoes').hidden = false;
          if (d.status === 'aplicado') {
            el('status-titulo').textContent = 'Orçamento #' + (d.result && d.result.quoteId) + ' criado';
            el('status-texto').textContent = d.result && d.result.totalCents != null
              ? 'Total ' + brl(d.result.totalCents) + ' — já com a tabela de preço do cliente.'
              : '';
            if (d.result && d.result.quoteUuid) el('link-ver').href = '/m/orcamentos/' + d.result.quoteUuid;
            else el('link-ver').style.display = 'none';
          } else {
            el('status-titulo').textContent = 'Não foi possível criar';
            el('status-texto').textContent = (d.result && d.result.error) || 'O computador da loja recusou o pedido.';
            el('link-ver').style.display = 'none';
          }
        }).catch(function () {});
      }
      try {
        var es = new EventSource('/api/mobile/events');
        es.addEventListener('command-done', function () { checar(); });
      } catch (e) { /* navegador sem SSE: o polling cobre */ }
      var t = setInterval(function () { if (pronto) clearInterval(t); else checar(); }, 4000);
      checar();
    }

    el('enviar').addEventListener('click', function () {
      el('enviar').disabled = true;
      el('erro').hidden = true;
      fetch('/api/mobile/commands', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kind: 'store.quote.create',
          payload: {
            items: itens.map(function (i) {
              return { productUuid: i.uuid, qty: i.qty, notes: i.note.trim() || null };
            }),
            customerUuid: cliente ? cliente.uuid : null,
            customerName: cliente ? null : (clienteLivre || null),
            discountCents: PODE_DESCONTO && el('desconto') ? paraCentavos(el('desconto').value) : 0,
            surchargeCents: PODE_DESCONTO && el('acrescimo') ? paraCentavos(el('acrescimo').value) : 0,
            validUntil: el('validade').value || null,
            notes: el('obs').value.trim() || null,
          },
        }),
      }).then(function (r) {
        return r.json().then(function (d) { return { ok: r.ok, d: d }; });
      }).then(function (res) {
        if (!res.ok) {
          el('erro').hidden = false;
          el('erro').textContent = res.d.error || 'Falha ao enviar.';
          el('enviar').disabled = false;
          return;
        }
        el('form-area').hidden = true;
        el('barra').hidden = true;
        el('status-area').hidden = false;
        el('status-texto').textContent = res.d.desktopOnline
          ? 'O computador da loja está conectado — deve levar poucos segundos.'
          : 'O computador da loja não está conectado agora. Assim que ligar, o orçamento é criado.';
        acompanhar(res.d.id);
      }).catch(function () {
        el('erro').hidden = false;
        el('erro').textContent = 'Sem conexão. Tente de novo.';
        el('enviar').disabled = false;
      });
    });

    renderCliente();
    renderItens();
  })();
</script>

<%- include('partials/mobile-foot', { grant, ativo: 'orcamentos' }) %>
