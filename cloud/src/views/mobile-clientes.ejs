<%- include('partials/mobile-head', { titulo: 'Clientes', grant, fresh }) %>

<%# A tela abre pelo que o lojista veio fazer: cobrar. Os dois números do topo respondem
    "quanto tenho na rua e quanto já venceu" antes de qualquer rolagem. %>
<% if (podeCobranca && totalAberto > 0) { %>
<div class="m-kpi-grid">
  <div class="m-kpi">
    <span class="m-kpi-label">Em aberto</span>
    <strong class="m-kpi-value">R$ <%= brl(totalAberto) %></strong>
    <span class="m-kpi-sub"><%= devedores %> cliente<%= devedores === 1 ? '' : 's' %></span>
  </div>
  <div class="m-kpi <%= totalVencido > 0 ? 'alerta' : '' %>">
    <span class="m-kpi-label">Vencido</span>
    <strong class="m-kpi-value">R$ <%= brl(totalVencido) %></strong>
    <span class="m-kpi-sub"><%= totalVencido > 0 ? 'cobrar hoje' : 'nada atrasado' %></span>
  </div>
</div>
<% } %>

<div class="m-search" style="margin-bottom:.75rem">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
  <input type="search" id="busca" placeholder="Nome, telefone ou documento" autocomplete="off">
</div>

<%# Filtro rápido: numa loja com 800 cadastros, "quem me deve" é uma lista de 12 — e é
    essa que interessa. Só aparece se houver de fato quem deva. %>
<% if (podeCobranca && devedores > 0) { %>
<div class="m-chip-row" style="margin-bottom:.5rem">
  <button type="button" class="m-chip-btn on" data-filtro="todos">Todos</button>
  <button type="button" class="m-chip-btn" data-filtro="devendo">Devendo (<%= devedores %>)</button>
  <button type="button" class="m-chip-btn" data-filtro="vencido">Vencidos</button>
</div>
<% } %>

<div id="lista">
  <% clientes.forEach(function (c) { %>
  <a class="m-cli" href="/m/clientes/<%= c.uuid %>"
     data-nome="<%= (c.nome || '').toLowerCase() %>"
     data-contato="<%= ((c.telefone || '') + ' ' + (c.documento || '')).toLowerCase() %>"
     data-devendo="<%= c.abertoCents > 0 ? '1' : '0' %>"
     data-vencido="<%= c.vencidoCents > 0 ? '1' : '0' %>">
    <span class="m-ini"><%= (c.nome || '?').trim().charAt(0).toUpperCase() %></span>
    <span class="m-cli-body">
      <span class="m-cli-nome"><%= c.nome %></span>
      <span class="m-cli-meta"><%= c.telefone || c.documento || 'sem contato' %></span>
    </span>
    <% if (podeCobranca && c.abertoCents > 0) { %>
    <span class="m-cli-valor <%= c.vencidoCents > 0 ? 'vencido' : '' %>">
      <span class="m-cli-cents">R$ <%= brl(c.abertoCents) %></span>
      <span class="m-cli-tag">
        <%= c.vencidoCents > 0 ? (c.diasAtraso + (c.diasAtraso === 1 ? ' dia atrás' : ' dias atrás')) : 'a vencer' %>
      </span>
    </span>
    <% } %>
  </a>
  <% }) %>
</div>

<p class="m-empty" id="vazio" <%= clientes.length ? 'hidden' : '' %>>
  <%= clientes.length ? 'Nenhum cliente encontrado.' : 'Nenhum cliente cadastrado ainda.' %>
</p>

<script>
  (function () {
    var busca = document.getElementById('busca');
    var vazio = document.getElementById('vazio');
    var linhas = Array.prototype.slice.call(document.querySelectorAll('.m-cli'));
    var filtro = 'todos';

    function aplicar() {
      var termo = busca.value.trim().toLowerCase();
      var visiveis = 0;
      linhas.forEach(function (l) {
        var casaTexto = !termo
          || l.getAttribute('data-nome').indexOf(termo) !== -1
          || l.getAttribute('data-contato').indexOf(termo) !== -1;
        var casaFiltro = filtro === 'todos'
          || (filtro === 'devendo' && l.getAttribute('data-devendo') === '1')
          || (filtro === 'vencido' && l.getAttribute('data-vencido') === '1');
        var mostrar = casaTexto && casaFiltro;
        l.hidden = !mostrar;
        if (mostrar) visiveis++;
      });
      vazio.hidden = visiveis > 0;
      vazio.textContent = 'Nenhum cliente encontrado.';
    }

    busca.addEventListener('input', aplicar);
    Array.prototype.forEach.call(document.querySelectorAll('[data-filtro]'), function (b) {
      b.addEventListener('click', function () {
        filtro = b.getAttribute('data-filtro');
        Array.prototype.forEach.call(document.querySelectorAll('[data-filtro]'), function (o) {
          o.classList.toggle('on', o === b);
        });
        aplicar();
      });
    });
  })();
</script>

<%- include('partials/mobile-foot', { grant, ativo: 'clientes' }) %>
