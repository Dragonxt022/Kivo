<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kuruk Cloud — Downloads e testes</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kuruk-icon.svg">
  <%- include('partials/styles') %>
  <script defer src="/vendor/alpine.min.js"></script>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'downloads' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'downloads' }) %>

      <div class="page">
        <div class="page-header">
          <div>
            <div class="breadcrumb">Sistema</div>
            <h1>Downloads e testes</h1>
          </div>
          <a href="/admin/versions" class="btn secondary">Ver versões instaladas</a>
        </div>

        <p class="field-hint" style="margin-top:0">
          Para baixar o instalador, o visitante preenche nome, celular e e-mail em
          <strong>/baixar</strong>. O cadastro aparece aqui mesmo que a pessoa nunca ative uma
          licença. Quando o instalador é aberto e o teste de 15 dias é solicitado, a empresa e a
          máquina aparecem na segunda tabela.
        </p>

        <div class="dash-kpi-grid">
          <div class="dash-kpi">
            <div class="dash-kpi-icon blue">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            </div>
            <div class="dash-kpi-value"><%= stats.total %></div>
            <div class="dash-kpi-label">Cadastros para download</div>
            <div class="dash-kpi-delta flat"><span class="delta-base"><%= stats.last_24h %> nas últimas 24h</span></div>
          </div>
          <div class="dash-kpi">
            <div class="dash-kpi-icon green">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </div>
            <div class="dash-kpi-value"><%= stats.downloaded %></div>
            <div class="dash-kpi-label">Downloads efetivados</div>
            <div class="dash-kpi-delta flat"><span class="delta-base"><%= stats.total ? Math.round((stats.downloaded / stats.total) * 100) : 0 %>% dos cadastros</span></div>
          </div>
          <div class="dash-kpi">
            <div class="dash-kpi-icon amber">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <div class="dash-kpi-value"><%= stats.last_7d %></div>
            <div class="dash-kpi-label">Últimos 7 dias</div>
          </div>
          <div class="dash-kpi">
            <div class="dash-kpi-icon red">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </div>
            <div class="dash-kpi-value"><%= totalTrials %></div>
            <div class="dash-kpi-label">Testes em andamento</div>
            <div class="dash-kpi-delta flat"><span class="delta-base"><%= stats.unique_emails %> e-mail(s) único(s)</span></div>
          </div>
        </div>

        <div class="card table-card">
          <div class="table-toolbar">
            <h2 style="margin:0; font-size:1.05rem;">Cadastros para download</h2>
            <div class="table-count">até 500 registros</div>
          </div>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Quando</th><th>Nome / IP</th><th>Celular</th><th>E-mail</th><th>Versão</th><th>Origem</th><th>Download</th></tr></thead>
              <tbody>
                <% leads.forEach(function(l) { %>
                <tr>
                  <td><%= fmtDateTimeBr(l.created_at) %></td>
                  <td>
                    <strong><%= l.name %></strong>
                    <div class="cell-sub" title="<%= l.ip || '' %>"><%= l.ip || 'IP não registrado' %></div>
                  </td>
                  <td>
                    <% if (l.wa_link) { %>
                    <a href="<%= l.wa_link %>" target="_blank" rel="noopener"><%= l.whatsapp %></a>
                    <% } else { %>—<% } %>
                  </td>
                  <td><a href="mailto:<%= l.email %>"><%= l.email %></a></td>
                  <td><span class="badge paga"><%= l.version || '—' %></span></td>
                  <td class="cell-muted" title="<%= l.referer || '' %>"><%= l.origem || l.referer || 'direto' %></td>
                  <td>
                    <% if (l.downloaded_at) { %>
                    <span class="badge paga">baixou</span>
                    <div class="cell-sub"><%= fmtDateTimeBr(l.downloaded_at) %><% if (Number(l.download_count) > 1) { %> · <%= l.download_count %>x<% } %></div>
                    <% } else { %>
                    <span class="badge pendente">não baixou</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
                <% if (!leads.length) { %><tr><td colspan="7"><%- include('partials/empty-state', { message: 'Nenhum cadastro ainda. Quando alguém preencher o formulário em /baixar, aparece aqui.' }) %></td></tr><% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card table-card">
          <div class="table-toolbar">
            <h2 style="margin:0; font-size:1.05rem;">Testes de 15 dias</h2>
            <div class="table-count"><%= totalTrials %> teste<%= totalTrials === 1 ? '' : 's' %></div>
          </div>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Empresa</th><th>Validade</th><th>Máquina</th><th>Versão</th><th>Primeiro acesso</th><th>Último acesso</th></tr></thead>
              <tbody>
                <% trials.forEach(function(t) { %>
                <tr>
                  <td>
                    <a href="/admin/companies/<%= t.company_uuid %>"><%= t.name || t.company_uuid %></a>
                    <div class="cell-sub"><%= String(t.company_uuid).slice(0, 8) %></div>
                  </td>
                  <td class="cell-muted"><%= t.valid_until ? fmtDateBr(t.valid_until) : '—' %></td>
                  <td class="cell-muted" title="<%= t.machine_id || '' %>"><%= t.machine_id ? String(t.machine_id).slice(0, 16) + '…' : 'ainda não ativou' %></td>
                  <td><%= t.app_version || '—' %></td>
                  <td class="cell-muted"><%= t.first_seen_at ? fmtDateTimeBr(t.first_seen_at) : '—' %></td>
                  <td class="cell-muted"><%= t.last_seen_at ? fmtDateTimeBr(t.last_seen_at) : '—' %></td>
                </tr>
                <% }) %>
                <% if (!trials.length) { %><tr><td colspan="6"><%- include('partials/empty-state', { message: 'Nenhum teste de 15 dias em andamento.' }) %></td></tr><% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
