<%- include('partials/mobile-head', { titulo: 'Venda', grant, fresh }) %>

<div class="m-cards">
  <div class="m-card m-card-hero">
    <span class="m-card-label"><%= sale.payload.customer_name || 'Consumidor' %></span>
    <strong class="m-card-value">R$ <%= brl(sale.payload.total_cents) %></strong>
    <span class="m-card-sub">
      <%= (sale.payload.created_at || '').slice(0, 16).replace('T', ' ') %> · <%= sale.payload.status %>
    </span>
  </div>
</div>

<section class="m-section">
  <div class="m-section-head"><h2>Itens</h2></div>
  <ul class="m-list">
    <% (sale.payload.sale_items || []).forEach(function (i) { %>
      <li>
        <div class="m-list-static">
          <span class="m-list-main"><%= nomePorUuid.get(i.product_id) || 'Produto removido' %></span>
          <span class="m-list-meta"><%= i.qty %> × R$ <%= brl(i.unit_price_cents) %></span>
          <strong class="m-list-value">R$ <%= brl(i.total_cents) %></strong>
        </div>
      </li>
    <% }) %>
  </ul>
</section>

<% if ((sale.payload.sale_payments || []).length) { %>
<section class="m-section">
  <div class="m-section-head"><h2>Pagamento</h2></div>
  <ul class="m-list">
    <% sale.payload.sale_payments.forEach(function (p) { %>
      <li>
        <div class="m-list-static">
          <span class="m-list-main"><%= p.method_name %></span>
          <strong class="m-list-value">R$ <%= brl(p.amount_cents) %></strong>
        </div>
      </li>
    <% }) %>
  </ul>
</section>
<% } %>

<% if (sale.payload.discount_cents || sale.payload.surcharge_cents) { %>
<p class="m-note">
  <% if (sale.payload.discount_cents) { %>Desconto: R$ <%= brl(sale.payload.discount_cents) %>. <% } %>
  <% if (sale.payload.surcharge_cents) { %>Acréscimo: R$ <%= brl(sale.payload.surcharge_cents) %>.<% } %>
</p>
<% } %>

<p class="m-back"><a href="/m/vendas">← Voltar para vendas</a></p>

<%- include('partials/mobile-foot', { grant, ativo: 'vendas' }) %>
