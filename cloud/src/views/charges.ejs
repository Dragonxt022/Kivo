<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Cobranças</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <script defer src="/vendor/alpine.min.js"></script>
  <style>
    .charge-discount { color: #16a34a; font-size: 12px; }
    .charge-old { color: #888; text-decoration: line-through; font-size: 12px; }
    .affiliate-note { display: flex; gap: 10px; align-items: flex-start; }
    .affiliate-note svg { flex: none; color: var(--primary, #ff8000); margin-top: 2px; }
    .charge-actions { display: flex; gap: 6px; }
    .charge-actions form { display: inline; margin: 0; }
    .charge-actions button { border: 0; background: transparent; cursor: pointer; color: #2563eb; font-size: 12px; padding: 2px 4px; }
    .charge-actions button.danger { color: #dc2626; }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'charges' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'charges' }) %>

      <%
        function brl(c) { return (Number(c || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }
        var pendentes = Number(summary.pending_cents || 0);
        var vencidas = Number(summary.overdue_cents || 0);
        var recebidoMes = Number(summary.paid_month_cents || 0);
        var descontoMes = Number(summary.discount_month_cents || 0);
        var hoje = new Date().toISOString().slice(0, 10);
        function ehVencida(ch) { return ch.status === 'pendente' && String(ch.due_date).slice(0, 10) < hoje; }
        function statusBadge(ch) {
          if (ch.status === 'paga') return { cls: 'paga', label: 'Paga' };
          if (ch.status === 'cancelada') return { cls: 'cancelada', label: 'Cancelada' };
          return ehVencida(ch) ? { cls: 'cancelada', label: 'Vencida' } : { cls: '', label: 'Pendente' };
        }
      %>

      <div class="page">
        <div class="page-header">
          <div>
            <div class="breadcrumb">Geral</div>
            <h1>Cobranças</h1>
          </div>
          <button class="btn" onclick="document.getElementById('modal-new-charge').showModal()">+ Nova cobrança</button>
        </div>

        <div class="card">
          <div class="stat-row">
            <div class="stat"><div class="value"><%= brl(pendentes) %></div><div class="label">A receber (pendente)</div></div>
            <div class="stat"><div class="value" style="<%= vencidas ? 'color:#dc2626' : '' %>"><%= brl(vencidas) %></div><div class="label">Vencidas</div></div>
            <div class="stat"><div class="value"><%= brl(recebidoMes) %></div><div class="label">Recebido no mês</div></div>
            <div class="stat"><div class="value"><%= brl(descontoMes) %></div><div class="label">Descontos de indicação (mês)</div></div>
          </div>
        </div>

        <%# A nota que explica o programa: é o que o time lê antes de mexer nas cobranças. %>
        <div class="card affiliate-note">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <div>
            <strong>Como funciona a cobrança com indicação</strong>
            <p style="margin:6px 0 0; font-size:13px; line-height:1.5;">
              Cada empresa pode ter um <strong>afiliado</strong> (quem indicou), e cada afiliado tem um
              <strong>percentual de desconto</strong> cadastrado em <a href="/admin/affiliates">Afiliados</a>.
              Ao registrar uma cobrança, o valor informado é o <em>valor cheio</em>: o sistema aplica o
              desconto do afiliado da empresa automaticamente e guarda o histórico (valor cheio, percentual e
              desconto) — mudar o afiliado depois não altera cobranças já criadas. Sem afiliado (ou afiliado
              inativo), o cliente paga o valor cheio.
            </p>
          </div>
        </div>

        <div class="card table-card">
          <div class="table-toolbar">
            <div class="tabs" style="margin:0">
              <a class="tab <%= !filter.status && !filter.vencidas ? 'active' : '' %>" href="/admin/charges">Todas</a>
              <a class="tab <%= filter.status === 'pendente' && !filter.vencidas ? 'active' : '' %>" href="/admin/charges?status=pendente">Pendentes</a>
              <a class="tab <%= filter.vencidas ? 'active' : '' %>" href="/admin/charges?vencidas=1">Vencidas</a>
              <a class="tab <%= filter.status === 'paga' ? 'active' : '' %>" href="/admin/charges?status=paga">Pagas</a>
              <a class="tab <%= filter.status === 'cancelada' ? 'active' : '' %>" href="/admin/charges?status=cancelada">Canceladas</a>
            </div>
            <div class="table-count"><%= charges.length %> cobrança<%= charges.length === 1 ? '' : 's' %></div>
          </div>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Empresa</th>
                  <th>Descrição</th>
                  <th class="text-right">Valor</th>
                  <th>Vencimento</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% charges.forEach(function(ch) { var b = statusBadge(ch); %>
                <tr>
                  <td>
                    <a href="/admin/companies/<%= ch.company_uuid %>"><%= ch.company_name || String(ch.company_uuid).slice(0, 8) %></a>
                    <% if (ch.affiliate_name) { %><div class="cell-sub">indicação: <%= ch.affiliate_name %></div><% } %>
                  </td>
                  <td>
                    <div><%= ch.description %></div>
                    <% if (ch.instructions) { %><div class="cell-sub"><%= ch.instructions %></div><% } %>
                  </td>
                  <td class="text-right tabular">
                    <div><strong><%= brl(ch.amount_cents) %></strong></div>
                    <% if (Number(ch.discount_cents) > 0) { %>
                      <div class="charge-old"><%= brl(ch.original_amount_cents) %></div>
                      <div class="charge-discount">−<%= ch.discount_pct %>% indicação</div>
                    <% } %>
                  </td>
                  <td class="cell-muted"><%= String(ch.due_date).slice(0, 10) %></td>
                  <td><span class="badge <%= b.cls %>"><%= b.label %></span></td>
                  <td>
                    <% if (ch.status === 'pendente') { %>
                    <div class="charge-actions">
                      <form method="post" action="/admin/charges/<%= ch.id %>/pay"><button type="submit">Marcar paga</button></form>
                      <form method="post" action="/admin/charges/<%= ch.id %>/cancel"><button type="submit" class="danger">Cancelar</button></form>
                    </div>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
                <% if (!charges.length) { %>
                  <tr><td colspan="6"><%- include('partials/empty-state', { message: 'Nenhuma cobrança nesse filtro.' }) %></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <dialog id="modal-new-charge">
    <form method="post" action="/admin/charges">
      <div class="modal-header">
        <h2>Nova cobrança</h2>
        <button type="button" class="modal-close" onclick="document.getElementById('modal-new-charge').close()">&times;</button>
      </div>
      <div class="modal-body">
        <label>Empresa</label>
        <select name="companyUuid" id="charge-company" required onchange="previewDiscount()">
          <option value="">Selecione…</option>
          <% companies.forEach(function(c) { %>
            <option value="<%= c.company_uuid %>" data-affiliate="<%= c.affiliate_name || '' %>" data-pct="<%= c.discount_pct || 0 %>">
              <%= c.name || c.company_uuid %><%= c.affiliate_name ? (' — ' + c.affiliate_name + ' (' + c.discount_pct + '%)') : '' %>
            </option>
          <% }); %>
        </select>

        <label>Descrição</label>
        <input type="text" name="description" required maxlength="255" placeholder="Ex.: Mensalidade Plano Ouro">

        <label>Valor cheio (R$)</label>
        <input type="text" name="amount" id="charge-amount" required inputmode="decimal" placeholder="0,00" oninput="previewDiscount()">
        <p class="field-hint" id="charge-discount-hint">Se a empresa tiver afiliado, o desconto é aplicado automaticamente.</p>

        <label>Vencimento</label>
        <input type="date" name="dueDate" required>

        <label>Observações (opcional)</label>
        <textarea name="instructions" rows="2" placeholder="Aparece para o cliente na tela de Cobranças do app instalado."></textarea>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn secondary" onclick="document.getElementById('modal-new-charge').close()">Cancelar</button>
        <button type="submit" class="btn">Registrar cobrança</button>
      </div>
    </form>
  </dialog>

  <script>
    function parseMoney(txt) {
      var s = String(txt || '').replace(/[^\d,.]/g, '');
      if (s.indexOf(',') >= 0) s = s.replace(/\./g, '').replace(',', '.');
      var n = parseFloat(s);
      return isFinite(n) ? n : 0;
    }
    function previewDiscount() {
      var sel = document.getElementById('charge-company');
      var opt = sel.options[sel.selectedIndex];
      var pct = opt ? Number(opt.getAttribute('data-pct') || 0) : 0;
      var affiliate = opt ? opt.getAttribute('data-affiliate') : '';
      var valor = parseMoney(document.getElementById('charge-amount').value);
      var hint = document.getElementById('charge-discount-hint');
      if (!affiliate || pct <= 0) {
        hint.textContent = 'Empresa sem afiliado ativo — paga o valor cheio.';
        return;
      }
      var desconto = valor * pct / 100;
      var liquido = valor - desconto;
      hint.innerHTML = 'Indicação de <strong>' + affiliate + '</strong>: −' + pct + '% (' +
        desconto.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + '). O cliente pagará <strong>' +
        liquido.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + '</strong>.';
    }
  </script>
</body>
</html>
