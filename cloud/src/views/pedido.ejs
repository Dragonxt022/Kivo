<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title><%= companyName ? `Pedido — ${companyName}` : 'Pedido pela mesa — Kivo' %></title>
  <meta name="theme-color" content="#ff8000">
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <link rel="stylesheet" href="/css/pedido.css">
</head>
<body>
  <div class="pedido-page">
    <header class="pedido-hero">
      <span class="pedido-eyebrow">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg>
        Pedido pelo celular
      </span>
      <h1><%= companyName ?? 'Kivo' %></h1>
      <% if (tableLabel) { %><p class="pedido-table"><%= tableLabel %></p><% } %>
      <% if (!error) { %>
      <p class="pedido-hint">Monte seu pedido e envie. O atendente confirma antes de ir para a cozinha.</p>
      <% } %>
    </header>

    <% if (error) { %>
      <div class="pedido-notice">
        <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
        <h2>Pedido indisponível</h2>
        <p><%= error %></p>
      </div>
    <% } else { %>
      <div class="pedido-quickbar">
        <button type="button" class="pedido-history-btn" id="openHistory">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><path d="M12 7v5l3 2"/></svg>
          <span>Meus pedidos</span>
          <span class="pedido-history-count" id="historyCount" hidden>0</span>
        </button>
      </div>

      <section class="pedido-last-order" id="lastOrderSection" hidden>
        <div class="pedido-last-order-head">
          <span class="pedido-last-order-label">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            Último pedido
          </span>
          <span class="pedido-history-status" id="lastOrderStatus"></span>
        </div>
        <div class="pedido-last-order-card">
          <div class="pedido-last-order-main">
            <div class="pedido-history-title" id="lastOrderTitle"></div>
            <div class="pedido-history-meta" id="lastOrderMeta"></div>
            <div class="pedido-history-total" id="lastOrderTotal"></div>
          </div>
          <div class="pedido-last-order-actions">
            <button type="button" class="pedido-history-detail" id="lastOrderDetails">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
              Detalhes
            </button>
            <button type="button" class="pedido-history-reorder" id="lastOrderReorder">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
              Pedir novamente
            </button>
          </div>
        </div>
        <button type="button" class="pedido-history-all" id="lastOrderAll">
          Ver todos os pedidos
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </section>

      <div class="pedido-search-wrap">
        <div class="pedido-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="menuSearch" placeholder="Buscar no menu…" autocomplete="off" aria-label="Buscar no menu">
        </div>
      </div>

      <nav class="pedido-catnav" id="catNav" aria-label="Categorias"></nav>
      <main class="pedido-menu" id="menu"></main>
      <div class="pedido-empty" id="noResults" hidden>
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <p>Nada encontrado. Tente outro termo.</p>
      </div>

      <div class="pedido-cartbar" id="cartBar" hidden>
        <button type="button" class="pedido-cartbtn" id="openCart">
          <span class="pedido-cart-count" id="cartCount">0</span>
          <span class="pedido-cart-label">Ver pedido</span>
          <span class="pedido-cart-total" id="cartTotal">R$ 0,00</span>
        </button>
      </div>
    <% } %>

    <footer class="pedido-footer">
      <span class="mark">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg>
        Kivo
      </span>
      <span>Pedido gerado pelo Kivo</span>
    </footer>
  </div>

  <% if (!error) { %>
  <dialog id="itemDlg" class="pedido-dialog pedido-item-dialog">
    <div class="pedido-dialog-head">
      <h2 id="itemTitle">Item</h2>
      <button type="button" class="pedido-close" data-close="itemDlg" aria-label="Fechar">×</button>
    </div>
    <div class="pedido-item-body" id="itemBody"></div>
    <div class="pedido-dialog-actions">
      <button type="button" class="pedido-btn secondary" data-close="itemDlg">Cancelar</button>
      <button type="button" class="pedido-btn primary" id="addItem">Adicionar ao pedido</button>
    </div>
  </dialog>

  <dialog id="cartDlg" class="pedido-dialog pedido-cart-dialog">
    <div class="pedido-dialog-head">
      <h2>Seu pedido</h2>
      <button type="button" class="pedido-close" data-close="cartDlg" aria-label="Fechar">×</button>
    </div>
    <div class="pedido-reorder-note" id="reorderNote" hidden></div>
    <div class="pedido-cart-body" id="cartBody"></div>
    <label class="pedido-field">
      <span>Observação geral (opcional)</span>
      <textarea id="orderNote" maxlength="500" rows="2" placeholder="Ex.: trazer tudo junto, sem guardanapo…"></textarea>
    </label>
    <div class="pedido-send-error" id="sendError" hidden>
      <span id="sendErrorText"></span>
      <button type="button" class="pedido-btn secondary" id="reloadMenu" hidden>Atualizar cardápio</button>
    </div>
    <div class="pedido-dialog-actions">
      <button type="button" class="pedido-btn secondary" data-close="cartDlg">Continuar escolhendo</button>
      <button type="button" class="pedido-btn primary" id="sendOrder">Enviar pedido</button>
    </div>
  </dialog>

  <dialog id="statusDlg" class="pedido-dialog pedido-status-dialog">
    <div class="pedido-status-icon" id="statusIcon">…</div>
    <h2 id="statusTitle">Pedido enviado!</h2>
    <p id="statusText">Aguarde a confirmação do atendente.</p>
    <p class="pedido-status-offline" id="statusOffline" hidden>A loja está offline agora; o pedido será processado quando ela reconectar.</p>
    <div class="pedido-dialog-actions">
      <button type="button" class="pedido-btn primary" id="orderMore">Pedir mais</button>
    </div>
  </dialog>

  <dialog id="historyDlg" class="pedido-dialog pedido-history-dialog">
    <div class="pedido-dialog-head">
      <h2>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:.35rem"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><path d="M12 7v5l3 2"/></svg>
        Meus pedidos
      </h2>
      <button type="button" class="pedido-close" data-close="historyDlg" aria-label="Fechar">×</button>
    </div>
    <div class="pedido-history-toolbar">
      <span>Salvos apenas neste navegador.</span>
      <button type="button" class="pedido-history-clear" id="clearHistory">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
        Limpar
      </button>
    </div>
    <div class="pedido-history-list" id="historyList"></div>
    <div class="pedido-history-empty" id="historyEmpty" hidden>
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><path d="M12 7v5l3 2"/></svg>
      <p>Você ainda não fez pedidos neste navegador.</p>
      <button type="button" class="pedido-btn secondary" data-close="historyDlg">Voltar ao menu</button>
    </div>
  </dialog>

  <dialog id="historyDetailDlg" class="pedido-dialog pedido-history-detail-dialog">
    <div class="pedido-dialog-head">
      <button type="button" class="pedido-back" id="historyBack" aria-label="Voltar para Meus pedidos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <h2>Detalhes do pedido</h2>
      <button type="button" class="pedido-close" data-close="historyDetailDlg" aria-label="Fechar">×</button>
    </div>
    <div class="pedido-detail-headline" id="historyDetailHeadline"></div>
    <div class="pedido-detail-body" id="historyDetailBody"></div>
    <div class="pedido-dialog-actions">
      <button type="button" class="pedido-btn secondary" data-close="historyDetailDlg">Fechar</button>
      <button type="button" class="pedido-btn primary" id="detailReorder">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        Pedir novamente
      </button>
    </div>
  </dialog>
  <% } %>

  <script id="menu-data" type="application/json"><%- typeof menuJson !== 'undefined' && menuJson ? menuJson : 'null' %></script>
  <script>
    <%
      var pedidoConfig = JSON.stringify({
        token: typeof token !== 'undefined' ? token : null,
        companyUuid: typeof companyUuid !== 'undefined' ? companyUuid : null,
        tableLabel: typeof tableLabel !== 'undefined' ? tableLabel : null,
        online: typeof desktopOnline !== 'undefined' ? desktopOnline : false,
      }).replace(/</g, '\\u003c');
    %>
    window.__PEDIDO__ = <%- pedidoConfig %>;
  </script>
  <% if (!error) { %><script src="/js/pedido.js" defer></script><% } %>
</body>
</html>
