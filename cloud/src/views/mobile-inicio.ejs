<%- include('partials/mobile-head', { titulo: 'Início', grant, fresh }) %>

<div class="m-cards">
  <div class="m-card m-card-hero">
    <span class="m-card-label">Vendas de hoje</span>
    <strong class="m-card-value">R$ <%= brl(totalDia) %></strong>
    <span class="m-card-sub"><%= qtdDia %> <%= qtdDia === 1 ? 'venda' : 'vendas' %></span>
  </div>
  <div class="m-card">
    <span class="m-card-label">Ticket médio</span>
    <strong class="m-card-value">R$ <%= brl(ticketMedio) %></strong>
  </div>
  <div class="m-card">
    <span class="m-card-label">Caixa</span>
    <% if (caixa) { %>
      <strong class="m-card-value m-ok">Aberto</strong>
      <span class="m-card-sub">Abertura R$ <%= brl(caixa.opening_cents || 0) %></span>
    <% } else { %>
      <strong class="m-card-value m-muted">Fechado</strong>
    <% } %>
  </div>
</div>

<%# Atalhos: a inicial vira o mapa do app.
    A barra de baixo comporta cinco itens legíveis num celular, e o Kivo Web já tem mais
    seções que isso — quem não estivesse na barra simplesmente não era alcançável de lugar
    nenhum. Aqui aparece TUDO que o usuário tem permissão de ver, inclusive o que está na
    barra: quem abre o app não deveria precisar saber em qual dos dois lugares procurar. %>
<section class="m-section">
  <div class="m-section-head"><h2>O que você quer fazer?</h2></div>
  <div class="m-atalhos">
    <% if (grant.permissions.includes('commercial.customers.view')) { %>
    <a class="m-atalho" href="/m/clientes">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>
      <span>Clientes</span>
      <em>Cobrança e fichas</em>
    </a>
    <% } %>
    <% if (grant.permissions.includes('store.quotes.create')) { %>
    <a class="m-atalho" href="/m/orcamentos/novo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M12 11v6M9 14h6"/></svg>
      <span>Novo orçamento</span>
      <em>Montar e enviar</em>
    </a>
    <% } %>
    <% if (grant.permissions.includes('store.sales.view')) { %>
    <a class="m-atalho" href="/m/vendas">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span>Vendas</span>
      <em>Histórico da loja</em>
    </a>
    <% } %>
    <% if (grant.permissions.includes('store.reports.view') || grant.permissions.includes('store.sales.view')) { %>
    <a class="m-atalho" href="/m/analiticos">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
      <span>Analíticos</span>
      <em>Como a loja vai</em>
    </a>
    <% } %>
    <% if (grant.permissions.includes('commercial.products.view')) { %>
    <a class="m-atalho" href="/m/estoque">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="M3.3 7 12 12l8.7-5"/><path d="M12 22V12"/></svg>
      <span>Estoque</span>
      <em>O que está acabando</em>
    </a>
    <% } %>
    <% if (grant.permissions.includes('finance.payables.view') || grant.permissions.includes('finance.receivables.view')) { %>
    <a class="m-atalho" href="/m/financeiro">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
      <span>Financeiro</span>
      <em>A pagar e a receber</em>
    </a>
    <% } %>
  </div>
</section>

<% if (grant.permissions.includes('store.sales.view')) { %>
<section class="m-section">
  <div class="m-section-head">
    <h2>Últimas vendas de hoje</h2>
    <a href="/m/vendas">ver todas</a>
  </div>
  <% if (!ultimas.length) { %>
    <p class="m-empty">Nenhuma venda registrada hoje ainda.</p>
  <% } else { %>
    <ul class="m-list">
      <% ultimas.forEach(function (s) { %>
        <li>
          <a href="/m/vendas/<%= s.uuid %>">
            <span class="m-list-main"><%= s.payload.customer_name || 'Consumidor' %></span>
            <span class="m-list-meta"><%= (s.payload.created_at || '').slice(11, 16) %> · <%= s.payload.payment_method %></span>
            <strong class="m-list-value">R$ <%= brl(s.payload.total_cents) %></strong>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<% } %>

<%- include('partials/mobile-foot', { grant, ativo: 'inicio' }) %>
