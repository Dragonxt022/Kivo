<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — KIVO IA</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <style>
    /* ─── KPIs ─── */
    .ai-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 20px; }
    .ai-kpi {
      background: var(--glass-bg-strong);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      padding: 16px 18px;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .ai-kpi-icon {
      width: 42px; height: 42px; flex: none;
      display: grid; place-items: center;
      border-radius: 11px;
      background: var(--primary-soft);
      color: var(--primary);
    }
    .ai-kpi-icon svg { width: 20px; height: 20px; }
    .ai-kpi .label { font-size: .78rem; color: var(--muted); font-weight: 600; }
    .ai-kpi .value { font-size: 1.5rem; font-weight: 700; letter-spacing: -.02em; line-height: 1.15; }
    .ai-kpi .sub { font-size: .72rem; color: var(--muted); margin-top: 1px; }

    /* ─── Layout dos gráficos ─── */
    .ai-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; align-items: start; }
    .ai-card { margin-bottom: 0; }
    .ai-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
    .ai-card-head h2 { margin: 0; }
    .ai-card-head .sub { font-size: .78rem; color: var(--muted); }

    .ai-chart { width: 100%; height: auto; overflow: visible; }
    .ai-chart .grid-line { stroke: var(--viz-grid); stroke-width: 1; }
    .ai-chart .axis-line { stroke: var(--viz-axis); stroke-width: 1; }
    .ai-chart .tick { fill: var(--viz-ink-muted); font-size: 10px; }
    .ai-chart .bar { fill: var(--primary); transition: opacity .15s; }
    .ai-chart .bar-col:hover .bar { opacity: .72; }

    .ai-donut-wrap { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
    .ai-donut { position: relative; width: 160px; height: 160px; flex: none; }
    .ai-donut svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .ai-donut .seg { transition: opacity .15s; }
    .ai-donut .seg:hover { opacity: .78; }
    .ai-donut-center {
      position: absolute; inset: 0; display: grid; place-content: center; text-align: center;
    }
    .ai-donut-center .n { font-size: 1.25rem; font-weight: 700; letter-spacing: -.02em; }
    .ai-donut-center .l { font-size: .68rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
    .ai-legend { display: flex; flex-direction: column; gap: .4rem; font-size: .84rem; flex: 1; min-width: 150px; }
    .ai-legend-row { display: flex; align-items: center; gap: .5rem; }
    .ai-legend-row .dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
    .ai-legend-row .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ai-legend-row .tokens { margin-left: auto; color: var(--muted); white-space: nowrap; }
    .ai-empty { color: var(--muted); font-size: .9rem; padding: 2rem 0; text-align: center; }

    /* ─── Tabela de créditos ─── */
    .ai-credit-name { font-weight: 600; }
    .ai-credit-uuid { font-size: .72rem; color: var(--muted); }
    .ai-progress { width: 130px; height: 7px; border-radius: 999px; background: var(--border-light); overflow: hidden; margin-top: 5px; }
    .ai-progress > span { display: block; height: 100%; background: var(--primary); border-radius: 999px; }
    .ai-progress.warn > span { background: var(--warning); }
    .ai-progress.over > span { background: var(--danger); }
    .ai-limit-form { display: flex; gap: 6px; align-items: center; margin: 0; }
    .ai-limit-form input { width: 110px; margin: 0; }
    .ai-limit-form .btn { padding: 7px 12px; }
    .ai-table-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 14px 18px; border-bottom: 1px solid var(--border-light); }
    .ai-table-scroll { overflow-x: auto; }

    @media (max-width: 1000px) { .ai-kpis { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 820px) {
      .ai-grid { grid-template-columns: 1fr; }
      .ai-kpis { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'ai' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'ai' }) %>

      <div class="page">
        <%
          function compact(n) {
            n = Number(n || 0);
            if (n >= 1e6) return (n / 1e6).toFixed(1).replace('.', ',') + 'M';
            if (n >= 1e3) return (n / 1e3).toFixed(1).replace('.', ',') + 'k';
            return String(n);
          }
          function nbr(n) { return Number(n || 0).toLocaleString('pt-BR'); }
          var avgPerReq = kpi.requests > 0 ? Math.round(kpi.tokens / kpi.requests) : 0;

          // ─── Geometria do gráfico de barras (tokens por dia) ───
          var BW = 660, BH = 240, padL = 52, padR = 12, padT = 16, padB = 30;
          var plotW = BW - padL - padR, plotH = BH - padT - padB;
          var maxTok = Math.max.apply(null, bars.map(function (b) { return b.tokens; }).concat([1]));
          var mag = Math.pow(10, Math.floor(Math.log10(maxTok)));
          var niceMax = Math.ceil(maxTok / (mag / 2 || 1)) * (mag / 2 || 1);
          if (!isFinite(niceMax) || niceMax <= 0) niceMax = 1;
          var slot = plotW / bars.length;
          var barW = Math.min(34, slot * 0.62);
          function bx(i) { return padL + slot * i + (slot - barW) / 2; }
          function by(v) { return padT + plotH - (v / niceMax) * plotH; }
          function bh(v) { return (v / niceMax) * plotH; }
        %>

        <div class="page-header">
          <div>
            <div class="breadcrumb">Sistema</div>
            <h1>KIVO IA</h1>
          </div>
          <span class="badge plan" style="font-size:.85rem;padding:6px 14px;">Período <%= period %></span>
        </div>

        <div class="ai-kpis">
          <div class="ai-kpi">
            <div class="ai-kpi-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v2M12 19v2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M3 12h2M19 12h2M5.6 18.4 7 17M17 7l1.4-1.4"/><circle cx="12" cy="12" r="3.5"/></svg>
            </div>
            <div>
              <div class="label">Tokens no mês</div>
              <div class="value"><%= compact(kpi.tokens) %></div>
              <div class="sub"><%= nbr(kpi.tokens) %> tokens</div>
            </div>
          </div>
          <div class="ai-kpi">
            <div class="ai-kpi-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <div>
              <div class="label">Requisições no mês</div>
              <div class="value"><%= compact(kpi.requests) %></div>
              <div class="sub">chamadas à IA</div>
            </div>
          </div>
          <div class="ai-kpi">
            <div class="ai-kpi-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
            </div>
            <div>
              <div class="label">Empresas usando</div>
              <div class="value"><%= kpi.companies %></div>
              <div class="sub">no período</div>
            </div>
          </div>
          <div class="ai-kpi">
            <div class="ai-kpi-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </div>
            <div>
              <div class="label">Média por requisição</div>
              <div class="value"><%= compact(avgPerReq) %></div>
              <div class="sub">tokens/chamada</div>
            </div>
          </div>
        </div>

        <div class="ai-grid">
          <div class="card ai-card">
            <div class="ai-card-head">
              <h2>Tokens por dia</h2>
              <span class="sub">últimos 14 dias</span>
            </div>
            <svg class="ai-chart" viewBox="0 0 <%= BW %> <%= BH %>" role="img"
                 aria-label="Tokens consumidos por dia nos últimos 14 dias">
              <% for (var g = 0; g <= 2; g++) {
                   var gv = (niceMax / 2) * g, gy = by(gv); %>
                <line class="grid-line" x1="<%= padL %>" y1="<%= gy.toFixed(1) %>" x2="<%= BW - padR %>" y2="<%= gy.toFixed(1) %>"/>
                <text class="tick" x="<%= padL - 8 %>" y="<%= (gy + 3.5).toFixed(1) %>" text-anchor="end"><%= compact(gv) %></text>
              <% } %>
              <line class="axis-line" x1="<%= padL %>" y1="<%= (padT + plotH).toFixed(1) %>" x2="<%= BW - padR %>" y2="<%= (padT + plotH).toFixed(1) %>"/>
              <% bars.forEach(function (b, i) {
                   var h = bh(b.tokens), y = by(b.tokens); %>
                <g class="bar-col">
                  <rect class="bar" x="<%= bx(i).toFixed(1) %>" y="<%= y.toFixed(1) %>" width="<%= barW.toFixed(1) %>" height="<%= Math.max(1, h).toFixed(1) %>" rx="3">
                    <title><%= b.label %>: <%= nbr(b.tokens) %> tokens</title>
                  </rect>
                </g>
                <% if ((bars.length - 1 - i) % 2 === 0) { %>
                  <text class="tick" x="<%= (bx(i) + barW / 2).toFixed(1) %>" y="<%= BH - 10 %>" text-anchor="middle"><%= b.label %></text>
                <% } %>
              <% }); %>
            </svg>
          </div>

          <div class="card ai-card">
            <div class="ai-card-head">
              <h2>Uso por empresa</h2>
              <span class="sub">no mês</span>
            </div>
            <% if (!pie.length) { %>
              <p class="ai-empty">Sem uso neste período.</p>
            <% } else { %>
              <div class="ai-donut-wrap">
                <div class="ai-donut">
                  <svg viewBox="0 0 42 42" role="img" aria-label="Distribuição de tokens por empresa">
                    <circle cx="21" cy="21" r="15.9155" fill="transparent" stroke="var(--border-light)" stroke-width="7"></circle>
                    <% pie.forEach(function (s) { %>
                      <circle class="seg" cx="21" cy="21" r="15.9155" fill="transparent" stroke="<%= s.color %>" stroke-width="7"
                              stroke-dasharray="<%= s.pct %> <%= (100 - s.pct).toFixed(1) %>" stroke-dashoffset="<%= s.offset.toFixed(2) %>">
                        <title><%= s.name %>: <%= nbr(s.tokens) %> tokens (<%= String(s.pct).replace('.', ',') %>%)</title>
                      </circle>
                    <% }); %>
                  </svg>
                  <div class="ai-donut-center">
                    <div class="n"><%= compact(pieTotal) %></div>
                    <div class="l">tokens</div>
                  </div>
                </div>
                <div class="ai-legend">
                  <% pie.forEach(function (s) { %>
                    <div class="ai-legend-row">
                      <span class="dot" style="background:<%= s.color %>"></span>
                      <span class="name" title="<%= s.name %>"><%= s.name %></span>
                      <span class="tokens"><%= compact(s.tokens) %> · <%= String(s.pct).replace('.', ',') %>%</span>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card table-card ai-card" style="margin-top:20px">
          <div class="ai-table-toolbar">
            <div>
              <h2 style="margin:0">Créditos por empresa</h2>
              <p class="sub" style="margin:2px 0 0;font-size:.8rem;color:var(--muted)">
                Defina o teto de tokens por mês (0 = ilimitado). O consumo zera todo dia 1º.
              </p>
            </div>
            <div class="table-search" style="max-width:280px;margin-left:auto">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              <input type="text" id="ai-credit-search" placeholder="Buscar empresa…" autocomplete="off">
            </div>
            <span class="table-count" id="ai-credit-count"><%= companies.length %> empresa(s)</span>
          </div>
          <div class="ai-table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Empresa</th>
                  <th>Plano</th>
                  <th>Usado no mês</th>
                  <th>Teto (tokens/mês)</th>
                  <th>Restante</th>
                </tr>
              </thead>
              <tbody id="ai-credit-body">
                <% if (!companies.length) { %>
                  <tr><td colspan="5"><p class="ai-empty">Nenhuma empresa cadastrada.</p></td></tr>
                <% } %>
                <% companies.forEach(function (c) {
                     var pct = c.limit > 0 ? Math.min(100, Math.round((c.used / c.limit) * 100)) : 0;
                     var cls = c.limit > 0 ? (pct >= 100 ? 'over' : pct >= 80 ? 'warn' : '') : ''; %>
                  <tr data-search="<%= String(c.name || '').toLowerCase() %> <%= String(c.uuid).toLowerCase() %>">
                    <td>
                      <div class="ai-credit-name"><a href="/admin/companies/<%= c.uuid %>"><%= c.name || c.uuid %></a></div>
                      <div class="ai-credit-uuid"><%= c.uuid %></div>
                    </td>
                    <td><% if (c.plan) { %><span class="badge plan"><%= c.plan %></span><% } else { %><span class="muted">—</span><% } %></td>
                    <td>
                      <div><strong><%= compact(c.used) %></strong> <% if (c.limit > 0) { %><span class="muted" style="font-size:.78rem">de <%= compact(c.limit) %></span><% } %></div>
                      <% if (c.limit > 0) { %>
                        <div class="ai-progress <%= cls %>" title="<%= pct %>% do teto"><span style="width:<%= pct %>%"></span></div>
                      <% } %>
                    </td>
                    <td>
                      <form class="ai-limit-form" method="post" action="/admin/ai/<%= c.uuid %>/limit">
                        <input type="number" name="limitTokens" min="0" step="1000" value="<%= c.limit %>">
                        <button class="btn secondary" type="submit">Salvar</button>
                      </form>
                    </td>
                    <td>
                      <% if (c.limit > 0) { %>
                        <%= nbr(Math.max(0, c.limit - c.used)) %>
                      <% } else { %>
                        <span class="muted">ilimitado</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    // Filtro client-side da tabela de créditos (até 200 empresas).
    (function () {
      var input = document.getElementById('ai-credit-search');
      var body = document.getElementById('ai-credit-body');
      var count = document.getElementById('ai-credit-count');
      if (!input || !body) return;
      var rows = Array.prototype.slice.call(body.querySelectorAll('tr[data-search]'));
      function apply() {
        var q = input.value.trim().toLowerCase();
        var shown = 0;
        rows.forEach(function (tr) {
          var hit = !q || tr.getAttribute('data-search').indexOf(q) !== -1;
          tr.hidden = !hit;
          if (hit) shown++;
        });
        if (count) count.textContent = shown + ' empresa(s)';
      }
      input.addEventListener('input', apply);
    })();
  </script>
</body>
</html>
