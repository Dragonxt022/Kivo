<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include('partials/theme-init') %>
  <title>Kivo Cloud — Banco de imagens</title>
  <link rel="icon" type="image/svg+xml" href="/logo_kivo-icon.svg">
  <%- include('partials/styles') %>
  <script defer src="/vendor/alpine.min.js"></script>
  <style>
    .cat-filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
    .cat-filters .input-search { flex: 1; min-width: 220px; }
    .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }
    .cat-card { border: 1.5px solid var(--border-light, #e5e7eb); border-radius: 12px; overflow: hidden; background: #fff; display: flex; flex-direction: column; }
    .cat-card.selected { border-color: var(--primary, #ff8000); box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary, #ff8000) 25%, transparent); }
    .cat-thumb { position: relative; aspect-ratio: 1 / 1; background: var(--surface-hover, #f4f4f5); }
    .cat-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cat-check { position: absolute; top: 8px; left: 8px; width: 18px; height: 18px; cursor: pointer; }
    .cat-body { padding: 10px 12px; display: flex; flex-direction: column; gap: 4px; }
    .cat-name { font-weight: 600; font-size: 0.9rem; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .cat-meta { font-size: 0.74rem; color: var(--muted, #888); }
    .cat-actions { display: flex; gap: 6px; padding: 0 12px 12px; margin-top: auto; }
    .cat-actions form { margin: 0; display: inline; }
    .cat-actions .btn { padding: 5px 9px; font-size: 0.8rem; }
    .pager a { text-decoration: none; }
    .pager a.is-disabled { pointer-events: none; opacity: .45; }
    .pager-num { min-width: 32px; }
    .pager-num.ellipsis { border: 0; background: transparent; cursor: default; }
    .cat-toolbar-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'catalog' }) %>
    <main class="content">
      <%- include('partials/navbar', { active: 'catalog' }) %>

      <%
        function formatBytes(n) {
          if (!n) return '0 KB';
          if (n < 1024 * 1024) return Math.round(n / 1024) + ' KB';
          if (n < 1024 * 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + ' MB';
          return (n / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
        }
        function qs(extra) {
          var p = new URLSearchParams();
          p.set('tab', activeTab);
          if (activeTab === 'imagens') {
            p.set('status', activeStatus);
            if (q) p.set('q', q);
            if (source) p.set('source', source);
            if (format) p.set('format', format);
            if (sort) p.set('sort', sort);
          } else if (q) {
            p.set('q', q);
          }
          Object.keys(extra || {}).forEach(function (k) { p.set(k, extra[k]); });
          return '/admin/catalog?' + p.toString();
        }
        function renderPager(current, totalPages, win) {
          if (totalPages <= 1) return;
      %>
          <div class="pager">
            <a class="btn secondary small <%= current <= 1 ? 'is-disabled' : '' %>" href="<%= qs({ page: 1 }) %>">Primeiro</a>
            <a class="pager-arrow <%= current <= 1 ? 'is-disabled' : '' %>" href="<%= qs({ page: current - 1 }) %>" aria-label="Página anterior">‹</a>
            <% win.forEach(function (p) { %>
              <% if (p === '…') { %><span class="pager-num ellipsis">…</span><% } else { %>
                <a class="pager-num <%= p === current ? 'active' : '' %>" href="<%= qs({ page: p }) %>"><%= p %></a>
              <% } %>
            <% }); %>
            <a class="pager-arrow <%= current >= totalPages ? 'is-disabled' : '' %>" href="<%= qs({ page: current + 1 }) %>" aria-label="Próxima página">›</a>
            <a class="btn secondary small <%= current >= totalPages ? 'is-disabled' : '' %>" href="<%= qs({ page: totalPages }) %>">Último</a>
          </div>
      <%
        }
      %>

      <div class="page">
        <div class="page-header">
          <h1>Banco de imagens</h1>
          <div style="display:flex; gap:8px;">
            <button class="btn danger" onclick="openDeleteAllModal()">Apagar todas</button>
            <button class="btn" onclick="openUploadModal()">+ Adicionar imagem(ns)</button>
          </div>
        </div>

        <div class="card">
          <div class="stat-row">
            <div class="stat"><div class="value"><%= stats.pending %></div><div class="label">Pendentes</div></div>
            <div class="stat"><div class="value"><%= stats.approved %></div><div class="label">Aprovadas</div></div>
            <div class="stat"><div class="value"><%= stats.rejected %></div><div class="label">Rejeitadas (histórico)</div></div>
            <div class="stat"><div class="value"><%= formatBytes(stats.storageBytes) %></div><div class="label">Espaço em disco</div></div>
          </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="error-banner"><%= error %></div>
        <% } %>
        <% if (typeof deleted !== 'undefined' && deleted) { %>
          <div class="success-banner"><%= deleted %> imagem(ns) removida(s) com sucesso.</div>
        <% } %>

        <div class="catalog-tabs" style="display: flex; gap: 8px; margin-bottom: 20px;">
          <a href="/admin/catalog?tab=imagens&status=<%= activeStatus %>" class="btn secondary <%= activeTab === 'imagens' ? 'active' : '' %>">Imagens</a>
          <a href="/admin/catalog?tab=demanda" class="btn secondary <%= activeTab === 'demanda' ? 'active' : '' %>">
            Demanda<% if (demandTotal) { %> (<%= demandTotal %>)<% } %>
          </a>
        </div>

        <% if (activeTab === 'demanda') { %>
        <div class="card" style="padding: 16px 20px;">
          <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:8px;">
            <h2 style="margin:0; font-size:1.05rem;">Demanda do catálogo</h2>
            <span class="field-hint" style="margin:0;">
              <%= aliasStats.total %> alias aprendido<%= aliasStats.total === 1 ? '' : 's' %> · <%= aliasStats.hits %> uso<%= aliasStats.hits === 1 ? '' : 's' %>
            </span>
          </div>
          <p class="field-hint" style="margin-top:0;">
            Nomes que as empresas procuraram e não acharam (anônimo). Adicione uma imagem para o termo e marque "Resolvido".
          </p>

          <form method="get" action="/admin/catalog" class="cat-filters" style="margin-top:10px;">
            <input type="hidden" name="tab" value="demanda">
            <input type="search" class="input-search" name="q" value="<%= q %>" placeholder="Buscar termo…">
            <button type="submit" class="btn small">Buscar</button>
            <% if (q) { %><a class="btn secondary small" href="/admin/catalog?tab=demanda">Limpar</a><% } %>
          </form>

          <table>
            <thead><tr><th>Termo buscado</th><th class="text-right">Buscas</th><th>Última vez</th><th></th></tr></thead>
            <tbody>
              <% demand.forEach(function(d) { %>
              <tr>
                <td><strong><%= d.term %></strong></td>
                <td class="text-right tabular"><%= d.misses %></td>
                <td class="cell-muted"><%= fmtDateTimeBr(d.last_seen_at) %></td>
                <td class="text-right">
                  <a class="btn small secondary" href="/admin/catalog?tab=imagens&status=aprovada&q=<%= encodeURIComponent(d.term) %>">Buscar no catálogo</a>
                  <form method="post" action="/admin/catalog/demand/<%= d.id %>/delete" style="display:inline;"
                        onsubmit="return confirm('Remover este termo da lista de demanda?');">
                    <button type="submit" class="btn small secondary">Resolvido</button>
                  </form>
                </td>
              </tr>
              <% }) %>
              <% if (!demand.length) { %>
              <tr><td colspan="4"><%- include('partials/empty-state', { message: q ? 'Nenhum termo encontrado para esta busca.' : 'Nenhuma demanda registrada ainda.' }) %></td></tr>
              <% } %>
            </tbody>
          </table>

          <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-top:12px;">
            <span class="cell-muted" style="font-size:0.82rem;"><%= demandTotal %> termo(s) · página <%= demandPage %> de <%= demandTotalPages %></span>
            <% renderPager(demandPage, demandTotalPages, demandPageWindow); %>
          </div>
        </div>
        <% } else { %>
        <div class="cat-toolbar-row">
          <div class="catalog-tabs" style="display: flex; gap: 8px;">
            <a href="/admin/catalog?tab=imagens&status=pendente" class="btn secondary small <%= activeStatus === 'pendente' ? 'active' : '' %>">Pendentes (<%= stats.pending %>)</a>
            <a href="/admin/catalog?tab=imagens&status=aprovada" class="btn secondary small <%= activeStatus === 'aprovada' ? 'active' : '' %>">Aprovadas (<%= stats.approved %>)</a>
          </div>
          <span class="cell-muted" style="font-size:0.82rem;"><%= totalImages %> imagem(ns) · página <%= page %> de <%= totalPages %></span>
        </div>

        <form method="get" action="/admin/catalog" class="cat-filters">
          <input type="hidden" name="tab" value="imagens">
          <input type="hidden" name="status" value="<%= activeStatus %>">
          <input type="search" class="input-search" name="q" value="<%= q %>" placeholder="Buscar por nome, palavra-chave ou código de barras…">
          <select name="source" onchange="this.form.submit()">
            <option value="">Toda origem</option>
            <option value="manual" <%= source === 'manual' ? 'selected' : '' %>>Manual</option>
            <option value="empresa" <%= source === 'empresa' ? 'selected' : '' %>>Enviadas por empresas</option>
          </select>
          <select name="format" onchange="this.form.submit()">
            <option value="">Todo formato</option>
            <option value="jpeg" <%= format === 'jpeg' ? 'selected' : '' %>>JPEG</option>
            <option value="png" <%= format === 'png' ? 'selected' : '' %>>PNG</option>
            <option value="webp" <%= format === 'webp' ? 'selected' : '' %>>WEBP</option>
            <option value="avif" <%= format === 'avif' ? 'selected' : '' %>>AVIF</option>
          </select>
          <select name="sort" onchange="this.form.submit()">
            <option value="recentes" <%= sort === 'recentes' ? 'selected' : '' %>>Mais recentes</option>
            <option value="antigas" <%= sort === 'antigas' ? 'selected' : '' %>>Mais antigas</option>
            <option value="nome" <%= sort === 'nome' ? 'selected' : '' %>>Nome (A–Z)</option>
          </select>
          <button type="submit" class="btn small">Buscar</button>
          <% if (q || source || format) { %><a class="btn secondary small" href="/admin/catalog?tab=imagens&status=<%= activeStatus %>">Limpar</a><% } %>
        </form>

        <div x-data="catalogSelection()">
          <% if (activeStatus === 'pendente') { %>
          <div class="batch-bar" x-show="selectedIds.length > 0" x-cloak style="display:flex; align-items:center; gap:8px; padding:10px 14px; background:var(--surface-hover); border:1px solid var(--border-light); border-radius:10px; margin-bottom:12px; flex-wrap:wrap;">
            <span style="font-size:0.85rem; font-weight:600;" x-text="selectedIds.length + ' selecionada(s)'"></span>
            <form method="post" action="/admin/catalog/batch-approve" style="display:inline;" @submit.prevent="submitBatch($event)">
              <input type="hidden" name="ids" :value="selectedIds.join(',')">
              <input type="hidden" name="redirectStatus" value="pendente">
              <button type="submit" class="btn small" style="background:var(--success);color:#fff;">✓ Aprovar selecionadas</button>
            </form>
            <form method="post" action="/admin/catalog/batch-reject" style="display:inline;" @submit.prevent="if (confirm('Rejeitar ' + selectedIds.length + ' imagem(ns)?')) submitBatch($event)">
              <input type="hidden" name="ids" :value="selectedIds.join(',')">
              <input type="hidden" name="redirectStatus" value="pendente">
              <button type="submit" class="btn small danger">✕ Rejeitar selecionadas</button>
            </form>
            <button type="button" class="btn secondary small" @click="selectedIds = []">Limpar seleção</button>
          </div>
          <% } %>

          <% if (images.length) { %>
          <div class="cat-toolbar-row">
            <% if (activeStatus === 'pendente') { %>
            <label class="label-checkbox" style="font-size:0.82rem; margin:0;">
              <input type="checkbox" @change="toggleAllPage($event.target.checked, <%- JSON.stringify(images.map(function (i) { return i.id; })) %>)">
              Selecionar esta página
            </label>
            <% } else { %><span></span><% } %>
          </div>

          <div class="cat-grid">
            <% images.forEach(function(img) { %>
            <div class="cat-card" :class="{ selected: selectedIds.includes(<%= img.id %>) }">
              <div class="cat-thumb">
                <img src="/admin/catalog/<%= img.id %>/image" alt="<%= img.product_name %>" loading="lazy" width="<%= img.width %>" height="<%= img.height %>">
                <% if (activeStatus === 'pendente') { %>
                <input type="checkbox" class="cat-check" title="Selecionar" @change="toggle(<%= img.id %>, $event.target.checked)">
                <% } %>
              </div>
              <div class="cat-body">
                <div class="cat-name" title="<%= img.product_name %>"><%= img.product_name %></div>
                <div class="cat-meta"><%= img.width %>×<%= img.height %> · <%= formatBytes(img.size_bytes) %> · <%= img.format %></div>
                <div class="cat-meta"><%= img.source === 'manual' ? 'Manual' : (img.company_uuid ? 'Empresa ' + img.company_uuid.slice(0, 8) + '…' : 'Enviada') %> · <%= fmtDateTimeBr(img.created_at) %></div>
                <div class="cat-meta" style="display:flex;align-items:center;gap:6px;">
                  <span>EAN: <strong><%= img.barcode || '—' %></strong></span>
                  <button type="button" class="btn secondary" style="padding:1px 6px;font-size:0.72rem" onclick="setBarcode(<%= img.id %>, '<%= img.barcode || '' %>')">editar</button>
                </div>
              </div>
              <div class="cat-actions">
                <a href="/admin/catalog/<%= img.id %>/image" download class="btn secondary" title="Baixar">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </a>
                <% if (activeStatus === 'pendente') { %>
                <form method="post" action="/admin/catalog/<%= img.id %>/approve">
                  <input type="hidden" name="redirectStatus" value="pendente">
                  <button type="submit" class="btn" style="background:var(--success);color:#fff;" title="Aprovar">✓ Aprovar</button>
                </form>
                <form method="post" action="/admin/catalog/<%= img.id %>/reject" onsubmit="return confirm('Rejeitar e excluir esta imagem?');">
                  <input type="hidden" name="redirectStatus" value="pendente">
                  <button type="submit" class="btn danger" title="Rejeitar">✕</button>
                </form>
                <% } else { %>
                <form method="post" action="/admin/catalog/<%= img.id %>/reject" onsubmit="return confirm('Remover esta imagem do catálogo aprovado?');">
                  <input type="hidden" name="redirectStatus" value="aprovada">
                  <button type="submit" class="btn danger">Remover</button>
                </form>
                <% } %>
              </div>
            </div>
            <% }) %>
          </div>

          <div style="display:flex; justify-content:center; margin-top:16px;">
            <% renderPager(page, totalPages, pageWindow); %>
          </div>
          <% } else { %>
          <div class="card">
            <%- include('partials/empty-state', { message: q || source || format ? 'Nenhuma imagem encontrada com esses filtros.' : (activeStatus === 'aprovada' ? 'Nenhuma imagem aprovada ainda.' : 'Nenhuma imagem pendente de curadoria.') }) %>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <dialog id="modal-manual-upload">
    <div class="modal-header">
      <h2>Adicionar imagens ao catálogo</h2>
      <button type="button" class="modal-close" onclick="closeUploadModal()">&times;</button>
    </div>
    <div class="modal-body">
      <label>Imagens (JPEG, PNG, WEBP ou AVIF — mínimo 200×200px, máximo 6MB cada)</label>
      <p class="field-hint" style="margin-top:-4px">O nome de cada produto é gerado a partir do nome do arquivo — renomeie os arquivos antes de selecionar se quiser outro nome.</p>
      <div class="drop-zone" id="drop-zone">
        <div class="drop-zone-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        </div>
        <div>Arraste imagens aqui ou clique para selecionar</div>
        <div style="font-size: 0.78rem; margin-top: 4px; color: var(--muted);">Pode selecionar várias imagens de uma vez</div>
      </div>
      <input type="file" id="manual-image-file" accept="image/jpeg,image/png,image/webp,image/avif,.jpg,.jpeg,.png,.webp,.avif" multiple style="display:none">

      <div class="upload-preview-grid" id="upload-preview-grid"></div>
      <div class="upload-counter" id="upload-counter" style="display:none">
        <strong id="upload-count-num">0</strong> imagem(ns) selecionada(s)
      </div>

      <p style="color: var(--danger); font-size: 0.85rem; margin-top: 10px; display: none;" id="manual-upload-error"></p>

      <div id="upload-progress" style="display:none; margin-top: 12px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
          <span style="font-size:0.85rem; font-weight:600;" id="upload-progress-text">Enviando...</span>
          <span style="font-size:0.82rem; color:var(--muted);" id="upload-progress-count"></span>
        </div>
        <div style="height:6px; background:var(--surface-hover); border-radius:999px; overflow:hidden;">
          <div id="upload-progress-bar" style="height:100%; background:var(--primary); border-radius:999px; transition: width .3s; width: 0;"></div>
        </div>
      </div>

      <div class="modal-actions" style="margin-top: 16px;">
        <button type="button" class="btn secondary" onclick="closeUploadModal()">Cancelar</button>
        <button type="button" class="btn" id="manual-upload-submit" onclick="submitAllUploads()">Adicionar ao catálogo</button>
      </div>
    </div>
  </dialog>

  <dialog id="modal-delete-all">
    <div class="modal-header">
      <h2>Apagar imagens do catálogo</h2>
      <button type="button" class="modal-close" onclick="closeDeleteAllModal()">&times;</button>
    </div>
    <div class="modal-body">
      <p>Tem certeza que deseja apagar <strong id="delete-all-count">0</strong> imagem(ns) da aba <strong id="delete-all-status-label">Pendentes</strong>?</p>
      <p style="color: var(--danger); font-size: 0.85rem; margin-top: 8px;">Esta ação não pode ser desfeita. Os arquivos serão removidos permanentemente do disco.</p>

      <div style="margin-top: 16px;">
        <label style="font-size: 0.85rem; font-weight: 600;">Digite <strong>APAGAR</strong> para confirmar:</label>
        <input type="text" id="delete-all-confirm-input" class="input-search" placeholder="APAGAR" style="margin-top: 6px;" oninput="validateDeleteAllInput()">
      </div>

      <div class="modal-actions" style="margin-top: 16px;">
        <button type="button" class="btn secondary" onclick="closeDeleteAllModal()">Cancelar</button>
        <form method="post" action="/admin/catalog/delete-all" id="delete-all-form" style="display:inline;">
          <input type="hidden" name="status" id="delete-all-status-field" value="">
          <button type="submit" class="btn danger" id="delete-all-submit-btn" disabled>Apagar todas</button>
        </form>
      </div>
    </div>
  </dialog>

  <script>
    function catalogSelection() {
      return {
        selectedIds: [],
        toggle(id, checked) {
          if (checked) {
            if (!this.selectedIds.includes(id)) this.selectedIds.push(id);
          } else {
            this.selectedIds = this.selectedIds.filter((x) => x !== id);
          }
        },
        toggleAllPage(checked, ids) {
          if (checked) {
            this.selectedIds = [...new Set(this.selectedIds.concat(ids))];
          } else {
            const rm = new Set(ids);
            this.selectedIds = this.selectedIds.filter((x) => !rm.has(x));
          }
        },
        submitBatch(ev) {
          if (this.selectedIds.length) ev.target.submit();
        },
      };
    }

    var pendingFiles = [];

    async function setBarcode(id, current) {
      var val = prompt('Código de barras (EAN/UPC). Deixe vazio para limpar:', current || '');
      if (val === null) return;
      var r = await fetch('/admin/catalog/' + id + '/barcode', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ barcode: val.trim() }),
      });
      if (r.ok) location.reload();
      else alert('Não foi possível salvar o código.');
    }

    function nameFromFilename(filename) {
      return filename.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ').trim();
    }

    function openUploadModal() {
      pendingFiles = [];
      document.getElementById('upload-preview-grid').innerHTML = '';
      document.getElementById('upload-counter').style.display = 'none';
      document.getElementById('manual-upload-error').style.display = 'none';
      document.getElementById('upload-progress').style.display = 'none';
      document.getElementById('manual-upload-submit').disabled = false;
      document.getElementById('manual-upload-submit').textContent = 'Adicionar ao catálogo';
      document.getElementById('modal-manual-upload').showModal();
    }

    function closeUploadModal() {
      document.getElementById('modal-manual-upload').close();
      pendingFiles = [];
    }

    function renderPreviews() {
      var grid = document.getElementById('upload-preview-grid');
      var counter = document.getElementById('upload-counter');
      grid.innerHTML = '';
      if (!pendingFiles.length) {
        counter.style.display = 'none';
        return;
      }
      counter.style.display = 'block';
      document.getElementById('upload-count-num').textContent = pendingFiles.length;
      pendingFiles.forEach(function (f, i) {
        var div = document.createElement('div');
        div.className = 'upload-preview-item';
        var img = document.createElement('img');
        img.src = URL.createObjectURL(f);
        var caption = document.createElement('div');
        caption.className = 'upload-preview-name';
        caption.textContent = nameFromFilename(f.name);
        caption.title = f.name;
        var btn = document.createElement('button');
        btn.className = 'remove-btn';
        btn.type = 'button';
        btn.textContent = '×';
        btn.onclick = function () {
          pendingFiles.splice(i, 1);
          renderPreviews();
        };
        div.appendChild(img);
        div.appendChild(caption);
        div.appendChild(btn);
        grid.appendChild(div);
      });
    }

    var dropZone = document.getElementById('drop-zone');
    var fileInput = document.getElementById('manual-image-file');

    dropZone.addEventListener('click', function () { fileInput.click(); });

    dropZone.addEventListener('dragover', function (e) {
      e.preventDefault();
      dropZone.classList.add('dragover');
    });
    dropZone.addEventListener('dragleave', function () {
      dropZone.classList.remove('dragover');
    });
    dropZone.addEventListener('drop', function (e) {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      var files = Array.from(e.dataTransfer.files).filter(function (f) {
        return ['image/jpeg', 'image/png', 'image/webp', 'image/avif'].indexOf(f.type) !== -1;
      });
      if (files.length) {
        pendingFiles = pendingFiles.concat(files);
        renderPreviews();
      }
    });

    fileInput.addEventListener('change', function (e) {
      var files = Array.from(e.target.files);
      if (files.length) {
        pendingFiles = pendingFiles.concat(files);
        renderPreviews();
      }
      fileInput.value = '';
    });

    var uploading = false;

    async function submitAllUploads() {
      if (uploading) return;
      var errorEl = document.getElementById('manual-upload-error');
      errorEl.style.display = 'none';
      if (!pendingFiles.length) {
        errorEl.textContent = 'Selecione ao menos uma imagem.';
        errorEl.style.display = 'block';
        return;
      }

      uploading = true;
      var btn = document.getElementById('manual-upload-submit');
      btn.disabled = true;
      btn.textContent = 'Enviando...';

      var progressEl = document.getElementById('upload-progress');
      var barEl = document.getElementById('upload-progress-bar');
      var textEl = document.getElementById('upload-progress-text');
      var countEl = document.getElementById('upload-progress-count');
      progressEl.style.display = 'block';

      var total = pendingFiles.length;
      var ok = 0;
      var fail = 0;
      var errors = [];

      for (var i = 0; i < total; i++) {
        countEl.textContent = (i + 1) + '/' + total;
        textEl.textContent = 'Enviando ' + (i + 1) + ' de ' + total + '...';
        barEl.style.width = Math.round(((i) / total) * 100) + '%';

        try {
          var buf = await pendingFiles[i].arrayBuffer();
          var res = await fetch('/admin/catalog/manual', {
            method: 'POST',
            headers: { 'Content-Type': pendingFiles[i].type, 'X-Kivo-Product-Name': nameFromFilename(pendingFiles[i].name) },
            body: buf,
          });
          if (res.ok) {
            ok++;
          } else {
            var data = await res.json().catch(function () { return { error: 'HTTP ' + res.status }; });
            fail++;
            errors.push(pendingFiles[i].name + ': ' + (data.error || 'Erro ' + res.status));
          }
        } catch (e) {
          fail++;
          errors.push(pendingFiles[i].name + ': Erro de rede');
        }
      }

      barEl.style.width = '100%';
      textEl.textContent = 'Concluído!';

      if (fail > 0 && ok === 0) {
        errorEl.textContent = 'Falha em todas: ' + errors.join('; ');
        errorEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Adicionar ao catálogo';
        uploading = false;
        return;
      }

      window.location.href = '/admin/catalog?tab=imagens&status=aprovada';
    }

    var deleteAllCount = <%= activeStatus === 'aprovada' ? stats.approved : stats.pending %>;
    var deleteAllStatus = '<%= activeStatus %>';

    function openDeleteAllModal() {
      document.getElementById('delete-all-count').textContent = deleteAllCount;
      document.getElementById('delete-all-status-label').textContent = deleteAllStatus === 'aprovada' ? 'Aprovadas' : 'Pendentes';
      document.getElementById('delete-all-status-field').value = deleteAllStatus;
      document.getElementById('delete-all-confirm-input').value = '';
      document.getElementById('delete-all-submit-btn').disabled = true;
      document.getElementById('modal-delete-all').showModal();
    }

    function closeDeleteAllModal() {
      document.getElementById('modal-delete-all').close();
    }

    function validateDeleteAllInput() {
      var val = document.getElementById('delete-all-confirm-input').value.trim().toUpperCase();
      document.getElementById('delete-all-submit-btn').disabled = val !== 'APAGAR';
    }
  </script>
</body>
</html>
